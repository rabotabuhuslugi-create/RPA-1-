// Модуль управляемой формы внешней обработки "РазведкаЭПД".
// Форма пустая: реквизит и кнопка создаются программно, чтобы не рисовать форму вручную.
// Задача: показать, как в ВАШЕЙ базе называются объекты 1С-ЭПД (ЭТрН),
// чтобы затем написать точный код подписания.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("Отчет", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(НовыеРеквизиты);

	Поле = Элементы.Добавить("Отчет", Тип("ПолеФормы"), ЭтаФорма);
	Поле.Вид = ВидПоляФормы.ПолеТекстовогоДокумента;
	Поле.ПутьКДанным = "Отчет";
	Поле.Высота = 30;

	Команда = Команды.Добавить("Собрать");
	Команда.Действие = "СобратьКоманда";
	Команда.Заголовок = "Собрать сведения об объектах ЭПД";
	Кнопка = Элементы.Добавить("СобратьКнопка", Тип("КнопкаФормы"), ЭтаФорма);
	Кнопка.ИмяКоманды = "Собрать";
	Кнопка.Заголовок = "Собрать сведения об объектах ЭПД";

КонецПроцедуры

&НаКлиенте
Процедура СобратьКоманда(Команда)
	Отчет = СобратьНаСервере();
КонецПроцедуры

&НаСервере
Функция СобратьНаСервере()

	Маски = Новый Массив;
	Маски.Добавить("ЭПД");
	Маски.Добавить("Перевоз");
	Маски.Добавить("ЭТрН");
	Маски.Добавить("Транспортн");

	Текст = Новый Массив;
	Текст.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);

	Коллекции = Новый Структура;
	Коллекции.Insert("Документ", Метаданные.Документы);
	Коллекции.Insert("Справочник", Метаданные.Справочники);
	Коллекции.Insert("РегистрСведений", Метаданные.РегистрыСведений);
	Коллекции.Insert("ОбщийМодуль", Метаданные.ОбщиеМодули);
	Коллекции.Insert("Перечисление", Метаданные.Перечисления);
	Коллекции.Insert("Подсистема", Метаданные.Подсистемы);
	Коллекции.Insert("ОбщаяФорма", Метаданные.ОбщиеФормы);
	Коллекции.Insert("Обработка", Метаданные.Обработки);

	Для Каждого Элемент Из Коллекции Цикл
		Для Каждого Объект Из Элемент.Значение Цикл
			Если ПодходитПоМаске(Объект.Имя + " " + Объект.Синоним, Маски) Тогда
				Текст.Добавить(Элемент.Ключ + "." + Объект.Имя + "  | " + Объект.Синоним);
				ДобавитьПодробности(Текст, Элемент.Ключ, Объект);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

&НаСервере
Функция ПодходитПоМаске(Строка, Маски)
	Для Каждого Маска Из Маски Цикл
		Если СтрНайти(НРег(Строка), НРег(Маска)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ДобавитьПодробности(Текст, Вид, Объект)

	Если Вид = "Перечисление" Тогда
		Для Каждого Значение Из Объект.ЗначенияПеречисления Цикл
			Текст.Добавить("      значение: " + Значение.Имя + " | " + Значение.Синоним);
		КонецЦикла;
	ИначеЕсли Вид = "Документ" Или Вид = "Справочник" Или Вид = "РегистрСведений" Тогда
		Поля = Новый Массив;
		Для Каждого Реквизит Из Объект.Реквизиты Цикл
			Поля.Добавить(Реквизит.Имя);
		КонецЦикла;
		Если Поля.Количество() > 0 Тогда
			Текст.Добавить("      реквизиты: " + СтрСоединить(Поля, ", "));
		КонецЕсли;
	ИначеЕсли Вид = "ОбщийМодуль" Тогда
		Текст.Добавить("      клиент=" + Объект.КлиентУправляемоеПриложение
			+ " сервер=" + Объект.Сервер + " вызовСервера=" + Объект.ВызовСервера);
	КонецЕсли;

КонецПроцедуры
