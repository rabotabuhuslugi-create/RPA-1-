// Приёмка входящих ЭТрН: титул грузополучателя (ЭТрН_Титул3), шаг «Приемка».
// Заполняет в титуле количество мест, массу брутто и состояние груза по данным грузоотправителя
// и запускает штатные действия 1С-ЭДО: сформировать / подписать / подготовить / отправить —
// теми же вызовами, что кнопка «Отправить» в форме документа.
// Сначала используйте «Пробный режим», затем лимит 1 документ.

&НаКлиенте
Перем ОчередьДокументов, ИндексОчереди, СчетчикОтправлено;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КонецПериода = КонецДня(ТекущаяДата());
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -2));
	ПробныйРежим = Истина;
	ЛимитДокументов = 1;
	ТекстСостояния = "Груз принят в полном объеме";
	Для Каждого Имя Из СтрРазделить("Номер,Дата,Грузоотправитель,МестаОтпр,МассаОтпр,МестаПолуч,МассаПолуч,Проверка,Результат", ",") Цикл
		Элементы["Список" + Имя].ТолькоПросмотр = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	ЗаполнитьСписокНаСервере();
	Сообщить("Найдено документов: " + Список.Количество());
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из Список Цикл
		Стр.Выбран = (Стр.Проверка = "ОК");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Стр Из Список Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Документ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранные(Команда)

	ОчередьДокументов = Новый Массив;
	Для Каждого Стр Из Список Цикл
		Если Стр.Выбран И Стр.Проверка = "ОК" Тогда
			Если ЛимитДокументов > 0 И ОчередьДокументов.Количество() >= ЛимитДокументов Тогда
				Прервать;
			КонецЕсли;
			ОчередьДокументов.Добавить(Стр.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	Если ОчередьДокументов.Количество() = 0 Тогда
		Сообщить("Нет выбранных документов со статусом проверки ""ОК"".");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекстСостояния) Тогда
		Сообщить("Заполните «Фактическое состояние груза».");
		Возврат;
	КонецЕсли;

	Если ПробныйРежим Тогда
		ИндексОчереди = 0;
		СчетчикОтправлено = 0;
		ОбработатьСледующий();
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ПодписатьВыбранныеЗавершение", ЭтаФорма),
		"Подписать ЭЦП и ОТПРАВИТЬ титул грузополучателя по " + ОчередьДокументов.Количество()
		+ " ЭТрН? Действие необратимо.", РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранныеЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ИндексОчереди = 0;
	СчетчикОтправлено = 0;
	ОбработатьСледующий();
КонецПроцедуры

// Обрабатывает документы очереди по одному (подпись требует участия клиента и ЭЦП).
&НаКлиенте
Процедура ОбработатьСледующий()

	Если ИндексОчереди >= ОчередьДокументов.Количество() Тогда
		Сообщить("Готово. Отправлено документов: " + СчетчикОтправлено + " из " + ОчередьДокументов.Количество()
			+ ?(ПробныйРежим, " (пробный режим, ничего не отправлялось)", ""));
		Возврат;
	КонецЕсли;

	Стр = Список.НайтиПоИдентификатору(ОчередьДокументов[ИндексОчереди]);
	Подготовка = ПодготовитьНаСервере(Стр.Документ, Стр.МестаОтпр, Стр.МассаОтпр, ТекстСостояния, Не ПробныйРежим);
	Если Не Подготовка.Успех Тогда
		Стр.Результат = Подготовка.Сообщение;
		ИндексОчереди = ИндексОчереди + 1;
		ОбработатьСледующий();
		Возврат;
	КонецЕсли;
	Если ПробныйРежим Тогда
		Стр.Результат = "Пробный режим. " + Подготовка.Сообщение;
		ИндексОчереди = ИндексОчереди + 1;
		ОбработатьСледующий();
		Возврат;
	КонецЕсли;

	НаборДействий = Новый Соответствие;
	Для Каждого ИмяДействия Из Подготовка.Действия Цикл
		ИнтерфейсДокументовЭДОКлиентСервер.ДобавитьДействие(НаборДействий,
			ПредопределенноеЗначение("Перечисление.ДействияПоЭДО." + ИмяДействия));
	КонецЦикла;

	ПараметрыВыполнения = ИнтерфейсДокументовЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
	ПараметрыВыполнения.ОбъектыДействий.ОбъектыУчета.Добавить(Стр.Документ);
	ПараметрыВыполнения.НаборДействий = НаборДействий;

	ДопУспех = Новый Структура("НаборДействий, ЭтоИсправление, ИдентификаторСтроки", НаборДействий, Ложь, Неопределено);
	ДопВыполнения = Новый Структура;
	ДопВыполнения.Вставить("ЭтоИсправление", Ложь);
	ДопВыполнения.Вставить("ОповещениеУспешногоЗавершения",
		Новый ОписаниеОповещения("ПослеОтправкиДокумента", ЭтаФорма, ДопУспех, "ПослеОтправкиОшибка", ЭтаФорма));

	Оповещение = Новый ОписаниеОповещения("ПослеВыполненияДействийПоЭДО", ИнтерфейсДокументовЭДОКлиент, ДопВыполнения);
	ЭлектронныеДокументыЭДОКлиент.НачатьВыполнениеДействийПоЭДО(Оповещение, ПараметрыВыполнения);

КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиДокумента(Результат, ДопПараметры) Экспорт

	Стр = Список.НайтиПоИдентификатору(ОчередьДокументов[ИндексОчереди]);
	Отправлено = Ложь;
	Попытка
		ДействиеОтправить = ПредопределенноеЗначение("Перечисление.ДействияПоЭДО.Отправить");
		Количество = Результат.ОбработаноПоДействиям.Получить(ДействиеОтправить);
		Отправлено = (Количество <> Неопределено И Количество > 0);
	Исключение
		Отправлено = Ложь;
	КонецПопытки;

	Если Отправлено Тогда
		СчетчикОтправлено = СчетчикОтправлено + 1;
		Стр.Результат = ЗаписатьДокументПослеОтправки(Стр.Документ);
	Иначе
		Стр.Результат = "Не отправлено (отмена подписи или ошибка ЭДО)";
	КонецЕсли;

	ИндексОчереди = ИндексОчереди + 1;
	ОбработатьСледующий();

КонецПроцедуры

&НаКлиенте
Процедура ПослеОтправкиОшибка(ИнформацияОбОшибке, СтандартнаяОбработка, ДопПараметры) Экспорт

	СтандартнаяОбработка = Ложь;
	Стр = Список.НайтиПоИдентификатору(ОчередьДокументов[ИндексОчереди]);
	Стр.Результат = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	ИндексОчереди = ИндексОчереди + 1;
	ОбработатьСледующий();

КонецПроцедуры

// После успешной отправки форма документа записывает объект: это продвигает шаг документа.
&НаСервереБезКонтекста
Функция ЗаписатьДокументПослеОтправки(Док)
	Попытка
		ДокОбъект = Док.ПолучитьОбъект();
		ДокОбъект.Записать();
		Возврат "Отправлено";
	Исключение
		Возврат "Отправлено, но запись документа не удалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// Заполняет титул данными отправителя (если не пробный режим) и определяет набор действий ЭДО.
&НаСервереБезКонтекста
Функция ПодготовитьНаСервере(Док, Места, Масса, Состояние, Записывать)

	Результат = Новый Структура("Успех, Сообщение, Действия", Ложь, "", Новый Массив);
	Титул3 = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул3;

	Если Док.ТекущийТитул <> Титул3 Или Док.ТекущийШагВыполнен Тогда
		Результат.Сообщение = "Документ уже не на титуле грузополучателя";
		Возврат Результат;
	КонецЕсли;
	Если Места <= 0 Или Масса <= 0 Тогда
		Результат.Сообщение = "Нет данных груза у отправителя";
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ МАКСИМУМ(В.НомерВерсии) КАК НомерВерсии
		|ИЗ РегистрСведений.ВерсииТитуловЭПД КАК В
		|ГДЕ В.Документ = &Док И В.Титул = &Титул");
	Запрос.УстановитьПараметр("Док", Док);
	Запрос.УстановитьПараметр("Титул", Титул3);
	Выб = Запрос.Выполнить().Выбрать();
	НомерВерсии = 0;
	Если Выб.Следующий() И Выб.НомерВерсии <> Null Тогда
		НомерВерсии = Выб.НомерВерсии;
	КонецЕсли;

	Организация = Док.Организация;
	Если Записывать Тогда
		Попытка
			НачатьТранзакцию();
			ЗаписатьРеквизитТитула(Док, Организация, Титул3, НомерВерсии,
				"ТитулГрузополучателяОбщееКоличествоПринятыхГрузовыхМест", Места);
			ЗаписатьРеквизитТитула(Док, Организация, Титул3, НомерВерсии,
				"ТитулГрузополучателяМассаБруттоПринятогоГруза", Масса);
			ЗаписатьРеквизитТитула(Док, Организация, Титул3, НомерВерсии,
				"ТитулГрузополучателяФактическоеСостояниеГруза", Состояние);
			ЗафиксироватьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			Результат.Сообщение = "Ошибка записи значений титула: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;

	Сообщение = ОбменСГИСЭПДКлиентСервер.ПолучитьСообщениеТитула(Док, Титул3);
	СостояниеЭДО = ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Док).ПредставлениеСостояния;

	Действия = Результат.Действия;
	Если ЗначениеЗаполнено(Сообщение) = Ложь Или СостояниеЭДО = "Требуется повторная отправка" Тогда
		Действия.Добавить("СформироватьОтвет");
		Действия.Добавить("Подписать");
		Действия.Добавить("ПодготовитьКОтправке");
	Иначе
		Если СостояниеЭДО <> "Требуется подготовка к отправке" И СостояниеЭДО <> "Требуется отправка" Тогда
			Действия.Добавить("Подписать");
		КонецЕсли;
		Если СостояниеЭДО <> "Требуется отправка" Тогда
			Действия.Добавить("ПодготовитьКОтправке");
		КонецЕсли;
	КонецЕсли;
	Действия.Добавить("Отправить");

	Результат.Успех = Истина;
	Результат.Сообщение = "Мест: " + Места + ", брутто: " + Масса + ", состояние: «" + Состояние + "», версия титула " + НомерВерсии
		+ ", состояние ЭДО: " + СостояниеЭДО + ", действия: " + СтрСоединить(Действия, ", ");
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьРеквизитТитула(Док, Организация, Титул, НомерВерсии, ИмяРеквизита, Значение)

	Запись = РегистрыСведений.ЗначенияРеквизитовДокументовЭПД.СоздатьМенеджерЗаписи();
	Запись.Документ = Док;
	Запись.Организация = Организация;
	Запись.Титул = Титул;
	Запись.НомерВерсии = НомерВерсии;
	Запись.ИмяТабличнойЧасти = "";
	Запись.НомерСтрокиРеквизита = 0;
	Запись.ИмяРеквизита = ИмяРеквизита;
	Запись.Прочитать();
	Запись.Документ = Док;
	Запись.Организация = Организация;
	Запись.Титул = Титул;
	Запись.НомерВерсии = НомерВерсии;
	Запись.ИмяТабличнойЧасти = "";
	Запись.НомерСтрокиРеквизита = 0;
	Запись.ИмяРеквизита = ИмяРеквизита;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Запись.ЗначениеРеквизита = Неопределено;
		Запись.ЗначениеРеквизитаСсылка = Неопределено;
		Запись.ЗначениеРеквизитаСтрока = Значение;
		Запись.ТипРеквизита = Перечисления.ТипыРеквизитовЭПД.НеограниченнаяСтрока;
	Иначе
		Запись.ЗначениеРеквизита = Значение;
		Запись.ЗначениеРеквизитаСсылка = Неопределено;
		Запись.ЗначениеРеквизитаСтрока = "";
		Запись.ТипРеквизита = Перечисления.ТипыРеквизитовЭПД.ПростойКромеСтроки;
	КонецЕсли;
	Запись.Записать();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере()

	Список.Очистить();
	Титул3 = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул3;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка КАК Ссылка
		|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И Д.ЭтоВходящий И Д.ТекущийШаг = ""Приемка"" И НЕ Д.ТекущийШагВыполнен
		|	И Д.ТекущийТитул = &Титул3
		|	И Д.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОрганизации ИЛИ Д.Организация = &Организация)");
	Запрос.УстановитьПараметр("Титул3", Титул3);
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецПериода);
	Запрос.УстановитьПараметр("БезОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);

	Доки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Доки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Данные = Новый Соответствие;
	Для Каждого Док Из Доки Цикл
		Данные.Вставить(Док, Новый Структура("Номер, Дата, Грузоотправитель, МестаОтпр, МассаОтпр, МестаПолуч, МассаПолуч, СуммаМест, СуммаМасс",
			"", Дата(1, 1, 1), "", 0, 0, 0, 0, 0, 0));
	КонецЦикла;

	ЗапросЗнач = Новый Запрос(
		"ВЫБРАТЬ Р.Документ КАК Док, Р.ИмяТабличнойЧасти КАК ТЧ, Р.ИмяРеквизита КАК Имя,
		|	Р.ЗначениеРеквизита КАК Знач, Р.ЗначениеРеквизитаСсылка КАК Ссылка, Р.ЗначениеРеквизитаСтрока КАК ТекстЗнач
		|ИЗ РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК Р
		|ГДЕ Р.Документ В (&Доки)");
	ЗапросЗнач.УстановитьПараметр("Доки", Доки);
	Выб = ЗапросЗнач.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Д = Данные[Выб.Док];
		Имя = Выб.Имя;
		Если Выб.ТЧ = "ТитулГрузоотправителяГрузы" Тогда
			Если Имя = "КоличествоГрузовыхМест" Тогда
				Д.СуммаМест = Д.СуммаМест + ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "МассаБрутто" Тогда
				Д.СуммаМасс = Д.СуммаМасс + ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			КонецЕсли;
		ИначеЕсли Выб.ТЧ = "" Тогда
			Если Имя = "ТитулГрузоотправителяТранспортнаяНакладнаяНомер" Тогда
				Д.Номер = ТекстИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузоотправителяТранспортнаяНакладнаяДата" Тогда
				Если ТипЗнч(Выб.Знач) = Тип("Дата") Тогда
					Д.Дата = Выб.Знач;
				КонецЕсли;
			ИначеЕсли Имя = "СсылкаТитулГрузоотправителяГрузоотправитель" Тогда
				Д.Грузоотправитель = Строка(Выб.Ссылка);
			ИначеЕсли Имя = "ТитулГрузоотправителяКоличествоГрузовыхМест" Тогда
				Д.МестаОтпр = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузоотправителяМассаБруттоГруза" Тогда
				Д.МассаОтпр = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузополучателяОбщееКоличествоПринятыхГрузовыхМест" Тогда
				Д.МестаПолуч = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузополучателяМассаБруттоПринятогоГруза" Тогда
				Д.МассаПолуч = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Док Из Доки Цикл
		Д = Данные[Док];
		Если Д.МестаОтпр = 0 Тогда
			Д.МестаОтпр = Д.СуммаМест;
		КонецЕсли;
		Если Д.МассаОтпр = 0 Тогда
			Д.МассаОтпр = Д.СуммаМасс;
		КонецЕсли;
		Стр = Список.Добавить();
		Стр.Документ = Док;
		Стр.Номер = Д.Номер;
		Стр.Дата = Д.Дата;
		Стр.Грузоотправитель = Д.Грузоотправитель;
		Стр.МестаОтпр = Д.МестаОтпр;
		Стр.МассаОтпр = Д.МассаОтпр;
		Стр.МестаПолуч = Д.МестаПолуч;
		Стр.МассаПолуч = Д.МассаПолуч;
		Если Д.МестаОтпр = 0 Или Д.МассаОтпр = 0 Тогда
			Стр.Проверка = "Нет данных груза у отправителя";
		Иначе
			Стр.Проверка = "ОК";
			Если Д.МестаПолуч <> 0 Или Д.МассаПолуч <> 0 Тогда
				Если Д.МестаПолуч <> Д.МестаОтпр Или Окр(Д.МассаПолуч - Д.МассаОтпр, 3) <> 0 Тогда
					Стр.Результат = "В черновике титула другие значения: будут заменены данными отправителя";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Список.Сортировать("Дата, Номер");

КонецПроцедуры

&НаСервере
Функция ТекстИзЗначения(Знач, ТекстЗнач)
	Если ЗначениеЗаполнено(ТекстЗнач) Тогда
		Возврат ТекстЗнач;
	КонецЕсли;
	Возврат Строка(Знач);
КонецФункции

&НаСервере
Функция ЧислоИзЗначения(Знач, ТекстЗнач)

	Если ТипЗнч(Знач) = Тип("Число") И Знач <> 0 Тогда
		Возврат Знач;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(ТекстЗнач), ",", "."), " ", ""), Символы.НПП, "");
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
