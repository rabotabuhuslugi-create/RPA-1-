// Приёмка входящих ЭТрН: титул грузополучателя (ЭТрН_Титул3), шаг «Приемка».
// Заполняет в титуле количество мест, массу брутто и состояние груза по данным грузоотправителя
// и запускает штатные действия 1С-ЭДО: сформировать / подписать / подготовить / отправить —
// теми же вызовами, что кнопка «Отправить» в форме документа.
// Сначала используйте «Пробный режим», затем лимит 1 документ.

&НаКлиенте
Перем ОчередьДокументов, ИндексОчереди, СчетчикОтправлено, ОткрытаяФорма, ТекущийДокумент, СчетчикОжидания;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Рекв = Новый Массив;
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипЧисло3 = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));

	Рекв.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Рекв.Добавить(Новый РеквизитФормы("НачалоПериода", ТипДата, , "Документы с"));
	Рекв.Добавить(Новый РеквизитФормы("КонецПериода", ТипДата, , "по"));
	Рекв.Добавить(Новый РеквизитФормы("ПробныйРежим", ТипБулево, , "Пробный режим (ничего не менять и не отправлять)"));
	Рекв.Добавить(Новый РеквизитФормы("ЛимитДокументов",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)), , "Не более документов за запуск"));
	Рекв.Добавить(Новый РеквизитФормы("ТекстСостояния", ТипСтрока, , "Фактическое состояние груза"));
	Рекв.Добавить(Новый РеквизитФормы("Список", Новый ОписаниеТипов("ТаблицаЗначений"), , "Список"));
	Рекв.Добавить(Новый РеквизитФормы("Выбран", ТипБулево, "Список", "Выбрать"));
	Рекв.Добавить(Новый РеквизитФормы("Документ", Новый ОписаниеТипов("ДокументСсылка.ЭлектроннаяТранспортнаяНакладная"), "Список", "Документ"));
	Рекв.Добавить(Новый РеквизитФормы("Номер", ТипСтрока, "Список", "Номер ЭТрН"));
	Рекв.Добавить(Новый РеквизитФормы("Дата", ТипДата, "Список", "Дата"));
	Рекв.Добавить(Новый РеквизитФормы("Грузоотправитель", ТипСтрока, "Список", "Грузоотправитель"));
	Рекв.Добавить(Новый РеквизитФормы("МестаОтпр", ТипЧисло3, "Список", "Мест (отправитель)"));
	Рекв.Добавить(Новый РеквизитФормы("МассаОтпр", ТипЧисло3, "Список", "Брутто, кг (отправитель)"));
	Рекв.Добавить(Новый РеквизитФормы("МестаПолуч", ТипЧисло3, "Список", "Мест (наш титул)"));
	Рекв.Добавить(Новый РеквизитФормы("МассаПолуч", ТипЧисло3, "Список", "Брутто, кг (наш титул)"));
	Рекв.Добавить(Новый РеквизитФормы("Проверка", ТипСтрока, "Список", "Проверка"));
	Рекв.Добавить(Новый РеквизитФормы("Результат", ТипСтрока, "Список", "Результат"));
	ИзменитьРеквизиты(Рекв);

	ЭтаФорма["КонецПериода"] = КонецДня(ТекущаяДатаСеанса());
	ЭтаФорма["НачалоПериода"] = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -2));
	ЭтаФорма["ПробныйРежим"] = Истина;
	ЭтаФорма["ЛимитДокументов"] = 1;
	ЭтаФорма["ТекстСостояния"] = "Груз принят в полном объеме";

	// Команды и кнопки.
	Описание = Новый Структура;
	Описание.Вставить("ЗаполнитьСписок", "Заполнить список");
	Описание.Вставить("ВыбратьВсе", "Выбрать готовые");
	Описание.Вставить("СнятьВсе", "Снять все");
	Описание.Вставить("ПодписатьВыбранные", "Подписать и отправить выбранные");

	ГруппаШапка = Элементы.Добавить("ГруппаШапка", Тип("ГруппаФормы"), ЭтаФорма);
	ГруппаШапка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаШапка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаШапка.ОтображатьЗаголовок = Ложь;
	ГруппаШапка.Отображение = ОтображениеОбычнойГруппы.Нет;

	ГруппаПоля = Элементы.Добавить("ГруппаПоля", Тип("ГруппаФормы"), ГруппаШапка);
	ГруппаПоля.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПоля.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаПоля.ОтображатьЗаголовок = Ложь;
	ГруппаПоля.Отображение = ОтображениеОбычнойГруппы.Нет;

	ГруппаКнопки = Элементы.Добавить("ГруппаКнопки", Тип("ГруппаФормы"), ГруппаШапка);
	ГруппаКнопки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКнопки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаКнопки.ОтображатьЗаголовок = Ложь;
	ГруппаКнопки.Отображение = ОтображениеОбычнойГруппы.Нет;

	ДобавитьПолеВвода("Организация", "Организация", ГруппаПоля);
	ДобавитьПолеВвода("НачалоПериода", "НачалоПериода", ГруппаПоля);
	ДобавитьПолеВвода("КонецПериода", "КонецПериода", ГруппаПоля);
	ДобавитьПолеВвода("ЛимитДокументов", "ЛимитДокументов", ГруппаПоля);
	ДобавитьПолеВвода("ТекстСостояния", "ТекстСостояния", ГруппаПоля);
	Флажок = Элементы.Добавить("ПробныйРежим", Тип("ПолеФормы"), ГруппаПоля);
	Флажок.Вид = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = "ПробныйРежим";

	Для Каждого КиЗ Из Описание Цикл
		Команда = Команды.Добавить(КиЗ.Ключ);
		Команда.Действие = КиЗ.Ключ;
		Команда.Заголовок = КиЗ.Значение;
		Кнопка = Элементы.Добавить("Кн" + КиЗ.Ключ, Тип("КнопкаФормы"), ГруппаКнопки);
		Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		Кнопка.ИмяКоманды = КиЗ.Ключ;
		Кнопка.Заголовок = КиЗ.Значение;
	КонецЦикла;

	Таблица = Элементы.Добавить("Список", Тип("ТаблицаФормы"), ЭтаФорма);
	Таблица.ПутьКДанным = "Список";
	Таблица.УстановитьДействие("Выбор", "СписокВыбор");
	Колонка = Элементы.Добавить("СписокВыбран", Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеФлажка;
	Колонка.ПутьКДанным = "Список.Выбран";
	Для Каждого Имя Из СтрРазделить("Номер,Дата,Грузоотправитель,МестаОтпр,МассаОтпр,МестаПолуч,МассаПолуч,Проверка,Результат", ",") Цикл
		Колонка = Элементы.Добавить("Список" + Имя, Тип("ПолеФормы"), Таблица);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Список." + Имя;
		Колонка.ТолькоПросмотр = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеВвода(ИмяЭлемента, ПутьКДанным, Родитель)
	Поле = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПутьКДанным;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	ЗаполнитьСписокНаСервере();
	Сообщить("Найдено документов: " + ЭтаФорма["Список"].Количество());
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из ЭтаФорма["Список"] Цикл
		Стр.Выбран = (Стр.Проверка = "ОК");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Стр Из ЭтаФорма["Список"] Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Документ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранные(Команда)

	ОчередьДокументов = Новый Массив;
	Для Каждого Стр Из ЭтаФорма["Список"] Цикл
		Если Стр.Выбран И Стр.Проверка = "ОК" Тогда
			Если ЭтаФорма["ЛимитДокументов"] > 0 И ОчередьДокументов.Количество() >= ЭтаФорма["ЛимитДокументов"] Тогда
				Прервать;
			КонецЕсли;
			ОчередьДокументов.Добавить(Стр.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	Если ОчередьДокументов.Количество() = 0 Тогда
		Сообщить("Нет выбранных документов со статусом проверки ""ОК"".");
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ЭтаФорма["ТекстСостояния"]) Тогда
		Сообщить("Заполните «Фактическое состояние груза».");
		Возврат;
	КонецЕсли;

	Если ЭтаФорма["ПробныйРежим"] Тогда
		ИндексОчереди = 0;
		СчетчикОтправлено = 0;
		ОбработатьСледующий();
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ПодписатьВыбранныеЗавершение", ЭтаФорма),
		"Подписать ЭЦП и ОТПРАВИТЬ титул грузополучателя по " + ОчередьДокументов.Количество()
		+ " ЭТрН? Действие необратимо.", РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранныеЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ИндексОчереди = 0;
	СчетчикОтправлено = 0;
	ОбработатьСледующий();
КонецПроцедуры

// Обрабатывает документы очереди по одному: открывает штатную форму документа и выполняет те же действия,
// что пользователь (заполнить поля приёмки, «Отправить»).
&НаКлиенте
Процедура ОбработатьСледующий()

	Если ИндексОчереди >= ОчередьДокументов.Количество() Тогда
		Сообщить("Готово. Отправлено документов: " + СчетчикОтправлено + " из " + ОчередьДокументов.Количество()
			+ ?(ЭтаФорма["ПробныйРежим"], " (пробный режим, ничего не отправлялось)", ""));
		Возврат;
	КонецЕсли;

	Стр = ЭтаФорма["Список"].НайтиПоИдентификатору(ОчередьДокументов[ИндексОчереди]);
	Подготовка = ПодготовитьНаСервере(Стр.Документ, Стр.МестаОтпр, Стр.МассаОтпр, ЭтаФорма["ТекстСостояния"]);
	Если Не Подготовка.Успех Тогда
		Стр.Результат = Подготовка.Сообщение;
		ИндексОчереди = ИндексОчереди + 1;
		ОбработатьСледующий();
		Возврат;
	КонецЕсли;
	Если ЭтаФорма["ПробныйРежим"] Тогда
		Стр.Результат = "Пробный режим. " + Подготовка.Сообщение;
		ИндексОчереди = ИндексОчереди + 1;
		ОбработатьСледующий();
		Возврат;
	КонецЕсли;

	ТекущийДокумент = Стр.Документ;
	ОткрытаяФорма = ОткрытьФорму("Документ.ЭлектроннаяТранспортнаяНакладная.Форма.ОсновнаяФорма",
		Новый Структура("Ключ", ТекущийДокумент), , ТекущийДокумент);
	ПодключитьОбработчикОжидания("ЗаполнитьИОтправить", 3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИОтправить()

	Стр = ЭтаФорма["Список"].НайтиПоИдентификатору(ОчередьДокументов[ИндексОчереди]);
	Попытка
		ОбменСГИСЭПДКлиентСервер.УстановитьЗначениеРеквизитаВСтруктуреФормы(ОткрытаяФорма,
			"ТитулГрузополучателяОбщееКоличествоПринятыхГрузовыхМест", Стр.МестаОтпр, , , Истина);
		ОбменСГИСЭПДКлиентСервер.УстановитьЗначениеРеквизитаВСтруктуреФормы(ОткрытаяФорма,
			"ТитулГрузополучателяМассаБруттоПринятогоГруза", Стр.МассаОтпр, , , Истина);
		ОбменСГИСЭПДКлиентСервер.УстановитьЗначениеРеквизитаВСтруктуреФормы(ОткрытаяФорма,
			"ТитулГрузополучателяФактическоеСостояниеГруза", ЭтаФорма["ТекстСостояния"], , , Истина);
		ОбменСГИСЭПДКлиент.ОтправитьЭПД(ОткрытаяФорма, Ложь, Ложь);
	Исключение
		Стр.Результат = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗакрытьФормуИПерейтиДалее();
		Возврат;
	КонецПопытки;

	СчетчикОжидания = 0;
	ПодключитьОбработчикОжидания("ПроверитьОтправку", 3);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОтправку()

	СчетчикОжидания = СчетчикОжидания + 1;
	Стр = ЭтаФорма["Список"].НайтиПоИдентификатору(ОчередьДокументов[ИндексОчереди]);

	Если ШагДокументаВыполнен(ТекущийДокумент) Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтправку");
		СчетчикОтправлено = СчетчикОтправлено + 1;
		Стр.Результат = "Отправлено";
		ЗакрытьФормуИПерейтиДалее();
	ИначеЕсли СчетчикОжидания >= 60 Тогда
		ОтключитьОбработчикОжидания("ПроверитьОтправку");
		Стр.Результат = "Нет подтверждения отправки за 3 минуты. Проверьте открытую форму документа (ошибки заполнения, подпись). Очередь остановлена.";
		Сообщить(Стр.Результат);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуИПерейтиДалее()

	Если ОткрытаяФорма <> Неопределено И ОткрытаяФорма.Открыта() Тогда
		ОткрытаяФорма.Модифицированность = Ложь;
		ОткрытаяФорма.Закрыть();
	КонецЕсли;
	ОткрытаяФорма = Неопределено;
	ИндексОчереди = ИндексОчереди + 1;
	ОбработатьСледующий();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ШагДокументаВыполнен(Док)
	Запрос = Новый Запрос("ВЫБРАТЬ Д.ТекущийШагВыполнен КАК Выполнен ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д ГДЕ Д.Ссылка = &Док");
	Запрос.УстановитьПараметр("Док", Док);
	Выб = Запрос.Выполнить().Выбрать();
	Возврат Выб.Следующий() И Выб.Выполнен = Истина;
КонецФункции

// Заполняет титул данными отправителя (если не пробный режим) и определяет набор действий ЭДО.
&НаСервереБезКонтекста
Функция ПодготовитьНаСервере(Док, Места, Масса, Состояние)

	Результат = Новый Структура("Успех, Сообщение, Действия", Ложь, "", Новый Массив);
	Титул3 = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул3;

	Если Док.ТекущийТитул <> Титул3 Или Док.ТекущийШагВыполнен Тогда
		Результат.Сообщение = "Документ уже не на титуле грузополучателя";
		Возврат Результат;
	КонецЕсли;
	Если Места <= 0 Или Масса <= 0 Тогда
		Результат.Сообщение = "Нет данных груза у отправителя";
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ МАКСИМУМ(Версии.НомерВерсии) КАК НомерВерсии
		|ИЗ РегистрСведений.ВерсииТитуловЭПД КАК Версии
		|ГДЕ Версии.Документ = &Док И Версии.Титул = &Титул");
	Запрос.УстановитьПараметр("Док", Док);
	Запрос.УстановитьПараметр("Титул", Титул3);
	Выб = Запрос.Выполнить().Выбрать();
	НомерВерсии = 0;
	Если Выб.Следующий() И Выб.НомерВерсии <> Null Тогда
		НомерВерсии = Выб.НомерВерсии;
	КонецЕсли;

	Если ПустаяСтрока(Док.ИдентификаторГрузоотправителя) Или ПустаяСтрока(Док.ИдентификаторГрузополучателя)
		Или ПустаяСтрока(Док.ИдентификаторПеревозчика) Тогда
		Результат.Сообщение = "Не заполнены идентификаторы участников обмена (нужна ручная настройка в форме документа)";
		Возврат Результат;
	КонецЕсли;

	Сообщение = ОбменСГИСЭПДКлиентСервер.ПолучитьСообщениеТитула(Док, Титул3);
	СостояниеЭДО = ИнтеграцияЭДОВызовСервера.ДанныеСостоянияЭДОДляФормыОбъектаУчета(Док).ПредставлениеСостояния;

	Действия = Результат.Действия;
	Если ЗначениеЗаполнено(Сообщение) = Ложь Или СостояниеЭДО = "Требуется повторная отправка" Тогда
		Действия.Добавить("СформироватьОтвет");
		Действия.Добавить("Подписать");
		Действия.Добавить("ПодготовитьКОтправке");
	Иначе
		Если СостояниеЭДО <> "Требуется подготовка к отправке" И СостояниеЭДО <> "Требуется отправка" Тогда
			Действия.Добавить("Подписать");
		КонецЕсли;
		Если СостояниеЭДО <> "Требуется отправка" Тогда
			Действия.Добавить("ПодготовитьКОтправке");
		КонецЕсли;
	КонецЕсли;
	Действия.Добавить("Отправить");

	Результат.Успех = Истина;
	Результат.Сообщение = "Через форму документа. Мест: " + Места + ", брутто: " + Масса + ", состояние: «" + Состояние + "», версия титула " + НомерВерсии
		+ ", состояние ЭДО: " + СостояниеЭДО + ", действия: " + СтрСоединить(Действия, ", ");
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокНаСервере()

	Таб = ЭтаФорма["Список"];
	Таб.Очистить();
	Титул3 = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул3;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка КАК Ссылка
		|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И Д.ЭтоВходящий И Д.ТекущийШаг = ""Приемка"" И НЕ Д.ТекущийШагВыполнен
		|	И Д.ТекущийТитул = &Титул3
		|	И Д.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОрганизации ИЛИ Д.Организация = &Организация)");
	Запрос.УстановитьПараметр("Титул3", Титул3);
	Запрос.УстановитьПараметр("Начало", ЭтаФорма["НачалоПериода"]);
	Запрос.УстановитьПараметр("Конец", ЭтаФорма["КонецПериода"]);
	Запрос.УстановитьПараметр("БезОрганизации", Не ЗначениеЗаполнено(ЭтаФорма["Организация"]));
	Запрос.УстановитьПараметр("Организация", ЭтаФорма["Организация"]);

	Доки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Доки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Данные = Новый Соответствие;
	Для Каждого Док Из Доки Цикл
		Данные.Вставить(Док, Новый Структура("Номер, Дата, Грузоотправитель, МестаОтпр, МассаОтпр, МестаПолуч, МассаПолуч, СуммаМест, СуммаМасс",
			"", Дата(1, 1, 1), "", 0, 0, 0, 0, 0, 0));
	КонецЦикла;

	ЗапросЗнач = Новый Запрос(
		"ВЫБРАТЬ Р.Документ КАК Док, Р.ИмяТабличнойЧасти КАК ТЧ, Р.ИмяРеквизита КАК Имя,
		|	Р.ЗначениеРеквизита КАК Значение0, Р.ЗначениеРеквизитаСсылка КАК Ссылка, Р.ЗначениеРеквизитаСтрока КАК ТекстЗнач
		|ИЗ РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК Р
		|ГДЕ Р.Документ В (&Доки)");
	ЗапросЗнач.УстановитьПараметр("Доки", Доки);
	Выб = ЗапросЗнач.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Д = Данные[Выб.Док];
		Имя = Выб.Имя;
		Если Выб.ТЧ = "ТитулГрузоотправителяГрузы" Тогда
			Если Имя = "КоличествоГрузовыхМест" Тогда
				Д.СуммаМест = Д.СуммаМест + ЧислоИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			ИначеЕсли Имя = "МассаБрутто" Тогда
				Д.СуммаМасс = Д.СуммаМасс + ЧислоИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			КонецЕсли;
		ИначеЕсли Выб.ТЧ = "" Тогда
			Если Имя = "ТитулГрузоотправителяТранспортнаяНакладнаяНомер" Тогда
				Д.Номер = ТекстИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузоотправителяТранспортнаяНакладнаяДата" Тогда
				Если ТипЗнч(Выб.Значение0) = Тип("Дата") Тогда
					Д.Дата = Выб.Значение0;
				КонецЕсли;
			ИначеЕсли Имя = "СсылкаТитулГрузоотправителяГрузоотправитель" Тогда
				Д.Грузоотправитель = Строка(Выб.Ссылка);
			ИначеЕсли Имя = "ТитулГрузоотправителяКоличествоГрузовыхМест" Тогда
				Д.МестаОтпр = ЧислоИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузоотправителяМассаБруттоГруза" Тогда
				Д.МассаОтпр = ЧислоИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузополучателяОбщееКоличествоПринятыхГрузовыхМест" Тогда
				Д.МестаПолуч = ЧислоИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузополучателяМассаБруттоПринятогоГруза" Тогда
				Д.МассаПолуч = ЧислоИзЗначения(Выб.Значение0, Выб.ТекстЗнач);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Док Из Доки Цикл
		Д = Данные[Док];
		Если Д.МестаОтпр = 0 Тогда
			Д.МестаОтпр = Д.СуммаМест;
		КонецЕсли;
		Если Д.МассаОтпр = 0 Тогда
			Д.МассаОтпр = Д.СуммаМасс;
		КонецЕсли;
		Стр = Таб.Добавить();
		Стр.Документ = Док;
		Стр.Номер = Д.Номер;
		Стр.Дата = Д.Дата;
		Если ПустаяСтрока(Д.Номер) Тогда
			Стр.Номер = "(№ ИБ " + Док.Номер + ")";
			Стр.Дата = Док.Дата;
		КонецЕсли;
		Стр.Грузоотправитель = Д.Грузоотправитель;
		Стр.МестаОтпр = Д.МестаОтпр;
		Стр.МассаОтпр = Д.МассаОтпр;
		Стр.МестаПолуч = Д.МестаПолуч;
		Стр.МассаПолуч = Д.МассаПолуч;
		Если ПустаяСтрока(Д.Номер) Тогда
			Стр.Проверка = "Пустой документ: нет титула отправителя";
		ИначеЕсли Д.МестаОтпр = 0 Или Д.МассаОтпр = 0 Тогда
			Стр.Проверка = "Нет данных груза у отправителя";
		Иначе
			Стр.Проверка = "ОК";
			Если Д.МестаПолуч <> 0 Или Д.МассаПолуч <> 0 Тогда
				Если Д.МестаПолуч <> Д.МестаОтпр Или Окр(Д.МассаПолуч - Д.МассаОтпр, 3) <> 0 Тогда
					Стр.Результат = "В черновике титула другие значения: будут заменены данными отправителя";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Таб.Сортировать("Дата, Номер");

КонецПроцедуры

&НаСервере
Функция ТекстИзЗначения(Зн, ТекстЗнач)
	Если ЗначениеЗаполнено(ТекстЗнач) Тогда
		Возврат ТекстЗнач;
	КонецЕсли;
	Возврат Строка(Зн);
КонецФункции

&НаСервере
Функция ЧислоИзЗначения(Зн, ТекстЗнач)

	Если ТипЗнч(Зн) = Тип("Число") И Зн <> 0 Тогда
		Возврат Зн;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(ТекстЗнач), ",", "."), " ", ""), Символы.НПП, "");
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
