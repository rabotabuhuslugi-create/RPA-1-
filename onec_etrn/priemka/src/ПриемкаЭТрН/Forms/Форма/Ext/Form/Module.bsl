// Приёмка входящих ЭТрН (шаг «Приемка», титул грузополучателя).
// Сборка 1: список, проверка черновика титула по данным грузоотправителя, открытие документа.
// Подписание и отправка: точка подключения ПодписатьИОтправитьТитул (см. ниже) — требует
// процедуры 1С-ЭПД, имя которой в вашей конфигурации пока неизвестно.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КонецПериода = КонецДня(ТекущаяДата());
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -2));
	Для Каждого Имя Из СтрРазделить("Номер,Дата,Грузоотправитель,МестаОтпр,МассаОтпр,МестаПолуч,МассаПолуч,Проверка,Результат", ",") Цикл
		Элементы["Список" + Имя].ТолькоПросмотр = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	ЗаполнитьСписокНаСервере();
	Сообщить("Найдено документов: " + Список.Количество());
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из Список Цикл
		Стр.Выбран = (Стр.Проверка = "ОК");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Стр Из Список Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Документ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранные(Команда)
	Количество = 0;
	Для Каждого Стр Из Список Цикл
		Если Стр.Выбран И Стр.Проверка = "ОК" Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Если Количество = 0 Тогда
		Сообщить("Нет выбранных документов со статусом проверки ""ОК"".");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодписатьВыбранныеЗавершение", ЭтаФорма),
		"Подписать ЭЦП и отправить титул грузополучателя по " + Количество + " ЭТрН? Действие необратимо.",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранныеЗавершение(Ответ, ДопПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из Список Цикл
		Если Стр.Выбран И Стр.Проверка = "ОК" Тогда
			Стр.Результат = ОтправитьНаСервере(Стр.Документ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьНаСервере(Документ)
	Попытка
		Возврат ПодписатьИОтправитьТитул(Документ);
	Исключение
		Возврат "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// ТОЧКА ПОДКЛЮЧЕНИЯ. Здесь должен быть вызов штатной процедуры 1С-ЭПД, которая формирует титул
// грузополучателя, подписывает его ЭЦП и отправляет оператору (то же, что кнопка «Отправить»
// на шаге «Приемка»). Пока не реализовано, чтобы не подписывать «вслепую».
&НаСервереБезКонтекста
Функция ПодписатьИОтправитьТитул(Документ)
	Возврат "Не реализовано: нужна процедура подписания 1С-ЭПД";
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокНаСервере()

	Список.Очистить();

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка КАК Ссылка, ПРЕДСТАВЛЕНИЕ(Д.ТекущийТитул) КАК Титул
		|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И Д.ЭтоВходящий И Д.ТекущийШаг = ""Приемка"" И НЕ Д.ТекущийШагВыполнен
		|	И Д.Дата МЕЖДУ &Начало И &Конец
		|	И (&БезОрганизации ИЛИ Д.Организация = &Организация)");
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецПериода);
	Запрос.УстановитьПараметр("БезОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);

	Доки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строка(Выборка.Титул) = "Информация грузополучателя" Тогда
			Доки.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Доки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Данные = Новый Соответствие;
	Для Каждого Док Из Доки Цикл
		Данные.Вставить(Док, Новый Структура("Номер, Дата, Грузоотправитель, МестаОтпр, МассаОтпр, МестаПолуч, МассаПолуч, СуммаМест, СуммаМасс",
			"", Дата(1, 1, 1), "", 0, 0, 0, 0, 0, 0));
	КонецЦикла;

	ЗапросЗнач = Новый Запрос(
		"ВЫБРАТЬ Р.Документ КАК Док, Р.ИмяТабличнойЧасти КАК ТЧ, Р.ИмяРеквизита КАК Имя,
		|	Р.ЗначениеРеквизита КАК Знач, Р.ЗначениеРеквизитаСсылка КАК Ссылка, Р.ЗначениеРеквизитаСтрока КАК ТекстЗнач
		|ИЗ РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК Р
		|ГДЕ Р.Документ В (&Доки)");
	ЗапросЗнач.УстановитьПараметр("Доки", Доки);
	Выб = ЗапросЗнач.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Д = Данные[Выб.Док];
		Имя = Выб.Имя;
		Если Выб.ТЧ = "ТитулГрузоотправителяГрузы" Тогда
			Если Имя = "КоличествоГрузовыхМест" Тогда
				Д.СуммаМест = Д.СуммаМест + ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "МассаБрутто" Тогда
				Д.СуммаМасс = Д.СуммаМасс + ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			КонецЕсли;
		ИначеЕсли Выб.ТЧ = "" Тогда
			Если Имя = "ТитулГрузоотправителяТранспортнаяНакладнаяНомер" Тогда
				Д.Номер = ТекстИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузоотправителяТранспортнаяНакладнаяДата" Тогда
				Если ТипЗнч(Выб.Знач) = Тип("Дата") Тогда
					Д.Дата = Выб.Знач;
				КонецЕсли;
			ИначеЕсли Имя = "СсылкаТитулГрузоотправителяГрузоотправитель" Тогда
				Д.Грузоотправитель = Строка(Выб.Ссылка);
			ИначеЕсли Имя = "ТитулГрузоотправителяКоличествоГрузовыхМест" Тогда
				Д.МестаОтпр = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузоотправителяМассаБруттоГруза" Тогда
				Д.МассаОтпр = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузополучателяОбщееКоличествоПринятыхГрузовыхМест" Тогда
				Д.МестаПолуч = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			ИначеЕсли Имя = "ТитулГрузополучателяМассаБруттоПринятогоГруза" Тогда
				Д.МассаПолуч = ЧислоИзЗначения(Выб.Знач, Выб.ТекстЗнач);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Док Из Доки Цикл
		Д = Данные[Док];
		Если Д.МестаОтпр = 0 Тогда
			Д.МестаОтпр = Д.СуммаМест;
		КонецЕсли;
		Если Д.МассаОтпр = 0 Тогда
			Д.МассаОтпр = Д.СуммаМасс;
		КонецЕсли;
		Стр = Список.Добавить();
		Стр.Документ = Док;
		Стр.Номер = Д.Номер;
		Стр.Дата = Д.Дата;
		Стр.Грузоотправитель = Д.Грузоотправитель;
		Стр.МестаОтпр = Д.МестаОтпр;
		Стр.МассаОтпр = Д.МассаОтпр;
		Стр.МестаПолуч = Д.МестаПолуч;
		Стр.МассаПолуч = Д.МассаПолуч;
		Если Д.МестаОтпр = 0 Или Д.МассаОтпр = 0 Тогда
			Стр.Проверка = "Нет данных груза у отправителя";
		ИначеЕсли Д.МестаПолуч = 0 И Д.МассаПолуч = 0 Тогда
			Стр.Проверка = "Титул грузополучателя не заполнен";
		ИначеЕсли Д.МестаПолуч <> Д.МестаОтпр Или Окр(Д.МассаПолуч - Д.МассаОтпр, 3) <> 0 Тогда
			Стр.Проверка = "Расхождение с отправителем";
		Иначе
			Стр.Проверка = "ОК";
		КонецЕсли;
	КонецЦикла;

	Список.Сортировать("Дата, Номер");

КонецПроцедуры

&НаСервере
Функция ТекстИзЗначения(Знач, ТекстЗнач)
	Если ЗначениеЗаполнено(ТекстЗнач) Тогда
		Возврат ТекстЗнач;
	КонецЕсли;
	Возврат Строка(Знач);
КонецФункции

&НаСервере
Функция ЧислоИзЗначения(Знач, ТекстЗнач)

	Если ТипЗнч(Знач) = Тип("Число") И Знач <> 0 Тогда
		Возврат Знач;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(ТекстЗнач), ",", "."), " ", ""), Символы.НПП, "");
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
