// Модуль управляемой формы внешней обработки "РазведкаЭПД".
// Форма пустая: реквизит и кнопка создаются программно, чтобы не рисовать форму вручную.
// Задача: показать, как в ВАШЕЙ базе называются объекты 1С-ЭПД (ЭТрН),
// чтобы затем написать точный код подписания.

&НаКлиенте
Процедура СобратьКоманда(Команда)
	СобратьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СобратьНаСервере()

	Маски = Новый Массив;
	Маски.Добавить("ЭПД");
	Маски.Добавить("Перевоз");
	Маски.Добавить("ЭТрН");
	Маски.Добавить("Транспортн");

	Текст = Новый Массив;
	Текст.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);

	Коллекции = Новый Структура;
	Коллекции.Insert("Документ", Метаданные.Документы);
	Коллекции.Insert("Справочник", Метаданные.Справочники);
	Коллекции.Insert("РегистрСведений", Метаданные.РегистрыСведений);
	Коллекции.Insert("ОбщийМодуль", Метаданные.ОбщиеМодули);
	Коллекции.Insert("Перечисление", Метаданные.Перечисления);
	Коллекции.Insert("Подсистема", Метаданные.Подсистемы);
	Коллекции.Insert("ОбщаяФорма", Метаданные.ОбщиеФормы);
	Коллекции.Insert("Обработка", Метаданные.Обработки);

	Для Каждого Элемент Из Коллекции Цикл
		Для Каждого ОбъектМД Из Элемент.Значение Цикл
			Если ПодходитПоМаске(ОбъектМД.Имя + " " + ОбъектМД.Синоним, Маски) Тогда
				Текст.Добавить(Элемент.Ключ + "." + ОбъектМД.Имя + "  | " + ОбъектМД.Синоним);
				ДобавитьПодробности(Текст, Элемент.Ключ, ОбъектМД);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = СтрСоединить(Текст, Символы.ПС);
	Сообщить(Результат);
	ТекстОтчета = Результат;

КонецПроцедуры

&НаСервере
Функция ПодходитПоМаске(Строка, Маски)
	Для Каждого Маска Из Маски Цикл
		Если СтрНайти(НРег(Строка), НРег(Маска)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ДобавитьПодробности(Текст, Вид, ОбъектМД)

	Если Вид = "Перечисление" Тогда
		Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
			Текст.Добавить("      значение: " + Значение.Имя + " | " + Значение.Синоним);
		КонецЦикла;
	ИначеЕсли Вид = "Документ" Или Вид = "Справочник" Или Вид = "РегистрСведений" Тогда
		Поля = Новый Массив;
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Поля.Добавить(Реквизит.Имя);
		КонецЦикла;
		Если Поля.Количество() > 0 Тогда
			Текст.Добавить("      реквизиты: " + СтрСоединить(Поля, ", "));
		КонецЕсли;
	ИначеЕсли Вид = "ОбщийМодуль" Тогда
		Текст.Добавить("      клиент=" + ОбъектМД.КлиентУправляемоеПриложение
			+ " сервер=" + ОбъектМД.Сервер + " вызовСервера=" + ОбъектМД.ВызовСервера);
	КонецЕсли;

КонецПроцедуры
