// Разведка ЭПД, этап 2: структура объектов ЭТрН и живые данные.
// Ничего не меняет в базе, только читает.

&НаКлиенте
Процедура СобратьКоманда(Команда)
	СобратьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СобратьНаСервере()

	Т = Новый Массив;
	Т.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);

	// 1) Документ, ожидающий нашей подписи; 2) уже принятый (для образца заполненных значений).
	Для Каждого Выполнен Из Новый Структура("Ожидает, Принят", Ложь, Истина) Цикл
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 500 Д.Ссылка КАК Ссылка, ПРЕДСТАВЛЕНИЕ(Д.ТекущийТитул) КАК Титул
			|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
			|ГДЕ НЕ Д.ПометкаУдаления И Д.ЭтоВходящий И Д.ТекущийШаг = ""Приемка""
			|	И Д.ТекущийШагВыполнен = &Выполнен");
		Запрос.УстановитьПараметр("Выполнен", Выполнен.Значение);
		Выборка = Запрос.Выполнить().Выбрать();
		Т.Добавить("");
		Т.Добавить("######## " + Выполнен.Ключ + " ########");
		Найден = Неопределено;
		Пока Выборка.Следующий() Цикл
			Если Строка(Выборка.Титул) = "Информация грузополучателя" Тогда
				Найден = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найден = Неопределено Тогда
			Т.Добавить("нет такого документа");
			Продолжить;
		КонецЕсли;
		Т.Добавить("Документ: " + Строка(Найден));
		ВывестиРеквизитыЭПД(Т, Найден);
	КонецЦикла;

	Результат = СтрСоединить(Т, Символы.ПС);
	Сообщить(Результат);
	ТекстОтчета = Результат;

КонецПроцедуры

&НаСервере
Процедура ВывестиРеквизитыЭПД(Т, Док)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПРЕДСТАВЛЕНИЕ(Р.Титул) КАК Титул, Р.НомерВерсии КАК НомерВерсии,
		|	Р.ИмяТабличнойЧасти КАК ТЧ, Р.НомерСтрокиРеквизита КАК НомерСтроки, Р.ИмяРеквизита КАК Имя,
		|	Р.ЗначениеРеквизита КАК Знач, Р.ЗначениеРеквизитаСсылка КАК Ссылка, Р.ЗначениеРеквизитаСтрока КАК Строка
		|ИЗ РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК Р
		|ГДЕ Р.Документ = &Док");
	Запрос.УстановитьПараметр("Док", Док);
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Если СтрНайти(Выб.Имя, "ЭлектроннаяПодпись") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Значение = ?(ЗначениеЗаполнено(Выб.Строка), Выб.Строка, ?(ЗначениеЗаполнено(Выб.Ссылка), Строка(Выб.Ссылка), ?(ЗначениеЗаполнено(Выб.Знач), Строка(Выб.Знач), "")));
		Если Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(Значение) > 200 Тогда
			Значение = Лев(Значение, 200) + "...";
		КонецЕсли;
		Т.Добавить(Выб.Титул + " | v" + Выб.НомерВерсии + " | " + ?(Выб.ТЧ = "", "", Выб.ТЧ + "[" + Выб.НомерСтроки + "] ")
			+ Выб.Имя + " = " + Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОписатьОбъектМД(Т, ОМД)

	Для Каждого Р Из ОМД.Реквизиты Цикл
		Т.Добавить("реквизит " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
	КонецЦикла;

	Если ЕстьСвойство(ОМД, "Измерения") Тогда
		Для Каждого Р Из ОМД.Измерения Цикл
			Т.Добавить("измерение " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Ресурсы") Тогда
		Для Каждого Р Из ОМД.Ресурсы Цикл
			Т.Добавить("ресурс " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "ТабличныеЧасти") Тогда
		Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
			Т.Добавить("табличная часть " + ТЧ.Имя);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Формы") Тогда
		Для Каждого Ф Из ОМД.Формы Цикл
			Т.Добавить("форма " + Ф.Имя + " | " + Ф.Синоним);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Команды") Тогда
		Для Каждого К Из ОМД.Команды Цикл
			Т.Добавить("команда " + К.Имя + " | " + К.Синоним);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Макеты") Тогда
		Для Каждого М Из ОМД.Макеты Цикл
			Т.Добавить("макет " + М.Имя);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьСвойство(ОМД, Имя)
	Структура = Новый Структура(Имя);
	ЗаполнитьЗначенияСвойств(Структура, ОМД);
	Возврат Структура[Имя] <> Неопределено;
КонецФункции

&НаСервере
Функция ТипыСтрокой(ОписаниеТипа)

	Части = Новый Массив;
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		МД = Метаданные.НайтиПоТипу(Тип);
		Если МД <> Неопределено Тогда
			Части.Добавить(МД.ПолноеИмя());
		Иначе
			Части.Добавить(Строка(Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции
