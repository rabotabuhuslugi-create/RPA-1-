// Разведка ЭПД, этап 2: структура объектов ЭТрН и живые данные.
// Ничего не меняет в базе, только читает.

&НаКлиенте
Процедура СобратьКоманда(Команда)
	СобратьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СобратьНаСервере()

	Т = Новый Массив;
	Т.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);

	Т.Добавить("");
	Т.Добавить("=== ДОКУМЕНТ ЭлектроннаяТранспортнаяНакладная ===");
	ОписатьОбъектМД(Т, Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная);

	Т.Добавить("");
	Т.Добавить("=== РЕГИСТР РеестрЭПД ===");
	ОписатьОбъектМД(Т, Метаданные.РегистрыСведений.РеестрЭПД);

	Т.Добавить("");
	Т.Добавить("=== РЕГИСТР ВерсииТитуловЭПД ===");
	ОписатьОбъектМД(Т, Метаданные.РегистрыСведений.ВерсииТитуловЭПД);

	Т.Добавить("");
	Т.Добавить("=== ОБРАБОТКА ГрупповаяОтправкаЭПД ===");
	ОписатьОбъектМД(Т, Метаданные.Обработки.ГрупповаяОтправкаЭПД);

	Т.Добавить("");
	Т.Добавить("=== ОБРАБОТКА ЭлектронныеПеревозочныеДокументы ===");
	ОписатьОбъектМД(Т, Метаданные.Обработки.ЭлектронныеПеревозочныеДокументы);

	Т.Добавить("");
	Т.Добавить("=== ДАННЫЕ: группировка ЭТрН по шагу ===");
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	ПРЕДСТАВЛЕНИЕ(Д.ТекущийШаг) КАК Шаг,
			|	Д.ТекущийШагВыполнен КАК Выполнен,
			|	Д.ЭтоВходящий КАК Входящий,
			|	ПРЕДСТАВЛЕНИЕ(Д.ВидДокумента) КАК Вид,
			|	ПРЕДСТАВЛЕНИЕ(Д.РольУчастника) КАК Роль,
			|	ПРЕДСТАВЛЕНИЕ(Д.ТекущийТитул) КАК Титул,
			|	ПРЕДСТАВЛЕНИЕ(Д.ТекущийПолученныйТитул) КАК ПолученныйТитул,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
			|ГДЕ НЕ Д.ПометкаУдаления
			|СГРУППИРОВАТЬ ПО ПРЕДСТАВЛЕНИЕ(Д.ТекущийШаг), Д.ТекущийШагВыполнен, Д.ЭтоВходящий,
			|	ПРЕДСТАВЛЕНИЕ(Д.ВидДокумента), ПРЕДСТАВЛЕНИЕ(Д.РольУчастника),
			|	ПРЕДСТАВЛЕНИЕ(Д.ТекущийТитул), ПРЕДСТАВЛЕНИЕ(Д.ТекущийПолученныйТитул)");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Т.Добавить("шаг=" + Выборка.Шаг + " | выполнен=" + Выборка.Выполнен + " | входящий=" + Выборка.Входящий
				+ " | вид=" + Выборка.Вид + " | роль=" + Выборка.Роль + " | титул=" + Выборка.Титул
				+ " | полученныйТитул=" + Выборка.ПолученныйТитул + " | шт=" + Выборка.Количество);
		КонецЦикла;
	Исключение
		Т.Добавить("ОШИБКА запроса: " + ОписаниеОшибки());
	КонецПопытки;

	Т.Добавить("");
	Т.Добавить("=== ДАННЫЕ: 3 входящих ЭТрН с невыполненным шагом (все реквизиты) ===");
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 3 Д.Ссылка КАК Ссылка
			|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
			|ГДЕ НЕ Д.ПометкаУдаления И Д.ЭтоВходящий И НЕ Д.ТекущийШагВыполнен");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДокМД = Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная;
			Т.Добавить("--- " + Строка(Выборка.Ссылка) + " | uid=" + Выборка.Ссылка.УникальныйИдентификатор());
			Для Каждого Р Из ДокМД.Реквизиты Цикл
				Значение = Выборка.Ссылка[Р.Имя];
				Если ЗначениеЗаполнено(Значение) Тогда
					Т.Добавить("   " + Р.Имя + " = " + Строка(Значение));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Т.Добавить("ОШИБКА запроса: " + ОписаниеОшибки());
	КонецПопытки;

	Результат = СтрСоединить(Т, Символы.ПС);
	Сообщить(Результат);
	ТекстОтчета = Результат;

КонецПроцедуры

&НаСервере
Процедура ОписатьОбъектМД(Т, ОМД)

	Для Каждого Р Из ОМД.Реквизиты Цикл
		Т.Добавить("реквизит " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
	КонецЦикла;

	Если ЕстьСвойство(ОМД, "Измерения") Тогда
		Для Каждого Р Из ОМД.Измерения Цикл
			Т.Добавить("измерение " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Ресурсы") Тогда
		Для Каждого Р Из ОМД.Ресурсы Цикл
			Т.Добавить("ресурс " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "ТабличныеЧасти") Тогда
		Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
			Т.Добавить("табличная часть " + ТЧ.Имя);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Формы") Тогда
		Для Каждого Ф Из ОМД.Формы Цикл
			Т.Добавить("форма " + Ф.Имя + " | " + Ф.Синоним);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Команды") Тогда
		Для Каждого К Из ОМД.Команды Цикл
			Т.Добавить("команда " + К.Имя + " | " + К.Синоним);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Макеты") Тогда
		Для Каждого М Из ОМД.Макеты Цикл
			Т.Добавить("макет " + М.Имя);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьСвойство(ОМД, Имя)
	Структура = Новый Структура(Имя);
	ЗаполнитьЗначенияСвойств(Структура, ОМД);
	Возврат Структура[Имя] <> Неопределено;
КонецФункции

&НаСервере
Функция ТипыСтрокой(ОписаниеТипа)

	Части = Новый Массив;
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		МД = Метаданные.НайтиПоТипу(Тип);
		Если МД <> Неопределено Тогда
			Части.Добавить(МД.ПолноеИмя());
		Иначе
			Части.Добавить(Строка(Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции
