// Разведка ЭПД, этап 2: структура объектов ЭТрН и живые данные.
// Ничего не меняет в базе, только читает.

&НаКлиенте
Процедура СобратьКоманда(Команда)
	СобратьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СобратьНаСервере()

	Т = Новый Массив;
	Т.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);

	ТипДок = Тип("ДокументСсылка.ЭлектроннаяТранспортнаяНакладная");

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка
		|ИЗ Документ.ЭлектроннаяТранспортнаяНакладная КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И Д.ЭтоВходящий И НЕ Д.ТекущийШагВыполнен И Д.ТекущийШаг = ""Приемка""");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Т.Добавить("Нет подходящего документа");
		ТекстОтчета = СтрСоединить(Т, Символы.ПС);
		Возврат;
	КонецЕсли;
	Док = Выборка.Ссылка;
	Т.Добавить("Документ: " + Строка(Док));

	// Табличные части документа.
	Для Каждого ТЧ Из Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная.ТабличныеЧасти Цикл
		Т.Добавить("--- табличная часть " + ТЧ.Имя + ": строк " + Док[ТЧ.Имя].Количество());
	КонецЦикла;

	// Регистры сведений, в измерениях которых может быть этот документ.
	Для Каждого Рег Из Метаданные.РегистрыСведений Цикл
		Для Каждого Изм Из Рег.Измерения Цикл
			Если Изм.Тип.СодержитТип(ТипДок) Тогда
				ВывестиЗаписиРегистра(Т, Рег, Изм, Док);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Справочники присоединённых файлов, владельцем которых может быть документ.
	Для Каждого Спр Из Метаданные.Справочники Цикл
		Если Спр.Владельцы.Содержит(Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная) Тогда
			Т.Добавить("--- справочник-подчинённый " + Спр.Имя);
			Попытка
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 20 С.Наименование КАК Имя ИЗ Справочник." + Спр.Имя
					+ " КАК С ГДЕ С.Владелец = &Д");
				Запрос.УстановитьПараметр("Д", Док);
				Выб = Запрос.Выполнить().Выбрать();
				Пока Выб.Следующий() Цикл
					Т.Добавить("   " + Выб.Имя);
				КонецЦикла;
			Исключение
				Т.Добавить("   ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Результат = СтрСоединить(Т, Символы.ПС);
	Сообщить(Результат);
	ТекстОтчета = Результат;

КонецПроцедуры

&НаСервере
Процедура ВывестиЗаписиРегистра(Т, Рег, Изм, Док)

	Поля = Новый Массив;
	Для Каждого Э Из Рег.Измерения Цикл
		Поля.Добавить("Р." + Э.Имя + " КАК " + Э.Имя);
	КонецЦикла;
	Для Каждого Э Из Рег.Ресурсы Цикл
		Поля.Добавить("Р." + Э.Имя + " КАК " + Э.Имя);
	КонецЦикла;
	Для Каждого Э Из Рег.Реквизиты Цикл
		Поля.Добавить("Р." + Э.Имя + " КАК " + Э.Имя);
	КонецЦикла;

	Т.Добавить("--- регистр " + Рег.Имя + " (по измерению " + Изм.Имя + ")");
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 60 " + СтрСоединить(Поля, ", ")
			+ " ИЗ РегистрСведений." + Рег.Имя + " КАК Р ГДЕ Р." + Изм.Имя + " = &Д");
		Запрос.УстановитьПараметр("Д", Док);
		Результат = Запрос.Выполнить();
		Выб = Результат.Выбрать();
		Пока Выб.Следующий() Цикл
			Строки = Новый Массив;
			Для Каждого К Из Результат.Колонки Цикл
				Значение = Строка(Выб[К.Имя]);
				Если СтрДлина(Значение) > 300 Тогда
					Значение = Лев(Значение, 300) + "...";
				КонецЕсли;
				Строки.Добавить(К.Имя + "=" + Значение);
			КонецЦикла;
			Т.Добавить("   " + СтрСоединить(Строки, " | "));
		КонецЦикла;
	Исключение
		Т.Добавить("   ошибка: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОписатьОбъектМД(Т, ОМД)

	Для Каждого Р Из ОМД.Реквизиты Цикл
		Т.Добавить("реквизит " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
	КонецЦикла;

	Если ЕстьСвойство(ОМД, "Измерения") Тогда
		Для Каждого Р Из ОМД.Измерения Цикл
			Т.Добавить("измерение " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Ресурсы") Тогда
		Для Каждого Р Из ОМД.Ресурсы Цикл
			Т.Добавить("ресурс " + Р.Имя + " : " + ТипыСтрокой(Р.Тип));
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "ТабличныеЧасти") Тогда
		Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
			Т.Добавить("табличная часть " + ТЧ.Имя);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Формы") Тогда
		Для Каждого Ф Из ОМД.Формы Цикл
			Т.Добавить("форма " + Ф.Имя + " | " + Ф.Синоним);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Команды") Тогда
		Для Каждого К Из ОМД.Команды Цикл
			Т.Добавить("команда " + К.Имя + " | " + К.Синоним);
		КонецЦикла;
	КонецЕсли;
	Если ЕстьСвойство(ОМД, "Макеты") Тогда
		Для Каждого М Из ОМД.Макеты Цикл
			Т.Добавить("макет " + М.Имя);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьСвойство(ОМД, Имя)
	Структура = Новый Структура(Имя);
	ЗаполнитьЗначенияСвойств(Структура, ОМД);
	Возврат Структура[Имя] <> Неопределено;
КонецФункции

&НаСервере
Функция ТипыСтрокой(ОписаниеТипа)

	Части = Новый Массив;
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		МД = Метаданные.НайтиПоТипу(Тип);
		Если МД <> Неопределено Тогда
			Части.Добавить(МД.ПолноеИмя());
		Иначе
			Части.Добавить(Строка(Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции
