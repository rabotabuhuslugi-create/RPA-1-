// Внешняя обработка «РазделкаПересчетДолей»: групповой пересчёт долей выхода и себестоимости
// в проведённых документах питРазделка (отбор по периоду и организации).
// Самодостаточна: расширение РазделкаДоли не требуется. Если в базе есть регистр сведений
// РазделкаВидЦенПодразделения (из расширения), вид цен берётся по подразделению документа, иначе —
// «Вид цен по умолчанию» с формы.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Документы по отбору (только проведённые): Ссылка, Номер, Дата, Организация, Проведен, ВыходСейчас, СебестоимостьСейчас.
Функция ДокументыПоОтбору(ДатаС, ДатаПо, Организация, ТолькоНеверные) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ДатаПо", ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(3999, 12, 31)));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ВсеДокументы", Не ТолькоНеверные);
	Запрос.УстановитьПараметр("Операция", Перечисления.питХозяйственныеОперации.РецептураРазделка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Организация КАК Организация,
	|	Д.Проведен КАК Проведен,
	|	ЕСТЬNULL(Итоги.Выход, 0) КАК ВыходСейчас,
	|	ЕСТЬNULL(Итоги.Себестоимость, 0) КАК СебестоимостьСейчас
	|ИЗ
	|	Документ.питРазделка КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				Т.Ссылка КАК Ссылка,
	|				СУММА(Т.ПроцентВыхода) КАК Выход,
	|				СУММА(Т.ПроцентСебестоимости) КАК Себестоимость
	|			ИЗ
	|				Документ.питРазделка.Товары КАК Т
	|			СГРУППИРОВАТЬ ПО
	|				Т.Ссылка) КАК Итоги
	|		ПО Д.Ссылка = Итоги.Ссылка
	|ГДЕ
	|	Д.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И (&ВсеОрганизации ИЛИ Д.Организация = &Организация)
	|	И Д.Проведен
	|	И НЕ Д.ПометкаУдаления
	|	И Д.ХозяйственнаяОперация = &Операция
	|	И (&ВсеДокументы
	|		ИЛИ ЕСТЬNULL(Итоги.Выход, 0) <> 1
	|		ИЛИ ЕСТЬNULL(Итоги.Себестоимость, 0) <> 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Пересчитывает доли проведённого документа и перепроводит его. Возвращает текст результата.
Функция ПересчитатьДокумент(Ссылка, ВидЦенПоУмолчанию, МинДоля) Экспорт

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект.ХозяйственнаяОперация <> Перечисления.питХозяйственныеОперации.РецептураРазделка Тогда
			Возврат НСтр("ru = 'Пропущен: операция не «Разделка»'");
		КонецЕсли;
		Если Объект.Товары.Количество() = 0 Тогда
			Возврат НСтр("ru = 'Пропущен: нет строк'");
		КонецЕсли;
		Если Не Объект.Проведен Тогда
			Возврат НСтр("ru = 'Пропущен: документ не проведён'");
		КонецЕсли;

		ВидЦен = ВидЦенДляПодразделения(Объект.Подразделение, ВидЦенПоУмолчанию);
		БезЦены = Новый Массив;
		Доли = РассчитатьДоли(Объект.Товары.Выгрузить(), ВидЦен, Объект.Дата, МинДоля, ИменаОтходов(), БезЦены);
		Для Каждого Доля Из Доли Цикл
			Строка = Объект.Товары[Доля.НомерСтроки - 1]; // факт, норму, порядок строк не трогаем
			Строка.ПроцентВыхода = Доля.ДоляВыхода;
			Строка.ПроцентСебестоимости = Доля.ДоляСебестоимости;
		КонецЦикла;
		Объект.Записать(РежимЗаписиДокумента.Проведение);

		Результат = НСтр("ru = 'Готово (перепроведён)'");
		Если БезЦены.Количество() > 0 Тогда
			Позиции = "";
			Для Каждого Позиция Из БезЦены Цикл
				Позиции = Позиции + ?(Позиции = "", "", "; ") + Строка(Позиция);
			КонецЦикла;
			Результат = Результат + НСтр("ru = '; нет цены: '") + Позиции;
		КонецЕсли;
		Возврат Результат;
	Исключение
		Возврат НСтр("ru = 'Ошибка: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Начала наименований «отходов»: «Свинина ОТХОДЫ охл кг МЦ» и т.п. — доля себестоимости всегда 0.
Функция ИменаОтходов()
	Имена = Новый Массив;
	Имена.Добавить("Свинина ОТХОДЫ");
	Имена.Добавить("Говядина ОТХОДЫ");
	Имена.Добавить("Курица вода");
	Возврат Имена;
КонецФункции

// Вид цен подразделения из регистра расширения (если он есть в базе), иначе вид цен по умолчанию.
Функция ВидЦенДляПодразделения(Подразделение, ВидЦенПоУмолчанию)
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ВидЦен ИЗ РегистрСведений.РазделкаВидЦенПодразделения ГДЕ Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ВидЦен) Тогда
			Возврат Выборка.ВидЦен;
		КонецЕсли;
	Исключение
		// Регистра нет (расширение не установлено) — используем значение по умолчанию.
	КонецПопытки;
	Возврат ВидЦенПоУмолчанию;
КонецФункции

// Возвращает массив структур (НомерСтроки, ДоляВыхода, ДоляСебестоимости). Документ не меняет.
Функция РассчитатьДоли(Знач Товары, Знач ВидЦен, Знач Дата, Знач МинДоля, Знач ИменаОтходов, БезЦены = Неопределено)

	Результат = Новый Массив;
	Если Товары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Товары.Количество() = 1 Тогда
		Результат.Добавить(Новый Структура("НомерСтроки, ДоляВыхода, ДоляСебестоимости", 1, 1, 1));
		Возврат Результат;
	КонецЕсли;

	СуммаФакт = 0;
	Для Каждого Строка Из Товары Цикл
		СуммаФакт = СуммаФакт + Строка.Количество;
	КонецЦикла;
	Если СуммаФакт <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Сумма фактического количества должна быть больше нуля'");
	КонецЕсли;

	Отходы = НоменклатураПоИменам(ИменаОтходов);
	Цены = ЦеныПродажи(Товары.ВыгрузитьКолонку("Номенклатура"), ВидЦен, Дата);

	// Продаваемые позиции без цены на дату документа (вес у них 0) — сообщаем вызывающему.
	Если БезЦены <> Неопределено Тогда
		Для Каждого Строка Из Товары Цикл
			Если Отходы.Найти(Строка.Номенклатура) = Неопределено
				И Не Цены[Строка.Номенклатура] > 0 Тогда
				БезЦены.Добавить(Строка.Номенклатура);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Выход = Новый Массив;
	Веса = Новый Массив;
	СуммаВесов = 0;
	Для Каждого Строка Из Товары Цикл
		Выход.Добавить(Окр(Строка.Количество / СуммаФакт, 3, 1));
		Вес = 0;
		Если Отходы.Найти(Строка.Номенклатура) = Неопределено Тогда
			Вес = Строка.Количество * Цены[Строка.Номенклатура];
		КонецЕсли;
		Веса.Добавить(Вес);
		СуммаВесов = СуммаВесов + Вес;
	КонецЦикла;
	Если СуммаВесов <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет продаваемых позиций с ценой: доли себестоимости не рассчитать'");
	КонецЕсли;

	Себест = Новый Массив;
	Для Каждого Вес Из Веса Цикл
		Себест.Добавить(Окр(Вес / СуммаВесов, 2, 1));
	КонецЦикла;

	ДобавитьОстаток(Выход, Товары.ВыгрузитьКолонку("Количество"), 1, Ложь);
	ДобавитьОстаток(Себест, Веса, 1, Ложь);

	Если МинДоля > 0 Тогда
		Для Индекс = 0 По Веса.ВГраница() Цикл
			Если Веса[Индекс] > 0 И Себест[Индекс] = 0 Тогда
				Себест[Индекс] = МинДоля;
				ДобавитьОстаток(Себест, Веса, -МинДоля, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Индекс = 0 По Выход.ВГраница() Цикл
		Результат.Добавить(Новый Структура("НомерСтроки, ДоляВыхода, ДоляСебестоимости",
			Индекс + 1, Выход[Индекс], Себест[Индекс]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьОстаток(Значения, Ключи, Знач Поправка, Знач Вычитание)
	Индекс = 0;
	Для Н = 1 По Ключи.ВГраница() Цикл
		Если Ключи[Н] > Ключи[Индекс] Тогда // строго больше → при равенстве первая
			Индекс = Н;
		КонецЕсли;
	КонецЦикла;
	Если Вычитание Тогда
		Значения[Индекс] = Значения[Индекс] + Поправка;
	Иначе
		Сумма = 0;
		Для Каждого Значение Из Значения Цикл
			Сумма = Сумма + Значение;
		КонецЦикла;
		Значения[Индекс] = Значения[Индекс] + (Поправка - Сумма);
	КонецЕсли;
КонецПроцедуры

Функция НоменклатураПоИменам(Имена)
	// Имена — начала наименований: «Свинина ОТХОДЫ» найдёт «Свинина ОТХОДЫ охл кг МЦ».
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Наименование ПОДОБНО &Шаблон");
		Запрос.УстановитьПараметр("Шаблон", СтрЗаменить(Имя, "%", "") + "%");
		Для Каждого Ссылка Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") Цикл
			Результат.Добавить(Ссылка);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Цена по виду цен из настроек; если нет — самая частая из последних цен по розничным видам.
// Цены берутся актуальными на дату документа (срез последних на Дату); без цены на эту дату — 0.
Функция ЦеныПродажи(Номенклатура, ВидЦен, Дата)

	Цены = Новый Соответствие;

	ЗагрузитьЦены(Цены, Номенклатура, Дата, ВидЦен);

	Для Каждого Позиция Из Номенклатура Цикл
		Если Цены[Позиция] = Неопределено Тогда
			Цены.Вставить(Позиция, 0);
		КонецЕсли;
	КонецЦикла;
	Возврат Цены;

КонецФункции

// Дополняет Цены: по виду цен, затем по розничным видам (мода). Уже найденные позиции не трогает.
Процедура ЗагрузитьЦены(Цены, Номенклатура, Дата, ВидЦен)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);

	Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|&Дата, Номенклатура В (&Номенклатура) И ВидЦены = &ВидЦен)"; // продажные цены: РС «Цены номенклатуры»
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Цены[Выборка.Номенклатура] = Неопределено Тогда
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

	// Резерв: самая частая из последних цен по всем розничным видам цен
	// (наименование вида цены содержит «озничн»: «Розничная Дарвина 101», «Сочи 1 кат. Искры розничная»).
	// Отбор по наименованию — во внешнем запросе: в условии виртуальной таблицы обращение через точку недопустимо.
	Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена, КОЛИЧЕСТВО(*) КАК Частота ИЗ (
		|ВЫБРАТЬ Ц.Номенклатура КАК Номенклатура, Ц.Цена КАК Цена
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, Номенклатура В (&Номенклатура)) КАК Ц
		|ГДЕ Ц.ВидЦены.Наименование ПОДОБНО ""%озничн%"" И Ц.Цена > 0) КАК С
		|СГРУППИРОВАТЬ ПО Номенклатура, Цена УПОРЯДОЧИТЬ ПО Частота УБЫВ, Цена УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Цены[Выборка.Номенклатура] = Неопределено Тогда
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли
