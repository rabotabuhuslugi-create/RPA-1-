// Модуль объекта документа питРазделка (расширение РазделкаДоли).
// Открыть: расширение → Документы → питРазделка → свойства → «Модуль объекта: Открыть».
// Проверка: итого доля себестоимости по ТЧ «Товары» должна быть равна 1.
//  • Проведение — отказ с сообщением, пока не будет равна 1.
//  • Простая запись — только предупреждение (черновик сохранить можно). Чтобы запретить и запись,
//    уберите условие «РежимЗаписи = РежимЗаписиДокумента.Проведение» ниже.
// Реквизиты основного объекта — через ЭтотОбъект (в расширении они не заимствованы).
// Стоит после ПередЗаписью документа: родной обработчик присваивает Отказ, поэтому «Перед» тут нельзя.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ПередЗаписью")
Процедура РД_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Отказ Или ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	// Только разделка: в других операциях доля себестоимости может не заполняться.
	Если ЭтотОбъект.ХозяйственнаяОперация <> Перечисления.питХозяйственныеОперации.РецептураРазделка Тогда
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект.Товары.Количество() = 0
		Или Окр(ЭтотОбъект.Товары.Итог("ПроцентСебестоимости"), 2) = 1 Тогда
		Возврат;
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Итого доля себестоимости не равна 1, нажать кнопку ""РАССЧИТАТЬ ДОЛИ ПО ЦЕНАМ""'");
	Сообщение.Поле = "Товары";
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецЕсли
