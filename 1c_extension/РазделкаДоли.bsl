// Общий модуль расширения «РазделкаДоли» (сервер, без привилегированного режима).
// Алгоритм зеркалит rpa1c/razdelka.py — тесты там. Имена объектов метаданных
// Реквизиты документа питРазделка сверены по выгрузке; регистры — по скриншоту.

#Область ПрограммныйИнтерфейс

// Рассчитывает доли по строкам табличной части. Реквизиты строк не меняет — возвращает
// массив структур (НомерСтроки, ДоляВыхода, ДоляСебестоимости).
Функция РассчитатьДоли(Знач Товары, Знач Подразделение, Знач Дата) Экспорт

	Результат = Новый Массив;
	Если Товары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если Товары.Количество() = 1 Тогда
		Результат.Добавить(Новый Структура("НомерСтроки, ДоляВыхода, ДоляСебестоимости", 1, 1, 1));
		Возврат Результат;
	КонецЕсли;

	СуммаФакт = 0;
	Для Каждого Строка Из Товары Цикл
		СуммаФакт = СуммаФакт + Строка.Количество;
	КонецЦикла;
	Если СуммаФакт <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Сумма фактического количества должна быть больше нуля'");
	КонецЕсли;

	Отходы = СписокОтходов();
	Цены = ЦеныПродажи(Товары.ВыгрузитьКолонку("Номенклатура"), Подразделение, Дата);
	МинДоля = Константы.РазделкаМинимальнаяДоляДляПродукта.Получить(); // 0 или 0.01

	// Шаги 2–3
	Выход = Новый Массив;
	Веса = Новый Массив;
	СуммаВесов = 0;
	Для Каждого Строка Из Товары Цикл
		Выход.Добавить(Окр(Строка.Количество / СуммаФакт, 3, 1));
		Вес = 0;
		Если Отходы.Найти(Строка.Номенклатура) = Неопределено Тогда
			Вес = Строка.Количество * Цены[Строка.Номенклатура];
		КонецЕсли;
		Веса.Добавить(Вес);
		СуммаВесов = СуммаВесов + Вес;
	КонецЦикла;
	Если СуммаВесов <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет продаваемых позиций с ценой: доли себестоимости не рассчитать'");
	КонецЕсли;

	// Шаг 4
	Себест = Новый Массив;
	Для Каждого Вес Из Веса Цикл
		Себест.Добавить(Окр(Вес / СуммаВесов, 2, 1));
	КонецЦикла;

	// Шаг 5: остаток — строке с наибольшим значением, при равенстве первой
	ДобавитьОстаток(Выход, Товары.ВыгрузитьКолонку("Количество"), 1);
	ДобавитьОстаток(Себест, Веса, 1);

	// Шаг 6
	Если МинДоля > 0 Тогда
		Для Индекс = 0 По Веса.ВГраница() Цикл
			Если Веса[Индекс] > 0 И Себест[Индекс] = 0 Тогда
				Себест[Индекс] = МинДоля;
				ДобавитьОстаток(Себест, Веса, -МинДоля, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Индекс = 0 По Выход.ВГраница() Цикл
		Результат.Добавить(Новый Структура("НомерСтроки, ДоляВыхода, ДоляСебестоимости",
			Индекс + 1, Выход[Индекс], Себест[Индекс]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверка перед проведением: суммы долей = 1.
Функция ДолиКорректны(Знач Товары) Экспорт
	Выход = 0;
	Себест = 0;
	Для Каждого Строка Из Товары Цикл
		Выход = Выход + Строка.ПроцентВыхода;
		Себест = Себест + Строка.ПроцентСебестоимости;
	КонецЦикла;
	Возврат Товары.Количество() = 0 Или (Окр(Выход, 3) = 1 И Окр(Себест, 2) = 1);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Корректирует значения так, чтобы сумма была ровно 1 (точность — по числу знаков значений).
// Если Вычитание = Истина, Поправка вычитается из строки с наибольшим весом без пересчёта остатка.
Процедура ДобавитьОстаток(Значения, Ключи, Знач Поправка, Вычитание = Ложь)
	Индекс = 0;
	Для Н = 1 По Ключи.ВГраница() Цикл
		Если Ключи[Н] > Ключи[Индекс] Тогда // строго больше → при равенстве первая
			Индекс = Н;
		КонецЕсли;
	КонецЦикла;
	Если Вычитание Тогда
		Значения[Индекс] = Значения[Индекс] + Поправка;
	Иначе
		Сумма = 0;
		Для Каждого Значение Из Значения Цикл
			Сумма = Сумма + Значение;
		КонецЦикла;
		Значения[Индекс] = Значения[Индекс] + (Поправка - Сумма);
	КонецЕсли;
КонецПроцедуры

// «Отходы»: всегда доля с/с = 0. УТОЧНИТЬ: надёжнее хранить признаком в справочнике
// номенклатуры или регистре, а не по имени.
Функция СписокОтходов()
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура
		|ГДЕ Наименование В (""Свинина ОТХОДЫ"", ""Говядина ОТХОДЫ"", ""Курица вода"")");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Цена по виду цен подразделения; если нет — самая частая из последних цен по розничным видам.
// Сначала берём цены на дату документа, для позиций без цены — самые свежие из регистра.
Функция ЦеныПродажи(Номенклатура, Подразделение, Дата)

	ВидЦен = ВидЦенДляПодразделения(Подразделение);
	Цены = Новый Соответствие;

	ЗагрузитьЦены(Цены, Номенклатура, Дата, ВидЦен);

	БезЦены = Новый Массив;
	Для Каждого Позиция Из Номенклатура Цикл
		Если Цены[Позиция] = Неопределено Тогда
			БезЦены.Добавить(Позиция);
		КонецЕсли;
	КонецЦикла;
	Если БезЦены.Количество() > 0 Тогда
		ЗагрузитьЦены(Цены, БезЦены, Неопределено, ВидЦен); // Неопределено = последние значения
	КонецЕсли;

	Для Каждого Позиция Из Номенклатура Цикл
		Если Цены[Позиция] = Неопределено Тогда
			Цены.Вставить(Позиция, 0);
		КонецЕсли;
	КонецЦикла;
	Возврат Цены;

КонецФункции

// Дополняет Цены: по виду цен, затем по розничным видам (мода). Уже найденные позиции не трогает.
Процедура ЗагрузитьЦены(Цены, Номенклатура, Дата, ВидЦен)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);

	Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|&Дата, Номенклатура В (&Номенклатура) И ВидЦены = &ВидЦен)"; // продажные цены: РС «Цены номенклатуры»
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Цены[Выборка.Номенклатура] = Неопределено Тогда
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

	// Резерв: самая частая из последних цен по всем розничным видам цен
	// (наименование вида цены содержит «озничн»: «Розничная Дарвина 101», «Сочи 1 кат. Искры розничная»).
	// Отбор по наименованию — во внешнем запросе: в условии виртуальной таблицы обращение через точку недопустимо.
	Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена, КОЛИЧЕСТВО(*) КАК Частота ИЗ (
		|ВЫБРАТЬ Ц.Номенклатура КАК Номенклатура, Ц.Цена КАК Цена
		|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, Номенклатура В (&Номенклатура)) КАК Ц
		|ГДЕ Ц.ВидЦены.Наименование ПОДОБНО ""%озничн%"" И Ц.Цена > 0) КАК С
		|СГРУППИРОВАТЬ ПО Номенклатура, Цена УПОРЯДОЧИТЬ ПО Частота УБЫВ, Цена УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Цены[Выборка.Номенклатура] = Неопределено Тогда
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ВидЦенДляПодразделения(Подразделение)
	// Сначала регистр «Подразделение → вид цен», иначе константа.
	Значение = РегистрыСведений.РазделкаВидЦенПодразделения.Получить(
		Новый Структура("Подразделение", Подразделение)).ВидЦен;
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Константы.РазделкаВидЦенДляРасчетаДолей.Получить());
КонецФункции

#КонецОбласти
