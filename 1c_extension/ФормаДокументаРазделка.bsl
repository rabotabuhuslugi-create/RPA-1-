// Фрагмент модуля формы документа «Разделка» (расширение).
// Команда «РассчитатьДоли»: кнопка «Рассчитать доли по ценам» в группе командной панели
// таблицы «Товары», рядом с «Подбор». Меняет ТОЛЬКО ПроцентВыхода/ПроцентСебестоимости (документ питРазделка).

&НаКлиенте
Процедура РассчитатьДолиПоЦенам(Команда)
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Доли = РассчитатьДолиНаСервере();
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Функция РассчитатьДолиНаСервере()
	Доли = РазделкаДоли.РассчитатьДоли(Объект.Товары.Выгрузить(), Объект.Подразделение, Объект.Дата);
	Для Каждого Доля Из Доли Цикл
		Строка = Объект.Товары[Доля.НомерСтроки - 1]; // порядок и факт не трогаем
		Строка.ПроцентВыхода = Доля.ДоляВыхода;
		Строка.ПроцентСебестоимости = Доля.ДоляСебестоимости;
	КонецЦикла;
	Возврат Доли;
КонецФункции

// При каждой записи (в т.ч. проведении) из формы: вопрос «Пересчитать доли?».
// Да  — доли рассчитываются, затем документ записывается (с тем же режимом записи).
// Нет — документ записывается как есть.
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.Товары.Количество() = 0 Или ПараметрыЗаписи.Свойство("ДолиОбработаны") Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина; // запись продолжится в обработчике ответа
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОДолях", ЭтотОбъект, ПараметрыЗаписи),
		НСтр("ru = 'Пересчитать доли выхода и себестоимости по ценам?'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОДолях(Ответ, ПараметрыЗаписи) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Попытка
			РассчитатьДолиНаСервере();
		Исключение
			ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат; // доли не рассчитаны — документ не записываем
		КонецПопытки;
	ИначеЕсли Ответ <> КодВозвратаДиалога.Нет Тогда
		Возврат; // диалог закрыт крестиком — запись отменена
	КонецЕсли;
	ПараметрыЗаписи.Вставить("ДолиОбработаны", Истина);
	Записать(ПараметрыЗаписи);
КонецПроцедуры
