// Фрагмент модуля формы документа «Разделка» (расширение).
// Команда «РассчитатьДоли»: кнопка «Рассчитать доли по ценам» в группе командной панели
// таблицы «Товары», рядом с «Подбор». Меняет ТОЛЬКО ДоляВыхода/ДоляСебестоимости.

&НаКлиенте
Процедура РассчитатьДолиПоЦенам(Команда)
	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Доли = РассчитатьДолиНаСервере();
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Функция РассчитатьДолиНаСервере()
	Доли = РазделкаДоли.РассчитатьДоли(Объект.Товары.Выгрузить(), Объект.Подразделение, Объект.Дата);
	Для Каждого Доля Из Доли Цикл
		Строка = Объект.Товары[Доля.НомерСтроки - 1]; // порядок и факт не трогаем
		Строка.ДоляВыхода = Доля.ДоляВыхода;
		Строка.ДоляСебестоимости = Доля.ДоляСебестоимости;
	КонецЦикла;
	Возврат Доли;
КонецФункции

// Перед проведением: проверка сумм и предложение пересчитать.
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не ДолиКорректныеНаСервере() И Не ПараметрыЗаписи.Свойство("ДолиПодтверждены") Тогда
		Отказ = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОДолях", ЭтотОбъект, ПараметрыЗаписи),
			НСтр("ru = 'Сумма долей выхода или себестоимости не равна 1. Пересчитать доли по ценам?'"),
			РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОДолях(Ответ, ПараметрыЗаписи) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		РассчитатьДолиПоЦенам(Неопределено);
	КонецЕсли; // «Нет» — пользователь сам правит доли, проведение повторит проверку
КонецПроцедуры

&НаСервере
Функция ДолиКорректныеНаСервере()
	Возврат РазделкаДоли.ДолиКорректны(Объект.Товары);
КонецФункции
