// Модуль управляемой формы обработки «РазделкаПересчетДолей» (форма «ФормаПересчета»).
//
// Реквизиты формы:
//   Организация       СправочникСсылка.Организации (пусто = все организации)
//   ДатаС, ДатаПо     Дата (состав — Дата)
//   ТолькоНеверные    Булево (по умолчанию Истина) — документы, где суммы долей не равны 1
//   Документы         ТаблицаЗначений: Выбор (Булево), Документ (ДокументСсылка.питРазделка),
//                     Дата (Дата), Организация (СправочникСсылка.Организации), Проведен (Булево),
//                     ВыходСейчас (Число 7.3), СебестоимостьСейчас (Число 7.2), Результат (Строка)
// Команды: «Заполнить» → ЗаполнитьКоманда, «Пересчитать» → ПересчитатьКоманда,
//          «Отметить все» → ОтметитьВсеКоманда, «Снять отметки» → СнятьОтметкиКоманда.

&НаКлиенте
Процедура ЗаполнитьКоманда(Команда)
	Если Не ЗначениеЗаполнено(ДатаС) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите дату начала периода'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьНаСервере();
	Если Документы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документов по отбору нет'"));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Таблица = РеквизитФормыВЗначение("Объект").ДокументыПоОтбору(ДатаС, ДатаПо, Организация, ТолькоНеверные);
	Документы.Очистить();
	Для Каждого Строка Из Таблица Цикл
		Новая = Документы.Добавить();
		Новая.Выбор = Истина;
		Новая.Документ = Строка.Ссылка;
		Новая.Дата = Строка.Дата;
		Новая.Организация = Строка.Организация;
		Новая.Проведен = Строка.Проведен;
		Новая.ВыходСейчас = Строка.ВыходСейчас;
		Новая.СебестоимостьСейчас = Строка.СебестоимостьСейчас;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеКоманда(Команда)
	Для Каждого Строка Из Документы Цикл
		Строка.Выбор = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиКоманда(Команда)
	Для Каждого Строка Из Документы Цикл
		Строка.Выбор = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьКоманда(Команда)
	Отмеченные = Документы.НайтиСтроки(Новый Структура("Выбор", Истина));
	Если Отмеченные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте документы для пересчёта'"));
		Возврат;
	КонецЕсли;
	ТекстВопроса = СтрШаблон(НСтр("ru = 'Пересчитать доли в документах: %1?%2'"), Отмеченные.Количество(),
		Символы.ПС + НСтр("ru = 'Документы будут перепроведены.'"));
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаПересчитать", ЭтотОбъект), ТекстВопроса,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаПересчитать(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Отмеченные = Документы.НайтиСтроки(Новый Структура("Выбор", Истина));
	Всего = Отмеченные.Количество();
	Готово = 0;
	Ошибок = 0;
	Номер = 0;
	Для Каждого Строка Из Отмеченные Цикл
		Номер = Номер + 1;
		Состояние(СтрШаблон(НСтр("ru = 'Пересчёт долей: %1 из %2'"), Номер, Всего));
		Строка.Результат = ПересчитатьДокументНаСервере(Строка.Документ);
		Если СтрНачинаетсяС(Строка.Результат, "Готово") Тогда
			Готово = Готово + 1;
			Строка.Выбор = Ложь;
		ИначеЕсли СтрНачинаетсяС(Строка.Результат, "Ошибка") Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
		ОбработкаПрерыванияПользователя();
	КонецЦикла;
	ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Обработано: %1 из %2. Ошибок: %3. Подробности — в колонке «Результат».'"),
		Готово, Всего, Ошибок));
КонецПроцедуры

&НаСервере
Функция ПересчитатьДокументНаСервере(Ссылка)
	Возврат РеквизитФормыВЗначение("Объект").ПересчитатьДокумент(Ссылка);
КонецФункции
