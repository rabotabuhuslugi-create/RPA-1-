// Автооплаты КА (исправленная версия).
//
// Принцип работы:
//  1. «Сформировать оплаты» - загружает остатки задолженности перед поставщиками (приобретения с договором)
//     на дату оплат, исключая контрагентов со свойством «Стоп оплаты».
//  2. Пользователь отмечает документы/контрагентов, при необходимости меняет суммы и делит их между двумя счетами.
//  3. «Сформировать ПП» - проверяет данные и создает платежные поручения (Списание безналичных ДС)
//     с разбивкой по договорам документов и ставкам НДС.
//
// Инвариант таблицы КОплате: строка отмечена (Оплатить) <=> НашДолгПросрочено > 0
// (НашДолгПросрочено - сумма, которую оплачиваем по документу).

&НаКлиенте
Перем ПредыдущийСчет1;

&НаКлиенте
Перем ПредыдущийСчет2;

&НаКлиенте
Перем ПредыдущаяДатаОплат;

#Область Итоги

&НаКлиенте
Процедура ПересчитатьИтоги()

	ИтогСч1 = 0;
	ИтогСч2 = 0;
	Для Каждого СтрокаТаблицы Из Объект.Контрагенты Цикл
		Если СтрокаТаблицы.Оплатить Тогда
			ИтогСч1 = ИтогСч1 + СтрокаТаблицы.СуммаСч1;
			ИтогСч2 = ИтогСч2 + СтрокаТаблицы.СуммаСч2;
		КонецЕсли;
	КонецЦикла;
	СуммаКОплатеПоСчету1 = ИтогСч1;
	СуммаКОплатеПоСчету2 = ИтогСч2;
	ОстанетсяПослеОплатыСч1 = Объект.ОстатокСчет1 - СуммаКОплатеПоСчету1;
	ОстанетсяПослеОплатыСч2 = Объект.ОстатокСчет2 - СуммаКОплатеПоСчету2;

КонецПроцедуры

// Сводка по документам одним проходом: Данные - Соответствие "Контрагент -> (ДолгВсего, КОплате)",
// Порядок - массив контрагентов в порядке появления.
&НаКлиенте
Функция СводкаПоДокументам()

	Данные = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрДок Из Объект.КОплате Цикл
		Итоги = Данные.Получить(СтрДок.Контрагент);
		Если Итоги = Неопределено Тогда
			Итоги = Новый Структура("ДолгВсего, КОплате", 0, 0);
			Данные.Вставить(СтрДок.Контрагент, Итоги);
			Порядок.Добавить(СтрДок.Контрагент);
		КонецЕсли;
		Итоги.ДолгВсего = Окр(Итоги.ДолгВсего + СтрДок.НашДолг, 2);
		Если СтрДок.Оплатить Тогда
			Итоги.КОплате = Окр(Итоги.КОплате + СтрДок.НашДолгПросрочено, 2);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Данные, Порядок", Данные, Порядок);

КонецФункции

// Раскладывает сумму к оплате контрагента по счетам.
// Если заполнен второй счет и у контрагента задан счет (из договора), отличный от первого, - все на второй счет.
&НаКлиенте
Процедура РаспределитьПоСчетам(СтрокаК)

	СтрокаК.СуммаСч1 = 0;
	СтрокаК.СуммаСч2 = 0;
	Если СтрокаК.СуммаКОплате <= 0 Тогда
		Возврат;
	КонецЕсли;

	ЕстьСчет1 = ЗначениеЗаполнено(Объект.СчетОрганизации);
	ЕстьСчет2 = ЗначениеЗаполнено(Объект.СчетОрганизации2);
	Если ЕстьСчет2
		И ЗначениеЗаполнено(СтрокаК.БанковскийСчетОрганизации)
		И СтрокаК.БанковскийСчетОрганизации <> Объект.СчетОрганизации Тогда
		СтрокаК.СуммаСч2 = СтрокаК.СуммаКОплате;
	ИначеЕсли ЕстьСчет1 Тогда
		СтрокаК.СуммаСч1 = СтрокаК.СуммаКОплате;
	КонецЕсли;

КонецПроцедуры

// Обновляет таблицу Контрагенты по сводке. Пересоздать = Истина - строки создаются заново.
&НаКлиенте
Процедура ПрименитьСводку(Сводка, Пересоздать)

	Если Пересоздать Тогда
		Объект.Контрагенты.Очистить();
		Для Каждого Контрагент Из Сводка.Порядок Цикл
			Объект.Контрагенты.Добавить().Контрагент = Контрагент;
		КонецЦикла;
		ЗаполнитьСчетаКонтрагентов();
	Иначе
		Индекс = Объект.Контрагенты.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если Сводка.Данные.Получить(Объект.Контрагенты[Индекс].Контрагент) = Неопределено Тогда
				Объект.Контрагенты.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаК Из Объект.Контрагенты Цикл
		Итоги = Сводка.Данные.Получить(СтрокаК.Контрагент);
		СтрокаК.СуммаДолгВсего = Итоги.ДолгВсего;
		СтрокаК.СуммаКОплате = Итоги.КОплате;
		СтрокаК.Оплатить = Итоги.КОплате > 0;
		РаспределитьПоСчетам(СтрокаК);
	КонецЦикла;
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиПоКонтрагенту(врКонтрагент)

	СуммаВсего = 0;
	СуммаОплаты = 0;
	Для Каждого СтрДок Из Объект.КОплате.НайтиСтроки(Новый Структура("Контрагент", врКонтрагент)) Цикл
		СуммаВсего = СуммаВсего + СтрДок.НашДолг;
		Если СтрДок.Оплатить Тогда
			СуммаОплаты = СуммаОплаты + СтрДок.НашДолгПросрочено;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаК Из Объект.Контрагенты.НайтиСтроки(Новый Структура("Контрагент", врКонтрагент)) Цикл
		СтрокаК.СуммаДолгВсего = Окр(СуммаВсего, 2);
		СтрокаК.СуммаКОплате = Окр(СуммаОплаты, 2);
		СтрокаК.Оплатить = СтрокаК.СуммаКОплате > 0;
		РаспределитьПоСчетам(СтрокаК);
	КонецЦикла;
	ПересчитатьИтоги();

КонецПроцедуры

#КонецОбласти

#Область СчетаДоговоров

&НаСервереБезКонтекста
Функция ПолучитьСчетаДоговоров(Договоры)

	Результат = Новый Соответствие;
	Если Договоры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	ДоговорыКонтрагентов.БанковскийСчет КАК БанковскийСчет
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Ссылка В (&Договоры)
		|	И ДоговорыКонтрагентов.БанковскийСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Договор, Выборка.БанковскийСчет);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Банковский счет контрагента берется из договора первого (по порядку) документа, у договора которого счет задан.
&НаКлиенте
Процедура ЗаполнитьСчетаКонтрагентов()

	Договоры = Новый Массив;
	Уникальные = Новый Соответствие;
	Для Каждого СтрДок Из Объект.КОплате Цикл
		Если ЗначениеЗаполнено(СтрДок.Договор) И Уникальные.Получить(СтрДок.Договор) = Неопределено Тогда
			Уникальные.Вставить(СтрДок.Договор, Истина);
			Договоры.Добавить(СтрДок.Договор);
		КонецЕсли;
	КонецЦикла;

	СчетаДоговоров = ПолучитьСчетаДоговоров(Договоры);
	СчетаКонтрагентов = Новый Соответствие;
	Для Каждого СтрДок Из Объект.КОплате Цикл
		Если СчетаКонтрагентов.Получить(СтрДок.Контрагент) = Неопределено Тогда
			Счет = СчетаДоговоров.Получить(СтрДок.Договор);
			Если Счет <> Неопределено Тогда
				СчетаКонтрагентов.Вставить(СтрДок.Контрагент, Счет);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаК Из Объект.Контрагенты Цикл
		Счет = СчетаКонтрагентов.Получить(СтрокаК.Контрагент);
		Если Счет <> Неопределено Тогда
			СтрокаК.БанковскийСчетОрганизации = Счет;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ФормированиеСпискаОплат

// Партнеры со свойством «Стоп оплаты». Найдено = Ложь, если самого свойства в базе нет
// (в этом случае проверка стоп-листа невозможна и формирование прерывается).
&НаСервереБезКонтекста
Функция ПартнерыСтопОплаты()

	Результат = Новый Структура("Найдено, Партнеры", Ложь, Новый Массив);

	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Стоп оплаты", Истина);
	Если НЕ ЗначениеЗаполнено(Свойство) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Найдено = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПартнерыДополнительныеРеквизиты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
		|ГДЕ
		|	ПартнерыДополнительныеРеквизиты.Свойство.Наименование = ""Стоп оплаты""
		|	И ПартнерыДополнительныеРеквизиты.Значение = ИСТИНА";
	Результат.Партнеры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Результат;

КонецФункции

&НаСервере
Функция СформироватьОплатыНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщить("Укажите организацию: задолженность и платежные поручения формируются в разрезе одной организации.");
		Возврат Ложь;
	КонецЕсли;

	Стоп = ПартнерыСтопОплаты();
	Если НЕ Стоп.Найдено Тогда
		Сообщить("Не найдено дополнительное свойство «Стоп оплаты». Без него нельзя исключить заблокированных контрагентов, формирование прервано.");
		Возврат Ложь;
	КонецЕсли;

	ГраницаСрока = КонецДня(Объект.ДатаОплат);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АналитикаУчета.Организация КАК Организация,
		|	АналитикаУчета.Контрагент КАК Контрагент,
		|	АналитикаУчета.Договор КАК Договор,
		|	РасчетыПоСрокам.РасчетныйДокумент КАК РасчетныйДокумент,
		|	РасчетыПоСрокам.ДатаПлановогоПогашения КАК ДатаПлановогоПогашения,
		|	РасчетыПоСрокам.ДатаВозникновения КАК ДатаВозникновения,
		|	РасчетыПоСрокам.ДолгУпрОстаток КАК НашДолг,
		|	ВЫБОР
		|		КОГДА РасчетыПоСрокам.ДатаПлановогоПогашения <= &ГраницаСрока
		|			ТОГДА РасчетыПоСрокам.ДолгУпрОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НашДолгПросрочено
		|ИЗ
		|	РегистрНакопления.РасчетыСПоставщикамиПоСрокам.Остатки(&ГраницаСрока, ) КАК РасчетыПоСрокам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчета
		|		ПО (АналитикаУчета.КлючАналитики = РасчетыПоСрокам.АналитикаУчетаПоПартнерам)
		|ГДЕ
		|	АналитикаУчета.Организация = &Организация
		|	И АналитикаУчета.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
		|	И НЕ АналитикаУчета.Партнер В (&ПартнерыСтопОплаты)
		|	И АналитикаУчета.Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|	И ТИПЗНАЧЕНИЯ(РасчетыПоСрокам.РасчетныйДокумент) = ТИП(Документ.ПриобретениеТоваровУслуг)
		|	И РасчетыПоСрокам.ДолгУпрОстаток > 0
		|	И ВЫБОР
		|			КОГДА &ОтборКонтрагент
		|				ТОГДА АналитикаУчета.Контрагент = &Контрагент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	АналитикаУчета.Контрагент.Наименование,
		|	РасчетыПоСрокам.ДатаВозникновения,
		|	РасчетыПоСрокам.ДатаПлановогоПогашения";
	Запрос.УстановитьПараметр("ГраницаСрока", ГраницаСрока);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ПартнерыСтопОплаты", Стоп.Партнеры);
	Запрос.УстановитьПараметр("ОтборКонтрагент", ЗначениеЗаполнено(Объект.Контрагент));
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);

	ТЗРезультат = Запрос.Выполнить().Выгрузить();

	Объект.КОплате.Очистить();
	Объект.Контрагенты.Очистить();
	Объект.СтопОплаты.Очистить();

	Если ТЗРезультат.Количество() = 0 Тогда
		Сообщить("К оплате 0 руб.");
	КонецЕсли;
	Для Каждого СтрТЗ Из ТЗРезультат Цикл
		НоваяСтрока = Объект.КОплате.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТЗ);
		НоваяСтрока.Оплатить = СтрТЗ.НашДолгПросрочено > 0;
	КонецЦикла;

	// Контрагенты, которым оплата запрещена (для информации).
	Если Стоп.Партнеры.Количество() > 0 Тогда
		ЗапросСтоп = Новый Запрос;
		ЗапросСтоп.Текст =
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Контрагент
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Партнер В (&Партнеры)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Контрагенты.Наименование";
		ЗапросСтоп.УстановитьПараметр("Партнеры", Стоп.Партнеры);
		ВыборкаСтоп = ЗапросСтоп.Выполнить().Выбрать();
		Пока ВыборкаСтоп.Следующий() Цикл
			Объект.СтопОплаты.Добавить().Контрагент = ВыборкаСтоп.Контрагент;
		КонецЦикла;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура СформироватьОплаты(Команда)

	Если НЕ СформироватьОплатыНаСервере() Тогда
		Возврат;
	КонецЕсли;
	ПредыдущаяДатаОплат = Объект.ДатаОплат;
	ПредыдущийСчет1 = Объект.СчетОрганизации;
	ПредыдущийСчет2 = Объект.СчетОрганизации2;
	ПрименитьСводку(СводкаПоДокументам(), Истина);

КонецПроцедуры

#КонецОбласти

#Область ОтметкиИСуммы

&НаКлиенте
Процедура УстановитьОплатуСтрокТаблицы(ЗначениеОтметки)

	ГраницаСрока = КонецДня(Объект.ДатаОплат);
	Для Каждого СтрДок Из Объект.КОплате Цикл
		Если ЗначениеОтметки Тогда
			Если СтрДок.ДатаПлановогоПогашения <= ГраницаСрока И СтрДок.НашДолг > 0 Тогда
				СтрДок.Оплатить = Истина;
				СтрДок.НашДолгПросрочено = СтрДок.НашДолг;
			КонецЕсли;
		Иначе
			СтрДок.Оплатить = Ложь;
			СтрДок.НашДолгПросрочено = 0;
		КонецЕсли;
	КонецЦикла;
	ПрименитьСводку(СводкаПоДокументам(), Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОплатуСтрокТаблицы(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьОплатуСтрокТаблицы(Ложь);
КонецПроцедуры

// Отметка документов (с учетом отбора по контрагенту, если он задан).
&НаКлиенте
Процедура УстановитьОплатуСтрокТаблицыКОплате(ЗначениеОтметки)

	ЕстьОтбор = ЗначениеЗаполнено(КонтрагентОтборОплат);
	Для Каждого СтрДок Из Объект.КОплате Цикл
		Если ЕстьОтбор И СтрДок.Контрагент <> КонтрагентОтборОплат Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеОтметки Тогда
			Если СтрДок.НашДолг > 0 Тогда
				СтрДок.Оплатить = Истина;
				СтрДок.НашДолгПросрочено = СтрДок.НашДолг;
			КонецЕсли;
		Иначе
			СтрДок.Оплатить = Ложь;
			СтрДок.НашДолгПросрочено = 0;
		КонецЕсли;
	КонецЦикла;
	ПрименитьСводку(СводкаПоДокументам(), Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеКОплате(Команда)
	УстановитьОплатуСтрокТаблицыКОплате(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеКОплате(Команда)
	УстановитьОплатуСтрокТаблицыКОплате(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура КОплатеОплатитьПриИзменении(Элемент)

	ТекДанные = Элементы.КОплате.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекДанные.Оплатить И ТекДанные.НашДолг <= 0 Тогда
		ТекДанные.Оплатить = Ложь;
	КонецЕсли;
	ТекДанные.НашДолгПросрочено = ?(ТекДанные.Оплатить, ТекДанные.НашДолг, 0);
	ПересчитатьИтогиПоКонтрагенту(ТекДанные.Контрагент);

КонецПроцедуры

&НаКлиенте
Процедура КОплатеНашДолгПросроченоПриИзменении(Элемент)

	ТекДанные = Элементы.КОплате.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные.НашДолгПросрочено = Мин(Макс(ТекДанные.НашДолгПросрочено, 0), Макс(ТекДанные.НашДолг, 0));
	ТекДанные.Оплатить = ТекДанные.НашДолгПросрочено > 0;
	ПересчитатьИтогиПоКонтрагенту(ТекДанные.Контрагент);

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыОплатитьПриИзменении(Элемент)

	ТекДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Включали = ТекДанные.Оплатить;
	ГраницаСрока = КонецДня(Объект.ДатаОплат);
	Для Каждого СтрДок Из Объект.КОплате.НайтиСтроки(Новый Структура("Контрагент", ТекДанные.Контрагент)) Цикл
		Если Включали Тогда
			Если СтрДок.ДатаПлановогоПогашения <= ГраницаСрока И СтрДок.НашДолг > 0 Тогда
				СтрДок.Оплатить = Истина;
				СтрДок.НашДолгПросрочено = СтрДок.НашДолг;
			КонецЕсли;
		Иначе
			СтрДок.Оплатить = Ложь;
			СтрДок.НашДолгПросрочено = 0;
		КонецЕсли;
	КонецЦикла;
	ПересчитатьИтогиПоКонтрагенту(ТекДанные.Контрагент);

	Если Включали И НЕ ТекДанные.Оплатить Тогда
		Сообщить("У контрагента " + Строка(ТекДанные.Контрагент) + " нет документов со сроком оплаты до даты оплат. Отметьте нужные документы вручную.");
	КонецЕсли;

КонецПроцедуры

// Распределяет сумму по документам контрагента: сначала по документам, срок которых наступил, затем по остальным.
&НаКлиенте
Процедура ЗаполнитьСуммыОплатПоДокументам(РаспределитьОстаток, врКонтрагент)

	ГраницаСрока = КонецДня(Объект.ДатаОплат);
	СтрокиДокументов = Объект.КОплате.НайтиСтроки(Новый Структура("Контрагент", врКонтрагент));
	Для Каждого СтрДок Из СтрокиДокументов Цикл
		СтрДок.Оплатить = Ложь;
		СтрДок.НашДолгПросрочено = 0;
	КонецЦикла;

	Остаток = РаспределитьОстаток;
	Для Проход = 1 По 2 Цикл
		Для Каждого СтрДок Из СтрокиДокументов Цикл
			Если Остаток <= 0 Тогда
				Прервать;
			КонецЕсли;
			ВСрок = (СтрДок.ДатаПлановогоПогашения <= ГраницаСрока);
			Если ВСрок <> (Проход = 1) ИЛИ СтрДок.НашДолг <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Сумма = Мин(СтрДок.НашДолг, Остаток);
			СтрДок.НашДолгПросрочено = Сумма;
			СтрДок.Оплатить = Истина;
			Остаток = Окр(Остаток - Сумма, 2);
		КонецЦикла;
	КонецЦикла;
	ПересчитатьИтогиПоКонтрагенту(врКонтрагент);

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыСуммаКОплатеПриИзменении(Элемент)

	ТекДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	врКонтрагент = ТекДанные.Контрагент;
	ГраницаСрока = КонецДня(Объект.ДатаОплат);
	ДолгПоСроку = 0;
	ДолгВсего = 0;
	Для Каждого СтрДок Из Объект.КОплате.НайтиСтроки(Новый Структура("Контрагент", врКонтрагент)) Цикл
		Если СтрДок.НашДолг > 0 Тогда
			ДолгВсего = ДолгВсего + СтрДок.НашДолг;
			Если СтрДок.ДатаПлановогоПогашения <= ГраницаСрока Тогда
				ДолгПоСроку = ДолгПоСроку + СтрДок.НашДолг;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ПараметрыВопроса = Новый Структура("Контрагент, Сумма", врКонтрагент, Макс(ТекДанные.СуммаКОплате, 0));
	Если ПараметрыВопроса.Сумма > ДолгВсего Тогда
		ПоказатьПредупреждение(, "Сумма к оплате превышает общий долг по документам. Сумма будет уменьшена до суммы долга.");
		ЗаполнитьСуммыОплатПоДокументам(ДолгВсего, врКонтрагент);
	ИначеЕсли ПараметрыВопроса.Сумма > ДолгПоСроку Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПревышенииСуммыПоСроку", ЭтотОбъект, ПараметрыВопроса);
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'Сумма к оплате превышает долг по документам, срок оплаты которых наступил на дату оплат. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Внимание!");
	Иначе
		ЗаполнитьСуммыОплатПоДокументам(Параметры.Сумма, врКонтрагент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПревышенииСуммыПоСроку(Результат, ПараметрыВопроса) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСуммыОплатПоДокументам(ПараметрыВопроса.Сумма, ПараметрыВопроса.Контрагент);
	Иначе
		// Возвращаем сумму, соответствующую отмеченным документам.
		ПересчитатьИтогиПоКонтрагенту(ПараметрыВопроса.Контрагент);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентОтборОплатПриИзменении(Элемент)

	Если ЗначениеЗаполнено(КонтрагентОтборОплат) Тогда
		ЭтаФорма.Элементы.КОплате.ОтборСтрок = Новый ФиксированнаяСтруктура("Контрагент", КонтрагентОтборОплат);
	Иначе
		ЭтаФорма.Элементы.КОплате.ОтборСтрок = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СчетаИДата

&НаКлиенте
Процедура СчетОрганизацииПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.СчетОрганизации) Тогда
		Если НЕ ЗначениеЗаполнено(ПредыдущийСчет1) Тогда
			// Первое заполнение счета: все, что не ушло на второй счет, идет на первый.
			Для Каждого СтрокаК Из Объект.Контрагенты Цикл
				СтрокаК.СуммаСч1 = Макс(СтрокаК.СуммаКОплате - СтрокаК.СуммаСч2, 0);
			КонецЦикла;
		КонецЕсли;
		ПредыдущийСчет1 = Объект.СчетОрганизации;
		Элементы.КонтрагентыСуммаСч1.Видимость = Истина;
		Элементы.ГруппаИтоговСчет1.Видимость = Истина;
		ПересчитатьИтоги();
	ИначеЕсли Объект.Контрагенты.Итог("СуммаСч1") > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбИзмененииСчета", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'При очистке счета все суммы к оплате в колонке Сумма сч1 будут очищены. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Внимание!");
	Иначе
		ВыполнитьЗавершениеПослеИзмененияСчета();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбИзмененииСчета(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьЗавершениеПослеИзмененияСчета();
	ИначеЕсли ПредыдущийСчет1 <> Неопределено Тогда
		Объект.СчетОрганизации = ПредыдущийСчет1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗавершениеПослеИзмененияСчета()

	ПредыдущийСчет1 = Объект.СчетОрганизации;
	Для Каждого СтрокаК Из Объект.Контрагенты Цикл
		СтрокаК.СуммаСч1 = 0;
	КонецЦикла;
	Элементы.КонтрагентыСуммаСч1.Видимость = Ложь;
	Элементы.ГруппаИтоговСчет1.Видимость = Ложь;
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура СчетОрганизации2ПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.СчетОрганизации2) Тогда
		Если Объект.СчетОрганизации2 = Объект.СчетОрганизации Тогда
			ПоказатьПредупреждение(, "Счет организации 2 должен отличаться от счета организации 1.");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПредыдущийСчет2) Тогда
			// Первое заполнение второго счета: пересчитываем распределение по правилу «счет из договора».
			Для Каждого СтрокаК Из Объект.Контрагенты Цикл
				РаспределитьПоСчетам(СтрокаК);
			КонецЦикла;
		КонецЕсли;
		ПредыдущийСчет2 = Объект.СчетОрганизации2;
		Элементы.КонтрагентыСуммаСч2.Видимость = Истина;
		Элементы.ГруппаИтоговСчет2.Видимость = Истина;
		ПересчитатьИтоги();
	ИначеЕсли Объект.Контрагенты.Итог("СуммаСч2") > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбИзмененииСчета2", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'При очистке счета все суммы к оплате в колонке Сумма сч2 будут очищены. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Внимание!");
	Иначе
		ВыполнитьЗавершениеПослеИзмененияСчета2();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбИзмененииСчета2(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьЗавершениеПослеИзмененияСчета2();
	ИначеЕсли ПредыдущийСчет2 <> Неопределено Тогда
		Объект.СчетОрганизации2 = ПредыдущийСчет2;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗавершениеПослеИзмененияСчета2()

	ПредыдущийСчет2 = Объект.СчетОрганизации2;
	Элементы.КонтрагентыСуммаСч2.Видимость = Ложь;
	Элементы.ГруппаИтоговСчет2.Видимость = Ложь;
	// Сумма второго счета возвращается на первый.
	Для Каждого СтрокаК Из Объект.Контрагенты Цикл
		РаспределитьПоСчетам(СтрокаК);
	КонецЦикла;
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыСуммаСч1ПриИзменении(Элемент)

	ТекДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные.СуммаСч1 = Мин(Макс(ТекДанные.СуммаСч1, 0), ТекДанные.СуммаКОплате);
	Если ЗначениеЗаполнено(Объект.СчетОрганизации2) Тогда
		ТекДанные.СуммаСч2 = ТекДанные.СуммаКОплате - ТекДанные.СуммаСч1;
	КонецЕсли;
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентыСуммаСч2ПриИзменении(Элемент)

	ТекДанные = Элементы.Контрагенты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекДанные.СуммаСч2 = Мин(Макс(ТекДанные.СуммаСч2, 0), ТекДанные.СуммаКОплате);
	Если ЗначениеЗаполнено(Объект.СчетОрганизации2) Тогда
		ТекДанные.СуммаСч1 = ТекДанные.СуммаКОплате - ТекДанные.СуммаСч2;
	КонецЕсли;
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ДатаОплатПриИзменении(Элемент)

	Если Объект.Контрагенты.Итог("СуммаСч1") > 0 ИЛИ Объект.Контрагенты.Итог("СуммаСч2") > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбИзмененииДатыОплаты", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'При изменении даты оплат отметки и суммы к оплате будут пересчитаны по срокам оплаты, ручное распределение по счетам сбросится. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Внимание!");
	Иначе
		ВыполнитьЗавершениеИзмененияДатОплат();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбИзмененииДатыОплаты(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьЗавершениеИзмененияДатОплат();
	ИначеЕсли ПредыдущаяДатаОплат <> Неопределено Тогда
		Объект.ДатаОплат = ПредыдущаяДатаОплат;
	КонецЕсли;

КонецПроцедуры

// Остатки задолженности не перечитываются: меняется только отметка по сроку оплаты.
// Для актуализации долга на новую дату нажмите «Сформировать оплаты».
&НаКлиенте
Процедура ВыполнитьЗавершениеИзмененияДатОплат()

	ПредыдущаяДатаОплат = Объект.ДатаОплат;
	ГраницаСрока = КонецДня(Объект.ДатаОплат);
	Для Каждого СтрДок Из Объект.КОплате Цикл
		ВСрок = СтрДок.ДатаПлановогоПогашения <= ГраницаСрока И СтрДок.НашДолг > 0;
		СтрДок.Оплатить = ВСрок;
		СтрДок.НашДолгПросрочено = ?(ВСрок, СтрДок.НашДолг, 0);
	КонецЦикла;
	ПрименитьСводку(СводкаПоДокументам(), Ложь);

КонецПроцедуры

#КонецОбласти

#Область ПлатежныеПоручения

&НаКлиенте
Процедура СформироватьПП(Команда)

	Проверка = ПроверитьПередСозданиемПП();
	Если Проверка.Ошибки.Количество() > 0 Тогда
		Ошибки = Новый Массив;
		Для Индекс = 0 По Мин(Проверка.Ошибки.ВГраница(), 14) Цикл
			Ошибки.Добавить(Проверка.Ошибки[Индекс]);
		КонецЦикла;
		Если Проверка.Ошибки.Количество() > 15 Тогда
			Ошибки.Добавить("... и еще ошибок: " + Строка(Проверка.Ошибки.Количество() - 15));
		КонецЕсли;
		ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС));
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон("Будет создано и проведено платежных поручений: %1 на сумму %2.",
		Проверка.КоличествоПП, Формат(Проверка.Сумма, "ЧДЦ=2; ЧГ=3,0"));
	Если Объект.ОстатокСчет1 > 0 И ОстанетсяПослеОплатыСч1 < 0 Тогда
		Текст = Текст + Символы.ПС + "ВНИМАНИЕ: остатка на счете 1 недостаточно для оплаты.";
	КонецЕсли;
	Если Объект.ОстатокСчет2 > 0 И ОстанетсяПослеОплатыСч2 < 0 Тогда
		Текст = Текст + Символы.ПС + "ВНИМАНИЕ: остатка на счете 2 недостаточно для оплаты.";
	КонецЕсли;
	Текст = Текст + Символы.ПС + "Продолжить?";

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияСозданияПП", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Формирование платежных поручений");

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияСозданияПП(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	СформироватьППНаСервере();
	ПрименитьСводку(СводкаПоДокументам(), Ложь);

КонецПроцедуры

&НаКлиенте
Функция ПроверитьПередСозданиемПП()

	Результат = Новый Структура("Ошибки, КоличествоПП, Сумма", Новый Массив, 0, 0);

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат.Ошибки.Добавить("Не заполнена организация.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.СчетОрганизации) Тогда
		Результат.Ошибки.Добавить("Счет организации не заполнен. Выберите счет организации.");
	ИначеЕсли Объект.СчетОрганизации = Объект.СчетОрганизации2 Тогда
		Результат.Ошибки.Добавить("Счет организации должен отличаться от счета организации 2. Выберите разные счета для оплаты.");
	КонецЕсли;

	Сводка = СводкаПоДокументам().Данные;
	Для Каждого СтрокаК Из Объект.Контрагенты Цикл
		Если НЕ СтрокаК.Оплатить ИЛИ СтрокаК.СуммаКОплате <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Итоги = Сводка.Получить(СтрокаК.Контрагент);
		СуммаПоДокументам = ?(Итоги = Неопределено, 0, Итоги.КОплате);
		Если Окр(СуммаПоДокументам - СтрокаК.СуммаКОплате, 2) <> 0 Тогда
			Результат.Ошибки.Добавить(Строка(СтрокаК.Контрагент) + ": сумма к оплате не равна сумме по отмеченным документам ("
				+ Строка(СуммаПоДокументам) + "). Перераспределите сумму по документам.");
		КонецЕсли;
		Если Окр(СтрокаК.СуммаСч1 + СтрокаК.СуммаСч2 - СтрокаК.СуммаКОплате, 2) <> 0 Тогда
			Результат.Ошибки.Добавить(Строка(СтрокаК.Контрагент) + ": сумма по счетам не равна сумме к оплате.");
		КонецЕсли;
		Если СтрокаК.СуммаСч2 > 0 И НЕ ЗначениеЗаполнено(Объект.СчетОрганизации2) Тогда
			Результат.Ошибки.Добавить(Строка(СтрокаК.Контрагент) + ": сумма указана по счету 2, но счет организации 2 не заполнен.");
		КонецЕсли;

		Результат.КоличествоПП = Результат.КоличествоПП + ?(СтрокаК.СуммаСч1 > 0, 1, 0) + ?(СтрокаК.СуммаСч2 > 0, 1, 0);
		Результат.Сумма = Результат.Сумма + СтрокаК.СуммаКОплате;
	КонецЦикла;

	Если Результат.КоличествоПП = 0 И Результат.Ошибки.Количество() = 0 Тогда
		Результат.Ошибки.Добавить("Нет отмеченных контрагентов с суммой к оплате.");
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ВалютаРубль()

	Результат = Справочники.Валюты.НайтиПоКоду("643");
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = Справочники.Валюты.НайтиПоНаименованию("руб.", Истина);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = Справочники.Валюты.НайтиПоНаименованию("RUB", Истина);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Процент ставки НДС по предопределенному значению перечисления в ставке (НДС20, НДС20_120, НДС5, БезНДС ...).
&НаСервереБезКонтекста
Функция ПроцентСтавкиНДС(СтавкаНДС)

	Значение = СтавкаНДС.ПеречислениеСтавкаНДС;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Индекс = Перечисления.СтавкиНДС.Индекс(Значение);
	Имя = Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления[Индекс].Имя;
	Если Лев(Имя, 3) <> "НДС" Тогда
		Возврат 0;
	КонецЕсли;

	Цифры = "";
	Для Позиция = 4 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Позиция, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Цифры), 0, Число(Цифры));

КонецФункции

// Строки НДС документов приобретения: Соответствие "Документ -> массив (СтавкаНДС, Процент, СуммаСНДС)".
&НаСервереБезКонтекста
Функция СтавкиДокументов(СписокДокументов)

	Результат = Новый Соответствие;
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриобретениеТоваровУслугТовары.Ссылка КАК Документ,
		|	ПриобретениеТоваровУслугТовары.СтавкаНДС КАК СтавкаНДС,
		|	СУММА(ПриобретениеТоваровУслугТовары.СуммаСНДС) КАК СуммаСНДС
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		|ГДЕ
		|	ПриобретениеТоваровУслугТовары.Ссылка В (&Документы)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПриобретениеТоваровУслугТовары.Ссылка,
		|	ПриобретениеТоваровУслугТовары.СтавкаНДС";
	Запрос.УстановитьПараметр("Документы", СписокДокументов);

	Проценты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Процент = Проценты.Получить(Выборка.СтавкаНДС);
		Если Процент = Неопределено Тогда
			Процент = ПроцентСтавкиНДС(Выборка.СтавкаНДС);
			Проценты.Вставить(Выборка.СтавкаНДС, Процент);
		КонецЕсли;
		Строки = Результат.Получить(Выборка.Документ);
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Результат.Вставить(Выборка.Документ, Строки);
		КонецЕсли;
		Строки.Добавить(Новый Структура("СтавкаНДС, Процент, СуммаСНДС", Выборка.СтавкаНДС, Процент, Выборка.СуммаСНДС));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуПлатежа(Строки, Договор, СтавкаНДС, Процент, Сумма)

	Если Сумма <= 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Эл Из Строки Цикл
		Если Эл.Договор = Договор И Эл.СтавкаНДС = СтавкаНДС Тогда
			Эл.Сумма = Окр(Эл.Сумма + Сумма, 2);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить(Новый Структура("Договор, СтавкаНДС, Процент, Сумма", Договор, СтавкаНДС, Процент, Сумма));

КонецПроцедуры

// Строки платежа контрагента (договор + ставка НДС + сумма). Оплачиваемая сумма каждого документа
// делится между его ставками НДС пропорционально суммам документа; остаток округления уходит в последнюю ставку.
&НаСервереБезКонтекста
Функция СтрокиПлатежаПоДокументам(СтрокиДокументов, Ставки, СтавкаБезНДС)

	Результат = Новый Массив;
	Для Каждого СтрДок Из СтрокиДокументов Цикл
		Сумма = СтрДок.НашДолгПросрочено;
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокиСтавок = Ставки.Получить(СтрДок.РасчетныйДокумент);
		ИтогоДокумент = 0;
		Если СтрокиСтавок <> Неопределено Тогда
			Для Каждого СтрСтавки Из СтрокиСтавок Цикл
				ИтогоДокумент = ИтогоДокумент + СтрСтавки.СуммаСНДС;
			КонецЦикла;
		КонецЕсли;

		Если СтрокиСтавок = Неопределено ИЛИ ИтогоДокумент <= 0 Тогда
			Сообщить("Документ " + Строка(СтрДок.РасчетныйДокумент) + ": нет данных о ставках НДС, платеж отнесен на «Без НДС».");
			ДобавитьСтрокуПлатежа(Результат, СтрДок.Договор, СтавкаБезНДС, 0, Сумма);
			Продолжить;
		КонецЕсли;

		Остаток = Сумма;
		Для Индекс = 0 По СтрокиСтавок.ВГраница() Цикл
			СтрСтавки = СтрокиСтавок[Индекс];
			Если Индекс = СтрокиСтавок.ВГраница() Тогда
				Часть = Остаток;
			Иначе
				Часть = Мин(Окр(Сумма * СтрСтавки.СуммаСНДС / ИтогоДокумент, 2), Остаток);
			КонецЕсли;
			Остаток = Окр(Остаток - Часть, 2);
			ДобавитьСтрокуПлатежа(Результат, СтрДок.Договор, СтрСтавки.СтавкаНДС, СтрСтавки.Процент, Часть);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Забирает из строк платежа указанную сумму (строки уменьшаются), возвращает взятые строки.
&НаСервереБезКонтекста
Функция ВзятьСтрокиПлатежа(Строки, Сумма)

	Результат = Новый Массив;
	Остаток = Сумма;
	Для Каждого Эл Из Строки Цикл
		Если Остаток <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если Эл.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Часть = Мин(Эл.Сумма, Остаток);
		Результат.Добавить(Новый Структура("Договор, СтавкаНДС, Процент, Сумма", Эл.Договор, Эл.СтавкаНДС, Эл.Процент, Часть));
		Эл.Сумма = Окр(Эл.Сумма - Часть, 2);
		Остаток = Окр(Остаток - Часть, 2);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция СоздатьПлатежноеПоручение(КонтрагентПП, Счет, Строки, Валюта)

	СуммаПП = 0;
	Для Каждого Эл Из Строки Цикл
		СуммаПП = СуммаПП + Эл.Сумма;
	КонецЦикла;

	Док = Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент();
	Док.ДатаВходящегоДокумента = ТекущаяДатаСеанса();
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	Док.Организация = Объект.Организация;
	Док.Валюта = Валюта;
	Док.БанковскийСчет = Счет;
	Док.ПеречислениеВБюджет = Ложь;
	Док.ВидПеречисленияВБюджет = Перечисления.ВидыПеречисленийВБюджет.НалоговыйПлатеж;
	Док.НеКонтролироватьЗаполнениеЗаявки = Ложь;
	Док.ТипПлатежногоДокумента = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
	Док.ОплатаПоЗаявкам = Ложь;
	Док.ПроводкиПоРаботникам = Ложь;
	Док.ПроведеноБанком = Ложь;
	Док.Контрагент = КонтрагентПП;
	Док.Партнер = КонтрагентПП.Партнер;
	Док.СуммаДокумента = СуммаПП;
	Док.ОчередностьПлатежа = 5;
	Док.Дата = ТекущаяДатаСеанса();

	Для Каждого Эл Из Строки Цикл
		ОбъектРасчетов = Справочники.ОбъектыРасчетов.НайтиПоРеквизиту("Объект", Эл.Договор);
		Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
			ВызватьИсключение "Не найден объект расчетов для договора " + Строка(Эл.Договор);
		КонецЕсли;
		НоваяСтрока = Док.РасшифровкаПлатежа.Добавить();
		НоваяСтрока.Партнер = Док.Партнер;
		НоваяСтрока.ВалютаВзаиморасчетов = Валюта;
		НоваяСтрока.Сумма = Эл.Сумма;
		НоваяСтрока.СуммаВзаиморасчетов = Эл.Сумма;
		НоваяСтрока.Организация = Док.Организация;
		НоваяСтрока.СтавкаНДС = Эл.СтавкаНДС;
		НоваяСтрока.СуммаНДС = Окр(Эл.Сумма * Эл.Процент / (100 + Эл.Процент), 2);
		НоваяСтрока.ОбъектРасчетов = ОбъектРасчетов;
		НоваяСтрока.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
	КонецЦикла;

	Док.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(
		Док.Контрагент, Док.Валюта);

	Док.Записать();
	Док.НомерВходящегодокумента = СокрЛП(ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Док.Номер, Истина, Истина));
	ДенежныеСредстваСервер.ЗаполнитьТекстНазначенияПлатежа(Док);
	Док.Записать(РежимЗаписиДокумента.Проведение);

	Возврат Док.Ссылка;

КонецФункции

&НаСервере
Процедура СформироватьППНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Организация) ИЛИ НЕ ЗначениеЗаполнено(Объект.СчетОрганизации) Тогда
		Сообщить("Не заполнена организация или счет организации.");
		Возврат;
	КонецЕсли;
	Валюта = ВалютаРубль();
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Сообщить("Не найдена валюта «руб.» (код 643).");
		Возврат;
	КонецЕсли;
	СтавкаБезНДС = Справочники.СтавкиНДС.БезНДС;

	ТЗДокументов = Объект.КОплате.Выгрузить(Новый Структура("Оплатить", Истина));
	Ставки = СтавкиДокументов(ТЗДокументов.ВыгрузитьКолонку("РасчетныйДокумент"));
	ТЗКонтрагентов = Объект.Контрагенты.Выгрузить(Новый Структура("Оплатить", Истина));

	Оплаченные = Новый Массив;
	КоличествоСоздано = 0;
	Для Каждого СтрокаК Из ТЗКонтрагентов Цикл
		Сумма1 = Окр(СтрокаК.СуммаСч1, 2);
		Сумма2 = Окр(СтрокаК.СуммаСч2, 2);
		Если Сумма1 + Сумма2 <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Строки = СтрокиПлатежаПоДокументам(ТЗДокументов.НайтиСтроки(Новый Структура("Контрагент", СтрокаК.Контрагент)), Ставки, СтавкаБезНДС);
		ИтогоСтрок = 0;
		Для Каждого Эл Из Строки Цикл
			ИтогоСтрок = ИтогоСтрок + Эл.Сумма;
		КонецЦикла;
		Если Окр(ИтогоСтрок - Сумма1 - Сумма2, 2) <> 0 Тогда
			Сообщить(Строка(СтрокаК.Контрагент) + ": сумма по документам (" + Строка(ИтогоСтрок) + ") не равна сумме по счетам ("
				+ Строка(Сумма1 + Сумма2) + "), платежные поручения не созданы.");
			Продолжить;
		КонецЕсли;

		Созданные = Новый Массив;
		НачатьТранзакцию();
		Попытка
			Если Сумма1 > 0 Тогда
				Созданные.Добавить(СоздатьПлатежноеПоручение(СтрокаК.Контрагент, Объект.СчетОрганизации, ВзятьСтрокиПлатежа(Строки, Сумма1), Валюта));
			КонецЕсли;
			Если Сумма2 > 0 Тогда
				Созданные.Добавить(СоздатьПлатежноеПоручение(СтрокаК.Контрагент, Объект.СчетОрганизации2, ВзятьСтрокиПлатежа(Строки, Сумма2), Валюта));
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Сообщить(Строка(СтрокаК.Контрагент) + ": платежные поручения не созданы. " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Для Каждого Ссылка Из Созданные Цикл
			Сообщить("Создано и проведено: " + Строка(Ссылка));
			КоличествоСоздано = КоличествоСоздано + 1;
		КонецЦикла;
		Оплаченные.Добавить(СтрокаК.Контрагент);
	КонецЦикла;

	// Оплаченные документы убираем из списка, чтобы повторное нажатие не создало дубли.
	Для Каждого Контрагент Из Оплаченные Цикл
		Для Каждого СтрДок Из Объект.КОплате.НайтиСтроки(Новый Структура("Контрагент, Оплатить", Контрагент, Истина)) Цикл
			Объект.КОплате.Удалить(СтрДок);
		КонецЦикла;
	КонецЦикла;

	Сообщить("Создано платежных поручений: " + Строка(КоличествоСоздано) + ". Для актуализации задолженности нажмите «Сформировать оплаты».");

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Объект.ДатаОплат = КонецДня(ТекущаяДатаСеанса() + 3600 * 24);

КонецПроцедуры
