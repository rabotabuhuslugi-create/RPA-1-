// Внешняя обработка "Контроль инкассации" (1С:Комплексная автоматизация, управляемая форма).
// Весь модуль вставляется в модуль ПУСТОЙ управляемой формы обработки.
// Реквизиты и элементы формы создаются кодом в ПриСозданииНаСервере.

#Область Настройки

// Единственное место, где нужно править имена под вашу конфигурацию.
// Проверить имена: Конфигуратор -> дерево метаданных, либо <база>/odata/standard.odata/$metadata
&НаСервере
Функция Настройки()
	Н = Новый Структура;
	Н.Вставить("Регистр",           "ДенежныеСредстваВПути");  // регистр накопления "Денежные средства в пути"
	Н.Вставить("ДокРКО",            "РасходныйКассовыйОрдер");
	Н.Вставить("ДокПоступление",    "ПоступлениеБезналичныхДенежныхСредств");
	Н.Вставить("РеквНомерСумки",    "НомерСумки");             // реквизит РКО "Номер сумки"
	Н.Вставить("РеквНомерПоБанку",  "НомерПоБанку");           // реквизит поступления "Номер по банку"
	Н.Вставить("РеквНазначение",    "НазначениеПлатежа");      // реквизит поступления "Назначение платежа"
	Н.Вставить("ВидПеревода",       "Инкассация в банк");      // представление вида перевода (сравнивается как строка)
	Н.Вставить("ДопускДней",        3);                        // календарных дней на поступление
	Н.Вставить("ДопускДнейСинк",    1);                        // самоинкассация: зачисление не позже чем через N календарных дней
	Н.Вставить("ПроверятьОстаток",  Истина);                   // контроль остатка кассы после инкассации
	Н.Вставить("ЛимитОстатка",      40000);                    // остаток кассы после инкассации не должен превышать
	Н.Вставить("РегНаличные",       "ДенежныеСредстваНаличные"); // запасное имя регистра "Денежные средства (наличные)"
	Н.Вставить("ЛимитНакопленийПоУмолчанию", 300000);          // лимит накопления наличных в кассе по умолчанию
	Н.Вставить("БанкиРСХ",          "рсх, россельхоз");        // подстроки (через запятую) в названии счёта-получателя инкассации РСХ
	Н.Вставить("ДопускПропуска",    1);                        // дней: РКО "в день графика" можно сделать в течение N дней
	Н.Вставить("ХранилищеОбъект",   "КонтрольИнкассации");
	Н.Вставить("ХранилищеКлюч",     "Графики");
	Возврат Н;
КонецФункции

#КонецОбласти

#Область СозданиеФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Н = Настройки();
	ТипКассы = Метаданные.РегистрыНакопления[Н.Регистр].Измерения.Отправитель.Тип;

	Дни = Новый Массив;
	Дни.Добавить("Пн"); Дни.Добавить("Вт"); Дни.Добавить("Ср"); Дни.Добавить("Чт");
	Дни.Добавить("Пт"); Дни.Добавить("Сб"); Дни.Добавить("Вс");

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаНач",  Новый ОписаниеТипов("Дата")));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаКон",  Новый ОписаниеТипов("Дата")));
	Реквизиты.Добавить(Новый РеквизитФормы("Результат", Новый ОписаниеТипов("ТабличныйДокумент")));
	Реквизиты.Добавить(Новый РеквизитФормы("Графики",   Новый ОписаниеТипов("ТаблицаЗначений")));
	Реквизиты.Добавить(Новый РеквизитФормы("Касса", ТипКассы, "Графики", "Касса"));
	Реквизиты.Добавить(Новый РеквизитФормы("Магазин", Новый ОписаниеТипов("Строка"), "Графики", "Магазин"));
	Реквизиты.Добавить(Новый РеквизитФормы("СИнк", Новый ОписаниеТипов("Булево"), "Графики", "СИнк"));
	Реквизиты.Добавить(Новый РеквизитФормы("Закрыт", Новый ОписаниеТипов("Булево"), "Графики", "Закрыт"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоказыватьУспешные", Новый ОписаниеТипов("Булево")));
	Для Каждого Д Из Дни Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Д, Новый ОписаниеТипов("Булево"), "Графики", Д));
	КонецЦикла;
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный));
	Реквизиты.Добавить(Новый РеквизитФормы("ЛимитНакоплений", ТипЧисло));
	Реквизиты.Добавить(Новый РеквизитФормы("РезультатРасчёта", Новый ОписаниеТипов("ТабличныйДокумент")));
	Реквизиты.Добавить(Новый РеквизитФормы("Сценарии", Новый ОписаниеТипов("ТаблицаЗначений")));
	Реквизиты.Добавить(Новый РеквизитФормы("Лимит", ТипЧисло, "Сценарии", "Лимит на выезд"));
	ИзменитьРеквизиты(Реквизиты);

	ЭтаФорма.ДатаКон = НачалоДня(ТекущаяДата());
	ЭтаФорма.ДатаНач = НачалоМесяца(ЭтаФорма.ДатаКон);

	// Элементы
	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"), ЭтаФорма);
	Страницы.Вид = ВидГруппыФормы.Страницы;
	СтрОтчет = Элементы.Добавить("СтраницаОтчет", Тип("ГруппаФормы"), Страницы);
	СтрОтчет.Вид = ВидГруппыФормы.Страница;
	СтрОтчет.Заголовок = "Отчёт";
	СтрГрафики = Элементы.Добавить("СтраницаГрафики", Тип("ГруппаФормы"), Страницы);
	СтрГрафики.Вид = ВидГруппыФормы.Страница;
	СтрГрафики.Заголовок = "Графики инкассации";

	// --- страница отчёта
	Панель = Элементы.Добавить("ПанельОтбора", Тип("ГруппаФормы"), СтрОтчет);
	Панель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Панель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Панель.Отображение = ОтображениеОбычнойГруппы.Нет;

	П1 = Элементы.Добавить("ДатаНач", Тип("ПолеФормы"), Панель);
	П1.Вид = ВидПоляФормы.ПолеВвода; П1.ПутьКДанным = "ДатаНач"; П1.Заголовок = "Период с";
	П2 = Элементы.Добавить("ДатаКон", Тип("ПолеФормы"), Панель);
	П2.Вид = ВидПоляФормы.ПолеВвода; П2.ПутьКДанным = "ДатаКон"; П2.Заголовок = "по";

	П3 = Элементы.Добавить("ПоказыватьУспешные", Тип("ПолеФормы"), Панель);
	П3.Вид = ВидПоляФормы.ПолеФлажка; П3.ПутьКДанным = "ПоказыватьУспешные"; П3.Заголовок = "Показывать успешные";

	П4 = Элементы.Добавить("ЛимитНакоплений", Тип("ПолеФормы"), Панель);
	П4.Вид = ВидПоляФормы.ПолеВвода; П4.ПутьКДанным = "ЛимитНакоплений"; П4.Заголовок = "Лимит накоплений";
	П4.Подсказка = "Остаток наличных в кассе на конец дня выше этой суммы считается ошибкой. 0 - проверка выключена.";

	Команда = Команды.Добавить("Сформировать");
	Команда.Действие = "Сформировать";
	Команда.Заголовок = "Сформировать";
	Кн = Элементы.Добавить("Сформировать", Тип("КнопкаФормы"), Панель);
	Кн.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды = "Сформировать";

	Р = Элементы.Добавить("Результат", Тип("ПолеФормы"), СтрОтчет);
	Р.Вид = ВидПоляФормы.ПолеТабличногоДокумента; Р.ПутьКДанным = "Результат";
	Р.ТолькоПросмотр = Истина;

	// --- страница графиков
	ПанельГ = Элементы.Добавить("ПанельГрафиков", Тип("ГруппаФормы"), СтрГрафики);
	ПанельГ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПанельГ.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПанельГ.Отображение = ОтображениеОбычнойГруппы.Нет;

	К1 = Команды.Добавить("ЗаполнитьКассы");
	К1.Действие = "ЗаполнитьКассы"; К1.Заголовок = "Добавить кассы из движений";
	Б1 = Элементы.Добавить("ЗаполнитьКассы", Тип("КнопкаФормы"), ПанельГ);
	Б1.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Б1.ИмяКоманды = "ЗаполнитьКассы";

	К2 = Команды.Добавить("СохранитьГрафики");
	К2.Действие = "СохранитьГрафики"; К2.Заголовок = "Сохранить графики";
	Б2 = Элементы.Добавить("СохранитьГрафики", Тип("КнопкаФормы"), ПанельГ);
	Б2.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Б2.ИмяКоманды = "СохранитьГрафики";

	Т = Элементы.Добавить("Графики", Тип("ТаблицаФормы"), СтрГрафики);
	Т.ПутьКДанным = "Графики";
	Т.Заголовок = "Дни инкассации по кассам (отметьте 1-2 дня недели)";
	Кс = Элементы.Добавить("ГрафикиКасса", Тип("ПолеФормы"), Т);
	Кс.Вид = ВидПоляФормы.ПолеВвода; Кс.ПутьКДанным = "Графики.Касса"; Кс.Заголовок = "Касса";
	Км = Элементы.Добавить("ГрафикиМагазин", Тип("ПолеФормы"), Т);
	Км.Вид = ВидПоляФормы.ПолеВвода; Км.ПутьКДанным = "Графики.Магазин"; Км.Заголовок = "Магазин (из списка)";
	Для Каждого Д Из Дни Цикл
		Э = Элементы.Добавить("Графики" + Д, Тип("ПолеФормы"), Т);
		Э.Вид = ВидПоляФормы.ПолеФлажка; Э.ПутьКДанным = "Графики." + Д; Э.Заголовок = Д;
	КонецЦикла;
	Эс = Элементы.Добавить("ГрафикиСИнк", Тип("ПолеФормы"), Т);
	Эс.Вид = ВидПоляФормы.ПолеФлажка; Эс.ПутьКДанным = "Графики.СИнк"; Эс.Заголовок = "С/инк";
	Эз = Элементы.Добавить("ГрафикиЗакрыт", Тип("ПолеФормы"), Т);
	Эз.Вид = ВидПоляФормы.ПолеФлажка; Эз.ПутьКДанным = "Графики.Закрыт"; Эз.Заголовок = "Закрыт";

	// --- страница расчёта инкассации
	СтрРасчёт = Элементы.Добавить("СтраницаРасчёт", Тип("ГруппаФормы"), Страницы);
	СтрРасчёт.Вид = ВидГруппыФормы.Страница;
	СтрРасчёт.Заголовок = "Расчёт инкассации";

	ПанельР = Элементы.Добавить("ПанельРасчёта", Тип("ГруппаФормы"), СтрРасчёт);
	ПанельР.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПанельР.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПанельР.Отображение = ОтображениеОбычнойГруппы.Нет;
	Р1 = Элементы.Добавить("ДатаНачРасчёт", Тип("ПолеФормы"), ПанельР);
	Р1.Вид = ВидПоляФормы.ПолеВвода; Р1.ПутьКДанным = "ДатаНач"; Р1.Заголовок = "Период с";
	Р2 = Элементы.Добавить("ДатаКонРасчёт", Тип("ПолеФормы"), ПанельР);
	Р2.Вид = ВидПоляФормы.ПолеВвода; Р2.ПутьКДанным = "ДатаКон"; Р2.Заголовок = "по";
	К4 = Команды.Добавить("Рассчитать");
	К4.Действие = "Рассчитать"; К4.Заголовок = "Рассчитать";
	Б4 = Элементы.Добавить("Рассчитать", Тип("КнопкаФормы"), ПанельР);
	Б4.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Б4.ИмяКоманды = "Рассчитать";

	Тс = Элементы.Добавить("Сценарии", Тип("ТаблицаФормы"), СтрРасчёт);
	Тс.ПутьКДанным = "Сценарии";
	Тс.Заголовок = "Сравниваемые лимиты на выезд (можно менять, добавлять и удалять строки)";
	Тс.Высота = 6;
	Кл = Элементы.Добавить("СценарииЛимит", Тип("ПолеФормы"), Тс);
	Кл.Вид = ВидПоляФормы.ПолеВвода; Кл.ПутьКДанным = "Сценарии.Лимит"; Кл.Заголовок = "Лимит на выезд";

	Рр = Элементы.Добавить("РезультатРасчёта", Тип("ПолеФормы"), СтрРасчёт);
	Рр.Вид = ВидПоляФормы.ПолеТабличногоДокумента; Рр.ПутьКДанным = "РезультатРасчёта";
	Рр.ТолькоПросмотр = Истина;

	ЗагрузитьГрафики();
	ЗагрузитьНастройкиРасчёта();
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Сформировать(Команда)
	Если ЭтаФорма.ДатаНач > ЭтаФорма.ДатаКон Тогда
		Сообщить("Начало периода позже конца");
		Возврат;
	КонецЕсли;
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	Если ЭтаФорма.ДатаНач > ЭтаФорма.ДатаКон Тогда
		Сообщить("Начало периода позже конца");
		Возврат;
	КонецЕсли;
	РассчитатьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьГрафики(Команда)
	СохранитьГрафикиНаСервере();
	Сообщить("Графики сохранены");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКассы(Команда)
	ЗаполнитьКассыНаСервере();
КонецПроцедуры

#КонецОбласти

#Область Графики

&НаСервере
Процедура ЗагрузитьГрафики()
	Н = Настройки();
	ЭтаФорма.Графики.Очистить();
	Данные = ХранилищеОбщихНастроек.Загрузить(Н.ХранилищеОбъект, Н.ХранилищеКлюч);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого С Из Данные Цикл
		Строка = ЭтаФорма.Графики.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, С);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьГрафикиНаСервере()
	Н = Настройки();
	Данные = Новый Массив;
	Для Каждого Строка Из ЭтаФорма.Графики Цикл
		Если Не ЗначениеЗаполнено(Строка.Касса) Тогда
			Продолжить;
		КонецЕсли;
		С = Новый Структура("Касса, Магазин, Пн, Вт, Ср, Чт, Пт, Сб, Вс, СИнк, Закрыт");
		ЗаполнитьЗначенияСвойств(С, Строка);
		Данные.Добавить(С);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(Н.ХранилищеОбъект, Н.ХранилищеКлюч, Данные);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКассыНаСервере()
	Н = Настройки();
	Строки = ПрочитатьДвижения(НачалоДня(ТекущаяДата()) - 120 * 86400, КонецДня(ТекущаяДата()), Н);
	Есть = Новый Соответствие;
	Для Каждого Стр Из ЭтаФорма.Графики Цикл
		Есть.Вставить(Стр.Касса, Истина);
	КонецЦикла;
	Для Каждого Д Из Строки Цикл
		Если Д.Приход И Есть[Д.Касса] = Неопределено Тогда
			ЭтаФорма.Графики.Добавить().Касса = Д.Касса;
			Есть.Вставить(Д.Касса, Истина);
		КонецЕсли;
	КонецЦикла;
	ЭтаФорма.Графики.Сортировать("Касса");
КонецПроцедуры

#КонецОбласти

#Область Данные

// Возвращает массив структур с движениями "Денежные средства в пути" по инкассации.
&НаСервере
Функция ПрочитатьДвижения(Нач, Кон, Н)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Регистратор КАК Регистратор,
	|	Д.Период КАК Период,
	|	Д.ВидДвижения КАК ВидДвижения,
	|	Д.ВидПереводаДенежныхСредств КАК Вид,
	|	Д.Отправитель КАК Касса,
	|	Д.Получатель КАК Получатель,
	|	Д.Организация КАК Организация,
	|	Д.Сумма КАК Сумма,
	|	&ВыражСумки КАК НомерСумки,
	|	&ВыражБанк КАК НомерПоБанку,
	|	&ВыражНазначение КАК Назначение
	|ИЗ
	|	РегистрНакопления.&Регистр КАК Д
	|ГДЕ
	|	Д.Период МЕЖДУ &Нач И &Кон
	|	И Д.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Д.Период,
	|	Д.Регистратор";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражСумки", ВыражениеРеквизита(Н.ДокРКО, Н.РеквНомерСумки,
		"номер сумки, номер сумки инкассации", "НомерСумки, НомерПакета, НомерПломбы, НомерСумкиИнкассации"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражБанк", ВыражениеРеквизита(Н.ДокПоступление, Н.РеквНомерПоБанку,
		"номер по банку, номер платежного документа, номер входящего документа, номер платежки",
		"НомерПоБанку, НомерВходящегоДокумента, НомерПоВходящемуДокументу, НомерПлатежногоДокумента, НомерПлатежногоПоручения, НомерВходящегоПлатежногоДокумента"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражНазначение", ВыражениеРеквизита(Н.ДокПоступление, Н.РеквНазначение,
		"назначение платежа, назначение", "НазначениеПлатежа, Назначение"));
	Для Каждого КЗ Из Н Цикл
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&" + КЗ.Ключ, Строка(КЗ.Значение));
	КонецЦикла;
	Запрос.УстановитьПараметр("Нач", Нач);
	Запрос.УстановитьПараметр("Кон", Кон);

	МассивДвижений = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строка(Выборка.Вид) <> Н.ВидПеревода Тогда
			Продолжить;
		КонецЕсли;
		С = Новый Структура;
		С.Вставить("Регистратор", Выборка.Регистратор);
		С.Вставить("Дата",   НачалоДня(Выборка.Период));
		С.Вставить("Приход", Выборка.ВидДвижения = ВидДвиженияНакопления.Приход);
		С.Вставить("Касса",  Выборка.Касса);
		С.Вставить("Организация", Строка(Выборка.Организация));
		С.Вставить("Получатель", НРег(Строка(Выборка.Получатель)));
		С.Вставить("Сумма",  Выборка.Сумма);
		// ключ сопоставления: номер сумки (РКО) / номер по банку, иначе номер из назначения платежа
		Ключ = НормализоватьНомер(Выборка.НомерСумки);
		Если Ключ = "" Тогда Ключ = НормализоватьНомер(Выборка.НомерПоБанку); КонецЕсли;
		Если Ключ = "" Тогда Ключ = НомерИзНазначения(Выборка.Назначение); КонецЕсли;
		С.Вставить("Ключ", Ключ);
		С.Вставить("Использован", Ложь);
		МассивДвижений.Добавить(С);
	КонецЦикла;
	Возврат МассивДвижений;
КонецФункции

// Возвращает фрагмент запроса для реквизита документа-регистратора.
// Ищет реквизит: 1) по имени из настроек, 2) по синониму (то, что видно на форме), 3) по запасным именам.
// Если реквизита нет, подставляет пустую строку и сообщает об этом.
&НаСервере
Функция ВыражениеРеквизита(ИмяДокумента, ИмяРеквизита, Синонимы, Имена)
	МД = Метаданные.Документы.Найти(ИмяДокумента);
	Если МД = Неопределено Тогда
		Сообщить("Документ не найден в конфигурации: " + ИмяДокумента + " (исправьте в Настройки())");
		Возврат """""";
	КонецЕсли;
	Найден = "";
	Если МД.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Найден = ИмяРеквизита;
	КонецЕсли;
	Если Найден = "" Тогда
		Список = СтрРазделить(Синонимы, ",", Ложь);
		Для Каждого Р Из МД.Реквизиты Цикл
			Для Каждого Син Из Список Цикл
				Если НРег(СокрЛП(Р.Синоним)) = СокрЛП(Син) Тогда
					Найден = Р.Имя; Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Найден <> "" Тогда Прервать; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Найден = "" Тогда
		Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
			Если МД.Реквизиты.Найти(СокрЛП(Имя)) <> Неопределено Тогда
				Найден = СокрЛП(Имя); Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Найден = "" Тогда
		Сообщить("У документа " + ИмяДокумента + " не найден реквизит '" + ИмяРеквизита + "'. Сопоставление пойдёт без него. Реквизиты документа: "
			+ СтрСоединить(РеквизитыДокумента(МД), ", "));
		Возврат """""";
	КонецЕсли;
	Возврат "ВЫРАЗИТЬ(Д.Регистратор КАК Документ." + ИмяДокумента + ")." + Найден;
КонецФункции

&НаСервере
Функция РеквизитыДокумента(МД)
	М = Новый Массив;
	Для Каждого Р Из МД.Реквизиты Цикл
		М.Добавить(Р.Имя + " (" + Р.Синоним + ")");
	КонецЦикла;
	Возврат М;
КонецФункции

// Оставляет только цифры и убирает ведущие нули: "015976988" -> "15976988".
&НаСервере
Функция НормализоватьНомер(Знач Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = Строка(Текст);
	Цифры = "";
	Для й = 1 По СтрДлина(Текст) Цикл
		С = Сред(Текст, й, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		КонецЕсли;
	КонецЦикла;
	Пока Лев(Цифры, 1) = "0" Цикл
		Цифры = Сред(Цифры, 2);
	КонецЦикла;
	Возврат Цифры;
КонецФункции

// Достаёт номер препроводительной ведомости из текста "...ведомости №15976988 от ...".
&НаСервере
Функция НомерИзНазначения(Знач Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = Строка(Текст);
	Поз = СтрНайти(НРег(Текст), "ведомости №");
	Смещение = 11;
	Если Поз = 0 Тогда
		Поз = СтрНайти(Текст, "№");
		Смещение = 1;
	КонецЕсли;
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Поз + Смещение);
	Цифры = "";
	Для й = 1 По СтрДлина(Хвост) Цикл
		С = Сред(Хвост, й, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		ИначеЕсли С = " " И Цифры = "" Тогда
			Продолжить;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НормализоватьНомер(Цифры);
КонецФункции

#КонецОбласти

#Область Отчет

// Остаток кассы после каждого РКО: регистр "Денежные средства (наличные)", остатки по регистраторам.
// Возвращает Соответствие "документ-регистратор -> Соответствие(касса -> остаток после документа)".
&НаСервере
Функция ПрочитатьОстаткиКасс(Нач, Кон, Н)
	Остатки = Новый Соответствие;
	Попытка
		Опис = ОписаниеРегистраНаличных(Н);
		Если Опис = Неопределено Тогда
			Возврат Остатки;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Регистратор КАК Регистратор,
		|	Т.[Изм] КАК Касса,
		|	Т.[Ресурс]КонечныйОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.[Рег].ОстаткиИОбороты(&Нач, &Кон, Регистратор, ДвиженияИГраницыПериода) КАК Т
		|ГДЕ
		|	Т.Регистратор ЕСТЬ НЕ NULL";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Рег]", Опис.Рег);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Ресурс]", Опис.Рес);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Изм]", Опис.Изм);
		Запрос.УстановитьПараметр("Нач", Нач);
		Запрос.УстановитьПараметр("Кон", Кон);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПоРег = Остатки[Выборка.Регистратор];
			Если ПоРег = Неопределено Тогда
				ПоРег = Новый Соответствие;
				Остатки.Вставить(Выборка.Регистратор, ПоРег);
			КонецЕсли;
			ПоРег.Вставить(Выборка.Касса, Выборка.Остаток);
		КонецЦикла;
	Исключение
		Сообщить("Остаток кассы не проверен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Остатки;
КонецФункции

&НаСервере
Функция Ранг(Цвет)
	Если Цвет = "Красный" Тогда Возврат 0; КонецЕсли;
	Если Цвет = "Жёлтый" Тогда Возврат 1; КонецЕсли;
	Если Цвет = "Серый" Тогда Возврат 2; КонецЕсли;
	Возврат 3;
КонецФункции

&НаСервере
Функция Деньги(Сумма)
	Если Сумма = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
КонецФункции

&НаСервере
Процедура СформироватьНаСервере()

	Н = Настройки();
	СохранитьНастройкиРасчёта();
	Сутки = 86400;
	Сегодня = НачалоДня(ТекущаяДата());
	НачП = НачалоДня(ЭтаФорма.ДатаНач);
	КонП = КонецДня(ЭтаФорма.ДатаКон);

	// запас по краям, чтобы сопоставить пары, пересекающие границу периода
	Все = ПрочитатьДвижения(НачП - 10 * Сутки, КонП + 10 * Сутки, Н);
	Приходы = Новый Массив;
	Расходы = Новый Массив;
	Для Каждого Д Из Все Цикл
		Если Д.Приход Тогда Приходы.Добавить(Д); Иначе Расходы.Добавить(Д); КонецЕсли;
	КонецЦикла;
	Остатки = ?(Н.ПроверятьОстаток, ПрочитатьОстаткиКасс(НачП - 10 * Сутки, КонП + 10 * Сутки, Н), Новый Соответствие);

	График = ГрафикПоКассам();

	Итог = Новый Массив;

	Для Каждого П Из Приходы Цикл

		Г = График[П.Касса];
		СИнк = (Г <> Неопределено И Г.СИнк);
		СрокДней = ?(СИнк, Н.ДопускДнейСинк, Н.ДопускДней);
		Срок = СрокДней * Сутки;

		// ---- поиск зачислений
		Пары = Новый Массив;
		// 1) по номеру сумки / номеру ведомости
		Если П.Ключ <> "" Тогда
			Для Каждого Р Из Расходы Цикл
				Если Не Р.Использован И Р.Ключ = П.Ключ И Р.Касса = П.Касса Тогда
					Пары.Добавить(Р); Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// 2) одно зачисление на ту же сумму в окне допуска
		Если Пары.Количество() = 0 Тогда
			Для Каждого Р Из Расходы Цикл
				Если Не Р.Использован И Р.Касса = П.Касса И Р.Сумма = П.Сумма
					И Р.Дата >= П.Дата И Р.Дата - П.Дата <= Срок Тогда
					Пары.Добавить(Р); Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// 3) зачисление несколькими суммами: складываем по порядку, пока не наберём сумму РКО
		Если Пары.Количество() = 0 Тогда
			Кандидаты = Новый Массив;
			Накоплено = 0;
			Для Каждого Р Из Расходы Цикл
				Если Не Р.Использован И Р.Касса = П.Касса И Р.Дата >= П.Дата И Р.Дата - П.Дата <= Срок Тогда
					Кандидаты.Добавить(Р);
					Накоплено = Накоплено + Р.Сумма;
					Если Накоплено >= П.Сумма Тогда Прервать; КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			// у самоинкассации принимаем и неполную/избыточную сумму, чтобы показать разницу
			Если Накоплено = П.Сумма Или (СИнк И Кандидаты.Количество() > 0) Тогда
				Пары = Кандидаты;
			КонецЕсли;
		КонецЕсли;

		СуммаПост = 0;
		ПоследняяДата = Неопределено;
		ДатыПост = Новый Массив;
		Для Каждого Р Из Пары Цикл
			Р.Использован = Истина;
			СуммаПост = СуммаПост + Р.Сумма;
			Если ПоследняяДата = Неопределено Или Р.Дата > ПоследняяДата Тогда
				ПоследняяДата = Р.Дата;
			КонецЕсли;
			ДатыПост.Добавить(Формат(Р.Дата, "ДФ=dd.MM"));
		КонецЦикла;

		Если П.Дата < НачП Или П.Дата > КонП Тогда
			Продолжить; // запись за границей периода нужна была только для пары
		КонецЕсли;

		// ---- проблемы
		Проблемы = Новый Массив; // структуры (Цвет, Имя, Текст)
		Если Пары.Количество() = 0 Тогда
			Если Сегодня - П.Дата > Срок Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Нет поступления",
					"в банк не поступило в течение " + СрокДней + " дн."));
			Иначе
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Серый", "В пути",
					"срок зачисления (" + СрокДней + " дн.) не вышел"));
			КонецЕсли;
		ИначеЕсли СуммаПост <> П.Сумма Тогда
			Если СуммаПост < П.Сумма И Сегодня - П.Дата <= Срок Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Серый", "Зачислено частично",
					"пока " + Деньги(СуммаПост) + " из " + Деньги(П.Сумма)));
			Иначе
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Расхождение суммы",
					"РКО " + Деньги(П.Сумма) + ", в банк " + Деньги(СуммаПост) + ", разница " + Деньги(СуммаПост - П.Сумма)));
			КонецЕсли;
		ИначеЕсли ПоследняяДата - П.Дата > Срок Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Позже срока",
				"зачислено через " + Формат((ПоследняяДата - П.Дата) / Сутки, "ЧГ=0") + " дн., допустимо " + СрокДней));
		КонецЕсли;

		ПоРег = Остатки[П.Регистратор];
		Остаток = ?(ПоРег = Неопределено, Неопределено, ПоРег[П.Касса]);
		Если Остаток <> Неопределено И Остаток > Н.ЛимитОстатка Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Остаток кассы",
				"после инкассации в кассе " + Деньги(Остаток) + " (лимит " + Деньги(Н.ЛимитОстатка) + ")"));
		КонецЕсли;

		// график (самоинкассацию по дням недели не проверяем)
		Если Г = Неопределено Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "кассы нет в графике"));
		ИначеЕсли Г.Закрыт Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "магазин помечен закрытым"));
		ИначеЕсли Не Г.СИнк Тогда
			Если Не Г.Задан Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "дни графика не заданы"));
			ИначеЕсли Не Г.Дни[ДеньНедели(П.Дата) - 1] Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "сдача не в день графика"));
			КонецЕсли;
		КонецЕсли;

		Итог.Добавить(НоваяСтрока(П.Касса, П.Дата, П.Регистратор, П.Ключ, П.Сумма,
			СтрСоединить(ДатыПост, ", "), ?(Пары.Количество() = 0, Неопределено, СуммаПост), Остаток, Проблемы, СИнк));
	КонецЦикла;

	// ---- поступления без РКО
	Для Каждого Р Из Расходы Цикл
		Если Не Р.Использован И Р.Дата >= НачП И Р.Дата <= КонП Тогда
			Проблемы = Новый Массив;
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Поступление без РКО",
				"в банк пришли деньги, РКО на сдачу не найден"));
			Итог.Добавить(НоваяСтрока(Р.Касса, Неопределено, Неопределено, Р.Ключ, Неопределено,
				Формат(Р.Дата, "ДФ=dd.MM"), Р.Сумма, Неопределено, Проблемы, Ложь));
		КонецЕсли;
	КонецЦикла;

	// ---- пропущенные дни графика
	Для Каждого КЗ Из График Цикл
		Касса = КЗ.Ключ;
		Если КЗ.Значение.Закрыт Или КЗ.Значение.СИнк Или Не КЗ.Значение.Задан Тогда
			Продолжить;
		КонецЕсли;
		День = НачалоДня(ЭтаФорма.ДатаНач);
		Пока День <= ЭтаФорма.ДатаКон И День < Сегодня Цикл
			Если КЗ.Значение.Дни[ДеньНедели(День) - 1] Тогда
				Сдавал = Ложь;
				Для Каждого П Из Приходы Цикл
					Если П.Касса = Касса И П.Дата >= День И П.Дата - День <= Н.ДопускПропуска * Сутки Тогда
						Сдавал = Истина; Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не Сдавал И Сегодня - День > Н.ДопускПропуска * Сутки Тогда
					Проблемы = Новый Массив;
					Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Пропуск дня графика",
						"РКО в день инкассации по графику не сделан"));
					Итог.Добавить(НоваяСтрока(Касса, День, Неопределено, "", Неопределено, "", Неопределено, Неопределено, Проблемы, Ложь));
				КонецЕсли;
			КонецЕсли;
			День = День + Сутки;
		КонецЦикла;
	КонецЦикла;

	// ---- превышение лимита накопления наличных в кассе (остаток на конец дня)
	ЛимитН = ЭтаФорма.ЛимитНакоплений;
	Если ЛимитН > 0 Тогда
		КонОст = ?(КонП > КонецДня(ТекущаяДата()), КонецДня(ТекущаяДата()), КонП);
		Суточные = ПрочитатьСуточныеОстатки(НачП, КонОст, Н);
		Для Каждого КЗ Из Суточные Цикл
			Г = График[КЗ.Ключ];
			Если Г <> Неопределено И Г.Закрыт Тогда
				Продолжить;
			КонецЕсли;
			Эпизод = Неопределено;
			Для Каждого Д Из КЗ.Значение Цикл
				Если Д.Конец > ЛимитН Тогда
					Если Эпизод = Неопределено Тогда
						Эпизод = Новый Структура("Начало, Конец, Дней, Макс, МаксДата", Д.Дата, Д.Дата, 0, 0, Д.Дата);
					КонецЕсли;
					Эпизод.Конец = Д.Дата;
					Эпизод.Дней = Эпизод.Дней + 1;
					Если Д.Конец > Эпизод.Макс Тогда
						Эпизод.Макс = Д.Конец;
						Эпизод.МаксДата = Д.Дата;
					КонецЕсли;
				ИначеЕсли Эпизод <> Неопределено Тогда
					ДобавитьЭпизодЛимита(Итог, КЗ.Ключ, Эпизод, ЛимитН);
					Эпизод = Неопределено;
				КонецЕсли;
			КонецЦикла;
			Если Эпизод <> Неопределено Тогда
				ДобавитьЭпизодЛимита(Итог, КЗ.Ключ, Эпизод, ЛимитН);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ВывестиОтчет(Итог);
КонецПроцедуры

// Собирает строку отчёта; цвет и статус берутся по самой серьёзной проблеме.
&НаСервере
Функция НоваяСтрока(Касса, ДатаРКО, РКО, Ключ, СуммаРКО, ДатыПост, СуммаПост, Остаток, Проблемы, СИнк)
	Цвет = "Зелёный";
	Статус = "ОК";
	Тексты = Новый Массив;
	ГрафикТекст = "";
	Для Каждого П Из Проблемы Цикл
		Если Ранг(П.Цвет) < Ранг(Цвет) Тогда
			Цвет = П.Цвет;
			Статус = П.Имя;
		КонецЕсли;
		Если П.Цвет = "Жёлтый" Тогда
			ГрафикТекст = П.Текст;
		Иначе
			Тексты.Добавить(П.Текст);
		КонецЕсли;
	КонецЦикла;
	Если Тексты.Количество() = 0 И ГрафикТекст <> "" Тогда
		Тексты.Добавить(ГрафикТекст);
		ГрафикТекст = "";
	КонецЕсли;
	Разница = ?(СуммаПост <> Неопределено И СуммаРКО <> Неопределено, СуммаПост - СуммаРКО, Неопределено);
	Возврат Новый Структура("Касса, ДатаРКО, РКО, Ключ, СуммаРКО, ДатыПост, СуммаПост, Разница, Остаток, Статус, Цвет, Прим, СИнк, График",
		Касса, ДатаРКО, РКО, Ключ, СуммаРКО, ДатыПост, СуммаПост, Разница, Остаток, Статус, Цвет, СтрСоединить(Тексты, Символы.ПС), СИнк, ГрафикТекст);
КонецФункции

// Порядок и пояснения видов ошибок (красные строки группируются по этому порядку).
&НаСервере
Функция ВидыОшибок()
	В = Новый Массив;
	В.Добавить(Новый Структура("Имя, Пояснение", "Нет поступления", "РКО на инкассацию есть, деньги в банк не пришли в срок"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Расхождение суммы", "сумма зачисления в банк не равна сумме РКО"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Позже срока", "деньги пришли в банк позже допустимого срока"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Превышение лимита накоплений", "наличных в кассе накопилось больше лимита накопления"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Остаток кассы", "после инкассации в кассе осталось больше допустимого"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Поступление без РКО", "в банк пришли деньги, а РКО на сдачу не найден"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Пропуск дня графика", "в день инкассации по графику РКО не сделан"));
	Возврат В;
КонецФункции

&НаСервере
Процедура ОбвестиСтроку(Док, Н, Колонок)
	Лин = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Для к = 1 По Колонок Цикл
		Область = Док.Область(Н, к);
		Область.Обвести(Лин, Лин, Лин, Лин);
		Попытка
			Область.ЦветГраницы = Новый Цвет(120, 120, 120);
		Исключение
		КонецПопытки;
		Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВывестиЗаголовкиКолонок(Док, Н, Заголовки)
	Для к = 0 По Заголовки.ВГраница() Цикл
		Док.Область(Н, к + 1).Текст = Заголовки[к];
		Док.Область(Н, к + 1).Шрифт = Новый Шрифт(Док.Область(Н, к + 1).Шрифт, , , Истина);
		Док.Область(Н, к + 1).ЦветФона = Новый Цвет(217, 217, 217);
		Док.Область(Н, к + 1).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	КонецЦикла;
	ОбвестиСтроку(Док, Н, Заголовки.Количество());
КонецПроцедуры

&НаСервере
Процедура ВывестиОтчет(Итог)

	Док = ЭтаФорма.Результат;
	Док.Очистить();

	Виды = ВидыОшибок();
	ВидИндекс = Новый Соответствие;
	Для к = 0 По Виды.ВГраница() Цикл
		ВидИндекс.Вставить(Виды[к].Имя, к);
	КонецЦикла;

	// сортировка: серьёзность, вид ошибки, касса, дата
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Ранг");
	Т.Колонки.Добавить("Вид");
	Т.Колонки.Добавить("КассаПредст");
	Т.Колонки.Добавить("Дата");
	Т.Колонки.Добавить("Данные");
	Счет = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого С Из Итог Цикл
		Счет.Вставить(С.Цвет, ?(Счет[С.Цвет] = Неопределено, 0, Счет[С.Цвет]) + 1);
		Если С.Цвет = "Красный" Тогда
			ПоВидам.Вставить(С.Статус, ?(ПоВидам[С.Статус] = Неопределено, 0, ПоВидам[С.Статус]) + 1);
		КонецЕсли;
		Стр = Т.Добавить();
		Стр.Ранг = Ранг(С.Цвет);
		Индекс = ?(С.Цвет = "Красный", ВидИндекс[С.Статус], 0);
		Стр.Вид = ?(Индекс = Неопределено, 99, Индекс);
		Стр.КассаПредст = Строка(С.Касса);
		Стр.Дата = ?(С.ДатаРКО <> Неопределено, С.ДатаРКО, '00010101');
		Стр.Данные = С;
	КонецЦикла;
	Т.Сортировать("Ранг, Вид, КассаПредст, Дата");

	КолКрасных = ?(Счет["Красный"] = Неопределено, 0, Счет["Красный"]);
	КолЖелтых  = ?(Счет["Жёлтый"] = Неопределено, 0, Счет["Жёлтый"]);
	КолСерых   = ?(Счет["Серый"] = Неопределено, 0, Счет["Серый"]);
	КолЗелёных = ?(Счет["Зелёный"] = Неопределено, 0, Счет["Зелёный"]);

	ФонКрасный = Новый Цвет(255, 199, 206);
	ФонЖелтый  = Новый Цвет(255, 242, 204);
	ФонСерый   = Новый Цвет(237, 237, 237);
	ФонЗелёный = Новый Цвет(226, 239, 218);
	ТёмныйКрасный = Новый Цвет(156, 0, 6);
	Белый = Новый Цвет(255, 255, 255);

	Ширины = Новый Массив;
	Ширины.Добавить(38); Ширины.Добавить(11); Ширины.Добавить(13); Ширины.Добавить(15);
	Ширины.Добавить(16); Ширины.Добавить(15); Ширины.Добавить(13); Ширины.Добавить(14); Ширины.Добавить(62); Ширины.Добавить(22);

	Н = 1;
	Для к = 1 По 10 Цикл
		Док.Область(Н, к, Н, к).ШиринаКолонки = Ширины[к - 1];
	КонецЦикла;
	Док.Область(Н, 1).Текст = "Контроль инкассации за период " + Формат(ЭтаФорма.ДатаНач, "ДЛФ=D") + " - " + Формат(ЭтаФорма.ДатаКон, "ДЛФ=D");
	Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 14, Истина);
	Н = Н + 1;

	// --- сводка
	Док.Область(Н, 1, Н, 10).Объединить();
	Док.Область(Н, 1).Текст = "ОШИБКИ: " + КолКрасных + "     вне графика: " + КолЖелтых + "     в пути: " + КолСерых + "     без замечаний: " + КолЗелёных;
	Док.Область(Н, 1, Н, 10).ЦветФона = ?(КолКрасных > 0, ФонКрасный, ФонЗелёный);
	Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 11, Истина);
	Если КолКрасных > 0 Тогда
		Док.Область(Н, 1).ЦветТекста = ТёмныйКрасный;
	КонецЕсли;
	Н = Н + 1;
	Если КолКрасных > 0 Тогда
		Для Каждого В Из Виды Цикл
			Если ПоВидам[В.Имя] <> Неопределено Тогда
				Док.Область(Н, 1, Н, 10).Объединить();
				Док.Область(Н, 1).Текст = "   " + В.Имя + ": " + ПоВидам[В.Имя];
				Н = Н + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Н = Н + 1;

	Разделы = Новый Массив;
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 0, "ОШИБКИ - требуют внимания", Новый Цвет(192, 0, 0), ФонКрасный));
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 1, "Сдача вне графика", Новый Цвет(191, 143, 0), ФонЖелтый));
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 2, "В пути (срок зачисления не вышел)", Новый Цвет(128, 128, 128), ФонСерый));
	Если ЭтаФорма.ПоказыватьУспешные Тогда
		Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 3, "Без замечаний", Новый Цвет(84, 130, 53), ФонЗелёный));
	КонецЕсли;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Магазин (касса)"); Заголовки.Добавить("Дата"); Заголовки.Добавить("№ сумки");
	Заголовки.Добавить("Сумма РКО"); Заголовки.Добавить("Зачисление, даты"); Заголовки.Добавить("Сумма в банке");
	Заголовки.Добавить("Разница"); Заголовки.Добавить("Остаток кассы"); Заголовки.Добавить("Что не так"); Заголовки.Добавить("График");

	Для Каждого Раздел Из Разделы Цикл
		Строки = Т.НайтиСтроки(Новый Структура("Ранг", Раздел.Ранг));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// заголовок раздела
		Док.Область(Н, 1, Н, 10).Объединить();
		Док.Область(Н, 1).Текст = Раздел.Заголовок + "  (" + Строки.Количество() + ")";
		Док.Область(Н, 1, Н, 10).ЦветФона = Раздел.ФонЗаг;
		Док.Область(Н, 1).ЦветТекста = Белый;
		Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 12, Истина);
		Н = Н + 1;

		ТекущийВид = Неопределено;
		НомерВГруппе = 0;
		Для Каждого Стр Из Строки Цикл
			С = Стр.Данные;

			// новая группа: для ошибок - по виду, для остальных разделов - одна группа
			НоваяГруппа = ?(Раздел.Ранг = 0, ТекущийВид <> Стр.Вид, ТекущийВид = Неопределено);
			Если НоваяГруппа Тогда
				ТекущийВид = Стр.Вид;
				НомерВГруппе = 0;
				Если Раздел.Ранг = 0 Тогда
					Число = 0;
					Для Каждого Эл Из Строки Цикл
						Если Эл.Вид = Стр.Вид Тогда Число = Число + 1; КонецЕсли;
					КонецЦикла;
					Пояснение = "";
					Если Стр.Вид < Виды.Количество() Тогда
						Пояснение = " - " + Виды[Стр.Вид].Пояснение;
					КонецЕсли;
					Док.Область(Н, 1, Н, 10).Объединить();
					Док.Область(Н, 1).Текст = С.Статус + "  (" + Число + ")" + Пояснение;
					Док.Область(Н, 1, Н, 10).ЦветФона = Новый Цвет(248, 160, 170);
					Док.Область(Н, 1).ЦветТекста = ТёмныйКрасный;
					Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 11, Истина);
					Н = Н + 1;
				КонецЕсли;
				ВывестиЗаголовкиКолонок(Док, Н, Заголовки);
				Н = Н + 1;
			КонецЕсли;

			НомерВГруппе = НомерВГруппе + 1;
			ФонСтроки = ?(НомерВГруппе % 2 = 1, Белый, Новый Цвет(242, 242, 242));
			Док.Область(Н, 1).Текст = Стр.КассаПредст + ?(С.СИнк, "  [с/инк]", "");
			Док.Область(Н, 2).Текст = ?(С.ДатаРКО = Неопределено, "", Формат(С.ДатаРКО, "ДФ=dd.MM.yyyy"));
			Док.Область(Н, 3).Текст = С.Ключ;
			Док.Область(Н, 4).Текст = Деньги(С.СуммаРКО);
			Док.Область(Н, 5).Текст = С.ДатыПост;
			Док.Область(Н, 6).Текст = Деньги(С.СуммаПост);
			Док.Область(Н, 7).Текст = ?(С.Разница = Неопределено Или С.Разница = 0, "", Деньги(С.Разница));
			Док.Область(Н, 8).Текст = Деньги(С.Остаток);
			Док.Область(Н, 9).Текст = С.Прим;
			Док.Область(Н, 10).Текст = С.График;
			Для к = 4 По 8 Цикл
				Док.Область(Н, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			КонецЦикла;
			Док.Область(Н, 9).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Док.Область(Н, 10).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Док.Область(Н, 1, Н, 10).ЦветФона = ФонСтроки;
			Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , , Истина);
			// цветом выделена только ячейка с причиной
			Док.Область(Н, 9).ЦветФона = Раздел.ФонСтр;
			Если Раздел.Ранг = 0 Тогда
				Док.Область(Н, 9).ЦветТекста = ТёмныйКрасный;
			КонецЕсли;
			Если С.График <> "" Тогда
				Док.Область(Н, 10).ЦветФона = ФонЖелтый;
			КонецЕсли;
			ОбвестиСтроку(Док, Н, 10);
			Н = Н + 1;
		КонецЦикла;
		Н = Н + 1;
	КонецЦикла;

	Если Итог.Количество() = 0 Тогда
		Док.Область(Н, 1).Текст = "За период инкассаций не найдено";
	КонецЕсли;
КонецПроцедуры

// ---------------------------------------------------------------------------
// Лимит накопления и расчёт инкассации
// ---------------------------------------------------------------------------

&НаСервере
Функция ГрафикПоКассам()
	График = Новый Соответствие;
	Для Каждого С Из ЭтаФорма.Графики Цикл
		Если ЗначениеЗаполнено(С.Касса) Тогда
			М = Новый Массив;
			М.Добавить(С.Пн); М.Добавить(С.Вт); М.Добавить(С.Ср); М.Добавить(С.Чт);
			М.Добавить(С.Пт); М.Добавить(С.Сб); М.Добавить(С.Вс);
			График.Вставить(С.Касса, Новый Структура("Дни, СИнк, Закрыт, Задан",
				М, С.СИнк, С.Закрыт, М.Найти(Истина) <> Неопределено));
		КонецЕсли;
	КонецЦикла;
	Возврат График;
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиРасчёта()
	Н = Настройки();
	Лим = ХранилищеОбщихНастроек.Загрузить(Н.ХранилищеОбъект, "ЛимитНакоплений");
	ЭтаФорма.ЛимитНакоплений = ?(ТипЗнч(Лим) = Тип("Число"), Лим, Н.ЛимитНакопленийПоУмолчанию);
	ЭтаФорма.Сценарии.Очистить();
	Данные = ХранилищеОбщихНастроек.Загрузить(Н.ХранилищеОбъект, "Сценарии");
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Данные = Новый Массив;
		Для Каждого Л Из СтрРазделить("100000,150000,200000,250000,300000", ",") Цикл
			Данные.Добавить(Число(Л));
		КонецЦикла;
	КонецЕсли;
	Для Каждого Л Из Данные Цикл
		ЭтаФорма.Сценарии.Добавить().Лимит = Л;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиРасчёта()
	Н = Настройки();
	ХранилищеОбщихНастроек.Сохранить(Н.ХранилищеОбъект, "ЛимитНакоплений", ЭтаФорма.ЛимитНакоплений);
	Данные = Новый Массив;
	Для Каждого Стр Из ЭтаФорма.Сценарии Цикл
		Данные.Добавить(Стр.Лимит);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(Н.ХранилищеОбъект, "Сценарии", Данные);
КонецПроцедуры

// Описание регистра "Денежные средства (наличные)": имя регистра, измерения-кассы и ресурса "Сумма".
&НаСервере
Функция ОписаниеРегистраНаличных(Н)
	РегМД = Неопределено;
	Для Каждого Р Из Метаданные.РегистрыНакопления Цикл
		Если НРег(СокрЛП(Р.Синоним)) = "денежные средства (наличные)" Тогда
			РегМД = Р; Прервать;
		КонецЕсли;
	КонецЦикла;
	Если РегМД = Неопределено Тогда
		РегМД = Метаданные.РегистрыНакопления.Найти(Н.РегНаличные);
	КонецЕсли;
	Если РегМД = Неопределено Тогда
		Сообщить("Регистр 'Денежные средства (наличные)' не найден (укажите имя в Настройки: РегНаличные)");
		Возврат Неопределено;
	КонецЕсли;

	ИмяИзм = "";
	Если РегМД.Измерения.Найти("Касса") <> Неопределено Тогда
		ИмяИзм = "Касса";
	Иначе
		Для Каждого Изм Из РегМД.Измерения Цикл
			Если НРег(Изм.Синоним) = "касса" Тогда
				ИмяИзм = Изм.Имя; Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ИмяИзм = "" Тогда
		Сообщить("В регистре " + РегМД.Имя + " не найдено измерение 'Касса'");
		Возврат Неопределено;
	КонецЕсли;
	Рес = РегМД.Ресурсы.Найти("Сумма");
	Если Рес = Неопределено Тогда
		Рес = РегМД.Ресурсы[0];
	КонецЕсли;
	Возврат Новый Структура("Рег, Изм, Рес", РегМД.Имя, ИмяИзм, Рес.Имя);
КонецФункции

// Суточные остатки и обороты наличных по кассам.
// Возвращает Соответствие "касса -> массив структур (Дата, Конец, Приход, Расход)" на каждый день Нач..Кон
// (дни без движений заполняются предыдущим остатком). Кассы без движений за период в результат не попадают.
&НаСервере
Функция ПрочитатьСуточныеОстатки(Нач, Кон, Н)
	Результат0 = Новый Соответствие;
	Попытка
		Опис = ОписаниеРегистраНаличных(Н);
		Если Опис = Неопределено Тогда
			Возврат Результат0;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Период КАК ДеньПериода,
		|	Т.[Изм] КАК Касса,
		|	Т.[Ресурс]НачальныйОстаток КАК Начало,
		|	Т.[Ресурс]Приход КАК Приход,
		|	Т.[Ресурс]Расход КАК Расход,
		|	Т.[Ресурс]КонечныйОстаток КАК Конец
		|ИЗ
		|	РегистрНакопления.[Рег].ОстаткиИОбороты(&Нач, &Кон, День, Движения) КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Касса,
		|	ДеньПериода";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Рег]", Опис.Рег);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Ресурс]", Опис.Рес);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Изм]", Опис.Изм);
		Запрос.УстановитьПараметр("Нач", НачалоДня(Нач));
		Запрос.УстановитьПараметр("Кон", Кон);

		ПоКассам = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Данные = ПоКассам[Выборка.Касса];
			Если Данные = Неопределено Тогда
				Данные = Новый Структура("Дни, Начало", Новый Соответствие, Выборка.Начало);
				ПоКассам.Вставить(Выборка.Касса, Данные);
			КонецЕсли;
			Данные.Дни.Вставить(НачалоДня(Выборка.ДеньПериода),
				Новый Структура("Конец, Приход, Расход", Выборка.Конец, Выборка.Приход, Выборка.Расход));
		КонецЦикла;

		Для Каждого КЗ Из ПоКассам Цикл
			Дни = Новый Массив;
			Остаток = КЗ.Значение.Начало;
			День = НачалоДня(Нач);
			Пока День <= Кон Цикл
				Д = КЗ.Значение.Дни[День];
				Если Д <> Неопределено Тогда
					Остаток = Д.Конец;
					Дни.Добавить(Новый Структура("Дата, Конец, Приход, Расход", День, Д.Конец, Д.Приход, Д.Расход));
				Иначе
					Дни.Добавить(Новый Структура("Дата, Конец, Приход, Расход", День, Остаток, 0, 0));
				КонецЕсли;
				День = День + 86400;
			КонецЦикла;
			Результат0.Вставить(КЗ.Ключ, Дни);
		КонецЦикла;
	Исключение
		Сообщить("Суточные остатки кассы не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат0;
КонецФункции

&НаСервере
Процедура ДобавитьЭпизодЛимита(Итог, Касса, Э, Лимит)
	Проблемы = Новый Массив;
	Период = ?(Э.Начало = Э.Конец, Формат(Э.Начало, "ДФ=dd.MM"),
		"с " + Формат(Э.Начало, "ДФ=dd.MM") + " по " + Формат(Э.Конец, "ДФ=dd.MM"));
	Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Превышение лимита накоплений",
		"остаток кассы выше лимита " + Деньги(Лимит) + ": " + Период + " (" + Э.Дней + " дн.), максимум "
		+ Деньги(Э.Макс) + " на " + Формат(Э.МаксДата, "ДФ=dd.MM")));
	Итог.Добавить(НоваяСтрока(Касса, Э.Начало, Неопределено, "", Неопределено, "", Неопределено, Э.Макс, Проблемы, Ложь));
КонецПроцедуры

// Симуляция: в день инкассации по графику инкассатор выезжает, только если в кассе накоплено не меньше лимита.
// Поступление наличных берётся из факта: приход - расход + фактически сданное в инкассацию.
&НаСервере
Функция СимулироватьВыезды(Лимит, Магазины, Суточные, Сданное, График)
	Выездов = 0;
	Сумма = 0;
	Для Каждого К Из Магазины Цикл
		Дни = Суточные[К];
		Г = График[К];
		ПоДням = Сданное[К];
		Первый = Дни[0];
		Б = Первый.Конец - Первый.Приход + Первый.Расход; // остаток на начало периода
		Для Каждого Д Из Дни Цикл
			Поток = Д.Приход - Д.Расход;
			Если ПоДням <> Неопределено И ПоДням[Д.Дата] <> Неопределено Тогда
				Поток = Поток + ПоДням[Д.Дата];
			КонецЕсли;
			Б = Б + Поток;
			Если Г.Дни[ДеньНедели(Д.Дата) - 1] И Б > 0 И Б >= Лимит Тогда
				Выездов = Выездов + 1;
				Сумма = Сумма + Б;
				Б = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Выездов, Сумма", Выездов, Сумма);
КонецФункции

&НаСервере
Процедура РассчитатьНаСервере()

	Н = Настройки();
	СохранитьНастройкиРасчёта();
	НачП = НачалоДня(ЭтаФорма.ДатаНач);
	КонДня = КонецДня(ТекущаяДата());
	КонРасч = ?(КонецДня(ЭтаФорма.ДатаКон) > КонДня, КонДня, КонецДня(ЭтаФорма.ДатаКон)); // будущее не считаем
	График = ГрафикПоКассам();

	// фактические выезды РСХ (РКО "Инкассация в банк" на счёт РСХ) по кассам с заданным графиком, без самоинкассации
	Подстроки = СтрРазделить(Н.БанкиРСХ, ",", Ложь);
	Движения = ПрочитатьДвижения(НачП, КонРасч, Н);
	Факт = Новый Соответствие;
	Сданное = Новый Соответствие;
	БезГрафика = Новый Соответствие;
	СамоИнк = Новый Соответствие;
	Для Каждого Д Из Движения Цикл
		Если Не Д.Приход Тогда
			Продолжить;
		КонецЕсли;
		Рсх = (Подстроки.Количество() = 0);
		Для Каждого Подстр Из Подстроки Цикл
			Если СтрНайти(Д.Получатель, НРег(СокрЛП(Подстр))) > 0 Тогда
				Рсх = Истина; Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Рсх Тогда
			Продолжить;
		КонецЕсли;
		К = Д.Касса;
		Г = График[К];
		Если Г <> Неопределено И Г.Закрыт Тогда
			Продолжить;
		КонецЕсли;
		Если Г <> Неопределено И Г.СИнк Тогда
			СамоИнк.Вставить(К, Истина);
			Продолжить;
		КонецЕсли;
		Если Г = Неопределено Или Не Г.Задан Тогда
			БезГрафика.Вставить(К, Истина);
			Продолжить;
		КонецЕсли;
		ПоДням = Сданное[К];
		Если ПоДням = Неопределено Тогда
			ПоДням = Новый Соответствие;
			Сданное.Вставить(К, ПоДням);
		КонецЕсли;
		Если ПоДням[Д.Дата] = Неопределено Тогда
			ПоДням.Вставить(Д.Дата, 0);
			Ф = Факт[К];
			Если Ф = Неопределено Тогда
				Ф = Новый Структура("Выездов, Сумма", 0, 0);
				Факт.Вставить(К, Ф);
			КонецЕсли;
			Ф.Выездов = Ф.Выездов + 1; // один выезд = один день сдачи по кассе
		КонецЕсли;
		ПоДням.Вставить(Д.Дата, ПоДням[Д.Дата] + Д.Сумма);
		Ф = Факт[К];
		Ф.Сумма = Ф.Сумма + Д.Сумма;
	КонецЦикла;

	Суточные = ПрочитатьСуточныеОстатки(НачП, КонРасч, Н);
	Магазины = Новый Массив;
	Для Каждого КЗ Из Факт Цикл
		Если Суточные[КЗ.Ключ] <> Неопределено Тогда
			Магазины.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Магазины.Количество() = 0 Тогда
		ЭтаФорма.РезультатРасчёта.Очистить();
		ЭтаФорма.РезультатРасчёта.Область(1, 1).Текст = "Нет данных для расчёта: задайте графики инкассации (вкладка 'Графики инкассации') "
			+ "для магазинов с инкассацией РСХ или проверьте период.";
		Возврат;
	КонецЕсли;

	// строка 1 - текущая ситуация (факт), далее сценарии
	ФактВыездов = 0;
	ФактСумма = 0;
	Для Каждого К Из Магазины Цикл
		ФактВыездов = ФактВыездов + Факт[К].Выездов;
		ФактСумма = ФактСумма + Факт[К].Сумма;
	КонецЦикла;
	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Название, Лимит, Выездов, Сумма", "Текущая ситуация (факт)", Неопределено, ФактВыездов, ФактСумма));

	Лимиты = Новый Массив;
	Для Каждого Стр Из ЭтаФорма.Сценарии Цикл
		Если Лимиты.Найти(Стр.Лимит) = Неопределено Тогда
			Лимиты.Добавить(Стр.Лимит);
		КонецЕсли;
	КонецЦикла;
	ТЛ = Новый ТаблицаЗначений;
	ТЛ.Колонки.Добавить("Лимит");
	Для Каждого Л Из Лимиты Цикл
		ТЛ.Добавить().Лимит = Л;
	КонецЦикла;
	ТЛ.Сортировать("Лимит");
	Для Каждого Стр Из ТЛ Цикл
		Рез = СимулироватьВыезды(Стр.Лимит, Магазины, Суточные, Сданное, График);
		Строки.Добавить(Новый Структура("Название, Лимит, Выездов, Сумма",
			"Лимит на выезд " + Деньги(Стр.Лимит), Стр.Лимит, Рез.Выездов, Рез.Сумма));
	КонецЦикла;

	ВывестиРасчёт(Строки, Магазины.Количество(), БезГрафика.Количество(), СамоИнк.Количество(), НачП, КонРасч);
КонецПроцедуры

&НаСервере
Функция СоЗнаком(Значение, Фмт)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(Значение > 0, "+", "") + Формат(Значение, Фмт);
КонецФункции

&НаСервере
Процедура ВывестиРасчёт(Строки, Магазинов, БезГрафика, СамоИнк, НачП, КонРасч)

	Док = ЭтаФорма.РезультатРасчёта;
	Док.Очистить();

	Белый = Новый Цвет(255, 255, 255);
	ФонФакт = Новый Цвет(221, 235, 247);
	ФонЗелёный = Новый Цвет(198, 239, 206);
	ФонКрасный = Новый Цвет(255, 199, 206);
	Серый = Новый Цвет(242, 242, 242);

	Ширины = Новый Массив;
	Ширины.Добавить(36); Ширины.Добавить(18); Ширины.Добавить(12); Ширины.Добавить(20);
	Ширины.Добавить(20); Ширины.Добавить(16); Ширины.Добавить(14); Ширины.Добавить(20);

	Н = 1;
	Для к = 1 По 8 Цикл
		Док.Область(Н, к, Н, к).ШиринаКолонки = Ширины[к - 1];
	КонецЦикла;
	Док.Область(Н, 1).Текст = "Сравнение лимитов на выезд (инкассация РСХ, без самоинкассации)";
	Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 14, Истина);
	Н = Н + 1;
	Док.Область(Н, 1).Текст = "Период " + Формат(НачП, "ДЛФ=D") + " - " + Формат(КонРасч, "ДЛФ=D")
		+ ".  Магазинов в расчёте: " + Магазинов
		+ ?(БезГрафика > 0, ";  без заданного графика (не вошли): " + БезГрафика, "")
		+ ?(СамоИнк > 0, ";  самоинкассация (не вошли): " + СамоИнк, "");
	Н = Н + 1;
	Док.Область(Н, 1).Текст = "Модель: в день инкассации по графику инкассатор выезжает, только если в кассе накоплено не меньше лимита. "
		+ "Разница считается от текущей ситуации (первая строка): минус - выездов меньше, чем сейчас.";
	Н = Н + 2;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Вариант"); Заголовки.Добавить("Лимит на выезд"); Заголовки.Добавить("Выездов");
	Заголовки.Добавить("Сумма инкассации"); Заголовки.Добавить("Средняя сумма выезда");
	Заголовки.Добавить("Разница выездов"); Заголовки.Добавить("Разница, %"); Заголовки.Добавить("Разница средней суммы");
	ВывестиЗаголовкиКолонок(Док, Н, Заголовки);
	Н = Н + 1;

	Эталон = Строки[0];
	ЭталонСредняя = ?(Эталон.Выездов = 0, 0, Эталон.Сумма / Эталон.Выездов);

	Для Индекс = 0 По Строки.ВГраница() Цикл
		С = Строки[Индекс];
		Средняя = ?(С.Выездов = 0, 0, С.Сумма / С.Выездов);
		ДВ = С.Выездов - Эталон.Выездов;
		ДП = ?(Эталон.Выездов = 0, Неопределено, ДВ / Эталон.Выездов * 100);
		ДС = Средняя - ЭталонСредняя;

		Док.Область(Н, 1).Текст = С.Название;
		Док.Область(Н, 2).Текст = ?(С.Лимит = Неопределено, "-", Деньги(С.Лимит));
		Док.Область(Н, 3).Текст = Формат(С.Выездов, "ЧГ=0; ЧН=0");
		Док.Область(Н, 4).Текст = Деньги(С.Сумма);
		Док.Область(Н, 5).Текст = Деньги(Средняя);
		Док.Область(Н, 6).Текст = СоЗнаком(ДВ, "ЧГ=0; ЧН=0");
		Док.Область(Н, 7).Текст = СоЗнаком(ДП, "ЧДЦ=1; ЧН=0,0") + ?(ДП = Неопределено, "", " %");
		Док.Область(Н, 8).Текст = СоЗнаком(ДС, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
		Для к = 2 По 8 Цикл
			Док.Область(Н, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		КонецЦикла;
		Если Индекс = 0 Тогда
			Док.Область(Н, 1, Н, 8).ЦветФона = ФонФакт;
			Для к = 1 По 8 Цикл
				Док.Область(Н, к).Шрифт = Новый Шрифт(Док.Область(Н, к).Шрифт, , , Истина);
			КонецЦикла;
		Иначе
			Док.Область(Н, 1, Н, 8).ЦветФона = ?(Индекс % 2 = 1, Белый, Серый);
			Если ДВ < 0 Тогда
				Док.Область(Н, 6, Н, 7).ЦветФона = ФонЗелёный;
			ИначеЕсли ДВ > 0 Тогда
				Док.Область(Н, 6, Н, 7).ЦветФона = ФонКрасный;
			КонецЕсли;
		КонецЕсли;
		ОбвестиСтроку(Док, Н, 8);
		Н = Н + 1;
	КонецЦикла;
