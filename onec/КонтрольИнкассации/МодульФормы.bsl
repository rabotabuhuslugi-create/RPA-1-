// Внешняя обработка "Контроль инкассации" (1С:Комплексная автоматизация, управляемая форма).
// Весь модуль вставляется в модуль ПУСТОЙ управляемой формы обработки.
// Реквизиты и элементы формы создаются кодом в ПриСозданииНаСервере.

#Область Настройки

// Единственное место, где нужно править имена под вашу конфигурацию.
// Проверить имена: Конфигуратор -> дерево метаданных, либо <база>/odata/standard.odata/$metadata
&НаСервере
Функция Настройки()
	Н = Новый Структура;
	Н.Вставить("Регистр",           "ДенежныеСредстваВПути");  // регистр накопления "Денежные средства в пути"
	Н.Вставить("ДокРКО",            "РасходныйКассовыйОрдер");
	Н.Вставить("ДокПоступление",    "ПоступлениеБезналичныхДенежныхСредств");
	Н.Вставить("РеквНомерСумки",    "НомерСумки");             // реквизит РКО "Номер сумки"
	Н.Вставить("РеквНомерПоБанку",  "НомерПоБанку");           // реквизит поступления "Номер по банку"
	Н.Вставить("РеквНазначение",    "НазначениеПлатежа");      // реквизит поступления "Назначение платежа"
	Н.Вставить("ВидПеревода",       "Инкассация в банк");      // представление вида перевода (сравнивается как строка)
	Н.Вставить("ДопускДней",        3);                        // календарных дней на поступление
	Н.Вставить("ДопускДнейСинк",    1);                        // самоинкассация: зачисление не позже чем через N календарных дней
	Н.Вставить("ПроверятьОстаток",  Истина);                   // контроль остатка кассы после инкассации
	Н.Вставить("ЛимитОстатка",      40000);                    // остаток кассы после инкассации не должен превышать
	Н.Вставить("РегНаличные",       "ДенежныеСредстваНаличные"); // запасное имя регистра "Денежные средства (наличные)"
	Н.Вставить("ЛимитНакопленийПоУмолчанию", 300000);          // лимит накопления наличных в кассе по умолчанию
	Н.Вставить("ДопускПропуска",    1);                        // дней: РКО "в день графика" можно сделать в течение N дней
	Н.Вставить("ХранилищеОбъект",   "КонтрольИнкассации");
	Н.Вставить("ХранилищеКлюч",     "Графики");
	// --- расчёт количества инкассаций (вкладка «Расчёт инкассаций»)
	Н.Вставить("ДокПКО",            "ПриходныйКассовыйОрдер");  // нал берём по ПКО основной кассы магазина
	Н.Вставить("ОперацияПКО",       "ПоступлениеДенежныхСредствИзКассыККМ"); // выручка ККМ; "" - все ПКО кассы
	// Дополнительно учитываемые операции ПКО (имя или представление, через ;). В магазинах с двумя юрлицами
	// наличные Гермеса приходуются в основную кассу НВ ПКО «Поступление по кредитам» (займ).
	Н.Вставить("ОперацииПКОДоп",    "ПоступлениеПоКредитам;Поступление по кредитам;Получение кредита (займа);ПолучениеКредитаЗайма");
	Н.Вставить("СтавкаИнк",         610);                      // мин. комиссия РСХ за выезд до порога (поле на форме)
	// тарифы: инкассация РСХ (за выезд + пересчёт), самоинкассация Сбер
	Н.Вставить("ТарифПорог",        600000);                   // сумма одного выезда, руб.
	Н.Вставить("ТарифДоПроц",       0.15);                     // % от суммы сдачи до порога
	Н.Вставить("ТарифДоМин",        610);                      // мин. руб. до порога
	Н.Вставить("ТарифСвышеПроц",    0.1);                      // % от суммы сдачи свыше порога
	Н.Вставить("ТарифСвышеМин",     300);                      // мин. руб. свыше порога
	Н.Вставить("ТарифПересчетПроц", 0.2);                      // % за пересчёт и зачисление на р/с
	Н.Вставить("ТарифСИнкПроц",     0.4);                      // самоинкассация Сбер, % от зачисляемой суммы
	Н.Вставить("ЛимитИнк",          200000);                   // руб. наличных на один выезд (по умолчанию)
	Н.Вставить("ЛимитыСравнения",   "200000;250000;300000");   // варианты лимита для таблицы сравнения
	Н.Вставить("СИнкВРасходах",     Ложь);                     // самоинкассацию считать в выездах и расходах
	Н.Вставить("ХранилищеКлючСвод", "ПараметрыРасчета");
	// --- магазины, сдающие наличные в кассу ЦО: операция РКО (имя или представление, через ;)
	Н.Вставить("ОперацииЦО",        "ВыдачаДенежныхСредствВДругуюКассу;Выдача в другую кассу");
	// --- проверка кассовых книг (пусто - найти автоматически)
	Н.Вставить("ДокКК",             "");                       // имя документа кассовой книги
	Н.Вставить("РеквКассаКК",       "");                       // реквизит документа со ссылкой на кассу
	Н.Вставить("РеквДатаКК",        "");                       // реквизит с датой листа (по умолчанию - дата документа)
	Н.Вставить("СрокКК",            7);                        // нет листа N дней и дольше - ошибка
	Возврат Н;
КонецФункции

#КонецОбласти

#Область СозданиеФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Н = Настройки();
	ТипКассы = Метаданные.РегистрыНакопления[Н.Регистр].Измерения.Отправитель.Тип;

	Дни = Новый Массив;
	Дни.Добавить("Пн"); Дни.Добавить("Вт"); Дни.Добавить("Ср"); Дни.Добавить("Чт");
	Дни.Добавить("Пт"); Дни.Добавить("Сб"); Дни.Добавить("Вс");

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаНач",  Новый ОписаниеТипов("Дата")));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаКон",  Новый ОписаниеТипов("Дата")));
	Реквизиты.Добавить(Новый РеквизитФормы("Результат", Новый ОписаниеТипов("ТабличныйДокумент")));
	Реквизиты.Добавить(Новый РеквизитФормы("Графики",   Новый ОписаниеТипов("ТаблицаЗначений")));
	Реквизиты.Добавить(Новый РеквизитФормы("Касса", ТипКассы, "Графики", "Касса"));
	Реквизиты.Добавить(Новый РеквизитФормы("Магазин", Новый ОписаниеТипов("Строка"), "Графики", "Магазин"));
	Реквизиты.Добавить(Новый РеквизитФормы("СИнк", Новый ОписаниеТипов("Булево"), "Графики", "СИнк"));
	Реквизиты.Добавить(Новый РеквизитФормы("Закрыт", Новый ОписаниеТипов("Булево"), "Графики", "Закрыт"));
	Реквизиты.Добавить(Новый РеквизитФормы("ЦО", Новый ОписаниеТипов("Булево"), "Графики", "ЦО"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоказыватьУспешные", Новый ОписаниеТипов("Булево")));
	Реквизиты.Добавить(Новый РеквизитФормы("АдресИтога", Новый ОписаниеТипов("Строка")));
	Реквизиты.Добавить(Новый РеквизитФормы("СвернутыеБлоки", Новый ОписаниеТипов("Строка")));
	Реквизиты.Добавить(Новый РеквизитФормы("РезультатРасчета", Новый ОписаниеТипов("ТабличныйДокумент")));
	Реквизиты.Добавить(Новый РеквизитФормы("РезультатКК", Новый ОписаниеТипов("ТабличныйДокумент")));
	Реквизиты.Добавить(Новый РеквизитФормы("СтавкаИнк", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2))));
	Для Каждого ИмяТарифа Из СтрРазделить("ТарифПорог,ТарифДоПроц,ТарифСвышеПроц,ТарифСвышеМин,ТарифПересчетПроц,ТарифСИнкПроц", ",") Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(ИмяТарифа, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3))));
	КонецЦикла;
	Реквизиты.Добавить(Новый РеквизитФормы("ЛимитИнк", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2))));
	Реквизиты.Добавить(Новый РеквизитФормы("ЛимитНакоплений", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный))));
	Реквизиты.Добавить(Новый РеквизитФормы("ЛимитыСравнения", Новый ОписаниеТипов("Строка")));
	Для Каждого Д Из Дни Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Д, Новый ОписаниеТипов("Булево"), "Графики", Д));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);

	ЭтаФорма.ДатаКон = НачалоДня(ТекущаяДата());
	ЭтаФорма.ДатаНач = НачалоМесяца(ЭтаФорма.ДатаКон);

	// Элементы
	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"), ЭтаФорма);
	Страницы.Вид = ВидГруппыФормы.Страницы;
	СтрОтчет = Элементы.Добавить("СтраницаОтчет", Тип("ГруппаФормы"), Страницы);
	СтрОтчет.Вид = ВидГруппыФормы.Страница;
	СтрОтчет.Заголовок = "Отчёт";
	СтрГрафики = Элементы.Добавить("СтраницаГрафики", Тип("ГруппаФормы"), Страницы);
	СтрГрафики.Вид = ВидГруппыФормы.Страница;
	СтрГрафики.Заголовок = "Графики инкассации";
	СтрРасчет = Элементы.Добавить("СтраницаРасчет", Тип("ГруппаФормы"), Страницы);
	СтрРасчет.Вид = ВидГруппыФормы.Страница;
	СтрРасчет.Заголовок = "Расчёт инкассаций";

	// --- страница отчёта
	Панель = Элементы.Добавить("ПанельОтбора", Тип("ГруппаФормы"), СтрОтчет);
	Панель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Панель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Панель.Отображение = ОтображениеОбычнойГруппы.Нет;

	П1 = Элементы.Добавить("ДатаНач", Тип("ПолеФормы"), Панель);
	П1.Вид = ВидПоляФормы.ПолеВвода; П1.ПутьКДанным = "ДатаНач"; П1.Заголовок = "Период с";
	П2 = Элементы.Добавить("ДатаКон", Тип("ПолеФормы"), Панель);
	П2.Вид = ВидПоляФормы.ПолеВвода; П2.ПутьКДанным = "ДатаКон"; П2.Заголовок = "по";

	П3 = Элементы.Добавить("ПоказыватьУспешные", Тип("ПолеФормы"), Панель);
	П3.Вид = ВидПоляФормы.ПолеФлажка; П3.ПутьКДанным = "ПоказыватьУспешные"; П3.Заголовок = "Показывать успешные";

	П4 = Элементы.Добавить("ЛимитНакоплений", Тип("ПолеФормы"), Панель);
	П4.Вид = ВидПоляФормы.ПолеВвода; П4.ПутьКДанным = "ЛимитНакоплений"; П4.Заголовок = "Лимит накоплений";
	П4.Подсказка = "Остаток наличных в кассе на конец дня выше этой суммы - ошибка. 0 - проверка выключена.";

	Команда = Команды.Добавить("Сформировать");
	Команда.Действие = "Сформировать";
	Команда.Заголовок = "Сформировать";
	Кн = Элементы.Добавить("Сформировать", Тип("КнопкаФормы"), Панель);
	Кн.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Кн.ИмяКоманды = "Сформировать";

	Р = Элементы.Добавить("Результат", Тип("ПолеФормы"), СтрОтчет);
	Р.Вид = ВидПоляФормы.ПолеТабличногоДокумента; Р.ПутьКДанным = "Результат";
	Р.ТолькоПросмотр = Истина;
	Попытка
		Р.УстановитьДействие("ОбработкаРасшифровки", "РезультатОбработкаРасшифровки");
	Исключение
	КонецПопытки;

	// --- страница графиков
	ПанельГ = Элементы.Добавить("ПанельГрафиков", Тип("ГруппаФормы"), СтрГрафики);
	ПанельГ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПанельГ.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПанельГ.Отображение = ОтображениеОбычнойГруппы.Нет;

	К1 = Команды.Добавить("ЗаполнитьКассы");
	К1.Действие = "ЗаполнитьКассы"; К1.Заголовок = "Добавить кассы из движений";
	Б1 = Элементы.Добавить("ЗаполнитьКассы", Тип("КнопкаФормы"), ПанельГ);
	Б1.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Б1.ИмяКоманды = "ЗаполнитьКассы";

	К2 = Команды.Добавить("СохранитьГрафики");
	К2.Действие = "СохранитьГрафики"; К2.Заголовок = "Сохранить графики";
	Б2 = Элементы.Добавить("СохранитьГрафики", Тип("КнопкаФормы"), ПанельГ);
	Б2.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Б2.ИмяКоманды = "СохранитьГрафики";

	К3 = Команды.Добавить("ЗагрузитьГрафикИзФайла");
	К3.Действие = "ЗагрузитьГрафикИзФайла"; К3.Заголовок = "Загрузить график из файла...";
	Б3 = Элементы.Добавить("ЗагрузитьГрафикИзФайла", Тип("КнопкаФормы"), ПанельГ);
	Б3.Вид = ВидКнопкиФормы.ОбычнаяКнопка; Б3.ИмяКоманды = "ЗагрузитьГрафикИзФайла";

	Т = Элементы.Добавить("Графики", Тип("ТаблицаФормы"), СтрГрафики);
	Т.ПутьКДанным = "Графики";
	Т.Заголовок = "Дни инкассации по кассам (отметьте 1-2 дня недели)";
	Кс = Элементы.Добавить("ГрафикиКасса", Тип("ПолеФормы"), Т);
	Кс.Вид = ВидПоляФормы.ПолеВвода; Кс.ПутьКДанным = "Графики.Касса"; Кс.Заголовок = "Касса";
	Км = Элементы.Добавить("ГрафикиМагазин", Тип("ПолеФормы"), Т);
	Км.Вид = ВидПоляФормы.ПолеВвода; Км.ПутьКДанным = "Графики.Магазин"; Км.Заголовок = "Магазин (из списка)";
	Для Каждого Д Из Дни Цикл
		Э = Элементы.Добавить("Графики" + Д, Тип("ПолеФормы"), Т);
		Э.Вид = ВидПоляФормы.ПолеФлажка; Э.ПутьКДанным = "Графики." + Д; Э.Заголовок = Д;
	КонецЦикла;
	Эс = Элементы.Добавить("ГрафикиСИнк", Тип("ПолеФормы"), Т);
	Эс.Вид = ВидПоляФормы.ПолеФлажка; Эс.ПутьКДанным = "Графики.СИнк"; Эс.Заголовок = "С/инк";
	Эц = Элементы.Добавить("ГрафикиЦО", Тип("ПолеФормы"), Т);
	Эц.Вид = ВидПоляФормы.ПолеФлажка; Эц.ПутьКДанным = "Графики.ЦО"; Эц.Заголовок = "В кассу ЦО";
	Эц.Подсказка = "Магазин сдаёт наличные в кассу ЦО, а не инкассатору банка";
	Эз = Элементы.Добавить("ГрафикиЗакрыт", Тип("ПолеФормы"), Т);
	Эз.Вид = ВидПоляФормы.ПолеФлажка; Эз.ПутьКДанным = "Графики.Закрыт"; Эз.Заголовок = "Закрыт";

	// --- страница расчёта количества инкассаций
	ПанельР = Элементы.Добавить("ПанельРасчета", Тип("ГруппаФормы"), СтрРасчет);
	ПанельР.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПанельР.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПанельР.Отображение = ОтображениеОбычнойГруппы.Нет;
	Р1 = Элементы.Добавить("РасчетДатаНач", Тип("ПолеФормы"), ПанельР);
	Р1.Вид = ВидПоляФормы.ПолеВвода; Р1.ПутьКДанным = "ДатаНач"; Р1.Заголовок = "Период с";
	Р2 = Элементы.Добавить("РасчетДатаКон", Тип("ПолеФормы"), ПанельР);
	Р2.Вид = ВидПоляФормы.ПолеВвода; Р2.ПутьКДанным = "ДатаКон"; Р2.Заголовок = "по";
	Р4 = Элементы.Добавить("ЛимитИнк", Тип("ПолеФормы"), ПанельР);
	Р4.Вид = ВидПоляФормы.ПолеВвода; Р4.ПутьКДанным = "ЛимитИнк"; Р4.Заголовок = "Лимит на выезд";
	Р5 = Элементы.Добавить("ЛимитыСравнения", Тип("ПолеФормы"), ПанельР);
	Р5.Вид = ВидПоляФормы.ПолеВвода; Р5.ПутьКДанным = "ЛимитыСравнения"; Р5.Заголовок = "Сравнить лимиты";
	Р5.Подсказка = "Через точку с запятой, например 200000;250000;300000";
	КР = Команды.Добавить("Рассчитать");
	КР.Действие = "Рассчитать"; КР.Заголовок = "Рассчитать";
	БР = Элементы.Добавить("Рассчитать", Тип("КнопкаФормы"), ПанельР);
	БР.Вид = ВидКнопкиФормы.ОбычнаяКнопка; БР.ИмяКоманды = "Рассчитать";
	// --- тарифы банков (можно менять, запоминаются)
	ГрТ = Элементы.Добавить("ГруппаТарифы", Тип("ГруппаФормы"), СтрРасчет);
	ГрТ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГрТ.Заголовок = "Тарифы банков";
	ГрТ.ОтображатьЗаголовок = Истина;
	ГрТ.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	ГрТ.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГрРСХ = Элементы.Добавить("ГруппаТарифыРСХ", Тип("ГруппаФормы"), ГрТ);
	ГрРСХ.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГрРСХ.Заголовок = "Инкассация РСХ (за выезд):";
	ГрРСХ.ОтображатьЗаголовок = Истина;
	ГрРСХ.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГрРСХ.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПоляТарифов = Новый Массив;
	ПоляТарифов.Добавить(Новый Структура("Имя, Заголовок", "ТарифПорог", "Порог суммы выезда, ₽"));
	ПоляТарифов.Добавить(Новый Структура("Имя, Заголовок", "ТарифДоПроц", "до порога, %"));
	ПоляТарифов.Добавить(Новый Структура("Имя, Заголовок", "СтавкаИнк", "мин., ₽"));
	ПоляТарифов.Добавить(Новый Структура("Имя, Заголовок", "ТарифСвышеПроц", "свыше порога, %"));
	ПоляТарифов.Добавить(Новый Структура("Имя, Заголовок", "ТарифСвышеМин", "мин., ₽"));
	ПоляТарифов.Добавить(Новый Структура("Имя, Заголовок", "ТарифПересчетПроц", "пересчёт и зачисление, %"));
	Для Каждого ПТ Из ПоляТарифов Цикл
		ЭТ = Элементы.Добавить(ПТ.Имя, Тип("ПолеФормы"), ГрРСХ);
		ЭТ.Вид = ВидПоляФормы.ПолеВвода;
		ЭТ.ПутьКДанным = ПТ.Имя;
		ЭТ.Заголовок = ПТ.Заголовок;
		ЭТ.Ширина = ?(ПТ.Имя = "ТарифПорог", 10, 7);
		ЭТ.РастягиватьПоГоризонтали = Ложь;
	КонецЦикла;
	ГрСбер = Элементы.Добавить("ГруппаТарифыСбер", Тип("ГруппаФормы"), ГрТ);
	ГрСбер.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГрСбер.Заголовок = "Самоинкассация Сбер:";
	ГрСбер.ОтображатьЗаголовок = Истина;
	ГрСбер.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГрСбер.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ЭС = Элементы.Добавить("ТарифСИнкПроц", Тип("ПолеФормы"), ГрСбер);
	ЭС.Вид = ВидПоляФормы.ПолеВвода; ЭС.ПутьКДанным = "ТарифСИнкПроц"; ЭС.Заголовок = "от зачисляемой суммы, %";
	ЭС.Ширина = 7; ЭС.РастягиватьПоГоризонтали = Ложь;
	КТ = Команды.Добавить("ТарифыПоУмолчанию");
	КТ.Действие = "ТарифыПоУмолчанию"; КТ.Заголовок = "Тарифы по умолчанию";
	БТ = Элементы.Добавить("ТарифыПоУмолчанию", Тип("КнопкаФормы"), ГрСбер);
	БТ.Вид = ВидКнопкиФормы.ОбычнаяКнопка; БТ.ИмяКоманды = "ТарифыПоУмолчанию";

	РР = Элементы.Добавить("РезультатРасчета", Тип("ПолеФормы"), СтрРасчет);
	РР.Вид = ВидПоляФормы.ПолеТабличногоДокумента; РР.ПутьКДанным = "РезультатРасчета";
	РР.ТолькоПросмотр = Истина;

	// --- страница проверки кассовых книг
	СтрКК = Элементы.Добавить("СтраницаКК", Тип("ГруппаФормы"), Страницы);
	СтрКК.Вид = ВидГруппыФормы.Страница;
	СтрКК.Заголовок = "Кассовые книги";
	ПанельК = Элементы.Добавить("ПанельКК", Тип("ГруппаФормы"), СтрКК);
	ПанельК.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПанельК.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПанельК.Отображение = ОтображениеОбычнойГруппы.Нет;
	К1К = Элементы.Добавить("ККДатаНач", Тип("ПолеФормы"), ПанельК);
	К1К.Вид = ВидПоляФормы.ПолеВвода; К1К.ПутьКДанным = "ДатаНач"; К1К.Заголовок = "Период с";
	К2К = Элементы.Добавить("ККДатаКон", Тип("ПолеФормы"), ПанельК);
	К2К.Вид = ВидПоляФормы.ПолеВвода; К2К.ПутьКДанным = "ДатаКон"; К2К.Заголовок = "по";
	КК = Команды.Добавить("ПроверитьКассовыеКниги");
	КК.Действие = "ПроверитьКассовыеКниги"; КК.Заголовок = "Проверить";
	БК = Элементы.Добавить("ПроверитьКассовыеКниги", Тип("КнопкаФормы"), ПанельК);
	БК.Вид = ВидКнопкиФормы.ОбычнаяКнопка; БК.ИмяКоманды = "ПроверитьКассовыеКниги";
	РК = Элементы.Добавить("РезультатКК", Тип("ПолеФормы"), СтрКК);
	РК.Вид = ВидПоляФормы.ПолеТабличногоДокумента; РК.ПутьКДанным = "РезультатКК";
	РК.ТолькоПросмотр = Истина;

	// порядок вкладок: Отчёт, Кассовые книги, Расчёт инкассаций, Графики
	Элементы.Переместить(Элементы.СтраницаКК, Элементы.Страницы, Элементы.СтраницаГрафики);
	Элементы.Переместить(Элементы.СтраницаРасчет, Элементы.Страницы, Элементы.СтраницаГрафики);
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтчет;

	ЗагрузитьГрафики();
	ЗагрузитьПараметрыРасчета();
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Сформировать(Команда)
	Если ЭтаФорма.ДатаНач > ЭтаФорма.ДатаКон Тогда
		Сообщить("Начало периода позже конца");
		Возврат;
	КонецЕсли;
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьГрафики(Команда)
	СохранитьГрафикиНаСервере();
	Сообщить("Графики сохранены");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКассы(Команда)
	ЗаполнитьКассыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	Если ЭтаФорма.ДатаНач > ЭтаФорма.ДатаКон Тогда
		Сообщить("Начало периода позже конца");
		Возврат;
	КонецЕсли;
	Если ЭтаФорма.ЛимитИнк <= 0 Тогда
		Сообщить("Укажите лимит на один выезд инкассации");
		Возврат;
	КонецЕсли;
	РассчитатьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область Графики

&НаСервере
Процедура ЗагрузитьГрафики()
	Н = Настройки();
	ЭтаФорма.Графики.Очистить();
	Данные = ХранилищеОбщихНастроек.Загрузить(Н.ХранилищеОбъект, Н.ХранилищеКлюч);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого С Из Данные Цикл
		Строка = ЭтаФорма.Графики.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, С);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьГрафикиНаСервере()
	Н = Настройки();
	Данные = Новый Массив;
	Для Каждого Строка Из ЭтаФорма.Графики Цикл
		Если Не ЗначениеЗаполнено(Строка.Касса) Тогда
			Продолжить;
		КонецЕсли;
		С = Новый Структура("Касса, Магазин, Пн, Вт, Ср, Чт, Пт, Сб, Вс, СИнк, Закрыт, ЦО");
		ЗаполнитьЗначенияСвойств(С, Строка);
		Данные.Добавить(С);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(Н.ХранилищеОбъект, Н.ХранилищеКлюч, Данные);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКассыНаСервере()
	Н = Настройки();
	Строки = ПрочитатьДвижения(НачалоДня(ТекущаяДата()) - 120 * 86400, КонецДня(ТекущаяДата()), Н);
	Есть = Новый Соответствие;
	Для Каждого Стр Из ЭтаФорма.Графики Цикл
		Есть.Вставить(Стр.Касса, Истина);
	КонецЦикла;
	Для Каждого Д Из Строки Цикл
		Если Д.Приход И Есть[Д.Касса] = Неопределено Тогда
			ЭтаФорма.Графики.Добавить().Касса = Д.Касса;
			Есть.Вставить(Д.Касса, Истина);
		КонецЕсли;
	КонецЦикла;
	ЭтаФорма.Графики.Сортировать("Касса");
КонецПроцедуры

#КонецОбласти

#Область Данные

// Возвращает массив структур с движениями "Денежные средства в пути" по инкассации.
&НаСервере
Функция ПрочитатьДвижения(Нач, Кон, Н)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Регистратор КАК Регистратор,
	|	Д.Период КАК Период,
	|	Д.ВидДвижения КАК ВидДвижения,
	|	Д.ВидПереводаДенежныхСредств КАК Вид,
	|	Д.Отправитель КАК Касса,
	|	Д.Организация КАК Организация,
	|	Д.Сумма КАК Сумма,
	|	&ВыражСумки КАК НомерСумки,
	|	&ВыражБанк КАК НомерПоБанку,
	|	&ВыражНазначение КАК Назначение
	|ИЗ
	|	РегистрНакопления.&Регистр КАК Д
	|ГДЕ
	|	Д.Период МЕЖДУ &Нач И &Кон
	|	И Д.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Д.Период,
	|	Д.Регистратор";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражСумки", ВыражениеРеквизита(Н.ДокРКО, Н.РеквНомерСумки,
		"номер сумки, номер сумки инкассации", "НомерСумки, НомерПакета, НомерПломбы, НомерСумкиИнкассации"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражБанк", ВыражениеРеквизита(Н.ДокПоступление, Н.РеквНомерПоБанку,
		"номер по банку, номер платежного документа, номер входящего документа, номер платежки",
		"НомерПоБанку, НомерВходящегоДокумента, НомерПоВходящемуДокументу, НомерПлатежногоДокумента, НомерПлатежногоПоручения, НомерВходящегоПлатежногоДокумента"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыражНазначение", ВыражениеРеквизита(Н.ДокПоступление, Н.РеквНазначение,
		"назначение платежа, назначение", "НазначениеПлатежа, Назначение"));
	Для Каждого КЗ Из Н Цикл
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&" + КЗ.Ключ, Строка(КЗ.Значение));
	КонецЦикла;
	Запрос.УстановитьПараметр("Нач", Нач);
	Запрос.УстановитьПараметр("Кон", Кон);

	МассивДвижений = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строка(Выборка.Вид) <> Н.ВидПеревода Тогда
			Продолжить;
		КонецЕсли;
		С = Новый Структура;
		С.Вставить("Регистратор", Выборка.Регистратор);
		С.Вставить("Дата",   НачалоДня(Выборка.Период));
		С.Вставить("Приход", Выборка.ВидДвижения = ВидДвиженияНакопления.Приход);
		С.Вставить("Касса",  Выборка.Касса);
		С.Вставить("Организация", Строка(Выборка.Организация));
		С.Вставить("Сумма",  Выборка.Сумма);
		// ключ сопоставления: номер сумки (РКО) / номер по банку, иначе номер из назначения платежа
		Ключ = НормализоватьНомер(Выборка.НомерСумки);
		Если Ключ = "" Тогда Ключ = НормализоватьНомер(Выборка.НомерПоБанку); КонецЕсли;
		Если Ключ = "" Тогда Ключ = НомерИзНазначения(Выборка.Назначение); КонецЕсли;
		С.Вставить("Ключ", Ключ);
		С.Вставить("Использован", Ложь);
		МассивДвижений.Добавить(С);
	КонецЦикла;
	Возврат МассивДвижений;
КонецФункции

// Возвращает фрагмент запроса для реквизита документа-регистратора.
// Ищет реквизит: 1) по имени из настроек, 2) по синониму (то, что видно на форме), 3) по запасным именам.
// Если реквизита нет, подставляет пустую строку и сообщает об этом.
&НаСервере
Функция ВыражениеРеквизита(ИмяДокумента, ИмяРеквизита, Синонимы, Имена)
	МД = Метаданные.Документы.Найти(ИмяДокумента);
	Если МД = Неопределено Тогда
		Сообщить("Документ не найден в конфигурации: " + ИмяДокумента + " (исправьте в Настройки())");
		Возврат """""";
	КонецЕсли;
	Найден = "";
	Если МД.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Найден = ИмяРеквизита;
	КонецЕсли;
	Если Найден = "" Тогда
		Список = СтрРазделить(Синонимы, ",", Ложь);
		Для Каждого Р Из МД.Реквизиты Цикл
			Для Каждого Син Из Список Цикл
				Если НРег(СокрЛП(Р.Синоним)) = СокрЛП(Син) Тогда
					Найден = Р.Имя; Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Найден <> "" Тогда Прервать; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Найден = "" Тогда
		Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
			Если МД.Реквизиты.Найти(СокрЛП(Имя)) <> Неопределено Тогда
				Найден = СокрЛП(Имя); Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Найден = "" Тогда
		Сообщить("У документа " + ИмяДокумента + " не найден реквизит '" + ИмяРеквизита + "'. Сопоставление пойдёт без него. Реквизиты документа: "
			+ СтрСоединить(РеквизитыДокумента(МД), ", "));
		Возврат """""";
	КонецЕсли;
	Возврат "ВЫРАЗИТЬ(Д.Регистратор КАК Документ." + ИмяДокумента + ")." + Найден;
КонецФункции

&НаСервере
Функция РеквизитыДокумента(МД)
	М = Новый Массив;
	Для Каждого Р Из МД.Реквизиты Цикл
		М.Добавить(Р.Имя + " (" + Р.Синоним + ")");
	КонецЦикла;
	Возврат М;
КонецФункции

// Оставляет только цифры и убирает ведущие нули: "015976988" -> "15976988".
&НаСервере
Функция НормализоватьНомер(Знач Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = Строка(Текст);
	Цифры = "";
	Для й = 1 По СтрДлина(Текст) Цикл
		С = Сред(Текст, й, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		КонецЕсли;
	КонецЦикла;
	Пока Лев(Цифры, 1) = "0" Цикл
		Цифры = Сред(Цифры, 2);
	КонецЦикла;
	Возврат Цифры;
КонецФункции

// Достаёт номер препроводительной ведомости из текста "...ведомости №15976988 от ...".
&НаСервере
Функция НомерИзНазначения(Знач Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = Строка(Текст);
	Поз = СтрНайти(НРег(Текст), "ведомости №");
	Смещение = 11;
	Если Поз = 0 Тогда
		Поз = СтрНайти(Текст, "№");
		Смещение = 1;
	КонецЕсли;
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Поз + Смещение);
	Цифры = "";
	Для й = 1 По СтрДлина(Хвост) Цикл
		С = Сред(Хвост, й, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		ИначеЕсли С = " " И Цифры = "" Тогда
			Продолжить;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НормализоватьНомер(Цифры);
КонецФункции

#КонецОбласти

#Область Отчет

// Остаток кассы после каждого РКО: регистр "Денежные средства (наличные)", остатки по регистраторам.
// Возвращает Соответствие "документ-регистратор -> Соответствие(касса -> остаток после документа)".
&НаСервере
Функция ПрочитатьОстаткиКасс(Нач, Кон, Н)
	Остатки = Новый Соответствие;
	Попытка
		РегМД = Неопределено;
		Для Каждого Р Из Метаданные.РегистрыНакопления Цикл
			Если НРег(СокрЛП(Р.Синоним)) = "денежные средства (наличные)" Тогда
				РегМД = Р; Прервать;
			КонецЕсли;
		КонецЦикла;
		Если РегМД = Неопределено Тогда
			РегМД = Метаданные.РегистрыНакопления.Найти(Н.РегНаличные);
		КонецЕсли;
		Если РегМД = Неопределено Тогда
			Сообщить("Регистр 'Денежные средства (наличные)' не найден - контроль остатка кассы пропущен (укажите имя в Настройки: РегНаличные)");
			Возврат Остатки;
		КонецЕсли;

		// измерение-касса: "Касса", иначе первое измерение со ссылкой на справочник Кассы
		ИмяИзм = "";
		Если РегМД.Измерения.Найти("Касса") <> Неопределено Тогда
			ИмяИзм = "Касса";
		Иначе
			Для Каждого Изм Из РегМД.Измерения Цикл
				Если НРег(Изм.Синоним) = "касса" Тогда
					ИмяИзм = Изм.Имя; Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ИмяИзм = "" Тогда
			Сообщить("В регистре " + РегМД.Имя + " не найдено измерение 'Касса' - контроль остатка пропущен");
			Возврат Остатки;
		КонецЕсли;
		Рес = РегМД.Ресурсы.Найти("Сумма");
		Если Рес = Неопределено Тогда
			Рес = РегМД.Ресурсы[0];
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Регистратор КАК Регистратор,
		|	Т.[Изм] КАК Касса,
		|	Т.[Ресурс]КонечныйОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.[Рег].ОстаткиИОбороты(&Нач, &Кон, Регистратор, ДвиженияИГраницыПериода) КАК Т
		|ГДЕ
		|	Т.Регистратор ЕСТЬ НЕ NULL";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Рег]", РегМД.Имя);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Ресурс]", Рес.Имя);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Изм]", ИмяИзм);
		Запрос.УстановитьПараметр("Нач", Нач);
		Запрос.УстановитьПараметр("Кон", Кон);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПоРег = Остатки[Выборка.Регистратор];
			Если ПоРег = Неопределено Тогда
				ПоРег = Новый Соответствие;
				Остатки.Вставить(Выборка.Регистратор, ПоРег);
			КонецЕсли;
			ПоРег.Вставить(Выборка.Касса, Выборка.Остаток);
		КонецЦикла;
	Исключение
		Сообщить("Остаток кассы не проверен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Остатки;
КонецФункции

&НаСервере
Функция Ранг(Цвет)
	Если Цвет = "Красный" Тогда Возврат 0; КонецЕсли;
	Если Цвет = "Жёлтый" Тогда Возврат 1; КонецЕсли;
	Если Цвет = "Серый" Тогда Возврат 2; КонецЕсли;
	Возврат 3;
КонецФункции

&НаСервере
Функция Деньги(Сумма)
	Если Сумма = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00");
КонецФункции

&НаСервере
Процедура СформироватьНаСервере()

	Н = Настройки();
	СохранитьПараметрыРасчета();
	Сутки = 86400;
	Сегодня = НачалоДня(ТекущаяДата());
	НачП = НачалоДня(ЭтаФорма.ДатаНач);
	КонП = КонецДня(ЭтаФорма.ДатаКон);

	// запас по краям, чтобы сопоставить пары, пересекающие границу периода
	Все = ПрочитатьДвижения(НачП - 10 * Сутки, КонП + 10 * Сутки, Н);
	Приходы = Новый Массив;
	Расходы = Новый Массив;
	Для Каждого Д Из Все Цикл
		Если Д.Приход Тогда Приходы.Добавить(Д); Иначе Расходы.Добавить(Д); КонецЕсли;
	КонецЦикла;
	Остатки = ?(Н.ПроверятьОстаток, ПрочитатьОстаткиКасс(НачП - 10 * Сутки, КонП + 10 * Сутки, Н), Новый Соответствие);

	// график: касса -> структура (Дни, СИнк, Закрыт, Задан, ЦО)
	График = Новый Соответствие;
	КассыЦО = Новый Массив;
	Для Каждого С Из ЭтаФорма.Графики Цикл
		Если ЗначениеЗаполнено(С.Касса) Тогда
			М = Новый Массив;
			М.Добавить(С.Пн); М.Добавить(С.Вт); М.Добавить(С.Ср); М.Добавить(С.Чт);
			М.Добавить(С.Пт); М.Добавить(С.Сб); М.Добавить(С.Вс);
			График.Вставить(С.Касса, Новый Структура("Дни, СИнк, Закрыт, Задан, ЦО",
				М, С.СИнк, С.Закрыт, М.Найти(Истина) <> Неопределено, С.ЦО));
			Если С.ЦО И Не С.Закрыт Тогда
				КассыЦО.Добавить(С.Касса);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// магазины, сдающие наличные в кассу ЦО: дни, когда по кассе магазина проведён РКО (любой)
	ДниЦО = ДниРКОКасс(КассыЦО, НачП, КонП + (Н.ДопускПропуска + 1) * Сутки, Н);

	Итог = Новый Массив;

	Для Каждого П Из Приходы Цикл

		Г = График[П.Касса];
		СИнк = (Г <> Неопределено И Г.СИнк);
		СрокДней = ?(СИнк, Н.ДопускДнейСинк, Н.ДопускДней);
		Срок = СрокДней * Сутки;

		// ---- поиск зачислений
		Пары = Новый Массив;
		// 1) по номеру сумки / номеру ведомости
		Если П.Ключ <> "" Тогда
			Для Каждого Р Из Расходы Цикл
				Если Не Р.Использован И Р.Ключ = П.Ключ И Р.Касса = П.Касса Тогда
					Пары.Добавить(Р); Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// 2) одно зачисление на ту же сумму в окне допуска
		Если Пары.Количество() = 0 Тогда
			Для Каждого Р Из Расходы Цикл
				Если Не Р.Использован И Р.Касса = П.Касса И Р.Сумма = П.Сумма
					И Р.Дата >= П.Дата И Р.Дата - П.Дата <= Срок Тогда
					Пары.Добавить(Р); Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// 3) зачисление несколькими суммами: складываем по порядку, пока не наберём сумму РКО
		Если Пары.Количество() = 0 Тогда
			Кандидаты = Новый Массив;
			Накоплено = 0;
			Для Каждого Р Из Расходы Цикл
				Если Не Р.Использован И Р.Касса = П.Касса И Р.Дата >= П.Дата И Р.Дата - П.Дата <= Срок Тогда
					Кандидаты.Добавить(Р);
					Накоплено = Накоплено + Р.Сумма;
					Если Накоплено >= П.Сумма Тогда Прервать; КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			// у самоинкассации принимаем и неполную/избыточную сумму, чтобы показать разницу
			Если Накоплено = П.Сумма Или (СИнк И Кандидаты.Количество() > 0) Тогда
				Пары = Кандидаты;
			КонецЕсли;
		КонецЕсли;

		СуммаПост = 0;
		ПоследняяДата = Неопределено;
		ДатыПост = Новый Массив;
		Для Каждого Р Из Пары Цикл
			Р.Использован = Истина;
			СуммаПост = СуммаПост + Р.Сумма;
			Если ПоследняяДата = Неопределено Или Р.Дата > ПоследняяДата Тогда
				ПоследняяДата = Р.Дата;
			КонецЕсли;
			ДатыПост.Добавить(Формат(Р.Дата, "ДФ=dd.MM"));
		КонецЦикла;

		Если П.Дата < НачП Или П.Дата > КонП Тогда
			Продолжить; // запись за границей периода нужна была только для пары
		КонецЕсли;

		// ---- проблемы
		Проблемы = Новый Массив; // структуры (Цвет, Имя, Текст)
		Если Пары.Количество() = 0 Тогда
			Если Сегодня - П.Дата > Срок Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Нет поступления",
					"в банк не поступило в течение " + СрокДней + " дн."));
			Иначе
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Серый", "В пути",
					"срок зачисления (" + СрокДней + " дн.) не вышел"));
			КонецЕсли;
		ИначеЕсли СуммаПост <> П.Сумма Тогда
			Если СуммаПост < П.Сумма И Сегодня - П.Дата <= Срок Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Серый", "Зачислено частично",
					"пока " + Деньги(СуммаПост) + " из " + Деньги(П.Сумма)));
			Иначе
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Расхождение суммы",
					"РКО " + Деньги(П.Сумма) + ", в банк " + Деньги(СуммаПост) + ", разница " + Деньги(СуммаПост - П.Сумма)));
			КонецЕсли;
		ИначеЕсли ПоследняяДата - П.Дата > Срок Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Позже срока",
				"зачислено через " + Формат((ПоследняяДата - П.Дата) / Сутки, "ЧГ=0") + " дн., допустимо " + СрокДней));
		КонецЕсли;

		ПоРег = Остатки[П.Регистратор];
		Остаток = ?(ПоРег = Неопределено, Неопределено, ПоРег[П.Касса]);
		Если Остаток <> Неопределено И Остаток > Н.ЛимитОстатка Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Остаток кассы",
				"после инкассации в кассе " + Деньги(Остаток) + " (лимит " + Деньги(Н.ЛимитОстатка) + ")"));
		КонецЕсли;

		// график (самоинкассацию по дням недели не проверяем)
		Если Г = Неопределено Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "кассы нет в графике"));
		ИначеЕсли Г.Закрыт Тогда
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "магазин помечен закрытым"));
		ИначеЕсли Не Г.СИнк Тогда
			Если Не Г.Задан Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "дни графика не заданы"));
			ИначеЕсли Не Г.Дни[ДеньНедели(П.Дата) - 1] Тогда
				Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Жёлтый", "Вне графика", "сдача не в день графика"));
			КонецЕсли;
		КонецЕсли;

		Итог.Добавить(НоваяСтрока(П.Касса, П.Дата, П.Регистратор, П.Ключ, П.Сумма,
			СтрСоединить(ДатыПост, ", "), ?(Пары.Количество() = 0, Неопределено, СуммаПост), Остаток, Проблемы, СИнк));
	КонецЦикла;

	// ---- поступления без РКО
	Для Каждого Р Из Расходы Цикл
		Если Не Р.Использован И Р.Дата >= НачП И Р.Дата <= КонП Тогда
			Проблемы = Новый Массив;
			Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Поступление без РКО",
				"в банк пришли деньги, РКО на сдачу не найден"));
			Итог.Добавить(НоваяСтрока(Р.Касса, Неопределено, Неопределено, Р.Ключ, Неопределено,
				Формат(Р.Дата, "ДФ=dd.MM"), Р.Сумма, Неопределено, Проблемы, Ложь));
		КонецЕсли;
	КонецЦикла;

	// ---- пропущенные дни графика
	Для Каждого КЗ Из График Цикл
		Касса = КЗ.Ключ;
		Если КЗ.Значение.Закрыт Или КЗ.Значение.СИнк Или Не КЗ.Значение.Задан Тогда
			Продолжить;
		КонецЕсли;
		ЦО = КЗ.Значение.ЦО;
		ДниКассыЦО = ДниЦО[Касса];
		День = НачалоДня(ЭтаФорма.ДатаНач);
		Пока День <= ЭтаФорма.ДатаКон И День < Сегодня Цикл
			Если КЗ.Значение.Дни[ДеньНедели(День) - 1] Тогда
				Сдавал = Ложь;
				Если ЦО Тогда
					Если ДниКассыЦО <> Неопределено Тогда
						Для См = 0 По Н.ДопускПропуска Цикл
							Если ДниКассыЦО[День + См * Сутки] <> Неопределено Тогда
								Сдавал = Истина; Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				Иначе
					Для Каждого П Из Приходы Цикл
						Если П.Касса = Касса И П.Дата >= День И П.Дата - День <= Н.ДопускПропуска * Сутки Тогда
							Сдавал = Истина; Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если Не Сдавал И Сегодня - День > Н.ДопускПропуска * Сутки Тогда
					Проблемы = Новый Массив;
					Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Пропуск дня графика",
						?(ЦО, "РКО в кассу ЦО в день графика не сделан", "РКО в день инкассации по графику не сделан")));
					Итог.Добавить(НоваяСтрока(Касса, День, Неопределено, "", Неопределено, "", Неопределено, Неопределено, Проблемы, Ложь));
				КонецЕсли;
			КонецЕсли;
			День = День + Сутки;
		КонецЦикла;
	КонецЦикла;

	// ---- превышение лимита накопления наличных в кассе (остаток на конец дня)
	ЛимитН = ЭтаФорма.ЛимитНакоплений;
	Если ЛимитН > 0 Тогда
		КонОст = ?(КонП > КонецДня(ТекущаяДата()), КонецДня(ТекущаяДата()), КонП);
		Суточные = ПрочитатьСуточныеОстатки(НачП, КонОст, Н);
		Для Каждого КЗ Из Суточные Цикл
			Г = График[КЗ.Ключ];
			Если Г <> Неопределено И Г.Закрыт Тогда
				Продолжить;
			КонецЕсли;
			Эпизод = Неопределено;
			Для Каждого Д Из КЗ.Значение Цикл
				Если Д.Конец > ЛимитН Тогда
					Если Эпизод = Неопределено Тогда
						Эпизод = Новый Структура("Начало, Конец, Дней, Макс, МаксДата", Д.Дата, Д.Дата, 0, 0, Д.Дата);
					КонецЕсли;
					Эпизод.Конец = Д.Дата;
					Эпизод.Дней = Эпизод.Дней + 1;
					Если Д.Конец > Эпизод.Макс Тогда
						Эпизод.Макс = Д.Конец;
						Эпизод.МаксДата = Д.Дата;
					КонецЕсли;
				ИначеЕсли Эпизод <> Неопределено Тогда
					ДобавитьЭпизодЛимита(Итог, КЗ.Ключ, Эпизод, ЛимитН);
					Эпизод = Неопределено;
				КонецЕсли;
			КонецЦикла;
			Если Эпизод <> Неопределено Тогда
				ДобавитьЭпизодЛимита(Итог, КЗ.Ключ, Эпизод, ЛимитН);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ЭтаФорма.АдресИтога = ПоместитьВоВременноеХранилище(Итог, ЭтаФорма.УникальныйИдентификатор);
	ЭтаФорма.СвернутыеБлоки = "";
	ВывестиОтчет(Итог);
КонецПроцедуры

// Дни, когда по кассам проведены РКО «Выдача в другую кассу»: Соответствие касса -> Соответствие(день -> Истина).
&НаСервере
Функция ДниРКОКасс(Кассы, Нач, Кон, Н)
	Результат = Новый Соответствие;
	Если Кассы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Р.Касса КАК Касса,
	|	НАЧАЛОПЕРИОДА(Р.Дата, ДЕНЬ) КАК День
	|ИЗ
	|	Документ.[ДокРКО] КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Дата МЕЖДУ &Нач И &Кон
	|	И Р.Касса В (&Кассы)
	|	[УсловиеОперации]";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ДокРКО]", Н.ДокРКО);
	// только РКО с операцией «Выдача в другую кассу»
	Операции = Новый Массив;
	МДПеречисления = Метаданные.Перечисления.Найти("ХозяйственныеОперации");
	Если ЗначениеЗаполнено(Н.ОперацииЦО) И МДПеречисления <> Неопределено Тогда
		Искомые = Новый Соответствие;
		Для Каждого Им Из СтрРазделить(Н.ОперацииЦО, ";", Ложь) Цикл
			Искомые.Вставить(НРег(СокрЛП(Им)), Истина);
		КонецЦикла;
		Для Каждого ЗП Из МДПеречисления.ЗначенияПеречисления Цикл
			Если Искомые[НРег(ЗП.Имя)] <> Неопределено Или Искомые[НРег(СокрЛП(ЗП.Синоним))] <> Неопределено Тогда
				Операции.Добавить(Перечисления.ХозяйственныеОперации[ЗП.Имя]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Операции.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[УсловиеОперации]", "И Р.ХозяйственнаяОперация В (&Операции)");
		Запрос.УстановитьПараметр("Операции", Операции);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[УсловиеОперации]", "");
		Сообщить("Операция РКО «" + Н.ОперацииЦО + "» не найдена - для касс ЦО учитываются все РКО (исправьте ОперацииЦО в Настройки())");
	КонецЕсли;
	Запрос.УстановитьПараметр("Нач", НачалоДня(Нач));
	Запрос.УстановитьПараметр("Кон", КонецДня(Кон));
	Запрос.УстановитьПараметр("Кассы", Кассы);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Сообщить("Не удалось прочитать РКО касс ЦО: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		ПоКассе = Результат[Выборка.Касса];
		Если ПоКассе = Неопределено Тогда
			ПоКассе = Новый Соответствие;
			Результат.Вставить(Выборка.Касса, ПоКассе);
		КонецЕсли;
		ПоКассе.Вставить(Выборка.День, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Описание регистра "Денежные средства (наличные)": имя регистра, измерения-кассы и ресурса "Сумма".
&НаСервере
Функция ОписаниеРегистраНаличных(Н)
	РегМД = Неопределено;
	Для Каждого Р Из Метаданные.РегистрыНакопления Цикл
		Если НРег(СокрЛП(Р.Синоним)) = "денежные средства (наличные)" Тогда
			РегМД = Р; Прервать;
		КонецЕсли;
	КонецЦикла;
	Если РегМД = Неопределено Тогда
		РегМД = Метаданные.РегистрыНакопления.Найти(Н.РегНаличные);
	КонецЕсли;
	Если РегМД = Неопределено Тогда
		Сообщить("Регистр 'Денежные средства (наличные)' не найден (укажите имя в Настройки: РегНаличные)");
		Возврат Неопределено;
	КонецЕсли;
	ИмяИзм = "";
	Если РегМД.Измерения.Найти("Касса") <> Неопределено Тогда
		ИмяИзм = "Касса";
	Иначе
		Для Каждого Изм Из РегМД.Измерения Цикл
			Если НРег(Изм.Синоним) = "касса" Тогда
				ИмяИзм = Изм.Имя; Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ИмяИзм = "" Тогда
		Сообщить("В регистре " + РегМД.Имя + " не найдено измерение 'Касса'");
		Возврат Неопределено;
	КонецЕсли;
	Рес = РегМД.Ресурсы.Найти("Сумма");
	Если Рес = Неопределено Тогда
		Рес = РегМД.Ресурсы[0];
	КонецЕсли;
	Возврат Новый Структура("Рег, Изм, Рес", РегМД.Имя, ИмяИзм, Рес.Имя);
КонецФункции

// Суточные остатки и обороты наличных по кассам.
// Возвращает Соответствие "касса -> массив структур (Дата, Конец, Приход, Расход)" на каждый день Нач..Кон
// (дни без движений заполняются предыдущим остатком). Кассы без движений за период в результат не попадают.
&НаСервере
Функция ПрочитатьСуточныеОстатки(Нач, Кон, Н)
	Результат0 = Новый Соответствие;
	Попытка
		Опис = ОписаниеРегистраНаличных(Н);
		Если Опис = Неопределено Тогда
			Возврат Результат0;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Период КАК ДеньПериода,
		|	Т.[Изм] КАК Касса,
		|	Т.[Ресурс]НачальныйОстаток КАК Начало,
		|	Т.[Ресурс]Приход КАК Приход,
		|	Т.[Ресурс]Расход КАК Расход,
		|	Т.[Ресурс]КонечныйОстаток КАК Конец
		|ИЗ
		|	РегистрНакопления.[Рег].ОстаткиИОбороты(&Нач, &Кон, День, Движения) КАК Т
		|
		|УПОРЯДОЧИТЬ ПО
		|	Касса,
		|	ДеньПериода";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Рег]", Опис.Рег);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Ресурс]", Опис.Рес);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Изм]", Опис.Изм);
		Запрос.УстановитьПараметр("Нач", НачалоДня(Нач));
		Запрос.УстановитьПараметр("Кон", Кон);

		ПоКассам = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Данные = ПоКассам[Выборка.Касса];
			Если Данные = Неопределено Тогда
				Данные = Новый Структура("Дни, Начало", Новый Соответствие, Выборка.Начало);
				ПоКассам.Вставить(Выборка.Касса, Данные);
			КонецЕсли;
			Данные.Дни.Вставить(НачалоДня(Выборка.ДеньПериода),
				Новый Структура("Конец, Приход, Расход", Выборка.Конец, Выборка.Приход, Выборка.Расход));
		КонецЦикла;

		Для Каждого КЗ Из ПоКассам Цикл
			Дни = Новый Массив;
			Остаток = КЗ.Значение.Начало;
			День = НачалоДня(Нач);
			Пока День <= Кон Цикл
				Д = КЗ.Значение.Дни[День];
				Если Д <> Неопределено Тогда
					Остаток = Д.Конец;
					Дни.Добавить(Новый Структура("Дата, Конец, Приход, Расход", День, Д.Конец, Д.Приход, Д.Расход));
				Иначе
					Дни.Добавить(Новый Структура("Дата, Конец, Приход, Расход", День, Остаток, 0, 0));
				КонецЕсли;
				День = День + 86400;
			КонецЦикла;
			Результат0.Вставить(КЗ.Ключ, Дни);
		КонецЦикла;
	Исключение
		Сообщить("Суточные остатки кассы не прочитаны: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат0;
КонецФункции

&НаСервере
Процедура ДобавитьЭпизодЛимита(Итог, Касса, Э, Лимит)
	Проблемы = Новый Массив;
	Период = ?(Э.Начало = Э.Конец, Формат(Э.Начало, "ДФ=dd.MM"),
		"с " + Формат(Э.Начало, "ДФ=dd.MM") + " по " + Формат(Э.Конец, "ДФ=dd.MM"));
	Проблемы.Добавить(Новый Структура("Цвет, Имя, Текст", "Красный", "Превышение лимита накоплений",
		"остаток кассы выше лимита " + Деньги(Лимит) + ": " + Период + " (" + Э.Дней + " дн.), максимум "
		+ Деньги(Э.Макс) + " на " + Формат(Э.МаксДата, "ДФ=dd.MM")));
	Итог.Добавить(НоваяСтрока(Касса, Э.Начало, Неопределено, "", Неопределено, "", Неопределено, Э.Макс, Проблемы, Ложь));
КонецПроцедуры

// Собирает строку отчёта; цвет и статус берутся по самой серьёзной проблеме.
&НаСервере
Функция НоваяСтрока(Касса, ДатаРКО, РКО, Ключ, СуммаРКО, ДатыПост, СуммаПост, Остаток, Проблемы, СИнк)
	Цвет = "Зелёный";
	Статус = "ОК";
	Тексты = Новый Массив;
	ГрафикТекст = "";
	Для Каждого П Из Проблемы Цикл
		Если Ранг(П.Цвет) < Ранг(Цвет) Тогда
			Цвет = П.Цвет;
			Статус = П.Имя;
		КонецЕсли;
		Если П.Цвет = "Жёлтый" Тогда
			ГрафикТекст = П.Текст;
		Иначе
			Тексты.Добавить(П.Текст);
		КонецЕсли;
	КонецЦикла;
	Если Тексты.Количество() = 0 И ГрафикТекст <> "" Тогда
		Тексты.Добавить(ГрафикТекст);
		ГрафикТекст = "";
	КонецЕсли;
	Разница = ?(СуммаПост <> Неопределено И СуммаРКО <> Неопределено, СуммаПост - СуммаРКО, Неопределено);
	Возврат Новый Структура("Касса, ДатаРКО, РКО, Ключ, СуммаРКО, ДатыПост, СуммаПост, Разница, Остаток, Статус, Цвет, Прим, СИнк, График",
		Касса, ДатаРКО, РКО, Ключ, СуммаРКО, ДатыПост, СуммаПост, Разница, Остаток, Статус, Цвет, СтрСоединить(Тексты, Символы.ПС), СИнк, ГрафикТекст);
КонецФункции

// Порядок и пояснения видов ошибок (красные строки группируются по этому порядку).
&НаСервере
Функция ВидыОшибок()
	В = Новый Массив;
	В.Добавить(Новый Структура("Имя, Пояснение", "Нет поступления", "РКО на инкассацию есть, деньги в банк не пришли в срок"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Расхождение суммы", "сумма зачисления в банк не равна сумме РКО"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Позже срока", "деньги пришли в банк позже допустимого срока"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Остаток кассы", "после инкассации в кассе осталось больше допустимого"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Поступление без РКО", "в банк пришли деньги, а РКО на сдачу не найден"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Пропуск дня графика", "в день инкассации по графику РКО не сделан"));
	В.Добавить(Новый Структура("Имя, Пояснение", "Превышение лимита накоплений", "наличных в кассе накопилось больше лимита накопления"));
	Возврат В;
КонецФункции

// Альбомная ориентация и масштаб по ширине листа (печать, PDF, сохранение в Excel).
&НаСервере
Процедура НастроитьПечать(Док)
	Попытка
		Док.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		Док.АвтоМасштаб = Истина;
		Док.ПолеСлева = 5; Док.ПолеСправа = 5; Док.ПолеСверху = 5; Док.ПолеСнизу = 5;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОбвестиСтроку(Док, Н, Колонок)
	Лин = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Для к = 1 По Колонок Цикл
		Область = Док.Область(Н, к);
		Область.Обвести(Лин, Лин, Лин, Лин);
		Попытка
			Область.ЦветГраницы = Новый Цвет(120, 120, 120);
		Исключение
		КонецПопытки;
		Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВывестиЗаголовкиКолонок(Док, Н, Заголовки)
	Для к = 0 По Заголовки.ВГраница() Цикл
		Док.Область(Н, к + 1).Текст = Заголовки[к];
		Док.Область(Н, к + 1).Шрифт = Новый Шрифт(Док.Область(Н, к + 1).Шрифт, , , Истина);
		Док.Область(Н, к + 1).ЦветФона = Новый Цвет(217, 217, 217);
		Док.Область(Н, к + 1).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	КонецЦикла;
	ОбвестиСтроку(Док, Н, Заголовки.Количество());
КонецПроцедуры

// Свёрнутые блоки отчёта: двойной щелчок по заголовку блока (ему задана расшифровка) переключает его.
&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	Если ТипЗнч(Расшифровка) = Тип("Строка") И СтрНачинаетсяС(Расшифровка, "Блок") Тогда
		СтандартнаяОбработка = Ложь;
		ПереключитьБлок(Расшифровка);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПереключитьБлок(Ключ)
	Список = ";" + ЭтаФорма.СвернутыеБлоки + ";";
	Если СтрНайти(Список, ";" + Ключ + ";") > 0 Тогда
		Список = СтрЗаменить(Список, ";" + Ключ + ";", ";");
	Иначе
		Список = Список + Ключ + ";";
	КонецЕсли;
	ЭтаФорма.СвернутыеБлоки = Список;
	Если ЗначениеЗаполнено(ЭтаФорма.АдресИтога) Тогда
		Итог = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресИтога);
		Если Итог <> Неопределено Тогда
			ВывестиОтчет(Итог);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВывестиОтчет(Итог)

	Док = ЭтаФорма.Результат;
	Док.Очистить();
	НастроитьПечать(Док);
	КассыЦООтчет = Новый Соответствие;
	Для Каждого СГ Из ЭтаФорма.Графики Цикл
		Если СГ.ЦО Тогда КассыЦООтчет.Вставить(СГ.Касса, Истина); КонецЕсли;
	КонецЦикла;

	Виды = ВидыОшибок();
	ВидИндекс = Новый Соответствие;
	Для к = 0 По Виды.ВГраница() Цикл
		ВидИндекс.Вставить(Виды[к].Имя, к);
	КонецЦикла;

	// сортировка: серьёзность, вид ошибки, касса, дата
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Ранг");
	Т.Колонки.Добавить("Вид");
	Т.Колонки.Добавить("КассаПредст");
	Т.Колонки.Добавить("Дата");
	Т.Колонки.Добавить("Данные");
	Счет = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого С Из Итог Цикл
		Счет.Вставить(С.Цвет, ?(Счет[С.Цвет] = Неопределено, 0, Счет[С.Цвет]) + 1);
		Если С.Цвет = "Красный" Тогда
			ПоВидам.Вставить(С.Статус, ?(ПоВидам[С.Статус] = Неопределено, 0, ПоВидам[С.Статус]) + 1);
		КонецЕсли;
		Стр = Т.Добавить();
		Стр.Ранг = ?(С.Цвет = "Красный" И С.Статус = "Превышение лимита накоплений", 4, Ранг(С.Цвет));
		Индекс = ?(С.Цвет = "Красный", ВидИндекс[С.Статус], 0);
		Стр.Вид = ?(Индекс = Неопределено, 99, Индекс);
		Стр.КассаПредст = Строка(С.Касса);
		Стр.Дата = ?(С.ДатаРКО <> Неопределено, С.ДатаРКО, '00010101');
		Стр.Данные = С;
	КонецЦикла;
	Т.Сортировать("Ранг, Вид, КассаПредст, Дата");

	КолКрасных = ?(Счет["Красный"] = Неопределено, 0, Счет["Красный"]);
	КолЖелтых  = ?(Счет["Жёлтый"] = Неопределено, 0, Счет["Жёлтый"]);
	КолСерых   = ?(Счет["Серый"] = Неопределено, 0, Счет["Серый"]);
	КолЗелёных = ?(Счет["Зелёный"] = Неопределено, 0, Счет["Зелёный"]);

	ФонКрасный = Новый Цвет(255, 199, 206);
	ФонЖелтый  = Новый Цвет(255, 242, 204);
	ФонСерый   = Новый Цвет(237, 237, 237);
	ФонЗелёный = Новый Цвет(226, 239, 218);
	ТёмныйКрасный = Новый Цвет(156, 0, 6);
	Белый = Новый Цвет(255, 255, 255);

	Ширины = Новый Массив;
	Ширины.Добавить(38); Ширины.Добавить(11); Ширины.Добавить(13); Ширины.Добавить(15);
	Ширины.Добавить(16); Ширины.Добавить(15); Ширины.Добавить(13); Ширины.Добавить(14); Ширины.Добавить(62); Ширины.Добавить(22);

	Н = 1;
	Для к = 1 По 10 Цикл
		Док.Область(Н, к, Н, к).ШиринаКолонки = Ширины[к - 1];
	КонецЦикла;
	Док.Область(Н, 1).Текст = "Контроль инкассации за период " + Формат(ЭтаФорма.ДатаНач, "ДЛФ=D") + " - " + Формат(ЭтаФорма.ДатаКон, "ДЛФ=D");
	Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 14, Истина);
	Н = Н + 1;

	// --- сводка
	Док.Область(Н, 1, Н, 10).Объединить();
	Док.Область(Н, 1).Текст = "ОШИБКИ: " + КолКрасных + "     вне графика: " + КолЖелтых + "     в пути: " + КолСерых + "     без замечаний: " + КолЗелёных;
	Док.Область(Н, 1, Н, 10).ЦветФона = ?(КолКрасных > 0, ФонКрасный, ФонЗелёный);
	Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 11, Истина);
	Если КолКрасных > 0 Тогда
		Док.Область(Н, 1).ЦветТекста = ТёмныйКрасный;
	КонецЕсли;
	Н = Н + 1;
	Если КолКрасных > 0 Тогда
		Для Каждого В Из Виды Цикл
			Если ПоВидам[В.Имя] <> Неопределено Тогда
				Док.Область(Н, 1, Н, 10).Объединить();
				Док.Область(Н, 1).Текст = "   " + В.Имя + ": " + ПоВидам[В.Имя];
				Н = Н + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Н = Н + 1;
	Док.Область(Н, 1, Н, 10).Объединить();
	Док.Область(Н, 1).Текст = "Двойной щелчок по заголовку блока ([-] / [+]) - свернуть или раскрыть блок.";
	Док.Область(Н, 1).ЦветТекста = Новый Цвет(110, 110, 110);
	Н = Н + 2;

	Разделы = Новый Массив;
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 0, "ОШИБКИ - требуют внимания", Новый Цвет(192, 0, 0), ФонКрасный));
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 1, "Сдача вне графика", Новый Цвет(191, 143, 0), ФонЖелтый));
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 2, "В пути (срок зачисления не вышел)", Новый Цвет(128, 128, 128), ФонСерый));
	Если ЭтаФорма.ПоказыватьУспешные Тогда
		Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 3, "Без замечаний", Новый Цвет(84, 130, 53), ФонЗелёный));
	КонецЕсли;
	// превышение лимита накоплений - отдельным блоком в самом низу отчёта
	Разделы.Добавить(Новый Структура("Ранг, Заголовок, ФонЗаг, ФонСтр", 4,
		"Превышение лимита накоплений - наличных в кассе накопилось больше лимита " + Деньги(ЭтаФорма.ЛимитНакоплений),
		Новый Цвет(192, 0, 0), ФонКрасный));

	Заголовки = Новый Массив;
	Заголовки.Добавить("Магазин (касса)"); Заголовки.Добавить("Дата"); Заголовки.Добавить("№ сумки");
	Заголовки.Добавить("Сумма РКО"); Заголовки.Добавить("Зачисление, даты"); Заголовки.Добавить("Сумма в банке");
	Заголовки.Добавить("Разница"); Заголовки.Добавить("Остаток кассы"); Заголовки.Добавить("Вид ошибки"); Заголовки.Добавить("График");

	Для Каждого Раздел Из Разделы Цикл
		Строки = Т.НайтиСтроки(Новый Структура("Ранг", Раздел.Ранг));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// заголовок раздела
		// у разделов, кроме красного "ОШИБКИ", весь раздел - один блок, который можно свернуть
		КлючСекции = "Блок" + Раздел.Ранг + "_" + Строки[0].Вид;
		Док.Область(Н, 1, Н, 10).Объединить();
		Док.Область(Н, 1).Текст = ?(Раздел.Ранг = 0, "",
			?(СтрНайти(";" + ЭтаФорма.СвернутыеБлоки + ";", ";" + КлючСекции + ";") > 0, "[+]  ", "[-]  "))
			+ Раздел.Заголовок + "  (" + Строки.Количество() + ")";
		Если Раздел.Ранг <> 0 Тогда
			Док.Область(Н, 1, Н, 10).Расшифровка = КлючСекции;
		КонецЕсли;
		Док.Область(Н, 1, Н, 10).ЦветФона = Раздел.ФонЗаг;
		Док.Область(Н, 1).ЦветТекста = Белый;
		Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 12, Истина);
		Н = Н + 1;

		ТекущийВид = Неопределено;
		НомерВГруппе = 0;
		СвернутТекущий = Ложь;
		Для Каждого Стр Из Строки Цикл
			С = Стр.Данные;

			// новая группа: для ошибок - по виду, для остальных разделов - одна группа
			НоваяГруппа = ?(Раздел.Ранг = 0, ТекущийВид <> Стр.Вид, ТекущийВид = Неопределено);
			Если НоваяГруппа Тогда
				ТекущийВид = Стр.Вид;
				НомерВГруппе = 0;
				КлючБлока = "Блок" + Раздел.Ранг + "_" + Стр.Вид;
				СвернутТекущий = СтрНайти(";" + ЭтаФорма.СвернутыеБлоки + ";", ";" + КлючБлока + ";") > 0;
				Если Раздел.Ранг = 0 Тогда
					Число = 0;
					Для Каждого Эл Из Строки Цикл
						Если Эл.Вид = Стр.Вид Тогда Число = Число + 1; КонецЕсли;
					КонецЦикла;
					Пояснение = "";
					Если Стр.Вид < Виды.Количество() Тогда
						Пояснение = " - " + Виды[Стр.Вид].Пояснение;
					КонецЕсли;
					Док.Область(Н, 1, Н, 10).Объединить();
					Док.Область(Н, 1).Текст = ?(СвернутТекущий, "[+]  ", "[-]  ") + С.Статус + "  (" + Число + ")" + Пояснение;
					Док.Область(Н, 1, Н, 10).Расшифровка = КлючБлока;
					Док.Область(Н, 1, Н, 10).ЦветФона = Новый Цвет(248, 160, 170);
					Док.Область(Н, 1).ЦветТекста = ТёмныйКрасный;
					Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , 11, Истина);
					Н = Н + 1;
				КонецЕсли;
				Если Не СвернутТекущий Тогда
					ВывестиЗаголовкиКолонок(Док, Н, Заголовки);
					Н = Н + 1;
				КонецЕсли;
			КонецЕсли;
			Если СвернутТекущий Тогда
				Продолжить; // блок свёрнут - строки не выводятся
			КонецЕсли;

			НомерВГруппе = НомерВГруппе + 1;
			ФонСтроки = ?(НомерВГруппе % 2 = 1, Белый, Новый Цвет(242, 242, 242));
			Док.Область(Н, 1).Текст = Стр.КассаПредст + ?(С.СИнк, "  [с/инк]", "") + ?(КассыЦООтчет[С.Касса] = Истина, "  [касса ЦО]", "");
			Док.Область(Н, 2).Текст = ?(С.ДатаРКО = Неопределено, "", Формат(С.ДатаРКО, "ДФ=dd.MM.yyyy"));
			Док.Область(Н, 3).Текст = С.Ключ;
			Док.Область(Н, 4).Текст = Деньги(С.СуммаРКО);
			Док.Область(Н, 5).Текст = С.ДатыПост;
			Док.Область(Н, 6).Текст = Деньги(С.СуммаПост);
			Док.Область(Н, 7).Текст = ?(С.Разница = Неопределено Или С.Разница = 0, "", Деньги(С.Разница));
			Док.Область(Н, 8).Текст = Деньги(С.Остаток);
			Док.Область(Н, 9).Текст = С.Прим;
			Док.Область(Н, 10).Текст = С.График;
			Для к = 4 По 8 Цикл
				Док.Область(Н, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			КонецЦикла;
			Док.Область(Н, 9).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Док.Область(Н, 10).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Док.Область(Н, 1, Н, 10).ЦветФона = ФонСтроки;
			Док.Область(Н, 1).Шрифт = Новый Шрифт(Док.Область(Н, 1).Шрифт, , , Истина);
			// причина ошибки - красным шрифтом, без заливки
			Если Раздел.Ранг = 0 Тогда
				Док.Область(Н, 9).ЦветТекста = ТёмныйКрасный;
			КонецЕсли;
			Если С.График <> "" Тогда
				Док.Область(Н, 10).ЦветФона = ФонЖелтый;
			КонецЕсли;
			ОбвестиСтроку(Док, Н, 10);
			Н = Н + 1;
		КонецЦикла;
		Н = Н + 1;
	КонецЦикла;

	Если Итог.Количество() = 0 Тогда
		Док.Область(Н, 1).Текст = "За период инкассаций не найдено";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область РасчетИнкассаций

// Расчёт нужного количества инкассаций в неделю (как лист «Свод» в Google-таблице):
//   нал за период (ПКО основной кассы магазина) / дней периода = среднедневной нал,
//   x 7 = нал за неделю, ОКРВВЕРХ(нал за неделю / лимит) = инкассаций в неделю ПЛАН,
//   ФАКТ - сколько дней отмечено в графике (Пн-Вс), отклонение = ПЛАН - ФАКТ,
//   расходы = выезды x ставка.

&НаСервере
Процедура ЗагрузитьПараметрыРасчета()
	Н = Настройки();
	ЭтаФорма.СтавкаИнк = Н.СтавкаИнк;
	ЭтаФорма.ЛимитИнк = Н.ЛимитИнк;
	ЭтаФорма.ЛимитыСравнения = Н.ЛимитыСравнения;
	ЭтаФорма.ЛимитНакоплений = Н.ЛимитНакопленийПоУмолчанию;
	УстановитьТарифыПоУмолчанию();
	Данные = ХранилищеОбщихНастроек.Загрузить(Н.ХранилищеОбъект, Н.ХранилищеКлючСвод);
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		// тарифы: берём сохранённые, в т.ч. нулевые
		Для Каждого ИмяТарифа Из СтрРазделить(ИменаТарифов(), ",") Цикл
			Если Данные.Свойство(ИмяТарифа) И ТипЗнч(Данные[ИмяТарифа]) = Тип("Число") Тогда
				ЭтаФорма[ИмяТарифа] = Данные[ИмяТарифа];
			КонецЕсли;
		КонецЦикла;
		Если Данные.Свойство("СтавкаИнк") И ЗначениеЗаполнено(Данные.СтавкаИнк) Тогда
			ЭтаФорма.СтавкаИнк = Данные.СтавкаИнк;
		КонецЕсли;
		Если Данные.Свойство("ЛимитИнк") И ЗначениеЗаполнено(Данные.ЛимитИнк) Тогда
			ЭтаФорма.ЛимитИнк = Данные.ЛимитИнк;
		КонецЕсли;
		Если Данные.Свойство("ЛимитыСравнения") И ЗначениеЗаполнено(Данные.ЛимитыСравнения) Тогда
			ЭтаФорма.ЛимитыСравнения = Данные.ЛимитыСравнения;
		КонецЕсли;
		Если Данные.Свойство("ЛимитНакоплений") И ТипЗнч(Данные.ЛимитНакоплений) = Тип("Число") Тогда
			ЭтаФорма.ЛимитНакоплений = Данные.ЛимитНакоплений;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьПараметрыРасчета()
	Н = Настройки();
	Данные = Новый Структура("СтавкаИнк, ЛимитИнк, ЛимитыСравнения, ЛимитНакоплений", ЭтаФорма.СтавкаИнк, ЭтаФорма.ЛимитИнк, ЭтаФорма.ЛимитыСравнения, ЭтаФорма.ЛимитНакоплений);
	Для Каждого ИмяТарифа Из СтрРазделить(ИменаТарифов(), ",") Цикл
		Данные.Вставить(ИмяТарифа, ЭтаФорма[ИмяТарифа]);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(Н.ХранилищеОбъект, Н.ХранилищеКлючСвод, Данные);
КонецПроцедуры

&НаСервере
Функция ИменаТарифов()
	Возврат "СтавкаИнк,ТарифПорог,ТарифДоПроц,ТарифСвышеПроц,ТарифСвышеМин,ТарифПересчетПроц,ТарифСИнкПроц";
КонецФункции

&НаСервере
Процедура УстановитьТарифыПоУмолчанию()
	Н = Настройки();
	ЭтаФорма.СтавкаИнк         = Н.ТарифДоМин;
	ЭтаФорма.ТарифПорог        = Н.ТарифПорог;
	ЭтаФорма.ТарифДоПроц       = Н.ТарифДоПроц;
	ЭтаФорма.ТарифСвышеПроц    = Н.ТарифСвышеПроц;
	ЭтаФорма.ТарифСвышеМин     = Н.ТарифСвышеМин;
	ЭтаФорма.ТарифПересчетПроц = Н.ТарифПересчетПроц;
	ЭтаФорма.ТарифСИнкПроц     = Н.ТарифСИнкПроц;
КонецПроцедуры

&НаКлиенте
Процедура ТарифыПоУмолчанию(Команда)
	УстановитьТарифыПоУмолчанию();
КонецПроцедуры

// ОКРВВЕРХ до целого.
&НаСервере
Функция ОкрВверх(Знач Х)
	Ц = Цел(Х);
	Возврат ?(Х > Ц, Ц + 1, Ц);
КонецФункции

// Нал по ПКО основных касс магазинов: Соответствие касса -> Структура(Сумма, Документов, Займ).
// Сумма - все учитываемые ПКО (выручка ККМ + дополнительные операции), Займ - только дополнительные операции.
&НаСервере
Функция ПрочитатьНалПКО(Нач, Кон, Кассы, Н, Диаг)
	Рез = Новый Соответствие;
	Если Метаданные.Документы.Найти(Н.ДокПКО) = Неопределено Тогда
		Сообщить("Документ не найден в конфигурации: " + Н.ДокПКО + " (исправьте в Настройки())");
		Возврат Рез;
	КонецЕсли;

	// значения перечисления: основная операция и дополнительные (по имени или представлению)
	Основные = Новый Массив;
	Доп = Новый Массив;
	МДПеречисления = Метаданные.Перечисления.Найти("ХозяйственныеОперации");
	Если ЗначениеЗаполнено(Н.ОперацияПКО) И МДПеречисления <> Неопределено Тогда
		Искомые = Новый Соответствие;
		Для Каждого Им Из СтрРазделить(Н.ОперацииПКОДоп, ";", Ложь) Цикл
			Искомые.Вставить(НРег(СокрЛП(Им)), Истина);
		КонецЦикла;
		Для Каждого ЗП Из МДПеречисления.ЗначенияПеречисления Цикл
			Если ЗП.Имя = Н.ОперацияПКО Тогда
				Основные.Добавить(Перечисления.ХозяйственныеОперации[ЗП.Имя]);
			ИначеЕсли Искомые[НРег(ЗП.Имя)] <> Неопределено Или Искомые[НРег(СокрЛП(ЗП.Синоним))] <> Неопределено Тогда
				Доп.Добавить(Перечисления.ХозяйственныеОперации[ЗП.Имя]);
			КонецЕсли;
		КонецЦикла;
		Если Основные.Количество() = 0 Тогда
			Сообщить("Хозяйственная операция '" + Н.ОперацияПКО + "' не найдена - берутся все ПКО кассы (исправьте ОперацияПКО в Настройки())");
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Касса КАК Касса,
	|	П.ХозяйственнаяОперация КАК Операция,
	|	СУММА(П.СуммаДокумента) КАК Сумма,
	|	КОЛИЧЕСТВО(П.Ссылка) КАК Документов
	|ИЗ
	|	Документ.[ДокПКО] КАК П
	|ГДЕ
	|	П.Проведен
	|	И П.Дата МЕЖДУ &Нач И &Кон
	|	И П.Касса В (&Кассы)
	|	[УсловиеОперации]
	|
	|СГРУППИРОВАТЬ ПО
	|	П.Касса,
	|	П.ХозяйственнаяОперация";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ДокПКО]", Н.ДокПКО);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[УсловиеОперации]", "");
	Запрос.УстановитьПараметр("Нач", Нач);
	Запрос.УстановитьПараметр("Кон", Кон);
	Запрос.УстановитьПараметр("Кассы", Кассы);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Сообщить("Не удалось прочитать ПКО: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Рез;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		ИмяОп = Строка(Выборка.Операция);
		ОпН = НРег(ИмяОп);
		ЭтоЗайм = Доп.Найти(Выборка.Операция) <> Неопределено
			Или ((СтрНайти(ОпН, "кредит") > 0 Или СтрНайти(ОпН, "займ") > 0)
				И СтрНайти(ОпН, "возврат") = 0 И СтрНайти(ОпН, "погашен") = 0 И СтрНайти(ОпН, "выдач") = 0);
		ЭтоВыручка = Основные.Количество() = 0 Или Основные.Найти(Выборка.Операция) <> Неопределено;
		Если Не ЭтоЗайм И Не ЭтоВыручка Тогда
			Диаг.НеУчтено.Вставить(ИмяОп, ?(Диаг.НеУчтено[ИмяОп] = Неопределено, 0, Диаг.НеУчтено[ИмяОп]) + Выборка.Сумма);
			Продолжить;
		КонецЕсли;
		Д = Рез[Выборка.Касса];
		Если Д = Неопределено Тогда
			Д = Новый Структура("Сумма, Документов, Займ", 0, 0, 0);
			Рез.Вставить(Выборка.Касса, Д);
		КонецЕсли;
		Д.Сумма = Д.Сумма + Выборка.Сумма;
		Д.Документов = Д.Документов + Выборка.Документов;
		Если ЭтоЗайм И Не ЭтоВыручка Тогда
			Д.Займ = Д.Займ + Выборка.Сумма;
			Диаг.СуммаЗайма = Диаг.СуммаЗайма + Выборка.Сумма;
			Диаг.ОперацииЗайма.Вставить(ИмяОп, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Список лимитов для сравнения из строки "200000;250000;300000".
&НаСервере
Функция РазобратьЛимиты(Знач Текст)
	М = Новый Массив;
	Текст = СтрЗаменить(СтрЗаменить(Текст, ",", ";"), " ", "");
	Для Каждого Ч Из СтрРазделить(Текст, ";", Ложь) Цикл
		Попытка
			Л = Число(Ч);
		Исключение
			Продолжить;
		КонецПопытки;
		Если Л > 0 И М.Найти(Л) = Неопределено Тогда
			М.Добавить(Л);
		КонецЕсли;
	КонецЦикла;
	Возврат М;
КонецФункции

// ---- Тарифы банков (значения - в Настройки()).
// Инкассация РСХ: за выезд от суммы сдачи: до порога - % (мин. сумма), свыше порога - % (мин. сумма);
// плюс % за пересчёт и зачисление наличных на расчётный счёт. Самоинкассация Сбер: % от зачисляемой суммы.

&НаСервере
Функция Тарифы()
	Н = Настройки();
	Т = Новый Структура;
	Т.Вставить("Порог",         ?(ЭтаФорма.ТарифПорог > 0, ЭтаФорма.ТарифПорог, Н.ТарифПорог));
	Т.Вставить("ДоПроц",        ЭтаФорма.ТарифДоПроц);
	Т.Вставить("ДоМин",         ЭтаФорма.СтавкаИнк);
	Т.Вставить("СвышеПроц",     ЭтаФорма.ТарифСвышеПроц);
	Т.Вставить("СвышеМин",      ЭтаФорма.ТарифСвышеМин);
	Т.Вставить("ПересчетПроц",  ЭтаФорма.ТарифПересчетПроц);
	Т.Вставить("СИнкПроц",      ЭтаФорма.ТарифСИнкПроц);
	Возврат Т;
КонецФункции

// Комиссия РСХ за один выезд инкассации с суммой Сумма (без пересчёта).
&НаСервере
Функция КомиссияВыезда(Сумма, Т)
	Если Сумма <= Т.Порог Тогда
		Возврат Макс(Окр(Сумма * Т.ДоПроц / 100, 2), Т.ДоМин);
	КонецЕсли;
	Возврат Макс(Окр(Сумма * Т.СвышеПроц / 100, 2), Т.СвышеМин);
КонецФункции

// Полная стоимость сдачи суммы Сумма одним выездом: РСХ (выезд + пересчёт) или Сбер (самоинкассация).
&НаСервере
Функция СтоимостьСдачи(Сумма, СИнк, Т)
	Если СИнк Тогда
		Возврат Окр(Сумма * Т.СИнкПроц / 100, 2);
	КонецЕсли;
	Возврат КомиссияВыезда(Сумма, Т) + Окр(Сумма * Т.ПересчетПроц / 100, 2);
КонецФункции

// Расходы в неделю при сдаче НалНед за Выездов выездов (сумма делится поровну).
&НаСервере
Функция РасходыНедели(НалНед, Выездов, СИнк, Т)
	Если НалНед <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если СИнк Тогда
		Возврат Окр(НалНед * Т.СИнкПроц / 100, 2);
	КонецЕсли;
	Если Выездов <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Выездов * КомиссияВыезда(НалНед / Выездов, Т) + Окр(НалНед * Т.ПересчетПроц / 100, 2);
КонецФункции

&НаСервере
Процедура РассчитатьНаСервере()

	Н = Настройки();
	СохранитьПараметрыРасчета();
	Т_ = Тарифы();
	Сутки = 86400;
	НачП = НачалоДня(ЭтаФорма.ДатаНач);
	КонП = КонецДня(ЭтаФорма.ДатаКон);
	Дней = (НачалоДня(ЭтаФорма.ДатаКон) - НачП) / Сутки + 1;
	Недель = Дней / 7;
	Лимит = ЭтаФорма.ЛимитИнк;

	Кассы = Новый Массив;
	СИнкКассы = Новый Соответствие;
	Для Каждого С Из ЭтаФорма.Графики Цикл
		Если ЗначениеЗаполнено(С.Касса) И Кассы.Найти(С.Касса) = Неопределено Тогда
			Кассы.Добавить(С.Касса);
			СИнкКассы.Вставить(С.Касса, С.СИнк);
		КонецЕсли;
	КонецЦикла;
	Если Кассы.Количество() = 0 Тогда
		Сообщить("Список касс пуст: заполните вкладку «Графики инкассации» (кнопка «Добавить кассы из движений» или «Загрузить график из файла») и сохраните графики");
		Возврат;
	КонецЕсли;

	Диаг = Новый Структура("ОперацииЗайма, НеУчтено, СуммаЗайма", Новый Соответствие, Новый Соответствие, 0);
	Нал = ПрочитатьНалПКО(НачП, КонП, Кассы, Н, Диаг);

	// фактические сдачи по РКО на инкассацию: дни сдачи и комиссия по каждому РКО
	ДниРКО = Новый Соответствие;
	СуммыРКО = Новый Соответствие;   // касса -> Соответствие(регистратор -> сумма)
	Для Каждого Д Из ПрочитатьДвижения(НачП, КонП, Н) Цикл
		Если Д.Приход Тогда
			ПоКассе = ДниРКО[Д.Касса];
			Если ПоКассе = Неопределено Тогда
				ПоКассе = Новый Соответствие;
				ДниРКО.Вставить(Д.Касса, ПоКассе);
				СуммыРКО.Вставить(Д.Касса, Новый Соответствие);
			КонецЕсли;
			ПоКассе.Вставить(Д.Дата, Истина);
			ПоДок = СуммыРКО[Д.Касса];
			ПоДок.Вставить(Д.Регистратор, ?(ПоДок[Д.Регистратор] = Неопределено, 0, ПоДок[Д.Регистратор]) + Д.Сумма);
		КонецЕсли;
	КонецЦикла;

	Т = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Организация,Магазин,Касса,Нал,ПКО,СредДн,ЗаНеделю,План,Факт,Отклонение,РКО,РКОвНед,СИнк,Закрыт,ВРасчете,Сорт,РасхПлан,РасхФакт,КомРКО,СуммаРКО,РасхРСХ,РасхСбер", ",") Цикл
		Т.Колонки.Добавить(Имя);
	КонецЦикла;
	Т.Колонки.Добавить("ЦО");
	КассыЦО = Новый Массив;
	Для Каждого С Из ЭтаФорма.Графики Цикл
		Если ЗначениеЗаполнено(С.Касса) И С.ЦО Тогда
			КассыЦО.Добавить(С.Касса);
		КонецЕсли;
	КонецЦикла;
	ДниЦО = ДниРКОКасс(КассыЦО, НачП, КонП, Н);

	Для Каждого С Из ЭтаФорма.Графики Цикл
		Если Не ЗначениеЗаполнено(С.Касса) Тогда
			Продолжить;
		КонецЕсли;
		Стр = Т.Добавить();
		Стр.Касса = С.Касса;
		Стр.Магазин = ?(ЗначениеЗаполнено(С.Магазин), С.Магазин, Строка(С.Касса));
		Попытка
			Стр.Организация = Строка(С.Касса.Владелец);
		Исключение
			Стр.Организация = "";
		КонецПопытки;
		ДанныеНал = Нал[С.Касса];
		Стр.Нал = ?(ДанныеНал = Неопределено, 0, ДанныеНал.Сумма);
		Стр.ПКО = ?(ДанныеНал = Неопределено, 0, ДанныеНал.Займ);
		Стр.СредДн = Стр.Нал / Дней;
		Стр.ЗаНеделю = Стр.СредДн * 7;
		Стр.План = ОкрВверх(Стр.ЗаНеделю / Лимит);
		Стр.Факт = ?(С.Пн, 1, 0) + ?(С.Вт, 1, 0) + ?(С.Ср, 1, 0) + ?(С.Чт, 1, 0) + ?(С.Пт, 1, 0) + ?(С.Сб, 1, 0) + ?(С.Вс, 1, 0);
		Стр.Отклонение = Стр.План - Стр.Факт;
		ПоКассе = ?(С.ЦО, ДниЦО[С.Касса], ДниРКО[С.Касса]);
		Стр.РКО = ?(ПоКассе = Неопределено, 0, ПоКассе.Количество());
		Стр.ЦО = С.ЦО;
		Стр.РКОвНед = ?(Недель > 0, Стр.РКО / Недель, 0);
		Стр.СИнк = С.СИнк;
		Стр.Закрыт = С.Закрыт;
		Стр.ВРасчете = Не С.Закрыт И Не С.ЦО И (Н.СИнкВРасходах Или Не С.СИнк);
		Стр.Сорт = ?(Стр.ВРасчете, 0, 1);
		// расходы по тарифам
		Стр.РасхПлан = ?(С.Закрыт, 0, РасходыНедели(Стр.ЗаНеделю, Стр.План, С.СИнк, Т_));
		Стр.РасхФакт = ?(С.Закрыт, 0, РасходыНедели(Стр.ЗаНеделю, ?(С.СИнк, 1, Стр.Факт), С.СИнк, Т_));
		Стр.РасхРСХ = РасходыНедели(Стр.ЗаНеделю, Макс(Стр.План, 1), Ложь, Т_);
		Стр.РасхСбер = РасходыНедели(Стр.ЗаНеделю, 1, Истина, Т_);
		КомРКО = 0; СумРКО = 0;
		ПоДок = СуммыРКО[С.Касса];
		Если ПоДок <> Неопределено Тогда
			Для Каждого КЗ Из ПоДок Цикл
				КомРКО = КомРКО + СтоимостьСдачи(КЗ.Значение, С.СИнк, Т_);
				СумРКО = СумРКО + КЗ.Значение;
			КонецЦикла;
		КонецЕсли;
		Стр.КомРКО = КомРКО;
		Стр.СуммаРКО = СумРКО;
		Если С.ЦО Тогда
			// наличные везут в кассу ЦО - банковских расходов по магазину нет
			Стр.РасхПлан = 0; Стр.РасхФакт = 0; Стр.КомРКО = 0;
		КонецЕсли;
	КонецЦикла;
	Т.Сортировать("Сорт, Отклонение Убыв, Нал Убыв, Организация, Магазин");

	ВывестиРасчет(Т, Дней, Т_, Лимит, Н, Диаг);
КонецПроцедуры

&НаСервере
Функция Руб(Сумма)
	Возврат Формат(Сумма, "ЧДЦ=0; ЧРГ=' '; ЧН=0");
КонецФункции

&НаСервере
Процедура ВывестиРасчет(Т, Дней, Т_, Лимит, Н, Диаг)

	Док = ЭтаФорма.РезультатРасчета;
	Док.Очистить();
	НастроитьПечать(Док);
	Белый = Новый Цвет(255, 255, 255);
	ФонКрасный = Новый Цвет(255, 199, 206);
	ФонЖелтый  = Новый Цвет(255, 242, 204);
	ФонЗелёный = Новый Цвет(226, 239, 218);
	ФонСерый   = Новый Цвет(237, 237, 237);
	ФонШапки   = Новый Цвет(217, 217, 217);
	ТёмныйКрасный = Новый Цвет(156, 0, 6);
	Колонок = 16;
	Недель = Дней / 7;

	Ширины = СтрРазделить("16,34,14,13,13,12,12,12,11,10,8,8,14,14,14,70", ",");
	Для к = 1 По Колонок Цикл
		Док.Область(1, к, 1, к).ШиринаКолонки = Число(Ширины[к - 1]);
	КонецЦикла;

	Н1 = 1;
	Док.Область(Н1, 1).Текст = "Расчёт количества инкассаций за период " + Формат(ЭтаФорма.ДатаНач, "ДЛФ=D") + " - " + Формат(ЭтаФорма.ДатаКон, "ДЛФ=D")
		+ " (" + Дней + " дн.)";
	Док.Область(Н1, 1).Шрифт = Новый Шрифт(Док.Область(Н1, 1).Шрифт, , 14, Истина);
	Н1 = Н1 + 1;
	Док.Область(Н1, 1, Н1, Колонок).Объединить();
	Док.Область(Н1, 1).Текст = "Нал - сумма ПКО основной кассы магазина" + ?(ЗначениеЗаполнено(Н.ОперацияПКО), " (выручка из кассы ККМ + займ от другого юрлица магазина)", "")
		+ ". План в неделю = ОКРВВЕРХ(нал за 7 дней / лимит " + Руб(Лимит) + "). Факт - дни инкассации в графике.";
	Док.Область(Н1, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Н1 = Н1 + 1;
	Док.Область(Н1, 1, Н1, Колонок).Объединить();
	Док.Область(Н1, 1).Текст = "Тарифы. Инкассация РСХ: до " + Руб(Т_.Порог) + " ₽ за выезд - " + Т_.ДоПроц + "% (мин. " + Руб(Т_.ДоМин) + " ₽), свыше - "
		+ Т_.СвышеПроц + "% (мин. " + Руб(Т_.СвышеМин) + " ₽), плюс " + Т_.ПересчетПроц + "% за пересчёт и зачисление. Самоинкассация Сбер: "
		+ Т_.СИнкПроц + "% от зачисляемой суммы. Сумма выезда = нал за неделю / число выездов.";
	Док.Область(Н1, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Н1 = Н1 + 1;
	// какие ПКО вошли в нал и какие нет
	ОпЗайма = Новый Массив;
	Для Каждого КЗ Из Диаг.ОперацииЗайма Цикл ОпЗайма.Добавить("«" + КЗ.Ключ + "»"); КонецЦикла;
	НеУч = Новый Массив;
	Для Каждого КЗ Из Диаг.НеУчтено Цикл НеУч.Добавить("«" + КЗ.Ключ + "» " + Деньги(КЗ.Значение)); КонецЦикла;
	Док.Область(Н1, 1, Н1, Колонок).Объединить();
	Док.Область(Н1, 1).Текст = ?(ОпЗайма.Количество() > 0,
		"Займ от другого юрлица учтён в нале: " + Деньги(Диаг.СуммаЗайма) + " (ПКО " + СтрСоединить(ОпЗайма, ", ") + ").",
		"ПКО займа от другого юрлица за период не найдено - в нал вошла только выручка.")
		+ ?(НеУч.Количество() > 0, "  Не вошли в нал ПКО: " + СтрСоединить(НеУч, "; ") + ".", "");
	Док.Область(Н1, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Док.Область(Н1, 1).ЦветТекста = ?(ОпЗайма.Количество() > 0, Новый Цвет(0, 97, 0), ТёмныйКрасный);
	Н1 = Н1 + 2;

	// итоги
	ПланВ = 0; ФактВ = 0; РКОВ = 0; НалВсего = 0; ЗаймВсего = 0; Больше = 0; Меньше = 0;
	РасхП = 0; РасхФ = 0; КомР = 0; РасхСИнк = 0; КомРСИнк = 0;
	Для Каждого Стр Из Т Цикл
		НалВсего = НалВсего + Стр.Нал;
		ЗаймВсего = ЗаймВсего + Стр.ПКО;
		Если Стр.Закрыт Тогда
			Продолжить;
		КонецЕсли;
		РасхП = РасхП + Стр.РасхПлан;
		РасхФ = РасхФ + Стр.РасхФакт;
		КомР = КомР + Стр.КомРКО;
		Если Стр.СИнк И Не Стр.ЦО Тогда
			РасхСИнк = РасхСИнк + Стр.РасхПлан;
			КомРСИнк = КомРСИнк + Стр.КомРКО;
		КонецЕсли;
		Если Стр.ВРасчете Тогда
			ПланВ = ПланВ + Стр.План;
			ФактВ = ФактВ + Стр.Факт;
			РКОВ = РКОВ + Стр.РКОвНед;
			Если Стр.Отклонение > 0 Тогда Больше = Больше + 1; КонецЕсли;
			Если Стр.Отклонение < 0 Тогда Меньше = Меньше + 1; КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// шапка: две группы колонок - в неделю и за выбранный период
	Док.Область(Н1, 1, Н1 + 1, 2).Объединить();
	Док.Область(Н1, 3, Н1, 6).Объединить();
	Док.Область(Н1, 7, Н1, 10).Объединить();
	Док.Область(Н1, 3).Текст = "В НЕДЕЛЮ";
	Док.Область(Н1, 7).Текст = "ЗА ПЕРИОД  " + Формат(ЭтаФорма.ДатаНач, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтаФорма.ДатаКон, "ДФ=dd.MM.yyyy")
		+ "  (" + Дней + " дн. = " + Формат(Дней / 7, "ЧДЦ=1") + " нед.)";
	Шапка = СтрРазделить("|План|Факт по графику|Разница (план - факт)|Факт по РКО (среднее)|План|Факт по графику|Разница (план - факт)|Факт по РКО", "|");
	Для Стр_ = Н1 По Н1 + 1 Цикл
		Для к = 1 По 10 Цикл
			Док.Область(Стр_, к).Шрифт = Новый Шрифт(Док.Область(Стр_, к).Шрифт, , , Истина);
			Док.Область(Стр_, к).ЦветФона = ФонШапки;
			Док.Область(Стр_, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			Док.Область(Стр_, к).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		КонецЦикла;
		ОбвестиСтроку(Док, Стр_, 10);
	КонецЦикла;
	Для к = 1 По Шапка.ВГраница() Цикл
		Док.Область(Н1 + 1, к + 2).Текст = Шапка[к];
	КонецЦикла;
	Н1 = Н1 + 2;
	НедельВПериоде = Дней / 7;
	СтрокиИтогов = Новый Массив;
	// П, Ф, Р - в неделю; ПП, ФП, РП - за период (факт по РКО за период - реальные данные, не пересчёт)
	СтрокиИтогов.Добавить(Новый Структура("Имя, П, Ф, Р, ПП, ФП, РП", "Выездов инкассации", ПланВ, ФактВ, РКОВ,
		ПланВ * НедельВПериоде, ФактВ * НедельВПериоде, РКОВ * НедельВПериоде));
	СтрокиИтогов.Добавить(Новый Структура("Имя, П, Ф, Р, ПП, ФП, РП", "Расходы, ₽ (РСХ + Сбер)", РасхП, РасхФ, ?(НедельВПериоде > 0, КомР / НедельВПериоде, 0),
		РасхП * НедельВПериоде, РасхФ * НедельВПериоде, КомР));
	СтрокиИтогов.Добавить(Новый Структура("Имя, П, Ф, Р, ПП, ФП, РП", "   в т.ч. самоинкассация Сбер, ₽", РасхСИнк, РасхСИнк, ?(НедельВПериоде > 0, КомРСИнк / НедельВПериоде, 0),
		РасхСИнк * НедельВПериоде, РасхСИнк * НедельВПериоде, КомРСИнк));
	Для Каждого Итг Из СтрокиИтогов Цикл
		Док.Область(Н1, 1, Н1, 2).Объединить();
		Док.Область(Н1, 1).Текст = Итг.Имя;
		Док.Область(Н1, 3).Текст = Руб(Итг.П);
		Док.Область(Н1, 4).Текст = Руб(Итг.Ф);
		Док.Область(Н1, 5).Текст = Руб(Итг.П - Итг.Ф);
		Док.Область(Н1, 6).Текст = Руб(Итг.Р);
		Док.Область(Н1, 7).Текст = Руб(Итг.ПП);
		Док.Область(Н1, 8).Текст = Руб(Итг.ФП);
		Док.Область(Н1, 9).Текст = Руб(Итг.ПП - Итг.ФП);
		Док.Область(Н1, 10).Текст = Руб(Итг.РП);
		Для к = 3 По 10 Цикл
			Док.Область(Н1, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		КонецЦикла;
		ЦветРазн = ?(Окр(Итг.П) > Окр(Итг.Ф), ФонКрасный, ?(Окр(Итг.П) < Окр(Итг.Ф), ФонЖелтый, ФонЗелёный));
		Док.Область(Н1, 5).ЦветФона = ЦветРазн;
		Док.Область(Н1, 9).ЦветФона = ЦветРазн;
		Док.Область(Н1, 7, Н1, 10).ЦветФона = Новый Цвет(242, 246, 252);
		Док.Область(Н1, 9).ЦветФона = ЦветРазн;
		ОбвестиСтроку(Док, Н1, 10);
		Н1 = Н1 + 1;
	КонецЦикла;
	Док.Область(Н1, 1, Н1, Колонок).Объединить();
	Док.Область(Н1, 1).Текст = "Касс в расчёте выездов: " + Т.НайтиСтроки(Новый Структура("ВРасчете", Истина)).Количество()
		+ ";  нужно больше выездов: " + Больше + ";  выездов больше нужного: " + Меньше
		+ ";  нал всего " + Деньги(НалВсего) + ", в т.ч. займ от др. юрлица " + Деньги(ЗаймВсего)
		+ ".  В неделю: план и факт по графику - недельная норма, факт по РКО - среднее за неделю (итог периода / число недель)."
		+ "  За период: план и график умножены на число недель, факт по РКО - реальные дни с РКО и комиссия по каждому РКО по тарифам."
		+ ?(Н.СИнкВРасходах, "", "  Самоинкассация в выезды не входит, её расходы (Сбер) - в строке расходов.");
	Док.Область(Н1, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Н1 = Н1 + 2;

	// сравнение лимитов: первая строка - текущая ситуация (график), разница по всем строкам - от неё
	Лимиты = РазобратьЛимиты(ЭтаФорма.ЛимитыСравнения);
	Если Лимиты.Найти(Лимит) = Неопределено Тогда
		Лимиты.Добавить(Лимит);
	КонецЕсли;
	СписокЛ = Новый СписокЗначений;
	СписокЛ.ЗагрузитьЗначения(Лимиты);
	СписокЛ.СортироватьПоЗначению();
	Док.Область(Н1, 1, Н1, 10).Объединить();
	Док.Область(Н1, 1).Текст = "Сравнение лимитов на выезд (инкассация РСХ, без самоинкассации)";
	Док.Область(Н1, 1).Шрифт = Новый Шрифт(Док.Область(Н1, 1).Шрифт, , 11, Истина);
	Н1 = Н1 + 1;
	Док.Область(Н1, 1, Н1, 10).Объединить();
	Док.Область(Н1, 1).Текст = "Первая строка - текущая ситуация (инкассации по действующему графику). Разница во всех строках считается от неё: "
		+ "минус в расходах - экономия, плюс - рост расходов.";
	Док.Область(Н1, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Н1 = Н1 + 1;
	// шапка: две группы колонок - в неделю и за выбранный период (как в итоговой таблице)
	Док.Область(Н1, 1, Н1 + 1, 2).Объединить();
	Док.Область(Н1, 3, Н1, 6).Объединить();
	Док.Область(Н1, 7, Н1, 10).Объединить();
	Док.Область(Н1, 1).Текст = "Вариант (лимит на выезд)";
	Док.Область(Н1, 3).Текст = "В НЕДЕЛЮ";
	Док.Область(Н1, 7).Текст = "ЗА ПЕРИОД  " + Формат(ЭтаФорма.ДатаНач, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтаФорма.ДатаКон, "ДФ=dd.MM.yyyy")
		+ "  (" + Дней + " дн. = " + Формат(Недель, "ЧДЦ=1") + " нед.)";
	Шапка = СтрРазделить("|Выездов|Разница выездов с текущей ситуацией|Расходы РСХ, ₽|Разница расходов с текущей ситуацией, ₽|Выездов|Разница выездов с текущей ситуацией|Расходы РСХ, ₽|Разница расходов с текущей ситуацией, ₽", "|");
	Для Стр_ = Н1 По Н1 + 1 Цикл
		Для к = 1 По 10 Цикл
			Док.Область(Стр_, к).Шрифт = Новый Шрифт(Док.Область(Стр_, к).Шрифт, , , Истина);
			Док.Область(Стр_, к).ЦветФона = ФонШапки;
			Док.Область(Стр_, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			Док.Область(Стр_, к).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		КонецЦикла;
		ОбвестиСтроку(Док, Стр_, 10);
	КонецЦикла;
	Для к = 1 По Шапка.ВГраница() Цикл
		Док.Область(Н1 + 1, к + 2).Текст = Шапка[к];
	КонецЦикла;
	Н1 = Н1 + 2;

	// текущая ситуация: выезды по графику магазинов РСХ без самоинкассации и расходы по ним
	ВыездовТек = 0; РасхТек = 0;
	Для Каждого Стр Из Т Цикл
		Если Стр.ВРасчете И Не Стр.СИнк Тогда
			ВыездовТек = ВыездовТек + Стр.Факт;
			РасхТек = РасхТек + Стр.РасхФакт;
		КонецЕсли;
	КонецЦикла;
	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Название, Выездов, Расх, Текущая", "Текущая ситуация (график)", ВыездовТек, РасхТек, Истина));
	Для Каждого ЭлЛ Из СписокЛ Цикл
		Л = ЭлЛ.Значение;
		Выездов = 0; Расх = 0;
		Для Каждого Стр Из Т Цикл
			Если Стр.ВРасчете И Не Стр.СИнк Тогда
				В = ОкрВверх(Стр.ЗаНеделю / Л);
				Выездов = Выездов + В;
				Расх = Расх + РасходыНедели(Стр.ЗаНеделю, В, Ложь, Т_);
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(Новый Структура("Название, Выездов, Расх, Текущая",
			"Лимит " + Руб(Л) + ?(Л = Лимит, "  (лимит расчёта)", ""), Выездов, Расх, Ложь));
	КонецЦикла;
	Для Каждого С_ Из Строки Цикл
		Док.Область(Н1, 1, Н1, 2).Объединить();
		Док.Область(Н1, 1).Текст = С_.Название;
		Для Гр = 0 По 1 Цикл
			Мн = ?(Гр = 0, 1, Недель);
			К0 = ?(Гр = 0, 3, 7);
			Док.Область(Н1, К0).Текст = Руб(С_.Выездов * Мн);
			Док.Область(Н1, К0 + 2).Текст = Руб(С_.Расх * Мн);
			Если С_.Текущая Тогда
				Док.Область(Н1, К0 + 1).Текст = "-";
				Док.Область(Н1, К0 + 3).Текст = "-";
			Иначе
				ДВ = (С_.Выездов - ВыездовТек) * Мн;
				Д_ = (С_.Расх - РасхТек) * Мн;
				Док.Область(Н1, К0 + 1).Текст = ?(ДВ > 0, "+", "") + Руб(ДВ);
				Док.Область(Н1, К0 + 3).Текст = ?(Д_ > 0, "+", "") + Руб(Д_);
				Док.Область(Н1, К0 + 1).ЦветФона = ?(ДВ < 0, ФонЗелёный, ?(ДВ > 0, ФонКрасный, Белый));
				Док.Область(Н1, К0 + 3).ЦветФона = ?(Д_ < 0, ФонЗелёный, ?(Д_ > 0, ФонКрасный, Белый));
			КонецЕсли;
		КонецЦикла;
		Для к = 3 По 10 Цикл
			Док.Область(Н1, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		КонецЦикла;
		Если С_.Текущая Тогда
			Док.Область(Н1, 1, Н1, 10).ЦветФона = Новый Цвет(221, 235, 247);
			Док.Область(Н1, 1, Н1, 10).Шрифт = Новый Шрифт(Док.Область(Н1, 1).Шрифт, , , Истина);
		КонецЕсли;
		ОбвестиСтроку(Док, Н1, 10);
		Н1 = Н1 + 1;
	КонецЦикла;
	Н1 = Н1 + 1;

	// таблица по магазинам
	Заголовки = СтрРазделить("Организация|Магазин (касса)|Нал по ПКО|Среднедневной нал|Нал за 7 дней|Инк. в нед. ПЛАН|Инк. в нед. ФАКТ (график)|Отклонение|Дней с РКО|Факт по РКО в нед.|С/инк|Закрыт|Расходы за период ПЛАН|Расходы за период ФАКТ (график)|Расходы за период по РКО (факт)|Что делать", "|");
	ВывестиЗаголовкиКолонок(Док, Н1, Заголовки);
	Для к = 1 По Колонок Цикл
		Док.Область(Н1, к).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	КонецЦикла;
	Н1 = Н1 + 1;
	Номер = 0;
	Для Каждого Стр Из Т Цикл
		Номер = Номер + 1;
		Док.Область(Н1, 1).Текст = Стр.Организация;
		Док.Область(Н1, 2).Текст = Стр.Магазин;
		Док.Область(Н1, 3).Текст = Деньги(Стр.Нал);
		Док.Область(Н1, 4).Текст = Деньги(Стр.СредДн);
		Док.Область(Н1, 5).Текст = Деньги(Стр.ЗаНеделю);
		Док.Область(Н1, 6).Текст = Формат(Стр.План, "ЧН=0");
		Док.Область(Н1, 7).Текст = Формат(Стр.Факт, "ЧН=0");
		Док.Область(Н1, 8).Текст = Формат(Стр.Отклонение, "ЧН=0");
		Док.Область(Н1, 9).Текст = Формат(Стр.РКО, "ЧН=0");
		Док.Область(Н1, 10).Текст = Формат(Стр.РКОвНед, "ЧДЦ=1; ЧН=0");
		Док.Область(Н1, 11).Текст = ?(Стр.ЦО, "касса ЦО", ?(Стр.СИнк, "Да", ""));
		Док.Область(Н1, 12).Текст = ?(Стр.Закрыт, "Да", "");
		Док.Область(Н1, 13).Текст = Руб(Стр.РасхПлан * Недель);
		Док.Область(Н1, 14).Текст = Руб(Стр.РасхФакт * Недель);
		Док.Область(Н1, 15).Текст = Руб(Стр.КомРКО);

		Советы = Новый Массив;
		Если Стр.Закрыт Тогда
			Советы.Добавить("магазин закрыт - не входит в расчёт");
		ИначеЕсли Стр.ЦО Тогда
			Советы.Добавить("сдаёт наличные в кассу ЦО - в выезды и расходы банка не входит");
			Если Стр.План > Стр.Факт Тогда
				Советы.Добавить("за неделю копится больше лимита - возить в ЦО " + Стр.План + " раз(а) в неделю");
			КонецЕсли;
		ИначеЕсли Стр.СИнк Тогда
			Советы.Добавить("самоинкассация Сбер " + Руб(Стр.РасхСбер) + " ₽/нед.");
			Если Стр.РасхРСХ < Стр.РасхСбер Тогда
				Советы.Добавить("инкассация РСХ (" + Макс(Стр.План, 1) + " р/нед.) дешевле на " + Руб(Стр.РасхСбер - Стр.РасхРСХ) + " ₽/нед.");
			КонецЕсли;
			Если Стр.План > 1 Тогда
				Советы.Добавить("нал за неделю больше лимита - сдавать " + Стр.План + " раз(а) в неделю");
			КонецЕсли;
		ИначеЕсли Стр.Нал = 0 Тогда
			Советы.Добавить("нет ПКО за период - проверьте кассу в графике");
		Иначе
			Если Стр.Отклонение > 0 Тогда
				Советы.Добавить("добавить " + Стр.Отклонение + " выезд(а) в неделю: при текущем графике в кассе копится больше лимита (+"
					+ Руб(Стр.РасхПлан - Стр.РасхФакт) + " ₽/нед.)");
			ИначеЕсли Стр.Отклонение < 0 Тогда
				Советы.Добавить("можно убрать " + (-Стр.Отклонение) + " выезд(а) в неделю, экономия " + Руб(Стр.РасхФакт - Стр.РасхПлан) + " ₽/нед.");
			Иначе
				Советы.Добавить("график соответствует");
			КонецЕсли;
			Если Стр.РасхСбер < Стр.РасхПлан Тогда
				Советы.Добавить("самоинкассация Сбер была бы дешевле на " + Руб(Стр.РасхПлан - Стр.РасхСбер) + " ₽/нед.");
			КонецЕсли;
		КонецЕсли;
		Док.Область(Н1, 16).Текст = СтрСоединить(Советы, "; ");

		Для к = 3 По 15 Цикл
			Док.Область(Н1, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		КонецЦикла;
		Док.Область(Н1, 11).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Док.Область(Н1, 12).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Док.Область(Н1, 16).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Док.Область(Н1, 1, Н1, Колонок).ЦветФона = ?(Номер % 2 = 1, Белый, Новый Цвет(242, 242, 242));
		Если Не Стр.ВРасчете Тогда
			ФонОткл = ФонСерый;
		ИначеЕсли Стр.Отклонение > 0 Тогда
			ФонОткл = ФонКрасный;
		ИначеЕсли Стр.Отклонение < 0 Тогда
			ФонОткл = ФонЖелтый;
		Иначе
			ФонОткл = ФонЗелёный;
		КонецЕсли;
		Док.Область(Н1, 13, Н1, 15).ЦветФона = Новый Цвет(242, 246, 252);
		Док.Область(Н1, 8).ЦветФона = ФонОткл;
		Док.Область(Н1, 16).ЦветФона = ФонОткл;
		Если Стр.ВРасчете И Стр.Отклонение > 0 Тогда
			Док.Область(Н1, 8).ЦветТекста = ТёмныйКрасный;
			Док.Область(Н1, 8).Шрифт = Новый Шрифт(Док.Область(Н1, 8).Шрифт, , , Истина);
		КонецЕсли;
		ОбвестиСтроку(Док, Н1, Колонок);
		Н1 = Н1 + 1;
	КонецЦикла;

	// итог
	Док.Область(Н1, 2).Текст = "ИТОГО";
	Док.Область(Н1, 3).Текст = Деньги(НалВсего);
	Док.Область(Н1, 6).Текст = Формат(ПланВ, "ЧН=0");
	Док.Область(Н1, 7).Текст = Формат(ФактВ, "ЧН=0");
	Док.Область(Н1, 8).Текст = Формат(ПланВ - ФактВ, "ЧН=0");
	Док.Область(Н1, 10).Текст = Формат(РКОВ, "ЧДЦ=1; ЧН=0");
	Док.Область(Н1, 13).Текст = Руб(РасхП * Недель);
	Док.Область(Н1, 14).Текст = Руб(РасхФ * Недель);
	Док.Область(Н1, 15).Текст = Руб(КомР);
	Для к = 3 По 15 Цикл
		Док.Область(Н1, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	КонецЦикла;
	Док.Область(Н1, 1, Н1, Колонок).Шрифт = Новый Шрифт(Док.Область(Н1, 2).Шрифт, , , Истина);
	Док.Область(Н1, 1, Н1, Колонок).ЦветФона = ФонШапки;
	ОбвестиСтроку(Док, Н1, Колонок);
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаГрафика

// Загрузка графика инкассации из файла Excel (xls/xlsx) или mxl.
// Ожидаемая шапка (порядок колонок любой, лишние колонки не мешают):
//   Касса | Магазин (из списка) | Пн | Вт | Ср | Чт | Пт | Сб | Вс | С/инк | Закрыт
// Значения дней и флажков: Да/Нет (также понимает Истина, 1, x, +).
// Кассы ищутся по наименованию. Строки, которые уже есть в графике, обновляются, новые добавляются.

&НаКлиенте
Процедура ЗагрузитьГрафикИзФайла(Команда)
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьГрафикПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьГрафикПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьГрафикНаСервере(Адрес, ВыбранноеИмяФайла);
КонецПроцедуры

&НаСервере
Функция ТекстЯчейки(ТД, НомСтр, НомКол)
	Возврат СокрЛП(ТД.Область(НомСтр, НомКол, НомСтр, НомКол).Текст);
КонецФункции

// "  Касса   Гермес ООО " -> "касса гермес ооо"
&НаСервере
Функция НормИмя(Знач Текст)
	Текст = НРег(СокрЛП(Текст));
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат СтрЗаменить(Текст, "ё", "е");
КонецФункции

&НаСервере
Функция ЭтоДа(Знач Текст)
	Т = НРег(СокрЛП(Текст));
	Возврат Т = "да" Или Т = "истина" Или Т = "1" Или Т = "x" Или Т = "х" Или Т = "+" Или Т = "true" Или Т = "yes" Или Т = "v" Или Т = "✓";
КонецФункции

// Соответствие "нормализованное наименование -> касса" по всем справочникам из типа измерения "Отправитель".
&НаСервере
Функция СловарьКасс(Н)
	Словарь = Новый Соответствие;
	ТипКассы = Метаданные.РегистрыНакопления[Н.Регистр].Измерения.Отправитель.Тип;
	Для Каждого Т Из ТипКассы.Типы() Цикл
		МД = Метаданные.НайтиПоТипу(Т);
		Если МД = Неопределено Или Не Метаданные.Справочники.Содержит(МД) Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	С.Ссылка КАК Ссылка,
		|	С.Наименование КАК Наименование,
		|	С.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник." + МД.Имя + " КАК С
		|УПОРЯДОЧИТЬ ПО
		|	С.ПометкаУдаления";
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Продолжить;
		КонецПопытки;
		Пока Выборка.Следующий() Цикл
			Ключ = НормИмя(Выборка.Наименование);
			Если Словарь[Ключ] = Неопределено Тогда   // непомеченные идут первыми
				Словарь.Вставить(Ключ, Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Словарь;
КонецФункции

&НаСервере
Процедура ЗагрузитьГрафикНаСервере(Адрес, ИмяФайла)

	Н = Настройки();
	ДД = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Части = СтрРазделить(ИмяФайла, ".");
	Расш = ?(Части.Количество() > 1, НРег(Части[Части.ВГраница()]), "xls");
	Если Расш <> "xls" И Расш <> "xlsx" И Расш <> "mxl" И Расш <> "ods" Тогда
		Сообщить("Нужен файл Excel (.xls, .xlsx), .ods или .mxl");
		Возврат;
	КонецЕсли;
	ИмяВрем = ПолучитьИмяВременногоФайла(Расш);
	ДД.Записать(ИмяВрем);
	ТД = Новый ТабличныйДокумент;
	Попытка
		ТД.Прочитать(ИмяВрем);
	Исключение
		Сообщить("Не удалось прочитать файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		УдалитьФайлы(ИмяВрем);
		Возврат;
	КонецПопытки;
	УдалитьФайлы(ИмяВрем);

	// поиск строки шапки: в ней есть "Касса" и "Пн"
	Колонки = Новый Соответствие;
	СтрокаШапки = 0;
	МаксСтрок = Мин(ТД.ВысотаТаблицы, 30);
	Для НомСтр = 1 По МаксСтрок Цикл
		Найдено = Новый Соответствие;
		Для НомКол = 1 По ТД.ШиринаТаблицы Цикл
			Т = НормИмя(ТекстЯчейки(ТД, НомСтр, НомКол));
			Если Т = "касса" Тогда
				Найдено.Вставить("Касса", НомКол);
			ИначеЕсли СтрНачинаетсяС(Т, "магазин") Тогда
				Найдено.Вставить("Магазин", НомКол);
			ИначеЕсли Т = "пн" Или Т = "понедельник" Тогда
				Найдено.Вставить("Пн", НомКол);
			ИначеЕсли Т = "вт" Или Т = "вторник" Тогда
				Найдено.Вставить("Вт", НомКол);
			ИначеЕсли Т = "ср" Или Т = "среда" Тогда
				Найдено.Вставить("Ср", НомКол);
			ИначеЕсли Т = "чт" Или Т = "четверг" Тогда
				Найдено.Вставить("Чт", НомКол);
			ИначеЕсли Т = "пт" Или Т = "пятница" Тогда
				Найдено.Вставить("Пт", НомКол);
			ИначеЕсли Т = "сб" Или Т = "суббота" Тогда
				Найдено.Вставить("Сб", НомКол);
			ИначеЕсли Т = "вс" Или Т = "воскресенье" Тогда
				Найдено.Вставить("Вс", НомКол);
			ИначеЕсли Т = "с/инк" Или Т = "синк" Или СтрНайти(Т, "самоинк") > 0 Тогда
				Найдено.Вставить("СИнк", НомКол);
			ИначеЕсли СтрНачинаетсяС(Т, "закрыт") Тогда
				Найдено.Вставить("Закрыт", НомКол);
			ИначеЕсли Т = "цо" Или СтрНайти(Т, "касса цо") > 0 Или СтрНайти(Т, "кассу цо") > 0 Или Т = "в цо" Тогда
				Найдено.Вставить("ЦО", НомКол);
			КонецЕсли;
		КонецЦикла;
		Если Найдено["Касса"] <> Неопределено И Найдено["Пн"] <> Неопределено Тогда
			Колонки = Найдено;
			СтрокаШапки = НомСтр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаШапки = 0 Тогда
		Сообщить("В файле не найдена шапка с колонками «Касса» и «Пн». Ожидается: Касса | Магазин | Пн ... Вс | С/инк | Закрыт | В кассу ЦО");
		Возврат;
	КонецЕсли;

	Словарь = СловарьКасс(Н);
	Есть = Новый Соответствие;
	Для Каждого Стр Из ЭтаФорма.Графики Цикл
		Если ЗначениеЗаполнено(Стр.Касса) Тогда
			Есть.Вставить(Стр.Касса, Стр);
		КонецЕсли;
	КонецЦикла;

	Поля = СтрРазделить("Пн,Вт,Ср,Чт,Пт,Сб,Вс,СИнк,Закрыт,ЦО", ",");
	Добавлено = 0; Обновлено = 0;
	НеНайдены = Новый Массив;
	Для НомСтр = СтрокаШапки + 1 По ТД.ВысотаТаблицы Цикл
		ИмяКассы = ТекстЯчейки(ТД, НомСтр, Колонки["Касса"]);
		Если ИмяКассы = "" Тогда
			Продолжить;
		КонецЕсли;
		Касса = Словарь[НормИмя(ИмяКассы)];
		Если Касса = Неопределено Тогда
			НеНайдены.Добавить(ИмяКассы);
			Продолжить;
		КонецЕсли;
		СтрГр = Есть[Касса];
		Если СтрГр = Неопределено Тогда
			СтрГр = ЭтаФорма.Графики.Добавить();
			СтрГр.Касса = Касса;
			Есть.Вставить(Касса, СтрГр);
			Добавлено = Добавлено + 1;
		Иначе
			Обновлено = Обновлено + 1;
		КонецЕсли;
		Флажки = Новый Структура;
		Для Каждого П Из Поля Цикл
			Если Колонки[П] <> Неопределено Тогда
				Флажки.Вставить(П, ЭтоДа(ТекстЯчейки(ТД, НомСтр, Колонки[П])));
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(СтрГр, Флажки);
		Если Колонки["Магазин"] <> Неопределено Тогда
			Маг = ТекстЯчейки(ТД, НомСтр, Колонки["Магазин"]);
			Если Маг <> "" Тогда
				СтрГр.Магазин = Маг;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЭтаФорма.Графики.Сортировать("Касса");
	СохранитьГрафикиНаСервере();

	Сообщить("График загружен и сохранён: добавлено касс " + Добавлено + ", обновлено " + Обновлено
		+ ?(НеНайдены.Количество() > 0, ", не найдено в справочнике " + НеНайдены.Количество(), "") + ".");
	Для Каждого Имя Из НеНайдены Цикл
		Сообщить("Касса не найдена по наименованию: " + Имя);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ПроверкаКассовыхКниг

// Проверка: за каждый день, когда по кассе были проведены ПКО или РКО, должен быть сформирован лист кассовой книги.
// Документ кассовой книги ищется автоматически (в имени или представлении есть «кассов» и «книг»),
// либо задаётся в Настройки(): ДокКК, РеквКассаКК, РеквДатаКК.

&НаКлиенте
Процедура ПроверитьКассовыеКниги(Команда)
	Если ЭтаФорма.ДатаНач > ЭтаФорма.ДатаКон Тогда
		Сообщить("Начало периода позже конца");
		Возврат;
	КонецЕсли;
	ПроверитьКассовыеКнигиНаСервере();
КонецПроцедуры

// Описание документа кассовой книги: Структура(Имя, Представление, РеквКасса, РеквОрг, РеквДата) или Неопределено.
&НаСервере
Функция ОписаниеДокументаКК(Н, ТипКассы, Кандидаты)
	МД = Неопределено;
	Если ЗначениеЗаполнено(Н.ДокКК) Тогда
		МД = Метаданные.Документы.Найти(Н.ДокКК);
		Если МД = Неопределено Тогда
			Сообщить("Документ кассовой книги не найден: " + Н.ДокКК + " (исправьте ДокКК в Настройки())");
		КонецЕсли;
	КонецЕсли;
	Если МД = Неопределено Тогда
		Для Каждого Д Из Метаданные.Документы Цикл
			Т = НРег(Д.Имя + " " + Д.Синоним);
			Если СтрНайти(Т, "касс") > 0 Тогда
				Кандидаты.Добавить(Д.Синоним + " (" + Д.Имя + ")");
			КонецЕсли;
			Если МД = Неопределено И СтрНайти(Т, "кассов") > 0 И СтрНайти(Т, "книг") > 0 Тогда
				МД = Д;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если МД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	О = Новый Структура("Имя, Представление, РеквКасса, РеквОрг, РеквДата", МД.Имя, МД.Синоним, "", "", "Дата");
	// касса
	Если ЗначениеЗаполнено(Н.РеквКассаКК) Тогда
		О.РеквКасса = Н.РеквКассаКК;
	Иначе
		Для Каждого Р Из МД.Реквизиты Цикл
			Для Каждого ТК Из ТипКассы.Типы() Цикл
				Если Р.Тип.СодержитТип(ТК) И Р.Тип.Типы().Количество() = 1 Тогда
					О.РеквКасса = Р.Имя;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если О.РеквКасса <> "" Тогда Прервать; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// организация (если касса в документе не указана - книга ведётся по организации)
	Если МД.Реквизиты.Найти("Организация") <> Неопределено Тогда
		О.РеквОрг = "Организация";
	КонецЕсли;
	// дата листа
	Если ЗначениеЗаполнено(Н.РеквДатаКК) Тогда
		О.РеквДата = Н.РеквДатаКК;
	Иначе
		Для Каждого Р Из МД.Реквизиты Цикл
			ИмяН = НРег(Р.Имя);
			Если Р.Тип.СодержитТип(Тип("Дата")) И (СтрНайти(ИмяН, "лист") > 0 Или СтрНайти(ИмяН, "день") > 0
				Или ИмяН = "датакниги" Или ИмяН = "датакассовойкниги") Тогда
				О.РеквДата = Р.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат О;
КонецФункции

&НаСервере
Процедура ПроверитьКассовыеКнигиНаСервере()

	Н = Настройки();
	Док = ЭтаФорма.РезультатКК;
	Док.Очистить();
	НастроитьПечать(Док);
	НачП = НачалоДня(ЭтаФорма.ДатаНач);
	КонП = КонецДня(ЭтаФорма.ДатаКон);
	ТипКассы = Метаданные.РегистрыНакопления[Н.Регистр].Измерения.Отправитель.Тип;

	Кассы = Новый Массив;
	Магазины = Новый Соответствие;
	Для Каждого С Из ЭтаФорма.Графики Цикл
		Если ЗначениеЗаполнено(С.Касса) И Не С.Закрыт И Кассы.Найти(С.Касса) = Неопределено Тогда
			Кассы.Добавить(С.Касса);
			Магазины.Вставить(С.Касса, ?(ЗначениеЗаполнено(С.Магазин), С.Магазин, ""));
		КонецЕсли;
	КонецЦикла;
	Если Кассы.Количество() = 0 Тогда
		Сообщить("Список касс пуст: заполните вкладку «Графики инкассации» и сохраните графики");
		Возврат;
	КонецЕсли;

	Кандидаты = Новый Массив;
	ОК = ОписаниеДокументаКК(Н, ТипКассы, Кандидаты);
	Если ОК = Неопределено Тогда
		Док.Область(1, 1).Текст = "Документ кассовой книги в конфигурации не найден. Укажите его имя в Настройки() (ДокКК).";
		Док.Область(2, 1).Текст = "Документы, в названии которых есть «касс»: " + СтрСоединить(Кандидаты, "; ");
		Возврат;
	КонецЕсли;
	Если ОК.РеквКасса = "" И ОК.РеквОрг = "" Тогда
		Док.Область(1, 1).Текст = "В документе «" + ОК.Представление + "» не найден реквизит с кассой или организацией. Укажите РеквКассаКК в Настройки().";
		Возврат;
	КонецЕсли;
	ПоОрганизации = (ОК.РеквКасса = "");

	// дни с операциями по кассам
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Касса КАК Касса,
	|	НАЧАЛОПЕРИОДА(П.Дата, ДЕНЬ) КАК День,
	|	1 КАК ПКО,
	|	0 КАК РКО,
	|	П.СуммаДокумента КАК Приход,
	|	0 КАК Расход
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.[ДокПКО] КАК П
	|ГДЕ
	|	П.Проведен
	|	И П.Дата МЕЖДУ &Нач И &Кон
	|	И П.Касса В (&Кассы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Р.Касса,
	|	НАЧАЛОПЕРИОДА(Р.Дата, ДЕНЬ),
	|	0,
	|	1,
	|	0,
	|	Р.СуммаДокумента
	|ИЗ
	|	Документ.[ДокРКО] КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Дата МЕЖДУ &Нач И &Кон
	|	И Р.Касса В (&Кассы)
	|;
	|
	|ВЫБРАТЬ
	|	ВТ.Касса КАК Касса,
	|	ВТ.День КАК День,
	|	СУММА(ВТ.ПКО) КАК ПКО,
	|	СУММА(ВТ.РКО) КАК РКО,
	|	СУММА(ВТ.Приход) КАК Приход,
	|	СУММА(ВТ.Расход) КАК Расход
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Касса,
	|	ВТ.День
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ДокПКО]", Н.ДокПКО);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ДокРКО]", Н.ДокРКО);
	Запрос.УстановитьПараметр("Нач", НачП);
	Запрос.УстановитьПараметр("Кон", КонП);
	Запрос.УстановитьПараметр("Кассы", Кассы);
	Попытка
		Операции = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить("Не удалось прочитать ПКО/РКО: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// листы кассовой книги: ключ (касса или организация) + день
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.[Ключ] КАК Ключ,
	|	НАЧАЛОПЕРИОДА(К.[Дата], ДЕНЬ) КАК День
	|ИЗ
	|	Документ.[Док] КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|	И К.[Дата] МЕЖДУ &Нач И &Кон";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Док]", ОК.Имя);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Ключ]", ?(ПоОрганизации, ОК.РеквОрг, ОК.РеквКасса));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[Дата]", ОК.РеквДата);
	Запрос.УстановитьПараметр("Нач", НачП);
	Запрос.УстановитьПараметр("Кон", КонП);
	Листы = Новый Соответствие;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Ключ) И ЗначениеЗаполнено(Выборка.День) Тогда
				Листы.Вставить(Строка(Выборка.Ключ.УникальныйИдентификатор()) + "|" + Формат(Выборка.День, "ДФ=yyyyMMdd"), Истина);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Не удалось прочитать документ «" + ОК.Представление + "»: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Проверьте ДокКК / РеквКассаКК / РеквДатаКК в Настройки().");
		Возврат;
	КонецПопытки;

	// сверка
	Итоги = Новый Соответствие;   // касса -> Структура
	Пропуски = Новый Массив;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	СрокКК = Н.СрокКК;
	Для Каждого Оп Из Операции Цикл
		Если ПоОрганизации Тогда
			Попытка
				КлючСсылка = Оп.Касса.Владелец;
			Исключение
				КлючСсылка = Неопределено;
			КонецПопытки;
		Иначе
			КлючСсылка = Оп.Касса;
		КонецЕсли;
		Есть = Ложь;
		Если КлючСсылка <> Неопределено И ЗначениеЗаполнено(КлючСсылка) Тогда
			Есть = Листы[Строка(КлючСсылка.УникальныйИдентификатор()) + "|" + Формат(Оп.День, "ДФ=yyyyMMdd")] <> Неопределено;
		КонецЕсли;
		// лист ещё не просрочен (в т.ч. сегодняшний день) - не проверяем
		Если Не Есть И Окр((Сегодня - Оп.День) / 86400, 0) < СрокКК Тогда
			Продолжить;
		КонецЕсли;
		И_ = Итоги[Оп.Касса];
		Если И_ = Неопределено Тогда
			И_ = Новый Структура("Дней, Листов, Нет, Ждут", 0, 0, Новый Массив, Новый Массив);
			Итоги.Вставить(Оп.Касса, И_);
		КонецЕсли;
		И_.Дней = И_.Дней + 1;
		Если Есть Тогда
			И_.Листов = И_.Листов + 1;
		Иначе
			Прошло = Окр((Сегодня - Оп.День) / 86400, 0);
			Если Прошло >= СрокКК Тогда
				И_.Нет.Добавить(Формат(Оп.День, "ДФ=dd.MM"));
			Иначе
				И_.Ждут.Добавить(Формат(Оп.День, "ДФ=dd.MM"));
			КонецЕсли;
			Пропуски.Добавить(Новый Структура("Касса, День, ПКО, РКО, Приход, Расход, Прошло, Ошибка",
				Оп.Касса, Оп.День, Оп.ПКО, Оп.РКО, Оп.Приход, Оп.Расход, Прошло, Прошло >= СрокКК));
		КонецЕсли;
	КонецЦикла;

	// вывод
	Белый = Новый Цвет(255, 255, 255);
	ФонКрасный = Новый Цвет(255, 199, 206);
	ФонЗелёный = Новый Цвет(226, 239, 218);
	ФонСерый   = Новый Цвет(237, 237, 237);
	ТёмныйКрасный = Новый Цвет(156, 0, 6);
	Колонок = 6;
	Ширины = СтрРазделить("45,16,14,14,16,60,12,12", ",");
	Для к = 1 По 8 Цикл
		Док.Область(1, к, 1, к).ШиринаКолонки = Число(Ширины[к - 1]);
	КонецЦикла;
	Н1 = 1;
	Док.Область(Н1, 1).Текст = "Проверка кассовых книг за период " + Формат(ЭтаФорма.ДатаНач, "ДЛФ=D") + " - " + Формат(ЭтаФорма.ДатаКон, "ДЛФ=D");
	Док.Область(Н1, 1).Шрифт = Новый Шрифт(Док.Область(Н1, 1).Шрифт, , 14, Истина);
	Н1 = Н1 + 1;
	Док.Область(Н1, 1, Н1, Колонок).Объединить();
	Док.Область(Н1, 1).Текст = "Документ: «" + ОК.Представление + "» (" + ОК.Имя + "), лист определяется по "
		+ ?(ПоОрганизации, "организации кассы (реквизит " + ОК.РеквОрг + ")", "кассе (реквизит " + ОК.РеквКасса + ")")
		+ " и дате (реквизит " + ОК.РеквДата + "). Проверяются дни, когда по кассе были проведены ПКО или РКО. Закрытые магазины не проверяются."
		+ " ОШИБКА - листа нет " + СрокКК + " дн. и дольше; дни, по которым " + СрокКК + " дн. ещё не прошло, не проверяются.";
	Док.Область(Н1, 1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Н1 = Н1 + 1;
	ВсегоДней = 0; ВсегоНет = 0; КассСПропусками = 0; ВсегоЖдут = 0;
	Для Каждого КЗ Из Итоги Цикл
		ВсегоДней = ВсегоДней + КЗ.Значение.Дней;
		ВсегоНет = ВсегоНет + КЗ.Значение.Нет.Количество();
		ВсегоЖдут = ВсегоЖдут + КЗ.Значение.Ждут.Количество();
		Если КЗ.Значение.Нет.Количество() > 0 Тогда КассСПропусками = КассСПропусками + 1; КонецЕсли;
	КонецЦикла;
	Док.Область(Н1, 1, Н1, Колонок).Объединить();
	Док.Область(Н1, 1).Текст = "ОШИБКИ (нет листа " + СрокКК + "+ дн.): " + ВсегоНет + " дн. по " + КассСПропусками + " кассам     проверено дней с операциями: " + ВсегоДней
		+ "     касс в проверке: " + Кассы.Количество();
	Док.Область(Н1, 1, Н1, Колонок).ЦветФона = ?(ВсегоНет > 0, ФонКрасный, ФонЗелёный);
	Док.Область(Н1, 1).Шрифт = Новый Шрифт(Док.Область(Н1, 1).Шрифт, , 11, Истина);
	Если ВсегоНет > 0 Тогда
		Док.Область(Н1, 1).ЦветТекста = ТёмныйКрасный;
	КонецЕсли;
	Н1 = Н1 + 2;

	// сводка по кассам
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Касса"); Т.Колонки.Добавить("Имя"); Т.Колонки.Добавить("Магазин");
	Т.Колонки.Добавить("Дней"); Т.Колонки.Добавить("Листов"); Т.Колонки.Добавить("НетЧисло"); Т.Колонки.Добавить("Нет"); Т.Колонки.Добавить("Ждут");
	Для Каждого К Из Кассы Цикл
		Стр = Т.Добавить();
		Стр.Касса = К;
		Стр.Имя = Строка(К);
		Стр.Магазин = Магазины[К];
		И_ = Итоги[К];
		Стр.Дней = ?(И_ = Неопределено, 0, И_.Дней);
		Стр.Листов = ?(И_ = Неопределено, 0, И_.Листов);
		Стр.НетЧисло = ?(И_ = Неопределено, 0, И_.Нет.Количество());
		Стр.Нет = ?(И_ = Неопределено, "", СтрСоединить(И_.Нет, ", "));
		Стр.Ждут = ?(И_ = Неопределено, "", СтрСоединить(И_.Ждут, ", "));
	КонецЦикла;
	Т.Сортировать("НетЧисло Убыв, Имя");

	Заголовки = СтрРазделить("Касса|Магазин|Дней с ПКО/РКО|Листов есть|ОШИБКА: нет листа " + СрокКК + "+ дн.|Дни без листа", "|");
	ВывестиЗаголовкиКолонок(Док, Н1, Заголовки);
	Н1 = Н1 + 1;
	Номер = 0;
	Для Каждого Стр Из Т Цикл
		Номер = Номер + 1;
		Док.Область(Н1, 1).Текст = Стр.Имя;
		Док.Область(Н1, 2).Текст = Стр.Магазин;
		Док.Область(Н1, 3).Текст = Формат(Стр.Дней, "ЧН=0");
		Док.Область(Н1, 4).Текст = Формат(Стр.Листов, "ЧН=0");
		Док.Область(Н1, 5).Текст = Формат(Стр.НетЧисло, "ЧН=0");
		Текст6 = ?(Стр.Нет = "", "", "ошибка: " + Стр.Нет);
		Если Стр.Ждут <> "" Тогда
			Текст6 = Текст6 + ?(Текст6 = "", "", "; ") + "в сроке: " + Стр.Ждут;
		КонецЕсли;
		Док.Область(Н1, 6).Текст = ?(Стр.Дней = 0, "нет ПКО/РКО за период", Текст6);
		Для к = 3 По 5 Цикл
			Док.Область(Н1, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		КонецЦикла;
		Док.Область(Н1, 6).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Док.Область(Н1, 1, Н1, Колонок).ЦветФона = ?(Номер % 2 = 1, Белый, Новый Цвет(242, 242, 242));
		Если Стр.НетЧисло > 0 Тогда
			Док.Область(Н1, 5).ЦветФона = ФонКрасный;
			Док.Область(Н1, 6).ЦветФона = ФонКрасный;
			Док.Область(Н1, 5).ЦветТекста = ТёмныйКрасный;
		ИначеЕсли Стр.Ждут <> "" Тогда
			Док.Область(Н1, 6).ЦветФона = Новый Цвет(255, 235, 156);
		ИначеЕсли Стр.Дней = 0 Тогда
			Док.Область(Н1, 6).ЦветФона = ФонСерый;
		Иначе
			Док.Область(Н1, 5).ЦветФона = ФонЗелёный;
		КонецЕсли;
		ОбвестиСтроку(Док, Н1, Колонок);
		Н1 = Н1 + 1;
	КонецЦикла;
	Н1 = Н1 + 1;

	// подробно: дни без листа
	Если Пропуски.Количество() > 0 Тогда
		ТП = Новый ТаблицаЗначений;
		Для Каждого ИмяК Из СтрРазделить("Касса,День,ПКО,РКО,Приход,Расход,Прошло,Ошибка,Имя", ",") Цикл
			ТП.Колонки.Добавить(ИмяК);
		КонецЦикла;
		Для Каждого П Из Пропуски Цикл
			С_ = ТП.Добавить();
			ЗаполнитьЗначенияСвойств(С_, П);
			С_.Имя = Строка(П.Касса);
		КонецЦикла;
		ТП.Сортировать("Ошибка Убыв, Имя, День");
		Пропуски = ТП;
		Док.Область(Н1, 1, Н1, 8).Объединить();
		Док.Область(Н1, 1).Текст = "Ошибки: дни без листа кассовой книги " + СрокКК + "+ дн.  (" + ВсегоНет + ")";
		Док.Область(Н1, 1, Н1, Колонок).ЦветФона = Новый Цвет(192, 0, 0);
		Док.Область(Н1, 1).ЦветТекста = Белый;
		Док.Область(Н1, 1).Шрифт = Новый Шрифт(Док.Область(Н1, 1).Шрифт, , 12, Истина);
		Н1 = Н1 + 1;
		ВывестиЗаголовкиКолонок(Док, Н1, СтрРазделить("Касса|Дата|ПКО, шт.|РКО, шт.|Приход|Расход|Дней без листа|Статус", "|"));
		Н1 = Н1 + 1;
		Номер = 0;
		Для Каждого Оп Из Пропуски Цикл
			Номер = Номер + 1;
			Док.Область(Н1, 1).Текст = Строка(Оп.Касса);
			Док.Область(Н1, 2).Текст = Формат(Оп.День, "ДФ=dd.MM.yyyy");
			Док.Область(Н1, 3).Текст = Формат(Оп.ПКО, "ЧН=0");
			Док.Область(Н1, 4).Текст = Формат(Оп.РКО, "ЧН=0");
			Док.Область(Н1, 5).Текст = Деньги(Оп.Приход);
			Док.Область(Н1, 6).Текст = Деньги(Оп.Расход);
			Док.Область(Н1, 7).Текст = Формат(Оп.Прошло, "ЧН=0");
			Док.Область(Н1, 8).Текст = ?(Оп.Ошибка, "ОШИБКА", "в сроке");
			Для к = 3 По 7 Цикл
				Док.Область(Н1, к).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			КонецЦикла;
			Док.Область(Н1, 1, Н1, 8).ЦветФона = ?(Оп.Ошибка, ФонКрасный, Новый Цвет(255, 235, 156));
			Если Оп.Ошибка Тогда
				Док.Область(Н1, 8).ЦветТекста = ТёмныйКрасный;
				Док.Область(Н1, 8).Шрифт = Новый Шрифт(Док.Область(Н1, 8).Шрифт, , , Истина);
			КонецЕсли;
			ОбвестиСтроку(Док, Н1, 8);
			Н1 = Н1 + 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
