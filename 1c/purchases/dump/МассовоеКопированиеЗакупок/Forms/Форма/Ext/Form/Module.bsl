&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КонецПериода = НачалоМесяца(ТекущаяДата()) - 1;
	НачалоПериода = НачалоМесяца(КонецПериода);
	НоваяДата = КонецМесяца(ТекущаяДата());
	Проводить = Истина;
	ТолькоБезНДС = Истина;
	ТолькоЗакупкаУПоставщика = Истина;
	ОчищатьВходящийНомер = Ложь;
	// Колонки только для просмотра, иначе двойной щелчок включает редактирование вместо открытия документа.
	Для Каждого Имя Из СтрРазделить("Документ,Организация,Контрагент,СтатьяРасходов,Сумма,НДС,Создан,Результат", ",") Цикл
		Элементы["Источники" + Имя].ТолькоПросмотр = Истина;
	КонецЦикла;
	ВидДокумента = "Приобретение услуг и прочих активов";
	ЗаполнитьСпискиВыбора();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()

	Запрос = Новый Запрос("ВЫБРАТЬ О.Наименование КАК Наименование ИЗ Справочник.Организации КАК О
		|ГДЕ НЕ О.ПометкаУдаления УПОРЯДОЧИТЬ ПО О.Наименование");
	Элементы.Организация.СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.Организация.СписокВыбора.Добавить(Выборка.Наименование);
	КонецЦикла;
	Элементы.Организация.КнопкаВыпадающегоСписка = Истина;

	Элементы.ВидДокумента.СписокВыбора.Очистить();
	Элементы.ВидДокумента.СписокВыбора.Добавить("Приобретение услуг и прочих активов");
	Элементы.ВидДокумента.СписокВыбора.Добавить("Приобретение товаров и услуг");
	Элементы.ВидДокумента.КнопкаВыпадающегоСписка = Истина;
	Элементы.ВидДокумента.РежимВыбораИзСписка = Истина;

	// Статьи расходов (если справочника с таким именем нет — список просто останется пустым).
	Элементы.СтатьяРасходов.СписокВыбора.Очистить();
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ С.Наименование КАК Наименование ИЗ ПланВидовХарактеристик.СтатьиРасходов КАК С
			|ГДЕ НЕ С.ПометкаУдаления И НЕ С.ЭтоГруппа УПОРЯДОЧИТЬ ПО С.Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Элементы.СтатьяРасходов.СписокВыбора.Добавить(Выборка.Наименование);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Элементы.СтатьяРасходов.КнопкаВыпадающегоСписка = Истина;

	// Поставщики, по которым уже есть проведённые приобретения.
	Запрос = Новый Запрос("ВЫБРАТЬ Р.Контрагент.Наименование КАК Наименование
		|ИЗ Документ.ПриобретениеУслугПрочихАктивов КАК Р
		|ГДЕ Р.Проведен
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ Р2.Контрагент.Наименование
		|ИЗ Документ.ПриобретениеТоваровУслуг КАК Р2
		|ГДЕ Р2.Проведен
		|УПОРЯДОЧИТЬ ПО Наименование");
	Элементы.Контрагент.СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
			Элементы.Контрагент.СписокВыбора.Добавить(Выборка.Наименование);
		КонецЕсли;
	КонецЦикла;
	Элементы.Контрагент.КнопкаВыпадающегоСписка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Таблица = РеквизитФормыВЗначение("Объект").ПолучитьИсточники(НачалоПериода, КонецПериода, Организация, Контрагент,
		ВидДокумента, ТолькоБезНДС, ТолькоЗакупкаУПоставщика, СтатьяРасходов);
	Источники.Очистить();
	Для Каждого Стр Из Таблица Цикл
		Новая = Источники.Добавить();
		Новая.Выбран = Истина;
		Новая.Документ = Строка(Стр.Документ);
		Новая.ДокументСтрока = ЗначениеВСтрокуВнутр(Стр.Документ);
		Новая.Организация = Строка(Стр.Организация);
		Новая.Контрагент = Строка(Стр.Контрагент);
		Новая.Сумма = Стр.Сумма;
		Новая.НДС = Стр.НДС;
		Новая.СтатьяРасходов = Стр.СтатьяРасходов;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	Если НЕ ЗначениеЗаполнено(НоваяДата) Тогда
		Сообщить("Укажите дату новых документов.");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьДокументыЗавершение", ЭтотОбъект),
		"Создать документы на " + Формат(НоваяДата, "ДЛФ=D") + "?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыЗавершение(Ответ, Параметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СоздатьНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Стр Из Источники Цикл
		Если НЕ Стр.Выбран ИЛИ НЕ ПустаяСтрока(Стр.Создан) Тогда
			Продолжить;
		КонецЕсли;
		Рез = Обработка.СоздатьКопию(Стр.ДокументСтрока, НоваяДата, Проводить, ОчищатьВходящийНомер, Стр.НоваяСумма);
		Если Рез.Успех Тогда
			Стр.Создан = Строка(Рез.Документ);
			Стр.СозданСтрока = ЗначениеВСтрокуВнутр(Рез.Документ);
			Стр.Результат = "Создан и " + ?(Проводить, "проведён", "записан");
		Иначе
			Стр.Результат = "Ошибка: " + Рез.Ошибка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из Источники Цикл
		Стр.Выбран = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Стр Из Источники Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	Данные = Элементы.Источники.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Сообщить("Выберите строку в таблице.");
		Возврат;
	КонецЕсли;
	ОткрытьПоКолонке(Данные, Элементы.Источники.ТекущийЭлемент.Имя);
КонецПроцедуры

// Двойной щелчок по строке: открывает документ из той колонки, по которой щёлкнули.
&НаКлиенте
Процедура ИсточникиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	// Редактируемые колонки («Выбран», «Новая сумма») — обычный ввод, документ не открываем.
	Если Поле.Имя = "ИсточникиНоваяСумма" ИЛИ Поле.Имя = "ИсточникиВыбран" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Данные = Источники.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Данные <> Неопределено Тогда
		ОткрытьПоКолонке(Данные, Поле.Имя);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоКолонке(Данные, Колонка)
	Если Колонка = "ИсточникиСоздан" Тогда
		Значение = Данные.СозданСтрока;
	Иначе
		Значение = Данные.ДокументСтрока;
	КонецЕсли;
	Если ПустаяСтрока(Значение) Тогда
		Сообщить("В этой колонке нет документа.");
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, СсылкаИзСтроки(Значение));
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкаИзСтроки(Строка)
	Возврат ЗначениеИзСтрокиВнутр(Строка);
КонецФункции
