// Внешняя обработка «Массовое копирование закупок» (1С:КА 2.5).
// Документы: ПриобретениеУслугПрочихАктивов, ПриобретениеТоваровУслуг. Счета-фактуры не создаются.

Функция ПолучитьИсточники(НачалоПериода, КонецПериода, Организация = "", Контрагент = "", ВидДокумента = "",
	ТолькоБезНДС = Истина, ТолькоЗакупкаУПоставщика = Истина) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация", "%" + СокрЛП(Организация) + "%");
	Запрос.УстановитьПараметр("Контрагент", "%" + СокрЛП(Контрагент) + "%");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Документ,
	|	Р.Организация КАК Организация,
	|	Р.Контрагент КАК Контрагент,
	|	Р.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ИмяДокумента КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Дата МЕЖДУ &Начало И &Конец
	|	&УсловиеОрганизации
	|	&УсловиеКонтрагента
	|	&УсловиеОперации
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р.Контрагент,
	|	Р.Дата";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации",
		?(ПустаяСтрока(Организация), "", "И Р.Организация.Наименование ПОДОБНО &Организация"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагента",
		?(ПустаяСтрока(Контрагент), "", "И Р.Контрагент.Наименование ПОДОБНО &Контрагент"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОперации",
		?(ТолькоЗакупкаУПоставщика,
			"И Р.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика)", ""));
	ИмяДокумента = ?(ВидДокумента = "Приобретение товаров и услуг", "ПриобретениеТоваровУслуг", "ПриобретениеУслугПрочихАктивов");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ИмяДокумента", "Документ." + ИмяДокумента);

	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("НДС", Новый ОписаниеТипов("Число"));

	// НДС считаем по самим документам: любое поле СуммаНДС в шапке и табличных частях.
	Удалить = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Стр.НДС = СуммаНДСДокумента(Стр.Документ);
		Если ТолькоБезНДС И Стр.НДС <> 0 Тогда
			Удалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удалить Цикл
		Таблица.Удалить(Стр);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СуммаНДСДокумента(Ссылка)

	Итог = 0;
	Объект = Ссылка.ПолучитьОбъект();
	Описание = Объект.Метаданные();
	Если Описание.Реквизиты.Найти("СуммаНДС") <> Неопределено Тогда
		Итог = Итог + ?(ТипЗнч(Объект.СуммаНДС) = Тип("Число"), Объект.СуммаНДС, 0);
	КонецЕсли;
	Для Каждого ТабЧасть Из Описание.ТабличныеЧасти Цикл
		Если ТабЧасть.Реквизиты.Найти("СуммаНДС") <> Неопределено Тогда
			Итог = Итог + Объект[ТабЧасть.Имя].Итог("СуммаНДС");
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Копирует документ-источник на НоваяДата. Возвращает структуру: Успех, Документ, Ошибка.
Функция СоздатьКопию(ИсточникСтрока, НоваяДата, Проводить = Истина, ОчищатьВходящийНомер = Ложь) Экспорт

	Результат = Новый Структура("Успех, Документ, Ошибка", Ложь, Неопределено, "");

	НачатьТранзакцию();
	Попытка
		Источник = ЗначениеИзСтрокиВнутр(ИсточникСтрока);
		НовыйДокумент = Источник.ПолучитьОбъект().Скопировать();
		НовыйДокумент.Дата = НоваяДата;
		НовыйДокумент.Номер = "";
		НовыйДокумент.УстановитьНовыйНомер();

		// Номер и дата документа поставщика за новый период другие.
		Если ОчищатьВходящийНомер Тогда
			Реквизиты = НовыйДокумент.Метаданные().Реквизиты;
			Для Каждого Имя Из СтрРазделить("НомерВходящегоДокумента,ДатаВходящегоДокумента", ",") Цикл
				Реквизит = Реквизиты.Найти(Имя);
				Если Реквизит <> Неопределено Тогда
					НовыйДокумент[Имя] = Реквизит.Тип.ПривестиЗначение(Неопределено);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если НЕ НовыйДокумент.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "Не пройдена проверка заполнения: " + СообщенияПользователяТекстом();
		КонецЕсли;

		Если Проводить Тогда
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
		Результат.Документ = НовыйДокумент.Ссылка;
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция СообщенияПользователяТекстом()
	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Сообщение.Текст + "; ";
	КонецЦикла;
	Возврат Текст;
КонецФункции
