// Внешняя обработка «Массовое копирование закупок» (1С:КА 2.5).
// Документы: ПриобретениеУслугПрочихАктивов, ПриобретениеТоваровУслуг. Счета-фактуры не создаются.

Функция ПолучитьИсточники(НачалоПериода, КонецПериода, Организация = "", Контрагент = "", ВидДокумента = "",
	ТолькоБезНДС = Истина, ТолькоЗакупкаУПоставщика = Истина, СтатьяРасходов = "") Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация", "%" + СокрЛП(Организация) + "%");
	Запрос.УстановитьПараметр("Контрагент", "%" + СокрЛП(Контрагент) + "%");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Документ,
	|	Р.Организация КАК Организация,
	|	Р.Контрагент КАК Контрагент,
	|	Р.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ИмяДокумента КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Дата МЕЖДУ &Начало И &Конец
	|	&УсловиеОрганизации
	|	&УсловиеКонтрагента
	|	&УсловиеОперации
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р.Контрагент,
	|	Р.Дата";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации",
		?(ПустаяСтрока(Организация), "", "И Р.Организация.Наименование ПОДОБНО &Организация"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагента",
		?(ПустаяСтрока(Контрагент), "", "И Р.Контрагент.Наименование ПОДОБНО &Контрагент"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОперации",
		?(ТолькоЗакупкаУПоставщика,
			"И Р.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика)", ""));
	ИмяДокумента = ?(ВидДокумента = "Приобретение товаров и услуг", "ПриобретениеТоваровУслуг", "ПриобретениеУслугПрочихАктивов");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ИмяДокумента", "Документ." + ИмяДокумента);

	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("НДС", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("Строка"));

	// НДС и статьи расходов берём из самих документов: поля СуммаНДС и СтатьяРасходов в шапке и табличных частях.
	Удалить = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Объект = Стр.Документ.ПолучитьОбъект();
		Стр.НДС = СуммаНДСДокумента(Объект);
		Стр.СтатьяРасходов = СтатьиРасходовДокумента(Объект);
		Если ТолькоБезНДС И Стр.НДС <> 0 Тогда
			Удалить.Добавить(Стр);
		ИначеЕсли НЕ ПустаяСтрока(СтатьяРасходов)
			И СтрНайти(НРег(Стр.СтатьяРасходов), НРег(СокрЛП(СтатьяРасходов))) = 0 Тогда
			Удалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удалить Цикл
		Таблица.Удалить(Стр);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СуммаНДСДокумента(Объект)

	Итог = 0;
	Описание = Объект.Метаданные();
	Если Описание.Реквизиты.Найти("СуммаНДС") <> Неопределено Тогда
		Итог = Итог + ?(ТипЗнч(Объект.СуммаНДС) = Тип("Число"), Объект.СуммаНДС, 0);
	КонецЕсли;
	Для Каждого ТабЧасть Из Описание.ТабличныеЧасти Цикл
		Если ТабЧасть.Реквизиты.Найти("СуммаНДС") <> Неопределено Тогда
			Итог = Итог + Объект[ТабЧасть.Имя].Итог("СуммаНДС");
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция СтатьиРасходовДокумента(Объект)

	Статьи = Новый Массив;
	Описание = Объект.Метаданные();
	Если Описание.Реквизиты.Найти("СтатьяРасходов") <> Неопределено И ЗначениеЗаполнено(Объект.СтатьяРасходов) Тогда
		Статьи.Добавить(Строка(Объект.СтатьяРасходов));
	КонецЕсли;
	Для Каждого ТабЧасть Из Описание.ТабличныеЧасти Цикл
		Если ТабЧасть.Реквизиты.Найти("СтатьяРасходов") <> Неопределено Тогда
			Для Каждого СтрокаТЧ Из Объект[ТабЧасть.Имя] Цикл
				Статья = Строка(СтрокаТЧ.СтатьяРасходов);
				Если НЕ ПустаяСтрока(Статья) И Статьи.Найти(Статья) = Неопределено Тогда
					Статьи.Добавить(Статья);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Статьи, "; ");

КонецФункции

// Пересчитывает суммы в строках документа так, чтобы общая сумма стала равна НоваяСумма
// (пропорционально прежним суммам; цена пересчитывается по количеству).
Процедура ПересчитатьСумму(Документ, НоваяСумма)

	Описание = Документ.Метаданные();
	Части = Новый Массив;
	Итого = 0;
	Для Каждого ТабЧасть Из Описание.ТабличныеЧасти Цикл
		// Строки с товарами/услугами/активами: есть сумма и что-то из номенклатуры, статьи, цены, количества.
		ЕстьСумма = ТабЧасть.Реквизиты.Найти("Сумма") <> Неопределено ИЛИ ТабЧасть.Реквизиты.Найти("СуммаВсего") <> Неопределено;
		ЕстьСтрока = ТабЧасть.Реквизиты.Найти("Номенклатура") <> Неопределено ИЛИ ТабЧасть.Реквизиты.Найти("СтатьяРасходов") <> Неопределено
			ИЛИ ТабЧасть.Реквизиты.Найти("Цена") <> Неопределено ИЛИ ТабЧасть.Реквизиты.Найти("Количество") <> Неопределено;
		Если ЕстьСумма И ЕстьСтрока Тогда
			Части.Добавить(ТабЧасть);
			ИмяСуммы = ?(ТабЧасть.Реквизиты.Найти("СуммаВсего") <> Неопределено, "СуммаВсего", "Сумма");
			Для Каждого СтрокаТЧ Из Документ[ТабЧасть.Имя] Цикл
				Итого = Итого + СтрокаТЧ[ИмяСуммы];
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если Итого = 0 Тогда
		// Для диагностики показываем, какие табличные части и поля есть в документе.
		Описания = Новый Массив;
		Для Каждого ТабЧасть Из Описание.ТабличныеЧасти Цикл
			Поля = Новый Массив;
			Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
				Поля.Добавить(Реквизит.Имя);
			КонецЦикла;
			Описания.Добавить(ТабЧасть.Имя + " (" + СтрСоединить(Поля, ", ") + "; строк: " + Документ[ТабЧасть.Имя].Количество() + ")");
		КонецЦикла;
		ВызватьИсключение "В документе нет сумм, которые можно пересчитать. Табличные части: " + СтрСоединить(Описания, "; ");
	КонецЕсли;

	Коэффициент = НоваяСумма / Итого;
	ПоследняяСтрока = Неопределено;
	ПоследняяЧасть = Неопределено;
	НовыйИтог = 0;
	Для Каждого ТабЧасть Из Части Цикл
		Для Каждого СтрокаТЧ Из Документ[ТабЧасть.Имя] Цикл
			// Все денежные поля строки (Сумма, СуммаНДС, СуммаВсего, СуммаРегл, СуммаУпр и т.п.) — от них зависят проводки и регистры.
			Для Каждого Имя Из ИменаСумм(ТабЧасть.Реквизиты) Цикл
				СтрокаТЧ[Имя] = Окр(СтрокаТЧ[Имя] * Коэффициент, 2);
			КонецЦикла;
			ПересчитатьЦену(ТабЧасть, СтрокаТЧ);
			НовыйИтог = НовыйИтог + СтрокаТЧ[?(ТабЧасть.Реквизиты.Найти("СуммаВсего") <> Неопределено, "СуммаВсего", "Сумма")];
			ПоследняяСтрока = СтрокаТЧ;
			ПоследняяЧасть = ТабЧасть;
		КонецЦикла;
	КонецЦикла;

	// Остаток от округления — в последнюю строку.
	Разница = НоваяСумма - НовыйИтог;
	Если Разница <> 0 И ПоследняяСтрока <> Неопределено Тогда
		Если ПоследняяЧасть.Реквизиты.Найти("Сумма") <> Неопределено Тогда
			ПоследняяСтрока.Сумма = ПоследняяСтрока.Сумма + Разница;
		КонецЕсли;
		Если ПоследняяЧасть.Реквизиты.Найти("СуммаВсего") <> Неопределено Тогда
			ПоследняяСтрока.СуммаВсего = ПоследняяСтрока.СуммаВсего + Разница;
		КонецЕсли;
		ПересчитатьЦену(ПоследняяЧасть, ПоследняяСтрока);
	КонецЕсли;

	// Другие табличные части с суммами: график оплаты — пропорционально; предоплата — только уменьшаем, если больше новой суммы.
	Для Каждого ТабЧасть Из Описание.ТабличныеЧасти Цикл
		Если Части.Найти(ТабЧасть) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена = ИменаСумм(ТабЧасть.Реквизиты);
		Если Имена.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмяТЧ = ТабЧасть.Имя;
		Если СтрНайти(ИмяТЧ, "График") > 0 ИЛИ СтрНайти(ИмяТЧ, "Этап") > 0 Тогда
			ПрименитьКоэффициент(Документ[ИмяТЧ], Имена, Коэффициент);
		ИначеЕсли СтрНайти(ИмяТЧ, "Предоплат") > 0 ИЛИ СтрНайти(ИмяТЧ, "Аванс") > 0 ИЛИ СтрНайти(ИмяТЧ, "Зачет") > 0 Тогда
			Всего = Документ[ИмяТЧ].Итог(Имена[0]);
			Если Всего > НоваяСумма Тогда
				ПрименитьКоэффициент(Документ[ИмяТЧ], Имена, НоваяСумма / Всего);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Шапка: все денежные реквизиты, «Сумма документа» — точно новая сумма.
	Для Каждого Имя Из ИменаСумм(Описание.Реквизиты) Цикл
		Документ[Имя] = Окр(Документ[Имя] * Коэффициент, 2);
	КонецЦикла;
	Если Описание.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
		Документ.СуммаДокумента = НоваяСумма;
	КонецЕсли;

КонецПроцедуры

// Числовые реквизиты, имя которых начинается с «Сумма».
Функция ИменаСумм(Реквизиты)

	Имена = Новый Массив;
	Для Каждого Реквизит Из Реквизиты Цикл
		Если СтрНачинаетсяС(Реквизит.Имя, "Сумма") И Реквизит.Тип.СодержитТип(Тип("Число")) Тогда
			Имена.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

Процедура ПрименитьКоэффициент(ТабличнаяЧасть, Имена, Коэффициент)

	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Для Каждого Имя Из Имена Цикл
			СтрокаТЧ[Имя] = Окр(СтрокаТЧ[Имя] * Коэффициент, 2);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Цена = сумма / количество; если количество не заполнено, считаем его равным 1 (цена равна сумме).
Процедура ПересчитатьЦену(ТабЧасть, СтрокаТЧ)

	Если ТабЧасть.Реквизиты.Найти("Цена") = Неопределено ИЛИ ТабЧасть.Реквизиты.Найти("Сумма") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Количество = 1;
	Если ТабЧасть.Реквизиты.Найти("Количество") <> Неопределено И СтрокаТЧ.Количество <> 0 Тогда
		Количество = СтрокаТЧ.Количество;
	КонецЕсли;
	СтрокаТЧ.Цена = Окр(СтрокаТЧ.Сумма / Количество, 2);

КонецПроцедуры

// Копирует документ-источник на НоваяДата. Возвращает структуру: Успех, Документ, Ошибка.
Функция СоздатьКопию(ИсточникСтрока, НоваяДата, Проводить = Истина, ОчищатьВходящийНомер = Ложь, НоваяСумма = 0) Экспорт

	Результат = Новый Структура("Успех, Документ, Ошибка, Предупреждение", Ложь, Неопределено, "", "");

	НачатьТранзакцию();
	Попытка
		Источник = ЗначениеИзСтрокиВнутр(ИсточникСтрока);
		НовыйДокумент = Источник.ПолучитьОбъект().Скопировать();
		НовыйДокумент.Дата = НоваяДата;
		НовыйДокумент.Номер = "";
		НовыйДокумент.УстановитьНовыйНомер();

		// Номер и дата документа поставщика за новый период другие.
		Если ОчищатьВходящийНомер Тогда
			Реквизиты = НовыйДокумент.Метаданные().Реквизиты;
			Для Каждого Имя Из СтрРазделить("НомерВходящегоДокумента,ДатаВходящегоДокумента", ",") Цикл
				Реквизит = Реквизиты.Найти(Имя);
				Если Реквизит <> Неопределено Тогда
					НовыйДокумент[Имя] = Реквизит.Тип.ПривестиЗначение(Неопределено);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Сумма указана — пересчитываем; пусто — остаётся прежней.
		Если НоваяСумма <> 0 Тогда
			ПересчитатьСумму(НовыйДокумент, НоваяСумма);
		КонецЕсли;

		Если НЕ НовыйДокумент.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "Не пройдена проверка заполнения: " + СообщенияПользователяТекстом();
		КонецЕсли;

		Если Проводить Тогда
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
		Результат.Документ = НовыйДокумент.Ссылка;
		// Контроль: итог документа после записи должен совпасть с введённой суммой.
		Если НоваяСумма <> 0 И НовыйДокумент.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
			ИтогПослеЗаписи = Результат.Документ.СуммаДокумента;
			Если ИтогПослеЗаписи <> НоваяСумма Тогда
				Результат.Предупреждение = "сумма документа " + ИтогПослеЗаписи + " вместо " + НоваяСумма;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция СообщенияПользователяТекстом()
	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Сообщение.Текст + "; ";
	КонецЦикла;
	Возврат Текст;
КонецФункции
