// Внешняя обработка «Оприходования без суммы» (1С:КА 2.5).
// Находит проведённые оприходования, где цена в строке есть, а сумма пустая (нет партии/себестоимости),
// создаёт «Приобретение товаров и услуг» на 1 шт. по этой цене и перепроводит оприходование.
// Имена реквизитов определяются по метаданным; что не нашлось — попадает в сообщение об ошибке.

Функция ИмяОприходования() Экспорт
	// Если в базе документ называется иначе — смотрите Конфигуратор: Документы → «Оприходование...».
	Возврат "ОприходованиеИзлишковТоваров";
КонецФункции

// Диагностика: какие табличные части/реквизиты и регистры у документа оприходования.
Функция Структура() Экспорт
	Описание = Метаданные.Документы[ИмяОприходования()];
	Текст = "Документ " + Описание.Имя + Символы.ПС;
	Для Каждого ТЧ Из Описание.ТабличныеЧасти Цикл
		Поля = Новый Массив;
		Для Каждого Р Из ТЧ.Реквизиты Цикл Поля.Добавить(Р.Имя); КонецЦикла;
		Текст = Текст + "  ТЧ " + ТЧ.Имя + ": " + СтрСоединить(Поля, ", ") + Символы.ПС;
	КонецЦикла;
	Регистры = Новый Массив;
	Для Каждого Р Из Описание.Движения Цикл Регистры.Добавить(Р.ПолноеИмя()); КонецЦикла;
	Возврат Текст + "  Движения: " + СтрСоединить(Регистры, ", ");
КонецФункции

// Возвращает таблицу проблемных строк: Оприходование, Дата, Организация, Склад, Номенклатура, Характеристика, Цена.
Функция НайтиПроблемные(Начало, Конец, Организация = Неопределено) Экспорт

	Имя = ИмяОприходования();
	ТЧ = Метаданные.Документы[Имя].ТабличныеЧасти.Товары;
	ЦенаИмя = ИмяКолонки(ТЧ, "Цена,ЦенаСНДС");
	СуммаИмя = ИмяКолонки(ТЧ, "Сумма,СуммаСНДС,СуммаВсего");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Оприходование,
	|	Д.Дата КАК Дата,
	|	Д.Организация КАК Организация,
	|	Д.Склад КАК Склад,
	|	С.Номенклатура КАК Номенклатура,
	|	С.Характеристика КАК Характеристика,
	|	С." + ЦенаИмя + " КАК Цена
	|ИЗ
	|	Документ." + Имя + ".Товары КАК С
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ." + Имя + " КАК Д
	|		ПО С.Ссылка = Д.Ссылка
	|ГДЕ
	|	Д.Проведен
	|	И Д.Дата МЕЖДУ &Начало И &Конец
	|	И С." + ЦенаИмя + " > 0
	|	И С." + СуммаИмя + " = 0
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ Д.Организация = &Организация)
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Имя первой существующей колонки из списка (колонки в оприходовании: «Цена с НДС», «Сумма с НДС» и т.п.).
Функция ИмяКолонки(ТабЧасть, Варианты)
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если ТабЧасть.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В табличной части " + ТабЧасть.Имя + " нет колонки из: " + Варианты + ". Нажмите «Структура документа» и пришлите вывод.";
КонецФункции

// ---------- Расхождения документа с регистрами (по количеству и по сумме) ----------

// Имя ресурса регистра по списку вариантов; пусто — не найден.
Функция ИмяРесурса(Регистр, Варианты)
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если Регистр.Ресурсы.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Итоги регистра накопления по регистраторам: Соответствие Регистратор -> Число.
Функция ИтогиРегистра(ИмяРегистра, ИмяРесурса, Начало, Конец)
	Итоги = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Р.Регистратор КАК Регистратор, СУММА(Р." + ИмяРесурса + ") КАК Итог
	|ИЗ РегистрНакопления." + ИмяРегистра + " КАК Р
	|ГДЕ Р.Период МЕЖДУ &Начало И &Конец И Р.Регистратор ССЫЛКА Документ." + ИмяОприходования() + "
	|СГРУППИРОВАТЬ ПО Р.Регистратор");
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итоги.Вставить(Выборка.Регистратор, Выборка.Итог);
	КонецЦикла;
	Возврат Итоги;
КонецФункции

// Оприходования, у которых количество не совпадает с «Товарами на складах» или сумма — с «Себестоимостью товаров».
// Возвращает Соответствие Документ -> текст причины. Если регистр/ресурс не найден — проверка пропускается (пишем в Лог).
Функция НайтиРасхождения(Начало, Конец, Организация, Лог) Экспорт

	Результат = Новый Соответствие;
	Имя = ИмяОприходования();
	ТЧ = Метаданные.Документы[Имя].ТабличныеЧасти.Товары;
	КолИмя = ИмяКолонки(ТЧ, "Количество");
	СуммаИмя = ИмяКолонки(ТЧ, "Сумма,СуммаСНДС,СуммаВсего");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ Д.Ссылка КАК Ссылка, СУММА(С." + КолИмя + ") КАК Количество, СУММА(С." + СуммаИмя + ") КАК Сумма
	|ИЗ Документ." + Имя + ".Товары КАК С
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ." + Имя + " КАК Д ПО С.Ссылка = Д.Ссылка
	|ГДЕ Д.Проведен И Д.Дата МЕЖДУ &Начало И &Конец
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ Д.Организация = &Организация)
	|СГРУППИРОВАТЬ ПО Д.Ссылка";
	Документы_ = Запрос.Выполнить().Выгрузить();

	// Количество: «Товары на складах»
	КолИтоги = Неопределено;
	Рег = Метаданные.РегистрыНакопления.Найти("ТоварыНаСкладах");
	Если Рег <> Неопределено Тогда
		Рес = ИмяРесурса(Рег, "ВНаличии,Количество");
		Если Рес <> "" Тогда
			КолИтоги = ИтогиРегистра("ТоварыНаСкладах", Рес, Начало, Конец);
		КонецЕсли;
	КонецЕсли;
	Если КолИтоги = Неопределено Тогда
		Лог.Добавить("Проверка количества пропущена: не найден регистр ТоварыНаСкладах/ресурс.");
	КонецЕсли;

	// Сумма: «Себестоимость товаров»
	СумИтоги = Неопределено;
	Рег = Метаданные.РегистрыНакопления.Найти("СебестоимостьТоваров");
	Если Рег <> Неопределено Тогда
		Рес = ИмяРесурса(Рег, "Стоимость,СтоимостьБезНДС");
		Если Рес <> "" Тогда
			СумИтоги = ИтогиРегистра("СебестоимостьТоваров", Рес, Начало, Конец);
		КонецЕсли;
	КонецЕсли;
	Если СумИтоги = Неопределено Тогда
		Лог.Добавить("Проверка суммы пропущена: не найден регистр СебестоимостьТоваров/ресурс стоимости.");
	КонецЕсли;

	Для Каждого Стр Из Документы_ Цикл
		Причины = Новый Массив;
		Если КолИтоги <> Неопределено Тогда
			Факт = КолИтоги.Получить(Стр.Ссылка);
			Если Окр(Стр.Количество - ?(Факт = Неопределено, 0, Факт), 3) <> 0 Тогда
				Причины.Добавить("количество в документе " + Стр.Количество + ", в регистре " + ?(Факт = Неопределено, 0, Факт));
			КонецЕсли;
		КонецЕсли;
		Если СумИтоги <> Неопределено Тогда
			Факт = СумИтоги.Получить(Стр.Ссылка);
			Если Абс(Стр.Сумма - ?(Факт = Неопределено, 0, Факт)) > 0.01 Тогда
				Причины.Добавить("сумма в документе " + Стр.Сумма + ", в регистре " + ?(Факт = Неопределено, 0, Факт));
			КонецЕсли;
		КонецЕсли;
		Если Причины.Количество() > 0 Тогда
			Результат.Вставить(Стр.Ссылка, СтрСоединить(Причины, "; "));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Распроводит и заново проводит документ в одной транзакции: при ошибке остаётся как было (проведённым).
Функция Перепровести(Ссылка, Лог)
	НачатьТранзакцию();
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		Лог.Добавить("ОШИБКА перепроведения " + Ссылка + " (документ оставлен как был): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Шаг 1: перепровести оприходования с расхождениями. Возвращает число перепроведённых.
Функция ПерепровестиРасхождения(Начало, Конец, Организация, ТолькоПоказать, Лог) Экспорт
	Найденные = НайтиРасхождения(Начало, Конец, Организация, Лог);
	Лог.Добавить("Оприходований с расхождениями: " + Найденные.Количество());
	Количество = 0;
	// по возрастанию даты, чтобы пересчёт шёл последовательно
	Таб = Новый ТаблицаЗначений;
	Таб.Колонки.Добавить("Ссылка");
	Таб.Колонки.Добавить("Дата");
	Таб.Колонки.Добавить("Причина");
	Для Каждого КЗ Из Найденные Цикл
		С = Таб.Добавить();
		С.Ссылка = КЗ.Ключ;
		С.Дата = КЗ.Ключ.Дата;
		С.Причина = КЗ.Значение;
	КонецЦикла;
	Таб.Сортировать("Дата");
	Для Каждого С Из Таб Цикл
		Лог.Добавить("Расхождение: " + С.Ссылка + " — " + С.Причина);
		Если НЕ ТолькоПоказать И Перепровести(С.Ссылка, Лог) Тогда
			Количество = Количество + 1;
			Лог.Добавить("Перепровёден: " + С.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

// Исправляет одну строку: создаёт приобретение на 1 шт. Возвращает ссылку на приобретение.
Функция СоздатьПриобретение(Стр, ОрганизацияПриобретения, Поставщик, Договор, Соглашение) Экспорт

	Док = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	Док.Дата = Стр.Дата - 1; // партия должна появиться раньше оприходования
	Док.УстановитьНовыйНомер();
	Док.Организация = ОрганизацияПриобретения;
	Док.Контрагент = Поставщик;
	Док.Договор = Договор;
	ЗаполнитьПоМетаданным(Док, "Соглашение", Соглашение);
	ЗаполнитьПоМетаданным(Док, "ЦенаВключаетНДС", Ложь);
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ЗаполнитьПоМетаданным(Док, "Склад", Стр.Склад);

	Новая = Док.Товары.Добавить();
	Новая.Номенклатура = Стр.Номенклатура;
	Новая.Характеристика = Стр.Характеристика;
	ЗаполнитьСтрокуЦеной(Док.Метаданные().ТабличныеЧасти.Товары, Новая, Стр.Цена);

	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;

КонецФункции

// Основной проход. ТолькоПоказать = Истина — ничего не создавать.
Функция Выполнить(Начало, Конец, ОрганизацияСтрока, ОрганизацияПриобрСтрока, ПоставщикСтрока, ДоговорСтрока, СоглашениеСтрока, ПерепроводитьРасхождения, ТолькоПоказать, Лог) Экспорт

	Организация = ?(ПустаяСтрока(ОрганизацияСтрока), Неопределено, НайтиОдин("Организации", ОрганизацияСтрока, Лог));
	ОрганизацияПриобр = НайтиОдин("Организации", ОрганизацияПриобрСтрока, Лог);
	Поставщик = НайтиОдин("Контрагенты", ПоставщикСтрока, Лог);
	Договор = Неопределено;
	Соглашение = Неопределено;
	Если НЕ ТолькоПоказать Тогда
		Если Поставщик = Неопределено ИЛИ ОрганизацияПриобр = Неопределено Тогда
			Возврат 0;
		КонецЕсли;
		Договор = НайтиДоговор(Поставщик, ДоговорСтрока, Лог);
		Соглашение = НайтиСоглашение(Поставщик, СоглашениеСтрока);
	КонецЕсли;

	Если ПерепроводитьРасхождения Тогда
		ПерепровестиРасхождения(Начало, Конец, Организация, ТолькоПоказать, Лог);
	КонецЕсли;

	Таблица = НайтиПроблемные(Начало, Конец, Организация);
	Лог.Добавить("Найдено проблемных строк: " + Таблица.Количество());
	Готовые = Новый Соответствие;
	Сделано = Новый Соответствие; // Номенклатура+Характеристика+Организация+Склад → уже создано

	Для Каждого Стр Из Таблица Цикл
		Лог.Добавить(Стр.Оприходование + " | " + Стр.Номенклатура + " | цена " + Стр.Цена);
		Если ТолькоПоказать Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка(Стр.Номенклатура.УникальныйИдентификатор()) + Строка(Стр.Характеристика.УникальныйИдентификатор())
			+ Строка(Стр.Склад.УникальныйИдентификатор());
		НачатьТранзакцию();
		Попытка
			Если Сделано.Получить(Ключ) = Неопределено Тогда
				Сделано.Вставить(Ключ, СоздатьПриобретение(Стр, ОрганизацияПриобр, Поставщик, Договор, Соглашение));
			КонецЕсли;
			ЗафиксироватьТранзакцию();
			Готовые.Вставить(Стр.Оприходование, Истина);
		Исключение
			ОтменитьТранзакцию();
			Лог.Добавить("ОШИБКА приобретения «" + Стр.Номенклатура + "»: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Для Каждого КЗ Из Готовые Цикл
		Попытка
			Объект = КЗ.Ключ.ПолучитьОбъект();
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			Лог.Добавить("Перепроведён: " + КЗ.Ключ);
		Исключение
			Лог.Добавить("ОШИБКА проведения " + КЗ.Ключ + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Готовые.Количество();

КонецФункции

// Ищет элемент справочника по части наименования; нужен ровно один.
Функция НайтиОдин(Справочник, Часть, Лог)
	Если ПустаяСтрока(Часть) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 С.Ссылка КАК Ссылка ИЗ Справочник." + Справочник + " КАК С ГДЕ НЕ С.ПометкаУдаления И С.Наименование ПОДОБНО &Н");
	Запрос.УстановитьПараметр("Н", "%" + СокрЛП(Часть) + "%");
	Т = Запрос.Выполнить().Выгрузить();
	Если Т.Количество() <> 1 Тогда
		Лог.Добавить("ОШИБКА: «" + Часть + "» (" + Справочник + ") — найдено " + Т.Количество() + ", нужно ровно одно. Уточните название.");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Т[0].Ссылка;
КонецФункции

Функция НайтиДоговор(Контрагент, Часть, Лог)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ Д.Владелец = &К И НЕ Д.ПометкаУдаления И Д.Наименование ПОДОБНО &Н");
	Запрос.УстановитьПараметр("К", Контрагент);
	Запрос.УстановитьПараметр("Н", "%" + СокрЛП(Часть) + "%");
	Т = Запрос.Выполнить().Выгрузить();
	Если Т.Количество() = 0 Тогда
		Лог.Добавить("ОШИБКА: договор поставщика не найден.");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Т[0].Ссылка;
КонецФункции

// Соглашение с поставщиком (КА): по контрагенту и части наименования; не нашли — пусто (заполнится по умолчанию).
Функция НайтиСоглашение(Контрагент, Часть)
	Если Метаданные.Справочники.Найти("СоглашенияОПоставках") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ Справочник.СоглашенияОПоставках КАК С
		|ГДЕ С.Контрагент = &К И НЕ С.ПометкаУдаления И С.Наименование ПОДОБНО &Н");
	Запрос.УстановитьПараметр("К", Контрагент);
	Запрос.УстановитьПараметр("Н", "%" + СокрЛП(Часть) + "%");
	Т = Запрос.Выполнить().Выгрузить();
	Возврат ?(Т.Количество() = 0, Неопределено, Т[0].Ссылка);
КонецФункции

Процедура ЗаполнитьПоМетаданным(Объект, Имя, Значение)
	Если Объект.Метаданные().Реквизиты.Найти(Имя) <> Неопределено Тогда
		Объект[Имя] = Значение;
	КонецЕсли;
КонецПроцедуры

// Количество = 1, цена и все «Сумма…» = цена (НДС не выделяем — для партии нужна себестоимость).
Процедура ЗаполнитьСтрокуЦеной(ТабЧасть, Строка, Цена)
	Для Каждого Р Из ТабЧасть.Реквизиты Цикл
		Имя = Р.Имя;
		Если Имя = "Количество" ИЛИ Имя = "КоличествоУпаковок" Тогда
			Строка[Имя] = 1;
		ИначеЕсли Имя = "Цена" ИЛИ Имя = "ЦенаСНДС" Тогда
			Строка[Имя] = Цена;
		ИначеЕсли СтрНачинаетсяС(Имя, "Сумма") И Р.Тип.СодержитТип(Тип("Число")) И Имя <> "СуммаНДС" Тогда
			Строка[Имя] = Цена;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
