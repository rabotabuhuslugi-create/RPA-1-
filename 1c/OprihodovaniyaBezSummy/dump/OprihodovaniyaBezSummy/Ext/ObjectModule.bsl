// Внешняя обработка «Оприходования без суммы» (1С:КА 2.5 / УТ 11).
// В проводках оприходования стоимость берётся из колонки строки «Сумма» (ТаблицаТовары.Сумма → СуммаУпр → партии/себестоимость).
// Обработка находит проведённые оприходования, где в строках Сумма = 0, заполняет в них Цену и Сумму
// (цена из документа; иначе как в форме — через ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены по виду цены документа;
// иначе из регистра «Цены номенклатуры» по виду цен закупки) и перепроводит документ. Приобретения не создаются.

Функция ИмяОприходования() Экспорт
	// Если в базе документ называется иначе — смотрите Конфигуратор: Документы → «Оприходование...».
	Возврат "ОприходованиеИзлишковТоваров";
КонецФункции

// Диагностика: какие табличные части/реквизиты и регистры у документа оприходования.
Функция ПоказатьСтруктуруДокумента() Экспорт
	Описание = Метаданные.Документы[ИмяОприходования()];
	Текст = "Документ " + Описание.Имя + Символы.ПС;
	Для Каждого ТЧ Из Описание.ТабличныеЧасти Цикл
		Поля = Новый Массив;
		Для Каждого Р Из ТЧ.Реквизиты Цикл Поля.Добавить(Р.Имя); КонецЦикла;
		Текст = Текст + "  ТЧ " + ТЧ.Имя + ": " + СтрСоединить(Поля, ", ") + Символы.ПС;
	КонецЦикла;
	Регистры = Новый Массив;
	Для Каждого Р Из Описание.Движения Цикл Регистры.Добавить(Р.ПолноеИмя()); КонецЦикла;
	Текст = Текст + "  Движения: " + СтрСоединить(Регистры, ", ") + Символы.ПС + Символы.ПС;
	Рег = РегистрЦенЗакупки();
	Если Рег = Неопределено Тогда
		Текст = Текст + "Регистр «Цены закупки» не найден. Регистры сведений со словом «цен»:" + Символы.ПС;
		Для Каждого Р Из Метаданные.РегистрыСведений Цикл
			Если СтрНайти(НРег(Р.Имя + " " + Р.Синоним), "цен") > 0 Тогда
				Изм = Новый Массив;
				Для Каждого Эл Из Р.Измерения Цикл Изм.Добавить(Эл.Имя); КонецЦикла;
				Рсс = Новый Массив;
				Для Каждого Эл Из Р.Ресурсы Цикл Рсс.Добавить(Эл.Имя); КонецЦикла;
				Текст = Текст + "  " + Р.Имя + " («" + Р.Синоним + "»): измерения " + СтрСоединить(Изм, ", ") + "; ресурсы " + СтрСоединить(Рсс, ", ") + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Текст = Текст + "Цены закупки: регистр " + Рег.Имя + ", ресурс цены " + Рег.Ресурс + ", измерение вида цен «" + Рег.ИзмерениеВида
			+ "», справочник «" + Рег.КаталогВида + "», периодический: " + Рег.Периодический;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Регистр сведений «Цены закупки»: ищется по имени/синониму, поля определяются по метаданным.
// Возвращает Структуру (Имя, Ресурс, ЕстьХарактеристика, ИзмерениеВида, КаталогВида, Периодический) или Неопределено.
Функция РегистрЦенЗакупки() Экспорт

	Найден = Неопределено;
	Для Каждого Р Из Метаданные.РегистрыСведений Цикл
		Если НРег(Р.Имя) = "ценызакупки" ИЛИ НРег(Р.Синоним) = "цены закупки" Тогда
			Найден = Р;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найден = Неопределено Тогда
		Для Каждого Р Из Метаданные.РегистрыСведений Цикл
			Если СтрНайти(НРег(Р.Имя), "ценызакуп") > 0 ИЛИ СтрНайти(НРег(Р.Синоним), "цены закуп") > 0 Тогда
				Найден = Р;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Найден = Неопределено ИЛИ Найден.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ресурс = "";
	Для Каждого Имя Из СтрРазделить("Цена,ЦенаЗакупки,ЦенаСНДС", ",") Цикл
		Если Найден.Ресурсы.Найти(Имя) <> Неопределено Тогда
			Ресурс = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Ресурс = "" Тогда
		Для Каждого Р Из Найден.Ресурсы Цикл
			Если СтрНачинаетсяС(Р.Имя, "Цена") Тогда
				Ресурс = Р.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Ресурс = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	// измерение вида цен (если есть): тип — справочник
	ИзмерениеВида = "";
	КаталогВида = "";
	Для Каждого Изм Из Найден.Измерения Цикл
		Если Изм.Имя = "Номенклатура" ИЛИ Изм.Имя = "Характеристика" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Изм.Имя, "ВидЦен") > 0 Тогда
			ИзмерениеВида = Изм.Имя;
			Для Каждого ТипДанных Из Изм.Тип.Типы() Цикл
				МД = Метаданные.НайтиПоТипу(ТипДанных);
				Если МД <> Неопределено И Метаданные.Справочники.Содержит(МД) Тогда
					КаталогВида = МД.Имя;
				КонецЕсли;
			КонецЦикла;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Имя", Найден.Имя);
	Результат.Вставить("Ресурс", Ресурс);
	Результат.Вставить("ЕстьХарактеристика", Найден.Измерения.Найти("Характеристика") <> Неопределено);
	Результат.Вставить("ИзмерениеВида", ИзмерениеВида);
	Результат.Вставить("КаталогВида", КаталогВида);
	Результат.Вставить("Периодический", Найден.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
	Возврат Результат;

КонецФункции

// Имя справочника для выпадающего списка «Вид цен закупки» (пусто — в регистре нет измерения вида цен).
Функция СправочникВидаЦенЗакупки() Экспорт
	Рег = РегистрЦенЗакупки();
	Возврат ?(Рег = Неопределено, "", Рег.КаталогВида);
КонецФункции

// Цена из регистра «Цены закупки»: на дату документа (если регистр периодический), иначе последняя;
// характеристика — точная, иначе любая; вид цен — если задан и есть такое измерение. 0 — не найдено.
Функция ЦенаИзРегистраЗакупки(Рег, Номенклатура, Характеристика, Дата, Вид, Кэш)

	Ключ = Строка(Номенклатура.УникальныйИдентификатор()) + Строка(Характеристика.УникальныйИдентификатор())
		+ Формат(НачалоДня(Дата), "ДФ=yyyyMMdd") + ?(Вид = Неопределено, "", Строка(Вид.УникальныйИдентификатор()));
	Значение = Кэш.Получить(Ключ);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Цена = 0;
	Для Каждого Вариант Из СтрРазделить("НаДату,Любая", ",") Цикл
		Если Вариант = "НаДату" И НЕ Рег.Периодический Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Точная Из СтрРазделить("Да,Нет", ",") Цикл
			Если Цена <> 0 Тогда Прервать; КонецЕсли;
			Если Точная = "Да" И НЕ Рег.ЕстьХарактеристика Тогда
				Продолжить;
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Н", Номенклатура);
			Запрос.УстановитьПараметр("Х", Характеристика);
			Запрос.УстановитьПараметр("В", Вид);
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1 Р." + Рег.Ресурс + " КАК Цена
			|ИЗ РегистрСведений." + Рег.Имя + " КАК Р
			|ГДЕ Р.Номенклатура = &Н И Р." + Рег.Ресурс + " > 0"
			+ ?(Точная = "Да", " И Р.Характеристика = &Х", "")
			+ ?(Вид <> Неопределено И Рег.ИзмерениеВида <> "", " И Р." + Рег.ИзмерениеВида + " = &В", "")
			+ ?(Вариант = "НаДату" И Рег.Периодический, " И Р.Период <= &Дата", "")
			+ " УПОРЯДОЧИТЬ ПО " + ?(Рег.Периодический, "Р.Период УБЫВ", "Р." + Рег.Ресурс + " УБЫВ");
			В = Запрос.Выполнить().Выбрать();
			Если В.Следующий() Тогда
				Цена = В.Цена;
			КонецЕсли;
		КонецЦикла;
		Если Цена <> 0 Тогда Прервать; КонецЕсли;
	КонецЦикла;

	Кэш.Вставить(Ключ, Цена);
	Возврат Цена;

КонецФункции

// Имя первой существующей колонки из списка (колонки в оприходовании: «Цена с НДС», «Сумма с НДС» и т.п.).
Функция ИмяКолонки(ТабЧасть, Варианты)
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если ТабЧасть.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В табличной части " + ТабЧасть.Имя + " нет колонки из: " + Варианты + ". Нажмите «Структура документа» и пришлите вывод.";
КонецФункции

// ---------- Расхождения документа с регистрами (по количеству и по сумме) ----------

// Имя ресурса регистра по списку вариантов; пусто — не найден.
Функция ИмяРесурса(Регистр, Варианты)
	Для Каждого Имя Из СтрРазделить(Варианты, ",") Цикл
		Если Регистр.Ресурсы.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Итоги регистра накопления по регистраторам: Соответствие Регистратор -> Число.
Функция ИтогиРегистра(ИмяРегистра, ИмяРесурса, Начало, Конец)
	Итоги = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Р.Регистратор КАК Регистратор, СУММА(Р." + ИмяРесурса + ") КАК Итог
	|ИЗ РегистрНакопления." + ИмяРегистра + " КАК Р
	|ГДЕ Р.Период МЕЖДУ &Начало И &Конец И Р.Регистратор ССЫЛКА Документ." + ИмяОприходования() + "
	|СГРУППИРОВАТЬ ПО Р.Регистратор");
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итоги.Вставить(Выборка.Регистратор, Выборка.Итог);
	КонецЦикла;
	Возврат Итоги;
КонецФункции

// Оприходования, у которых количество не совпадает с «Товарами на складах» или сумма — с «Себестоимостью товаров».
// Возвращает Соответствие Документ -> текст причины. Если регистр/ресурс не найден — проверка пропускается (пишем в Лог).
Функция НайтиРасхождения(Начало, Конец, Организация, Лог) Экспорт

	Результат = Новый Соответствие;
	Имя = ИмяОприходования();
	ТЧ = Метаданные.Документы[Имя].ТабличныеЧасти.Товары;
	КолИмя = ИмяКолонки(ТЧ, "Количество");
	СуммаИмя = ИмяКолонки(ТЧ, "Сумма,СуммаСНДС,СуммаВсего");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Дата КАК Дата, СУММА(С." + КолИмя + ") КАК Количество, СУММА(С." + СуммаИмя + ") КАК Сумма
	|ИЗ Документ." + Имя + ".Товары КАК С
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ." + Имя + " КАК Д ПО С.Ссылка = Д.Ссылка
	|ГДЕ Д.Проведен И Д.Дата МЕЖДУ &Начало И &Конец
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ Д.Организация = &Организация)
	|СГРУППИРОВАТЬ ПО Д.Ссылка, Д.Дата";
	Документы_ = Запрос.Выполнить().Выгрузить();

	// Количество: «Товары на складах»
	КолИтоги = Неопределено;
	Рег = Метаданные.РегистрыНакопления.Найти("ТоварыНаСкладах");
	Если Рег <> Неопределено Тогда
		Рес = ИмяРесурса(Рег, "ВНаличии,Количество");
		Если Рес <> "" Тогда
			КолИтоги = ИтогиРегистра("ТоварыНаСкладах", Рес, Начало, Конец);
		КонецЕсли;
	КонецЕсли;
	Если КолИтоги = Неопределено Тогда
		Лог.Добавить("Проверка количества пропущена: не найден регистр ТоварыНаСкладах/ресурс.");
	КонецЕсли;

	// Сумма: «Себестоимость товаров»
	СумИтоги = Неопределено;
	Рег = Метаданные.РегистрыНакопления.Найти("СебестоимостьТоваров");
	Если Рег <> Неопределено Тогда
		Рес = ИмяРесурса(Рег, "Стоимость,СтоимостьБезНДС");
		Если Рес <> "" Тогда
			СумИтоги = ИтогиРегистра("СебестоимостьТоваров", Рес, Начало, Конец);
		КонецЕсли;
	КонецЕсли;
	Если СумИтоги = Неопределено Тогда
		Лог.Добавить("Проверка суммы пропущена: не найден регистр СебестоимостьТоваров/ресурс стоимости.");
	КонецЕсли;

	Для Каждого Стр Из Документы_ Цикл
		Причины = Новый Массив;
		Если КолИтоги <> Неопределено Тогда
			Факт = КолИтоги.Получить(Стр.Ссылка);
			Если Окр(Стр.Количество - ?(Факт = Неопределено, 0, Факт), 3) <> 0 Тогда
				Причины.Добавить("количество в документе " + Стр.Количество + ", в регистре " + ?(Факт = Неопределено, 0, Факт));
			КонецЕсли;
		КонецЕсли;
		Если СумИтоги <> Неопределено Тогда
			Факт = СумИтоги.Получить(Стр.Ссылка);
			Разница = Стр.Сумма - ?(Факт = Неопределено, 0, Факт);
			Если ?(Разница < 0, -Разница, Разница) > 0.01 Тогда
				Причины.Добавить("сумма в документе " + Стр.Сумма + ", в регистре " + ?(Факт = Неопределено, 0, Факт));
			КонецЕсли;
		КонецЕсли;
		Если Причины.Количество() > 0 Тогда
			Результат.Вставить(Стр.Ссылка, Новый Структура("Причина, Дата", СтрСоединить(Причины, "; "), Стр.Дата));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Распроводит и заново проводит документ в одной транзакции: при ошибке остаётся как было (проведённым).
Функция Перепровести(Ссылка, Лог)
	НачатьТранзакцию();
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		Лог.Добавить("ОШИБКА перепроведения " + Ссылка + " (документ оставлен как был): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
КонецФункции



// Ищет элемент справочника. Часть — уникальный идентификатор (значение из выпадающего списка),
// либо наименование: точное совпадение, затем «содержит». Нужен ровно один элемент.
Функция НайтиОдин(Справочник, Часть, Лог)

	Если ПустаяСтрока(Часть) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// 1. идентификатор из выпадающего списка
	Если СтрДлина(СокрЛП(Часть)) = 36 Тогда
		Попытка
			Ссылка = Справочники[Справочник].ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Часть)));
			Проверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ Справочник." + Справочник + " КАК С ГДЕ С.Ссылка = &Ссылка");
			Проверка.УстановитьПараметр("Ссылка", Ссылка);
			Если НЕ Проверка.Выполнить().Пустой() Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// 2. наименование, введённое вручную
	Точный = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 С.Ссылка КАК Ссылка ИЗ Справочник." + Справочник + " КАК С ГДЕ НЕ С.ПометкаУдаления И С.Наименование = &Н");
	Точный.УстановитьПараметр("Н", СокрЛП(Часть));
	ТТ = Точный.Выполнить().Выгрузить();
	Если ТТ.Количество() = 1 Тогда
		Возврат ТТ[0].Ссылка;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 С.Ссылка КАК Ссылка ИЗ Справочник." + Справочник + " КАК С ГДЕ НЕ С.ПометкаУдаления И С.Наименование ПОДОБНО &Н");
	Запрос.УстановитьПараметр("Н", "%" + СокрЛП(Часть) + "%");
	Т = Запрос.Выполнить().Выгрузить();
	Если Т.Количество() <> 1 Тогда
		Лог.Добавить("ОШИБКА: «" + Часть + "» (" + Справочник + ") — найдено " + Т.Количество()
			+ ", нужно ровно одно. Выберите значение из выпадающего списка (там различаются по коду).");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Т[0].Ссылка;

КонецФункции


// Заполняет Цену/Сумму в строках Остались (индексы) по виду цены ВидЦены так же, как форма (ЗаполнитьЦены:
// на дату документа, с учётом упаковки и валюты). Из массива Остались убирает заполненные. Возвращает число заполненных строк.
Функция ЗаполнитьЦеныПоВидуЦены(Объект, Остались, ВидЦены, Лог, Источник = "по виду цены документа")
	Заполнено = 0;
	Попытка
		Таб = Объект.Товары.Выгрузить();
		Для Каждого Индекс Из Остались Цикл
			Таб[Индекс].Цена = 0;
			Таб[Индекс].Сумма = 0;
		КонецЦикла;
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Дата", Объект.Дата);
		ПараметрыЗаполнения.Вставить("Организация", Объект.Организация);
		ПараметрыЗаполнения.Вставить("Валюта", Объект.Валюта);
		ПараметрыЗаполнения.Вставить("ВидЦены", ВидЦены);
		ПараметрыЗаполнения.Вставить("КолонкиПоЗначению", Новый Структура("Упаковка", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка()));
		Этап(Объект.Ссылка, "ЗаполнитьЦены: вид цены " + ВидЦены);
		ЦеныПредприятияЗаполнениеСервер.ЗаполнитьЦены(Таб, Неопределено, ПараметрыЗаполнения, Новый Структура("ПересчитатьСумму", "Количество"));
		Этап(Объект.Ссылка, "ЗаполнитьЦены: готово");
		Ещё = Новый Массив;
		Для Каждого Индекс Из Остались Цикл
			Если Таб[Индекс].Цена > 0 Тогда
				Объект.Товары[Индекс].Цена = Таб[Индекс].Цена;
				Объект.Товары[Индекс].Сумма = ?(Таб[Индекс].Сумма > 0, Таб[Индекс].Сумма,
					Окр(Таб[Индекс].Цена * Объект.Товары[Индекс].Количество, 2));
				Заполнено = Заполнено + 1;
				Если Источник <> "по виду цены документа" Тогда
					Лог.Добавить("  " + Объект.Ссылка + " строка " + (Индекс + 1) + ": цена " + Таб[Индекс].Цена + " (" + Источник + ")");
				КонецЕсли;
			Иначе
				Ещё.Добавить(Индекс);
			КонецЕсли;
		КонецЦикла;
		Остались.Очистить();
		Для Каждого Индекс Из Ещё Цикл
			Остались.Добавить(Индекс);
		КонецЦикла;
	Исключение
		Лог.Добавить("  Не удалось получить цены (" + Источник + ", " + ВидЦены + "): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Заполнено;
КонецФункции

// Учётные виды цен всех складов (Справочники.Склады.УчетныйВидЦены), кроме исключаемого. Результат кэшируется.
Функция ВидыЦенДругихСкладов(Исключить, Кэш)
	Ключ = "ВидыЦенСкладов";
	Виды = Кэш.Получить(Ключ);
	Если Виды = Неопределено Тогда
		Виды = Новый Массив;
		Запрос = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Склад ИЗ Справочник.Склады КАК С ГДЕ НЕ С.ПометкаУдаления"
			+ ?(Метаданные.Справочники.Склады.Иерархический, " И НЕ С.ЭтоГруппа", ""));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				Вид = Справочники.Склады.УчетныйВидЦены(Выборка.Склад);
				Если ЗначениеЗаполнено(Вид) И Виды.Найти(Вид) = Неопределено Тогда
					Виды.Добавить(Вид);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
		Кэш.Вставить(Ключ, Виды);
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		Если Вид <> Исключить Тогда
			Результат.Добавить(Вид);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Заполняет Цену и Сумму в строках с нулевой суммой. Возвращает таблицу результата для лога; при ТолькоПоказать документ не пишется.
Функция ИсправитьДокументБезЗамера(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, ТолькоПоказать, Лог)

	Этап(Ссылка, "старт: получение объекта");
	Объект = Ссылка.ПолучитьОбъект();
	Строки = Новый Массив; // индексы строк с нулевой суммой
	Для Индекс = 0 По Объект.Товары.Количество() - 1 Цикл
		Стр = Объект.Товары[Индекс];
		Если Стр.Сумма = 0 И Стр.Количество > 0 Тогда
			Строки.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Кэш = Новый Соответствие;
	Исправлено = 0;

	Этап(Ссылка, "шаг 1: цены/суммы из колонок строки");
	// 1. в строке уже есть цена или сумма в любой из числовых колонок (Цена*, Сумма* кроме НДС) — берём оттуда
	ТЧМД = Объект.Метаданные().ТабличныеЧасти.Товары;
	КолонкиЦен = Новый Массив;
	КолонкиСумм = Новый Массив;
	Для Каждого Реквизит Из ТЧМД.Реквизиты Цикл
		Если НЕ Реквизит.Тип.СодержитТип(Тип("Число")) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Реквизит.Имя, "Цена") Тогда
			КолонкиЦен.Добавить(Реквизит.Имя);
		ИначеЕсли СтрНачинаетсяС(Реквизит.Имя, "Сумма") И Реквизит.Имя <> "Сумма" И (СтрНайти(Реквизит.Имя, "НДС") = 0 ИЛИ СтрНайти(Реквизит.Имя, "СНДС") > 0) Тогда
			// «СуммаСНДС», «СуммаВсего» — да; «СуммаНДС» (только НДС) — нет
			КолонкиСумм.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Остались = Новый Массив;
	Для Каждого Индекс Из Строки Цикл
		Стр = Объект.Товары[Индекс];
		ЦенаСтроки = 0;
		Для Каждого Имя Из КолонкиЦен Цикл
			Если Стр[Имя] > 0 Тогда
				ЦенаСтроки = Стр[Имя];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		СуммаСтроки = 0;
		Если ЦенаСтроки = 0 Тогда
			Для Каждого Имя Из КолонкиСумм Цикл
				Если Стр[Имя] > 0 Тогда
					СуммаСтроки = Стр[Имя];
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ЦенаСтроки > 0 Тогда
			Если Стр.Цена = 0 Тогда
				Стр.Цена = ЦенаСтроки;
			КонецЕсли;
			Стр.Сумма = Окр(ЦенаСтроки * Стр.Количество, 2);
			Исправлено = Исправлено + 1;
		ИначеЕсли СуммаСтроки > 0 Тогда
			Стр.Сумма = СуммаСтроки;
			Если Стр.Цена = 0 Тогда
				Стр.Цена = Окр(СуммаСтроки / Стр.Количество, 2);
			КонецЕсли;
			Исправлено = Исправлено + 1;
		Иначе
			Остались.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Этап(Ссылка, "шаг 2: по виду цены документа, строк без цены: " + Остались.Количество());
	// 2. как в форме: цены по виду цены документа (учётный вид цен склада) на дату документа
	Если Остались.Количество() > 0 И ЗначениеЗаполнено(Объект.ВидЦены) Тогда
		Исправлено = Исправлено + ЗаполнитьЦеныПоВидуЦены(Объект, Остались, Объект.ВидЦены, Лог);
	КонецЕсли;

	Этап(Ссылка, "шаг 2б: другие склады, строк без цены: " + Остались.Количество() + ", видов цен: " + ВидыДругихСкладов.Количество());
	// 2б. на этом складе цены нет — берём по учётным видам цен ДРУГИХ складов.
	// Одним запросом находим для каждой номенклатуры первый (по порядку списка) вид цен, где цена есть, и только затем
	// заполняем строки по этим видам (несколько вызовов вместо перебора всех видов цен для каждого документа).
	Если Остались.Количество() > 0 И ВидыДругихСкладов.Количество() > 0 Тогда
		Виды = Новый Массив;
		Для Каждого Вид Из ВидыДругихСкладов Цикл
			Если Вид <> Объект.ВидЦены Тогда
				Виды.Добавить(Вид);
			КонецЕсли;
		КонецЦикла;
		Если Метаданные.РегистрыСведений.Найти("ЦеныНоменклатуры") <> Неопределено Тогда
			Номенклатуры = Новый Массив;
			Для Каждого Индекс Из Остались Цикл
				Ном = Объект.Товары[Индекс].Номенклатура;
				Если Номенклатуры.Найти(Ном) = Неопределено Тогда
					Номенклатуры.Добавить(Ном);
				КонецЕсли;
			КонецЦикла;
			ЗапросЦен = Новый Запрос(
			"ВЫБРАТЬ Ц.Номенклатура КАК Номенклатура, Ц.ВидЦены КАК ВидЦены
			|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, Номенклатура В (&Номенклатуры) И ВидЦены В (&Виды)) КАК Ц
			|ГДЕ Ц.Цена > 0");
			ЗапросЦен.УстановитьПараметр("Дата", Объект.Дата);
			ЗапросЦен.УстановитьПараметр("Номенклатуры", Номенклатуры);
			ЗапросЦен.УстановитьПараметр("Виды", Виды);
			Найденные = ЗапросЦен.Выполнить().Выгрузить();
			ВидПоНоменклатуре = Новый Соответствие;
			Для Каждого Вид Из Виды Цикл
				Для Каждого НайденнаяСтрока Из Найденные.НайтиСтроки(Новый Структура("ВидЦены", Вид)) Цикл
					Если ВидПоНоменклатуре.Получить(НайденнаяСтрока.Номенклатура) = Неопределено Тогда
						ВидПоНоменклатуре.Вставить(НайденнаяСтрока.Номенклатура, Вид);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Группы = Новый Соответствие;
			Для Каждого Индекс Из Остались Цикл
				Вид = ВидПоНоменклатуре.Получить(Объект.Товары[Индекс].Номенклатура);
				Если Вид <> Неопределено Тогда
					Если Группы.Получить(Вид) = Неопределено Тогда
						Группы.Вставить(Вид, Новый Массив);
					КонецЕсли;
					Группы.Получить(Вид).Добавить(Индекс);
				КонецЕсли;
			КонецЦикла;
			Для Каждого КЗ Из Группы Цикл
				Исправлено = Исправлено + ЗаполнитьЦеныПоВидуЦены(Объект, КЗ.Значение, КЗ.Ключ, Лог, "с другого склада, вид цен " + КЗ.Ключ);
			КонецЦикла;
			Новые = Новый Массив;
			Для Каждого Индекс Из Остались Цикл
				Если Объект.Товары[Индекс].Сумма = 0 Тогда
					Новые.Добавить(Индекс);
				КонецЕсли;
			КонецЦикла;
			Остались.Очистить();
			Для Каждого Индекс Из Новые Цикл
				Остались.Добавить(Индекс);
			КонецЦикла;
		Иначе
			Для Каждого Вид Из Виды Цикл
				Если Остались.Количество() = 0 Тогда Прервать; КонецЕсли;
				Исправлено = Исправлено + ЗаполнитьЦеныПоВидуЦены(Объект, Остались, Вид, Лог, "с другого склада, вид цен " + Вид);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Этап(Ссылка, "шаг 3: регистр Цены закупки, строк без цены: " + Остались.Количество());
	// 3. запасной вариант: регистр сведений «Цены закупки»
	РегЗакупки = ?(Остались.Количество() > 0, РегистрЦенЗакупки(), Неопределено);
	Если Остались.Количество() > 0 И РегЗакупки = Неопределено Тогда
		Лог.Добавить("  Регистр «Цены закупки» не найден — запасной источник цены недоступен (кнопка «Структура документа» покажет регистры с «цен» в названии).");
	КонецЕсли;
	Если Остались.Количество() > 0 И РегЗакупки <> Неопределено Тогда
		Ещё = Новый Массив;
		Для Каждого Индекс Из Остались Цикл
			Стр = Объект.Товары[Индекс];
			Цена = ЦенаИзРегистраЗакупки(РегЗакупки, Стр.Номенклатура, Стр.Характеристика, Объект.Дата, ВидЦенЗакупки, Кэш);
			Если Цена > 0 Тогда
				Лог.Добавить("  " + Строка(Ссылка) + " строка " + (Индекс + 1) + ": цена " + Цена + " (регистр «Цены закупки»)");
				Стр.Цена = Цена;
				Стр.Сумма = Окр(Цена * Стр.Количество, 2);
				Исправлено = Исправлено + 1;
			Иначе
				Ещё.Добавить(Индекс);
			КонецЕсли;
		КонецЦикла;
		Остались = Ещё;
	КонецЕсли;

	Для Каждого Индекс Из Остались Цикл
		Колонки = Новый Массив;
		Для Каждого Реквизит Из ТЧМД.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(Тип("Число")) Тогда
				Колонки.Добавить(Реквизит.Имя + "=" + Объект.Товары[Индекс][Реквизит.Имя]);
			КонецЕсли;
		КонецЦикла;
		Лог.Добавить("  НЕТ ЦЕНЫ: " + Ссылка + " | строка " + (Индекс + 1) + " | " + Объект.Товары[Индекс].Номенклатура
			+ " | колонки: " + СтрСоединить(Колонки, "; "));
	КонецЦикла;

	Если Исправлено = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Лог.Добавить(Строка(Ссылка) + ": цены/суммы заполнены в строках: " + Исправлено + ", без цены: " + Остались.Количество());
	Если ТолькоПоказать Тогда
		Возврат Истина;
	КонецЕсли;

	Этап(Ссылка, "проведение: начало");
	НачатьТранзакцию();
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Этап(Ссылка, "проведение: готово");
		Лог.Добавить("  Перепроведён: " + Ссылка);
		Возврат Истина;
	Исключение
		ОтменитьТранзакцию();
		Лог.Добавить("ОШИБКА проведения " + Ссылка + " (документ не изменён): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции


// ---------- Пошаговый интерфейс для формы (клиент обрабатывает документы по одному, показывая прогресс) ----------

// Шаг 1: находит документы. Возвращает Структуру: Документы (массив ссылок — исправить цены), Расхождения (массив ссылок —
// только перепровести), ВидЦен (вид цен закупки или Неопределено), ВидыДругихСкладов (массив). Неопределено — ошибка (см. Лог).
Функция Подготовить(Начало, Конец, ОрганизацияСтрока, ВидЦенСтрока, ЦеныДругихСкладов, ПерепроводитьРасхождения, Лог) Экспорт

	Организация = ?(ПустаяСтрока(ОрганизацияСтрока), Неопределено, НайтиОдин("Организации", ОрганизацияСтрока, Лог));
	Если НЕ ПустаяСтрока(ОрганизацияСтрока) И Организация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Регистр сведений «Цены закупки» — запасной источник цены
	РегЗ = РегистрЦенЗакупки();
	ВидЦен = Неопределено;
	Если РегЗ = Неопределено Тогда
		Лог.Добавить("ВНИМАНИЕ: регистр сведений «Цены закупки» не найден — запасной источник цены отключён. Нажмите «Структура документа» и пришлите вывод.");
	Иначе
		Лог.Добавить("Цены закупки: регистр " + РегЗ.Имя + ", ресурс " + РегЗ.Ресурс
			+ ?(РегЗ.ИзмерениеВида = "", ", без измерения вида цен", ", вид цен — измерение " + РегЗ.ИзмерениеВида)
			+ ?(РегЗ.Периодический, ", периодический", ", непериодический"));
		Если НЕ ПустаяСтрока(ВидЦенСтрока) Тогда
			Если РегЗ.КаталогВида = "" Тогда
				Лог.Добавить("ВНИМАНИЕ: в регистре нет измерения вида цен — выбранный вид цен игнорируется.");
			Иначе
				ВидЦен = НайтиОдин(РегЗ.КаталогВида, ВидЦенСтрока, Лог);
				Если ВидЦен = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Имя = ИмяОприходования();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ Д.Ссылка КАК Ссылка, Д.Дата КАК Дата
	|ИЗ Документ." + Имя + ".Товары КАК С
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ." + Имя + " КАК Д ПО С.Ссылка = Д.Ссылка
	|ГДЕ Д.Проведен И Д.Дата МЕЖДУ &Начало И &Конец
	|	И С.Сумма = 0 И С.Количество > 0
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ Д.Организация = &Организация)
	|УПОРЯДОЧИТЬ ПО Д.Дата");
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Организация", Организация);
	Документы_ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Лог.Добавить("Оприходований со строками «Сумма = 0»: " + Документы_.Количество());

	Расхождения = Новый Массив; // ищутся отдельным шагом (РасхожденияДляФормы)

	ВидыДругих = Новый Массив;
	Если ЦеныДругихСкладов Тогда
		ВидыДругих = ВидыЦенДругихСкладов(Неопределено, Новый Соответствие);
		Лог.Добавить("Видов цен других складов для запасного поиска: " + ВидыДругих.Количество());
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Документы", Документы_);
	Результат.Вставить("Расхождения", Расхождения);
	Результат.Вставить("ВидЦен", ВидЦен);
	Результат.Вставить("ВидыДругихСкладов", ВидыДругих);
	Возврат Результат;

КонецФункции

// Этапы обработки пишутся в журнал регистрации (событие «Оприходования без суммы») — по последней записи видно, где остановилось.
Процедура Этап(Ссылка, Текст)
	Попытка
		ЗаписьЖурналаРегистрации("Оприходования без суммы", УровеньЖурналаРегистрации.Информация, , Ссылка, Текст);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Обёртка: если документ обрабатывался долго — пишем в журнал (чтобы видеть, что тормозит).
Функция ИсправитьДокумент(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, ТолькоПоказать, Лог)
	Начато = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Результат = ИсправитьДокументБезЗамера(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, ТолькоПоказать, Лог);
	Прошло = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начато) / 1000;
	Если Прошло > 5 Тогда
		Лог.Добавить("ВНИМАНИЕ: документ " + Строка(Ссылка) + " обрабатывался " + Окр(Прошло, 1) + " с");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Шаг 2 (по одному документу): заполнить Цену/Сумму и перепровести.
Функция ОбработатьЦены(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, ТолькоПоказать, Лог) Экспорт
	Возврат ИсправитьДокумент(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, ТолькоПоказать, Лог);
КонецФункции

// Шаг 3 (по одному документу): перепровести как есть.
Функция ПерепровестиДокумент(Ссылка, Лог) Экспорт
	Возврат Перепровести(Ссылка, Лог);
КонецФункции

// ---------- Отклонения: данные для таблицы на форме и (запасной вариант) табличного документа ----------

// Таблица значений проблемных строк (по паре «документ + номенклатура»). Колонки: Документ, Номер, Дата, Склад, Номенклатура,
// СуммаТЧ, СуммаСНДС, Себестоимость, БезНДС, НДСРегистр, Расхождение, Проблема. Не более 10000 строк.
Функция ТаблицаОтклонений(Начало, Конец, ОрганизацияСтрока, Лог, ДокументыОтбор = Неопределено, ТолькоПроблемы = Истина) Экспорт

	Организация = ?(ПустаяСтрока(ОрганизацияСтрока), Неопределено, НайтиОдин("Организации", ОрганизацияСтрока, Лог));
	Имя = ИмяОприходования();
	ТЧМД = Метаданные.Документы[Имя].ТабличныеЧасти.Товары;
	ЕстьСуммаСНДС = ТЧМД.Реквизиты.Найти("СуммаСНДС") <> Неопределено;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Д.Склад) КАК СкладПредставление,
	|	С.Номенклатура КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(С.Номенклатура) КАК НоменклатураПредставление,
	|	СУММА(С.Сумма) КАК Сумма,
	|	СУММА(" + ?(ЕстьСуммаСНДС, "С.СуммаСНДС", "0") + ") КАК СуммаСНДС
	|ИЗ Документ." + Имя + ".Товары КАК С
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ." + Имя + " КАК Д ПО С.Ссылка = Д.Ссылка
	|ГДЕ Д.Проведен И Д.Дата МЕЖДУ &Начало И &Конец
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ Д.Организация = &Организация)
	|	И (&БезОтбора ИЛИ Д.Ссылка В (&Документы))
	|СГРУППИРОВАТЬ ПО Д.Ссылка, Д.Номер, Д.Дата, Д.Склад, С.Номенклатура
	|УПОРЯДОЧИТЬ ПО Д.Дата, Д.Ссылка");
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбора", ДокументыОтбор = Неопределено);
	Запрос.УстановитьПараметр("Документы", ?(ДокументыОтбор = Неопределено, Новый Массив, ДокументыОтбор));
	Строки = Запрос.Выполнить().Выгрузить();

	// себестоимость из регистра по (документ, номенклатура)
	Регистр = Метаданные.РегистрыНакопления.Найти("СебестоимостьТоваров");
	Итоги = Неопределено;
	Если Регистр <> Неопределено Тогда
		ПутьНоменклатуры = "";
		Если Регистр.Измерения.Найти("Номенклатура") <> Неопределено Тогда
			ПутьНоменклатуры = "Р.Номенклатура";
		ИначеЕсли Регистр.Измерения.Найти("АналитикаУчетаНоменклатуры") <> Неопределено Тогда
			ПутьНоменклатуры = "Р.АналитикаУчетаНоменклатуры.Номенклатура";
		КонецЕсли;
		РесСтоимость = ИмяРесурса(Регистр, "Стоимость");
		РесБезНДС = ИмяРесурса(Регистр, "СтоимостьБезНДС");
		РесНДС = ИмяРесурса(Регистр, "НДС");
		Если ПутьНоменклатуры <> "" И РесСтоимость <> "" Тогда
			Итоги = Новый Соответствие;
			З = Новый Запрос(
			"ВЫБРАТЬ Р.Регистратор КАК Док, " + ПутьНоменклатуры + " КАК Номенклатура,
			|	СУММА(Р." + РесСтоимость + ") КАК Стоимость,
			|	СУММА(" + ?(РесБезНДС = "", "0", "Р." + РесБезНДС) + ") КАК БезНДС,
			|	СУММА(" + ?(РесНДС = "", "0", "Р." + РесНДС) + ") КАК НДС
			|ИЗ РегистрНакопления.СебестоимостьТоваров КАК Р
			|ГДЕ Р.Период МЕЖДУ &Начало И &Конец И Р.Регистратор ССЫЛКА Документ." + Имя + "
			|СГРУППИРОВАТЬ ПО Р.Регистратор, " + ПутьНоменклатуры);
			З.УстановитьПараметр("Начало", НачалоДня(Начало));
			З.УстановитьПараметр("Конец", КонецДня(Конец));
			В = З.Выполнить().Выбрать();
			Пока В.Следующий() Цикл
				Итоги.Вставить(Строка(В.Док.УникальныйИдентификатор()) + Строка(В.Номенклатура.УникальныйИдентификатор()),
					Новый Структура("Стоимость, БезНДС, НДС", В.Стоимость, В.БезНДС, В.НДС));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Итоги = Неопределено Тогда
		Лог.Добавить("Отклонения: себестоимость из регистра недоступна — показаны только строки с нулевой суммой в ТЧ.");
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Для Каждого К Из СтрРазделить("Документ,Номер,Дата,Склад,Номенклатура,СуммаТЧ,СуммаСНДС,Себестоимость,БезНДС,НДСРегистр,Расхождение,Проблема", ",") Цикл
		Результат.Колонки.Добавить(К);
	КонецЦикла;

	МаксСтрок = 10000;
	Всего = 0;
	Для Каждого Стр Из Строки Цикл
		Стоимость = 0; БезНДС = 0; НДС = 0;
		Если Итоги <> Неопределено Тогда
			Р = Итоги.Получить(Строка(Стр.Ссылка.УникальныйИдентификатор()) + Строка(Стр.Номенклатура.УникальныйИдентификатор()));
			Если Р <> Неопределено Тогда
				Стоимость = Р.Стоимость; БезНДС = Р.БезНДС; НДС = Р.НДС;
			КонецЕсли;
		КонецЕсли;
		Расхождение = Стр.Сумма - Стоимость;
		МодульРасх = ?(Расхождение < 0, -Расхождение, Расхождение);

		Проблема = "";
		Если Стр.Сумма = 0 И Стоимость = 0 Тогда
			Проблема = ?(Итоги = Неопределено, "Нулевая сумма в ТЧ", "Нулевая сумма в ТЧ и регистре");
		ИначеЕсли Стр.Сумма = 0 Тогда
			Проблема = "Нулевая сумма в ТЧ";
		ИначеЕсли Итоги <> Неопределено И Стоимость = 0 Тогда
			Проблема = "Нулевая себестоимость в регистре";
		ИначеЕсли Итоги <> Неопределено И МодульРасх > 0.01 Тогда
			Проблема = "Расхождение суммы ТЧ и регистра";
		КонецЕсли;
		Если Проблема = "" Тогда
			Если ТолькоПроблемы Тогда
				Продолжить;
			КонецЕсли;
			Проблема = "ОК";
		КонецЕсли;

		Всего = Всего + 1;
		Если Всего > МаксСтрок Тогда
			Продолжить;
		КонецЕсли;
		Н = Результат.Добавить();
		Н.Документ = Стр.Ссылка;
		Н.Номер = Стр.Номер;
		Н.Дата = Стр.Дата;
		Н.Склад = Стр.СкладПредставление;
		Н.Номенклатура = Стр.НоменклатураПредставление;
		Н.СуммаТЧ = Стр.Сумма;
		Н.СуммаСНДС = Стр.СуммаСНДС;
		Н.Себестоимость = Стоимость;
		Н.БезНДС = БезНДС;
		Н.НДСРегистр = НДС;
		Н.Расхождение = Расхождение;
		Н.Проблема = Проблема;
	КонецЦикла;

	Лог.Добавить("Отклонения: строк с проблемами " + Всего + " (проверено строк по номенклатуре: " + Строки.Количество() + ")."
		+ ?(Всего > МаксСтрок, " В таблице первые " + МаксСтрок + " — сузьте период.", ""));
	Возврат Результат;

КонецФункции

// Запасной вариант (если таблицу на форме создать не удалось): тот же отчёт табличным документом с расшифровкой.
Функция ОтчетОтклонений(Начало, Конец, ОрганизацияСтрока, Лог) Экспорт

	Данные = ТаблицаОтклонений(Начало, Конец, ОрганизацияСтрока, Лог);
	Док = Новый ТабличныйДокумент;
	Заголовки = СтрРазделить("Номер документа,Дата документа,Склад,Номенклатура,Сумма ТЧ Товары,Сумма ТЧ с НДС,Себестоимость регистр,Себестоимость без НДС,НДС регистр,Расхождение,Проблема", ",");
	Ширины = СтрРазделить("14,11,22,42,10,10,11,11,8,10,32", ",");
	Для К = 0 По Заголовки.Количество() - 1 Цикл
		Обл = Док.Область(1, К + 1, 1, К + 1);
		Обл.Текст = Заголовки[К];
		Обл.Шрифт = Новый Шрифт(, , , Истина);
		Обл.ЦветФона = Новый Цвет(230, 230, 230);
		Обл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Обл.ШиринаКолонки = Число(Ширины[К]);
	КонецЦикла;
	Док.ФиксацияСверху = 1;
	Кол = 1;
	Для Каждого Стр Из Данные Цикл
		Кол = Кол + 1;
		Значения = Новый Массив;
		Значения.Добавить(Стр.Номер);
		Значения.Добавить(Формат(Стр.Дата, "ДФ=dd.MM.yyyy"));
		Значения.Добавить(Стр.Склад);
		Значения.Добавить(Стр.Номенклатура);
		Для Каждого Имя Из СтрРазделить("СуммаТЧ,СуммаСНДС,Себестоимость,БезНДС,НДСРегистр,Расхождение", ",") Цикл
			Значения.Добавить(Формат(Стр[Имя], "ЧДЦ=2; ЧН=0,00"));
		КонецЦикла;
		Значения.Добавить(Стр.Проблема);
		Для К = 0 По Значения.Количество() - 1 Цикл
			Обл = Док.Область(Кол, К + 1);
			Обл.Текст = Значения[К];
			Обл.Расшифровка = Стр.Документ;
			Если К >= 4 И К <= 9 Тогда
				Обл.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Док;

КонецФункции
