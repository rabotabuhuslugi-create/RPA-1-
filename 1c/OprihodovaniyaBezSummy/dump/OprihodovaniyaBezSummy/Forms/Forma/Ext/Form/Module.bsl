&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Начало = НачалоМесяца(ТекущаяДатаСеанса());
	Конец = КонецДня(ТекущаяДатаСеанса());
	ТолькоПоказать = Истина;
	ПерепроводитьРасхождения = Истина;
	ПриобретениеНаГод = Истина;
	СкладПриобр = "Основной склад";
КонецПроцедуры

&НаКлиенте
Процедура Выполнить(Команда)
	Если НЕ ТолькоПоказать И (ПустаяСтрока(Поставщик) ИЛИ ПустаяСтрока(ОрганизацияПриобр) ИЛИ ПустаяСтрока(СкладПриобр)) Тогда
		Сообщить("Укажите организацию и склад приобретений и поставщика.");
		Возврат;
	КонецЕсли;
	ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	Журнал = Новый Массив;
	Попытка
		ОбъектОбр = РеквизитФормыВЗначение("Объект");
		ОбъектОбр.Выполнить(Начало, Конец, Организация, ОрганизацияПриобр, СкладПриобр, ВидЦен, Поставщик, Договор, Соглашение, ПерепроводитьРасхождения, ПриобретениеНаГод, ПроводитьПриобретение, ТолькоПоказать, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Лог = СтрСоединить(Журнал, Символы.ПС);
КонецПроцедуры

&НаКлиенте
Процедура Структура(Команда)
	СтруктураНаСервере();
КонецПроцедуры

&НаСервере
Процедура СтруктураНаСервере()
	Попытка
		Лог = РеквизитФормыВЗначение("Объект").Структура();
	Исключение
		Лог = "ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры
