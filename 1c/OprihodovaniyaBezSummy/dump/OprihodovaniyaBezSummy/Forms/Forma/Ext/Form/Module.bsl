&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Начало = НачалоМесяца(ТекущаяДатаСеанса());
	Конец = КонецДня(ТекущаяДатаСеанса());
	ТолькоПоказать = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Выполнить(Команда)
	Если НЕ ТолькоПоказать И ПустаяСтрока(Поставщик) Тогда
		Сообщить("Укажите поставщика для приобретений.");
		Возврат;
	КонецЕсли;
	ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	Журнал = Новый Массив;
	Попытка
		ОбъектОбр = РеквизитФормыВЗначение("Объект");
		ОбъектОбр.Выполнить(Начало, Конец, Организация, Поставщик, Договор, ТолькоПоказать, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Лог = СтрСоединить(Журнал, Символы.ПС);
КонецПроцедуры

&НаКлиенте
Процедура Структура(Команда)
	СтруктураНаСервере();
КонецПроцедуры

&НаСервере
Процедура СтруктураНаСервере()
	Попытка
		Лог = РеквизитФормыВЗначение("Объект").Структура();
	Исключение
		Лог = "ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры
