&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Начало = НачалоМесяца(ТекущаяДатаСеанса());
	Конец = КонецДня(ТекущаяДатаСеанса());
	ТолькоПоказать = Истина;
	ЦеныДругихСкладов = Истина;
	ПерепроводитьРасхождения = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	Журнал = Новый Массив;
	Попытка
		ОбъектОбр = РеквизитФормыВЗначение("Объект");
		ОбъектОбр.ВыполнитьОбработкуДанных(Начало, Конец, Организация, ВидЦен, ЦеныДругихСкладов, ПерепроводитьРасхождения, ТолькоПоказать, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Лог = СтрСоединить(Журнал, Символы.ПС);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтруктуру(Команда)
	СтруктураНаСервере();
КонецПроцедуры

&НаСервере
Процедура СтруктураНаСервере()
	Попытка
		Лог = РеквизитФормыВЗначение("Объект").ПоказатьСтруктуруДокумента();
	Исключение
		Лог = "ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры
