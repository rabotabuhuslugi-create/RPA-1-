// Обработка идёт документ за документом: каждый вызов сервера короткий, форма не «зависает»,
// виден прогресс в строке состояния; прервать можно сочетанием Ctrl+Break (уже обработанное сохраняется).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Начало = НачалоМесяца(ТекущаяДатаСеанса());
	Конец = КонецДня(ТекущаяДатаСеанса());
	ТолькоПоказать = Истина;
	ЦеныДругихСкладов = Истина;
	ПерепроводитьРасхождения = Истина;

	СоздатьТаблицуОтклонений();

	// Выпадающие списки: пустой выбор = «все» / «не использовать»
	НастроитьВыпадающийСписок(Элементы.Организация, "Организации", "<все организации>");
	// «Вид цен закупки» — значение измерения вида цен регистра «Цены закупки» (если такое измерение есть)
	КаталогВида = "";
	Попытка
		КаталогВида = РеквизитФормыВЗначение("Объект").СправочникВидаЦенЗакупки();
	Исключение
		Лог = Лог + "Регистр «Цены закупки»: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
	Если ПустаяСтрока(КаталогВида) Тогда
		Элементы.ВидЦен.Видимость = Ложь;
	Иначе
		НастроитьВыпадающийСписок(Элементы.ВидЦен, КаталогВида, "<любой>");
	КонецЕсли;
КонецПроцедуры

// Таблица отклонений создаётся кодом при открытии формы: на всю ширину окна, двойной щелчок/Enter открывает оприходование.
&НаСервере
Процедура СоздатьТаблицуОтклонений()
	Попытка
		ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
		ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
		ТипСтрока = Новый ОписаниеТипов("Строка");
		ТипДок = Новый ОписаниеТипов("ДокументСсылка.ОприходованиеИзлишковТоваров");

		// Имя | заголовок | тип | ширина
		Описание = Новый Массив;
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Документ", "Документ (двойной щелчок — открыть)", ТипДок, 34));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Дата", "Дата", ТипДата, 10));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Склад", "Склад", ТипСтрока, 24));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Номенклатура", "Номенклатура", ТипСтрока, 44));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "СуммаТЧ", "Сумма ТЧ", ТипЧисло, 11));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "СуммаСНДС", "Сумма ТЧ с НДС", ТипЧисло, 11));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Себестоимость", "Себестоимость регистр", ТипЧисло, 12));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "БезНДС", "Себестоимость без НДС", ТипЧисло, 12));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "НДСРегистр", "НДС регистр", ТипЧисло, 9));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Расхождение", "Расхождение", ТипЧисло, 11));
		Описание.Добавить(Новый Структура("Имя, Заголовок, Тип, Ширина", "Проблема", "Проблема", ТипСтрока, 32));

		Реквизиты = Новый Массив;
		Реквизиты.Добавить(Новый РеквизитФормы("ТаблицаОтклонений", Новый ОписаниеТипов("ТаблицаЗначений"), , "Отклонения"));
		Для Каждого Кол Из Описание Цикл
			Реквизиты.Добавить(Новый РеквизитФормы(Кол.Имя, Кол.Тип, "ТаблицаОтклонений", Кол.Заголовок));
		КонецЦикла;
		ИзменитьРеквизиты(Реквизиты);

		Таблица = Элементы.Добавить("ТаблицаОтклонений", Тип("ТаблицаФормы"), ЭтаФорма);
		Таблица.ПутьКДанным = "ТаблицаОтклонений";
		Таблица.Заголовок = "Отклонения (двойной щелчок или Enter — открыть оприходование)";
		Таблица.ТолькоПросмотр = Истина;
		Таблица.РастягиватьПоГоризонтали = Истина;
		Таблица.РастягиватьПоВертикали = Истина;
		Таблица.Высота = 18;
		Таблица.УстановитьДействие("Выбор", "ТаблицаОтклоненийВыбор");

		Для Каждого Кол Из Описание Цикл
			Поле = Элементы.Добавить("ТаблицаОтклонений" + Кол.Имя, Тип("ПолеФормы"), Таблица);
			Поле.Вид = ВидПоляФормы.ПолеВвода;
			Поле.ПутьКДанным = "ТаблицаОтклонений." + Кол.Имя;
			Поле.Заголовок = Кол.Заголовок;
			Поле.Ширина = Кол.Ширина;
			Поле.РастягиватьПоГоризонтали = (Кол.Имя = "Номенклатура");
		КонецЦикла;

		// журнал — под таблицу и короче
		Элементы.Переместить(Элементы.Лог, ЭтаФорма);
		Элементы.Лог.Высота = 6;
	Исключение
		Лог = Лог + "Таблица отклонений не создана (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "), отклонения откроются отчётом." + Символы.ПС;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура НастроитьВыпадающийСписок(Элемент, ИмяСправочника, ПредставлениеПустого)
	Попытка
		// Значение элемента списка — уникальный идентификатор (названия могут совпадать), представление — название и код
		ОписаниеСправочника = Метаданные.Справочники[ИмяСправочника];
		УсловиеГрупп = ?(ОписаниеСправочника.Иерархический, " И НЕ С.ЭтоГруппа", "");
		ЕстьКод = ОписаниеСправочника.ДлинаКода > 0;
		Запрос = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Ссылка, С.Наименование КАК Наименование"
			+ ?(ЕстьКод, ", С.Код КАК Код", "") + "
			|ИЗ Справочник." + ИмяСправочника + " КАК С ГДЕ НЕ С.ПометкаУдаления" + УсловиеГрупп + "
			|УПОРЯДОЧИТЬ ПО С.Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
		Элемент.СписокВыбора.Очистить();
		Элемент.СписокВыбора.Добавить("", ПредставлениеПустого);
		Пока Выборка.Следующий() Цикл
			Элемент.СписокВыбора.Добавить(Строка(Выборка.Ссылка.УникальныйИдентификатор()),
				Выборка.Наименование + ?(ЕстьКод, " (" + СокрЛП(Выборка.Код) + ")", ""));
		КонецЦикла;
		Элемент.РежимВыбораИзСписка = Истина;
		Элемент.КнопкаВыпадающегоСписка = Истина;
		Элемент.КнопкаВыбора = Ложь;
	Исключение
		// поле остаётся текстовым; причину покажем в «Результате»
		Лог = Лог + "Выпадающий список «" + ИмяСправочника + "» не построен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)

	ЧастиЛога = Новый Массив;
	Лог = "";
	Состояние("Поиск документов…");
	Журнал = Новый Массив;
	Данные = ПодготовитьНаСервере(Журнал);
	ДополнитьЛог(ЧастиЛога, Журнал);
	Если Данные = Неопределено Тогда
		Состояние("Остановлено: см. «Результат».");
		Возврат;
	КонецЕсли;

	Всего = Данные.Документы.Количество();
	Исправлено = 0;
	Для Индекс = 0 По Всего - 1 Цикл
		Состояние("Цены и суммы: документ " + (Индекс + 1) + " из " + Всего);
		Журнал = Новый Массив;
		Если ОбработатьЦеныНаСервере(Данные.Документы[Индекс], Данные.ВидЦен, Данные.ВидыДругихСкладов, Журнал) Тогда
			Исправлено = Исправлено + 1;
		КонецЕсли;
		ДополнитьЛог(ЧастиЛога, Журнал);
		ОбработкаПрерыванияПользователя();
	КонецЦикла;

	Расхождения = Новый Массив;
	Если ПерепроводитьРасхождения Тогда
		Состояние("Поиск расхождений в регистрах (на большом периоде может занять несколько минут)…");
		Журнал = Новый Массив;
		Расхождения = РасхожденияНаСервере(Данные.Документы, Журнал);
		ДополнитьЛог(ЧастиЛога, Журнал);
	КонецЕсли;

	Перепроведено = 0;
	Всего2 = Расхождения.Количество();
	Для Индекс = 0 По Всего2 - 1 Цикл
		Состояние("Перепроведение: документ " + (Индекс + 1) + " из " + Всего2);
		Журнал = Новый Массив;
		Если НЕ ТолькоПоказать Тогда
			Если ПерепровестиНаСервере(Расхождения[Индекс], Журнал) Тогда
				Перепроведено = Перепроведено + 1;
			КонецЕсли;
		КонецЕсли;
		ДополнитьЛог(ЧастиЛога, Журнал);
		ОбработкаПрерыванияПользователя();
	КонецЦикла;

	ЧастиЛога.Добавить(?(ТолькоПоказать, "Режим просмотра: документы не менялись. ", "")
		+ "Цены/суммы: документов " + Исправлено + " из " + Всего + "; перепроведено по расхождениям: " + Перепроведено + " из " + Всего2 + ".");
	Лог = СтрСоединить(ЧастиЛога, Символы.ПС);

	// Отклонения: после обработки — что осталось; в режиме просмотра — что будет исправляться
	Состояние("Формирование таблицы отклонений…");
	Журнал = Новый Массив;
	Если Элементы.Найти("ТаблицаОтклонений") <> Неопределено Тогда
		ЗаполнитьТаблицуНаСервере(Журнал);
	Иначе
		Отчет = ОтчетНаСервере(Журнал);
		Если Отчет.ВысотаТаблицы > 1 Тогда
			Отчет.Показать("Оприходования: отклонения");
		КонецЕсли;
	КонецЕсли;
	ДополнитьЛог(ЧастиЛога, Журнал);
	Состояние("Готово.");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере(Журнал)
	Попытка
		Данные = РеквизитФормыВЗначение("Объект").ТаблицаОтклонений(Начало, Конец, Организация, Журнал);
		ЗначениеВРеквизитФормы(Данные, "ТаблицаОтклонений");
	Исключение
		Журнал.Добавить("ОШИБКА таблицы отклонений: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ОтчетНаСервере(Журнал)
	Попытка
		Возврат РеквизитФормыВЗначение("Объект").ОтчетОтклонений(Начало, Конец, Организация, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА отчёта: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый ТабличныйДокумент;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ДополнитьЛог(ЧастиЛога, Журнал)
	Для Каждого Сообщение Из Журнал Цикл
		ЧастиЛога.Добавить(Сообщение);
	КонецЦикла;
	Если Журнал.Количество() > 0 Тогда
		Лог = СтрСоединить(ЧастиЛога, Символы.ПС);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПодготовитьНаСервере(Журнал)
	Попытка
		ОбъектОбр = РеквизитФормыВЗначение("Объект");
		Возврат ОбъектОбр.Подготовить(Начало, Конец, Организация, ВидЦен, ЦеныДругихСкладов, ПерепроводитьРасхождения, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Функция РасхожденияНаСервере(ИсключитьДокументы, Журнал)
	Попытка
		Возврат РеквизитФормыВЗначение("Объект").РасхожденияДляФормы(Начало, Конец, Организация, ИсключитьДокументы, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА поиска расхождений: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Массив;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ОбработатьЦеныНаСервере(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, Журнал)
	Попытка
		ОбъектОбр = РеквизитФормыВЗначение("Объект");
		Возврат ОбъектОбр.ОбработатьЦены(Ссылка, ВидЦенЗакупки, ВидыДругихСкладов, ТолькоПоказать, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА " + Строка(Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПерепровестиНаСервере(Ссылка, Журнал)
	Попытка
		ОбъектОбр = РеквизитФормыВЗначение("Объект");
		Возврат ОбъектОбр.ПерепровестиДокумент(Ссылка, Журнал);
	Исключение
		Журнал.Добавить("ОШИБКА " + Строка(Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ТаблицаОтклоненийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаОтклонений.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Документ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтруктуру(Команда)
	СтруктураНаСервере();
КонецПроцедуры

&НаСервере
Процедура СтруктураНаСервере()
	Попытка
		Лог = РеквизитФормыВЗначение("Объект").ПоказатьСтруктуруДокумента();
	Исключение
		Лог = "ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры
