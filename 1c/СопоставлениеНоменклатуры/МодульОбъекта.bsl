// Внешняя обработка "СопоставлениеНоменклатурыВЕТИС": автоматическое сопоставление продукции ВетИС
// с номенклатурой 1С (регистр сведений "Соответствие номенклатуры ВетИС").
// Работает отдельно от обработки "МеркурийАвто". Поиск ничего не меняет; запись - только кнопкой "Применить".
//
// Как ищется номенклатура для продукции ВетИС, которая встречается во ВСД за период и еще не сопоставлена:
//   1) GTIN = штрихкод номенклатуры                       -> "Автоматически"
//   2) GTIN без ведущего нуля (GTIN-14 -> EAN-13)           -> "Автоматически"
//   3) артикул продукции = артикул номенклатуры             -> "Проверить"
//   4) наименование продукции = наименование номенклатуры   -> "Проверить"
// Принимается только ровно ОДИН кандидат; если кандидатов несколько - "Неоднозначно", если нет - "Нет кандидата".

#Область ПрограммныйИнтерфейс

// Только чтение. Возвращает таблицу предложений (только простые значения и ссылки).
Функция ТаблицаПредложений(ДатаС, ДатаПо = Неопределено, ПоАртикулу = Истина, ПоНазванию = Истина) Экспорт
	Продукции = НесопоставленнаяПродукция(ДатаС, ДатаПо);

	Коды = Новый Массив;
	Артикулы = Новый Массив;
	Названия = Новый Массив;
	Для Каждого П Из Продукции Цикл
		Код = СокрЛП(П.GTIN);
		Если Код <> "" Тогда
			Коды.Добавить(Код);
			Если Лев(Код, 1) = "0" Тогда
				Коды.Добавить(Сред(Код, 2));
			КонецЕсли;
		КонецЕсли;
		Если ПоАртикулу И СокрЛП(П.Артикул) <> "" Тогда
			Артикулы.Добавить(СокрЛП(П.Артикул));
		КонецЕсли;
		Если ПоНазванию И СокрЛП(П.Наименование) <> "" Тогда
			Названия.Добавить(СокрЛП(П.Наименование));
		КонецЕсли;
	КонецЦикла;

	ПоШтрихкоду = КандидатыПоШтрихкоду(Коды);
	ПоАртикулуНом = КандидатыПоРеквизиту("Артикул", Артикулы);
	ПоНазваниюНом = КандидатыПоРеквизиту("Наименование", Названия);

	Т = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Порядок,Статус,Основание,Наименование,GTIN,Артикул,ВСД,Номенклатура,Кандидатов,Можно,Продукция,Результат", ",") Цикл
		Т.Колонки.Добавить(Имя);
	КонецЦикла;
	Порядки = Новый Соответствие;
	Порядки.Вставить("Автоматически", 1);
	Порядки.Вставить("Проверить", 2);
	Порядки.Вставить("Неоднозначно", 3);
	Порядки.Вставить("Нет кандидата", 4);

	Для Каждого П Из Продукции Цикл
		Код = СокрЛП(П.GTIN);
		Уровни = Новый Массив;
		Если Код <> "" Тогда
			Уровни.Добавить(Новый Структура("Список, Основание, Авто", ПоШтрихкоду[Код], "GTIN", Истина));
			Если Лев(Код, 1) = "0" Тогда
				Уровни.Добавить(Новый Структура("Список, Основание, Авто", ПоШтрихкоду[Сред(Код, 2)], "GTIN без ведущего нуля", Истина));
			КонецЕсли;
		КонецЕсли;
		Если ПоАртикулу И СокрЛП(П.Артикул) <> "" Тогда
			Уровни.Добавить(Новый Структура("Список, Основание, Авто", ПоАртикулуНом[ВРег(СокрЛП(П.Артикул))], "Артикул", Ложь));
		КонецЕсли;
		Если ПоНазванию И СокрЛП(П.Наименование) <> "" Тогда
			Уровни.Добавить(Новый Структура("Список, Основание, Авто", ПоНазваниюНом[ВРег(СокрЛП(П.Наименование))], "Название", Ложь));
		КонецЕсли;

		Статус = "Нет кандидата";
		Основание = "";
		Номенклатура = Неопределено;
		Количество = 0;
		Для Каждого Уровень Из Уровни Цикл
			Если Уровень.Список = Неопределено Или Уровень.Список.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Основание = Уровень.Основание;
			Количество = Уровень.Список.Количество();
			Если Количество = 1 Тогда
				Номенклатура = Уровень.Список[0];
				Статус = ?(Уровень.Авто, "Автоматически", "Проверить");
			Иначе
				Статус = "Неоднозначно";
			КонецЕсли;
			Прервать;
		КонецЦикла;

		С = Т.Добавить();
		С.Порядок = Порядки[Статус];
		С.Статус = Статус;
		С.Основание = Основание;
		С.Наименование = П.Наименование;
		С.GTIN = П.GTIN;
		С.Артикул = П.Артикул;
		С.ВСД = П.ВСД;
		С.Номенклатура = Номенклатура;
		С.Кандидатов = Количество;
		С.Можно = (Номенклатура <> Неопределено);
		С.Продукция = П.Продукция;
	КонецЦикла;
	Т.Сортировать("Порядок, ВСД УБЫВ");
	Возврат Т;
КонецФункции

// Запись соответствий. Выбранные - массив структур (Продукция, Номенклатура). Перед записью каждое соответствие
// проверяется заново (нет ли уже записи по продукции, не удалена ли номенклатура). Ничего не отправляется в Меркурий;
// запись можно удалить из регистра "Соответствие номенклатуры ВетИС".
// Возвращает таблицу с колонками Продукция, Результат.
Функция ПрименитьСоответствия(Выбранные) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Продукция");
	Результат.Колонки.Добавить("Результат");
	Значения = ЗначенияПоУмолчанию();
	Для Каждого Выбор Из Выбранные Цикл
		Строка = Результат.Добавить();
		Строка.Продукция = Выбор.Продукция;
		Попытка
			Если Не ЗначениеЗаполнено(Выбор.Продукция) Или Не ЗначениеЗаполнено(Выбор.Номенклатура) Тогда
				ВызватьИсключение "Не заданы продукция или номенклатура";
			КонецЕсли;
			Если Выбор.Номенклатура.ПометкаУдаления Тогда
				ВызватьИсключение "Номенклатура помечена на удаление";
			КонецЕсли;
			Если УжеСопоставлена(Выбор.Продукция) Тогда
				Строка.Результат = "Пропущено: по этой продукции уже есть соответствие";
				Продолжить;
			КонецЕсли;
			Набор = РегистрыСведений.СоответствиеНоменклатурыВЕТИС.СоздатьНаборЗаписей();
			Набор.Отбор.Продукция.Установить(Выбор.Продукция);
			Набор.Отбор.Номенклатура.Установить(Выбор.Номенклатура);
			Запись = Набор.Добавить();
			Запись.Продукция = Выбор.Продукция;
			Запись.Номенклатура = Выбор.Номенклатура;
			Запись.Порядок = Значения.Порядок;
			Запись.СтатусУказанияСерий = Значения.СтатусУказанияСерий;
			Набор.Записать(Истина);
			Строка.Результат = "Записано";
		Исключение
			Строка.Результат = "ОШИБКА: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("СопоставлениеНоменклатурыВЕТИС", УровеньЖурналаРегистрации.Ошибка,,,
				Строка(Выбор.Продукция) + ": " + Строка.Результат);
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Только чтение: как выглядят уже существующие соответствия и какие значения служебных полей самые частые.
// Так записываются и новые соответствия.
Функция ПримерыСуществующих() Экспорт
	Текст = Новый Массив;
	МД = Метаданные.РегистрыСведений.СоответствиеНоменклатурыВЕТИС;
	Поля = Новый Массив;
	Для Каждого Р Из МД.Измерения Цикл
		Поля.Добавить(Р.Имя);
	КонецЦикла;
	Для Каждого Р Из МД.Ресурсы Цикл
		Поля.Добавить(Р.Имя);
	КонецЦикла;
	Для Каждого Р Из МД.Реквизиты Цикл
		Поля.Добавить(Р.Имя);
	КонецЦикла;
	Выбор = Новый Массив;
	Для Каждого Имя Из Поля Цикл
		Выбор.Добавить("М." + Имя + " КАК " + Имя);
	КонецЦикла;
	З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 15 " + СтрСоединить(Выбор, ", ")
		+ " ИЗ РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК М");
	Результат = З.Выполнить();
	Выборка = Результат.Выбрать();
	Текст.Добавить("Существующих соответствий (первые 15): " + Выборка.Количество() + ". Поля: " + СтрСоединить(Поля, ", "));
	Пока Выборка.Следующий() Цикл
		Части = Новый Массив;
		Для Каждого Колонка Из Результат.Колонки Цикл
			Части.Добавить(Колонка.Имя + "=" + Строка(Выборка[Колонка.Имя]));
		КонецЦикла;
		Текст.Добавить("  " + СтрСоединить(Части, "; "));
	КонецЦикла;
	Значения = ЗначенияПоУмолчанию();
	Текст.Добавить("Для новых записей будет использовано: Порядок=" + Значения.Порядок
		+ ", СтатусУказанияСерий=" + Значения.СтатусУказанияСерий + " (самые частые значения среди существующих)");
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

#КонецОбласти

#Область Служебные

// Продукция ВетИС, которая встречается во ВСД за период и по которой еще нет ни одного соответствия.
Функция НесопоставленнаяПродукция(ДатаС, ДатаПо)
	З = Новый Запрос;
	З.Текст = "ВЫБРАТЬ
	|	П.Ссылка КАК Продукция,
	|	П.Наименование КАК Наименование,
	|	П.GTIN КАК GTIN,
	|	П.Артикул КАК Артикул,
	|	КОЛИЧЕСТВО(*) КАК ВСД
	|ИЗ
	|	Справочник.ВетеринарноСопроводительныйДокументВЕТИС КАК ВСДок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПродукцияВЕТИС КАК П
	|		ПО ВСДок.Продукция = П.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК М
	|		ПО М.Продукция = П.Ссылка
	|ГДЕ
	|	М.Продукция ЕСТЬ NULL
	|	И ВСДок.Дата >= &ДатаС
	|	И (&БезДатыПо ИЛИ ВСДок.Дата <= &ДатаПо)
	|СГРУППИРОВАТЬ ПО
	|	П.Ссылка,
	|	П.Наименование,
	|	П.GTIN,
	|	П.Артикул";
	З.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	З.УстановитьПараметр("БезДатыПо", Не ЗначениеЗаполнено(ДатаПо));
	З.УстановитьПараметр("ДатаПо", КонецДня(?(ЗначениеЗаполнено(ДатаПо), ДатаПо, ТекущаяДатаСеанса())));
	Возврат З.Выполнить().Выгрузить();
КонецФункции

// Соответствие "штрихкод -> массив разных номенклатур" (без помеченных на удаление).
Функция КандидатыПоШтрихкоду(Коды)
	Результат = Новый Соответствие;
	Если Коды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	З = Новый Запрос;
	З.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ш.Штрихкод КАК Ключ,
	|	Ш.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
	|ГДЕ
	|	Ш.Штрихкод В (&Коды)
	|	И НЕ Ш.Номенклатура.ПометкаУдаления";
	З.УстановитьПараметр("Коды", Коды);
	Выборка = З.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Результат, СокрЛП(Выборка.Ключ), Выборка.Номенклатура);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Соответствие "значение реквизита (в верхнем регистре) -> массив номенклатур" по артикулу или наименованию.
Функция КандидатыПоРеквизиту(Реквизит, Значения)
	Результат = Новый Соответствие;
	Если Значения.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	З = Новый Запрос;
	З.Текст = "ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	Н." + Реквизит + " КАК Ключ
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	Н." + Реквизит + " В (&Значения)
	|	И НЕ Н.ПометкаУдаления
	|	И НЕ Н.ЭтоГруппа";
	З.УстановитьПараметр("Значения", Значения);
	Выборка = З.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Результат, ВРег(СокрЛП(Выборка.Ключ)), Выборка.Номенклатура);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьКандидата(Соответствие, Ключ, Номенклатура)
	Список = Соответствие[Ключ];
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Соответствие.Вставить(Ключ, Список);
	КонецЕсли;
	Если Список.Найти(Номенклатура) = Неопределено Тогда
		Список.Добавить(Номенклатура);
	КонецЕсли;
КонецПроцедуры

Функция УжеСопоставлена(Продукция)
	З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Есть ИЗ РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК М ГДЕ М.Продукция = &Продукция");
	З.УстановитьПараметр("Продукция", Продукция);
	Возврат Не З.Выполнить().Пустой();
КонецФункции

// Самые частые значения служебных реквизитов в существующих соответствиях; для новых записей берем их.
Функция ЗначенияПоУмолчанию()
	Результат = Новый Структура("Порядок, СтатусУказанияСерий", 0, 0);
	Попытка
		З = Новый Запрос("ВЫБРАТЬ
		|	М.Порядок КАК Порядок,
		|	М.СтатусУказанияСерий КАК СтатусУказанияСерий,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК М
		|СГРУППИРОВАТЬ ПО
		|	М.Порядок,
		|	М.СтатусУказанияСерий
		|УПОРЯДОЧИТЬ ПО
		|	Количество УБЫВ");
		Выборка = З.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Порядок = Выборка.Порядок;
			Результат.СтатусУказанияСерий = Выборка.СтатусУказанияСерий;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецОбласти
