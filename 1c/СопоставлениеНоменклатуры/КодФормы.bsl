// Модуль формы "ФормаСопоставления" внешней обработки СопоставлениеНоменклатурыВЕТИС.
// Форма пустая: поля, кнопки и таблица создаются кодом. После вставки текста в модуль формы:
// свойства формы -> События -> ПриСозданииНаСервере -> впишите имя ПриСозданииНаСервере.
// В свойствах обработки "Основная форма" = ФормаСопоставления.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(8, 0));
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаС", ТипДата, , "С даты (ВСД)"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаПо", ТипДата, , "По дату (ВСД)"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоАртикулу", Новый ОписаниеТипов("Булево"), , "Искать по артикулу"));
	Реквизиты.Добавить(Новый РеквизитФормы("ПоНазванию", Новый ОписаниеТипов("Булево"), , "Искать по названию (точное совпадение)"));
	Реквизиты.Добавить(Новый РеквизитФормы("Итог", ТипСтрока, , "Итог"));
	Реквизиты.Добавить(Новый РеквизитФормы("Предложения", Новый ОписаниеТипов("ТаблицаЗначений"), , "Предложения"));

	Колонки = Новый Массив;
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Выбрать", "Применить", Новый ОписаниеТипов("Булево")));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Можно", "Можно", Новый ОписаниеТипов("Булево")));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Статус", "Статус", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Основание", "Основание", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Наименование", "Продукция ВетИС", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "GTIN", "GTIN", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Артикул", "Артикул", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ВСД", "ВСД, шт.", ТипЧисло));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Номенклатура", "Номенклатура 1С", Новый ОписаниеТипов("СправочникСсылка.Номенклатура")));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Кандидатов", "Кандидатов", ТипЧисло));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Продукция", "Продукция (ссылка)", Новый ОписаниеТипов("СправочникСсылка.ПродукцияВЕТИС")));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Результат", "Результат", ТипСтрока));
	Для Каждого Колонка Из Колонки Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.Тип, "Предложения", Колонка.Заголовок));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);

	ЭтаФорма.ДатаС = НачалоДня(ТекущаяДатаСеанса()) - 30 * 86400;
	ЭтаФорма.ПоАртикулу = Истина;
	ЭтаФорма.ПоНазванию = Истина;
	ЭтаФорма.Итог = "Нажмите ""Найти соответствия"": покажу продукцию из ВСД, которой нет в соответствиях, и найденную номенклатуру.";
	ЭтаФорма.Заголовок = "Сопоставление номенклатуры ВетИС";

	Поле = Элементы.Добавить("ПолеДатаС", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ДатаС";
	Поле = Элементы.Добавить("ПолеДатаПо", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ДатаПо";
	Поле = Элементы.Добавить("ПолеПоАртикулу", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПутьКДанным = "ПоАртикулу";
	Поле = Элементы.Добавить("ПолеПоНазванию", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПутьКДанным = "ПоНазванию";

	ДобавитьКнопку("Найти", "Найти соответствия", "КомандаНайти", "Только поиск: ничего не записывается");
	ДобавитьКнопку("ВыделитьАвто", "Выделить автоматические", "КомандаВыделитьАвто", "Отметить строки со статусом Автоматически");
	ДобавитьКнопку("ВыделитьВсе", "Выделить все возможные", "КомандаВыделитьВсе", "Отметить Автоматически и Проверить");
	ДобавитьКнопку("СнятьВыделение", "Снять выделение", "КомандаСнятьВыделение", "");
	ДобавитьКнопку("Применить", "Применить выбранные", "КомандаПрименить", "Записать отмеченные соответствия в регистр");
	ДобавитьКнопку("Примеры", "Примеры существующих", "КомандаПримеры", "Показать, как выглядят уже существующие соответствия");

	Поле = Элементы.Добавить("ПолеИтог", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеНадписи;
	Поле.ПутьКДанным = "Итог";

	Таблица = Элементы.Добавить("ТаблицаПредложения", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Предложения";
	Таблица.ТолькоПросмотр = Ложь;
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.УстановитьДействие("Выбор", "ПредложенияВыбор");
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.Имя = "Можно" Или Колонка.Имя = "Продукция" Тогда
			Продолжить;
		КонецЕсли;
		Столбец = Элементы.Добавить("Предложения" + Колонка.Имя, Тип("ПолеФормы"), Таблица);
		Если Колонка.Имя = "Выбрать" Тогда
			Столбец.Вид = ВидПоляФормы.ПолеФлажка;
		Иначе
			Столбец.Вид = ВидПоляФормы.ПолеВвода;
			Столбец.ТолькоПросмотр = Истина;
		КонецЕсли;
		Столбец.ПутьКДанным = "Предложения." + Колонка.Имя;
	КонецЦикла;

	Попытка
		ДобавитьЦвет("Предложения.Статус", "Автоматически", Новый Цвет(214, 240, 214));
		ДобавитьЦвет("Предложения.Статус", "Проверить", Новый Цвет(255, 242, 204));
		ДобавитьЦвет("Предложения.Статус", "Неоднозначно", Новый Цвет(248, 218, 218));
		ДобавитьЦвет("Предложения.Статус", "Нет кандидата", Новый Цвет(235, 235, 235));
		ДобавитьЦвет("Предложения.Результат", "Записано", Новый Цвет(190, 235, 190));
		БлокироватьФлажок();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Действие, Подсказка)
	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Подсказка = Подсказка;
	Команда.Действие = Действие;
	Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"));
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = Имя;
КонецПроцедуры

&НаСервере
Процедура ДобавитьЦвет(ИмяПоля, Значение, Цвет)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
КонецПроцедуры

&НаСервере
Процедура БлокироватьФлажок()
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ПредложенияВыбрать");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Предложения.Можно");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
КонецПроцедуры

&НаКлиенте
Функция ПериодКорректен()
	Если ЗначениеЗаполнено(ЭтаФорма.ДатаПо) И ЗначениеЗаполнено(ЭтаФорма.ДатаС) И ЭтаФорма.ДатаПо < ЭтаФорма.ДатаС Тогда
		ПоказатьПредупреждение(, "Дата ""по"" не может быть раньше даты ""с"".");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура КомандаНайти(Команда)
	Если Не ПериодКорректен() Тогда
		Возврат;
	КонецЕсли;
	Состояние("Ищу соответствия...");
	НайтиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьАвто(Команда)
	Для Каждого Стр Из ЭтаФорма.Предложения Цикл
		Стр.Выбрать = (Стр.Статус = "Автоматически");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьВсе(Команда)
	Для Каждого Стр Из ЭтаФорма.Предложения Цикл
		Стр.Выбрать = Стр.Можно;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВыделение(Команда)
	Для Каждого Стр Из ЭтаФорма.Предложения Цикл
		Стр.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименить(Команда)
	Выбранные = Новый Массив;
	Для Каждого Стр Из ЭтаФорма.Предложения Цикл
		Если Стр.Выбрать И Стр.Можно Тогда
			Выбранные.Добавить(Новый Структура("Продукция, Номенклатура", Стр.Продукция, Стр.Номенклатура));
		КонецЕсли;
	КонецЦикла;
	Если Выбранные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте строки со статусом ""Автоматически"" или ""Проверить"".");
		Возврат;
	КонецЕсли;
	Текст = "Будет записано соответствий в регистр ""Соответствие номенклатуры ВетИС"": " + Выбранные.Количество()
		+ ". Данные в Меркурий не отправляются. Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("КомандаПрименитьЗавершение", ЭтаФорма, Выбранные), Текст,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Подтверждение");
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименитьЗавершение(Ответ, Выбранные) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Состояние("Записываю соответствия...");
		ПрименитьНаСервере(Выбранные);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПримеры(Команда)
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ПримерыНаСервере());
	Документ.Показать("Существующие соответствия");
КонецПроцедуры

// Двойной щелчок: колонка "Номенклатура 1С" открывает номенклатуру, остальные - продукцию ВетИС.
&НаКлиенте
Процедура ПредложенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = ЭтаФорма.Предложения.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле.Имя = "ПредложенияНоменклатура" И ЗначениеЗаполнено(Данные.Номенклатура) Тогда
		ПоказатьЗначение(, Данные.Номенклатура);
	ИначеЕсли ЗначениеЗаполнено(Данные.Продукция) Тогда
		ПоказатьЗначение(, Данные.Продукция);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура НайтиНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Таблица = Обработка.ТаблицаПредложений(ЭтаФорма.ДатаС, ЭтаФорма.ДатаПо, ЭтаФорма.ПоАртикулу, ЭтаФорма.ПоНазванию);
	ЗаполнитьПредложения(Таблица);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредложения(Таблица)
	ЭтаФорма.Предложения.Очистить();
	Авто = 0;
	Проверить = 0;
	Неоднозначно = 0;
	НетКандидата = 0;
	Для Каждого Стр Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.Предложения.Добавить(), Стр);
		Если Стр.Статус = "Автоматически" Тогда
			Авто = Авто + 1;
		ИначеЕсли Стр.Статус = "Проверить" Тогда
			Проверить = Проверить + 1;
		ИначеЕсли Стр.Статус = "Неоднозначно" Тогда
			Неоднозначно = Неоднозначно + 1;
		Иначе
			НетКандидата = НетКандидата + 1;
		КонецЕсли;
	КонецЦикла;
	ЭтаФорма.Итог = "Несопоставленной продукции во ВСД: " + Таблица.Количество() + ". Автоматически: " + Авто
		+ "; проверить: " + Проверить + "; неоднозначно: " + Неоднозначно + "; нет кандидата: " + НетКандидата;
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере(Выбранные)
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ПрименитьСоответствия(Выбранные);
	Записано = 0;
	Ошибок = 0;
	Для Каждого Стр Из Результат Цикл
		Если Стр.Результат = "Записано" Тогда
			Записано = Записано + 1;
		ИначеЕсли СтрНачинаетсяС(Стр.Результат, "ОШИБКА") Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;
	// обновляем таблицу: записанные продукции из нее исчезнут
	Таблица = Обработка.ТаблицаПредложений(ЭтаФорма.ДатаС, ЭтаФорма.ДатаПо, ЭтаФорма.ПоАртикулу, ЭтаФорма.ПоНазванию);
	ЗаполнитьПредложения(Таблица);
	ЭтаФорма.Итог = "Записано соответствий: " + Записано + "; ошибок: " + Ошибок + ". " + ЭтаФорма.Итог;
КонецПроцедуры

&НаСервере
Функция ПримерыНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ПримерыСуществующих();
КонецФункции
