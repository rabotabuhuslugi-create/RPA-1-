// Модуль объекта внешней обработки «МассовоеКопированиеРеализаций».
// Конфигурация: 1С:Комплексная автоматизация 2.5 (документ РеализацияТоваровУслуг).
// Имена реквизитов проверьте в конфигураторе — в вашей сборке они могут отличаться.

Функция ПолучитьИсточники(НачалоПериода, КонецПериода, Организация = Неопределено, Контрагент = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Документ,
	|	Р.Дата КАК Дата,
	|	Р.Номер КАК Номер,
	|	Р.Партнер КАК Партнер,
	|	Р.Контрагент КАК Контрагент,
	|	Р.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Дата МЕЖДУ &Начало И &Конец
	|	И (&Организация = НЕОПРЕДЕЛЕНО ИЛИ Р.Организация = &Организация)
	|	И (&Контрагент = НЕОПРЕДЕЛЕНО ИЛИ Р.Контрагент = &Контрагент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р.Контрагент,
	|	Р.Дата";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Копирует документ-источник на НоваяДата.
// Возвращает структуру: Успех, Документ, Ошибка.
Функция СоздатьКопию(Источник, НоваяДата, Проводить = Истина) Экспорт

	Результат = Новый Структура("Успех, Документ, Ошибка", Ложь, Неопределено, "");

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
		Блокировка.Заблокировать();

		Новый = Источник.ПолучитьОбъект().Скопировать();
		Новый.Дата = НоваяДата;
		Новый.Номер = "";               // номер присвоится автоматически
		Новый.УстановитьНовыйНомер();
		Новый.Комментарий = СокрЛП(Новый.Комментарий);

		Если НЕ Новый.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "Не пройдена проверка заполнения: " + СообщенияПользователю();
		КонецЕсли;

		Если Проводить Тогда
			Новый.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Новый.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
		Результат.Документ = Новый.Ссылка;
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция СообщенияПользователю()
	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Сообщение.Текст + "; ";
	КонецЦикла;
	Возврат Текст;
КонецФункции
