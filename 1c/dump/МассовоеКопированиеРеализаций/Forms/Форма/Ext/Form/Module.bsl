&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КонецПериода = НачалоМесяца(ТекущаяДата()) - 1;
	НачалоПериода = НачалоМесяца(КонецПериода);
	НоваяДата = КонецМесяца(ТекущаяДата());
	Проводить = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Таблица = РеквизитФормыВЗначение("Объект").ПолучитьИсточники(
		НачалоПериода, КонецПериода,
		?(ЗначениеЗаполнено(Организация), Организация, Неопределено),
		?(ЗначениеЗаполнено(Контрагент), Контрагент, Неопределено));
	Источники.Очистить();
	Для Каждого Стр Из Таблица Цикл
		Новая = Источники.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Стр);
		Новая.Выбран = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализации(Команда)
	Если НЕ ЗначениеЗаполнено(НоваяДата) Тогда
		Сообщить("Укажите дату новых документов.");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьРеализацииЗавершение", ЭтотОбъект),
		"Создать реализации на " + Формат(НоваяДата, "ДЛФ=D") + "?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализацииЗавершение(Ответ, Параметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СоздатьНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Стр Из Источники Цикл
		Если НЕ Стр.Выбран ИЛИ ЗначениеЗаполнено(Стр.Создан) Тогда
			Продолжить;
		КонецЕсли;
		Рез = Обработка.СоздатьКопию(Стр.Документ, НоваяДата, Проводить);
		Если Рез.Успех Тогда
			Стр.Создан = Рез.Документ;
			Стр.Результат = "Создан и " + ?(Проводить, "проведён", "записан");
		Иначе
			Стр.Результат = "Ошибка: " + Рез.Ошибка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из Источники Цикл
		Стр.Выбран = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Стр Из Источники Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;
КонецПроцедуры
