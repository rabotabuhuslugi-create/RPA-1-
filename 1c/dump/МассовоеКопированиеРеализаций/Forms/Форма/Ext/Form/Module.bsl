&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КонецПериода = НачалоМесяца(ТекущаяДата()) - 1;
	НачалоПериода = НачалоМесяца(КонецПериода);
	НоваяДата = КонецМесяца(ТекущаяДата());
	Проводить = Истина;
	СоздаватьСчетаФактуры = Истина;
	ВидДокумента = "Реализация услуг и прочих активов";
	ЗаполнитьСпискиВыбора();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()

	Запрос = Новый Запрос("ВЫБРАТЬ О.Наименование КАК Наименование ИЗ Справочник.Организации КАК О
		|ГДЕ НЕ О.ПометкаУдаления УПОРЯДОЧИТЬ ПО О.Наименование");
	Элементы.Организация.СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элементы.Организация.СписокВыбора.Добавить(Выборка.Наименование);
	КонецЦикла;
	Элементы.Организация.КнопкаВыпадающегоСписка = Истина;

	Элементы.ВидДокумента.СписокВыбора.Очистить();
	Элементы.ВидДокумента.СписокВыбора.Добавить("Реализация услуг и прочих активов");
	Элементы.ВидДокумента.СписокВыбора.Добавить("Реализация товаров и услуг");
	Элементы.ВидДокумента.КнопкаВыпадающегоСписка = Истина;
	Элементы.ВидДокумента.РежимВыбораИзСписка = Истина;

	// Контрагенты, по которым уже есть проведённые реализации.
	Запрос = Новый Запрос("ВЫБРАТЬ Р.Контрагент.Наименование КАК Наименование
		|ИЗ Документ.РеализацияУслугПрочихАктивов КАК Р
		|ГДЕ Р.Проведен
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ Р2.Контрагент.Наименование
		|ИЗ Документ.РеализацияТоваровУслуг КАК Р2
		|ГДЕ Р2.Проведен
		|УПОРЯДОЧИТЬ ПО Наименование");
	Элементы.Контрагент.СписокВыбора.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
			Элементы.Контрагент.СписокВыбора.Добавить(Выборка.Наименование);
		КонецЕсли;
	КонецЦикла;
	Элементы.Контрагент.КнопкаВыпадающегоСписка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписок(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Таблица = РеквизитФормыВЗначение("Объект").ПолучитьИсточники(НачалоПериода, КонецПериода, Организация, Контрагент, ВидДокумента);
	Источники.Очистить();
	Для Каждого Стр Из Таблица Цикл
		Новая = Источники.Добавить();
		Новая.Выбран = Истина;
		Новая.Документ = Строка(Стр.Документ);
		Новая.ДокументСтрока = ЗначениеВСтрокуВнутр(Стр.Документ);
		Новая.Организация = Строка(Стр.Организация);
		Новая.Контрагент = Строка(Стр.Контрагент);
		Новая.Сумма = Стр.Сумма;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализации(Команда)
	Если НЕ ЗначениеЗаполнено(НоваяДата) Тогда
		Сообщить("Укажите дату новых документов.");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьРеализацииЗавершение", ЭтотОбъект),
		"Создать реализации на " + Формат(НоваяДата, "ДЛФ=D") + "?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализацииЗавершение(Ответ, Параметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СоздатьНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Стр Из Источники Цикл
		Если НЕ Стр.Выбран ИЛИ НЕ ПустаяСтрока(Стр.Создан) Тогда
			Продолжить;
		КонецЕсли;
		Рез = Обработка.СоздатьКопию(Стр.ДокументСтрока, НоваяДата, Проводить, СоздаватьСчетаФактуры);
		Если Рез.Успех Тогда
			Стр.Создан = Строка(Рез.Документ);
			Стр.СозданСтрока = ЗначениеВСтрокуВнутр(Рез.Документ);
			Стр.Результат = "Создан и " + ?(Проводить, "проведён", "записан");
			Если Рез.СчетФактура <> Неопределено Тогда
				Стр.СчетФактура = Строка(Рез.СчетФактура);
				Стр.СчетФактураСтрока = ЗначениеВСтрокуВнутр(Рез.СчетФактура);
			ИначеЕсли НЕ ПустаяСтрока(Рез.ОшибкаСФ) Тогда
				Стр.Результат = Стр.Результат + "; счёт-фактура не создан: " + Рез.ОшибкаСФ;
			КонецЕсли;
		Иначе
			Стр.Результат = "Ошибка: " + Рез.Ошибка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	Для Каждого Стр Из Источники Цикл
		Стр.Выбран = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	Для Каждого Стр Из Источники Цикл
		Стр.Выбран = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	Данные = Элементы.Источники.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Сообщить("Выберите строку в таблице.");
		Возврат;
	КонецЕсли;
	// Что откроется, зависит от колонки, в которой стоит курсор.
	Колонка = Элементы.Источники.ТекущийЭлемент.Имя;
	Если Колонка = "ИсточникиСоздан" Тогда
		Значение = Данные.СозданСтрока;
	ИначеЕсли Колонка = "ИсточникиСчетФактура" Тогда
		Значение = Данные.СчетФактураСтрока;
	Иначе
		Значение = Данные.ДокументСтрока;
	КонецЕсли;
	Если ПустаяСтрока(Значение) Тогда
		Сообщить("В этой колонке нет документа.");
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, СсылкаИзСтроки(Значение));
КонецПроцедуры

&НаСервереБезКонтекста
Функция СсылкаИзСтроки(Строка)
	Возврат ЗначениеИзСтрокиВнутр(Строка);
КонецФункции
