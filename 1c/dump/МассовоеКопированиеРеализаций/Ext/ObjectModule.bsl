// Внешняя обработка «Массовое копирование реализаций» (1С:КА 2.5, документ РеализацияТоваровУслуг).

Функция ПолучитьИсточники(НачалоПериода, КонецПериода, Организация = "", Контрагент = "", ВидДокумента = "") Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация", "%" + СокрЛП(Организация) + "%");
	Запрос.УстановитьПараметр("Контрагент", "%" + СокрЛП(Контрагент) + "%");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Ссылка КАК Документ,
	|	Р.Организация КАК Организация,
	|	Р.Контрагент КАК Контрагент,
	|	Р.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ИмяДокумента КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Дата МЕЖДУ &Начало И &Конец
	|	&УсловиеОрганизации
	|	&УсловиеКонтрагента
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р.Контрагент,
	|	Р.Дата";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизации",
		?(ПустаяСтрока(Организация), "", "И Р.Организация.Наименование ПОДОБНО &Организация"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагента",
		?(ПустаяСтрока(Контрагент), "", "И Р.Контрагент.Наименование ПОДОБНО &Контрагент"));

	ИмяДокумента = ?(ВидДокумента = "Реализация товаров и услуг", "РеализацияТоваровУслуг", "РеализацияУслугПрочихАктивов");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ИмяДокумента", "Документ." + ИмяДокумента);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Копирует документ-источник на НоваяДата. Возвращает структуру: Успех, Документ, Ошибка.
Функция СоздатьКопию(ИсточникСтрока, НоваяДата, Проводить = Истина, СоздаватьСчетФактуру = Ложь) Экспорт

	Результат = Новый Структура("Успех, Документ, Ошибка, СчетФактура, ОшибкаСФ", Ложь, Неопределено, "", Неопределено, "");

	НачатьТранзакцию();
	Попытка
		Источник = ЗначениеИзСтрокиВнутр(ИсточникСтрока);
		НоваяРеализация = Источник.ПолучитьОбъект().Скопировать();
		НоваяРеализация.Дата = НоваяДата;
		НоваяРеализация.Номер = "";
		НоваяРеализация.УстановитьНовыйНомер();

		Если НЕ НоваяРеализация.ПроверитьЗаполнение() Тогда
			ВызватьИсключение "Не пройдена проверка заполнения: " + СообщенияПользователяТекстом();
		КонецЕсли;

		Если Проводить Тогда
			НоваяРеализация.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			НоваяРеализация.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Результат.Успех = Истина;
		Результат.Документ = НоваяРеализация.Ссылка;
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Счёт-фактура — отдельно: если не получилась, реализация остаётся созданной.
	Если Результат.Успех И Проводить И СоздаватьСчетФактуру Тогда
		Попытка
			Результат.СчетФактура = СоздатьСчетФактуру(Результат.Документ);
		Исключение
			Результат.ОшибкаСФ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// То же, что ссылка «Оформить счет-фактуру» в документе реализации.
Функция СоздатьСчетФактуру(Реализация)

	СчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
	СчетФактура.Заполнить(Реализация);
	Если НЕ СчетФактура.ПроверитьЗаполнение() Тогда
		ВызватьИсключение "Не пройдена проверка заполнения счёта-фактуры: " + СообщенияПользователяТекстом();
	КонецЕсли;
	СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
	Возврат СчетФактура.Ссылка;

КонецФункции

Функция СообщенияПользователяТекстом()
	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Сообщение.Текст + "; ";
	КонецЦикла;
	Возврат Текст;
КонецФункции
