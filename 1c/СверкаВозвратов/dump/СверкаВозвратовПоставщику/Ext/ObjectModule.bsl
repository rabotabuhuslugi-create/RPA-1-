#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Сверка «Возврат товаров поставщику» <-> «Корректировка приобретения» (таблица «Расхождения»).
// Алгоритм повторяет эталон rpa1c/sverka.py (и HTML-инструмент): при правке менять оба места.
// Обработка ТОЛЬКО читает данные; запись (пометка на удаление) — отдельная процедура формы.

Перем СрокКорректировкиМесяцев; // корректировка поставщика приходит не позже этого срока после возврата
Перем ПредельныйСрок;            // жёсткий предел времени всего подбора, мс (после него — только быстрый поиск без комбинаций)
Перем ВремяПодбораМс;           // бюджет времени на точный подбор, мс (после него берём лучшее из найденного)
Перем ДнейРаньшеВозврата;       // возврат могут провести позже корректировки: допустимо раньше возврата не более чем на столько дней

#Область ПрограммныйИнтерфейс

// Выполняет подбор и сверку.
//
// Параметры:
//	Параметры - Структура - НачалоПериода, КонецПериода, СрокМесяцев, ДнейРаньше, ВремяПодбораСек, Контрагент, Организация, Допуск, МаксКомбинация
//
// Возвращаемое значение:
//	Структура - Возвраты (Массив структур), Корректировки (Массив структур), КолвоСтрокВозвратов, КолвоСтрокКорректировок
//
// Шаг 1: читает возвраты и корректировки из базы (ничего не сопоставляет и не пишет).
Функция ПрочитатьДанные(Параметры) Экспорт

	ИнициализироватьПараметры(Параметры);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СтрокиВозвратов = ПрочитатьСтрокиВозвратов(Параметры);
	СтрокиКорректировок = ПрочитатьСтрокиКорректировок(Параметры);
	Возврат Новый Структура("СтрокиВозвратов, СтрокиКорректировок, СекундЧтение", СтрокиВозвратов, СтрокиКорректировок,
		Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1));

КонецФункции

// Шаг 2: сопоставляет прочитанные данные (подбор).
Функция Сверить(Параметры, Данные) Экспорт

	ИнициализироватьПараметры(Параметры);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПредельныйСрок = Начало + Макс(ВремяПодбораМс * 4, 30000);

	Результат = ВыполнитьСверку(Данные.СтрокиВозвратов, Данные.СтрокиКорректировок, Параметры.Допуск, Параметры.МаксКомбинация);
	Результат.Вставить("КолвоСтрокВозвратов", Данные.СтрокиВозвратов.Количество());
	Результат.Вставить("КолвоСтрокКорректировок", Данные.СтрокиКорректировок.Количество());
	Результат.Вставить("СекундЧтение", Данные.СекундЧтение);
	Результат.Вставить("СекундПодбор", Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, 1));
	Возврат Результат;

КонецФункции

Процедура ИнициализироватьПараметры(Параметры)

	СрокКорректировкиМесяцев = ?(Параметры.Свойство("СрокМесяцев") И Параметры.СрокМесяцев > 0, Параметры.СрокМесяцев, 3);
	ВремяПодбораМс = ?(Параметры.Свойство("ВремяПодбораСек") И Параметры.ВремяПодбораСек > 0, Параметры.ВремяПодбораСек, 5) * 1000;
	ДнейРаньшеВозврата = ?(Параметры.Свойство("ДнейРаньше") И Параметры.ДнейРаньше >= 0, Параметры.ДнейРаньше, 30);
	ПредельныйСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Макс(ВремяПодбораМс * 4, 30000);

КонецПроцедуры

#КонецОбласти

#Область ЧтениеДанных

Функция ПрочитатьСтрокиВозвратов(Параметры)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Проведен КАК Проведен,
	|	Док.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Т.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ТОГДА Док.Склад
	|		ИНАЧЕ Т.Склад
	|	КОНЕЦ КАК Склад,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Количество КАК Количество,
	|	Т.ДокументПоступления КАК ПоступлениеСтроки,
	|	Док.ДокументПоступления КАК ПоступлениеШапки,
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику КАК Док
	|		ПО Т.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Проведен
	|	И НЕ Док.ПометкаУдаления
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&БезКонтрагента ИЛИ Док.Контрагент = &Контрагент)
	|	И (&БезОрганизации ИЛИ Док.Организация = &Организация)
	|	И Т.Количество <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка,
	|	Т.НомерСтроки";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
	ЗаполнитьОтборыЗапроса(Запрос, Параметры);

	Возврат ВыгрузитьСтроки(Запрос.Выполнить().Выгрузить(), Ложь);

КонецФункции

Функция ПрочитатьСтрокиКорректировок(Параметры)

	// Корректировки берутся независимо от проведённости: «Расхождения» заполняются из ЭДО сразу.
	// Берём только строки «Уменьшить закупку, уменьшить складские остатки», количество — по модулю.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Проведен КАК Проведен,
	|	Док.ДокументОснование КАК Основание,
	|	Док.ДатаВходящегоДокумента КАК ДатаВходящая,
	|	Док.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Т.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ТОГДА Док.Склад
	|		ИНАЧЕ Т.Склад
	|	КОНЕЦ КАК Склад,
	|	Т.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Т.Количество < 0
	|			ТОГДА -Т.Количество
	|		ИНАЧЕ Т.Количество
	|	КОНЕЦ КАК Количество,
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.КорректировкаПриобретения.Расхождения КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаПриобретения КАК Док
	|		ПО Т.Ссылка = Док.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА Док.ДатаВходящегоДокумента <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА Док.ДатаВходящегоДокумента
	|			ИНАЧЕ Док.Дата
	|		КОНЕЦ МЕЖДУ &НачалоПериода И &ВерхДата
	|	И (&БезКонтрагента ИЛИ Док.Контрагент = &Контрагент)
	|	И (&БезОрганизации ИЛИ Док.Организация = &Организация)
	|	И Т.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокПоступлений.УменьшитьЗакупкуУменьшитьСкладскиеОстатки)
	|	И Т.Количество <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка,
	|	Т.НомерСтроки";
	// Корректировка могла прийти раньше возврата (возврат провели позже) — берём с запасом
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода) - ДнейРаньшеВозврата * 86400);
	// Корректировка поставщика приходит не позже заданного срока после последнего возврата периода
	Запрос.УстановитьПараметр("ВерхДата", КонецДня(ДобавитьМесяц(Параметры.КонецПериода, СрокКорректировкиМесяцев)));
	ЗаполнитьОтборыЗапроса(Запрос, Параметры);

	Возврат ВыгрузитьСтроки(Запрос.Выполнить().Выгрузить(), Истина);

КонецФункции

Процедура ЗаполнитьОтборыЗапроса(Запрос, Параметры)

	Запрос.УстановитьПараметр("БезКонтрагента", Не ЗначениеЗаполнено(Параметры.Контрагент));
	Запрос.УстановитьПараметр("Контрагент", Параметры.Контрагент);
	Запрос.УстановитьПараметр("БезОрганизации", Не ЗначениеЗаполнено(Параметры.Организация));
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);

КонецПроцедуры

// Даты поступлений-оснований корректировок: поступления товаров — одним запросом, остальные документы — по одному.
Функция ДатыОснованийКорректировок(Таблица)

	Даты = Новый Соответствие;
	МассивЗакупок = Новый Массив;
	Прочие = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Основание = СтрокаТаблицы.Основание;
		Если Не ЗначениеЗаполнено(Основание) Или Даты.Получить(Основание) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Даты.Вставить(Основание, Ложь); // отметка «уже учтено»
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			МассивЗакупок.Добавить(Основание);
		Иначе
			Прочие.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;

	Если МассивЗакупок.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.Дата КАК Дата
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.Ссылка В(&Ссылки)";
		Запрос.УстановитьПараметр("Ссылки", МассивЗакупок);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Даты.Вставить(Выборка.Ссылка, Выборка.Дата);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Основание Из Прочие Цикл
		Даты.Вставить(Основание, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "Дата"));
	КонецЦикла;
	Возврат Даты;

КонецФункции

Функция ВыгрузитьСтроки(Таблица, ЭтоКорректировка)

	Строки = Новый Массив;
	ДатыОснований = ?(ЭтоКорректировка, ДатыОснованийКорректировок(Таблица), Новый Соответствие);
	Для Каждого Выборка Из Таблица Цикл
		Количество = Окр(Выборка.Количество, 3);
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("Документ", Выборка.Документ);
		СтрокаДанных.Вставить("ДокументКлюч", Строка(Выборка.Документ.УникальныйИдентификатор()));
		СтрокаДанных.Вставить("Номер", Выборка.Номер);
		СтрокаДанных.Вставить("Дата", Выборка.Дата);
		СтрокаДанных.Вставить("Проведен", Выборка.Проведен);
		Если ЭтоКорректировка Тогда
			СтрокаДанных.Вставить("Основание", Выборка.Основание);
			// Дата поступления, к которому относится корректировка (для проверки совместимости с возвратом)
			ДатаОснования = Неопределено;
			Если ЗначениеЗаполнено(Выборка.Основание) Тогда
				ДатаОснования = ДатыОснований.Получить(Выборка.Основание);
				Если ДатаОснования = Ложь Тогда
					ДатаОснования = Неопределено;
				КонецЕсли;
			КонецЕсли;
			СтрокаДанных.Вставить("ДатаОснования", ДатаОснования);
			// Дата корректировки поставщика: дата его документа (не меняется при переносе даты проведения у нас)
			СтрокаДанных.Вставить("ДатаПоставщика", ?(ЗначениеЗаполнено(Выборка.ДатаВходящая), Выборка.ДатаВходящая, Выборка.Дата));
			СтрокаДанных.Вставить("ДатаКорр", НачалоДня(?(ЗначениеЗаполнено(Выборка.ДатаВходящая), Выборка.ДатаВходящая, Выборка.Дата)));
		Иначе
			// Поступление, из которого сделан возврат: указано в строке, иначе в шапке
			СтрокаДанных.Вставить("Поступление", ?(ЗначениеЗаполнено(Выборка.ПоступлениеСтроки), Выборка.ПоступлениеСтроки, Выборка.ПоступлениеШапки));
			// Допустимое окно дат корректировки поставщика: считаем один раз, а не при каждой проверке
			СтрокаДанных.Вставить("ВерхГраница", ДобавитьМесяц(НачалоДня(Выборка.Дата), СрокКорректировкиМесяцев));
			СтрокаДанных.Вставить("НижГраница", НачалоДня(Выборка.Дата) - ДнейРаньшеВозврата * 86400);
		КонецЕсли;
		СтрокаДанных.Вставить("СортКлюч", Формат(Выборка.Дата, "ДФ=yyyyMMddHHmmss") + Выборка.Номер);
		СтрокаДанных.Вставить("Номенклатура", Выборка.Номенклатура);
		СтрокаДанных.Вставить("Количество", Количество);
		// Ключ сопоставления: номенклатура + склад + поставщик (контрагент)
		СтрокаДанных.Вставить("Ключ", Строка(Выборка.Номенклатура.УникальныйИдентификатор()) + "|"
			+ Строка(Выборка.Склад.УникальныйИдентификатор()) + "|"
			+ Строка(Выборка.Контрагент.УникальныйИдентификатор()));
		СтрокаДанных.Вставить("Склад", Выборка.Склад);
		СтрокаДанных.Вставить("Контрагент", Выборка.Контрагент);
		СтрокаДанных.Вставить("Индекс", Строки.Количество());
		Строки.Добавить(СтрокаДанных);
	КонецЦикла;
	Возврат Строки;

КонецФункции

#КонецОбласти

#Область ТочныйПодбор

// Все комбинации из 2 и более строк пула с суммой количества, равной цели (не больше ЛимитВариантов штук).
Функция СобратьВсеКомбинации(Пул, Цель, Допуск, МаксДлина, ЛимитВариантов)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Индекс");
	Таблица.Колонки.Добавить("СтрокаДанных");
	Для Каждого Элемент Из Пул Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Количество = Элемент.Количество;
		НоваяСтрока.Индекс = Элемент.Индекс;
		НоваяСтрока.СтрокаДанных = Элемент;
	КонецЦикла;
	Таблица.Сортировать("Количество Убыв, Индекс Возр");

	Отсортированные = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Отсортированные.Добавить(СтрокаТаблицы.СтрокаДанных);
	КонецЦикла;
	Размер = Отсортированные.Количество();
	Суффикс = МассивРазмера(Размер + 1);
	Суффикс[Размер] = 0;
	Для Индекс = 1 По Размер Цикл
		ТекИндекс = Размер - Индекс;
		Суффикс[ТекИндекс] = Суффикс[ТекИндекс + 1] + Отсортированные[ТекИндекс].Количество;
	КонецЦикла;

	Контекст = Новый Структура;
	Контекст.Вставить("Пул", Отсортированные);
	Контекст.Вставить("Суффикс", Суффикс);
	Контекст.Вставить("Допуск", Допуск);
	Контекст.Вставить("МаксДлина", МаксДлина);
	Контекст.Вставить("Результат", Новый Массив);
	Контекст.Вставить("ЛимитВариантов", ЛимитВариантов);
	Контекст.Вставить("Шагов", 0);
	Контекст.Вставить("ЛимитШагов", 800);
	ПоискВсехКомбинаций(Контекст, 0, Цель, Новый Массив);
	Возврат Контекст.Результат;

КонецФункции

Процедура ПоискВсехКомбинаций(Контекст, Индекс, Остаток, Выбранные)

	Если Контекст.Результат.Количество() >= Контекст.ЛимитВариантов Или Контекст.Шагов > Контекст.ЛимитШагов Тогда
		Возврат;
	КонецЕсли;
	Контекст.Шагов = Контекст.Шагов + 1;

	Если Выбранные.Количество() > Контекст.МаксДлина Тогда
		Возврат;
	КонецЕсли;
	Если МодульЧисла(Остаток) <= Контекст.Допуск И Выбранные.Количество() >= 2 Тогда
		Комбинация = Новый Массив;
		Для Каждого Элемент Из Выбранные Цикл
			Комбинация.Добавить(Элемент);
		КонецЦикла;
		Контекст.Результат.Добавить(Комбинация);
		Возврат;
	КонецЕсли;
	Если Индекс >= Контекст.Пул.Количество() Или Остаток < -Контекст.Допуск Тогда
		Возврат;
	КонецЕсли;
	Если Остаток - Контекст.Допуск > Контекст.Суффикс[Индекс] Тогда
		Возврат;
	КонецЕсли;

	Выбранные.Добавить(Контекст.Пул[Индекс]);
	ПоискВсехКомбинаций(Контекст, Индекс + 1, Остаток - Контекст.Пул[Индекс].Количество, Выбранные);
	Выбранные.Удалить(Выбранные.ВГраница());
	ПоискВсехКомбинаций(Контекст, Индекс + 1, Остаток, Выбранные);

КонецПроцедуры

// Варианты закрыть строку корректировки свободными строками возврата: сначала одна строка, затем комбинации.
Функция ВариантыРазбиения(ВозвратыПоКлючу, СтрокаКорр, Занятые, Допуск, МаксКомбинация)

	ЛимитВариантов = 8;
	Свободные = СвободныеВозвраты(ВозвратыПоКлючу, СтрокаКорр, Занятые);
	Варианты = Новый Массив;
	Для Каждого Кандидат Из Свободные Цикл
		Если МодульЧисла(Кандидат.Количество - СтрокаКорр.Количество) <= Допуск Тогда
			Вариант = Новый Массив;
			Вариант.Добавить(Кандидат);
			Варианты.Добавить(Вариант);
			Если Варианты.Количество() >= ЛимитВариантов Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Варианты.Количество() < ЛимитВариантов И ТекущаяУниверсальнаяДатаВМиллисекундах() <= ПредельныйСрок Тогда
		Пул = Свободные;
		Если Свободные.Количество() > 30 Тогда
			Пул = Новый Массив;
			Для Индекс = 0 По 29 Цикл
				Пул.Добавить(Свободные[Индекс]);
			КонецЦикла;
		КонецЕсли;
		Комбинации = СобратьВсеКомбинации(Пул, СтрокаКорр.Количество, Допуск, МаксКомбинация, ЛимитВариантов - Варианты.Количество());
		Для Каждого Комбинация Из Комбинации Цикл
			Варианты.Добавить(Комбинация);
		КонецЦикла;
	КонецЕсли;
	Возврат Варианты;

КонецФункции

Функция НайтиКореньГруппы(Родитель, Знач Индекс)

	Пока Родитель[Индекс] <> Индекс Цикл
		Родитель[Индекс] = Родитель[Родитель[Индекс]];
		Индекс = Родитель[Индекс];
	КонецЦикла;
	Возврат Индекс;

КонецФункции

// Разбивает документы корректировки на независимые группы: документы, у которых есть общая возможная
// строка возврата, попадают в одну группу (между группами строки возврата не конкурируют).
Функция ПостроитьКомпоненты(Кандидаты, ВозвратыПоКлючу)

	Размер = Кандидаты.Количество();
	Родитель = МассивРазмера(Размер);
	Для Индекс = 0 По Размер - 1 Цикл
		Родитель[Индекс] = Индекс;
	КонецЦикла;

	Владелец = Новый Соответствие;
	Для Индекс = 0 По Размер - 1 Цикл
		Для Каждого СтрокаДанных Из Кандидаты[Индекс].Строки Цикл
			Для Каждого СтрокаВозврата Из СтрокаДанных.Совместимые Цикл
				Другой = Владелец.Получить(СтрокаВозврата.Индекс);
				Если Другой = Неопределено Тогда
					Владелец.Вставить(СтрокаВозврата.Индекс, Индекс);
				Иначе
					КореньА = НайтиКореньГруппы(Родитель, Индекс);
					КореньБ = НайтиКореньГруппы(Родитель, Другой);
					Если КореньА <> КореньБ Тогда
						Родитель[Макс(КореньА, КореньБ)] = Мин(КореньА, КореньБ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Индекс = 0 По Размер - 1 Цикл
		Корень = НайтиКореньГруппы(Родитель, Индекс);
		Группа = Группы.Получить(Корень);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Корень, Группа);
			Порядок.Добавить(Группа);
		КонецЕсли;
		Группа.Добавить(Кандидаты[Индекс]);
	КонецЦикла;
	Возврат Порядок;

КонецФункции

// Жадное решение (быстрое, всегда есть): документы от коротких к длинным, документ закрываем только если ВСЕ его
// строки нашли пару. Служит стартовым вариантом: точный подбор может его только улучшить.
Функция ЖадноеРешение(Доки, ВозвратыПоКлючу, Допуск, МаксКомбинация)

	Размер = Доки.Количество();
	Занятые = Новый Соответствие;
	Назначения = МассивРазмера(Размер);
	Счёт = 0;
	Для Индекс = 0 По Размер - 1 Цикл
		Временные = Новый Соответствие;
		Пары = Новый Массив;
		ВсеНайдены = Истина;
		Использовано = 0;
		Для Каждого СтрокаДанных Из Доки[Индекс].Строки Цикл
			Доступные = СвободныеВозвраты(ВозвратыПоКлючу, СтрокаДанных, Занятые, Временные);
			Найдены = НайтиПару(Доступные, СтрокаДанных, Допуск, МаксКомбинация);
			Если Найдены = Неопределено Или Найдены.Количество() = 0 Тогда
				ВсеНайдены = Ложь;
				Прервать;
			КонецЕсли;
			Для Каждого СтрокаВозврата Из Найдены Цикл
				Временные.Вставить(СтрокаВозврата.Индекс, Истина);
			КонецЦикла;
			Пары.Добавить(Новый Структура("СтрокаДанных, Найдены", СтрокаДанных, Найдены));
			Использовано = Использовано + Найдены.Количество();
		КонецЦикла;
		Если ВсеНайдены Тогда
			Для Каждого Пара Из Пары Цикл
				Для Каждого СтрокаВозврата Из Пара.Найдены Цикл
					Занятые.Вставить(СтрокаВозврата.Индекс, Истина);
				КонецЦикла;
			КонецЦикла;
			Назначения[Индекс] = Пары;
			Счёт = Счёт + Использовано * 1000 + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Назначения, Счёт", Назначения, Счёт);

КонецФункции

// Точный подбор для одной группы документов: какие документы закрыть целиком и какими строками возврата.
// Начинает с жадного решения и улучшает его перебором, пока не истечёт КрайнийСрок (мс).
// Возвращает массив по числу документов группы: массив пар (СтрокаДанных, Найдены) или Неопределено (документ не закрываем).
Функция РешитьКомпоненту(Доки, ВозвратыПоКлючу, Допуск, МаксКомбинация, КрайнийСрок)

	Размер = Доки.Количество();

	// Оценка сверху: сколько строк возврата ещё можно закрыть документами i..конец (объединение возможных строк)
	Потенциал = МассивРазмера(Размер + 1);
	Потенциал[Размер] = 0;
	Накоплено = Новый Соответствие;
	Для Индекс = 1 По Размер Цикл
		Текущий = Размер - Индекс;
		Для Каждого СтрокаДанных Из Доки[Текущий].Строки Цикл
			Для Каждого СтрокаВозврата Из СтрокаДанных.Совместимые Цикл
				Накоплено.Вставить(СтрокаВозврата.Индекс, Истина);
			КонецЦикла;
		КонецЦикла;
		Потенциал[Текущий] = Накоплено.Количество() * 1000 + (Размер - Текущий);
	КонецЦикла;

	Жадное = ЖадноеРешение(Доки, ВозвратыПоКлючу, Допуск, МаксКомбинация);

	Контекст = Новый Структура;
	Контекст.Вставить("Доки", Доки);
	Контекст.Вставить("ВозвратыПоКлючу", ВозвратыПоКлючу);
	Контекст.Вставить("Допуск", Допуск);
	Контекст.Вставить("МаксКомбинация", МаксКомбинация);
	Контекст.Вставить("Потенциал", Потенциал);
	Контекст.Вставить("Занятые", Новый Соответствие);
	Контекст.Вставить("Назначения", МассивРазмера(Размер));
	Контекст.Вставить("ЛучшийСчёт", Жадное.Счёт);
	Контекст.Вставить("ЛучшиеНазначения", ?(Жадное.Счёт > 0, Жадное.Назначения, Неопределено));
	Контекст.Вставить("Шагов", 0);
	Контекст.Вставить("КрайнийСрок", КрайнийСрок);
	Контекст.Вставить("Время", Ложь); // время вышло
	Контекст.Вставить("ПоследнееУлучшение", ТекущаяУниверсальнаяДатаВМиллисекундах());

	// Если жадное решение уже закрывает всё возможное, перебор не нужен
	Если Жадное.Счёт < Потенциал[0] Тогда
		ПоискДокументов(Контекст, 0, 0);
	КонецЕсли;
	Возврат Контекст.ЛучшиеНазначения;

КонецФункции

Процедура ПоискДокументов(Контекст, Индекс, Счёт)

	Если Контекст.Время Тогда
		Возврат;
	КонецЕсли;

	Если Индекс >= Контекст.Доки.Количество() Тогда
		Если Счёт > Контекст.ЛучшийСчёт Тогда
			Контекст.ЛучшийСчёт = Счёт;
			Контекст.ПоследнееУлучшение = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Контекст.ЛучшиеНазначения = Новый Массив;
			Для Каждого Элемент Из Контекст.Назначения Цикл
				Контекст.ЛучшиеНазначения.Добавить(Элемент);
			КонецЦикла;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Отсечение: даже при самом удачном исходе лучшего результата не получить
	Если Счёт + Контекст.Потенциал[Индекс] <= Контекст.ЛучшийСчёт Тогда
		Возврат;
	КонецЕсли;

	// 1) закрыть документ целиком
	ПоискСтрокДокумента(Контекст, Индекс, 0, Счёт, Новый Массив, 0);
	// 2) не закрывать документ
	Если Не Контекст.Время Тогда
		ПоискДокументов(Контекст, Индекс + 1, Счёт);
	КонецЕсли;

КонецПроцедуры

Процедура ПоискСтрокДокумента(Контекст, ИндексДока, ИндексСтроки, Счёт, Пары, ИспользованоСтрок)

	Контекст.Шагов = Контекст.Шагов + 1;
	// Время вышло — прекращаем перебор, остаётся лучшее найденное решение (не хуже жадного)
	// Прекращаем при исходе времени или если давно нет улучшений (дальше перебирать бессмысленно)
	Если Контекст.Шагов % 20 = 0 Тогда
		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Сейчас > Контекст.КрайнийСрок Или Сейчас - Контекст.ПоследнееУлучшение > 1500 Тогда
			Контекст.Время = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Контекст.Время Тогда
		Возврат;
	КонецЕсли;

	Док = Контекст.Доки[ИндексДока];
	Если ИндексСтроки >= Док.Строки.Количество() Тогда
		// Все строки документа нашли пару — документ закрыт целиком
		КопияПар = Новый Массив;
		Для Каждого Элемент Из Пары Цикл
			КопияПар.Добавить(Элемент);
		КонецЦикла;
		Контекст.Назначения[ИндексДока] = КопияПар;
		ПоискДокументов(Контекст, ИндексДока + 1, Счёт + ИспользованоСтрок * 1000 + 1);
		Контекст.Назначения[ИндексДока] = Неопределено;
		Возврат;
	КонецЕсли;

	СтрокаДанных = Док.Строки[ИндексСтроки];
	Варианты = ВариантыРазбиения(Контекст.ВозвратыПоКлючу, СтрокаДанных, Контекст.Занятые, Контекст.Допуск, Контекст.МаксКомбинация);
	Для Каждого Вариант Из Варианты Цикл
		Если Контекст.Время Тогда
			Прервать;
		КонецЕсли;
		Для Каждого СтрокаВозврата Из Вариант Цикл
			Контекст.Занятые.Вставить(СтрокаВозврата.Индекс, Истина);
		КонецЦикла;
		Пары.Добавить(Новый Структура("СтрокаДанных, Найдены", СтрокаДанных, Вариант));
		ПоискСтрокДокумента(Контекст, ИндексДока, ИндексСтроки + 1, Счёт, Пары, ИспользованоСтрок + Вариант.Количество());
		Пары.Удалить(Пары.ВГраница());
		Для Каждого СтрокаВозврата Из Вариант Цикл
			Контекст.Занятые.Удалить(СтрокаВозврата.Индекс);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Алгоритм

// В языке 1С нет функции Абс.
Функция МодульЧисла(Значение)

	Возврат ?(Значение < 0, -Значение, Значение);

КонецФункции

// Подбор комбинации возвратов под количество строки корректировки (сумма подмножества).
// Пул сортируется по убыванию количества, при равенстве — по порядку появления.
Функция ПодобратьКомбинацию(Пул, Цель, Допуск, МаксДлина)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Индекс");
	Таблица.Колонки.Добавить("СтрокаДанных");
	Для Каждого Элемент Из Пул Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Количество = Элемент.Количество;
		НоваяСтрока.Индекс = Элемент.Индекс;
		НоваяСтрока.СтрокаДанных = Элемент;
	КонецЦикла;
	Таблица.Сортировать("Количество Убыв, Индекс Возр");

	Отсортированные = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Отсортированные.Добавить(СтрокаТаблицы.СтрокаДанных);
	КонецЦикла;

	Размер = Отсортированные.Количество();
	Суффикс = МассивРазмера(Размер + 1);
	Суффикс[Размер] = 0;
	Для Индекс = 1 По Размер Цикл
		ТекИндекс = Размер - Индекс;
		Суффикс[ТекИндекс] = Суффикс[ТекИндекс + 1] + Отсортированные[ТекИндекс].Количество;
	КонецЦикла;

	Контекст = Новый Структура;
	Контекст.Вставить("Пул", Отсортированные);
	Контекст.Вставить("Суффикс", Суффикс);
	Контекст.Вставить("Допуск", Допуск);
	Контекст.Вставить("МаксДлина", МаксДлина);
	Контекст.Вставить("Найдено", Ложь);
	Контекст.Вставить("Выбранные", Новый Массив);
	Контекст.Вставить("Шагов", 0);
	Контекст.Вставить("ЛимитШагов", 3000); // защита от «взрыва» перебора

	ПоискКомбинации(Контекст, 0, Цель, Новый Массив);

	Если Контекст.Найдено И Контекст.Выбранные.Количество() > 0 Тогда
		Возврат Контекст.Выбранные;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура ПоискКомбинации(Контекст, Индекс, Остаток, Выбранные)

	Если Контекст.Найдено Или Контекст.Шагов > Контекст.ЛимитШагов Тогда
		Возврат;
	КонецЕсли;
	Контекст.Шагов = Контекст.Шагов + 1;

	Если Выбранные.Количество() > Контекст.МаксДлина Тогда
		Возврат;
	КонецЕсли;
	Если МодульЧисла(Остаток) <= Контекст.Допуск Тогда
		Контекст.Найдено = Истина;
		Контекст.Выбранные = Новый Массив;
		Для Каждого Элемент Из Выбранные Цикл
			Контекст.Выбранные.Добавить(Элемент);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Если Индекс >= Контекст.Пул.Количество() Или Остаток < -Контекст.Допуск Тогда
		Возврат;
	КонецЕсли;
	Если Остаток - Контекст.Допуск > Контекст.Суффикс[Индекс] Тогда
		Возврат;
	КонецЕсли;

	Выбранные.Добавить(Контекст.Пул[Индекс]);
	ПоискКомбинации(Контекст, Индекс + 1, Остаток - Контекст.Пул[Индекс].Количество, Выбранные);
	Выбранные.Удалить(Выбранные.ВГраница());
	Если Контекст.Найдено Тогда
		Возврат;
	КонецЕсли;
	ПоискКомбинации(Контекст, Индекс + 1, Остаток, Выбранные);

КонецПроцедуры

// Ищет пару для строки корректировки среди свободных возвратов того же ключа.
Функция НайтиПару(Доступные, СтрокаДанных, Допуск, МаксКомбинация)

	Если Доступные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Кандидат Из Доступные Цикл
		Если МодульЧисла(Кандидат.Количество - СтрокаДанных.Количество) <= Допуск Тогда
			Результат = Новый Массив;
			Результат.Добавить(Кандидат);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	// Комбинации — дорогая часть: после предельного срока ищем только одиночные совпадения
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ПредельныйСрок Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Для комбинаций берём не больше 30 первых (по порядку возвратов) подходящих строк
	Если Доступные.Количество() > 30 Тогда
		Пул = Новый Массив;
		Для Индекс = 0 По 29 Цикл
			Пул.Добавить(Доступные[Индекс]);
		КонецЦикла;
		Возврат ПодобратьКомбинацию(Пул, СтрокаДанных.Количество, Допуск, МаксКомбинация);
	КонецЕсли;
	Возврат ПодобратьКомбинацию(Доступные, СтрокаДанных.Количество, Допуск, МаксКомбинация);

КонецФункции

// Можно ли сопоставлять строку возврата со строкой корректировки:
// 1. Срок: корректировка поставщика не позже заданного срока (по умолчанию 3 месяца) после возврата и, как правило,
//    не раньше возврата. Возврат могут провести уже после прихода корректировки, поэтому допускается корректировка
//    раньше возврата не более чем на ДнейРаньшеВозврата дней; если в возврате явно указано то же поступление,
//    что и в основании корректировки, нижняя граница не применяется.
//    Берётся дата документа поставщика (входящая дата), а если её нет — дата корректировки.
// 2. Поступление, по которому пришла корректировка, раньше возврата (нельзя вернуть товар, которого ещё не было).
// 3. Если в возврате указано поступление — оно должно совпасть с основанием корректировки.
Функция СовместимыПоПоступлению(СтрокаВозврата, СтрокаКорр)

	// Срок: не позже верхней границы; раньше нижней — только при явной связи по поступлению
	Если СтрокаКорр.ДатаКорр > СтрокаВозврата.ВерхГраница Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаКорр.ДатаКорр < СтрокаВозврата.НижГраница Тогда
		Если Не (ЗначениеЗаполнено(СтрокаВозврата.Поступление) И СтрокаВозврата.Поступление = СтрокаКорр.Основание) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	// Поступление корректировки не позже возврата
	Если СтрокаКорр.ДатаОснования <> Неопределено Тогда
		Если СтрокаКорр.ДатаОснования > СтрокаВозврата.Дата Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаВозврата.Поступление) Тогда
		Возврат СтрокаВозврата.Поступление = СтрокаКорр.Основание;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Совместимые (по срокам и поступлению) строки возврата той же номенклатуры, склада и поставщика — считаются один раз.
Процедура ЗаполнитьСовместимые(ВозвратыПоКлючу, СтрокаКорр)

	Совместимые = Новый Массив;
	Список = ВозвратыПоКлючу.Получить(СтрокаКорр.Ключ);
	Если Список <> Неопределено Тогда
		Для Каждого СтрокаВозврата Из Список Цикл
			Если СовместимыПоПоступлению(СтрокаВозврата, СтрокаКорр) Тогда
				Совместимые.Добавить(СтрокаВозврата);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СтрокаКорр.Вставить("Совместимые", Совместимые);

КонецПроцедуры

// Свободные совместимые строки возврата для строки корректировки. Строки, количество которых больше нужного,
// в подборе участвовать не могут — отбрасываем сразу (так перебор комбинаций остаётся небольшим).
Функция СвободныеВозвраты(ВозвратыПоКлючу, СтрокаКорр, Занятые, Занятые2 = Неопределено)

	Результат = Новый Массив;
	Предел = СтрокаКорр.Количество + 0.5;
	Для Каждого Элемент Из СтрокаКорр.Совместимые Цикл
		Если Элемент.Количество > Предел Тогда
			Продолжить;
		КонецЕсли;
		Если Занятые.Получить(Элемент.Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Занятые2 <> Неопределено И Занятые2.Получить(Элемент.Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтатусПоСовпадению(Совпало, Всего)

	Если Совпало = Всего Тогда
		Возврат "full";
	ИначеЕсли Совпало > 0 Тогда
		Возврат "partial";
	КонецЕсли;
	Возврат "none";

КонецФункции

Функция ВыполнитьСверку(СтрокиВозвратов, СтрокиКорректировок, Допуск, МаксКомбинация)

	// Возвраты по ключу
	ВозвратыПоКлючу = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокиВозвратов Цикл
		Список = ВозвратыПоКлючу.Получить(СтрокаДанных.Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ВозвратыПоКлючу.Вставить(СтрокаДанных.Ключ, Список);
		КонецЕсли;
		Список.Добавить(СтрокаДанных);
	КонецЦикла;

	// Документы корректировки (порядок появления)
	ПорядокКорр = Новый Массив;
	ДокиКорр = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокиКорректировок Цикл
		Док = ДокиКорр.Получить(СтрокаДанных.ДокументКлюч);
		Если Док = Неопределено Тогда
			Док = Новый Структура("Документ, Номер, Дата, Проведен, Основание, СортКлюч, Строки, Значимая, Закрыта, Склад");
			Док.Основание = СтрокаДанных.Основание;
			Док.Проведен = СтрокаДанных.Проведен;
			Док.Документ = СтрокаДанных.Документ;
			Док.Номер = СтрокаДанных.Номер;
			Док.Дата = СтрокаДанных.Дата;
			Док.СортКлюч = СтрокаДанных.СортКлюч;
			Док.Склад = СтрокаДанных.Склад;
			Док.Строки = Новый Массив;
			Док.Значимая = Ложь;
			Док.Закрыта = Ложь;
			ДокиКорр.Вставить(СтрокаДанных.ДокументКлюч, Док);
			ПорядокКорр.Добавить(Док);
		КонецЕсли;
		Док.Строки.Добавить(СтрокаДанных);
		ЗаполнитьСовместимые(ВозвратыПоКлючу, СтрокаДанных);
		Если СтрокаДанных.Совместимые.Количество() > 0 Тогда
			Док.Значимая = Истина;
		КонецЕсли;
	КонецЦикла;

	// Кандидаты: от меньших документов к большим
	ТаблицаКандидатов = Новый ТаблицаЗначений;
	ТаблицаКандидатов.Колонки.Добавить("КолвоСтрок");
	ТаблицаКандидатов.Колонки.Добавить("СортКлюч");
	ТаблицаКандидатов.Колонки.Добавить("Док");
	Для Каждого Док Из ПорядокКорр Цикл
		Если Не Док.Значимая Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаКандидатов.Добавить();
		НоваяСтрока.КолвоСтрок = Док.Строки.Количество();
		НоваяСтрока.СортКлюч = Док.СортКлюч;
		НоваяСтрока.Док = Док;
	КонецЦикла;
	ТаблицаКандидатов.Сортировать("КолвоСтрок Возр, СортКлюч Возр");
	Кандидаты = ТаблицаКандидатов.ВыгрузитьКолонку("Док");

	Занятые = Новый Соответствие;          // индекс строки возврата -> Истина
	СовпадениеСтрокиКорр = Новый Соответствие; // индекс строки корректировки -> массив строк возврата
	ПараПоВозврату = Новый Соответствие;       // индекс строки возврата -> строка корректировки

	// Раунд 1: точный подбор по компонентам. Закрываем ЦЕЛИКОМ те документы корректировки, которые дают максимум
	// закрытых строк возврата (при равенстве — больше документов), а не «первые подошедшие».
	Компоненты = ПостроитьКомпоненты(Кандидаты, ВозвратыПоКлючу);
	КонецОбщегоВремени = ТекущаяУниверсальнаяДатаВМиллисекундах() + ВремяПодбораМс;
	ОсталосьКомпонент = Компоненты.Количество();
	Для Каждого Компонента Из Компоненты Цикл
		// Время делится поровну между оставшимися группами; неиспользованное достаётся следующим
		ОсталосьВремени = Макс(КонецОбщегоВремени - ТекущаяУниверсальнаяДатаВМиллисекундах(), 0);
		КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Окр(ОсталосьВремени / ОсталосьКомпонент);
		ОсталосьКомпонент = ОсталосьКомпонент - 1;
		Решение = РешитьКомпоненту(Компонента, ВозвратыПоКлючу, Допуск, МаксКомбинация, КрайнийСрок);
		Если Решение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 0 По Компонента.ВГраница() Цикл
			ПарыДока = Решение[Индекс];
			Если ПарыДока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Пара Из ПарыДока Цикл
				ЗафиксироватьПару(Пара.СтрокаДанных, Пара.Найдены, Занятые, СовпадениеСтрокиКорр, ПараПоВозврату);
			КонецЦикла;
			Компонента[Индекс].Закрыта = Истина;
		КонецЦикла;
	КонецЦикла;

	// Раунд 2: частичные совпадения для остальных документов
	Для Каждого Док Из Кандидаты Цикл
		Если Док.Закрыта Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Если СовпадениеСтрокиКорр.Получить(СтрокаДанных.Индекс) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Доступные = СвободныеВозвраты(ВозвратыПоКлючу, СтрокаДанных, Занятые);
			Найдены = НайтиПару(Доступные, СтрокаДанных, Допуск, МаксКомбинация);
			Если Найдены <> Неопределено И Найдены.Количество() > 0 Тогда
				ЗафиксироватьПару(СтрокаДанных, Найдены, Занятые, СовпадениеСтрокиКорр, ПараПоВозврату);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Результат по документам корректировки (справочно)
	ИтогКорректировки = Новый Массив;
	КорректировкаПоКлючу = Новый Соответствие;
	Для Каждого Док Из ПорядокКорр Цикл
		Если Не Док.Значимая Тогда
			Продолжить;
		КонецЕсли;
		Совпало = 0;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Если СовпадениеСтрокиКорр.Получить(СтрокаДанных.Индекс) <> Неопределено Тогда
				Совпало = Совпало + 1;
			КонецЕсли;
		КонецЦикла;
		Запись = Новый Структура;
		Запись.Вставить("Документ", Док.Документ);
		Запись.Вставить("Номер", Док.Номер);
		Запись.Вставить("Дата", Док.Дата);
		Запись.Вставить("Проведен", Док.Проведен);
		Запись.Вставить("Основание", Док.Основание);
		Запись.Вставить("Склад", Док.Склад);
		Запись.Вставить("Всего", Док.Строки.Количество());
		Запись.Вставить("Совпало", Совпало);
		Запись.Вставить("Статус", СтатусПоСовпадению(Совпало, Док.Строки.Количество()));
		Запись.Вставить("Возвраты", Новый Массив);
		ИтогКорректировки.Добавить(Запись);
		КорректировкаПоКлючу.Вставить(Строка(Док.Документ.УникальныйИдентификатор()), Запись);
	КонецЦикла;

	// Результат по документам возврата (главный)
	ПорядокВозвратов = Новый Массив;
	ДокиВозвратов = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокиВозвратов Цикл
		Док = ДокиВозвратов.Получить(СтрокаДанных.ДокументКлюч);
		Если Док = Неопределено Тогда
			Док = Новый Структура("Документ, Номер, Дата, Склад, Контрагент, Строки");
			Док.Документ = СтрокаДанных.Документ;
			Док.Номер = СтрокаДанных.Номер;
			Док.Дата = СтрокаДанных.Дата;
			Док.Склад = СтрокаДанных.Склад;
			Док.Контрагент = СтрокаДанных.Контрагент;
			Док.Строки = Новый Массив;
			ДокиВозвратов.Вставить(СтрокаДанных.ДокументКлюч, Док);
			ПорядокВозвратов.Добавить(Док);
		КонецЕсли;
		Док.Строки.Добавить(СтрокаДанных);
	КонецЦикла;

	ИтогВозвраты = Новый Массив;
	Для Каждого Док Из ПорядокВозвратов Цикл
		Совпало = 0;
		Детали = Новый Массив;
		СписокКорр = Новый Массив;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Пара = ПараПоВозврату.Получить(СтрокаДанных.Индекс);
			Деталь = Новый Структура;
			Деталь.Вставить("Номенклатура", СтрокаДанных.Номенклатура);
			Деталь.Вставить("Количество", СтрокаДанных.Количество);
			Если Пара <> Неопределено Тогда
				Совпало = Совпало + 1;
				Деталь.Вставить("Корректировка", Пара.Документ);
				Деталь.Вставить("КорректировкаНомер", Пара.Номер);
				Деталь.Вставить("КоличествоКорр", Пара.Количество);
				Если СписокКорр.Найти(Пара.Документ) = Неопределено Тогда
					СписокКорр.Добавить(Пара.Документ);
				КонецЕсли;
			Иначе
				Деталь.Вставить("Корректировка", Неопределено);
				Деталь.Вставить("КорректировкаНомер", "");
				Деталь.Вставить("КоличествоКорр", 0);
			КонецЕсли;
			Детали.Добавить(Деталь);
		КонецЦикла;

		Статус = СтатусПоСовпадению(Совпало, Док.Строки.Количество());
		НеГотовые = Новый Массив;
		Если Статус = "full" Тогда
			// Возврат можно удалять, только если каждая закрывающая корректировка тоже закрыта полностью
			Для Каждого КорректировкаСсылка Из СписокКорр Цикл
				ЗаписьКорр = КорректировкаПоКлючу.Получить(Строка(КорректировкаСсылка.УникальныйИдентификатор()));
				Если ЗаписьКорр <> Неопределено И ЗаписьКорр.Статус <> "full" Тогда
					НеГотовые.Добавить(ЗаписьКорр.Номер);
				КонецЕсли;
			КонецЦикла;
			Если НеГотовые.Количество() > 0 Тогда
				Статус = "partial";
			КонецЕсли;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("Документ", Док.Документ);
		Запись.Вставить("Номер", Док.Номер);
		Запись.Вставить("Дата", Док.Дата);
		Запись.Вставить("Склад", Док.Склад);
		Запись.Вставить("Контрагент", Док.Контрагент);
		Запись.Вставить("Всего", Док.Строки.Количество());
		Запись.Вставить("Совпало", Совпало);
		Запись.Вставить("Статус", Статус);
		Запись.Вставить("НеГотовыеКорректировки", НеГотовые);
		Запись.Вставить("Корректировки", СписокКорр);
		Запись.Вставить("Детали", Детали);
		ИтогВозвраты.Добавить(Запись);

		// Обратная связь для таблицы корректировок
		Для Каждого КорректировкаСсылка Из СписокКорр Цикл
			ЗаписьКорр = КорректировкаПоКлючу.Получить(Строка(КорректировкаСсылка.УникальныйИдентификатор()));
			Если ЗаписьКорр <> Неопределено Тогда
				ЗаписьКорр.Возвраты.Добавить(Док.Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Возвраты", ИтогВозвраты);
	Результат.Вставить("Корректировки", ИтогКорректировки);
	Возврат Результат;

КонецФункции

Процедура ЗафиксироватьПару(СтрокаДанных, Найдены, Занятые, СовпадениеСтрокиКорр, ПараПоВозврату)

	СовпадениеСтрокиКорр.Вставить(СтрокаДанных.Индекс, Найдены);
	Для Каждого СтрокаВозврата Из Найдены Цикл
		Занятые.Вставить(СтрокаВозврата.Индекс, Истина);
		ПараПоВозврату.Вставить(СтрокаВозврата.Индекс, СтрокаДанных);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Проведение

// Проводит цепочки корректировок приобретения (К1 -> К2 -> К3 одного поступления) по порядку даты и времени.
// Перед проведением каждой корректировки, у которой есть предыдущая в цепочке, как команда формы
// «Заполнить корректируемые данные» перезаполняется вкладка «Товары» по состоянию после предыдущей.
// Вместе с корректировкой проводится связанная счёт-фактура. Ошибка в цепочке останавливает только её.
//
// Параметры:
//	Параметры - Структура - Корректировки (Массив структур Ссылка, ДатаПроведения), ПробныйРежим, ЛимитЦепочек,
//		ПроводитьСчетаФактуры, Сопоставленные (Массив структур Ссылка, ДатаПроведения — корректировки, сопоставленные с
//		возвратами и допустимые как «предыдущие» в цепочке)
//
// Возвращаемое значение:
//	Массив - записи журнала: Основание, Корректировка, Номер, Успех (Истина/Ложь/Неопределено), Сообщение
//
Функция ПровестиЦепочки(Параметры) Экспорт

	Журнал = Новый Массив;

	ВыбранныеДаты = Новый Соответствие;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Параметры.Корректировки Цикл
		ВыбранныеДаты.Вставить(Элемент.Ссылка, Элемент.ДатаПроведения);
		Ссылки.Добавить(Элемент.Ссылка);
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Журнал;
	КонецЕсли;

	// Поступления (основания) выбранных корректировок
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.ДокументОснование КАК Основание
	|ИЗ
	|	Документ.КорректировкаПриобретения КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Основания = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Основание");

	// Все не удалённые корректировки этих поступлений — целая цепочка по порядку даты и времени
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Проведен КАК Проведен,
	|	Док.ДокументОснование КАК Основание
	|ИЗ
	|	Документ.КорректировкаПриобретения КАК Док
	|ГДЕ
	|	Док.ДокументОснование В(&Основания)
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка";
	Запрос.УстановитьПараметр("Основания", Основания);
	Выборка = Запрос.Выполнить().Выбрать();

	Цепочки = Новый Соответствие;
	ПорядокЦепочек = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список = Цепочки.Получить(Выборка.Основание);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Цепочки.Вставить(Выборка.Основание, Список);
			ПорядокЦепочек.Добавить(Выборка.Основание);
		КонецЕсли;
		Элемент = Новый Структура("Ссылка, Дата, Номер, Проведен, Условно");
		ЗаполнитьЗначенияСвойств(Элемент, Выборка);
		Элемент.Условно = Ложь;
		Список.Добавить(Элемент);
	КонецЦикла;

	// Сопоставленные с возвратами корректировки: только их можно провести как «предыдущие» в цепочке
	Сопоставленные = Новый Соответствие;
	Если Параметры.Свойство("Сопоставленные") Тогда
		Для Каждого Элемент Из Параметры.Сопоставленные Цикл
			Сопоставленные.Вставить(Элемент.Ссылка, Элемент.ДатаПроведения);
		КонецЦикла;
	КонецЕсли;

	// Пробный режим: корректировки, «проведённые» для предыдущих возвратов, считаем проведёнными
	Условные = Новый Соответствие;
	Если Параметры.Свойство("УсловноПроведены") Тогда
		Для Каждого Условная Из Параметры.УсловноПроведены Цикл
			Условные.Вставить(Условная, Истина);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Основание Из ПорядокЦепочек Цикл
		Для Каждого Элемент Из Цепочки.Получить(Основание) Цикл
			Если Условные.Получить(Элемент.Ссылка) <> Неопределено Тогда
				Элемент.Проведен = Истина;
				Элемент.Условно = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ОбработаноЦепочек = 0;
	Для Каждого Основание Из ПорядокЦепочек Цикл
		Список = Цепочки.Получить(Основание);
		ЕстьВыбранные = Ложь;
		Для Каждого Элемент Из Список Цикл
			Если Не Элемент.Проведен И ВыбранныеДаты.Получить(Элемент.Ссылка) <> Неопределено Тогда
				ЕстьВыбранные = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьВыбранные Тогда
			Продолжить;
		КонецЕсли;

		Если Не Параметры.ПробныйРежим И ОбработаноЦепочек >= Параметры.ЛимитЦепочек Тогда
			ДобавитьВЖурнал(Журнал, Основание, Неопределено, "", Неопределено,
				"Цепочка пропущена: достигнут лимит цепочек за один запуск (" + Параметры.ЛимитЦепочек + ")");
			Продолжить;
		КонецЕсли;
		ОбработаноЦепочек = ОбработаноЦепочек + 1;

		ПровестиЦепочку(Основание, Список, ВыбранныеДаты, Сопоставленные, Параметры, Журнал);
	КонецЦикла;

	Возврат Журнал;

КонецФункции

Процедура ПровестиЦепочку(Основание, Список, ВыбранныеДаты, Сопоставленные, Параметры, Журнал)

	ПредыдущаяДата = Неопределено;   // дата предыдущего документа цепочки (фактическая или планируемая)
	ЕстьПредыдущая = Ложь;           // раньше в цепочке уже есть проведённая корректировка
	СимуляцияПредыдущей = Ложь;      // в пробном режиме: предыдущие «проведены» только условно
	Остановлена = Ложь;
	НеВыбраннаяНомер = Неопределено;

	// Индекс последней выбранной непроведённой корректировки: всё непроведённое раньше неё — «предыдущие»
	ПоследнийВыбранный = -1;
	Для Индекс = 0 По Список.ВГраница() Цикл
		Если Не Список[Индекс].Проведен И ВыбранныеДаты.Получить(Список[Индекс].Ссылка) <> Неопределено Тогда
			ПоследнийВыбранный = Индекс;
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По Список.ВГраница() Цикл
		Элемент = Список[Индекс];

		Если Элемент.Проведен Тогда
			ПредыдущаяДата = Элемент.Дата;
			ЕстьПредыдущая = Истина;
			Если Элемент.Условно Тогда
				СимуляцияПредыдущей = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Добавлена = Ложь;
		ДатаПроведения = ВыбранныеДаты.Получить(Элемент.Ссылка);
		Если ДатаПроведения = Неопределено Тогда
			ДатаСопоставленной = Сопоставленные.Получить(Элемент.Ссылка);
			Если ДатаСопоставленной <> Неопределено И Индекс < ПоследнийВыбранный И Не Остановлена Тогда
				// Не выбрана, но сопоставлена с возвратами и стоит в цепочке раньше выбранной: проводим её тоже
				// (порядок цепочки нельзя нарушать)
				ДатаПроведения = ДатаСопоставленной;
				Добавлена = Истина;
			Иначе
				// Непроведённая и НЕ сопоставленная: через неё последующие проводить нельзя — цепочка останавливается
				Если НеВыбраннаяНомер = Неопределено Тогда
					НеВыбраннаяНомер = Элемент.Номер;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Если Остановлена Тогда
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Неопределено,
				"Пропущена: цепочка остановлена из-за ошибки выше");
			Продолжить;
		КонецЕсли;

		Если НеВыбраннаяНомер <> Неопределено Тогда
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Ложь,
				"Не проведена: раньше в цепочке стоит непроведённая корректировка № " + НеВыбраннаяНомер
				+ ", которая не сопоставилась с возвратами (или сопоставилась не полностью). Проведение цепочки остановлено на ней: "
				+ "проведите её вручную или дождитесь недостающих документов.");
			Остановлена = Истина;
			Продолжить;
		КонецЕсли;

		НоваяДата = НоваяДатаДокумента(Элемент.Дата, ДатаПроведения);
		Если ПредыдущаяДата <> Неопределено Тогда
			Если НоваяДата <= ПредыдущаяДата И НачалоДня(НоваяДата) = НачалоДня(ПредыдущаяДата) Тогда
				// Тот же день, но время исходной даты нарушает порядок цепочки: ставим сразу после предыдущей
				НоваяДата = ПредыдущаяДата + 1;
				Если НачалоДня(НоваяДата) <> НачалоДня(ПредыдущаяДата) Тогда
					НоваяДата = ПредыдущаяДата;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ДатаНарушает = Ложь;
		Если ПредыдущаяДата <> Неопределено Тогда
			ДатаНарушает = (НоваяДата <= ПредыдущаяДата);
		КонецЕсли;
		Если ДатаНарушает Тогда
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Ложь,
				"Не проведена: дата проведения " + Формат(НоваяДата, "ДФ='dd.MM.yyyy HH:mm'")
				+ " не позже предыдущей корректировки цепочки (" + Формат(ПредыдущаяДата, "ДФ='dd.MM.yyyy HH:mm'")
				+ "). Измените дату проведения.");
			Остановлена = Истина;
			Продолжить;
		КонецЕсли;

		Описание = ?(Добавлена, "добавлена как предыдущая в цепочке (сопоставлена с другим возвратом); ", "");
		НачатьТранзакцию();
		Попытка
			Док = Элемент.Ссылка.ПолучитьОбъект();

			Если Док.Дата <> НоваяДата Тогда
				Описание = Описание + "дата " + Формат(Док.Дата, "ДФ='dd.MM.yyyy HH:mm'") + " -> "
					+ Формат(НоваяДата, "ДФ='dd.MM.yyyy HH:mm'") + "; ";
				Док.Дата = НоваяДата;
			КонецЕсли;

			Если ЕстьПредыдущая Тогда
				Если СимуляцияПредыдущей Тогда
					Описание = Описание + "Товары будут перезаполнены после проведения предыдущей; ";
				Иначе
					ОтличияТоваров = ОтличияТоваровОтОжидаемых(Док);
					Если ПустаяСтрока(ОтличияТоваров) Тогда
						Описание = Описание + "Товары уже соответствуют состоянию после предыдущей корректировки, перезаполнение не требуется; ";
					Иначе
						ТекстПредупреждения = ЗаполнитьТоварыПоИсходнымДанным(Док);
						Описание = Описание + "Товары перезаполнены по состоянию после предыдущей (было отличие: " + ОтличияТоваров + "); ";
						Если Не ПустаяСтрока(ТекстПредупреждения) Тогда
							ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Неопределено, ТекстПредупреждения);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

			Если Параметры.ПробныйРежим Тогда
				Если Не СимуляцияПредыдущей Тогда
					Если Не Док.ПроверитьЗаполнение() Тогда
						ВызватьИсключение "Не пройдена проверка заполнения документа (подробности в сообщениях)";
					КонецЕсли;
					Описание = Описание + "проверка заполнения пройдена; ";
				КонецЕсли;
				СчетаФактуры = НайтиСчетаФактуры(Элемент.Ссылка);
				Описание = Описание + "связанных счетов-фактур: " + СчетаФактуры.Количество() + "; ";
				ОтменитьТранзакцию();
				СимуляцияПредыдущей = Истина;
				ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Неопределено,
					"ПРОБНЫЙ РЕЖИМ, ничего не записано: " + Описание + "будет проведена", Истина);
			Иначе
				Док.Записать(РежимЗаписиДокумента.Проведение);
				Описание = Описание + "проведена; ";
				Если Параметры.ПроводитьСчетаФактуры Тогда
					Описание = Описание + ПровестиСчетаФактуры(Док);
				КонецЕсли;
				ЗафиксироватьТранзакцию();
				ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Истина, Описание);
			КонецЕсли;

			ПредыдущаяДата = НоваяДата;
			ЕстьПредыдущая = Истина;

		Исключение
			ОтменитьТранзакцию();
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Ложь,
				"Ошибка, документ не проведён: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Остановлена = Истина;
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Дата проведения — только день; время суток сохраняется от исходной даты документа,
// чтобы порядок корректировок внутри одного дня не изменился.
Функция НоваяДатаДокумента(ТекущаяДатаДокумента, ДатаПроведения)

	Если НачалоДня(ТекущаяДатаДокумента) = НачалоДня(ДатаПроведения) Тогда
		Возврат ТекущаяДатаДокумента;
	КонецЕсли;
	Возврат НачалоДня(ДатаПроведения) + (ТекущаяДатаДокумента - НачалоДня(ТекущаяДатаДокумента));

КонецФункции

// То же, что команда формы «Заполнить корректируемые данные».
// Возвращает текст предупреждения или пустую строку.
Функция ЗаполнитьТоварыПоИсходнымДанным(Док)

	Документы.КорректировкаПриобретения.ЗаполнитьТоварыПоИсходнымДанным(Док.ДокументОснование, Док.Товары, Док.Ссылка);

	// Как в форме: собственная копия настройки счетов учёта у каждой строки
	ТекстПредупреждения = "";
	Попытка
		Для Каждого СтрокаТовара Из Док.Товары Цикл
			СтрокаТовара.НастройкаСчетовУчета = НастройкаСчетовУчетаСервер.КопияНастройкиСчетовУчета(СтрокаТовара.НастройкаСчетовУчета, Док);
		КонецЦикла;
	Исключение
		ТекстПредупреждения = "Не удалось скопировать настройки счетов учёта строк (документ настроит их при записи): "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ТекстПредупреждения;

КонецФункции

// Сравнивает «Товары» корректировки с тем, что получилось бы после «Заполнить корректируемые данные»
// (учёт предыдущих проведённых корректировок и собственных расхождений делает сама конфигурация,
// поэтому знак расхождения вручную не вычисляется). Пустая строка — отличий нет; иначе краткое описание отличий.
Функция ОтличияТоваровОтОжидаемых(Док)

	Эталон = Док.Ссылка.ПолучитьОбъект();
	Попытка
		ЗаполнитьТоварыПоИсходнымДанным(Эталон);
	Исключение
		Возврат "не удалось получить ожидаемые товары: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТекущиеКоличества = КоличестваПоНоменклатуре(Док.Товары);
	ОжидаемыеКоличества = КоличестваПоНоменклатуре(Эталон.Товары);
	Отличия = "";
	Счётчик = 0;
	Для Каждого Пара Из ОжидаемыеКоличества Цикл
		Текущее = ТекущиеКоличества.Получить(Пара.Ключ);
		Если Текущее = Неопределено Тогда
			Текущее = 0;
		КонецЕсли;
		Если МодульЧисла(Текущее - Пара.Значение.Количество) > 0.0005 Тогда
			Счётчик = Счётчик + 1;
			Если Счётчик <= 3 Тогда
				Отличия = Отличия + ?(Отличия = "", "", ", ") + Пара.Значение.Представление + " " + Текущее + " вместо " + Пара.Значение.Количество;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Пара Из ТекущиеКоличества Цикл
		Если ОжидаемыеКоличества.Получить(Пара.Ключ) = Неопределено И МодульЧисла(Пара.Значение.Количество) > 0.0005 Тогда
			Счётчик = Счётчик + 1;
			Если Счётчик <= 3 Тогда
				Отличия = Отличия + ?(Отличия = "", "", ", ") + Пара.Значение.Представление + " " + Пара.Значение.Количество + " вместо отсутствия";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Счётчик > 3 Тогда
		Отличия = Отличия + " и ещё " + (Счётчик - 3);
	КонецЕсли;
	Возврат Отличия;

КонецФункции

// Суммарные количества табличной части «Товары» по номенклатуре и характеристике.
Функция КоличестваПоНоменклатуре(Товары)

	Результат = Новый Соответствие;
	// У табличной части документа нет свойства «Колонки» — берём её копию-таблицу значений
	ТаблицаТоваров = Товары.Выгрузить();
	ЕстьХарактеристика = (ТаблицаТоваров.Колонки.Найти("Характеристика") <> Неопределено);
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Ключ = Строка(СтрокаТовара.Номенклатура.УникальныйИдентификатор());
		Представление = Строка(СтрокаТовара.Номенклатура);
		Если ЕстьХарактеристика И ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
			Ключ = Ключ + "|" + Строка(СтрокаТовара.Характеристика.УникальныйИдентификатор());
			Представление = Представление + " (" + Строка(СтрокаТовара.Характеристика) + ")";
		КонецЕсли;
		Запись = Результат.Получить(Ключ);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура("Количество, Представление", 0, Представление);
			Результат.Вставить(Ключ, Запись);
		КонецЕсли;
		Запись.Количество = Запись.Количество + СтрокаТовара.Количество;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверка цепочек корректировок одного поступления (только чтение, ничего не записывает).
// Ожидаемые «Товары» каждой корректировки: количества поступления, последовательно изменённые «Расхождениями»
// всех корректировок цепочки по порядку даты (расхождение со знаком: -1 уменьшает, +1 увеличивает).
// Фактические «Товары» корректировки сравниваются с ожидаемыми.
// Возвращает массив структур: Основание, НомерВЦепочке, ВсегоВЦепочке, Документ, Номер, Дата, Проведен,
// Статус ("ok" — заполнена верно, "redo" — нужно перезаполнить, "nodata" — проверить нельзя), Отличия.
Функция ПроверитьЦепочки(Основания) Экспорт

	Результат = Новый Массив;
	Если Основания.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ЗакупкиОснований = Новый Массив;
	Для Каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			ЗакупкиОснований.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;

	// Количества поступлений
	БазовыеКоличества = Новый Соответствие;
	Если ЗакупкиОснований.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Номенклатура КАК Номенклатура,
		|	СУММА(Т.Количество) КАК Количество
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка В(&Основания)
		|СГРУППИРОВАТЬ ПО
		|	Т.Ссылка,
		|	Т.Номенклатура";
		Запрос.УстановитьПараметр("Основания", ЗакупкиОснований);
		КоличестваВСоответствие(Запрос.Выполнить().Выгрузить(), БазовыеКоличества);
	КонецЕсли;

	// Корректировки поступлений, по порядку даты
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Проведен КАК Проведен,
	|	Док.ДокументОснование КАК Основание,
	|	Док.Склад КАК Склад
	|ИЗ
	|	Документ.КорректировкаПриобретения КАК Док
	|ГДЕ
	|	Док.ДокументОснование В(&Основания)
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	Запрос.УстановитьПараметр("Основания", Основания);
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();

	// Фактические «Товары» и расхождения (со знаком, все варианты отражения)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура КАК Номенклатура,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	Документ.КорректировкаПриобретения.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.ДокументОснование В(&Основания)
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Т.Ссылка,
	|	Т.Номенклатура";
	Запрос.УстановитьПараметр("Основания", Основания);
	ТоварыДокументов = Новый Соответствие;
	КоличестваВСоответствие(Запрос.Выполнить().Выгрузить(), ТоварыДокументов);

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КорректировкаПриобретения.Товары", "КорректировкаПриобретения.Расхождения");
	РасхожденияДокументов = Новый Соответствие;
	КоличестваВСоответствие(Запрос.Выполнить().Выгрузить(), РасхожденияДокументов);

	// Документы по основаниям
	ДокументыПоОснованию = Новый Соответствие;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Список = ДокументыПоОснованию.Получить(СтрокаДокумента.Основание);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ДокументыПоОснованию.Вставить(СтрокаДокумента.Основание, Список);
		КонецЕсли;
		Список.Добавить(СтрокаДокумента);
	КонецЦикла;

	Для Каждого Элемент Из ДокументыПоОснованию Цикл
		Основание = Элемент.Ключ;
		Список = Элемент.Значение;
		Ожидаемые = Неопределено;
		Если БазовыеКоличества.Получить(Основание) <> Неопределено Тогда
			Ожидаемые = КопияКоличеств(БазовыеКоличества.Получить(Основание));
		КонецЕсли;
		НомерВЦепочке = 0;
		Для Каждого СтрокаДокумента Из Список Цикл
			НомерВЦепочке = НомерВЦепочке + 1;
			Запись = Новый Структура;
			Запись.Вставить("Основание", Основание);
			Запись.Вставить("НомерВЦепочке", НомерВЦепочке);
			Запись.Вставить("ВсегоВЦепочке", Список.Количество());
			Запись.Вставить("Документ", СтрокаДокумента.Ссылка);
			Запись.Вставить("Номер", СтрокаДокумента.Номер);
			Запись.Вставить("Дата", СтрокаДокумента.Дата);
			Запись.Вставить("Проведен", СтрокаДокумента.Проведен);
			Запись.Вставить("Склад", СтрокаДокумента.Склад);
			Запись.Вставить("Статус", "nodata");
			Запись.Вставить("Отличия", "");
			Запись.Вставить("Ожидаемые", Неопределено);
			Если Ожидаемые = Неопределено Тогда
				Запись.Отличия = "основание не «Приобретение товаров и услуг» либо в нём нет товаров — проверить нельзя";
			Иначе
				Расхождения = РасхожденияДокументов.Получить(СтрокаДокумента.Ссылка);
				Если Расхождения <> Неопределено Тогда
					Для Каждого Строка_ Из Расхождения Цикл
						Запись_ = Ожидаемые.Получить(Строка_.Ключ);
						Если Запись_ = Неопределено Тогда
							Запись_ = Новый Структура("Количество, Представление, Причина", 0, Строка_.Значение.Представление, "");
							Ожидаемые.Вставить(Строка_.Ключ, Запись_);
						КонецЕсли;
						Запись_.Количество = Окр(Запись_.Количество + Строка_.Значение.Количество, 3);
						Запись_.Причина = Запись_.Причина + ?(Запись_.Причина = "", "", ", ") + "К" + НомерВЦепочке + " "
							+ ?(Строка_.Значение.Количество > 0, "+", "") + Строка_.Значение.Количество;
					КонецЦикла;
				КонецЕсли;
				Фактические = ТоварыДокументов.Получить(СтрокаДокумента.Ссылка);
				Если Фактические = Неопределено Тогда
					Фактические = Новый Соответствие;
				КонецЕсли;
				Запись.Отличия = ОтличияКоличеств(Ожидаемые, Фактические);
				Запись.Ожидаемые = КопияКоличеств(Ожидаемые);
				Запись.Статус = ?(ПустаяСтрока(Запись.Отличия), "ok", "redo");
			КонецЕсли;
			Результат.Добавить(Запись);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Складывает строки таблицы (Ссылка, Номенклатура, Количество) в соответствие Ссылка -> (Номенклатура -> {Количество, Представление}).
Процедура КоличестваВСоответствие(Таблица, Приёмник)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Группа = Приёмник.Получить(СтрокаТаблицы.Ссылка);
		Если Группа = Неопределено Тогда
			Группа = Новый Соответствие;
			Приёмник.Вставить(СтрокаТаблицы.Ссылка, Группа);
		КонецЕсли;
		Группа.Вставить(СтрокаТаблицы.Номенклатура, Новый Структура("Количество, Представление, Причина",
			Окр(СтрокаТаблицы.Количество, 3), Строка(СтрокаТаблицы.Номенклатура), ""));
	КонецЦикла;

КонецПроцедуры

Функция КопияКоличеств(Источник)

	Копия = Новый Соответствие;
	Для Каждого Элемент Из Источник Цикл
		Копия.Вставить(Элемент.Ключ, Новый Структура("Количество, Представление, Причина", Элемент.Значение.Количество, Элемент.Значение.Представление, ""));
	КонецЦикла;
	Возврат Копия;

КонецФункции

// Описание расхождений между ожидаемыми и фактическими количествами (пустая строка — совпадают).
Функция ОтличияКоличеств(Ожидаемые, Фактические)

	Отличия = "";
	Счётчик = 0;
	Для Каждого Элемент Из Ожидаемые Цикл
		Факт = Фактические.Получить(Элемент.Ключ);
		ФактКоличество = ?(Факт = Неопределено, 0, Факт.Количество);
		Если МодульЧисла(ФактКоличество - Элемент.Значение.Количество) > 0.0005 Тогда
			Счётчик = Счётчик + 1;
			Если Счётчик <= 4 Тогда
				Отличия = Отличия + ?(Отличия = "", "", "; ") + Элемент.Значение.Представление + ": в документе "
					+ ФактКоличество + ", должно быть " + Элемент.Значение.Количество
					+ ?(ПустаяСтрока(Элемент.Значение.Причина), "", " (учтено: " + Элемент.Значение.Причина + ")");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Фактические Цикл
		Если Ожидаемые.Получить(Элемент.Ключ) = Неопределено И МодульЧисла(Элемент.Значение.Количество) > 0.0005 Тогда
			Счётчик = Счётчик + 1;
			Если Счётчик <= 4 Тогда
				Отличия = Отличия + ?(Отличия = "", "", "; ") + Элемент.Значение.Представление + ": в документе "
					+ Элемент.Значение.Количество + ", должно быть 0";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Счётчик > 4 Тогда
		Отличия = Отличия + "; и ещё " + (Счётчик - 4);
	КонецЕсли;
	Возврат Отличия;

КонецФункции

// Последовательное перезаполнение «Товаров» непроведённой корректировки с учётом расхождений цепочки.
// Ожидаемые — количества по номенклатуре после поступления и всех расхождений цепочки до этой корректировки включительно
// (результат ПроверитьЦепочки). Сначала выполняется стандартное «Заполнить корректируемые данные», затем количества
// строк (и суммы пропорционально) приводятся к ожидаемым. Если привести не удалось — документ не записывается.
// Пробный — только расчёт, без записи. Проведённые документы не меняются.
Функция ПерезаполнитьТоварыКорректировки(Ссылка, Ожидаемые, Пробный) Экспорт

	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	Если Ожидаемые = Неопределено Тогда
		Результат.Сообщение = "нет расчёта ожидаемых товаров (основание не поступление)";
		Возврат Результат;
	КонецЕсли;
	Док = Ссылка.ПолучитьОбъект();
	Если Док.Проведен Тогда
		Результат.Сообщение = "документ проведён, перезаполнение пропущено (сначала отмените проведение)";
		Возврат Результат;
	КонецЕсли;

	Примечания = "";
	Попытка
		ЗаполнитьТоварыПоИсходнымДанным(Док);
		Примечания = "выполнено «Заполнить корректируемые данные»; ";
	Исключение
		Примечания = "«Заполнить корректируемые данные» не выполнилось (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ "), исправлены текущие строки; ";
	КонецПопытки;

	// Приводим количества к ожидаемым
	Текущие = КоличестваТоваровПоНоменклатуре(Док.Товары);
	Замечания = "";
	УдалитьСтроки = Новый Массив;
	Для Каждого СтрокаТовара Из Док.Товары Цикл
		Если Ожидаемые.Получить(СтрокаТовара.Номенклатура) = Неопределено Тогда
			УдалитьСтроки.Добавить(СтрокаТовара);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Ожидаемые Цикл
		Требуется = Элемент.Значение.Количество;
		Запись = Текущие.Получить(Элемент.Ключ);
		Есть = ?(Запись = Неопределено, 0, Запись.Количество);
		Если МодульЧисла(Есть - Требуется) <= 0.0005 Тогда
			Продолжить;
		КонецЕсли;
		СтрокиНоменклатуры = Новый Массив;
		Для Каждого СтрокаТовара Из Док.Товары Цикл
			Если СтрокаТовара.Номенклатура = Элемент.Ключ Тогда
				СтрокиНоменклатуры.Добавить(СтрокаТовара);
			КонецЕсли;
		КонецЦикла;
		Если Требуется <= 0.0005 Тогда
			Для Каждого СтрокаТовара Из СтрокиНоменклатуры Цикл
				УдалитьСтроки.Добавить(СтрокаТовара);
			КонецЦикла;
		ИначеЕсли СтрокиНоменклатуры.Количество() = 0 Тогда
			// Строки нет — берём из поступления (цена, ставка НДС, настройки), количество — ожидаемое
			Добавлено = ДобавитьСтрокуПоПоступлению(Док, Элемент.Ключ, Требуется);
			Если Добавлено Тогда
				Примечания = Примечания + "добавлена строка «" + Элемент.Значение.Представление + "» из поступления (" + Требуется + ") — проверьте цену и НДС; ";
			Иначе
				Замечания = Замечания + "«" + Элемент.Значение.Представление + "» нужно добавить вручную (" + Требуется + "), в поступлении такой строки нет; ";
			КонецЕсли;
		ИначеЕсли СтрокиНоменклатуры.Количество() > 1 Тогда
			Замечания = Замечания + "«" + Элемент.Значение.Представление + "» в нескольких строках, исправьте вручную (нужно " + Требуется + "); ";
		Иначе
			ИзменитьКоличествоСтроки(Док, СтрокиНоменклатуры[0], Требуется);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаТовара Из УдалитьСтроки Цикл
		Док.Товары.Удалить(СтрокаТовара);
	КонецЦикла;

	// Проверяем итог
	Остаток = ОтличияКоличеств(Ожидаемые, КоличестваТоваровПоНоменклатуре(Док.Товары));
	Если Не ПустаяСтрока(Замечания) Или Не ПустаяСтрока(Остаток) Тогда
		Результат.Сообщение = Примечания + "не записана, осталось: " + Замечания + Остаток;
		Возврат Результат;
	КонецЕсли;
	Если Пробный Тогда
		Результат.Сообщение = Примечания + "ПРОБНЫЙ РЕЖИМ: «Товары» приведены к ожидаемым, документ не записан";
	Иначе
		Док.Записать(РежимЗаписиДокумента.Запись);
		Результат.Сообщение = Примечания + "«Товары» приведены к ожидаемым, документ записан (не проведён)";
	КонецЕсли;
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Добавляет в «Товары» корректировки строку по номенклатуре из «Товаров» поступления-основания:
// копируются одноимённые реквизиты, суммы пересчитываются пропорционально новому количеству.
Функция ДобавитьСтрокуПоПоступлению(Док, Номенклатура, Количество)

	Основание = Док.ДокументОснование;
	Если ТипЗнч(Основание) <> Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбъектОснования = Основание.ПолучитьОбъект();
	Источники = ОбъектОснования.Товары.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
	Если Источники.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Источник = Источники[0];
	РеквизитыИсточника = ОбъектОснования.Метаданные().ТабличныеЧасти.Товары.Реквизиты;

	НоваяСтрока = Док.Товары.Добавить();
	Для Каждого Реквизит Из Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты Цикл
		Если РеквизитыИсточника.Найти(Реквизит.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			НоваяСтрока[Реквизит.Имя] = Источник[Реквизит.Имя];
		Исключение
		КонецПопытки;
	КонецЦикла;

	Если Источник.Количество <> 0 Тогда
		Коэффициент = Количество / Источник.Количество;
		Для Каждого ИмяРеквизита Из СтрРазделить("Сумма,СуммаНДС,СуммаСНДС,КоличествоУпаковок", ",") Цикл
			Если Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти(ИмяРеквизита) <> Неопределено
				И ТипЗнч(НоваяСтрока[ИмяРеквизита]) = Тип("Число") Тогда
				НоваяСтрока[ИмяРеквизита] = Окр(НоваяСтрока[ИмяРеквизита] * Коэффициент, ?(ИмяРеквизита = "КоличествоУпаковок", 3, 2));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	НоваяСтрока.Количество = Количество;
	Попытка
		НоваяСтрока.НастройкаСчетовУчета = НастройкаСчетовУчетаСервер.КопияНастройкиСчетовУчета(НоваяСтрока.НастройкаСчетовУчета, Док);
	Исключение
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Меняет количество строки «Товаров»; суммы пересчитываются пропорционально.
Процедура ИзменитьКоличествоСтроки(Док, СтрокаТовара, НовоеКоличество)

	Старое = СтрокаТовара.Количество;
	Реквизиты = Док.Метаданные().ТабличныеЧасти.Товары.Реквизиты;
	Если Старое <> 0 Тогда
		Коэффициент = НовоеКоличество / Старое;
		Для Каждого ИмяРеквизита Из СтрРазделить("Сумма,СуммаНДС,СуммаСНДС,СуммаРучная,КоличествоУпаковок", ",") Цикл
			Если Реквизиты.Найти(ИмяРеквизита) <> Неопределено И ТипЗнч(СтрокаТовара[ИмяРеквизита]) = Тип("Число") Тогда
				СтрокаТовара[ИмяРеквизита] = Окр(СтрокаТовара[ИмяРеквизита] * Коэффициент, ?(ИмяРеквизита = "КоличествоУпаковок", 3, 2));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СтрокаТовара.Количество = НовоеКоличество;

КонецПроцедуры

// Суммарные количества «Товаров» по номенклатуре: Номенклатура -> {Количество, Представление}.
Функция КоличестваТоваровПоНоменклатуре(Товары)

	Результат = Новый Соответствие;
	Для Каждого СтрокаТовара Из Товары Цикл
		Запись = Результат.Получить(СтрокаТовара.Номенклатура);
		Если Запись = Неопределено Тогда
			Запись = Новый Структура("Количество, Представление, Причина", 0, Строка(СтрокаТовара.Номенклатура), "");
			Результат.Вставить(СтрокаТовара.Номенклатура, Запись);
		КонецЕсли;
		Запись.Количество = Окр(Запись.Количество + СтрокаТовара.Количество, 3);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НайтиСчетаФактуры(Корректировка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СФ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СФ
	|		ПО Т.Ссылка = СФ.Ссылка
	|ГДЕ
	|	Т.ДокументОснование = &Корректировка
	|	И НЕ СФ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Корректировка", Корректировка);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Проводит связанные счета-фактуры (после проведения корректировки). Возвращает текст для журнала.
// Для непроведённой счёта-фактуры: «Получен» (дата документа) = дата корректировки, «Запись в книге продаж»
// = день корректировки (от неё зависит налоговый период). Уже проведённую не трогаем, но предупреждаем,
// если её даты отличаются от даты корректировки.
Функция ПровестиСчетаФактуры(Корректировка)

	СчетаФактуры = НайтиСчетаФактуры(Корректировка.Ссылка);
	Если СчетаФактуры.Количество() = 0 Тогда
		Возврат "счёт-фактура не найдена (не регистрируется или не создана); ";
	КонецЕсли;

	ДеньКорректировки = НачалоДня(Корректировка.Дата);
	Текст = "";
	Для Каждого СчетФактура Из СчетаФактуры Цикл
		Объект = СчетФактура.ПолучитьОбъект();
		ЕстьДатаКниги = (Объект.Метаданные().Реквизиты.Найти("ДатаЗаписиКнигиПродаж") <> Неопределено);

		БылаПроведена = Объект.Проведен;
		ПрежняяДата = Объект.Дата;
		ПрежняяКнига = ?(ЕстьДатаКниги, Объект.ДатаЗаписиКнигиПродаж, Неопределено);
		Если БылаПроведена
			И НачалоДня(Объект.Дата) = ДеньКорректировки
			И (НЕ ЕстьДатаКниги ИЛИ НачалоДня(Объект.ДатаЗаписиКнигиПродаж) = ДеньКорректировки) Тогда
			Текст = Текст + "счёт-фактура " + Объект.Номер + " уже проведена, даты верные; ";
			Продолжить;
		КонецЕсли;

		Если Объект.Дата <> Корректировка.Дата Тогда
			Объект.Дата = Корректировка.Дата;
		КонецЕсли;
		Если ЕстьДатаКниги И Объект.ДатаЗаписиКнигиПродаж <> ДеньКорректировки Тогда
			Объект.ДатаЗаписиКнигиПродаж = ДеньКорректировки;
		КонецЕсли;
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Текст = Текст + "счёт-фактура " + Объект.Номер + ": не удалось перепровести с новыми датами ("
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "); исправьте вручную; ";
			Продолжить;
		КонецПопытки;
		Текст = Текст + "счёт-фактура " + Объект.Номер + ?(БылаПроведена, " перепроведена (даты изменены с " + Формат(ПрежняяДата, "ДФ=dd.MM.yyyy") + ") (получен ", " проведена (получен ")
			+ Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + ?(ЕстьДатаКниги, ", запись в книге продаж "
			+ Формат(Объект.ДатаЗаписиКнигиПродаж, "ДФ=dd.MM.yyyy"), "") + "); ";
	КонецЦикла;
	Возврат Текст;

КонецФункции

Процедура ДобавитьВЖурнал(Журнал, Основание, Корректировка, Номер, Успех, Сообщение, Условно = Ложь)

	Запись = Новый Структура;
	Запись.Вставить("Основание", Основание);
	Запись.Вставить("Корректировка", Корректировка);
	Запись.Вставить("Номер", Номер);
	Запись.Вставить("Успех", Успех);
	Запись.Вставить("Сообщение", Сообщение);
	Запись.Вставить("Условно", Условно);
	Журнал.Добавить(Запись);

КонецПроцедуры

// Массив заданного размера (Новый Массив(0) вызывает ошибку «Недопустимое значение параметра»).
Функция МассивРазмера(Размер)

	Если Размер <= 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Новый Массив(Размер);

КонецФункции

#КонецОбласти

#КонецЕсли
