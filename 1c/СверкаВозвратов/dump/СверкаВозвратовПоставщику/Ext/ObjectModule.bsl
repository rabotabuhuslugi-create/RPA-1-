#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Сверка «Возврат товаров поставщику» <-> «Корректировка приобретения» (таблица «Расхождения»).
// Алгоритм повторяет эталон rpa1c/sverka.py (и HTML-инструмент): при правке менять оба места.
// Обработка ТОЛЬКО читает данные; запись (пометка на удаление) — отдельная процедура формы.

Перем СрокКорректировкиМесяцев; // корректировка поставщика приходит не позже этого срока после возврата
Перем ДнейРаньшеВозврата;       // возврат могут провести позже корректировки: допустимо раньше возврата не более чем на столько дней

#Область ПрограммныйИнтерфейс

// Выполняет подбор и сверку.
//
// Параметры:
//	Параметры - Структура - НачалоПериода, КонецПериода, СрокМесяцев, ДнейРаньше, Контрагент, Организация, Допуск, МаксКомбинация
//
// Возвращаемое значение:
//	Структура - Возвраты (Массив структур), Корректировки (Массив структур), КолвоСтрокВозвратов, КолвоСтрокКорректировок
//
Функция Сверить(Параметры) Экспорт

	СрокКорректировкиМесяцев = ?(Параметры.Свойство("СрокМесяцев") И Параметры.СрокМесяцев > 0, Параметры.СрокМесяцев, 3);
	ДнейРаньшеВозврата = ?(Параметры.Свойство("ДнейРаньше") И Параметры.ДнейРаньше >= 0, Параметры.ДнейРаньше, 30);
	СтрокиВозвратов = ПрочитатьСтрокиВозвратов(Параметры);
	СтрокиКорректировок = ПрочитатьСтрокиКорректировок(Параметры);

	Результат = ВыполнитьСверку(СтрокиВозвратов, СтрокиКорректировок, Параметры.Допуск, Параметры.МаксКомбинация);
	Результат.Вставить("КолвоСтрокВозвратов", СтрокиВозвратов.Количество());
	Результат.Вставить("КолвоСтрокКорректировок", СтрокиКорректировок.Количество());
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЧтениеДанных

Функция ПрочитатьСтрокиВозвратов(Параметры)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Проведен КАК Проведен,
	|	Док.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Т.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ТОГДА Док.Склад
	|		ИНАЧЕ Т.Склад
	|	КОНЕЦ КАК Склад,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Количество КАК Количество,
	|	Т.ДокументПоступления КАК ПоступлениеСтроки,
	|	Док.ДокументПоступления КАК ПоступлениеШапки,
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику КАК Док
	|		ПО Т.Ссылка = Док.Ссылка
	|ГДЕ
	|	Док.Проведен
	|	И НЕ Док.ПометкаУдаления
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&БезКонтрагента ИЛИ Док.Контрагент = &Контрагент)
	|	И (&БезОрганизации ИЛИ Док.Организация = &Организация)
	|	И Т.Количество <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка,
	|	Т.НомерСтроки";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
	ЗаполнитьОтборыЗапроса(Запрос, Параметры);

	Возврат ВыгрузитьСтроки(Запрос.Выполнить().Выбрать(), Ложь);

КонецФункции

Функция ПрочитатьСтрокиКорректировок(Параметры)

	// Корректировки берутся независимо от проведённости: «Расхождения» заполняются из ЭДО сразу.
	// Берём только строки «Уменьшить закупку, уменьшить складские остатки», количество — по модулю.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Проведен КАК Проведен,
	|	Док.ДокументОснование КАК Основание,
	|	Док.ДатаВходящегоДокумента КАК ДатаВходящая,
	|	Док.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Т.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ТОГДА Док.Склад
	|		ИНАЧЕ Т.Склад
	|	КОНЕЦ КАК Склад,
	|	Т.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Т.Количество < 0
	|			ТОГДА -Т.Количество
	|		ИНАЧЕ Т.Количество
	|	КОНЕЦ КАК Количество,
	|	Т.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.КорректировкаПриобретения.Расхождения КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаПриобретения КАК Док
	|		ПО Т.Ссылка = Док.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Дата >= &НачалоПериода
	|	И (&БезКонтрагента ИЛИ Док.Контрагент = &Контрагент)
	|	И (&БезОрганизации ИЛИ Док.Организация = &Организация)
	|	И Т.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокПоступлений.УменьшитьЗакупкуУменьшитьСкладскиеОстатки)
	|	И Т.Количество <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка,
	|	Т.НомерСтроки";
	// Корректировка могла прийти раньше возврата (возврат провели позже) — берём с запасом
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода) - ДнейРаньшеВозврата * 86400);
	ЗаполнитьОтборыЗапроса(Запрос, Параметры);

	Возврат ВыгрузитьСтроки(Запрос.Выполнить().Выбрать(), Истина);

КонецФункции

Процедура ЗаполнитьОтборыЗапроса(Запрос, Параметры)

	Запрос.УстановитьПараметр("БезКонтрагента", Не ЗначениеЗаполнено(Параметры.Контрагент));
	Запрос.УстановитьПараметр("Контрагент", Параметры.Контрагент);
	Запрос.УстановитьПараметр("БезОрганизации", Не ЗначениеЗаполнено(Параметры.Организация));
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);

КонецПроцедуры

Функция ВыгрузитьСтроки(Выборка, ЭтоКорректировка)

	Строки = Новый Массив;
	ДатыОснований = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Количество = Окр(Выборка.Количество, 3);
		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("Документ", Выборка.Документ);
		СтрокаДанных.Вставить("ДокументКлюч", Строка(Выборка.Документ.УникальныйИдентификатор()));
		СтрокаДанных.Вставить("Номер", Выборка.Номер);
		СтрокаДанных.Вставить("Дата", Выборка.Дата);
		СтрокаДанных.Вставить("Проведен", Выборка.Проведен);
		Если ЭтоКорректировка Тогда
			СтрокаДанных.Вставить("Основание", Выборка.Основание);
			// Дата поступления, к которому относится корректировка (для проверки совместимости с возвратом)
			ДатаОснования = Неопределено;
			Если ЗначениеЗаполнено(Выборка.Основание) Тогда
				ДатаОснования = ДатыОснований.Получить(Выборка.Основание);
				Если ДатаОснования = Неопределено Тогда
					ДатаОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Основание, "Дата");
					ДатыОснований.Вставить(Выборка.Основание, ДатаОснования);
				КонецЕсли;
			КонецЕсли;
			СтрокаДанных.Вставить("ДатаОснования", ДатаОснования);
			// Дата корректировки поставщика: дата его документа (не меняется при переносе даты проведения у нас)
			СтрокаДанных.Вставить("ДатаПоставщика", ?(ЗначениеЗаполнено(Выборка.ДатаВходящая), Выборка.ДатаВходящая, Выборка.Дата));
		Иначе
			// Поступление, из которого сделан возврат: указано в строке, иначе в шапке
			СтрокаДанных.Вставить("Поступление", ?(ЗначениеЗаполнено(Выборка.ПоступлениеСтроки), Выборка.ПоступлениеСтроки, Выборка.ПоступлениеШапки));
		КонецЕсли;
		СтрокаДанных.Вставить("СортКлюч", Формат(Выборка.Дата, "ДФ=yyyyMMddHHmmss") + Выборка.Номер);
		СтрокаДанных.Вставить("Номенклатура", Выборка.Номенклатура);
		СтрокаДанных.Вставить("Количество", Количество);
		// Ключ сопоставления: номенклатура + склад + поставщик (контрагент)
		СтрокаДанных.Вставить("Ключ", Строка(Выборка.Номенклатура.УникальныйИдентификатор()) + "|"
			+ Строка(Выборка.Склад.УникальныйИдентификатор()) + "|"
			+ Строка(Выборка.Контрагент.УникальныйИдентификатор()));
		СтрокаДанных.Вставить("Склад", Выборка.Склад);
		СтрокаДанных.Вставить("Контрагент", Выборка.Контрагент);
		СтрокаДанных.Вставить("Индекс", Строки.Количество());
		Строки.Добавить(СтрокаДанных);
	КонецЦикла;
	Возврат Строки;

КонецФункции

#КонецОбласти

#Область Алгоритм

// В языке 1С нет функции Абс.
Функция МодульЧисла(Значение)
	
	Возврат ?(Значение < 0, -Значение, Значение);
	
КонецФункции

// Подбор комбинации возвратов под количество строки корректировки (сумма подмножества).
// Пул сортируется по убыванию количества, при равенстве — по порядку появления.
Функция ПодобратьКомбинацию(Пул, Цель, Допуск, МаксДлина)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Индекс");
	Таблица.Колонки.Добавить("СтрокаДанных");
	Для Каждого Элемент Из Пул Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Количество = Элемент.Количество;
		НоваяСтрока.Индекс = Элемент.Индекс;
		НоваяСтрока.СтрокаДанных = Элемент;
	КонецЦикла;
	Таблица.Сортировать("Количество Убыв, Индекс Возр");

	Отсортированные = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Отсортированные.Добавить(СтрокаТаблицы.СтрокаДанных);
	КонецЦикла;

	Размер = Отсортированные.Количество();
	Суффикс = Новый Массив(Размер + 1);
	Суффикс[Размер] = 0;
	Для Индекс = 1 По Размер Цикл
		ТекИндекс = Размер - Индекс;
		Суффикс[ТекИндекс] = Суффикс[ТекИндекс + 1] + Отсортированные[ТекИндекс].Количество;
	КонецЦикла;

	Контекст = Новый Структура;
	Контекст.Вставить("Пул", Отсортированные);
	Контекст.Вставить("Суффикс", Суффикс);
	Контекст.Вставить("Допуск", Допуск);
	Контекст.Вставить("МаксДлина", МаксДлина);
	Контекст.Вставить("Найдено", Ложь);
	Контекст.Вставить("Выбранные", Новый Массив);
	Контекст.Вставить("Шагов", 0);
	Контекст.Вставить("ЛимитШагов", 200000); // защита от «взрыва» перебора

	ПоискКомбинации(Контекст, 0, Цель, Новый Массив);

	Если Контекст.Найдено И Контекст.Выбранные.Количество() > 0 Тогда
		Возврат Контекст.Выбранные;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура ПоискКомбинации(Контекст, Индекс, Остаток, Выбранные)

	Если Контекст.Найдено Или Контекст.Шагов > Контекст.ЛимитШагов Тогда
		Возврат;
	КонецЕсли;
	Контекст.Шагов = Контекст.Шагов + 1;

	Если Выбранные.Количество() > Контекст.МаксДлина Тогда
		Возврат;
	КонецЕсли;
	Если МодульЧисла(Остаток) <= Контекст.Допуск Тогда
		Контекст.Найдено = Истина;
		Контекст.Выбранные = Новый Массив;
		Для Каждого Элемент Из Выбранные Цикл
			Контекст.Выбранные.Добавить(Элемент);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Если Индекс >= Контекст.Пул.Количество() Или Остаток < -Контекст.Допуск Тогда
		Возврат;
	КонецЕсли;
	Если Остаток - Контекст.Допуск > Контекст.Суффикс[Индекс] Тогда
		Возврат;
	КонецЕсли;

	Выбранные.Добавить(Контекст.Пул[Индекс]);
	ПоискКомбинации(Контекст, Индекс + 1, Остаток - Контекст.Пул[Индекс].Количество, Выбранные);
	Выбранные.Удалить(Выбранные.ВГраница());
	Если Контекст.Найдено Тогда
		Возврат;
	КонецЕсли;
	ПоискКомбинации(Контекст, Индекс + 1, Остаток, Выбранные);

КонецПроцедуры

// Ищет пару для строки корректировки среди свободных возвратов того же ключа.
Функция НайтиПару(Доступные, СтрокаДанных, Допуск, МаксКомбинация)

	Если Доступные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Кандидат Из Доступные Цикл
		Если МодульЧисла(Кандидат.Количество - СтрокаДанных.Количество) <= Допуск Тогда
			Результат = Новый Массив;
			Результат.Добавить(Кандидат);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат ПодобратьКомбинацию(Доступные, СтрокаДанных.Количество, Допуск, МаксКомбинация);

КонецФункции

// Можно ли сопоставлять строку возврата со строкой корректировки:
// 1. Срок: корректировка поставщика не позже заданного срока (по умолчанию 3 месяца) после возврата и, как правило,
//    не раньше возврата. Возврат могут провести уже после прихода корректировки, поэтому допускается корректировка
//    раньше возврата не более чем на ДнейРаньшеВозврата дней; если в возврате явно указано то же поступление,
//    что и в основании корректировки, нижняя граница не применяется.
//    Берётся дата документа поставщика (входящая дата), а если её нет — дата корректировки.
// 2. Поступление, по которому пришла корректировка, раньше возврата (нельзя вернуть товар, которого ещё не было).
// 3. Если в возврате указано поступление — оно должно совпасть с основанием корректировки.
Функция СовместимыПоПоступлению(СтрокаВозврата, СтрокаКорр)
	
	ДатаВозврата = НачалоДня(СтрокаВозврата.Дата);
	ДатаКорр = НачалоДня(СтрокаКорр.ДатаПоставщика);
	ЯвнаяСвязь = ЗначениеЗаполнено(СтрокаВозврата.Поступление) И СтрокаВозврата.Поступление = СтрокаКорр.Основание;
	
	Если ДатаКорр > ДобавитьМесяц(ДатаВозврата, СрокКорректировкиМесяцев) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЯвнаяСвязь И ДатаКорр < ДатаВозврата - ДнейРаньшеВозврата * 86400 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрокаКорр.ДатаОснования <> Неопределено Тогда
		Если СтрокаКорр.ДатаОснования > СтрокаВозврата.Дата Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаВозврата.Поступление) Тогда
		Возврат ЯвнаяСвязь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

Функция ЕстьСовместимыйВозврат(ВозвратыПоКлючу, СтрокаКорр)
	
	Список = ВозвратыПоКлючу.Получить(СтрокаКорр.Ключ);
	Если Список = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого СтрокаВозврата Из Список Цикл
		Если СовместимыПоПоступлению(СтрокаВозврата, СтрокаКорр) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция СвободныеВозвраты(ВозвратыПоКлючу, СтрокаКорр, Занятые, Занятые2 = Неопределено)

	Результат = Новый Массив;
	Список = ВозвратыПоКлючу.Получить(СтрокаКорр.Ключ);
	Если Список = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Список Цикл
		Если Занятые.Получить(Элемент.Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Занятые2 <> Неопределено И Занятые2.Получить(Элемент.Индекс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не СовместимыПоПоступлению(Элемент, СтрокаКорр) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтатусПоСовпадению(Совпало, Всего)

	Если Совпало = Всего Тогда
		Возврат "full";
	ИначеЕсли Совпало > 0 Тогда
		Возврат "partial";
	КонецЕсли;
	Возврат "none";

КонецФункции

Функция ВыполнитьСверку(СтрокиВозвратов, СтрокиКорректировок, Допуск, МаксКомбинация)

	// Возвраты по ключу
	ВозвратыПоКлючу = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокиВозвратов Цикл
		Список = ВозвратыПоКлючу.Получить(СтрокаДанных.Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ВозвратыПоКлючу.Вставить(СтрокаДанных.Ключ, Список);
		КонецЕсли;
		Список.Добавить(СтрокаДанных);
	КонецЦикла;

	// Документы корректировки (порядок появления)
	ПорядокКорр = Новый Массив;
	ДокиКорр = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокиКорректировок Цикл
		Док = ДокиКорр.Получить(СтрокаДанных.ДокументКлюч);
		Если Док = Неопределено Тогда
			Док = Новый Структура("Документ, Номер, Дата, Проведен, Основание, СортКлюч, Строки, Значимая, Закрыта");
			Док.Основание = СтрокаДанных.Основание;
			Док.Проведен = СтрокаДанных.Проведен;
			Док.Документ = СтрокаДанных.Документ;
			Док.Номер = СтрокаДанных.Номер;
			Док.Дата = СтрокаДанных.Дата;
			Док.СортКлюч = СтрокаДанных.СортКлюч;
			Док.Строки = Новый Массив;
			Док.Значимая = Ложь;
			Док.Закрыта = Ложь;
			ДокиКорр.Вставить(СтрокаДанных.ДокументКлюч, Док);
			ПорядокКорр.Добавить(Док);
		КонецЕсли;
		Док.Строки.Добавить(СтрокаДанных);
		Если ЕстьСовместимыйВозврат(ВозвратыПоКлючу, СтрокаДанных) Тогда
			Док.Значимая = Истина;
		КонецЕсли;
	КонецЦикла;

	// Кандидаты: от меньших документов к большим
	ТаблицаКандидатов = Новый ТаблицаЗначений;
	ТаблицаКандидатов.Колонки.Добавить("КолвоСтрок");
	ТаблицаКандидатов.Колонки.Добавить("СортКлюч");
	ТаблицаКандидатов.Колонки.Добавить("Док");
	Для Каждого Док Из ПорядокКорр Цикл
		Если Не Док.Значимая Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаКандидатов.Добавить();
		НоваяСтрока.КолвоСтрок = Док.Строки.Количество();
		НоваяСтрока.СортКлюч = Док.СортКлюч;
		НоваяСтрока.Док = Док;
	КонецЦикла;
	ТаблицаКандидатов.Сортировать("КолвоСтрок Возр, СортКлюч Возр");
	Кандидаты = ТаблицаКандидатов.ВыгрузитьКолонку("Док");

	Занятые = Новый Соответствие;          // индекс строки возврата -> Истина
	СовпадениеСтрокиКорр = Новый Соответствие; // индекс строки корректировки -> массив строк возврата
	ПараПоВозврату = Новый Соответствие;       // индекс строки возврата -> строка корректировки

	// Раунд 1: документ закрываем только если ВСЕ его строки нашли пару
	Для Каждого Док Из Кандидаты Цикл
		ВременноЗанятые = Новый Соответствие;
		ВременныеПары = Новый Массив;
		ВсеНайдены = Истина;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Доступные = СвободныеВозвраты(ВозвратыПоКлючу, СтрокаДанных, Занятые, ВременноЗанятые);
			Найдены = НайтиПару(Доступные, СтрокаДанных, Допуск, МаксКомбинация);
			Если Найдены <> Неопределено И Найдены.Количество() > 0 Тогда
				Для Каждого СтрокаВозврата Из Найдены Цикл
					ВременноЗанятые.Вставить(СтрокаВозврата.Индекс, Истина);
				КонецЦикла;
				ВременныеПары.Добавить(Новый Структура("СтрокаДанных, Найдены", СтрокаДанных, Найдены));
			Иначе
				ВсеНайдены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ВсеНайдены И Док.Строки.Количество() > 0 Тогда
			Для Каждого Пара Из ВременныеПары Цикл
				ЗафиксироватьПару(Пара.СтрокаДанных, Пара.Найдены, Занятые, СовпадениеСтрокиКорр, ПараПоВозврату);
			КонецЦикла;
			Док.Закрыта = Истина;
		КонецЕсли;
	КонецЦикла;

	// Раунд 2: частичные совпадения для остальных документов
	Для Каждого Док Из Кандидаты Цикл
		Если Док.Закрыта Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Если СовпадениеСтрокиКорр.Получить(СтрокаДанных.Индекс) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Доступные = СвободныеВозвраты(ВозвратыПоКлючу, СтрокаДанных, Занятые);
			Найдены = НайтиПару(Доступные, СтрокаДанных, Допуск, МаксКомбинация);
			Если Найдены <> Неопределено И Найдены.Количество() > 0 Тогда
				ЗафиксироватьПару(СтрокаДанных, Найдены, Занятые, СовпадениеСтрокиКорр, ПараПоВозврату);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Результат по документам корректировки (справочно)
	ИтогКорректировки = Новый Массив;
	КорректировкаПоКлючу = Новый Соответствие;
	Для Каждого Док Из ПорядокКорр Цикл
		Если Не Док.Значимая Тогда
			Продолжить;
		КонецЕсли;
		Совпало = 0;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Если СовпадениеСтрокиКорр.Получить(СтрокаДанных.Индекс) <> Неопределено Тогда
				Совпало = Совпало + 1;
			КонецЕсли;
		КонецЦикла;
		Запись = Новый Структура;
		Запись.Вставить("Документ", Док.Документ);
		Запись.Вставить("Номер", Док.Номер);
		Запись.Вставить("Дата", Док.Дата);
		Запись.Вставить("Проведен", Док.Проведен);
		Запись.Вставить("Основание", Док.Основание);
		Запись.Вставить("Всего", Док.Строки.Количество());
		Запись.Вставить("Совпало", Совпало);
		Запись.Вставить("Статус", СтатусПоСовпадению(Совпало, Док.Строки.Количество()));
		Запись.Вставить("Возвраты", Новый Массив);
		ИтогКорректировки.Добавить(Запись);
		КорректировкаПоКлючу.Вставить(Строка(Док.Документ.УникальныйИдентификатор()), Запись);
	КонецЦикла;

	// Результат по документам возврата (главный)
	ПорядокВозвратов = Новый Массив;
	ДокиВозвратов = Новый Соответствие;
	Для Каждого СтрокаДанных Из СтрокиВозвратов Цикл
		Док = ДокиВозвратов.Получить(СтрокаДанных.ДокументКлюч);
		Если Док = Неопределено Тогда
			Док = Новый Структура("Документ, Номер, Дата, Склад, Контрагент, Строки");
			Док.Документ = СтрокаДанных.Документ;
			Док.Номер = СтрокаДанных.Номер;
			Док.Дата = СтрокаДанных.Дата;
			Док.Склад = СтрокаДанных.Склад;
			Док.Контрагент = СтрокаДанных.Контрагент;
			Док.Строки = Новый Массив;
			ДокиВозвратов.Вставить(СтрокаДанных.ДокументКлюч, Док);
			ПорядокВозвратов.Добавить(Док);
		КонецЕсли;
		Док.Строки.Добавить(СтрокаДанных);
	КонецЦикла;

	ИтогВозвраты = Новый Массив;
	Для Каждого Док Из ПорядокВозвратов Цикл
		Совпало = 0;
		Детали = Новый Массив;
		СписокКорр = Новый Массив;
		Для Каждого СтрокаДанных Из Док.Строки Цикл
			Пара = ПараПоВозврату.Получить(СтрокаДанных.Индекс);
			Деталь = Новый Структура;
			Деталь.Вставить("Номенклатура", СтрокаДанных.Номенклатура);
			Деталь.Вставить("Количество", СтрокаДанных.Количество);
			Если Пара <> Неопределено Тогда
				Совпало = Совпало + 1;
				Деталь.Вставить("Корректировка", Пара.Документ);
				Деталь.Вставить("КорректировкаНомер", Пара.Номер);
				Деталь.Вставить("КоличествоКорр", Пара.Количество);
				Если СписокКорр.Найти(Пара.Документ) = Неопределено Тогда
					СписокКорр.Добавить(Пара.Документ);
				КонецЕсли;
			Иначе
				Деталь.Вставить("Корректировка", Неопределено);
				Деталь.Вставить("КорректировкаНомер", "");
				Деталь.Вставить("КоличествоКорр", 0);
			КонецЕсли;
			Детали.Добавить(Деталь);
		КонецЦикла;

		Статус = СтатусПоСовпадению(Совпало, Док.Строки.Количество());
		НеГотовые = Новый Массив;
		Если Статус = "full" Тогда
			// Возврат можно удалять, только если каждая закрывающая корректировка тоже закрыта полностью
			Для Каждого КорректировкаСсылка Из СписокКорр Цикл
				ЗаписьКорр = КорректировкаПоКлючу.Получить(Строка(КорректировкаСсылка.УникальныйИдентификатор()));
				Если ЗаписьКорр <> Неопределено И ЗаписьКорр.Статус <> "full" Тогда
					НеГотовые.Добавить(ЗаписьКорр.Номер);
				КонецЕсли;
			КонецЦикла;
			Если НеГотовые.Количество() > 0 Тогда
				Статус = "partial";
			КонецЕсли;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("Документ", Док.Документ);
		Запись.Вставить("Номер", Док.Номер);
		Запись.Вставить("Дата", Док.Дата);
		Запись.Вставить("Склад", Док.Склад);
		Запись.Вставить("Контрагент", Док.Контрагент);
		Запись.Вставить("Всего", Док.Строки.Количество());
		Запись.Вставить("Совпало", Совпало);
		Запись.Вставить("Статус", Статус);
		Запись.Вставить("НеГотовыеКорректировки", НеГотовые);
		Запись.Вставить("Корректировки", СписокКорр);
		Запись.Вставить("Детали", Детали);
		ИтогВозвраты.Добавить(Запись);

		// Обратная связь для таблицы корректировок
		Для Каждого КорректировкаСсылка Из СписокКорр Цикл
			ЗаписьКорр = КорректировкаПоКлючу.Получить(Строка(КорректировкаСсылка.УникальныйИдентификатор()));
			Если ЗаписьКорр <> Неопределено Тогда
				ЗаписьКорр.Возвраты.Добавить(Док.Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Возвраты", ИтогВозвраты);
	Результат.Вставить("Корректировки", ИтогКорректировки);
	Возврат Результат;

КонецФункции

Процедура ЗафиксироватьПару(СтрокаДанных, Найдены, Занятые, СовпадениеСтрокиКорр, ПараПоВозврату)

	СовпадениеСтрокиКорр.Вставить(СтрокаДанных.Индекс, Найдены);
	Для Каждого СтрокаВозврата Из Найдены Цикл
		Занятые.Вставить(СтрокаВозврата.Индекс, Истина);
		ПараПоВозврату.Вставить(СтрокаВозврата.Индекс, СтрокаДанных);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Проведение

// Проводит цепочки корректировок приобретения (К1 -> К2 -> К3 одного поступления) по порядку даты и времени.
// Перед проведением каждой корректировки, у которой есть предыдущая в цепочке, как команда формы
// «Заполнить корректируемые данные» перезаполняется вкладка «Товары» по состоянию после предыдущей.
// Вместе с корректировкой проводится связанная счёт-фактура. Ошибка в цепочке останавливает только её.
//
// Параметры:
//	Параметры - Структура - Корректировки (Массив структур Ссылка, ДатаПроведения), ПробныйРежим, ЛимитЦепочек,
//		ПроводитьСчетаФактуры, ВключатьПредыдущие, ДатаПоУмолчанию
//
// Возвращаемое значение:
//	Массив - записи журнала: Основание, Корректировка, Номер, Успех (Истина/Ложь/Неопределено), Сообщение
//
Функция ПровестиЦепочки(Параметры) Экспорт
	
	Журнал = Новый Массив;
	
	ВыбранныеДаты = Новый Соответствие;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Параметры.Корректировки Цикл
		ВыбранныеДаты.Вставить(Элемент.Ссылка, Элемент.ДатаПроведения);
		Ссылки.Добавить(Элемент.Ссылка);
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Журнал;
	КонецЕсли;
	
	// Поступления (основания) выбранных корректировок
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Док.ДокументОснование КАК Основание
	|ИЗ
	|	Документ.КорректировкаПриобретения КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Основания = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Основание");
	
	// Все не удалённые корректировки этих поступлений — целая цепочка по порядку даты и времени
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Дата КАК Дата,
	|	Док.Номер КАК Номер,
	|	Док.Проведен КАК Проведен,
	|	Док.ДокументОснование КАК Основание
	|ИЗ
	|	Документ.КорректировкаПриобретения КАК Док
	|ГДЕ
	|	Док.ДокументОснование В(&Основания)
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка";
	Запрос.УстановитьПараметр("Основания", Основания);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Цепочки = Новый Соответствие;
	ПорядокЦепочек = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список = Цепочки.Получить(Выборка.Основание);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Цепочки.Вставить(Выборка.Основание, Список);
			ПорядокЦепочек.Добавить(Выборка.Основание);
		КонецЕсли;
		Элемент = Новый Структура("Ссылка, Дата, Номер, Проведен");
		ЗаполнитьЗначенияСвойств(Элемент, Выборка);
		Список.Добавить(Элемент);
	КонецЦикла;
	
	ОбработаноЦепочек = 0;
	Для Каждого Основание Из ПорядокЦепочек Цикл
		Список = Цепочки.Получить(Основание);
		ЕстьВыбранные = Ложь;
		Для Каждого Элемент Из Список Цикл
			Если Не Элемент.Проведен И ВыбранныеДаты.Получить(Элемент.Ссылка) <> Неопределено Тогда
				ЕстьВыбранные = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьВыбранные Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Параметры.ПробныйРежим И ОбработаноЦепочек >= Параметры.ЛимитЦепочек Тогда
			ДобавитьВЖурнал(Журнал, Основание, Неопределено, "", Неопределено,
				"Цепочка пропущена: достигнут лимит цепочек за один запуск (" + Параметры.ЛимитЦепочек + ")");
			Продолжить;
		КонецЕсли;
		ОбработаноЦепочек = ОбработаноЦепочек + 1;
		
		ПровестиЦепочку(Основание, Список, ВыбранныеДаты, Параметры, Журнал);
	КонецЦикла;
	
	Возврат Журнал;
	
КонецФункции

Процедура ПровестиЦепочку(Основание, Список, ВыбранныеДаты, Параметры, Журнал)
	
	ПредыдущаяДата = Неопределено;   // дата предыдущего документа цепочки (фактическая или планируемая)
	ЕстьПредыдущая = Ложь;           // раньше в цепочке уже есть проведённая корректировка
	СимуляцияПредыдущей = Ложь;      // в пробном режиме: предыдущие «проведены» только условно
	Остановлена = Ложь;
	НеВыбраннаяНомер = Неопределено;
	
	// Индекс последней выбранной непроведённой корректировки: всё непроведённое раньше неё — «предыдущие»
	ПоследнийВыбранный = -1;
	Для Индекс = 0 По Список.ВГраница() Цикл
		Если Не Список[Индекс].Проведен И ВыбранныеДаты.Получить(Список[Индекс].Ссылка) <> Неопределено Тогда
			ПоследнийВыбранный = Индекс;
		КонецЕсли;
	КонецЦикла;
	
	Для Индекс = 0 По Список.ВГраница() Цикл
		Элемент = Список[Индекс];
		
		Если Элемент.Проведен Тогда
			ПредыдущаяДата = Элемент.Дата;
			ЕстьПредыдущая = Истина;
			Продолжить;
		КонецЕсли;
		
		Добавлена = Ложь;
		ДатаПроведения = ВыбранныеДаты.Получить(Элемент.Ссылка);
		Если ДатаПроведения = Неопределено Тогда
			Если Параметры.ВключатьПредыдущие И Индекс < ПоследнийВыбранный И Не Остановлена Тогда
				// Не выбрана, но стоит в цепочке раньше выбранной: проводим её тоже (порядок цепочки нельзя нарушать)
				ДатаПроведения = Параметры.ДатаПоУмолчанию;
				Добавлена = Истина;
			Иначе
				// Непроведённая и не выбранная: через неё последующие проводить нельзя
				Если НеВыбраннаяНомер = Неопределено Тогда
					НеВыбраннаяНомер = Элемент.Номер;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Остановлена Тогда
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Неопределено,
				"Пропущена: цепочка остановлена из-за ошибки выше");
			Продолжить;
		КонецЕсли;
		
		Если НеВыбраннаяНомер <> Неопределено Тогда
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Ложь,
				"Не проведена: раньше в цепочке стоит непроведённая корректировка № " + НеВыбраннаяНомер
				+ ", она не выбрана. Выберите её тоже, включите «Проводить и предыдущие непроведённые корректировки цепочки» или проведите вручную.");
			Остановлена = Истина;
			Продолжить;
		КонецЕсли;
		
		НоваяДата = НоваяДатаДокумента(Элемент.Дата, ДатаПроведения);
		Если ПредыдущаяДата <> Неопределено Тогда
			Если НоваяДата <= ПредыдущаяДата И НачалоДня(НоваяДата) = НачалоДня(ПредыдущаяДата) Тогда
				// Тот же день, но время исходной даты нарушает порядок цепочки: ставим сразу после предыдущей
				НоваяДата = ПредыдущаяДата + 1;
				Если НачалоДня(НоваяДата) <> НачалоДня(ПредыдущаяДата) Тогда
					НоваяДата = ПредыдущаяДата;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ДатаНарушает = Ложь;
		Если ПредыдущаяДата <> Неопределено Тогда
			ДатаНарушает = (НоваяДата <= ПредыдущаяДата);
		КонецЕсли;
		Если ДатаНарушает Тогда
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Ложь,
				"Не проведена: дата проведения " + Формат(НоваяДата, "ДФ='dd.MM.yyyy HH:mm'")
				+ " не позже предыдущей корректировки цепочки (" + Формат(ПредыдущаяДата, "ДФ='dd.MM.yyyy HH:mm'")
				+ "). Измените дату проведения.");
			Остановлена = Истина;
			Продолжить;
		КонецЕсли;
		
		Описание = ?(Добавлена, "добавлена как предыдущая в цепочке; ", "");
		НачатьТранзакцию();
		Попытка
			Док = Элемент.Ссылка.ПолучитьОбъект();
			
			Если Док.Дата <> НоваяДата Тогда
				Описание = Описание + "дата " + Формат(Док.Дата, "ДФ='dd.MM.yyyy HH:mm'") + " -> "
					+ Формат(НоваяДата, "ДФ='dd.MM.yyyy HH:mm'") + "; ";
				Док.Дата = НоваяДата;
			КонецЕсли;
			
			Если ЕстьПредыдущая Тогда
				Если СимуляцияПредыдущей Тогда
					Описание = Описание + "Товары будут перезаполнены после проведения предыдущей; ";
				Иначе
					ТекстПредупреждения = ЗаполнитьТоварыПоИсходнымДанным(Док);
					Описание = Описание + "Товары перезаполнены по состоянию после предыдущей; ";
					Если Не ПустаяСтрока(ТекстПредупреждения) Тогда
						ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Неопределено, ТекстПредупреждения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если Параметры.ПробныйРежим Тогда
				Если Не СимуляцияПредыдущей Тогда
					Если Не Док.ПроверитьЗаполнение() Тогда
						ВызватьИсключение "Не пройдена проверка заполнения документа (подробности в сообщениях)";
					КонецЕсли;
					Описание = Описание + "проверка заполнения пройдена; ";
				КонецЕсли;
				СчетаФактуры = НайтиСчетаФактуры(Элемент.Ссылка);
				Описание = Описание + "связанных счетов-фактур: " + СчетаФактуры.Количество() + "; ";
				ОтменитьТранзакцию();
				СимуляцияПредыдущей = Истина;
				ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Неопределено,
					"ПРОБНЫЙ РЕЖИМ, ничего не записано: " + Описание + "будет проведена");
			Иначе
				Док.Записать(РежимЗаписиДокумента.Проведение);
				Описание = Описание + "проведена; ";
				Если Параметры.ПроводитьСчетаФактуры Тогда
					Описание = Описание + ПровестиСчетаФактуры(Док);
				КонецЕсли;
				ЗафиксироватьТранзакцию();
				ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Истина, Описание);
			КонецЕсли;
			
			ПредыдущаяДата = НоваяДата;
			ЕстьПредыдущая = Истина;
			
		Исключение
			ОтменитьТранзакцию();
			ДобавитьВЖурнал(Журнал, Основание, Элемент.Ссылка, Элемент.Номер, Ложь,
				"Ошибка, документ не проведён: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Остановлена = Истина;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Дата проведения — только день; время суток сохраняется от исходной даты документа,
// чтобы порядок корректировок внутри одного дня не изменился.
Функция НоваяДатаДокумента(ТекущаяДатаДокумента, ДатаПроведения)
	
	Если НачалоДня(ТекущаяДатаДокумента) = НачалоДня(ДатаПроведения) Тогда
		Возврат ТекущаяДатаДокумента;
	КонецЕсли;
	Возврат НачалоДня(ДатаПроведения) + (ТекущаяДатаДокумента - НачалоДня(ТекущаяДатаДокумента));
	
КонецФункции

// То же, что команда формы «Заполнить корректируемые данные».
// Возвращает текст предупреждения или пустую строку.
Функция ЗаполнитьТоварыПоИсходнымДанным(Док)
	
	Документы.КорректировкаПриобретения.ЗаполнитьТоварыПоИсходнымДанным(Док.ДокументОснование, Док.Товары, Док.Ссылка);
	
	// Как в форме: собственная копия настройки счетов учёта у каждой строки
	ТекстПредупреждения = "";
	Попытка
		Для Каждого СтрокаТовара Из Док.Товары Цикл
			СтрокаТовара.НастройкаСчетовУчета = НастройкаСчетовУчетаСервер.КопияНастройкиСчетовУчета(СтрокаТовара.НастройкаСчетовУчета, Док);
		КонецЦикла;
	Исключение
		ТекстПредупреждения = "Не удалось скопировать настройки счетов учёта строк (документ настроит их при записи): "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ТекстПредупреждения;
	
КонецФункции

Функция НайтиСчетаФактуры(Корректировка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СФ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК СФ
	|		ПО Т.Ссылка = СФ.Ссылка
	|ГДЕ
	|	Т.ДокументОснование = &Корректировка
	|	И НЕ СФ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Корректировка", Корректировка);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Проводит связанные счета-фактуры (после проведения корректировки). Возвращает текст для журнала.
// Дата счёта-фактуры приводится к дате корректировки (как при регистрации по документу).
Функция ПровестиСчетаФактуры(Корректировка)
	
	СчетаФактуры = НайтиСчетаФактуры(Корректировка.Ссылка);
	Если СчетаФактуры.Количество() = 0 Тогда
		Возврат "счёт-фактура не найдена (не регистрируется или не создана); ";
	КонецЕсли;
	
	Текст = "";
	Для Каждого СчетФактура Из СчетаФактуры Цикл
		Объект = СчетФактура.ПолучитьОбъект();
		Если Объект.Проведен Тогда
			Текст = Текст + "счёт-фактура " + Объект.Номер + " уже проведена; ";
			Продолжить;
		КонецЕсли;
		Если Объект.Дата <> Корректировка.Дата Тогда
			Объект.Дата = Корректировка.Дата;
		КонецЕсли;
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Текст = Текст + "счёт-фактура " + Объект.Номер + " проведена; ";
	КонецЦикла;
	Возврат Текст;
	
КонецФункции

Процедура ДобавитьВЖурнал(Журнал, Основание, Корректировка, Номер, Успех, Сообщение)
	
	Запись = Новый Структура;
	Запись.Вставить("Основание", Основание);
	Запись.Вставить("Корректировка", Корректировка);
	Запись.Вставить("Номер", Номер);
	Запись.Вставить("Успех", Успех);
	Запись.Вставить("Сообщение", Сообщение);
	Журнал.Добавить(Запись);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
