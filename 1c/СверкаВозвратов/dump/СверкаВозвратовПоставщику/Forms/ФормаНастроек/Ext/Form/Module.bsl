&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Настройки") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.Настройки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьНастройки(Команда)

	Результат = Новый Структура;
	Результат.Вставить("СрокМесяцев", СрокМесяцев);
	Результат.Вставить("ДнейРаньше", ДнейРаньше);
	Результат.Вставить("ДатаПроведения", ДатаПроведения);
	Результат.Вставить("ЛимитЦепочек", ЛимитЦепочек);
	Результат.Вставить("Допуск", Допуск);
	Результат.Вставить("МаксКомбинация", МаксКомбинация);
	Результат.Вставить("ВремяПодбораСек", ВремяПодбораСек);
	Результат.Вставить("ПроводитьСчетаФактуры", ПроводитьСчетаФактуры);
	Результат.Вставить("ВключатьПредыдущие", ВключатьПредыдущие);
	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьНастройки(Команда)

	Закрыть(Неопределено);

КонецПроцедуры
