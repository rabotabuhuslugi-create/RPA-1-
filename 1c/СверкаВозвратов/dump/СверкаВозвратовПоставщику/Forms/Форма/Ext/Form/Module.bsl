&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	КонецПериода = НачалоДня(ТекущаяДата());
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(КонецПериода, -1));
	КорректировкиПо = КонецПериода;
	// Дата, которой по умолчанию будут проводиться ещё не проведённые корректировки (можно изменить)
	ДатаПроведения = КонецПериода;
	Допуск = 0.01;
	МаксКомбинация = 6;
	
	Элементы.Возвраты.ИзменятьСоставСтрок = Ложь;
	Элементы.Детали.ИзменятьСоставСтрок = Ложь;
	Элементы.Детали.ТолькоПросмотр = Истина;
	Элементы.Корректировки.ИзменятьСоставСтрок = Ложь;
	
КонецПроцедуры

#Область Команды

&НаКлиенте
Процедура Подобрать(Команда)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ПоказатьПредупреждение(, "Укажите контрагента (поставщика): сверка выполняется по одному поставщику.");
		Возврат;
	КонецЕсли;
	Если НачалоПериода > КонецПериода Или КонецПериода > КорректировкиПо Тогда
		ПоказатьПредупреждение(, "Проверьте период: «Период с» <= «Возвраты по» <= «Корректировки по».");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда
		ДатаПроведения = КонецПериода;
	КонецЕсли;
	
	ПодобратьНаСервере();
	ВозвратыПриАктивизацииСтроки(Элементы.Возвраты);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьГотовые(Команда)
	
	Для Каждого Запись Из Возвраты Цикл
		Запись.Выбран = (Запись.КодСтатуса = "full");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для Каждого Запись Из Возвраты Цикл
		Запись.Выбран = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВозврат(Команда)
	
	ТекущиеДанные = Элементы.Возвраты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Возврат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКорректировку(Команда)
	
	// Из деталей возврата берём корректировку выбранной строки, иначе из таблицы корректировок.
	ТекущиеДанные = Элементы.Детали.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьДату(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда
		ПоказатьПредупреждение(, "Укажите дату проведения.");
		Возврат;
	КонецЕсли;
	Для Каждого Запись Из Корректировки Цикл
		Если Не Запись.Проведена Тогда
			Запись.ДатаПроведения = ДатаПроведения;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдаление(Команда)
	
	Количество = 0;
	Пропущено = 0;
	Для Каждого Запись Из Возвраты Цикл
		Если Запись.Выбран Тогда
			Если Запись.КодСтатуса = "full" Тогда
				Количество = Количество + 1;
			Иначе
				Пропущено = Пропущено + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, "Нет выбранных возвратов со статусом «Можно удалить».");
		Возврат;
	КонецЕсли;
	
	Текст = "Пометить на удаление возвратов: " + Количество + "." + Символы.ПС
		+ "Проведённые возвраты будут предварительно распроведены." + Символы.ПС;
	Если Пропущено > 0 Тогда
		Текст = Текст + "Выбранные возвраты не со статусом «Можно удалить» (" + Пропущено + ") будут пропущены." + Символы.ПС;
	КонецЕсли;
	Текст = Текст + "Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПометитьНаУдалениеЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдалениеЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ПометитьНаУдалениеНаСервере();
	ПоказатьПредупреждение(, "Помечено на удаление: " + Результат.Помечено + ". Ошибок: " + Результат.Ошибок
		+ ". Подробности — в колонке «Результат»." + Символы.ПС
		+ "Корректировки для дальнейшего проведения показаны в нижней таблице.");
	
КонецПроцедуры

#КонецОбласти

#Область СобытияТаблиц

&НаКлиенте
Процедура ВозвратыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Возвраты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.Детали.ОтборСтрок = Новый ФиксированнаяСтруктура("Возврат", ПредопределенноеЗначение("Документ.ВозвратТоваровПоставщику.ПустаяСсылка"));
	Иначе
		Элементы.Детали.ОтборСтрок = Новый ФиксированнаяСтруктура("Возврат", ТекущиеДанные.Возврат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВозвратыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ВозвратыВыбран" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Возвраты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Возврат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеталиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Детали.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкиДатаПроведенияПриИзменении(Элемент)
	
	// У уже проведённой корректировки дата проведения — это её дата, менять её здесь нельзя
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Проведена Тогда
		ТекущиеДанные.ДатаПроведения = НачалоДня(ТекущиеДанные.Дата);
		ПоказатьПредупреждение(, "Корректировка уже проведена: её дату здесь изменить нельзя.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Сервер

&НаСервере
Процедура ПодобратьНаСервере()
	
	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("НачалоПериода", НачалоПериода);
	ПараметрыСверки.Вставить("КонецПериода", КонецПериода);
	ПараметрыСверки.Вставить("КорректировкиПо", КорректировкиПо);
	ПараметрыСверки.Вставить("Контрагент", Контрагент);
	ПараметрыСверки.Вставить("Организация", Организация);
	ПараметрыСверки.Вставить("Допуск", ?(Допуск > 0, Допуск, 0.01));
	ПараметрыСверки.Вставить("МаксКомбинация", ?(МаксКомбинация > 0, МаксКомбинация, 6));
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.Сверить(ПараметрыСверки);
	
	Возвраты.Очистить();
	Детали.Очистить();
	Корректировки.Очистить();
	
	Для Каждого Запись Из Результат.Возвраты Цикл
		
		СтрокаВозврата = Возвраты.Добавить();
		СтрокаВозврата.Возврат = Запись.Документ;
		СтрокаВозврата.Дата = Запись.Дата;
		СтрокаВозврата.Склад = Запись.Склад;
		СтрокаВозврата.Контрагент = Запись.Контрагент;
		СтрокаВозврата.Всего = Запись.Всего;
		СтрокаВозврата.Совпало = Запись.Совпало;
		СтрокаВозврата.КодСтатуса = Запись.Статус;
		СтрокаВозврата.Выбран = (Запись.Статус = "full");
		
		Если Запись.Статус = "full" Тогда
			СтрокаВозврата.Статус = "✔ Можно удалить";
		ИначеЕсли Запись.Статус = "partial" Тогда
			Если Запись.НеГотовыеКорректировки.Количество() > 0 Тогда
				СтрокаВозврата.Статус = "⚠ Корректировка закрыта не полностью";
				СтрокаВозврата.Результат = "Не закрыты полностью: " + СтрСоединить(Запись.НеГотовыеКорректировки, ", ");
			Иначе
				СтрокаВозврата.Статус = "⚠ Частично (" + Запись.Совпало + " из " + Запись.Всего + ")";
			КонецЕсли;
		Иначе
			СтрокаВозврата.Статус = "✖ Нет совпадений";
		КонецЕсли;
		
		НомераКорректировок = Новый Массив;
		Для Каждого Деталь Из Запись.Детали Цикл
			НоваяДеталь = Детали.Добавить();
			НоваяДеталь.Возврат = Запись.Документ;
			НоваяДеталь.Номенклатура = Деталь.Номенклатура;
			НоваяДеталь.Количество = Деталь.Количество;
			Если Деталь.Корректировка <> Неопределено Тогда
				НоваяДеталь.Корректировка = Деталь.Корректировка;
				НоваяДеталь.КоличествоКорр = Деталь.КоличествоКорр;
				НоваяДеталь.Статус = "✔ № " + Деталь.КорректировкаНомер;
				Если НомераКорректировок.Найти(Деталь.КорректировкаНомер) = Неопределено Тогда
					НомераКорректировок.Добавить(Деталь.КорректировкаНомер);
				КонецЕсли;
			Иначе
				НоваяДеталь.Статус = "✖ корректировка не найдена";
			КонецЕсли;
		КонецЦикла;
		СтрокаВозврата.Корректировки = СтрСоединить(НомераКорректировок, ", ");
		
	КонецЦикла;
	
	Для Каждого Запись Из Результат.Корректировки Цикл
		СтрокаКорр = Корректировки.Добавить();
		СтрокаКорр.Корректировка = Запись.Документ;
		СтрокаКорр.Дата = Запись.Дата;
		СтрокаКорр.Проведена = Запись.Проведен;
		// Проведённая — её фактическая дата; не проведённая — дата по умолчанию (можно менять)
		СтрокаКорр.ДатаПроведения = ?(Запись.Проведен, НачалоДня(Запись.Дата), ДатаПроведения);
		СтрокаКорр.Всего = Запись.Всего;
		СтрокаКорр.Совпало = Запись.Совпало;
		СтрокаКорр.Возвраты = СтрСоединить(Запись.Возвраты, ", ");
		Если Запись.Статус = "full" Тогда
			СтрокаКорр.Статус = "✔ Все позиции с возвратом";
		ИначеЕсли Запись.Статус = "partial" Тогда
			СтрокаКорр.Статус = "⚠ " + Запись.Совпало + " из " + Запись.Всего;
		Иначе
			СтрокаКорр.Статус = "✖ Нет совпадений";
		КонецЕсли;
	КонецЦикла;
	
	Сообщить("Строк возвратов: " + Результат.КолвоСтрокВозвратов + ", строк расхождений (уменьшение закупки): "
		+ Результат.КолвоСтрокКорректировок + ". Возвратов в списке: " + Возвраты.Количество() + ".");
	
КонецПроцедуры

&НаСервере
Функция ПометитьНаУдалениеНаСервере()
	
	Помечено = 0;
	Ошибок = 0;
	
	Для Каждого Запись Из Возвраты Цикл
		Если Не Запись.Выбран Или Запись.КодСтатуса <> "full" Тогда
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			Документ = Запись.Возврат.ПолучитьОбъект();
			Если Документ.ПометкаУдаления Тогда
				ЗафиксироватьТранзакцию();
				Запись.Результат = "Уже помечен на удаление";
				Запись.Выбран = Ложь;
				Продолжить;
			КонецЕсли;
			Если Документ.Проведен Тогда
				Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Документ.УстановитьПометкуУдаления(Истина);
			ЗафиксироватьТранзакцию();
			Запись.Результат = "✔ Помечен на удаление";
			Запись.Выбран = Ложь;
			Помечено = Помечено + 1;
		Исключение
			ОтменитьТранзакцию();
			Запись.Результат = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Ошибок = Ошибок + 1;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Новый Структура("Помечено, Ошибок", Помечено, Ошибок);
	
КонецФункции

#КонецОбласти
