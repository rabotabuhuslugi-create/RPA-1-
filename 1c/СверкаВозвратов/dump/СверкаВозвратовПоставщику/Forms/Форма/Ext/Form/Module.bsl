&НаКлиенте
Процедура ПриОткрытии(Отказ)

	КонецПериода = НачалоДня(ТекущаяДата());
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(КонецПериода, -1));
	СрокМесяцев = 3;
	ДнейРаньше = 30;
	// Дата, которой по умолчанию проводятся ещё не проведённые корректировки: дата запуска обработки (можно изменить)
	ДатаПроведения = НачалоДня(ТекущаяДата());
	Допуск = 0.01;
	МаксКомбинация = 6;
	ВремяПодбораСек = 5;
	ПробныйРежим = Истина;
	ЛимитЦепочек = 1;
	ПроводитьСчетаФактуры = Истина;
	ВключатьПредыдущие = Истина;
	Сводка = "Укажите контрагента и период, затем нажмите «Подобрать».";

	Элементы.Журнал.ИзменятьСоставСтрок = Ложь;
	Элементы.Журнал.ТолькоПросмотр = Истина;
	Элементы.Корректировки.ИзменятьСоставСтрок = Ложь;
	// Таблицы заполняются обработкой: командные панели («Добавить», стрелки) не нужны
	Элементы.ДеревоКоманднаяПанель.Видимость = Ложь;
	Элементы.КорректировкиКоманднаяПанель.Видимость = Ложь;
	Элементы.ЖурналКоманднаяПанель.Видимость = Ложь;

КонецПроцедуры

#Область Команды

// Окно настроек (как в отчётах): отдельная форма поверх основной.
&НаКлиенте
Процедура ОткрытьНастройки(Команда)

	Настройки = Новый Структура;
	Настройки.Вставить("СрокМесяцев", СрокМесяцев);
	Настройки.Вставить("ДнейРаньше", ДнейРаньше);
	Настройки.Вставить("ДатаПроведения", ДатаПроведения);
	Настройки.Вставить("ЛимитЦепочек", ЛимитЦепочек);
	Настройки.Вставить("Допуск", Допуск);
	Настройки.Вставить("МаксКомбинация", МаксКомбинация);
	Настройки.Вставить("ВремяПодбораСек", ВремяПодбораСек);
	Настройки.Вставить("ПроводитьСчетаФактуры", ПроводитьСчетаФактуры);
	Настройки.Вставить("ВключатьПредыдущие", ВключатьПредыдущие);

	// Имя формы настроек строим от имени текущей формы (работает и при открытии файла, и как внешняя обработка)
	ИмяФормыНастроек = Лев(ИмяФормы, СтрДлина(ИмяФормы) - СтрДлина("Форма")) + "ФормаНастроек";
	ОткрытьФорму(ИмяФормыНастроек, Новый Структура("Настройки", Настройки), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ОткрытьНастройкиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	СтараяДата = ДатаПроведения;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Результат);

	// Если изменили дату проведения — переносим её на все ещё не проведённые корректировки в таблице
	Если ДатаПроведения <> СтараяДата Тогда
		Для Каждого СтрокаКорр Из Корректировки Цикл
			Если Не СтрокаКорр.Проведена Тогда
				СтрокаКорр.ДатаПроведения = ДатаПроведения;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ПоказатьПредупреждение(, "Укажите контрагента (поставщика): сверка выполняется по одному поставщику.");
		Возврат;
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		ПоказатьПредупреждение(, "Проверьте период: «Период с» не может быть позже «Возвраты по».");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда
		ДатаПроведения = НачалоДня(ТекущаяДата());
	КонецЕсли;

	Состояние("Подбор возвратов и корректировок...");
	ПодобратьНаСервере();

	// Разворачиваем возвраты, у которых есть что смотреть (незакрытые), закрытые оставляем свёрнутыми
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.КодСтатуса <> "full" Тогда
			Элементы.Дерево.Развернуть(СтрокаВозврата.ПолучитьИдентификатор(), Ложь);
		КонецЕсли;
	КонецЦикла;
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСверка;

КонецПроцедуры

// Главное действие: для отмеченных возвратов проводит сопоставленные корректировки;
// полностью закрытый возврат помечается на удаление, незакрытый — остаётся ждать недостающие корректировки.
&НаКлиенте
Процедура ПровестиИПометить(Команда)

	КУдалению = 0;
	КОжиданию = 0;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.Выбран Тогда
			Если СтрокаВозврата.КодСтатуса = "full" Тогда
				КУдалению = КУдалению + 1;
			ИначеЕсли СтрокаВозврата.КодСтатуса = "partial" Тогда
				КОжиданию = КОжиданию + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КУдалению + КОжиданию = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных возвратов. Сначала нажмите «Подобрать», затем отметьте нужные возвраты.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЛимитЦепочек) Или ЛимитЦепочек < 1 Тогда
		ЛимитЦепочек = 1;
	КонецЕсли;

	Если ПробныйРежим Тогда
		ЗавершитьВыполнение(Истина);
		Возврат;
	КонецЕсли;

	Текст = "Будет выполнено (не больше возвратов за один запуск: " + ЛимитЦепочек + "):" + Символы.ПС
		+ "• полностью закрытых возвратов (корректировки проводятся, возврат помечается на удаление): " + КУдалению + Символы.ПС
		+ "• возвратов с недостающими корректировками (проводятся только найденные корректировки, возврат остаётся): " + КОжиданию + Символы.ПС
		+ "Операция изменяет данные в базе. Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПровестиИПометитьЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПровестиИПометитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьВыполнение(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыполнение(Пробный)

	Результат = ВыполнитьНаСервере();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЖурнал;
	Если Пробный Тогда
		Текст = "ПРОБНЫЙ РЕЖИМ, в базе ничего не изменено. Подробности — на вкладке «Журнал выполнения».";
	Иначе
		Текст = "Возвратов помечено на удаление: " + Результат.Помечено + "; ждут корректировок: " + Результат.Ожидают
			+ "; с ошибками: " + Результат.Ошибок + "; отложено лимитом: " + Результат.ОтложеноЛимитом + "."
			+ Символы.ПС + "Подробности — на вкладке «Журнал выполнения». Чтобы обновить список, нажмите «Подобрать».";
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

#КонецОбласти

#Область СобытияТаблиц

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ДеревоВыбран" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Двойной щелчок: по позиции — открыть корректировку, по возврату — открыть возврат
	Если ЗначениеЗаполнено(ТекущиеДанные.Корректировка) И Поле.Имя <> "ДеревоНазвание" Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Возврат) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Возврат);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЖурналВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Журнал.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КорректировкиДатаПроведенияПриИзменении(Элемент)

	// У уже проведённой корректировки дата проведения — это её дата, менять её здесь нельзя
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Проведена Тогда
		ТекущиеДанные.ДатаПроведения = НачалоДня(ТекущиеДанные.Дата);
		ПоказатьПредупреждение(, "Корректировка уже проведена: её дату здесь изменить нельзя.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КорректировкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "КорректировкиДатаПроведения" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Сервер

&НаСервере
Процедура ПодобратьНаСервере()

	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("НачалоПериода", НачалоПериода);
	ПараметрыСверки.Вставить("КонецПериода", КонецПериода);
	ПараметрыСверки.Вставить("СрокМесяцев", ?(СрокМесяцев > 0, СрокМесяцев, 3));
	ПараметрыСверки.Вставить("ДнейРаньше", ?(ДнейРаньше >= 0, ДнейРаньше, 30));
	ПараметрыСверки.Вставить("ВремяПодбораСек", ?(ВремяПодбораСек > 0, ВремяПодбораСек, 5));
	ПараметрыСверки.Вставить("Контрагент", Контрагент);
	ПараметрыСверки.Вставить("Организация", Организация);
	ПараметрыСверки.Вставить("Допуск", ?(Допуск > 0, Допуск, 0.01));
	ПараметрыСверки.Вставить("МаксКомбинация", ?(МаксКомбинация > 0, МаксКомбинация, 6));

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.Сверить(ПараметрыСверки);

	Дерево.ПолучитьЭлементы().Очистить();
	Корректировки.Очистить();
	Журнал.Очистить();

	// --- корректировки (нижняя вкладка): нужны до дерева, чтобы определить, что можно проводить
	Для Каждого Запись Из Результат.Корректировки Цикл
		СтрокаКорр = Корректировки.Добавить();
		СтрокаКорр.Корректировка = Запись.Документ;
		СтрокаКорр.Дата = Запись.Дата;
		СтрокаКорр.Проведена = Запись.Проведен;
		// Проведённая — её фактическая дата; не проведённая — дата по умолчанию (можно менять)
		СтрокаКорр.ДатаПроведения = ?(Запись.Проведен, НачалоДня(Запись.Дата), ДатаПроведения);
		СтрокаКорр.Основание = Строка(Запись.Основание);
		СтрокаКорр.Всего = Запись.Всего;
		СтрокаКорр.Совпало = Запись.Совпало;
		СтрокаКорр.Возвраты = СтрСоединить(Запись.Возвраты, ", ");
		СтрокаКорр.КодСтатуса = Запись.Статус;
		Если Запись.Статус = "full" Тогда
			СтрокаКорр.Статус = "✔ Все позиции с возвратом";
		ИначеЕсли Запись.Статус = "partial" Тогда
			СтрокаКорр.Статус = "⚠ " + Запись.Совпало + " из " + Запись.Всего;
		Иначе
			СтрокаКорр.Статус = "✖ Нет совпадений";
		КонецЕсли;
	КонецЦикла;

	// --- дерево: возврат -> позиции (с корректировкой для каждой позиции)
	Для Каждого Запись Из Результат.Возвраты Цикл

		СтрокаВозврата = Дерево.ПолучитьЭлементы().Добавить();
		СтрокаВозврата.Возврат = Запись.Документ;
		СтрокаВозврата.Название = "Возврат № " + Запись.Номер + " от " + Формат(Запись.Дата, "ДФ=dd.MM.yyyy");
		СтрокаВозврата.Дата = Запись.Дата;
		СтрокаВозврата.КодСтатуса = Запись.Статус;

		Если Запись.Статус = "full" Тогда
			СтрокаВозврата.Статус = "✔ Можно удалить";
		ИначеЕсли Запись.Статус = "partial" Тогда
			Если Запись.НеГотовыеКорректировки.Количество() > 0 Тогда
				СтрокаВозврата.Статус = "⚠ Корректировка закрыта не полностью";
				СтрокаВозврата.Результат = "Не закрыты полностью: " + СтрСоединить(Запись.НеГотовыеКорректировки, ", ");
			Иначе
				СтрокаВозврата.Статус = "⚠ Частично (" + Запись.Совпало + " из " + Запись.Всего + ")";
			КонецЕсли;
		Иначе
			СтрокаВозврата.Статус = "✖ Нет совпадений";
		КонецЕсли;

		Для Каждого Деталь Из Запись.Детали Цикл
			СтрокаПозиции = СтрокаВозврата.ПолучитьЭлементы().Добавить();
			СтрокаПозиции.Название = Строка(Деталь.Номенклатура);
			СтрокаПозиции.Количество = Деталь.Количество;
			Если Деталь.Корректировка <> Неопределено Тогда
				СтрокаПозиции.Корректировка = Деталь.Корректировка;
				СтрокаПозиции.КоличествоКорр = Деталь.КоличествоКорр;
				СтрокаПозиции.Статус = "✔ № " + Деталь.КорректировкаНомер;
				СтрокаПозиции.КодСтатуса = "ok";
			Иначе
				СтрокаПозиции.Статус = "✖ корректировка не найдена";
				СтрокаПозиции.КодСтатуса = "no";
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	// По умолчанию отмечаем то, что есть смысл обрабатывать: закрытые возвраты и возвраты, у которых
	// уже есть полностью сопоставленные непроведённые корректировки.
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		СтрокаВозврата.Выбран = (СтрокаВозврата.КодСтатуса = "full")
			Или (СтрокаВозврата.КодСтатуса = "partial" И КорректировкиСтрокиВозврата(СтрокаВозврата).Количество() > 0);
	КонецЦикла;

	ОбновитьСводку(Результат.КолвоСтрокВозвратов, Результат.КолвоСтрокКорректировок);

КонецПроцедуры

// Итоговая строка над деревом.
&НаСервере
Процедура ОбновитьСводку(КолвоСтрокВозвратов = Неопределено, КолвоСтрокКорректировок = Неопределено)

	Закрыто = 0;
	Частично = 0;
	БезПары = 0;
	Отмечено = 0;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.КодСтатуса = "full" Тогда
			Закрыто = Закрыто + 1;
		ИначеЕсли СтрокаВозврата.КодСтатуса = "partial" Тогда
			Частично = Частично + 1;
		Иначе
			БезПары = БезПары + 1;
		КонецЕсли;
		Если СтрокаВозврата.Выбран Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	НеПроведено = 0;
	Для Каждого СтрокаКорр Из Корректировки Цикл
		Если Не СтрокаКорр.Проведена Тогда
			НеПроведено = НеПроведено + 1;
		КонецЕсли;
	КонецЦикла;

	Сводка = "Возвратов: " + Дерево.ПолучитьЭлементы().Количество()
		+ "  |  ✔ можно удалить: " + Закрыто
		+ "  |  ⚠ ждут корректировок: " + Частично
		+ "  |  ✖ без совпадений: " + БезПары
		+ "  |  отмечено к обработке: " + Отмечено
		+ "  |  непроведённых корректировок: " + НеПроведено;

КонецПроцедуры

// Корректировки возврата, которые можно проводить: сопоставлены с возвратом, все их позиции
// нашли возврат (иначе проведение затронет позиции без возврата) и они ещё не проведены.
&НаСервере
Функция КорректировкиСтрокиВозврата(СтрокаВозврата)

	Результат = Новый Массив;
	Для Каждого СтрокаПозиции Из СтрокаВозврата.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(СтрокаПозиции.Корректировка) Или Результат.Найти(СтрокаПозиции.Корректировка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", СтрокаПозиции.Корректировка)) Цикл
			Если СтрокаКорр.КодСтатуса = "full" И Не СтрокаКорр.Проведена Тогда
				Результат.Добавить(СтрокаПозиции.Корректировка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ВыполнитьНаСервере()

	Журнал.Очистить();
	Обработка = РеквизитФормыВЗначение("Объект");

	Помечено = 0;
	Ожидают = 0;
	Ошибок = 0;
	ОтложеноЛимитом = 0;
	Обработано = 0;

	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл

		Если Не СтрокаВозврата.Выбран Или (СтрокаВозврата.КодСтатуса <> "full" И СтрокаВозврата.КодСтатуса <> "partial") Тогда
			Продолжить;
		КонецЕсли;

		ТекстВозврата = СтрокаВозврата.Название;
		КПроведению = КорректировкиСтрокиВозврата(СтрокаВозврата);
		ПолностьюЗакрыт = (СтрокаВозврата.КодСтатуса = "full");

		Если Не ПолностьюЗакрыт И КПроведению.Количество() = 0 Тогда
			СтрокаВозврата.Результат = "Ждём недостающие корректировки (проводить пока нечего)";
			Ожидают = Ожидают + 1;
			Продолжить;
		КонецЕсли;

		Если Не ПробныйРежим И Обработано >= ЛимитЦепочек Тогда
			СтрокаВозврата.Результат = "Не обработан: лимит возвратов за один запуск";
			ОтложеноЛимитом = ОтложеноЛимитом + 1;
			Продолжить;
		КонецЕсли;
		Обработано = Обработано + 1;

		// --- пробный режим: возврат не трогаем, только показываем, что будет с корректировками
		Если ПробныйРежим Тогда
			ПровестиКорректировкиВозврата(Обработка, КПроведению, ТекстВозврата);
			СтрокаВозврата.Результат = "Пробный режим: " + ?(ПолностьюЗакрыт,
				"будут проведены корректировки и возврат помечен на удаление",
				"будут проведены найденные корректировки, возврат останется");
			Продолжить;
		КонецЕсли;

		// --- реальный режим
		БылПроведен = Ложь;
		Если ПолностьюЗакрыт Тогда
			// Сначала снимаем возврат (иначе проведение корректировок задвоит списание остатков)
			РезультатПометки = ПометитьВозвратНаУдаление(СтрокаВозврата.Возврат);
			Если Не ПустаяСтрока(РезультатПометки.Ошибка) Тогда
				СтрокаВозврата.Результат = "✖ Ошибка пометки возврата: " + РезультатПометки.Ошибка;
				ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				Ошибок = Ошибок + 1;
				Продолжить;
			КонецЕсли;
			БылПроведен = РезультатПометки.БылПроведен;
		КонецЕсли;

		Итог = ПровестиКорректировкиВозврата(Обработка, КПроведению, ТекстВозврата);

		Если ПолностьюЗакрыт Тогда
			Если Итог.Успешно Тогда
				СтрокаВозврата.Результат = "✔ Помечен на удаление, проведено корректировок: " + Итог.Проведено;
				СтрокаВозврата.Статус = "✔ Удалён (помечен)";
				ДобавитьСтрокуЖурнала("✔", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				СтрокаВозврата.Выбран = Ложь;
				Помечено = Помечено + 1;
			Иначе
				// Корректировки не проведены — возвращаем возврат в прежнее состояние
				ОшибкаВосстановления = ВосстановитьВозврат(СтрокаВозврата.Возврат, БылПроведен);
				ПроведеноЧасть = ?(Итог.Проведено > 0, " Уже проведено корректировок: " + Итог.Проведено
					+ " — проверьте остатки по возврату (возврат снова проведён, а эти корректировки тоже проведены).", "");
				Если ПустаяСтрока(ОшибкаВосстановления) Тогда
					СтрокаВозврата.Результат = "✖ Корректировки проведены не полностью — возврат восстановлен (не удалён)." + ПроведеноЧасть;
				Иначе
					СтрокаВозврата.Результат = "✖ ВНИМАНИЕ: корректировки проведены не полностью, возврат не удалось восстановить: "
						+ ОшибкаВосстановления + ПроведеноЧасть;
				КонецЕсли;
				ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Иначе
			Если Итог.Успешно Тогда
				СтрокаВозврата.Результат = "⏳ Проведено корректировок: " + Итог.Проведено + ". Возврат остаётся, ждём недостающие";
				ДобавитьСтрокуЖурнала("•", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				СтрокаВозврата.Выбран = Ложь;
				Ожидают = Ожидают + 1;
			Иначе
				СтрокаВозврата.Результат = "✖ Часть корректировок не проведена (см. журнал)";
				ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	ОбновитьСводку();
	Возврат Новый Структура("Помечено, Ожидают, Ошибок, ОтложеноЛимитом", Помечено, Ожидают, Ошибок, ОтложеноЛимитом);

КонецФункции

// Проводит корректировки (цепочками, см. ПровестиЦепочки в модуле объекта) и пишет результат в журнал.
// Возвращает структуру: Успешно (все запрошенные проведены), Проведено (количество).
&НаСервере
Функция ПровестиКорректировкиВозврата(Обработка, КПроведению, ТекстВозврата)

	Итог = Новый Структура("Успешно, Проведено", Истина, 0);
	Если КПроведению.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	ПараметрыПроведения = Новый Структура;
	ПараметрыПроведения.Вставить("ПробныйРежим", ПробныйРежим);
	ПараметрыПроведения.Вставить("ЛимитЦепочек", 1000);
	ПараметрыПроведения.Вставить("ПроводитьСчетаФактуры", ПроводитьСчетаФактуры);
	ПараметрыПроведения.Вставить("ВключатьПредыдущие", ВключатьПредыдущие);
	ПараметрыПроведения.Вставить("ДатаПоУмолчанию", ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, НачалоДня(ТекущаяДата())));
	Выбранные = Новый Массив;
	Для Каждого КорректировкаСсылка Из КПроведению Цикл
		ДатаКорр = ПараметрыПроведения.ДатаПоУмолчанию;
		Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", КорректировкаСсылка)) Цикл
			Если ЗначениеЗаполнено(СтрокаКорр.ДатаПроведения) Тогда
				ДатаКорр = СтрокаКорр.ДатаПроведения;
			КонецЕсли;
		КонецЦикла;
		Выбранные.Добавить(Новый Структура("Ссылка, ДатаПроведения", КорректировкаСсылка, ДатаКорр));
	КонецЦикла;
	ПараметрыПроведения.Вставить("Корректировки", Выбранные);

	РезультатПроведения = Обработка.ПровестиЦепочки(ПараметрыПроведения);

	Проведенные = Новый Массив;
	Для Каждого ЗаписьЖурнала Из РезультатПроведения Цикл
		Если ЗаписьЖурнала.Успех = Истина Тогда
			Статус = "✔";
			Проведенные.Добавить(ЗаписьЖурнала.Корректировка);
			Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", ЗаписьЖурнала.Корректировка)) Цикл
				СтрокаКорр.Проведена = Истина;
			КонецЦикла;
		ИначеЕсли ЗаписьЖурнала.Успех = Ложь Тогда
			Статус = "✖";
		Иначе
			Статус = "•";
		КонецЕсли;
		ДобавитьСтрокуЖурнала(Статус, ТекстВозврата, ЗаписьЖурнала.Корректировка,
			?(ПустаяСтрока(ЗаписьЖурнала.Номер), "", "№ " + ЗаписьЖурнала.Номер + ": ") + ЗаписьЖурнала.Сообщение);
	КонецЦикла;

	Итог.Проведено = Проведенные.Количество();
	Если Не ПробныйРежим Тогда
		Для Каждого КорректировкаСсылка Из КПроведению Цикл
			Если Проведенные.Найти(КорректировкаСсылка) = Неопределено Тогда
				Итог.Успешно = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Снимает проведение возврата и помечает его на удаление. Возвращает структуру: Ошибка, БылПроведен.
&НаСервере
Функция ПометитьВозвратНаУдаление(ВозвратСсылка)

	Результат = Новый Структура("Ошибка, БылПроведен", "", Ложь);
	НачатьТранзакцию();
	Попытка
		Документ = ВозвратСсылка.ПолучитьОбъект();
		Результат.БылПроведен = Документ.Проведен;
		Если Не Документ.ПометкаУдаления Тогда
			Если Документ.Проведен Тогда
				Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Документ.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Возвращает возврат в прежнее состояние (снимает пометку удаления и при необходимости проводит).
// Возвращает текст ошибки или пустую строку.
&НаСервере
Функция ВосстановитьВозврат(ВозвратСсылка, БылПроведен)

	НачатьТранзакцию();
	Попытка
		Документ = ВозвратСсылка.ПолучитьОбъект();
		Документ.УстановитьПометкуУдаления(Ложь);
		Если БылПроведен Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

&НаСервере
Процедура ДобавитьСтрокуЖурнала(Статус, ТекстВозврата, КорректировкаСсылка, Сообщение)

	СтрокаЖурнала = Журнал.Добавить();
	СтрокаЖурнала.Статус = Статус;
	СтрокаЖурнала.Возврат = ТекстВозврата;
	Если КорректировкаСсылка <> Неопределено Тогда
		СтрокаЖурнала.Корректировка = КорректировкаСсылка;
	КонецЕсли;
	СтрокаЖурнала.Сообщение = Сообщение;

КонецПроцедуры

#КонецОбласти
