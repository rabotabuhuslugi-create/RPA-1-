&НаСервере
Перем КэшИнфоЦепочек;

&НаСервере
Перем КэшИндексЦепочек;

// Шаг 2. Кнопка «Перезаполнить Товары последовательно»: перезаполняются корректировки, отмеченные флажками в колонке «Перезаполнить».
&НаКлиенте
Процедура ПерезаполнитьЦепочкиНажатие(Элемент)

	ВыбранныеКорректировки = Новый Массив;
	Для Каждого СтрокаСписка Из Цепочки Цикл
		Если СтрокаСписка.Выбрать И ЗначениеЗаполнено(СтрокаСписка.Корректировка) Тогда
			ВыбранныеКорректировки.Добавить(СтрокаСписка.Корректировка);
		КонецЕсли;
	КонецЦикла;
	Если ВыбранныеКорректировки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте флажками в колонке «Перезаполнить» корректировки, которые нужно перезаполнить.");
		Возврат;
	КонецЕсли;
	Текст = "Перезаполнить «Товары» отмеченных корректировок (" + ВыбранныеКорректировки.Количество() + ") по порядку цепочек с учётом расхождений?"
		+ Символы.ПС + ?(ПробныйРежим, "Пробный режим: документы записаны не будут.", "Документы будут записаны (не проведены).");
	ПоказатьВопрос(Новый ОписаниеОповещения("ПерезаполнитьЦепочкиЗавершение", ЭтотОбъект, Новый Структура("Корректировки", ВыбранныеКорректировки)),
		Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Ссылка «Отметить все красные»: отмечает непроведённые корректировки со статусом «перезаполнить».
&НаКлиенте
Процедура ОтметитьКрасные(Элемент)

	Для Каждого СтрокаСписка Из Цепочки Цикл
		УстановитьОтметку(СтрокаСписка, ПодлежитПерезаполнению(СтрокаСписка));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Элемент)

	Для Каждого СтрокаСписка Из Цепочки Цикл
		УстановитьОтметку(СтрокаСписка, Ложь);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметку(СтрокаСписка, Значение)

	СтрокаСписка.Выбрать = Значение;

КонецПроцедуры

&НаКлиенте
Функция ПодлежитПерезаполнению(СтрокаСписка)

	Возврат СтрокаСписка.Статус = "✖ перезаполнить";

КонецФункции

&НаКлиенте
Процедура ПерезаполнитьЦепочкиЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ПерезаполнитьЦепочкиНаСервере(ДополнительныеПараметры.Корректировки);
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЦепочки;
	ПоказатьПредупреждение(, "Перезаполнено: " + Результат.Успешно + " из " + Результат.Всего + "."
		+ Результат.Сообщения
		+ ?(ПустаяСтрока(Результат.Добавлены), "", Символы.ПС + Символы.ПС + "⚠ Добавлены строки из поступления — проверьте цену, сумму и НДС:" + Результат.Добавлены)
		+ Символы.ПС + Символы.ПС + "Подробности — в колонке «Сообщение» таблицы. "
		+ ?(ПробныйРежим, "Пробный режим: документы не записаны.", "Проверка цепочек после перезаполнения обновлена автоматически, шаги 1 и 3 пересчитаны."));

КонецПроцедуры

// Колонка «Обработать» дерева: отметить все показанные возвраты / снять все галки.
&НаКлиенте
Процедура ДеревоОтметитьВсе(Элемент)

	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		СтрокаВозврата.Выбран = Истина;
	КонецЦикла;
	ОбновитьСводку();

КонецПроцедуры

&НаКлиенте
Процедура ДеревоСнятьВсе(Элемент)

	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		СтрокаВозврата.Выбран = Ложь;
	КонецЦикла;
	ОбновитьСводку();

КонецПроцедуры

// Поле «Склад» над деревом: выбор магазина.
&НаКлиенте
Процедура СкладФильтрПриИзменении(Элемент)

	ПрименитьМагазин();

КонецПроцедуры

// Двойной щелчок в дереве «Магазины»: по складу — показать все его документы на первой вкладке, по документу — открыть его.
&НаКлиенте
Процедура МагазиныВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = ЭтотОбъект.Магазины.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		ЭтотОбъект.СкладФильтр = ТекущаяСтрока.Магазин;
		ПрименитьМагазин();
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСверка;
	ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Документ) Тогда
		ПоказатьЗначение(, ТекущаяСтрока.Документ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВсеМагазины(Элемент)

	ЭтотОбъект.СкладФильтр = ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка");
	ПрименитьМагазин();

КонецПроцедуры

&НаКлиенте
Процедура МагазиныРазвернуть(Элемент)

	Для Каждого УзелСклада Из ЭтотОбъект.Магазины.ПолучитьЭлементы() Цикл
		Элементы.Магазины.Развернуть(УзелСклада.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура МагазиныСвернуть(Элемент)

	Для Каждого УзелСклада Из ЭтотОбъект.Магазины.ПолучитьЭлементы() Цикл
		Элементы.Магазины.Свернуть(УзелСклада.ПолучитьИдентификатор());
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СкладМагазиновПриИзменении(Элемент)

	ПрименитьСкладМагазинов();
	Для Каждого УзелСклада Из ЭтотОбъект.Магазины.ПолучитьЭлементы() Цикл
		Элементы.Магазины.Развернуть(УзелСклада.ПолучитьИдентификатор(), Ложь);
	КонецЦикла;

КонецПроцедуры

// Шаг 1. Кнопка «Сформировать»: возвраты за период вкладки, документы их цепочек — целиком.
&НаКлиенте
Процедура МагазиныСформировать(Элемент)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ПоказатьПредупреждение(, "Укажите контрагента (поставщика) в шапке формы.");
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭтотОбъект.ПериодМагазиновС) И ЗначениеЗаполнено(ЭтотОбъект.ПериодМагазиновПо)
		И ЭтотОбъект.ПериодМагазиновС > ЭтотОбъект.ПериодМагазиновПо Тогда
		ПоказатьПредупреждение(, "Проверьте период вкладки «Магазины»: «Период с» не может быть позже «по».");
		Возврат;
	КонецЕсли;
	Состояние("Формирование дерева магазинов...");
	СформироватьМагазиныЗаПериод();
	Состояние("Готово.");

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьМагазин()

	ПрименитьФильтрДерева();
	ОбновитьОтборыТаблиц();

КонецПроцедуры

// Отборы таблиц: выбранный магазин (склад) и значение поля «Показать» шага 2.
&НаКлиенте
Процедура ОбновитьОтборыТаблиц()

	ВыбранныйСклад = ?(ЗначениеЗаполнено(ЭтотОбъект.СкладФильтр), ЭтотОбъект.СкладФильтр, Неопределено);
	// В таблице шага 4 — только корректировки возвратов, отмеченных на шаге 3 (и выбранного склада)
	ОтборКорр = Новый Структура("КВыполнению", Истина);
	Если ВыбранныйСклад <> Неопределено Тогда
		ОтборКорр.Вставить("Склад", ВыбранныйСклад);
	КонецЕсли;
	Элементы.Корректировки.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборКорр);
	Отбор = Новый Структура;
	Если Не ПустаяСтрока(ЭтотОбъект.ФильтрЦепочек) И ЭтотОбъект.ФильтрЦепочек <> "Все" Тогда
		Отбор.Вставить("Статус", ЭтотОбъект.ФильтрЦепочек);
	КонецЕсли;
	Если ВыбранныйСклад <> Неопределено Тогда
		Отбор.Вставить("Склад", ВыбранныйСклад);
	КонецЕсли;
	Если Не ПустаяСтрока(ЭтотОбъект.ПоискЦепочки) Тогда
		Отбор.Вставить("Найдена", Истина);
	КонецЕсли;
	Элементы.Цепочки.ОтборСтрок = ?(Отбор.Количество() = 0, Неопределено, Новый ФиксированнаяСтруктура(Отбор));
	Элементы.Журнал.ОтборСтрок = ?(ВыбранныйСклад = Неопределено, Неопределено, Новый ФиксированнаяСтруктура("Склад", ВыбранныйСклад));

КонецПроцедуры

&НаКлиенте
Процедура ФильтрЦепочекПриИзменении(Элемент)

	ОбновитьОтборыТаблиц();

КонецПроцедуры

&НаКлиенте
Процедура ПоискКорректировкиПриИзменении(Элемент)

	ПрименитьФильтрДерева();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрДереваПриИзменении(Элемент)

	ПрименитьФильтрДерева();

КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница.Имя = "СтраницаКорректировки" Тогда
		ОбновитьКВыполнениюНаКлиенте();
		ОбновитьОтборыТаблиц();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	КонецПериода = НачалоДня(ТекущаяДата());
	НачалоПериода = НачалоМесяца(ДобавитьМесяц(КонецПериода, -1));
	СрокМесяцев = 3;
	ДнейРаньше = 30;
	// Дата, которой по умолчанию проводятся ещё не проведённые корректировки: дата запуска обработки (можно изменить)
	ДатаПроведения = НачалоДня(ТекущаяДата());
	Допуск = 0.0005;
	МаксКомбинация = 6;
	ВремяПодбораСек = 5;
	ПробныйРежим = Истина;
	ЛимитЦепочек = 1;
	ПроводитьСчетаФактуры = Истина;
	Сводка = "Укажите контрагента и период, затем нажмите «Подобрать».";

	ФильтрДерева = "Все";
	ФильтрЦепочек = "Все";
	// Шаг 6: нулевые остатки показываются как 0, а не пустой ячейкой
	Для Каждого ИмяКолонкиОстатков Из СтрРазделить("ОстаткиБыло,ОстаткиСтало,ОстаткиРазница", ",") Цикл
		Элементы[ИмяКолонкиОстатков].Формат = "ЧДЦ=3; ЧН=0";
	КонецЦикла;

	// Таблицы заполняются обработкой: состав строк не меняется; редактируются только флажки и даты проведения
	Элементы.Цепочки.ИзменятьСоставСтрок = Ложь;
	Элементы.Журнал.ИзменятьСоставСтрок = Ложь;
	Элементы.Журнал.ТолькоПросмотр = Истина;
	Элементы.Корректировки.ИзменятьСоставСтрок = Ложь;

	// Поля выбора склада и фильтры: списки значений
	Для Каждого ИмяПоля Из СтрРазделить("СкладФильтр,СкладМагазинов", ",") Цикл
		Элементы[ИмяПоля].РежимВыбораИзСписка = Истина;
		Элементы[ИмяПоля].РедактированиеТекста = Ложь;
		Элементы[ИмяПоля].КнопкаОчистки = Истина;
	КонецЦикла;
	Для Каждого Значение Из СтрРазделить("Все,✔ можно удалять (100%),✖ нужно перезаполнить,⚠ ждут корректировок,✖ нет совпадений", ",") Цикл
		Элементы.ФильтрДерева.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	Для Каждого Значение Из СтрРазделить("Все,✖ перезаполнить,✖ проведена,✔ верно,✔ перезаполнена,— нет данных", ",") Цикл
		Элементы.ФильтрЦепочек.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	Элементы.ФильтрДерева.РедактированиеТекста = Ложь;
	Элементы.ФильтрЦепочек.РедактированиеТекста = Ложь;

	// Ширины колонок дерева магазинов подобраны под содержимое (чтобы не раздвигать вручную)
	Для Каждого ОписаниеШирины Из СтрРазделить("Название:46,Статус:13,Дата:19,Сумма:14,Вердикт:62,Возвратов:10,МожноУдалять:13,Перезаполнить:13,Ждут:13,НетСовпадений:13,КорректировокПерезаполнить:14", ",") Цикл
		ЧастиШирины = СтрРазделить(ОписаниеШирины, ":");
		ПолеМагазинов = Элементы["Магазины" + ЧастиШирины[0]];
		ПолеМагазинов.Ширина = Число(ЧастиШирины[1]);
		ПолеМагазинов.АвтоМаксимальнаяШирина = Ложь;
		ПолеМагазинов.РастягиватьПоГоризонтали = (ЧастиШирины[0] = "Вердикт");
	КонецЦикла;
	Элементы.Магазины.ВысотаШапки = 2;

КонецПроцедуры

#Область Команды

// Навигация по шагам («Далее»)
&НаКлиенте
Процедура ДалееШаг2(Команда)

	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЦепочки;

КонецПроцедуры

&НаКлиенте
Процедура ДалееШаг3(Команда)

	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСверка;

КонецПроцедуры

&НаКлиенте
Процедура ДалееШаг4(Команда)

	ОбновитьКВыполнениюНаКлиенте();
	ОбновитьОтборыТаблиц();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаКорректировки;

КонецПроцедуры

&НаКлиенте
Процедура ДалееШаг5(Команда)

	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЖурнал;

КонецПроцедуры


// Печать всех вкладок: один документ (возвраты и позиции, корректировки с датами, журнал) в окне предпросмотра.
&НаКлиенте
Процедура Печать(Команда)

	Если Дерево.ПолучитьЭлементы().Количество() = 0 И Корректировки.Количество() = 0 И Журнал.Количество() = 0 И Цепочки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Печатать нечего: сначала нажмите «Подобрать».");
		Возврат;
	КонецЕсли;
	Печатная = ПечатьНаСервере();
	Печатная.Показать("Сверка возвратов поставщику и корректировок приобретения");

КонецПроцедуры

// Сортировка по колонке, на которой стоит курсор (для дерева сортируются и возвраты, и позиции внутри них).
&НаКлиенте
Процедура СортироватьВозр(Команда)

	СортироватьТекущуюКолонку(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура СортироватьУбыв(Команда)

	СортироватьТекущуюКолонку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СортироватьТекущуюКолонку(Убывание)

	Страница = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	Если Страница = "СтраницаСверка" Тогда
		Таблица = Элементы.Дерево;
	ИначеЕсли Страница = "СтраницаКорректировки" Тогда
		Таблица = Элементы.Корректировки;
	ИначеЕсли Страница = "СтраницаЦепочки" Тогда
		Таблица = Элементы.Цепочки;
	ИначеЕсли Страница = "СтраницаМагазины" Тогда
		ПоказатьПредупреждение(, "Дерево магазинов не сортируется: используйте поле «Склад».");
		Возврат;
	Иначе
		Таблица = Элементы.Журнал;
	КонецЕсли;
	Если Таблица.ТекущийЭлемент = Неопределено Тогда
		ПоказатьПредупреждение(, "Встаньте курсором в колонку, по которой нужно сортировать.");
		Возврат;
	КонецЕсли;
	Колонка = Сред(Таблица.ТекущийЭлемент.Имя, СтрДлина(Таблица.Имя) + 1);
	СортироватьНаСервере(Страница, Колонка, Убывание);

КонецПроцедуры

// Окно настроек (как в отчётах): отдельная форма поверх основной.
&НаКлиенте
Процедура ОткрытьНастройки(Команда)

	Настройки = Новый Структура;
	Настройки.Вставить("СрокМесяцев", СрокМесяцев);
	Настройки.Вставить("ДнейРаньше", ДнейРаньше);
	Настройки.Вставить("ДатаПроведения", ДатаПроведения);
	Настройки.Вставить("ЛимитЦепочек", ЛимитЦепочек);
	Настройки.Вставить("Допуск", Допуск);
	Настройки.Вставить("МаксКомбинация", МаксКомбинация);
	Настройки.Вставить("ВремяПодбораСек", ВремяПодбораСек);
	Настройки.Вставить("ПроводитьСчетаФактуры", ПроводитьСчетаФактуры);

	// Имя формы настроек строим от имени текущей формы (работает и при открытии файла, и как внешняя обработка)
	ИмяФормыНастроек = Лев(ИмяФормы, СтрДлина(ИмяФормы) - СтрДлина("Форма")) + "ФормаНастроек";
	ОткрытьФорму(ИмяФормыНастроек, Новый Структура("Настройки", Настройки), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ОткрытьНастройкиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	СтараяДата = ДатаПроведения;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Результат);

	// Если изменили дату проведения — переносим её на все ещё не проведённые корректировки в таблице
	Если ДатаПроведения <> СтараяДата Тогда
		Для Каждого СтрокаКорр Из Корректировки Цикл
			Если Не СтрокаКорр.Проведена Тогда
				СтрокаКорр.ДатаПроведения = ДатаПроведения;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ПоказатьПредупреждение(, "Укажите контрагента (поставщика): сверка выполняется по одному поставщику.");
		Возврат;
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		ПоказатьПредупреждение(, "Проверьте период: «Период с» не может быть позже «Возвраты по».");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаПроведения) Тогда
		ДатаПроведения = НачалоДня(ТекущаяДата());
	КонецЕсли;

	// Три шага отдельными вызовами: по статусу внизу окна видно, на каком шаге идёт работа
	Состояние("Шаг 1 из 3: чтение возвратов и корректировок из базы...");
	Прочитано = ПрочитатьДанныеНаСервере();
	Состояние("Шаг 2 из 3: подбор пар (строк возвратов: " + Прочитано.СтрокВозвратов + ", строк расхождений: "
		+ Прочитано.СтрокКорректировок + "; чтение: " + Прочитано.Секунд + " сек)...");
	АдресРезультата = СверитьНаСервере(Прочитано.Адрес);
	Состояние("Шаг 3 из 3: формирование списка...");
	ЗаполнитьСписокНаСервере(АдресРезультата);
	ОбновитьОтборыТаблиц();
	Состояние("Готово.");

	// Разворачиваем возвраты, у которых есть что смотреть (незакрытые), закрытые оставляем свёрнутыми
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.КодСтатуса <> "full" Тогда
			Элементы.Дерево.Развернуть(СтрокаВозврата.ПолучитьИдентификатор(), Ложь);
		КонецЕсли;
	КонецЦикла;
	// После «Подобрать» открывается шаг 1 «Обзор по магазинам» (дерево строится сразу, если ещё не построено)
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМагазины;
	Если Не ЭтотОбъект.МагазиныПостроены Тогда
		МагазиныСформировать(Неопределено);
	КонецЕсли;

КонецПроцедуры

// Шаг 4. Главное действие: для отмеченных возвратов проводит сопоставленные корректировки;
// полностью закрытый возврат помечается на удаление, незакрытый — остаётся ждать недостающие корректировки.
&НаКлиенте
Процедура ПровестиИПометить(Команда)

	КУдалению = 0;
	КОжиданию = 0;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.Выбран Тогда
			Если СтрокаВозврата.КодСтатуса = "full" Тогда
				КУдалению = КУдалению + 1;
			ИначеЕсли СтрокаВозврата.КодСтатуса = "partial" Тогда
				КОжиданию = КОжиданию + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если КУдалению + КОжиданию = 0 Тогда
		ПоказатьПредупреждение(, "Нет отмеченных возвратов. Сначала нажмите «Подобрать», затем отметьте нужные возвраты.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЛимитЦепочек) Или ЛимитЦепочек < 1 Тогда
		ЛимитЦепочек = 1;
	КонецЕсли;

	Если ПробныйРежим Тогда
		ЗавершитьВыполнение(Истина);
		Возврат;
	КонецЕсли;

	Текст = "Будет выполнено (не больше возвратов за один запуск: " + ЛимитЦепочек + "):" + Символы.ПС
		+ "• полностью закрытых возвратов (корректировки проводятся, возврат помечается на удаление): " + КУдалению + Символы.ПС
		+ "• возвратов с недостающими корректировками (проводятся только найденные корректировки, возврат остаётся): " + КОжиданию + Символы.ПС
		+ "Операция изменяет данные в базе. Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПровестиИПометитьЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПровестиИПометитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавершитьВыполнение(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыполнение(Пробный)

	Результат = ВыполнитьНаСервере();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЖурнал;
	Если Пробный Тогда
		Текст = "ПРОБНЫЙ РЕЖИМ, в базе ничего не изменено. Подробности — на шаге 5 «Результат выполнения».";
	Иначе
		Текст = "Возвратов помечено на удаление: " + Результат.Помечено + "; ждут корректировок: " + Результат.Ожидают
			+ "; с ошибками: " + Результат.Ошибок + "; отложено лимитом: " + Результат.ОтложеноЛимитом + "."
			+ Символы.ПС + "Подробности — на шаге 5 «Результат выполнения». Чтобы обновить список, нажмите «Подобрать».";
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

#КонецОбласти

#Область СобытияТаблиц

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ДеревоВыбран" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Двойной щелчок: по позиции — открыть корректировку, по возврату — открыть возврат
	Если ЗначениеЗаполнено(ТекущиеДанные.Корректировка) И Поле.Имя <> "ДеревоНазвание" Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Возврат) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Возврат);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЖурналВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Журнал.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Колонка «Возврат» открывает возврат, остальные — корректировку
	Если Поле.Имя = "ЖурналВозврат" И ЗначениеЗаполнено(ТекущиеДанные.ВозвратСсылка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.ВозвратСсылка);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЦепочкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ЦепочкиВыбрать" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Цепочки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Колонка «Цепочка / поступление» открывает поступление, остальные — корректировку
	Если Поле.Имя = "ЦепочкиВозврат" И ЗначениеЗаполнено(ТекущиеДанные.ВозвратСсылка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.ВозвратСсылка);
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Корректировка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КорректировкиДатаПроведенияПриИзменении(Элемент)

	// У уже проведённой корректировки дата проведения — это её дата, менять её здесь нельзя
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Проведена Тогда
		ТекущиеДанные.ДатаПроведения = НачалоДня(ТекущиеДанные.Дата);
		ПоказатьПредупреждение(, "Корректировка уже проведена: её дату здесь изменить нельзя.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КорректировкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "КорректировкиДатаПроведения" Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Корректировки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Корректировка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Сервер

&НаСервере
Функция ПараметрыСверкиСервер()

	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("НачалоПериода", НачалоПериода);
	ПараметрыСверки.Вставить("КонецПериода", КонецПериода);
	ПараметрыСверки.Вставить("СрокМесяцев", ?(СрокМесяцев > 0, СрокМесяцев, 3));
	ПараметрыСверки.Вставить("ДнейРаньше", ?(ДнейРаньше >= 0, ДнейРаньше, 30));
	ПараметрыСверки.Вставить("ВремяПодбораСек", ?(ВремяПодбораСек > 0, ВремяПодбораСек, 5));
	ПараметрыСверки.Вставить("Контрагент", Контрагент);
	ПараметрыСверки.Вставить("Организация", Организация);
	ПараметрыСверки.Вставить("Допуск", ?(Допуск > 0, Допуск, 0.0005));
	ПараметрыСверки.Вставить("МаксКомбинация", ?(МаксКомбинация > 0, МаксКомбинация, 6));
	Возврат ПараметрыСверки;

КонецФункции

// Шаг 1: чтение данных; результат кладём во временное хранилище.
&НаСервере
Функция ПрочитатьДанныеНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Обработка.ПрочитатьДанные(ПараметрыСверкиСервер());
	Адрес = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	Возврат Новый Структура("Адрес, СтрокВозвратов, СтрокКорректировок, Секунд", Адрес,
		Данные.СтрокиВозвратов.Количество(), Данные.СтрокиКорректировок.Количество(), Данные.СекундЧтение);

КонецФункции

// Шаг 2: подбор.
&НаСервере
Функция СверитьНаСервере(АдресДанных)

	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.Сверить(ПараметрыСверкиСервер(), Данные);
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);

КонецФункции

// Шаг 3: заполнение дерева и таблиц.
// Подсветка зелёным строк со статусом «Можно удалить» (возвраты) и полностью закрытых корректировок.
&НаСервере
Процедура НастроитьПодсветку()

	УсловноеОформление.Элементы.Очистить();
	ЦветЗакрыт = Новый Цвет(214, 240, 222);
	Для Каждого Описание Из СтрРазделить("Дерево:ДеревоВыбран,ДеревоНазвание,ДеревоСтатус,ДеревоДата,ДеревоКоличество,ДеревоКорректировка,ДеревоКоличествоКорр,ДеревоРезультат;"
		+ "Корректировки:КорректировкиСтатус,КорректировкиКорректировка,КорректировкиОснование,КорректировкиДата,КорректировкиПроведена,КорректировкиДатаПроведения,КорректировкиВсего,КорректировкиСовпало,КорректировкиВозвраты", ";") Цикл
		Части = СтрРазделить(Описание, ":");
		Элемент = УсловноеОформление.Элементы.Добавить();
		Для Каждого ИмяПоля Из СтрРазделить(Части[1], ",") Цикл
			Поле = Элемент.Поля.Элементы.Добавить();
			Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЦикла;
		УсловиеОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		УсловиеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Части[0] + ".КодСтатуса");
		УсловиеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		УсловиеОтбора.ПравоеЗначение = "full";
		УсловиеОтбора.Использование = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветЗакрыт);
	КонецЦикла;

	// Шаг 2 («Цепочки»): ✔ — зелёные, ✖ — красные, «перезаполнена» — голубые; шаг 5 («Журнал»): ✔ зелёные, ✖ красные
	Для Каждого Описание Из СтрРазделить("Цепочки:ЦепочкиСтатус,ЦепочкиВозврат,ЦепочкиКорректировка,ЦепочкиСообщение;Журнал:ЖурналСтатус,ЖурналВозврат,ЖурналКорректировка,ЖурналСообщение", ";") Цикл
		ЧастиТаблицы = СтрРазделить(Описание, ":");
		Для Каждого Правило Из СтрРазделить("✔:214,240,222;✖:255,218,218;✔ перезаполнена:170,205,250;✔ (проба):170,205,250", ";") Цикл
			Части = СтрРазделить(Правило, ":");
			Если ЧастиТаблицы[0] = "Журнал" И СтрДлина(Части[0]) > 1 Тогда
				Продолжить;
			КонецЕсли;
			Цвет = СтрРазделить(Части[1], ",");
			Элемент = УсловноеОформление.Элементы.Добавить();
			Для Каждого ИмяПоля Из СтрРазделить(ЧастиТаблицы[1], ",") Цикл
				Поле = Элемент.Поля.Элементы.Добавить();
				Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
			КонецЦикла;
			УсловиеОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			УсловиеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЧастиТаблицы[0] + ".Статус");
			УсловиеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
			УсловиеОтбора.ПравоеЗначение = Части[0];
			УсловиеОтбора.Использование = Истина;
			Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(Число(Цвет[0]), Число(Цвет[1]), Число(Цвет[2])));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Проверка цепочек: «Товары» каждой корректировки сравниваются с ожидаемыми (поступление + расхождения предыдущих и своя).
&НаСервере
Процедура ЗаполнитьЦепочки(ОснованияЦепочек)

	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Запись Из Обработка.ПроверитьЦепочки(ОснованияЦепочек) Цикл
		СтрокаЖурнала = Цепочки.Добавить();
		НомерВЦепочке = "К" + Запись.НомерВЦепочке + " из " + Запись.ВсегоВЦепочке;
		СтрокаЖурнала.Возврат = НомерВЦепочке + " · " + Строка(Запись.Основание);
		СтрокаЖурнала.ВозвратСсылка = Запись.Основание;
		СтрокаЖурнала.Выбрать = Ложь;
		СтрокаЖурнала.Склад = Запись.Склад;
		СтрокаЖурнала.Корректировка = Запись.Документ;
		Если Запись.Статус = "ok" И Не ПустаяСтрока(Запись.ПерезаполненаОбработкой) И Не Запись.Проведен Тогда
			СтрокаЖурнала.Статус = "✔ перезаполнена";
			СтрокаЖурнала.Сообщение = "Проверка цепочки (" + Запись.ИсточникПорядка + "): перезаполнена обработкой " + Запись.ПерезаполненаОбработкой
				+ ", «Товары» верны";
		ИначеЕсли Запись.Статус = "ok" Тогда
			СтрокаЖурнала.Статус = "✔ верно";
			СтрокаЖурнала.Сообщение = "Проверка цепочки (" + Запись.ИсточникПорядка + "): «Товары» заполнены верно, перезаполнять не нужно";
		ИначеЕсли Запись.Статус = "redo" Тогда
			СтрокаЖурнала.Статус = ?(Запись.Проведен, "✖ проведена", "✖ перезаполнить");
			СтрокаЖурнала.Сообщение = "Проверка цепочки (" + Запись.ИсточникПорядка + "): " + ?(Запись.Проведен, "документ проведён, но «Товары» расходятся: ",
				"«Товары» нужно перезаполнить: ") + Запись.Отличия;
		Иначе
			СтрокаЖурнала.Статус = "— нет данных";
			СтрокаЖурнала.Сообщение = "Проверка цепочки (" + Запись.ИсточникПорядка + "): " + Запись.Отличия;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере(АдресРезультата)

	НастроитьПодсветку();
	НастроитьПодсветкуДерева();
	НастроитьПодсветкуМагазинов();
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);

	Дерево.ПолучитьЭлементы().Очистить();
	Корректировки.Очистить();
	Цепочки.Очистить();
	Журнал.Очистить();

	// --- корректировки (нижняя вкладка): нужны до дерева, чтобы определить, что можно проводить
	ОснованияЦепочек = Новый Массив;
	Для Каждого Запись Из Результат.Корректировки Цикл
		СтрокаКорр = Корректировки.Добавить();
		Если (Запись.Статус = "full" Или Запись.Статус = "partial") И ЗначениеЗаполнено(Запись.Основание)
			И ОснованияЦепочек.Найти(Запись.Основание) = Неопределено Тогда
			ОснованияЦепочек.Добавить(Запись.Основание);
		КонецЕсли;
		СтрокаКорр.Корректировка = Запись.Документ;
		СтрокаКорр.Дата = Запись.Дата;
		СтрокаКорр.Проведена = Запись.Проведен;
		// Проведённая — её фактическая дата; не проведённая — дата по умолчанию (можно менять)
		СтрокаКорр.ДатаПроведения = ?(Запись.Проведен, НачалоДня(Запись.Дата), ДатаПроведения);
		СтрокаКорр.Основание = Строка(Запись.Основание);
		СтрокаКорр.Всего = Запись.Всего;
		СтрокаКорр.Совпало = Запись.Совпало;
		СтрокаКорр.Возвраты = СтрСоединить(Запись.Возвраты, ", ");
		СтрокаКорр.КодСтатуса = Запись.Статус;
		СтрокаКорр.Склад = Запись.Склад;
		Если Запись.Статус = "full" Тогда
			СтрокаКорр.Статус = "✔ Все позиции с возвратом";
		ИначеЕсли Запись.Статус = "partial" Тогда
			СтрокаКорр.Статус = "⚠ " + Запись.Совпало + " из " + Запись.Всего;
		Иначе
			СтрокаКорр.Статус = "✖ Нет совпадений";
		КонецЕсли;
	КонецЦикла;

	// --- проверка цепочек корректировок (результат — на шаге 2)
	ЗаполнитьЦепочки(ОснованияЦепочек);
	ПометитьНайденныеЦепочки();

	// --- дерево: возврат -> позиции; вердикт по цепочкам корректировок берётся из проверки выше
	ИнфоЦепочек = ИнформацияПоЦепочкам(ОснованияЦепочек);
	ЭтотОбъект.ФильтрДерева = "Все";
	ЭтотОбъект.АдресДерева = ПоместитьВоВременноеХранилище(
		Новый Структура("Результат, ИнфоЦепочек, Выбранные", Результат, ИнфоЦепочек, Новый Соответствие), УникальныйИдентификатор);
	ЗаполнитьМагазины(Результат, ИнфоЦепочек);
	ЗаполнитьДерево(Результат, ИнфоЦепочек, "Все", Новый Соответствие);
	ОбновитьКВыполнению();
	// Дерево вкладки «Магазины» строится отдельно за весь период (при открытии вкладки); здесь только список складов
	ЭтотОбъект.Магазины.ПолучитьЭлементы().Очистить();
	ЭтотОбъект.АдресМагазинов = "";
	ЭтотОбъект.МагазиныПостроены = Ложь;
	Если Элементы.Найти("ПодсказкаМагазинов") <> Неопределено Тогда
		Элементы.ПодсказкаМагазинов.Видимость = Истина;
	КонецЕсли;
	ЭтотОбъект.ПериодМагазиновС = НачалоПериода;
	ЭтотОбъект.ПериодМагазиновПо = КонецПериода;

	ОбновитьСводку(Результат.КолвоСтрокВозвратов, Результат.КолвоСтрокКорректировок);
	Сообщить("Строк возвратов: " + Результат.КолвоСтрокВозвратов + ", строк расхождений: " + Результат.КолвоСтрокКорректировок
		+ ". Чтение из базы: " + Результат.СекундЧтение + " сек, подбор: " + Результат.СекундПодбор + " сек.");

КонецПроцедуры

// Перезаполнение «Товаров» непроведённых корректировок со статусом «перезаполнить» по порядку цепочек.
&НаСервере
Функция ПерезаполнитьЦепочкиНаСервере(Корректировки_)

	Результат = Новый Структура("Всего, Успешно, Сообщения, Добавлены", 0, 0, "", "");
	Если ПустаяСтрока(ЭтотОбъект.АдресДерева) Тогда
		Возврат Результат;
	КонецЕсли;
	Хранимое = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресДерева);
	Если Хранимое = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Магазины_ = ВыбранныеМагазины();
	Отбор = Новый Соответствие;
	Для Каждого Ссылка Из Корректировки_ Цикл
		Отбор.Вставить(Ссылка, Истина);
	КонецЦикла;
	Очередь = Новый ТаблицаЗначений;
	Очередь.Колонки.Добавить("Основание");
	Очередь.Колонки.Добавить("Дата");
	Очередь.Колонки.Добавить("Запись");
	Для Каждого Элемент Из Хранимое.ИнфоЦепочек Цикл
		Запись = Элемент.Значение;
		Если Запись.Статус = "redo" И Не Запись.Проведен
			И (Магазины_.Количество() = 0 Или Магазины_.Получить(Запись.Склад) <> Неопределено) И (Отбор.Количество() = 0 Или Отбор.Получить(Запись.Документ) <> Неопределено) Тогда
			СтрокаОчереди = Очередь.Добавить();
			СтрокаОчереди.Основание = Строка(Запись.Основание);
			СтрокаОчереди.Дата = Запись.Дата;
			СтрокаОчереди.Запись = Запись;
		КонецЕсли;
	КонецЦикла;
	Очередь.Сортировать("Основание, Дата");

	Перезаполненные = Новый Соответствие;
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Запись = СтрокаОчереди.Запись;
		Результат.Всего = Результат.Всего + 1;
		// Строка цепочки в таблице: её статус меняется по результату перезаполнения
		СтрокаСписка = Неопределено;
		Для Каждого Кандидат Из Цепочки Цикл
			Если Кандидат.Корректировка = Запись.Документ Тогда
				СтрокаСписка = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаСписка = Неопределено Тогда
			СтрокаСписка = Цепочки.Добавить();
			СтрокаСписка.Корректировка = Запись.Документ;
		КонецЕсли;
		Попытка
			Итог = Обработка.ПерезаполнитьТоварыКорректировки(Запись.Документ, Запись.Ожидаемые, ПробныйРежим);
			Если Не ПустаяСтрока(Итог.Добавлено) Тогда
				Результат.Добавлены = Результат.Добавлены + Символы.ПС + "КТЦБ " + Запись.Номер + ": " + Итог.Добавлено;
			КонецЕсли;
			Если Итог.Успех Тогда
				Результат.Успешно = Результат.Успешно + 1;
				Если Не ПробныйРежим Тогда
					Перезаполненные.Вставить(Запись.Документ, Истина);
				КонецЕсли;
				Если ПробныйРежим Тогда
					СтрокаСписка.Статус = "✔ (проба) будет перезаполнена";
				Иначе
					СтрокаСписка.Статус = "✔ перезаполнена";
					Запись.Статус = "ok";
				КонецЕсли;

			Иначе
				СтрокаСписка.Статус = "✖ не перезаполнена";
			КонецЕсли;
			СтрокаСписка.Сообщение = "Перезаполнение: " + Итог.Сообщение;
			СтрокаСписка.Выбрать = Ложь;
			Результат.Сообщения = Результат.Сообщения + ?(Результат.Всего <= 5, Символы.ПС + Запись.Номер + ": " + Итог.Сообщение, "");
		Исключение
			СтрокаСписка.Статус = "✖ ошибка";
			СтрокаСписка.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Сообщения = Результат.Сообщения + Символы.ПС + Запись.Номер + ": " + СтрокаСписка.Сообщение;
		КонецПопытки;
	КонецЦикла;
	// Проверка цепочек заново для перезаполненных корректировок: статусы в таблице и в дереве возвратов обновляются сразу
	Если Перезаполненные.Количество() > 0 Тогда
		ОснованияПроверки = Новый Массив;
		Для Каждого Элемент Из Хранимое.ИнфоЦепочек Цикл
			Если ОснованияПроверки.Найти(Элемент.Значение.Основание) = Неопределено Тогда
				ОснованияПроверки.Добавить(Элемент.Значение.Основание);
			КонецЕсли;
		КонецЦикла;
		НоваяИнфо = ИнформацияПоЦепочкам(ОснованияПроверки);
		Для Каждого Элемент Из Перезаполненные Цикл
			НоваяЗапись = НоваяИнфо.Получить(Элемент.Ключ);
			Если НоваяЗапись <> Неопределено Тогда
				Хранимое.ИнфоЦепочек.Вставить(Элемент.Ключ, НоваяЗапись);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаСписка Из Цепочки Цикл
			Если Перезаполненные.Получить(СтрокаСписка.Корректировка) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НоваяЗапись = НоваяИнфо.Получить(СтрокаСписка.Корректировка);
			Если НоваяЗапись = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если НоваяЗапись.Статус = "ok" Тогда
				СтрокаСписка.Статус = "✔ перезаполнена";
				СтрокаСписка.Сообщение = СтрокаСписка.Сообщение + " | Проверка после перезаполнения: «Товары» верны";
			Иначе
				СтрокаСписка.Статус = "✖ перезаполнить";
				СтрокаСписка.Сообщение = "Проверка после перезаполнения: " + НоваяЗапись.Отличия;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Обновить сохранённые вердикты, чтобы дерево и сводка видели новые статусы
	ПоместитьВоВременноеХранилище(Хранимое, ЭтотОбъект.АдресДерева);
	Если Перезаполненные.Количество() > 0 Тогда
		// Шаг 3 (возвраты) и шаг 1 (обзор по магазинам) пересчитываются по новым статусам корректировок
		ПрименитьФильтрДерева();
		ОбновитьКВыполнению();
		ОбновитьСводку();
		Если Не ПустаяСтрока(ЭтотОбъект.АдресМагазинов) Тогда
			ХранимоеМагазинов = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресМагазинов);
			Если ХранимоеМагазинов <> Неопределено Тогда
				Для Каждого Элемент Из Перезаполненные Цикл
					НоваяЗаписьИнфо = Хранимое.ИнфоЦепочек.Получить(Элемент.Ключ);
					Если НоваяЗаписьИнфо <> Неопределено Тогда
						ХранимоеМагазинов.ИнфоЦепочек.Вставить(Элемент.Ключ, НоваяЗаписьИнфо);
					КонецЕсли;
				КонецЦикла;
				ПоместитьВоВременноеХранилище(ХранимоеМагазинов, ЭтотОбъект.АдресМагазинов);
				ЗаполнитьМагазины(ХранимоеМагазинов.Результат, ХранимоеМагазинов.ИнфоЦепочек, ?(ЗначениеЗаполнено(ЭтотОбъект.СкладМагазинов), ЭтотОбъект.СкладМагазинов, Неопределено), Ложь);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отобранный склад (магазин): пусто — все магазины.
&НаСервере
Функция ВыбранныеМагазины()

	Результат = Новый Соответствие;
	Если ЗначениеЗаполнено(ЭтотОбъект.СкладФильтр) Тогда
		Результат.Вставить(ЭтотОбъект.СкладФильтр, Истина);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Номер, дата, проведён и сумма документов по списку ссылок.
&НаСервере
Функция ДанныеДокументов(Ссылки, ИмяДокумента)

	Результат = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Проведен КАК Проведен,
	|	Док.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	Док.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// нет реквизита «СуммаДокумента» — покажем без сумм
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Док.СуммаДокумента", "0");
		Выборка = Запрос.Выполнить().Выбрать();
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Новый Структура("Номер, Дата, Проведен, Сумма", Выборка.Номер, Выборка.Дата, Выборка.Проведен, Выборка.Сумма));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дерево «Магазины»: Склад -> Приобретение -> Корректировки по порядку -> Возвраты, ссылающиеся на корректировку.
// Возвраты без найденной корректировки — отдельным узлом в конце склада.
&НаСервере
Процедура ЗаполнитьМагазины(Результат, ИнфоЦепочек, ОтборСклад = Неопределено, Сохранять = Истина)

	Корень = ЭтотОбъект.Магазины.ПолучитьЭлементы();
	Корень.Очистить();
	Если Сохранять Тогда
		ЭтотОбъект.АдресМагазинов = ПоместитьВоВременноеХранилище(Новый Структура("Результат, ИнфоЦепочек", Результат, ИнфоЦепочек), УникальныйИдентификатор);
		ЭтотОбъект.СкладМагазинов = Справочники.Склады.ПустаяСсылка();
	КонецЕсли;

	// Возвраты по корректировкам и без них
	ВозвратыПоКорр = Новый Соответствие;
	ВозвратыБезКорр = Новый Соответствие;
	ВозвратыПоСкладу = Новый Соответствие;
	Склады = Новый Соответствие;
	ССылкиВозвратов = Новый Массив;
	Для Каждого Запись Из Результат.Возвраты Цикл
		Склады.Вставить(Запись.Склад, Истина);
		ССылкиВозвратов.Добавить(Запись.Документ);
		Список = ВозвратыПоСкладу.Получить(Запись.Склад);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ВозвратыПоСкладу.Вставить(Запись.Склад, Список);
		КонецЕсли;
		Список.Добавить(Запись);
		Если Запись.Корректировки.Количество() = 0 Тогда
			Список = ВозвратыБезКорр.Получить(Запись.Склад);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ВозвратыБезКорр.Вставить(Запись.Склад, Список);
			КонецЕсли;
			Список.Добавить(Запись);
		КонецЕсли;
		Для Каждого КорректировкаСсылка Из Запись.Корректировки Цикл
			Список = ВозвратыПоКорр.Получить(КорректировкаСсылка);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ВозвратыПоКорр.Вставить(КорректировкаСсылка, Список);
			КонецЕсли;
			Список.Добавить(Запись);
		КонецЦикла;
	КонецЦикла;

	// Цепочки по поступлениям, по порядку
	ТаблицаЦепочек = Новый ТаблицаЗначений;
	ТаблицаЦепочек.Колонки.Добавить("Основание");
	ТаблицаЦепочек.Колонки.Добавить("Ключ");
	ТаблицаЦепочек.Колонки.Добавить("Номер");
	ТаблицаЦепочек.Колонки.Добавить("Запись");
	СсылкиЗакупок = Новый Массив;
	СсылкиКорректировок = Новый Массив;
	Для Каждого Элемент Из ИнфоЦепочек Цикл
		Запись = Элемент.Значение;
		СтрокаТаблицы = ТаблицаЦепочек.Добавить();
		СтрокаТаблицы.Основание = Запись.Основание;
		СтрокаТаблицы.Ключ = Строка(Запись.Основание);
		СтрокаТаблицы.Номер = Запись.НомерВЦепочке;
		СтрокаТаблицы.Запись = Запись;
		Склады.Вставить(Запись.Склад, Истина);
		Если СсылкиЗакупок.Найти(Запись.Основание) = Неопределено Тогда
			СсылкиЗакупок.Добавить(Запись.Основание);
		КонецЕсли;
		СсылкиКорректировок.Добавить(Запись.Документ);
	КонецЦикла;
	ТаблицаЦепочек.Сортировать("Ключ, Номер");

	ДанныеЗакупок = ДанныеДокументов(СсылкиЗакупок, "ПриобретениеТоваровУслуг");
	ДанныеКорректировок = ДанныеДокументов(СсылкиКорректировок, "КорректировкаПриобретения");
	ДанныеВозвратов = ДанныеДокументов(ССылкиВозвратов, "ВозвратТоваровПоставщику");
	// Склады по алфавиту
	ТаблицаСкладов = Новый ТаблицаЗначений;
	ТаблицаСкладов.Колонки.Добавить("Склад");
	ТаблицаСкладов.Колонки.Добавить("Имя");
	Для Каждого Элемент Из Склады Цикл
		СтрокаСклада = ТаблицаСкладов.Добавить();
		СтрокаСклада.Склад = Элемент.Ключ;
		СтрокаСклада.Имя = Строка(Элемент.Ключ);
	КонецЦикла;
	ТаблицаСкладов.Сортировать("Имя");

	Для Каждого СтрокаСклада Из ТаблицаСкладов Цикл
		Склад = СтрокаСклада.Склад;
		Если ОтборСклад <> Неопределено И Склад <> ОтборСклад Тогда
			Продолжить;
		КонецЕсли;
		УзелСклада = Корень.Добавить();
		УзелСклада.Магазин = Склад;
		УзелСклада.Название = ?(ПустаяСтрока(СтрокаСклада.Имя), "<склад не указан>", СтрокаСклада.Имя);

		// Итоги по складу
		СуммаВозвратов = 0;
		СписокВозвратов = ВозвратыПоСкладу.Получить(Склад);
		Если СписокВозвратов <> Неопределено Тогда
			Для Каждого Запись Из СписокВозвратов Цикл
				Категория = КатегорияВозврата(Запись, ИнфоЦепочек);
				УзелСклада.Возвратов = УзелСклада.Возвратов + 1;
				Если Категория.Код = "ok" Или Категория.Код = "full" Тогда
					УзелСклада.МожноУдалять = УзелСклада.МожноУдалять + 1;
				ИначеЕсли Категория.Код = "redo" Тогда
					УзелСклада.Перезаполнить = УзелСклада.Перезаполнить + 1;
				ИначеЕсли Категория.Код = "blocked" Или Запись.Статус = "partial" Тогда
					УзелСклада.Ждут = УзелСклада.Ждут + 1;
				Иначе
					УзелСклада.НетСовпадений = УзелСклада.НетСовпадений + 1;
				КонецЕсли;
				Данные = ДанныеВозвратов.Получить(Запись.Документ);
				СуммаВозвратов = СуммаВозвратов + ?(Данные = Неопределено, 0, Данные.Сумма);
			КонецЦикла;
		КонецЕсли;
		УзелСклада.Сумма = СуммаВозвратов;

		// Поступления склада и их цепочки
		УзелЗакупки = Неопределено;
		ТекущееОснование = Неопределено;
		НепроведённыеВЦепочке = Новый Массив;
		Для Каждого СтрокаЦепочки Из ТаблицаЦепочек Цикл
			Запись = СтрокаЦепочки.Запись;
			Если Запись.Склад <> Склад Тогда
				Продолжить;
			КонецЕсли;
			Если УзелЗакупки = Неопределено Или ТекущееОснование <> Запись.Основание Тогда
				ТекущееОснование = Запись.Основание;
				НепроведённыеВЦепочке = Новый Массив;
				УзелЗакупки = УзелСклада.ПолучитьЭлементы().Добавить();
				УзелЗакупки.Магазин = Склад;
				УзелЗакупки.Документ = Запись.Основание;
				Данные = ДанныеЗакупок.Получить(Запись.Основание);
				Если Данные <> Неопределено Тогда
					УзелЗакупки.Название = "Приобретение № " + Данные.Номер;
					УзелЗакупки.Дата = Данные.Дата;
					УзелЗакупки.Статус = ?(Данные.Проведен, "Проведён", "Не проведён");
					УзелЗакупки.Сумма = Данные.Сумма;
				Иначе
					УзелЗакупки.Название = Строка(Запись.Основание);
				КонецЕсли;
			КонецЕсли;
			УзелКорректировки = УзелЗакупки.ПолучитьЭлементы().Добавить();
			УзелКорректировки.Магазин = Склад;
			УзелКорректировки.Документ = Запись.Документ;
			УзелКорректировки.Название = "К" + Запись.НомерВЦепочке + " из " + Запись.ВсегоВЦепочке + " · Корректировка № " + Запись.Номер;
			УзелКорректировки.Дата = Запись.Дата;
			УзелКорректировки.Статус = ?(Запись.Проведен, "Проведена", "Не проведена");
			Данные = ДанныеКорректировок.Получить(Запись.Документ);
			УзелКорректировки.Сумма = ?(Данные = Неопределено, 0, Данные.Сумма);
			Если Запись.Статус = "ok" Тогда
				УзелКорректировки.Вердикт = ?(Запись.Проведен, "✔ «Товары» верны", "«Товары» верны, не проведена");
			ИначеЕсли Запись.Статус = "redo" Тогда
				УзелКорректировки.Вердикт = ?(Запись.Проведен, "✖ проведена, «Товары» расходятся", "✖ перезаполнить");
			Иначе
				УзелКорректировки.Вердикт = "— проверить нельзя";
			КонецЕсли;
			Если Запись.Статус = "redo" И Не Запись.Проведен Тогда
				УзелСклада.КорректировокПерезаполнить = УзелСклада.КорректировокПерезаполнить + 1;
			КонецЕсли;
			// Предупреждение о непроведённых корректировках цепочки (для возвратов под этой корректировкой)
			ПредупреждениеЦепочки = "";
			ИмяКорректировки = "К" + Запись.НомерВЦепочке;
			// Собственная непроведённость не мешает: корректировка проводится после удаления возврата.
			// Мешают только непроведённые предыдущие корректировки цепочки.
			Если НепроведённыеВЦепочке.Количество() > 0 Тогда
				ПредупреждениеЦепочки = "предыдущая корректировка не проведена: " + СтрСоединить(НепроведённыеВЦепочке, ", ")
					+ ", её расхождения учтены в «Товарах»";
			КонецЕсли;
			Если Не Запись.Проведен Тогда
				НепроведённыеВЦепочке.Добавить(ИмяКорректировки);
			КонецЕсли;
			// Возвраты, которые ссылаются на эту корректировку
			СписокВозвратов = ВозвратыПоКорр.Получить(Запись.Документ);
			Если СписокВозвратов <> Неопределено Тогда
				Для Каждого ЗаписьВозврата Из СписокВозвратов Цикл
					ДобавитьУзелВозврата(УзелКорректировки, ЗаписьВозврата, ДанныеВозвратов, ИнфоЦепочек, Склад, ПредупреждениеЦепочки);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

		// Возвраты без найденной корректировки
		СписокВозвратов = ВозвратыБезКорр.Получить(Склад);
		Если СписокВозвратов <> Неопределено Тогда
			УзелБез = УзелСклада.ПолучитьЭлементы().Добавить();
			УзелБез.Магазин = Склад;
			УзелБез.Название = "Возвраты без найденной корректировки";
			Для Каждого ЗаписьВозврата Из СписокВозвратов Цикл
				ДобавитьУзелВозврата(УзелБез, ЗаписьВозврата, ДанныеВозвратов, ИнфоЦепочек, Склад);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если Сохранять Тогда
		Для Каждого ИмяПоляСклада Из СтрРазделить("СкладФильтр,СкладМагазинов", ",") Цикл
			Если Элементы.Найти(ИмяПоляСклада) <> Неопределено Тогда
				Элементы[ИмяПоляСклада].СписокВыбора.Очистить();
				Для Каждого СтрокаСклада Из ТаблицаСкладов Цикл
					Элементы[ИмяПоляСклада].СписокВыбора.Добавить(СтрокаСклада.Склад, СтрокаСклада.Имя);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьУзелВозврата(Родитель, ЗаписьВозврата, ДанныеВозвратов, ИнфоЦепочек, Склад, Предупреждение = "")

	УзелВозврата = Родитель.ПолучитьЭлементы().Добавить();
	УзелВозврата.Магазин = Склад;
	УзелВозврата.Документ = ЗаписьВозврата.Документ;
	УзелВозврата.Название = "Возврат № " + ЗаписьВозврата.Номер;
	УзелВозврата.Дата = ЗаписьВозврата.Дата;
	Данные = ДанныеВозвратов.Получить(ЗаписьВозврата.Документ);
	Если Данные <> Неопределено Тогда
		УзелВозврата.Статус = ?(Данные.Проведен, "Проведён", "Не проведён");
		УзелВозврата.Сумма = Данные.Сумма;
	КонецЕсли;
	Категория = КатегорияВозврата(ЗаписьВозврата, ИнфоЦепочек);
	Если Категория.Код = "ok" И Не ПустаяСтрока(Предупреждение) Тогда
		УзелВозврата.Вердикт = "✔ можно удалять (100%); " + Предупреждение;
	ИначеЕсли Категория.Код = "blocked" Тогда
		УзелВозврата.Вердикт = Категория.Текст;
	ИначеЕсли Категория.Код = "ok" Тогда
		УзелВозврата.Вердикт = "✔ можно удалять (100%)";
	ИначеЕсли Категория.Код = "redo" Тогда
		УзелВозврата.Вердикт = "✖ к перезаполнению";
	ИначеЕсли ЗаписьВозврата.Статус = "full" Тогда
		УзелВозврата.Вердикт = "✔ можно удалить";
	ИначеЕсли ЗаписьВозврата.Статус = "partial" Тогда
		УзелВозврата.Вердикт = "⚠ ждут корректировок";
	Иначе
		УзелВозврата.Вердикт = "✖ нет совпадений";
	КонецЕсли;

КонецПроцедуры

// Подсветка дерева «Магазины» по колонке «Состояние».
&НаСервере
Процедура НастроитьПодсветкуМагазинов()

	Для Каждого Правило Из СтрРазделить("✔:214,240,222;✖:255,218,218;⚠:255,244,210", ";") Цикл
		Части = СтрРазделить(Правило, ":");
		Цвет = СтрРазделить(Части[1], ",");
		Элемент = УсловноеОформление.Элементы.Добавить();
		Для Каждого ИмяПоля Из СтрРазделить("МагазиныВердикт", ",") Цикл
			Поле = Элемент.Поля.Элементы.Добавить();
			Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЦикла;
		УсловиеОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		УсловиеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Магазины.Вердикт");
		УсловиеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
		УсловиеОтбора.ПравоеЗначение = Части[0];
		УсловиеОтбора.Использование = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(Число(Цвет[0]), Число(Цвет[1]), Число(Цвет[2])));
	КонецЦикла;

	// Колонка «Проведён» красится сама по себе: проведён — зелёным, не проведён — жёлтым
	Для Каждого ЗначениеПроведён Из СтрРазделить("Проведён,Проведена", ",") Цикл
		ЭлементПроведённые = УсловноеОформление.Элементы.Добавить();
		ПолеПроведённых = ЭлементПроведённые.Поля.Элементы.Добавить();
		ПолеПроведённых.Поле = Новый ПолеКомпоновкиДанных("МагазиныСтатус");
		УсловиеПроведённых = ЭлементПроведённые.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		УсловиеПроведённых.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Магазины.Статус");
		УсловиеПроведённых.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		УсловиеПроведённых.ПравоеЗначение = ЗначениеПроведён;
		УсловиеПроведённых.Использование = Истина;
		ЭлементПроведённые.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(214, 240, 222));
	КонецЦикла;
	// Непроведённые документы — жёлтым в колонке «Проведён»
	ЭлементНепроведённые = УсловноеОформление.Элементы.Добавить();
	ПолеНепроведённых = ЭлементНепроведённые.Поля.Элементы.Добавить();
	ПолеНепроведённых.Поле = Новый ПолеКомпоновкиДанных("МагазиныСтатус");
	УсловиеНепроведённых = ЭлементНепроведённые.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеНепроведённых.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Магазины.Статус");
	УсловиеНепроведённых.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
	УсловиеНепроведённых.ПравоеЗначение = "Не проведен";
	УсловиеНепроведённых.Использование = Истина;
	ЭлементНепроведённые.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 244, 210));

КонецПроцедуры

// Отбор по складу на вкладке «Магазины»: дерево перестраивается из сохранённых данных.
&НаСервере
Процедура ПрименитьСкладМагазинов()

	Если ПустаяСтрока(ЭтотОбъект.АдресМагазинов) Тогда
		Возврат;
	КонецЕсли;
	Хранимое = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресМагазинов);
	Если Хранимое = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтборСклада = ?(ЗначениеЗаполнено(ЭтотОбъект.СкладМагазинов), ЭтотОбъект.СкладМагазинов, Неопределено);
	ЗаполнитьМагазины(Хранимое.Результат, Хранимое.ИнфоЦепочек, ОтборСклада, Ложь);

КонецПроцедуры

// Возвраты по поступлениям за любой период (кроме перечисленных в ИсключитьСсылки).
&НаСервере
Функция ВозвратыПоПоступлениям(СсылкиЗакупок, ИсключитьСсылки)

	Результат = Новый Соответствие;
	Если СсылкиЗакупок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Исключить = Новый Соответствие;
	Для Каждого Ссылка Из ИсключитьСсылки Цикл
		Исключить.Вставить(Ссылка, Истина);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.ДокументПоступления КАК Закупка,
	|	Док.Ссылка КАК Возврат
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.ДокументПоступления В(&Закупки)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Т.ДокументПоступления,
	|	Т.Ссылка
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Товары КАК Т
	|ГДЕ
	|	НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.ДокументПоступления В(&Закупки)";
	Запрос.УстановитьПараметр("Закупки", СсылкиЗакупок);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат Результат;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Если Исключить.Получить(Выборка.Возврат) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Список = Результат.Получить(Выборка.Закупка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Выборка.Закупка, Список);
		КонецЕсли;
		Если Список.Найти(Выборка.Возврат) = Неопределено Тогда
			Список.Добавить(Выборка.Возврат);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дерево «Магазины»: возвраты за период вкладки и все остальные возвраты по тем же поступлениям (любой даты)
// вместе с цепочками корректировок. Если есть возвраты вне периода, сверка повторяется за расширенный период,
// чтобы показать, с какой корректировкой связан каждый из них.
&НаСервере
Процедура СформироватьМагазиныЗаПериод()

	ПараметрыПериода = ПараметрыСверкиСервер();
	ПараметрыПериода.НачалоПериода = ?(ЗначениеЗаполнено(ЭтотОбъект.ПериодМагазиновС), ЭтотОбъект.ПериодМагазиновС, НачалоПериода);
	ПараметрыПериода.КонецПериода = ?(ЗначениеЗаполнено(ЭтотОбъект.ПериодМагазиновПо), ЭтотОбъект.ПериодМагазиновПо, КонецПериода);
	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = Обработка.ПрочитатьДанные(ПараметрыПериода);
	Итог = Обработка.Сверить(ПараметрыПериода, Данные);

	Основания = Новый Массив;
	Для Каждого Запись Из Итог.Корректировки Цикл
		Если (Запись.Статус = "full" Или Запись.Статус = "partial") И ЗначениеЗаполнено(Запись.Основание)
			И Основания.Найти(Запись.Основание) = Неопределено Тогда
			Основания.Добавить(Запись.Основание);
		КонецЕсли;
	КонецЦикла;

	// Остальные возвраты по этим поступлениям — любой даты
	ИзвестныеВозвраты = Новый Массив;
	Нужные = Новый Соответствие;
	Для Каждого Запись Из Итог.Возвраты Цикл
		ИзвестныеВозвраты.Добавить(Запись.Документ);
		Нужные.Вставить(Запись.Документ, Истина);
	КонецЦикла;
	ДопСсылки = Новый Массив;
	Для Каждого Элемент Из ВозвратыПоПоступлениям(Основания, ИзвестныеВозвраты) Цикл
		Для Каждого Ссылка Из Элемент.Значение Цикл
			Если Нужные.Получить(Ссылка) = Неопределено Тогда
				ДопСсылки.Добавить(Ссылка);
				Нужные.Вставить(Ссылка, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ДопСсылки.Количество() > 0 Тогда
		НачалоРасширенное = ПараметрыПериода.НачалоПериода;
		КонецРасширенный = ПараметрыПериода.КонецПериода;
		Для Каждого Элемент Из ДанныеДокументов(ДопСсылки, "ВозвратТоваровПоставщику") Цикл
			НачалоРасширенное = Мин(НачалоРасширенное, Элемент.Значение.Дата);
			КонецРасширенный = Макс(КонецРасширенный, Элемент.Значение.Дата);
		КонецЦикла;
		ПараметрыШирокие = ПараметрыСверкиСервер();
		ПараметрыШирокие.НачалоПериода = НачалоДня(НачалоРасширенное);
		ПараметрыШирокие.КонецПериода = КонецДня(КонецРасширенный);
		ДанныеШирокие = Обработка.ПрочитатьДанные(ПараметрыШирокие);
		РезультатШирокий = Обработка.Сверить(ПараметрыШирокие, ДанныеШирокие);
		ОтобранныеВозвраты = Новый Массив;
		СсылкиКорректировок = Новый Соответствие;
		Для Каждого Запись Из РезультатШирокий.Возвраты Цикл
			Если Нужные.Получить(Запись.Документ) <> Неопределено Тогда
				ОтобранныеВозвраты.Добавить(Запись);
				Для Каждого КорректировкаСсылка Из Запись.Корректировки Цикл
					СсылкиКорректировок.Вставить(КорректировкаСсылка, Истина);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Запись Из РезультатШирокий.Корректировки Цикл
			Если СсылкиКорректировок.Получить(Запись.Документ) <> Неопределено И ЗначениеЗаполнено(Запись.Основание)
				И Основания.Найти(Запись.Основание) = Неопределено Тогда
				Основания.Добавить(Запись.Основание);
			КонецЕсли;
		КонецЦикла;
		Итог = Новый Структура("Возвраты, Корректировки", ОтобранныеВозвраты, РезультатШирокий.Корректировки);
	КонецЕсли;

	ЗаполнитьМагазины(Итог, ИнформацияПоЦепочкам(Основания));
	ЭтотОбъект.МагазиныПостроены = Истина;
	Если Элементы.Найти("ПодсказкаМагазинов") <> Неопределено Тогда
		Элементы.ПодсказкаМагазинов.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

// Вердикты по цепочкам: соответствие «корректировка -> результат проверки».
&НаСервере
Функция ИнформацияПоЦепочкам(ОснованияЦепочек)

	Инфо = Новый Соответствие;
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого Запись Из Обработка.ПроверитьЦепочки(ОснованияЦепочек) Цикл
		Инфо.Вставить(Запись.Документ, Запись);
	КонецЦикла;
	Возврат Инфо;

КонецФункции

// Красным — возврат/позиция, чьи корректировки нужно перезаполнить; зелёным — всё проверено и верно.
&НаСервере
Процедура НастроитьПодсветкуДерева()

	Для Каждого Правило Из СтрРазделить("✔:214,240,222;✖:255,218,218;✔ перезаполнена:170,205,250;✔ (проба):170,205,250;⚠:255,244,210", ";") Цикл
		Части = СтрРазделить(Правило, ":");
		Цвет = СтрРазделить(Части[1], ",");
		Элемент = УсловноеОформление.Элементы.Добавить();
		Для Каждого ИмяПоля Из СтрРазделить("ДеревоВыбран,ДеревоНазвание,ДеревоСтатус,ДеревоДата,ДеревоКоличество,ДеревоКорректировка,ДеревоКоличествоКорр,ДеревоРезультат", ",") Цикл
			Поле = Элемент.Поля.Элементы.Добавить();
			Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЦикла;
		УсловиеОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		УсловиеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дерево.Результат");
		УсловиеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
		УсловиеОтбора.ПравоеЗначение = Части[0];
		УсловиеОтбора.Использование = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(Число(Цвет[0]), Число(Цвет[1]), Число(Цвет[2])));
	КонецЦикла;

КонецПроцедуры

// Определяет категорию возврата и текст для колонки «Результат» с учётом проверки цепочек.
// Код: "ok" — все корректировки заполнены верно (можно удалять), "redo" — есть корректировки к перезаполнению,
// "partial" / "none" / "full" — как в подборе, когда вердикта по цепочкам нет.
&НаСервере
Функция КатегорияВозврата(Запись, ИнфоЦепочек)

	КПерезаполнению = Новый Массив;
	Верных = 0;
	НетДанных = 0;
	Просмотрены = Новый Соответствие;
	Для Каждого Деталь Из Запись.Детали Цикл
		Если Деталь.Корректировка = Неопределено Или Просмотрены.Получить(Деталь.Корректировка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Просмотрены.Вставить(Деталь.Корректировка, Истина);
		Инфо = ИнфоЦепочек.Получить(Деталь.Корректировка);
		Если Инфо = Неопределено Или Инфо.Статус = "nodata" Тогда
			НетДанных = НетДанных + 1;
		ИначеЕсли Инфо.Статус = "redo" Тогда
			КПерезаполнению.Добавить("К" + Инфо.НомерВЦепочке + " из " + Инфо.ВсегоВЦепочке + " № " + Инфо.Номер);
		Иначе
			Верных = Верных + 1;
		КонецЕсли;
	КонецЦикла;

	// Непроведённые корректировки, стоящие в цепочке раньше корректировок этого возврата
	// (индекс «поступление -> корректировки» строится один раз на вызов)
	Если КэшИнфоЦепочек = Неопределено Или КэшИнфоЦепочек <> ИнфоЦепочек Тогда
		КэшИнфоЦепочек = ИнфоЦепочек;
		КэшИндексЦепочек = Новый Соответствие;
		Для Каждого ДругойЭлемент Из ИнфоЦепочек Цикл
			Другая = ДругойЭлемент.Значение;
			СписокЦепочки = КэшИндексЦепочек.Получить(Другая.Основание);
			Если СписокЦепочки = Неопределено Тогда
				СписокЦепочки = Новый Массив;
				КэшИндексЦепочек.Вставить(Другая.Основание, СписокЦепочки);
			КонецЕсли;
			СписокЦепочки.Добавить(Другая);
		КонецЦикла;
	КонецЕсли;
	Блокирующие = Новый Массив;
	Для Каждого ЭлементПросмотра Из Просмотрены Цикл
		ИнфоКорр = ИнфоЦепочек.Получить(ЭлементПросмотра.Ключ);
		Если ИнфоКорр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СписокЦепочки = КэшИндексЦепочек.Получить(ИнфоКорр.Основание);
		Если СписокЦепочки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Другая Из СписокЦепочки Цикл
			Если Другая.НомерВЦепочке < ИнфоКорр.НомерВЦепочке И Не Другая.Проведен Тогда
				ИмяДругой = "К" + Другая.НомерВЦепочке + " № " + Другая.Номер;
				Если Блокирующие.Найти(ИмяДругой) = Неопределено Тогда
					Блокирующие.Добавить(ИмяДругой);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Структура("Код, Текст", Запись.Статус, "");
	Если КПерезаполнению.Количество() > 0 Тогда
		Результат.Код = "redo";
		Результат.Текст = "✖ Перезаполнить: " + СтрСоединить(КПерезаполнению, ", ");
	ИначеЕсли Запись.Статус = "full" Тогда
		Если НетДанных = 0 Тогда
			Результат.Код = "ok";
			Результат.Текст = "✔ 100%: «Товары» всех корректировок верны — можно удалять"
				+ ?(Блокирующие.Количество() > 0, " (предыдущая корректировка не проведена: " + СтрСоединить(Блокирующие, ", ")
					+ ", её расхождения учтены в «Товарах»)", "");
		Иначе
			Результат.Текст = "Цепочку корректировок проверить нельзя (основание не поступление) — проверьте вручную";
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Шаг 4: то же, что ОбновитьКВыполнению, но на клиенте — без обращения к серверу (быстро).
&НаКлиенте
Процедура ОбновитьКВыполнениюНаКлиенте()

	Для Каждого СтрокаКорр Из Корректировки Цикл
		СтрокаКорр.КВыполнению = Ложь;
	КонецЦикла;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если Не СтрокаВозврата.Выбран Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаПозиции Из СтрокаВозврата.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(СтрокаПозиции.Корректировка) Тогда
				Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", СтрокаПозиции.Корректировка)) Цикл
					СтрокаКорр.КВыполнению = Истина;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Шаг 4: помечает корректировки, связанные с возвратами, отмеченными на шаге 3 (только они показываются в таблице).
&НаСервере
Процедура ОбновитьКВыполнению()

	Для Каждого СтрокаКорр Из Корректировки Цикл
		СтрокаКорр.КВыполнению = Ложь;
	КонецЦикла;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если Не СтрокаВозврата.Выбран Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаПозиции Из СтрокаВозврата.ПолучитьЭлементы() Цикл
			Если ЗначениеЗаполнено(СтрокаПозиции.Корректировка) Тогда
				Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", СтрокаПозиции.Корректировка)) Цикл
					СтрокаКорр.КВыполнению = Истина;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Шаг 2: помечает строки проверки цепочек, подходящие под «Корректировка №» (пусто — все строки).
&НаСервере
Процедура ПометитьНайденныеЦепочки()

	Для Каждого СтрокаСписка Из Цепочки Цикл
		Если ПустаяСтрока(ЭтотОбъект.ПоискЦепочки) Или Не ЗначениеЗаполнено(СтрокаСписка.Корректировка) Тогда
			СтрокаСписка.Найдена = ПустаяСтрока(ЭтотОбъект.ПоискЦепочки);
		Иначе
			СтрокаСписка.Найдена = НомерПодходитПоиску(Строка(СтрокаСписка.Корректировка.Номер), ЭтотОбъект.ПоискЦепочки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоискЦепочкиПриИзменении(Элемент)

	ПометитьНайденныеЦепочки();
	ОбновитьОтборыТаблиц();

КонецПроцедуры

// ===== Шаг 6: проверка остатков на складе (было / стало) =====

// Пары «склад — номенклатура» отмеченных возвратов (полностью и частично сопоставленных): Ключ -> Структура(Склад, Номенклатура).
&НаСервере
Функция ПарыСкладНоменклатураОтмеченных()

	Пары = Новый Соответствие;
	Если ПустаяСтрока(ЭтотОбъект.АдресДерева) Тогда
		Возврат Пары;
	КонецЕсли;
	Хранимое = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресДерева);
	Если Хранимое = Неопределено Тогда
		Возврат Пары;
	КонецЕсли;
	Выбор = Новый Соответствие;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.Выбран И (СтрокаВозврата.КодСтатуса = "full" Или СтрокаВозврата.КодСтатуса = "partial") Тогда
			Выбор.Вставить(СтрокаВозврата.Возврат, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Запись Из Хранимое.Результат.Возвраты Цикл
		Если Выбор.Получить(Запись.Документ) = Неопределено Или Не ЗначениеЗаполнено(Запись.Склад) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Деталь Из Запись.Детали Цикл
			Если Не ЗначениеЗаполнено(Деталь.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			Ключ = КлючСкладНоменклатура(Запись.Склад, Деталь.Номенклатура);
			Если Пары.Получить(Ключ) = Неопределено Тогда
				Пары.Вставить(Ключ, Новый Структура("Склад, Номенклатура", Запись.Склад, Деталь.Номенклатура));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Пары;

КонецФункции

&НаСервере
Функция КлючСкладНоменклатура(Склад, Номенклатура)

	Возврат Строка(Склад.УникальныйИдентификатор()) + "|" + Строка(Номенклатура.УникальныйИдентификатор());

КонецФункции

// Текущие остатки «в наличии» по парам склад/номенклатура: Соответствие Ключ -> Количество.
// Возвращает Неопределено, если регистр остатков не найден или запрос не выполнился (причина — в сообщении).
&НаСервере
Функция ТекущиеОстаткиПоПарам(Пары)

	Если Пары.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Регистр = Метаданные.РегистрыНакопления.Найти("ТоварыНаСкладах");
	Если Регистр = Неопределено Тогда
		Сообщить("Остатки не проверены: в конфигурации нет регистра накопления «ТоварыНаСкладах».");
		Возврат Неопределено;
	КонецЕсли;
	ИмяРесурса = Неопределено;
	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Если Найти(Ресурс.Имя, "ВНаличии") > 0 Тогда
			ИмяРесурса = Ресурс.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИмяРесурса = Неопределено Тогда
		ИмяРесурса = Регистр.Ресурсы[0].Имя;
	КонецЕсли;
	Склады = Новый Массив;
	Номенклатура = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если Склады.Найти(Пара.Значение.Склад) = Неопределено Тогда
			Склады.Добавить(Пара.Значение.Склад);
		КонецЕсли;
		Если Номенклатура.Найти(Пара.Значение.Номенклатура) = Неопределено Тогда
			Номенклатура.Добавить(Пара.Значение.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	Остатки.Склад КАК Склад,
			|	Остатки.Номенклатура КАК Номенклатура,
			|	СУММА(Остатки." + ИмяРесурса + "Остаток) КАК Количество
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад В (&Склады) И Номенклатура В (&Номенклатура)) КАК Остатки
			|СГРУППИРОВАТЬ ПО
			|	Остатки.Склад,
			|	Остатки.Номенклатура";
		Запрос.УстановитьПараметр("Склады", Склады);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(КлючСкладНоменклатура(Выборка.Склад, Выборка.Номенклатура), Выборка.Количество);
		КонецЦикла;
	Исключение
		Сообщить("Остатки не проверены: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// «Было»: остатки в момент нажатия «Выполнить» (до проведения корректировок).
&НаСервере
Процедура ЗафиксироватьОстаткиДо()

	ЭтотОбъект.Остатки.Очистить();
	Пары = ПарыСкладНоменклатураОтмеченных();
	Остатки_ = ТекущиеОстаткиПоПарам(Пары);
	Если Остатки_ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Пара Из Пары Цикл
		НоваяСтрока = ЭтотОбъект.Остатки.Добавить();
		НоваяСтрока.Склад = Пара.Значение.Склад;
		НоваяСтрока.Номенклатура = Пара.Значение.Номенклатура;
		НоваяСтрока.Было = ?(Остатки_.Получить(Пара.Ключ) = Неопределено, 0, Остатки_.Получить(Пара.Ключ));
		НоваяСтрока.Стало = НоваяСтрока.Было;
		НоваяСтрока.Разница = 0;
	КонецЦикла;
	ЭтотОбъект.Остатки.Сортировать("Склад, Номенклатура");

КонецПроцедуры

// «Стало»: остатки после выполнения (в пробном режиме в базе ничего не меняется — «Стало» равно «Было»).
&НаСервере
Процедура ЗафиксироватьОстаткиПосле()

	Если ЭтотОбъект.Остатки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ПробныйРежим Тогда
		Для Каждого СтрокаОстатка Из ЭтотОбъект.Остатки Цикл
			СтрокаОстатка.Комментарий = "Пробный режим: в базе ничего не изменено";
		КонецЦикла;
		Возврат;
	КонецЕсли;
	ПересчитатьСталоОстатков();

КонецПроцедуры

&НаСервере
Процедура ПересчитатьСталоОстатков()

	Пары = Новый Соответствие;
	Для Каждого СтрокаОстатка Из ЭтотОбъект.Остатки Цикл
		Пары.Вставить(КлючСкладНоменклатура(СтрокаОстатка.Склад, СтрокаОстатка.Номенклатура), Новый Структура("Склад, Номенклатура", СтрокаОстатка.Склад, СтрокаОстатка.Номенклатура));
	КонецЦикла;
	Остатки_ = ТекущиеОстаткиПоПарам(Пары);
	Если Остатки_ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаОстатка Из ЭтотОбъект.Остатки Цикл
		Количество = Остатки_.Получить(КлючСкладНоменклатура(СтрокаОстатка.Склад, СтрокаОстатка.Номенклатура));
		СтрокаОстатка.Стало = ?(Количество = Неопределено, 0, Количество);
		СтрокаОстатка.Разница = СтрокаОстатка.Стало - СтрокаОстатка.Было;
		СтрокаОстатка.Комментарий = ?(СтрокаОстатка.Разница = 0, "Без изменений", ?(СтрокаОстатка.Разница < 0, "Остаток уменьшился", "Остаток увеличился"));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтало(Команда)

	ОбновитьСталоНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСталоНаСервере()

	Если ЭтотОбъект.Остатки.Количество() = 0 Тогда
		Сообщить("Остатки ещё не снимались: сначала выполните шаг 4 «Выполнить».");
		Возврат;
	КонецЕсли;
	ПересчитатьСталоОстатков();

КонецПроцедуры

&НаКлиенте
Процедура ДалееШаг6(Команда)

	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОстатки;

КонецПроцедуры

// Номер подходит поиску: сравниваются цифры номера (префикс КТЦБ и тире, русские/латинские буквы не мешают).
&НаСервере
Функция НомерПодходитПоиску(Номер, Поиск)

	ЦифрыПоиска = ТолькоЦифрыСтроки(Поиск);
	Если ПустаяСтрока(ЦифрыПоиска) Тогда
		Возврат Найти(ВРег(Номер), ВРег(СокрЛП(Поиск))) > 0;
	КонецЕсли;
	Возврат Найти(ТолькоЦифрыСтроки(Номер), ЦифрыПоиска) > 0;

КонецФункции

&НаСервере
Функция ТолькоЦифрыСтроки(Значение)

	Результат = "";
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заполняет дерево возвратов; Фильтр — значение поля «Показать» над деревом.
&НаСервере
Процедура ЗаполнитьДерево(Результат, ИнфоЦепочек, Фильтр, Выбранные, Магазины = Неопределено)

	Для Каждого Запись Из Результат.Возвраты Цикл

		Если Магазины <> Неопределено И Магазины.Количество() > 0 И Магазины.Получить(Запись.Склад) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Категория = КатегорияВозврата(Запись, ИнфоЦепочек);
		Если Не ПодходитПоФильтру(Запись, Категория, Фильтр) Тогда
			Продолжить;
		КонецЕсли;
		// Поиск по номеру корректировки: оставляем возвраты, к которым относится такая корректировка
		Если Не ПустаяСтрока(ЭтотОбъект.ПоискКорректировки) Тогда
			Найдено = Ложь;
			Для Каждого ДетальПоиска Из Запись.Детали Цикл
				Если ДетальПоиска.Корректировка <> Неопределено И НомерПодходитПоиску(Строка(ДетальПоиска.КорректировкаНомер), ЭтотОбъект.ПоискКорректировки) Тогда
					Найдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Найдено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СтрокаВозврата = Дерево.ПолучитьЭлементы().Добавить();
		СтрокаВозврата.Возврат = Запись.Документ;
		СтрокаВозврата.Название = "Возврат № " + Запись.Номер + " от " + Формат(Запись.Дата, "ДФ=dd.MM.yyyy");
		СтрокаВозврата.Дата = Запись.Дата;
		СтрокаВозврата.КодСтатуса = Запись.Статус;
		СтрокаВозврата.Склад = Запись.Склад;

		Если Запись.Статус = "full" И Категория.Код = "blocked" Тогда
			СтрокаВозврата.Статус = "⚠ Пока нельзя удалять";
		ИначеЕсли Запись.Статус = "full" И Категория.Код = "redo" Тогда
			СтрокаВозврата.Статус = "✖ Нельзя: сначала перезаполнить";
		ИначеЕсли Запись.Статус = "full" Тогда
			СтрокаВозврата.Статус = "✔ Можно удалить";
		ИначеЕсли Запись.Статус = "partial" Тогда
			Если Запись.НеГотовыеКорректировки.Количество() > 0 Тогда
				СтрокаВозврата.Статус = "⚠ Корректировка закрыта не полностью";
				СтрокаВозврата.Результат = "Не закрыты полностью: " + СтрСоединить(Запись.НеГотовыеКорректировки, ", ");
			Иначе
				СтрокаВозврата.Статус = "⚠ Частично (" + Запись.Совпало + " из " + Запись.Всего + ")";
			КонецЕсли;
		Иначе
			СтрокаВозврата.Статус = "✖ Нет совпадений";
		КонецЕсли;
		Если Не ПустаяСтрока(Категория.Текст) И (Категория.Код = "redo" Или Категория.Код = "blocked" Или ПустаяСтрока(СтрокаВозврата.Результат)) Тогда
			СтрокаВозврата.Результат = Категория.Текст;
		КонецЕсли;

		Для Каждого Деталь Из Запись.Детали Цикл
			СтрокаПозиции = СтрокаВозврата.ПолучитьЭлементы().Добавить();
			СтрокаПозиции.Название = Строка(Деталь.Номенклатура);
			СтрокаПозиции.Количество = Деталь.Количество;
			Если Деталь.Корректировка <> Неопределено Тогда
				СтрокаПозиции.Корректировка = Деталь.Корректировка;
				СтрокаПозиции.КоличествоКорр = Деталь.КоличествоКорр;
				СтрокаПозиции.Статус = "✔ № " + Деталь.КорректировкаНомер;
				СтрокаПозиции.КодСтатуса = "ok";
				Инфо = ИнфоЦепочек.Получить(Деталь.Корректировка);
				Если Инфо <> Неопределено Тогда
					НомерВЦепочке = "К" + Инфо.НомерВЦепочке + " из " + Инфо.ВсегоВЦепочке;
					Если Инфо.Статус = "ok" И Не ПустаяСтрока(Инфо.ПерезаполненаОбработкой) И Не Инфо.Проведен Тогда
						СтрокаПозиции.Результат = НомерВЦепочке + ": ✔ перезаполнена обработкой на шаге 2";
					ИначеЕсли Инфо.Статус = "ok" Тогда
						СтрокаПозиции.Результат = НомерВЦепочке + ": ✔ верно, перезаполнять не нужно";
					ИначеЕсли Инфо.Статус = "redo" Тогда
						СтрокаПозиции.Результат = НомерВЦепочке + ?(Инфо.Проведен, ": ✖ проведена, «Товары» расходятся (", ": ✖ перезаполнить (")
							+ Инфо.Отличия + ")";
					Иначе
						СтрокаПозиции.Результат = НомерВЦепочке + ": проверить нельзя";
					КонецЕсли;
				КонецЕсли;
			Иначе
				СтрокаПозиции.Статус = "✖ корректировка не найдена";
				СтрокаПозиции.КодСтатуса = "no";
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	ИндексКорр = ИндексКорректировок();
	// По умолчанию отмечаем то, что есть смысл обрабатывать: закрытые возвраты и возвраты, у которых
	// уже есть полностью сопоставленные непроведённые корректировки; прежний выбор пользователя сохраняется.
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Прежний = Выбранные.Получить(СтрокаВозврата.Возврат);
		Если Прежний <> Неопределено Тогда
			СтрокаВозврата.Выбран = Прежний;
		Иначе
			СтрокаВозврата.Выбран = (СтрокаВозврата.КодСтатуса = "full" И Найти(СтрокаВозврата.Результат, "⚠") = 0 И Найти(СтрокаВозврата.Результат, "✖") = 0)
				Или (СтрокаВозврата.КодСтатуса = "partial" И КорректировкиСтрокиВозврата(СтрокаВозврата, ИндексКорр).Количество() > 0);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПодходитПоФильтру(Запись, Категория, Фильтр)

	Если ПустаяСтрока(Фильтр) Или Фильтр = "Все" Тогда
		Возврат Истина;
	ИначеЕсли Фильтр = "✔ можно удалять (100%)" Тогда
		Возврат Категория.Код = "ok";
	ИначеЕсли Фильтр = "⚠ пока нельзя удалять" Тогда
		Возврат Категория.Код = "blocked";
	ИначеЕсли Фильтр = "✖ нужно перезаполнить" Тогда
		Возврат Категория.Код = "redo";
	ИначеЕсли Фильтр = "⚠ ждут корректировок" Тогда
		Возврат Запись.Статус = "partial";
	ИначеЕсли Фильтр = "✖ нет совпадений" Тогда
		Возврат Запись.Статус = "none" Или (Запись.Статус <> "full" И Запись.Статус <> "partial");
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Фильтр «Показать» над деревом: перестраивает дерево из сохранённого результата подбора, сохраняя отметки.
&НаСервере
Процедура ПрименитьФильтрДерева()

	Если ПустаяСтрока(ЭтотОбъект.АдресДерева) Тогда
		Возврат;
	КонецЕсли;
	Хранимое = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресДерева);
	Если Хранимое = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Хранимое.Выбранные.Вставить(СтрокаВозврата.Возврат, СтрокаВозврата.Выбран);
	КонецЦикла;
	ЭтотОбъект.АдресДерева = ПоместитьВоВременноеХранилище(Хранимое, УникальныйИдентификатор);
	Дерево.ПолучитьЭлементы().Очистить();
	ЗаполнитьДерево(Хранимое.Результат, Хранимое.ИнфоЦепочек, ЭтотОбъект.ФильтрДерева, Хранимое.Выбранные, ВыбранныеМагазины());
	Если Не ПустаяСтрока(ЭтотОбъект.ПоискКорректировки) И Дерево.ПолучитьЭлементы().Количество() = 0 Тогда
		Сообщить("Корректировка «" + ЭтотОбъект.ПоискКорректировки + "» не связана ни с одним возвратом периода (с учётом фильтров «Показать» и «Склад»). Возможно, к ней нет возврата в этом периоде — смотрите шаг 2.");
	КонецЕсли;

КонецПроцедуры

// Итоговая строка над деревом.
&НаСервере
Процедура ОбновитьСводку(КолвоСтрокВозвратов = Неопределено, КолвоСтрокКорректировок = Неопределено)

	Закрыто = 0;
	Заблокировано = 0;
	Частично = 0;
	БезПары = 0;
	Отмечено = 0;
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если СтрокаВозврата.КодСтатуса = "full" И (Найти(СтрокаВозврата.Результат, "⚠") > 0 Или Найти(СтрокаВозврата.Результат, "✖ Перезаполнить") > 0) Тогда
			Заблокировано = Заблокировано + 1;
		ИначеЕсли СтрокаВозврата.КодСтатуса = "full" Тогда
			Закрыто = Закрыто + 1;
		ИначеЕсли СтрокаВозврата.КодСтатуса = "partial" Тогда
			Частично = Частично + 1;
		Иначе
			БезПары = БезПары + 1;
		КонецЕсли;
		Если СтрокаВозврата.Выбран Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	НеПроведено = 0;
	Для Каждого СтрокаКорр Из Корректировки Цикл
		Если Не СтрокаКорр.Проведена Тогда
			НеПроведено = НеПроведено + 1;
		КонецЕсли;
	КонецЦикла;

	Сводка = "Возвратов: " + Дерево.ПолучитьЭлементы().Количество()
		+ "  |  ✔ можно удалить: " + Закрыто
		+ "  |  ⚠ пока нельзя: " + Заблокировано
		+ "  |  ⚠ ждут корректировок: " + Частично
		+ "  |  ✖ без совпадений: " + БезПары
		+ "  |  отмечено к обработке: " + Отмечено
		+ "  |  непроведённых корректировок: " + НеПроведено;

КонецПроцедуры

// Корректировки возврата, которые можно проводить: сопоставлены с возвратом, все их позиции
// нашли возврат (иначе проведение затронет позиции без возврата) и они ещё не проведены.
&НаСервере
Функция ИндексКорректировок()

	Индекс = Новый Соответствие;
	Для Каждого СтрокаКорр Из Корректировки Цикл
		Индекс.Вставить(СтрокаКорр.Корректировка, СтрокаКорр);
	КонецЦикла;
	Возврат Индекс;

КонецФункции

&НаСервере
Функция КорректировкиСтрокиВозврата(СтрокаВозврата, ИндексКорр)

	Результат = Новый Массив;
	Для Каждого СтрокаПозиции Из СтрокаВозврата.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(СтрокаПозиции.Корректировка) Или Результат.Найти(СтрокаПозиции.Корректировка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаКорр = ИндексКорр.Получить(СтрокаПозиции.Корректировка);
		Если СтрокаКорр <> Неопределено Тогда
			Если СтрокаКорр.КодСтатуса = "full" И Не СтрокаКорр.Проведена Тогда
				Результат.Добавить(СтрокаПозиции.Корректировка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ВыполнитьНаСервере()

	Журнал.Очистить();
	Обработка = РеквизитФормыВЗначение("Объект");

	ВремяСтарта = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИндексКорр = ИндексКорректировок();
	ВремяИндекса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗафиксироватьОстаткиДо();
	ВремяОстатковДо = ТекущаяУниверсальнаяДатаВМиллисекундах();
	УсловноПроведены = Новый Массив; // пробный режим: корректировки, «проведённые» для предыдущих возвратов
	Помечено = 0;
	Ожидают = 0;
	Ошибок = 0;
	ОтложеноЛимитом = 0;
	Обработано = 0;

	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл

		Если Не СтрокаВозврата.Выбран Или (СтрокаВозврата.КодСтатуса <> "full" И СтрокаВозврата.КодСтатуса <> "partial") Тогда
			Продолжить;
		КонецЕсли;

		ТекстВозврата = СтрокаВозврата.Название;
		КПроведению = КорректировкиСтрокиВозврата(СтрокаВозврата, ИндексКорр);
		// Уже условно проведённые для предыдущих возвратов (пробный режим) повторно не показываем
		Для Индекс = -КПроведению.ВГраница() По 0 Цикл
			Если УсловноПроведены.Найти(КПроведению[-Индекс]) <> Неопределено Тогда
				КПроведению.Удалить(-Индекс);
			КонецЕсли;
		КонецЦикла;
		ПолностьюЗакрыт = (СтрокаВозврата.КодСтатуса = "full");

		Если Не ПолностьюЗакрыт И КПроведению.Количество() = 0 Тогда
			СтрокаВозврата.Результат = "Ждём недостающие корректировки (проводить пока нечего)";
			Ожидают = Ожидают + 1;
			Продолжить;
		КонецЕсли;

		Если Не ПробныйРежим И Обработано >= ЛимитЦепочек Тогда
			СтрокаВозврата.Результат = "Не обработан: лимит возвратов за один запуск";
			ОтложеноЛимитом = ОтложеноЛимитом + 1;
			Продолжить;
		КонецЕсли;
		Обработано = Обработано + 1;

		// --- пробный режим: возврат не трогаем, только показываем, что будет с корректировками
		Если ПробныйРежим Тогда
			ПровестиКорректировкиВозврата(Обработка, КПроведению, ТекстВозврата, УсловноПроведены);
			СтрокаВозврата.Результат = "Пробный режим: " + ?(ПолностьюЗакрыт,
				"будут проведены корректировки и возврат помечен на удаление",
				"будут проведены найденные корректировки, возврат останется");
			Если Не ПолностьюЗакрыт Тогда
				ПозицииПлан = ПозицииКУдалению(СтрокаВозврата.Возврат, КПроведению);
				Если ПозицииПлан.Количество() > 0 Тогда
					ИмёнаПлан = Новый Массив;
					Для Каждого Позиция Из ПозицииПлан Цикл
						ИмёнаПлан.Добавить("№ " + Позиция.НомерСтроки + " " + Позиция.Название);
					КонецЦикла;
					СтрокаВозврата.Результат = СтрокаВозврата.Результат + "; из возврата будут удалены строки: " + СтрСоединить(ИмёнаПлан, "; ");
					ДобавитьСтрокуЖурнала("•", ТекстВозврата, Неопределено, "ПРОБНЫЙ РЕЖИМ: из возврата будут удалены строки: " + СтрСоединить(ИмёнаПлан, "; ")
						+ "; возврат останется проведённым с остальными позициями");
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// --- реальный режим
		БылПроведен = Ложь;
		Если ПолностьюЗакрыт Тогда
			// Сначала снимаем возврат (иначе проведение корректировок задвоит списание остатков)
			РезультатПометки = ПометитьВозвратНаУдаление(СтрокаВозврата.Возврат);
			Если Не ПустаяСтрока(РезультатПометки.Ошибка) Тогда
				СтрокаВозврата.Результат = "✖ Ошибка пометки возврата: " + РезультатПометки.Ошибка;
				ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				Ошибок = Ошибок + 1;
				Продолжить;
			КонецЕсли;
			БылПроведен = РезультатПометки.БылПроведен;
		КонецЕсли;

		Итог = ПровестиКорректировкиВозврата(Обработка, КПроведению, ТекстВозврата, УсловноПроведены);

		Если ПолностьюЗакрыт Тогда
			Если Итог.Успешно Тогда
				СтрокаВозврата.Результат = "✔ Помечен на удаление, проведено корректировок: " + Итог.Проведено;
				СтрокаВозврата.Статус = "✔ Удалён (помечен)";
				ДобавитьСтрокуЖурнала("✔", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				СтрокаВозврата.Выбран = Ложь;
				Помечено = Помечено + 1;
			Иначе
				// Корректировки не проведены — возвращаем возврат в прежнее состояние
				ОшибкаВосстановления = ВосстановитьВозврат(СтрокаВозврата.Возврат, БылПроведен);
				ПроведеноЧасть = ?(Итог.Проведено > 0, " Уже проведено корректировок: " + Итог.Проведено
					+ " — проверьте остатки по возврату (возврат снова проведён, а эти корректировки тоже проведены).", "");
				Если ПустаяСтрока(ОшибкаВосстановления) Тогда
					СтрокаВозврата.Результат = "✖ Корректировки проведены не полностью — возврат восстановлен (не удалён)." + ПроведеноЧасть;
				Иначе
					СтрокаВозврата.Результат = "✖ ВНИМАНИЕ: корректировки проведены не полностью, возврат не удалось восстановить: "
						+ ОшибкаВосстановления + ПроведеноЧасть;
				КонецЕсли;
				ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				Ошибок = Ошибок + 1;
			КонецЕсли;
		Иначе
			Если Итог.Успешно Тогда
				СтрокаВозврата.Результат = "⏳ Проведено корректировок: " + Итог.Проведено + ". Возврат остаётся, ждём недостающие";
				// Сначала проведены корректировки — теперь убираем из возврата закрытые ими строки (возврат остаётся проведённым)
				ПозицииУдалить = ПозицииКУдалению(СтрокаВозврата.Возврат, Итог.Список);
				Если ПозицииУдалить.Количество() > 0 Тогда
					РезультатПравки = Обработка.УдалитьСтрокиИзВозврата(СтрокаВозврата.Возврат, НомераСтрокСоответствие(ПозицииУдалить), Ложь);
					Если РезультатПравки.Успех Тогда
						СтрокаВозврата.Результат = "✔ Проведено корректировок: " + Итог.Проведено + "; " + РезультатПравки.Сообщение
							+ ". Возврат остаётся проведённым с позициями, не нашедшими пару";
					Иначе
						СтрокаВозврата.Результат = "✖ Корректировки проведены (" + Итог.Проведено + "), но возврат не изменён: " + РезультатПравки.Сообщение;
						ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
						Ошибок = Ошибок + 1;
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				ДобавитьСтрокуЖурнала("•", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				СтрокаВозврата.Выбран = Ложь;
				Ожидают = Ожидают + 1;
			Иначе
				СтрокаВозврата.Результат = "✖ Часть корректировок не проведена (см. журнал)";
				ДобавитьСтрокуЖурнала("✖", ТекстВозврата, Неопределено, СтрокаВозврата.Результат);
				Ошибок = Ошибок + 1;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	ВремяОбработки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьСводку();
	ЗафиксироватьОстаткиПосле();
	ВремяКонца = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сообщить("Время «Выполнить», сек: индекс корректировок " + Окр((ВремяИндекса - ВремяСтарта) / 1000, 1)
		+ "; остатки «Было» " + Окр((ВремяОстатковДо - ВремяИндекса) / 1000, 1)
		+ "; обработка возвратов " + Окр((ВремяОбработки - ВремяОстатковДо) / 1000, 1)
		+ "; остатки «Стало» и сводка " + Окр((ВремяКонца - ВремяОбработки) / 1000, 1)
		+ "; всего " + Окр((ВремяКонца - ВремяСтарта) / 1000, 1));
	Возврат Новый Структура("Помечено, Ожидают, Ошибок, ОтложеноЛимитом", Помечено, Ожидают, Ошибок, ОтложеноЛимитом);

КонецФункции

// Строки возврата, закрытые корректировками, которые проведены (или будут проведены в этом запуске):
// их нужно убрать из возврата. Использует результат подбора (номера строк возврата).
&НаСервере
Функция ПозицииКУдалению(ВозвратСсылка, БудутПроведены)

	Результат = Новый Массив;
	Если ПустаяСтрока(ЭтотОбъект.АдресДерева) Тогда
		Возврат Результат;
	КонецЕсли;
	Хранимое = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресДерева);
	Если Хранимое = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Запись Из Хранимое.Результат.Возвраты Цикл
		Если Запись.Документ <> ВозвратСсылка Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Деталь Из Запись.Детали Цикл
			Если Деталь.Корректировка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Проведена = (БудутПроведены.Найти(Деталь.Корректировка) <> Неопределено);
			Если Не Проведена Тогда
				Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", Деталь.Корректировка)) Цикл
					Проведена = СтрокаКорр.Проведена;
				КонецЦикла;
			КонецЕсли;
			Если Проведена Тогда
				Результат.Добавить(Новый Структура("НомерСтроки, Название", Деталь.НомерСтроки, Строка(Деталь.Номенклатура)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция НомераСтрокСоответствие(Позиции)

	Результат = Новый Соответствие;
	Для Каждого Позиция Из Позиции Цикл
		Результат.Вставить(Позиция.НомерСтроки, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проводит корректировки (цепочками, см. ПровестиЦепочки в модуле объекта) и пишет результат в журнал.
// Возвращает структуру: Успешно (все запрошенные проведены), Проведено (количество).
&НаСервере
Функция ПровестиКорректировкиВозврата(Обработка, КПроведению, ТекстВозврата, УсловноПроведены)

	Итог = Новый Структура("Успешно, Проведено, Список", Истина, 0, Новый Массив);
	Если КПроведению.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	ПараметрыПроведения = Новый Структура;
	ПараметрыПроведения.Вставить("ПробныйРежим", ПробныйРежим);
	ПараметрыПроведения.Вставить("ЛимитЦепочек", 1000);
	ПараметрыПроведения.Вставить("ПроводитьСчетаФактуры", ПроводитьСчетаФактуры);
	// Сопоставленные с возвратами корректировки: их можно провести как «предыдущие» в цепочке. Остальные непроведённые
	// корректировки цепочки её останавливают.
	Сопоставленные = Новый Массив;
	Для Каждого СтрокаКорр Из Корректировки Цикл
		Если СтрокаКорр.КодСтатуса = "full" И Не СтрокаКорр.Проведена Тогда
			Сопоставленные.Добавить(Новый Структура("Ссылка, ДатаПроведения", СтрокаКорр.Корректировка,
				?(ЗначениеЗаполнено(СтрокаКорр.ДатаПроведения), СтрокаКорр.ДатаПроведения, ДатаПроведения)));
		КонецЕсли;
	КонецЦикла;
	ПараметрыПроведения.Вставить("Сопоставленные", Сопоставленные);
	ПараметрыПроведения.Вставить("УсловноПроведены", УсловноПроведены);
	ПараметрыПроведения.Вставить("ДатаПоУмолчанию", ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, НачалоДня(ТекущаяДата())));
	Выбранные = Новый Массив;
	Для Каждого КорректировкаСсылка Из КПроведению Цикл
		ДатаКорр = ПараметрыПроведения.ДатаПоУмолчанию;
		Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", КорректировкаСсылка)) Цикл
			Если ЗначениеЗаполнено(СтрокаКорр.ДатаПроведения) Тогда
				ДатаКорр = СтрокаКорр.ДатаПроведения;
			КонецЕсли;
		КонецЦикла;
		Выбранные.Добавить(Новый Структура("Ссылка, ДатаПроведения", КорректировкаСсылка, ДатаКорр));
	КонецЦикла;
	ПараметрыПроведения.Вставить("Корректировки", Выбранные);

	РезультатПроведения = Обработка.ПровестиЦепочки(ПараметрыПроведения);

	Проведенные = Новый Массив;
	Для Каждого ЗаписьЖурнала Из РезультатПроведения Цикл
		Если ЗаписьЖурнала.Успех = Истина Тогда
			Статус = "✔";
			Проведенные.Добавить(ЗаписьЖурнала.Корректировка);
			Для Каждого СтрокаКорр Из Корректировки.НайтиСтроки(Новый Структура("Корректировка", ЗаписьЖурнала.Корректировка)) Цикл
				СтрокаКорр.Проведена = Истина;
			КонецЦикла;
		ИначеЕсли ЗаписьЖурнала.Успех = Ложь Тогда
			Статус = "✖";
		Иначе
			Статус = "•";
		КонецЕсли;
		Если ЗаписьЖурнала.Условно И УсловноПроведены.Найти(ЗаписьЖурнала.Корректировка) = Неопределено Тогда
			УсловноПроведены.Добавить(ЗаписьЖурнала.Корректировка);
		КонецЕсли;
		ДобавитьСтрокуЖурнала(Статус, ТекстВозврата, ЗаписьЖурнала.Корректировка,
			?(ПустаяСтрока(ЗаписьЖурнала.Номер), "", "№ " + ЗаписьЖурнала.Номер + ": ") + ЗаписьЖурнала.Сообщение);
	КонецЦикла;

	Итог.Проведено = Проведенные.Количество();
	Итог.Список = Проведенные;
	Если Не ПробныйРежим Тогда
		Для Каждого КорректировкаСсылка Из КПроведению Цикл
			Если Проведенные.Найти(КорректировкаСсылка) = Неопределено Тогда
				Итог.Успешно = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Снимает проведение возврата и помечает его на удаление. Возвращает структуру: Ошибка, БылПроведен.
&НаСервере
Функция ПометитьВозвратНаУдаление(ВозвратСсылка)

	Результат = Новый Структура("Ошибка, БылПроведен", "", Ложь);
	НачатьТранзакцию();
	Попытка
		Документ = ВозвратСсылка.ПолучитьОбъект();
		Результат.БылПроведен = Документ.Проведен;
		Если Не Документ.ПометкаУдаления Тогда
			Если Документ.Проведен Тогда
				Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Документ.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Возвращает возврат в прежнее состояние (снимает пометку удаления и при необходимости проводит).
// Возвращает текст ошибки или пустую строку.
&НаСервере
Функция ВосстановитьВозврат(ВозвратСсылка, БылПроведен)

	НачатьТранзакцию();
	Попытка
		Документ = ВозвратСсылка.ПолучитьОбъект();
		Документ.УстановитьПометкуУдаления(Ложь);
		Если БылПроведен Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

&НаСервере
Процедура ДобавитьСтрокуЖурнала(Статус, ТекстВозврата, КорректировкаСсылка, Сообщение)

	СтрокаЖурнала = Журнал.Добавить();
	СтрокаЖурнала.Статус = Статус;
	СтрокаЖурнала.Возврат = ТекстВозврата;
	Если КорректировкаСсылка <> Неопределено Тогда
		СтрокаЖурнала.Корректировка = КорректировкаСсылка;
	КонецЕсли;
	СтрокаЖурнала.Сообщение = Сообщение;
	// Склад (магазин) строки: по возврату из дерева, иначе по корректировке
	ОбщийСклад = Неопределено;
	Для Каждого УзелВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Если УзелВозврата.Название = ТекстВозврата Тогда
			ОбщийСклад = УзелВозврата.Склад;
			СтрокаЖурнала.ВозвратСсылка = УзелВозврата.Возврат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(ОбщийСклад) И КорректировкаСсылка <> Неопределено Тогда
		Для Каждого СтрокаКорр Из Корректировки Цикл
			Если СтрокаКорр.Корректировка = КорректировкаСсылка Тогда
				ОбщийСклад = СтрокаКорр.Склад;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбщийСклад) Тогда
		СтрокаЖурнала.Склад = ОбщийСклад;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СортироватьНаСервере(Страница, Колонка, Убывание)

	Порядок = Колонка + ?(Убывание, " Убыв", "");
	Если Страница = "СтраницаСверка" Тогда
		ТабДерево = РеквизитФормыВЗначение("Дерево");
		ТабДерево.Строки.Сортировать(Порядок, Истина);
		ЗначениеВРеквизитФормы(ТабДерево, "Дерево");
	ИначеЕсли Страница = "СтраницаКорректировки" Тогда
		Корректировки.Сортировать(Порядок);
	ИначеЕсли Страница = "СтраницаЦепочки" Тогда
		Цепочки.Сортировать(Порядок);
	Иначе
		Журнал.Сортировать(Порядок);
	КонецЕсли;

КонецПроцедуры

#Область Печать

// Формирует печатную форму всех вкладок.
&НаСервере
Функция ПечатьНаСервере()

	Таб = Новый ТабличныйДокумент;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб = Истина;

	// Единая сетка из 10 колонок; ячейки таблиц объединяются по колонкам
	Ширины = Новый Массив;
	Для Каждого Ширина Из СтрРазделить("34,22,16,12,34,12,14,12,12,26", ",") Цикл
		Ширины.Добавить(Число(Ширина));
	КонецЦикла;
	Для Индекс = 0 По 9 Цикл
		Попытка
			Таб.Область(1, Индекс + 1, 1, Индекс + 1).ШиринаКолонки = Ширины[Индекс];
		Исключение
		КонецПопытки;
	КонецЦикла;

	ЦветШапки = Новый Цвет(214, 226, 245);
	ЦветЗаголовка = Новый Цвет(235, 240, 250);
	ЦветЗакрыт = Новый Цвет(222, 245, 232);
	ЦветЧастично = Новый Цвет(255, 244, 210);
	ЦветНет = Новый Цвет(255, 226, 226);

	// --- шапка отчёта
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("Сверка возвратов поставщику и корректировок приобретения", 1, 10), Истина, Неопределено, Ложь);
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("Организация: " + Строка(Организация) + "    Поставщик: " + Строка(Контрагент), 1, 10), Ложь, Неопределено, Ложь);
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("Период возвратов: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(КонецПериода, "ДФ=dd.MM.yyyy") + "    Сформировано: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'")
		+ "    Режим: " + ?(ПробныйРежим, "пробный", "рабочий"), 1, 10), Ложь, Неопределено, Ложь);
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати(Сводка, 1, 10), Ложь, Неопределено, Ложь);
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("", 1, 10), Ложь, Неопределено, Ложь);

	// --- шаг 3: возвраты и позиции
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("1. Возвраты и корректировки", 1, 10), Истина, Неопределено, Ложь);
	Шапка = Новый Массив;
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Возврат / позиция", 1, 1));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Статус", 2, 2));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Дата", 3, 3));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Кол-во возврата", 4, 4));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Корректировка", 5, 5));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Кол-во корр.", 6, 6));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Результат", 7, 10));
	ВывестиСтрокуПечати(Таб, Ширины, Шапка, Истина, ЦветШапки, Истина);
	Для Каждого СтрокаВозврата Из Дерево.ПолучитьЭлементы() Цикл
		Цвет = ?(СтрокаВозврата.КодСтатуса = "full", ЦветЗакрыт, ?(СтрокаВозврата.КодСтатуса = "partial", ЦветЧастично, ЦветНет));
		Ячейки = Новый Массив;
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаВозврата.Название, 1, 1));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаВозврата.Статус, 2, 2));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", Формат(СтрокаВозврата.Дата, "ДФ='dd.MM.yyyy HH:mm'"), 3, 3));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", "", 4, 4));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", "", 5, 5));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", "", 6, 6));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаВозврата.Результат, 7, 10));
		ВывестиСтрокуПечати(Таб, Ширины, Ячейки, Истина, Цвет, Истина);
		Для Каждого СтрокаПозиции Из СтрокаВозврата.ПолучитьЭлементы() Цикл
			Ячейки = Новый Массив;
			Ячейки.Добавить(Новый Структура("Текст, Н, К", "    " + СтрокаПозиции.Название, 1, 1));
			Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаПозиции.Статус, 2, 2));
			Ячейки.Добавить(Новый Структура("Текст, Н, К", "", 3, 3));
			Ячейки.Добавить(Новый Структура("Текст, Н, К", Формат(СтрокаПозиции.Количество, "ЧДЦ=3; ЧН="), 4, 4));
			Ячейки.Добавить(Новый Структура("Текст, Н, К", ?(ЗначениеЗаполнено(СтрокаПозиции.Корректировка), Строка(СтрокаПозиции.Корректировка), ""), 5, 5));
			Ячейки.Добавить(Новый Структура("Текст, Н, К", ?(ЗначениеЗаполнено(СтрокаПозиции.Корректировка), Формат(СтрокаПозиции.КоличествоКорр, "ЧДЦ=3; ЧН="), ""), 6, 6));
			Ячейки.Добавить(Новый Структура("Текст, Н, К", "", 7, 10));
			ВывестиСтрокуПечати(Таб, Ширины, Ячейки, Ложь, Неопределено, Истина);
		КонецЦикла;
	КонецЦикла;

	// --- шаг 2: проверка корректировок (цепочки)
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("2. Корректировки: проверка «Товаров» по цепочкам", 1, 10), Истина, Неопределено, Ложь);
	Шапка = Новый Массив;
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Результат", 1, 1));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Цепочка / поступление", 2, 4));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Корректировка", 5, 6));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Сообщение", 7, 10));
	ВывестиСтрокуПечати(Таб, Ширины, Шапка, Истина, ЦветШапки, Истина);
	Для Каждого СтрокаЦепочки Из Цепочки Цикл
		Ячейки = Новый Массив;
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаЦепочки.Статус, 1, 1));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаЦепочки.Возврат, 2, 4));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", ?(ЗначениеЗаполнено(СтрокаЦепочки.Корректировка), Строка(СтрокаЦепочки.Корректировка), ""), 5, 6));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаЦепочки.Сообщение, 7, 10));
		Цвет = ?(Найти(СтрокаЦепочки.Статус, "✖") > 0, ЦветНет, ?(Найти(СтрокаЦепочки.Статус, "✔") > 0, ЦветЗакрыт, Неопределено));
		ВывестиСтрокуПечати(Таб, Ширины, Ячейки, Ложь, Цвет, Истина);
	КонецЦикла;

	// --- шаг 4: корректировки и даты проведения
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("3. Корректировки: даты проведения", 1, 10), Истина, Неопределено, Ложь);
	Шапка = Новый Массив;
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Статус", 1, 1));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Корректировка", 2, 3));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Поступление (основание)", 4, 5));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Дата", 6, 6));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Проведена", 7, 7));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Дата проведения", 8, 8));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Позиций / совпало", 9, 9));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Возвраты", 10, 10));
	ВывестиСтрокуПечати(Таб, Ширины, Шапка, Истина, ЦветШапки, Истина);
	Для Каждого СтрокаКорр Из Корректировки Цикл
		Цвет = ?(СтрокаКорр.КодСтатуса = "full", ЦветЗакрыт, ?(СтрокаКорр.КодСтатуса = "partial", ЦветЧастично, ЦветНет));
		Ячейки = Новый Массив;
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаКорр.Статус, 1, 1));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", Строка(СтрокаКорр.Корректировка), 2, 3));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаКорр.Основание, 4, 5));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", Формат(СтрокаКорр.Дата, "ДФ=dd.MM.yyyy"), 6, 6));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", ?(СтрокаКорр.Проведена, "Да", "Нет"), 7, 7));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", Формат(СтрокаКорр.ДатаПроведения, "ДФ=dd.MM.yyyy"), 8, 8));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", "" + СтрокаКорр.Всего + " / " + СтрокаКорр.Совпало, 9, 9));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаКорр.Возвраты, 10, 10));
		ВывестиСтрокуПечати(Таб, Ширины, Ячейки, Ложь, Цвет, Истина);
	КонецЦикла;

	// --- шаг 5: результат выполнения
	Таб.ВывестиГоризонтальныйРазделительСтраниц();
	ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("4. Результат выполнения", 1, 10), Истина, Неопределено, Ложь);
	Шапка = Новый Массив;
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Результат", 1, 1));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Возврат", 2, 3));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Корректировка", 4, 5));
	Шапка.Добавить(Новый Структура("Текст, Н, К", "Сообщение", 6, 10));
	ВывестиСтрокуПечати(Таб, Ширины, Шапка, Истина, ЦветШапки, Истина);
	Если Журнал.Количество() = 0 Тогда
		ВывестиСтрокуПечати(Таб, Ширины, ЯчейкиПечати("Журнал пуст: «Выполнить» ещё не запускалось.", 1, 10), Ложь, Неопределено, Ложь);
	КонецЕсли;
	Для Каждого СтрокаЖурнала Из Журнал Цикл
		Ячейки = Новый Массив;
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаЖурнала.Статус, 1, 1));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаЖурнала.Возврат, 2, 3));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", ?(ЗначениеЗаполнено(СтрокаЖурнала.Корректировка), Строка(СтрокаЖурнала.Корректировка), ""), 4, 5));
		Ячейки.Добавить(Новый Структура("Текст, Н, К", СтрокаЖурнала.Сообщение, 6, 10));
		Цвет = ?(СтрокаЖурнала.Статус = "✖", ЦветНет, Неопределено);
		ВывестиСтрокуПечати(Таб, Ширины, Ячейки, Ложь, Цвет, Истина);
	КонецЦикла;

	Возврат Таб;

КонецФункции

&НаСервере
Функция ЯчейкиПечати(Текст, Нач, Кон)

	Ячейки = Новый Массив;
	Ячейки.Добавить(Новый Структура("Текст, Н, К", Текст, Нач, Кон));
	Возврат Ячейки;

КонецФункции

// Выводит строку таблицы: ячейки с объединением по колонкам, переносом текста, рамкой и заливкой.
&НаСервере
Процедура ВывестиСтрокуПечати(Таб, Ширины, Ячейки, Жирный, Фон, Рамка)

	НомерСтроки = Таб.ВысотаТаблицы + 1;
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	МаксСтрок = 1;
	Для Каждого Ячейка Из Ячейки Цикл
		Область = Таб.Область(НомерСтроки, Ячейка.Н, НомерСтроки, Ячейка.К);
		Если Ячейка.К > Ячейка.Н Тогда
			Область.Объединить();
		КонецЕсли;
		Область.Текст = Ячейка.Текст;
		Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		Если Жирный Тогда
			Область.Шрифт = Новый Шрифт(Область.Шрифт, , , Истина);
		КонецЕсли;
		Если Фон <> Неопределено Тогда
			Область.ЦветФона = Фон;
		КонецЕсли;
		Если Рамка Тогда
			Область.Обвести(Линия, Линия, Линия, Линия);
		КонецЕсли;
		// Грубая оценка высоты: сколько строк займёт текст в объединённой ширине
		ШиринаОбласти = 0;
		Для Индекс = Ячейка.Н - 1 По Ячейка.К - 1 Цикл
			ШиринаОбласти = ШиринаОбласти + Ширины[Индекс];
		КонецЦикла;
		КолвоСтрок = Цел(СтрДлина(Ячейка.Текст) / Макс(ШиринаОбласти - 2, 1)) + 1;
		МаксСтрок = Макс(МаксСтрок, КолвоСтрок);
	КонецЦикла;
	Попытка
		Таб.Область(НомерСтроки, 1, НомерСтроки, 10).Высота = 14 * МаксСтрок + 2;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
