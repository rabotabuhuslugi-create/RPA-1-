// Сверка актов сверки с поставщиком.
// Сравнивает акт сверки из 1С («Наш») с актом поставщика (Excel, CSV, Word): сальдо, обороты, документы.
// Алгоритм перенесён из веб-сервиса «Сервис сверки актов»: 4 метода сравнения, зеркальное сопоставление УКД,
// групповое совпадение (1 запись = несколько), расхождения по сумме, документы только у одной стороны.
// Все вычисления выполняются на клиенте, файлы читаются прямо с компьютера пользователя.

&НаКлиенте
Перем ДанныеФайла1;      // содержимое файла «Наш акт»: массив строк, строка — массив значений ячеек
&НаКлиенте
Перем ДанныеФайла2;      // содержимое файла «Акт поставщика»
&НаКлиенте
Перем ПоследниеРезультаты;   // массив структур результата сверки (для выгрузки в Excel)

#Область События

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Метод = "Дата + Номер + Сумма";
	ИсточникНаш = "Из документа сверки";
	Элементы.ИсточникНаш.СписокВыбора.Добавить("Из документа сверки");
	Элементы.ИсточникНаш.СписокВыбора.Добавить("Из файла");
	Элементы.ИсточникНаш.РежимВыбораИзСписка = Истина;
	Элементы.ИсточникНаш.РедактированиеТекста = Ложь;
	Элементы.ДоговорСтрока.РежимВыбораИзСписка = Истина;
	Элементы.ДоговорСтрока.КнопкаОчистки = Истина;

	// Поле «Документ сверки взаиморасчётов»: тип реквизита зависит от конфигурации, поэтому создаём его по метаданным
	ИмяДокумента = ИмяДокументаСверки();
	Если ИмяДокумента <> "" Тогда
		НовыеРеквизиты = Новый Массив;
		НовыеРеквизиты.Добавить(Новый РеквизитФормы("ДокументСверки", Новый ОписаниеТипов("ДокументСсылка." + ИмяДокумента), , "Документ сверки взаиморасчётов"));
		ИзменитьРеквизиты(НовыеРеквизиты);
		ПолеДокумента = Элементы.Добавить("ДокументСверки", Тип("ПолеФормы"), Элементы.ГруппаНашИзДокумента);
		ПолеДокумента.Вид = ВидПоляФормы.ПолеВвода;
		ПолеДокумента.ПутьКДанным = "ДокументСверки";
		ПолеДокумента.Заголовок = "Документ сверки взаиморасчётов";
		ПолеДокумента.УстановитьДействие("ПриИзменении", "ДокументСверкиПриИзменении");
		Элементы.Переместить(ПолеДокумента, Элементы.ГруппаНашИзДокумента, Элементы.ДоговорСтрока);
	КонецЕсли;
	Для Каждого Значение Из СтрРазделить("Дата + Номер + Сумма;Номер + Сумма;Дата + Сумма;Только сумма", ";") Цикл
		Элементы.Метод.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	Элементы.Метод.РежимВыбораИзСписка = Истина;
	Элементы.Метод.РедактированиеТекста = Ложь;

	ФильтрСтатуса = "Все";
	Для Каждого Значение Из СтрРазделить("Все;Совпадают;Расхождения;Только у нас;Только у поставщика", ";") Цикл
		Элементы.ФильтрСтатуса.СписокВыбора.Добавить(Значение);
	КонецЦикла;
	Элементы.ФильтрСтатуса.РежимВыбораИзСписка = Истина;
	Элементы.ФильтрСтатуса.РедактированиеТекста = Ложь;

	Элементы.ИнфоФайл1.МногострочныйРежим = Истина;
	Элементы.ИнфоФайл1.Высота = 3;
	Элементы.ИнфоФайл2.МногострочныйРежим = Истина;
	Элементы.ИнфоФайл2.Высота = 3;
	Элементы.ФайлНаш.КнопкаВыбора = Истина;
	Элементы.ФайлПоставщика.КнопкаВыбора = Истина;
	Элементы.Результат.ИзменятьСоставСтрок = Ложь;
	Элементы.Результат.ТолькоПросмотр = Истина;

	// Подсветка строк результата по статусу: зелёный — совпадает, красный — расхождение, жёлтый — только у одной стороны
	ИменаПолей = "РезультатДата,РезультатДокумент,РезультатСуммаНаша,РезультатДебетНаш,РезультатКредитНаш,РезультатСуммаПост,"
		+ "РезультатДебетПост,РезультатКредитПост,РезультатРазница,РезультатСтатус,РезультатМетод,РезультатПримечание";
	Для Каждого Описание Из СтрРазделить("match:214,240,222;mismatch:255,218,218;only1:255,244,210;only2:255,244,210", ";") Цикл
		Части = СтрРазделить(Описание, ":");
		Цвет = СтрРазделить(Части[1], ",");
		Элемент = УсловноеОформление.Элементы.Добавить();
		Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",") Цикл
			Поле = Элемент.Поля.Элементы.Добавить();
			Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЦикла;
		УсловиеОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		УсловиеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Результат.Код");
		УсловиеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		УсловиеОтбора.ПравоеЗначение = Части[0];
		УсловиеОтбора.Использование = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(Число(Цвет[0]), Число(Цвет[1]), Число(Цвет[2])));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДанныеФайла1 = Неопределено;
	ДанныеФайла2 = Неопределено;
	ПоследниеРезультаты = Новый Массив;
	ИнфоФайл1 = "Акт будет сформирован из документа сверки взаиморасчётов при нажатии «Сверить»";
	ИнфоФайл2 = "Файл не выбран";
	ОбновитьВидимостьИсточника();

КонецПроцедуры

&НаКлиенте
Процедура ИсточникНашПриИзменении(Элемент)

	ОбновитьВидимостьИсточника();
	ДанныеФайла1 = Неопределено;
	ИнфоФайл1 = ?(ИсточникНаш = "Из документа сверки", "Акт будет сформирован из документа сверки взаиморасчётов при нажатии «Сверить»", "Файл не выбран");

КонецПроцедуры

// Показывает или прячет номера колонок и сведения о файлах; выбор актов, документа и договора остаётся на экране.
&НаКлиенте
Процедура УстановитьВидимостьНастроек(Видимо)

	Элементы.ГруппаКолонок1.Видимость = Видимо;
	Элементы.ГруппаКолонок2.Видимость = Видимо;
	Элементы.ИнфоФайл1.Видимость = Видимо;
	Элементы.ИнфоФайл2.Видимость = Видимо;

КонецПроцедуры

&НаКлиенте
Процедура НастройкиФайлов(Команда)

	УстановитьВидимостьНастроек(Не Элементы.ГруппаКолонок2.Видимость);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьИсточника()

	Элементы.ГруппаНашИзДокумента.Видимость = (ИсточникНаш = "Из документа сверки");
	Элементы.ГруппаНашФайл.Видимость = (ИсточникНаш <> "Из документа сверки");

КонецПроцедуры

#КонецОбласти

#Область Файлы

&НаКлиенте
Процедура ФайлНашНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайл(1);

КонецПроцедуры

&НаКлиенте
Процедура ФайлПоставщикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайл(2);

КонецПроцедуры

&НаКлиенте
Процедура ФайлНашПриИзменении(Элемент)

	ЗагрузитьФайл(1, ФайлНаш);

КонецПроцедуры

&НаКлиенте
Процедура ФайлПоставщикаПриИзменении(Элемент)

	ЗагрузитьФайл(2, ФайлПоставщика);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайл(НомерФайла)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = ?(НомерФайла = 1, "Акт сверки №1 — наш (из 1С)", "Акт сверки №2 — поставщика");
	Диалог.Фильтр = "Таблицы и документы (*.xlsx;*.xls;*.csv;*.docx;*.mxl)|*.xlsx;*.xls;*.csv;*.docx;*.mxl|Все файлы (*.*)|*.*";
	Диалог.Показать(Новый ОписаниеОповещения("ВыборФайлаЗавершение", ЭтотОбъект, Новый Структура("НомерФайла", НомерФайла)));

КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ДополнительныеПараметры.НомерФайла = 1 Тогда
		ФайлНаш = ВыбранныеФайлы[0];
	Иначе
		ФайлПоставщика = ВыбранныеФайлы[0];
	КонецЕсли;
	ЗагрузитьФайл(ДополнительныеПараметры.НомерФайла, ВыбранныеФайлы[0]);

КонецПроцедуры

// Передаёт файл на сервер, читает его, определяет шапку таблицы и колонки, заполняет настройки колонок.
&НаКлиенте
Процедура ЗагрузитьФайл(НомерФайла, Путь)

	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;
	Состояние("Чтение файла...");
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ПомещениеФайлаЗавершение", ЭтотОбъект, Новый Структура("НомерФайла", НомерФайла)), , Путь, Ложь, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПомещениеФайлаЗавершение(Результат_, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат_ Тогда
		ПоказатьПредупреждение(, "Не удалось передать файл для чтения. Проверьте путь и доступ к файлу.");
		Возврат;
	КонецЕсли;
	НомерФайла = ДополнительныеПараметры.НомерФайла;
	Попытка
		Данные = ПрочитатьФайлНаСервере(Адрес, ВыбранноеИмяФайла);
	Исключение
		ПоказатьПредупреждение(, "Не удалось прочитать файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если Данные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "В файле нет данных.");
		Возврат;
	КонецЕсли;

	Если НомерФайла = 1 Тогда
		ДанныеФайла1 = Данные;
	Иначе
		ДанныеФайла2 = Данные;
	КонецЕсли;
	Настройка = ОпределитьНастройкуФайла(Данные, НомерФайла);
	Если НомерФайла = 1 Тогда
		СтрокаШапки1 = Настройка.СтрокаШапки;
		ПерваяСтрока1 = Настройка.ПерваяСтрока;
		КолДата1 = Настройка.КолДата;
		КолДок1 = Настройка.КолДок;
		КолДебет1 = Настройка.КолДебет;
		КолКредит1 = Настройка.КолКредит;
	Иначе
		СтрокаШапки2 = Настройка.СтрокаШапки;
		ПерваяСтрока2 = Настройка.ПерваяСтрока;
		КолДата2 = Настройка.КолДата;
		КолДок2 = Настройка.КолДок;
		КолДебет2 = Настройка.КолДебет;
		КолКредит2 = Настройка.КолКредит;
	КонецЕсли;
	ОбновитьИнфоФайла(НомерФайла);
	Состояние("Готово.");

КонецПроцедуры

// Читает переданный на сервер файл во временный файл и возвращает массив строк.
&НаСервере
Функция ПрочитатьФайлНаСервере(Адрес, ИмяФайла)

	Двоичные = ПолучитьИзВременногоХранилища(Адрес);
	Расширение = "";
	Позиция = 0;
	Для Индекс = 1 По СтрДлина(ИмяФайла) Цикл
		Если Сред(ИмяФайла, Индекс, 1) = "." Тогда
			Позиция = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Позиция > 0 Тогда
		Расширение = НРег(Сред(ИмяФайла, Позиция));
	КонецЕсли;
	ВременныйФайл = ПолучитьИмяВременногоФайла(Расширение);
	Двоичные.Записать(ВременныйФайл);
	Попытка
		Результат_ = ПрочитатьФайлВМассив(ВременныйФайл);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		УдалитьФайлы(ВременныйФайл);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	УдалитьФайлы(ВременныйФайл);
	Возврат Результат_;

КонецФункции

&НаКлиенте
Процедура ОбновитьИнфоФайла(НомерФайла)

	Если НомерФайла = 1 Тогда
		Данные = ДанныеФайла1;
		ШапкаНомер = СтрокаШапки1;
		Первая = ПерваяСтрока1;
		Даты = КолДата1;
		Докум = КолДок1;
		Деб = КолДебет1;
		Кред = КолКредит1;
	Иначе
		Данные = ДанныеФайла2;
		ШапкаНомер = СтрокаШапки2;
		Первая = ПерваяСтрока2;
		Даты = КолДата2;
		Докум = КолДок2;
		Деб = КолДебет2;
		Кред = КолКредит2;
	КонецЕсли;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Текст = "Строк в файле: " + Данные.Количество() + ". Колонки: дата — " + Даты + ", документ — " + Докум + ", дебет — " + Деб + ", кредит — " + Кред + "."
		+ Символы.ПС + "Шапка (строка " + ШапкаНомер + "): " + СтрокаСНомерамиКолонок(Данные, ШапкаНомер)
		+ Символы.ПС + "Первая строка данных (строка " + Первая + "): " + СтрокаСНомерамиКолонок(Данные, Первая);
	// Какие строки распознаны как сальдо (последняя подходящая)
	НомерНач = 0;
	НомерКон = 0;
	Для Индекс = 1 По Данные.Количество() Цикл
		Если ЭтоСтрокаНачальногоСальдо(Данные[Индекс - 1]) Тогда
			НомерНач = Индекс;
		КонецЕсли;
		Если ЭтоСтрокаКонечногоСальдо(Данные[Индекс - 1]) Тогда
			НомерКон = Индекс;
		КонецЕсли;
	КонецЦикла;
	Текст = Текст + Символы.ПС + "Сальдо начальное — строка " + НомерНач + ": " + ?(НомерНач > 0, СтрокаСНомерамиКолонок(Данные, НомерНач), "не найдено")
		+ Символы.ПС + "Сальдо конечное — строка " + НомерКон + ": " + ?(НомерКон > 0, СтрокаСНомерамиКолонок(Данные, НомерКон), "не найдено");
	Если НомерФайла = 1 Тогда
		ИнфоФайл1 = Текст;
	Иначе
		ИнфоФайл2 = Текст;
	КонецЕсли;

КонецПроцедуры

// Непустые ячейки строки с номерами колонок: «1=Дата | 6=№/название | 8=ДЕБЕТ» (для проверки номеров колонок).
&НаКлиенте
Функция СтрокаСНомерамиКолонок(Данные, НомерСтроки)

	Если НомерСтроки < 1 Или НомерСтроки > Данные.Количество() Тогда
		Возврат "—";
	КонецЕсли;
	Части = Новый Массив;
	СтрокаДанных = Данные[НомерСтроки - 1];
	Для Индекс = 0 По СтрокаДанных.ВГраница() Цикл
		Текст_ = ТекстЯчейки(СтрокаДанных[Индекс]);
		Если Текст_ <> "" Тогда
			Части.Добавить(Формат(Индекс + 1, "ЧГ=0") + "=" + Лев(Текст_, 22));
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(СтрСоединить(Части, " | "), 400);

КонецФункции

&НаКлиенте
Процедура ОпределитьКолонкиЗаново(Команда)

	Если ДанныеФайла1 <> Неопределено Тогда
		ЗагрузитьФайл(1, ФайлНаш);
	КонецЕсли;
	Если ДанныеФайла2 <> Неопределено Тогда
		ЗагрузитьФайл(2, ФайлПоставщика);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастройкаИзменена(Элемент)

	ОбновитьИнфоФайла(1);
	ОбновитьИнфоФайла(2);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)

	УстановитьВидимостьНастроек(Истина);
	ДанныеФайла1 = Неопределено;
	ДанныеФайла2 = Неопределено;
	ПоследниеРезультаты = Новый Массив;
	ФайлНаш = "";
	ФайлПоставщика = "";
	ИнфоФайл1 = ?(ИсточникНаш = "Из документа сверки", "Акт будет сформирован из документа сверки взаиморасчётов при нажатии «Сверить»", "Файл не выбран");
	ИнфоФайл2 = "Файл не выбран";
	Результат.Очистить();
	Статистика = "";
	Вердикт = "";
	СальдоНачНаше = "";
	СальдоНачПост = "";
	СальдоНачРазн = "";
	СальдоКонНаше = "";
	СальдоКонПост = "";
	СальдоКонРазн = "";
	КомментарийНач = "";
	КомментарийКон = "";
	КомментарийРасчет = "";

КонецПроцедуры

#КонецОбласти

#Область Диагностика

// Показывает структуру документа «Сверка взаиморасчётов» и регистров расчётов вашей конфигурации — по ней настраивается формирование акта.
&НаКлиенте
Процедура ПоказатьСтруктуруСверки(Команда)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ОписаниеСтруктурыСверкиНаСервере());
	Текст.Показать("Структура документа сверки взаиморасчётов");

КонецПроцедуры

&НаСервере
Функция ОписаниеСтруктурыСверкиНаСервере()

	Строки = Новый Массив;
	Строки.Добавить("ДОКУМЕНТЫ С «СВЕРК» В ИМЕНИ (по одной колонке на строку)");
	Для Каждого Документ_ Из Метаданные.Документы Цикл
		Если Найти(НРег(Документ_.Имя), "сверк") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить("Документ." + Документ_.Имя + " («" + Документ_.Синоним + "»)");
		Для Каждого Часть_ Из Документ_.ТабличныеЧасти Цикл
			Строки.Добавить("  Табличная часть " + Часть_.Имя + " («" + Часть_.Синоним + "»):");
			Для Каждого Колонка_ Из Часть_.Реквизиты Цикл
				Строки.Добавить("    " + Колонка_.Имя + " | " + Колонка_.Синоним + " | " + ОписаниеТипов_(Колонка_));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Типы реквизита одной строкой.
&НаСервере
Функция ОписаниеТипов_(Элемент_)

	Типы = Новый Массив;
	Попытка
		Для Каждого Тип_ Из Элемент_.Тип.Типы() Цикл
			Типы.Добавить(XMLТип(Тип_).ИмяТипа);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат СтрСоединить(Типы, "/");

КонецФункции

// «Имя (Тип)» через запятую для коллекции реквизитов/измерений/ресурсов.
&НаСервере
Функция ОписаниеСписка(Коллекция)

	Элементы_ = Новый Массив;
	Для Каждого Элемент_ Из Коллекция Цикл
		Типы = Новый Массив;
		Попытка
			Для Каждого Тип_ Из Элемент_.Тип.Типы() Цикл
				Типы.Добавить(XMLТип(Тип_).ИмяТипа);
			КонецЦикла;
		Исключение
		КонецПопытки;
		Элементы_.Добавить(Элемент_.Имя + " (" + СтрСоединить(Типы, "/") + ")");
	КонецЦикла;
	Возврат СтрСоединить(Элементы_, "; ");

КонецФункции

#КонецОбласти

#Область НашАктИзДокумента

// Находит имя документа «Сверка взаиморасчётов» в метаданных конфигурации.
&НаСервере
Функция ИмяДокументаСверки()

	// Предпочитаем актуальный документ, устаревший «Сверка взаиморасчётов (2.4)» берём только если другого нет
	Запасной = "";
	Для Каждого Документ_ Из Метаданные.Документы Цикл
		Если Найти(НРег(СтрЗаменить(Документ_.Имя, "ё", "е")), "сверкавзаиморасчет") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Найти(Документ_.Имя, "2_4") > 0 Или Найти(Документ_.Синоним, "(2.4)") > 0 Тогда
			Запасной = Документ_.Имя;
			Продолжить;
		КонецЕсли;
		Возврат Документ_.Имя;
	КонецЦикла;
	Возврат Запасной;

КонецФункции

&НаКлиенте
Процедура ДокументСверкиПриИзменении(Элемент)

	Элементы.ДоговорСтрока.СписокВыбора.Очистить();
	ДоговорСтрока = "";
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ДокументСверки) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Договоры = ДоговорыДокументаСверки(ЭтотОбъект.ДокументСверки);
	Исключение
		ПоказатьПредупреждение(, "Не удалось прочитать договоры документа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Для Каждого Договор_ Из Договоры Цикл
		Элементы.ДоговорСтрока.СписокВыбора.Добавить(Договор_);
	КонецЦикла;
	Если Договоры.Количество() = 1 Тогда
		ДоговорСтрока = Договоры[0];
	КонецЕсли;

КонецПроцедуры

// Кнопки на форме больше нет (акт формируется при «Сверить»); процедура оставлена для совместимости со старыми собранными файлами.
&НаКлиенте
Процедура СформироватьНашАктКоманда(Команда)

	Если СформироватьНашАктИзДокумента() Тогда
		ПоказатьПредупреждение(, ИнфоФайл1);
	КонецЕсли;

КонецПроцедуры

// Формирует наш акт по документу «Сверка взаиморасчётов» в том же виде, что и прочитанный файл.
// Возвращает Истина, если акт сформирован.
&НаКлиенте
Функция СформироватьНашАктИзДокумента()

	Если Элементы.Найти("ДокументСверки") = Неопределено Тогда
		ПоказатьПредупреждение(, "В конфигурации не найден документ «Сверка взаиморасчётов». Выберите источник «Из файла».");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ДокументСверки) Тогда
		ПоказатьПредупреждение(, "Выберите документ «Сверка взаиморасчётов»: создайте его, нажмите «Заполнить» и запишите.");
		Возврат Ложь;
	КонецЕсли;
	Состояние("Формирование нашего акта сверки из документа...");
	Попытка
		Данные = ДанныеАктаИзДокументаСверки(ЭтотОбъект.ДокументСверки, ДоговорСтрока);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сформировать акт из документа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	ДанныеФайла1 = Данные;
	СтрокаШапки1 = 1;
	ПерваяСтрока1 = 2;
	КолДата1 = 1;
	КолДок1 = 2;
	КолДебет1 = 3;
	КолКредит1 = 4;
	ИнфоФайл1 = "Сформирован из документа " + Строка(ЭтотОбъект.ДокументСверки) + ?(ПустаяСтрока(ДоговорСтрока), " (все договоры с поставщиками)", ", договор " + ДоговорСтрока)
		+ ". Строк: " + Данные.Количество();
	Состояние("Готово.");
	Возврат Истина;

КонецФункции

// Краткое имя колонки в нижнем регистре: «имя синоним» для поиска по шаблонам.
&НаСервере
Функция ТекстКолонки(Колонка_)

	Возврат НРег(СтрЗаменить(Колонка_.Имя + " " + Колонка_.Синоним, "ё", "е"));

КонецФункции

// Колонка табличной части, в названии/синониме которой есть все подстроки и нет исключённых (списки через «|»).
// Колонка табличной части с точным именем или пустая строка.
&НаСервере
Функция ТочнаяКолонка(ТабличнаяЧасть_, Имя)

	Для Каждого Колонка_ Из ТабличнаяЧасть_.Реквизиты Цикл
		Если Колонка_.Имя = Имя Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаСервере
Функция НайтиКолонку(ТабличнаяЧасть_, Включить, Исключить = "")

	Для Каждого Колонка_ Из ТабличнаяЧасть_.Реквизиты Цикл
		Текст = ТекстКолонки(Колонка_);
		Подходит = Истина;
		Для Каждого Подстрока Из СтрРазделить(Включить, "|") Цикл
			Если Подстрока <> "" И Найти(Текст, Подстрока) = 0 Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Подходит И Исключить <> "" Тогда
			Для Каждого Подстрока Из СтрРазделить(Исключить, "|") Цикл
				Если Подстрока <> "" И Найти(Текст, Подстрока) > 0 Тогда
					Подходит = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Подходит Тогда
			Возврат Колонка_.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Табличные части документа сверки: итоги по договорам и детальные записи.
// Результат: Структура(Итоги, Детали) — имена табличных частей (пустая строка, если не найдена).
&НаСервере
Функция ТабличныеЧастиСверки(МетаДокумента)

	Результат_ = Новый Структура("Итоги, Детали", "", "");
	// Сначала по названию («Итоговые записи» / «Детальные записи»)
	Для Каждого Часть_ Из МетаДокумента.ТабличныеЧасти Цикл
		ИмяЧасти = НРег(Часть_.Имя);
		Если Найти(ИмяЧасти, "итог") > 0 И Найти(ИмяЧасти, "финансов") = 0 И Результат_.Итоги = "" Тогда
			Результат_.Итоги = Часть_.Имя;
		ИначеЕсли Найти(ИмяЧасти, "детал") > 0 И Найти(ИмяЧасти, "финансов") = 0 И Найти(ИмяЧасти, "расчет") = 0 И Результат_.Детали = "" Тогда
			Результат_.Детали = Часть_.Имя;
		КонецЕсли;
	КонецЦикла;
	Если Результат_.Итоги <> "" И Результат_.Детали <> "" Тогда
		Возврат Результат_;
	КонецЕсли;
	Для Каждого Часть_ Из МетаДокумента.ТабличныеЧасти Цикл
		ЕстьСальдо = НайтиКолонку(Часть_, "сальдо", "") <> "";
		ЕстьДебетКредит = НайтиКолонку(Часть_, "дебет", "") <> "" И НайтиКолонку(Часть_, "кредит", "") <> "";
		Если ЕстьДебетКредит И НайтиКолонку(Часть_, "номер", "") <> "" Тогда
			Результат_.Детали = Часть_.Имя;
		ИначеЕсли ЕстьСальдо И Результат_.Итоги = "" Тогда
			Результат_.Итоги = Часть_.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Представления договоров по расчётам с поставщиками из итогов документа сверки.
&НаСервере
Функция ДоговорыДокументаСверки(ДокументСверки_)

	Мета = ДокументСверки_.Метаданные();
	Части = ТабличныеЧастиСверки(Мета);
	Если Части.Итоги = "" Тогда
		ВызватьИсключение "В документе " + Мета.Имя + " не найдена табличная часть с итогами по договорам." + Символы.ПС + ОписаниеСтруктурыСверкиНаСервере();
	КонецЕсли;
	ЧастьИтогов = Мета.ТабличныеЧасти[Части.Итоги];
	КолТип = НайтиКолонку(ЧастьИтогов, "тип|расчет", "");
	КолДоговор = НайтиКолонку(ЧастьИтогов, "договор", "наименование|номер|дата|№");
	Если КолДоговор = "" Тогда
		КолДоговор = НайтиКолонку(ЧастьИтогов, "договор", "");
	КонецЕсли;
	Результат_ = Новый Массив;
	Документ_ = ДокументСверки_.ПолучитьОбъект();
	Для Каждого Строка_ Из Документ_[Части.Итоги] Цикл
		Если КолТип <> "" И Найти(НРег(Строка(Строка_[КолТип])), "поставщик") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если КолДоговор = "" Тогда
			Продолжить;
		КонецЕсли;
		Представление_ = Строка(Строка_[КолДоговор]);
		Если Результат_.Найти(Представление_) = Неопределено Тогда
			Результат_.Добавить(Представление_);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Данные нашего акта из документа «Сверка взаиморасчётов»: заголовок, «Сальдо начальное», детальные записи
// (дебет/кредит по документам), «Сальдо конечное». Без договора — по всем договорам расчётов с поставщиками.
&НаСервере
Функция ДанныеАктаИзДокументаСверки(ДокументСверки_, ДоговорПредставление)

	Мета = ДокументСверки_.Метаданные();
	Части = ТабличныеЧастиСверки(Мета);
	Если Части.Итоги = "" Или Части.Детали = "" Тогда
		ВызватьИсключение "В документе не найдены табличные части с итогами и детальными записями." + Символы.ПС + ОписаниеСтруктурыСверкиНаСервере();
	КонецЕсли;
	ЧастьИтогов = Мета.ТабличныеЧасти[Части.Итоги];
	ЧастьДеталей = Мета.ТабличныеЧасти[Части.Детали];

	// Колонки итогов
	КолТип = НайтиКолонку(ЧастьИтогов, "тип|расчет", "");
	КолДоговорИтогов = НайтиКолонку(ЧастьИтогов, "договор", "наименование|номер|дата|№");
	КолНачДт = ТочнаяКолонка(ЧастьИтогов, "НачальноеСальдоДт");
	Если КолНачДт = "" Тогда
		КолНачДт = НайтиКолонку(ЧастьИтогов, "нач|сальдо|дт", "кт|кредит|контраг");
	КонецЕсли;
	Если КолНачДт = "" Тогда
		КолНачДт = НайтиКолонку(ЧастьИтогов, "нач|сальдо|дебет", "кредит|контраг");
	КонецЕсли;
	КолНачКт = ТочнаяКолонка(ЧастьИтогов, "НачальноеСальдоКт");
	Если КолНачКт = "" Тогда
		КолНачКт = НайтиКолонку(ЧастьИтогов, "нач|сальдо|кт", "дт|дебет|контраг");
	КонецЕсли;
	Если КолНачКт = "" Тогда
		КолНачКт = НайтиКолонку(ЧастьИтогов, "нач|сальдо|кредит", "дебет|контраг");
	КонецЕсли;
	КолКонДт = ТочнаяКолонка(ЧастьИтогов, "КонечноеСальдоДт");
	Если КолКонДт = "" Тогда
		КолКонДт = НайтиКолонку(ЧастьИтогов, "кон|сальдо|дт", "кт|кредит|контраг");
	КонецЕсли;
	Если КолКонДт = "" Тогда
		КолКонДт = НайтиКолонку(ЧастьИтогов, "кон|сальдо|дебет", "кредит|контраг");
	КонецЕсли;
	КолКонКт = ТочнаяКолонка(ЧастьИтогов, "КонечноеСальдоКт");
	Если КолКонКт = "" Тогда
		КолКонКт = НайтиКолонку(ЧастьИтогов, "кон|сальдо|кт", "дт|дебет|контраг");
	КонецЕсли;
	Если КолКонКт = "" Тогда
		КолКонКт = НайтиКолонку(ЧастьИтогов, "кон|сальдо|кредит", "дебет|контраг");
	КонецЕсли;
	Если КолНачДт = "" Или КолНачКт = "" Или КолКонДт = "" Или КолКонКт = "" Тогда
		// Запасной вариант: числовые колонки итогов идут по порядку — нач. сальдо Дт/Кт, оборот Дт/Кт, кон. сальдо Дт/Кт
		ЧисловыеКолонки = Новый Массив;
		Для Каждого Колонка_ Из ЧастьИтогов.Реквизиты Цикл
			Если Колонка_.Тип.СодержитТип(Тип("Число")) Тогда
				ЧисловыеКолонки.Добавить(Колонка_.Имя);
			КонецЕсли;
		КонецЦикла;
		Если ЧисловыеКолонки.Количество() >= 6 Тогда
			КолНачДт = ЧисловыеКолонки[0];
			КолНачКт = ЧисловыеКолонки[1];
			КолКонДт = ЧисловыеКолонки[4];
			КолКонКт = ЧисловыеКолонки[5];
		КонецЕсли;
	КонецЕсли;
	Если КолНачДт = "" Или КолНачКт = "" Или КолКонДт = "" Или КолКонКт = "" Тогда
		ВызватьИсключение "Не найдены колонки сальдо в итогах документа." + Символы.ПС + ОписаниеСтруктурыСверкиНаСервере();
	КонецЕсли;

	// Колонки детальных записей
	КолДатаОперации = НайтиКолонку(ЧастьДеталей, "дата|операц", "");
	КолДатаДок = НайтиКолонку(ЧастьДеталей, "дата|документ", "операц|наименование|номер");
	КолНаименование = НайтиКолонку(ЧастьДеталей, "наименование|документ", "");
	КолНомер = НайтиКолонку(ЧастьДеталей, "номер|документ", "");
	КолДебет = ТочнаяКолонка(ЧастьДеталей, "СуммаДебет");
	Если КолДебет = "" Тогда
		КолДебет = НайтиКолонку(ЧастьДеталей, "дебет", "контраг");
	КонецЕсли;
	КолКредит = ТочнаяКолонка(ЧастьДеталей, "СуммаКредит");
	Если КолКредит = "" Тогда
		КолКредит = НайтиКолонку(ЧастьДеталей, "кредит", "контраг");
	КонецЕсли;
	КолНомерВх = ТочнаяКолонка(ЧастьДеталей, "НомерДокументаКонтрагент");
	КолДатаВх = ТочнаяКолонка(ЧастьДеталей, "ДатаДокументаКонтрагент");
	КолСвязанные = НайтиКолонку(ЧастьДеталей, "связанн", "");
	КолРасчетный = НайтиКолонку(ЧастьДеталей, "расчетн|документ", "");
	КолДоговорДеталей = НайтиКолонку(ЧастьДеталей, "договор", "наименование|номер|дата|№");
	Если КолДебет = "" Или КолКредит = "" Или (КолДатаОперации = "" И КолДатаДок = "") Тогда
		ВызватьИсключение "Не найдены колонки дат или сумм в детальных записях документа." + Символы.ПС + ОписаниеСтруктурыСверкиНаСервере();
	КонецЕсли;
	Если Не ПустаяСтрока(ДоговорПредставление) И КолДоговорДеталей = "" Тогда
		ВызватьИсключение "В детальных записях нет колонки с договором, поэтому нельзя отобрать строки по договору." + Символы.ПС + ОписаниеСтруктурыСверкиНаСервере();
	КонецЕсли;

	Документ_ = ДокументСверки_.ПолучитьОбъект();
	НачДт = 0;
	НачКт = 0;
	КонДт = 0;
	КонКт = 0;
	НайденоИтогов = 0;
	Для Каждого Строка_ Из Документ_[Части.Итоги] Цикл
		Если Не ПустаяСтрока(ДоговорПредставление) Тогда
			Если КолДоговорИтогов = "" Или Строка(Строка_[КолДоговорИтогов]) <> ДоговорПредставление Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			Если КолТип <> "" И Найти(НРег(Строка(Строка_[КолТип])), "поставщик") = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НачДт = НачДт + Строка_[КолНачДт];
		НачКт = НачКт + Строка_[КолНачКт];
		КонДт = КонДт + Строка_[КолКонДт];
		КонКт = КонКт + Строка_[КолКонКт];
		НайденоИтогов = НайденоИтогов + 1;
	КонецЦикла;
	Если НайденоИтогов = 0 Тогда
		ВызватьИсключение "В итогах документа нет расчётов с поставщиками" + ?(ПустаяСтрока(ДоговорПредставление), "", " по договору " + ДоговорПредставление)
			+ ". Проверьте документ: заполнен ли он («Заполнить») и записан ли.";
	КонецЕсли;

	Данные = Новый Массив;
	СтрокаЗаголовка = Новый Массив;
	СтрокаЗаголовка.Добавить("Дата");
	СтрокаЗаголовка.Добавить("Документ");
	СтрокаЗаголовка.Добавить("Дебет");
	СтрокаЗаголовка.Добавить("Кредит");
	Данные.Добавить(СтрокаЗаголовка);
	СтрокаНачала = Новый Массив;
	СтрокаНачала.Добавить("");
	СтрокаНачала.Добавить("Сальдо начальное");
	СтрокаНачала.Добавить(НачДт);
	СтрокаНачала.Добавить(НачКт);
	Данные.Добавить(СтрокаНачала);

	Для Каждого Строка_ Из Документ_[Части.Детали] Цикл
		Если Не ПустаяСтрока(ДоговорПредставление) И Строка(Строка_[КолДоговорДеталей]) <> ДоговорПредставление Тогда
			Продолжить;
		КонецЕсли;
		Дата_ = ?(КолДатаОперации <> "", Строка_[КолДатаОперации], Неопределено);
		Если Не ЗначениеЗаполнено(Дата_) И КолДатаДок <> "" Тогда
			Дата_ = Строка_[КолДатаДок];
		КонецЕсли;
		// Текст документа — как в печатной форме акта: «Товарная накладная №ЦБ-150 от 10.03.2026 (Счет-фактура №ЦБ-150 от 10.03.2026)»
		Наименование = ?(КолНаименование <> "", СокрЛП(Строка(Строка_[КолНаименование])), "");
		Если Наименование = "" И КолРасчетный <> "" Тогда
			Наименование = Строка(Строка_[КолРасчетный]);
		КонецЕсли;
		Текст = Наименование;
		// Номер и дата — входящие (поставщика), как в акте поставщика; если их нет — собственные номер и дата документа
		НомерДок = "";
		ДатаДок = Дата(1, 1, 1);
		Если КолНомерВх <> "" Тогда
			НомерДок = СокрЛП(Строка(Строка_[КолНомерВх]));
		КонецЕсли;
		Если КолДатаВх <> "" Тогда
			ДатаДок = Строка_[КолДатаВх];
		КонецЕсли;
		Если НомерДок = "" И КолРасчетный <> "" Тогда
			Попытка
				НомерДок = СокрЛП(Строка(Строка_[КолРасчетный].НомерВходящегоДокумента));
				Если Не ЗначениеЗаполнено(ДатаДок) Тогда
					ДатаДок = Строка_[КолРасчетный].ДатаВходящегоДокумента;
				КонецЕсли;
			Исключение
				НомерДок = "";
			КонецПопытки;
			Если НомерДок = "" Тогда
				Попытка
					НомерДок = СокрЛП(Строка(Строка_[КолРасчетный].Номер));
				Исключение
					НомерДок = "";
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		Если НомерДок = "" И КолНомер <> "" И Не ПустаяСтрока(Строка_[КолНомер]) Тогда
			НомерДок = СокрЛП(Строка(Строка_[КолНомер]));
		КонецЕсли;
		Если НомерДок <> "" Тогда
			Текст = Текст + " №" + НомерДок;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДатаДок) И КолДатаДок <> "" Тогда
			ДатаДок = Строка_[КолДатаДок];
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаДок) Тогда
			Текст = Текст + " от " + Формат(ДатаДок, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		Если КолСвязанные <> "" И Не ПустаяСтрока(Строка(Строка_[КолСвязанные])) Тогда
			Текст = Текст + " (" + СокрЛП(Строка(Строка_[КолСвязанные])) + ")";
		КонецЕсли;
		СтрокаДанных = Новый Массив;
		СтрокаДанных.Добавить(Дата_);
		СтрокаДанных.Добавить(Текст);
		СтрокаДанных.Добавить(Строка_[КолДебет]);
		СтрокаДанных.Добавить(Строка_[КолКредит]);
		// 5-й элемент — ссылка на расчётный документ (открывается двойным щелчком по строке результата)
		Если КолРасчетный <> "" Тогда
			СтрокаДанных.Добавить(Строка_[КолРасчетный]);
		Иначе
			СтрокаДанных.Добавить(Неопределено);
		КонецЕсли;
		Данные.Добавить(СтрокаДанных);
	КонецЦикла;

	СтрокаКонца = Новый Массив;
	СтрокаКонца.Добавить("");
	СтрокаКонца.Добавить("Сальдо конечное");
	СтрокаКонца.Добавить(КонДт);
	СтрокаКонца.Добавить(КонКт);
	Данные.Добавить(СтрокаКонца);
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область ЧтениеФайлов

// Читает файл в массив строк (строка — массив значений ячеек). Excel/MXL — через табличный документ,
// CSV — как текст, DOCX — самая большая таблица документа.
&НаСервере
Функция ПрочитатьФайлВМассив(Путь)

	Расширение = "";
	Позиция = 0;
	Для Индекс = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Индекс, 1) = "." Тогда
			Позиция = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Позиция > 0 Тогда
		Расширение = НРег(Сред(Путь, Позиция + 1));
	КонецЕсли;

	Если Расширение = "docx" Тогда
		Возврат ПрочитатьDocx(Путь);
	ИначеЕсли Расширение = "csv" Или Расширение = "txt" Тогда
		Возврат ПрочитатьCsv(Путь);
	КонецЕсли;
	Возврат ПрочитатьТабличныйДокумент(Путь);

КонецФункции

&НаСервере
Функция ПрочитатьТабличныйДокумент(Путь)

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(Путь, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Высота = ТабДок.ВысотаТаблицы;
	Ширина = ТабДок.ШиринаТаблицы;

	// Реальная ширина акта: в xls «ширина таблицы» бывает 256 колонок из-за оформления, читать их все долго.
	// Смотрим первые строки (шапка и первые операции) и берём последнюю непустую колонку с запасом.
	РеальнаяШирина = 1;
	Для НомерСтроки = 1 По Мин(Высота, 80) Цикл
		НомерКолонки = Ширина;
		Пока НомерКолонки > РеальнаяШирина Цикл
			Если Не ПустаяСтрока(ТабДок.Область(НомерСтроки, НомерКолонки).Текст) Тогда
				РеальнаяШирина = НомерКолонки;
			КонецЕсли;
			НомерКолонки = НомерКолонки - 1;
		КонецЦикла;
	КонецЦикла;
	Ширина = Мин(Ширина, РеальнаяШирина + 3);

	Результат_ = Новый Массив;
	ЧитатьЗначение = Истина;   // если значение ячейки недоступно (зависит от формата файла) — читаем отображаемый текст
	Для НомерСтроки = 1 По Высота Цикл
		СтрокаДанных = Новый Массив;
		Для НомерКолонки = 1 По Ширина Цикл
			Область = ТабДок.Область(НомерСтроки, НомерКолонки);
			Текст_ = Область.Текст;
			Значение = "";
			Если Текст_ <> "" Тогда
				// Объединённые ячейки: значение берём только из левой верхней ячейки области
				Если Область.Верх = НомерСтроки И Область.Лево = НомерКолонки Тогда
					Значение = СокрЛП(Текст_);
					Если ЧитатьЗначение И ПохожеНаЧислоИлиДату(Текст_) Тогда
						Попытка
							Значение_ = Область.Значение;
							Если ТипЗнч(Значение_) = Тип("Число") Или ТипЗнч(Значение_) = Тип("Дата") Тогда
								Значение = Значение_;
							КонецЕсли;
						Исключение
							ЧитатьЗначение = Ложь;
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			СтрокаДанных.Добавить(Значение);
		КонецЦикла;
		Результат_.Добавить(СтрокаДанных);
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Текст состоит только из цифр, пробелов, точек, запятых и минуса.
&НаСервере
Функция ПохожеНаЧислоИлиДату(Текст)

	Есть = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Сред(Текст, Индекс, 1));
		Если Код >= 48 И Код <= 57 Тогда
			Есть = Истина;
		ИначеЕсли Не (Код = 32 Или Код = 160 Или Код = 44 Или Код = 46 Или Код = 45 Или Код = 8722) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Есть;

КонецФункции

&НаСервере
Функция ПрочитатьCsv(Путь)

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(Путь, КодировкаТекста.UTF8);
	Если Найти(Текст.ПолучитьТекст(), Символ(65533)) > 0 Тогда
		Текст.Прочитать(Путь, КодировкаТекста.ANSI);
	КонецЕсли;

	// Разделитель: чаще всего «;», иначе табуляция или запятая
	Разделитель = ";";
	КолвоТочкиСЗапятой = 0;
	КолвоТабуляций = 0;
	КолвоЗапятых = 0;
	Для НомерСтроки = 1 По Мин(Текст.КоличествоСтрок(), 20) Цикл
		СтрокаТекста = Текст.ПолучитьСтроку(НомерСтроки);
		КолвоТочкиСЗапятой = КолвоТочкиСЗапятой + СтрДлина(СтрокаТекста) - СтрДлина(СтрЗаменить(СтрокаТекста, ";", ""));
		КолвоТабуляций = КолвоТабуляций + СтрДлина(СтрокаТекста) - СтрДлина(СтрЗаменить(СтрокаТекста, Символы.Таб, ""));
		КолвоЗапятых = КолвоЗапятых + СтрДлина(СтрокаТекста) - СтрДлина(СтрЗаменить(СтрокаТекста, ",", ""));
	КонецЦикла;
	Если КолвоТабуляций > КолвоТочкиСЗапятой И КолвоТабуляций >= КолвоЗапятых Тогда
		Разделитель = Символы.Таб;
	ИначеЕсли КолвоТочкиСЗапятой = 0 И КолвоЗапятых > 0 Тогда
		Разделитель = ",";
	КонецЕсли;

	Результат_ = Новый Массив;
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл
		СтрокаДанных = РазобратьСтрокуCsv(Текст.ПолучитьСтроку(НомерСтроки), Разделитель);
		Результат_.Добавить(СтрокаДанных);
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Разбор строки CSV с учётом кавычек.
&НаСервере
Функция РазобратьСтрокуCsv(СтрокаТекста, Разделитель)

	Ячейки = Новый Массив;
	Накоплено = "";
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(СтрокаТекста);
	Пока Индекс <= Длина Цикл
		Символ_ = Сред(СтрокаТекста, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ_ = """" Тогда
				Если Сред(СтрокаТекста, Индекс + 1, 1) = """" Тогда
					Накоплено = Накоплено + """";
					Индекс = Индекс + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Накоплено = Накоплено + Символ_;
			КонецЕсли;
		Иначе
			Если Символ_ = """" Тогда
				ВКавычках = Истина;
			ИначеЕсли Символ_ = Разделитель Тогда
				Ячейки.Добавить(СокрЛП(Накоплено));
				Накоплено = "";
			Иначе
				Накоплено = Накоплено + Символ_;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Ячейки.Добавить(СокрЛП(Накоплено));
	Возврат Ячейки;

КонецФункции

// Word: берём таблицу с наибольшим числом строк. DOCX — это zip с word/document.xml.
&НаСервере
Функция ПрочитатьDocx(Путь)

	КаталогРаспаковки = КаталогВременныхФайлов() + "sverka_docx_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss") + "\";
	СоздатьКаталог(КаталогРаспаковки);
	Таблицы = Новый Массив;
	Попытка
		Архив = Новый ЧтениеZipФайла(Путь);
		НайденФайл = Ложь;
		Для Каждого ЭлементАрхива Из Архив.Элементы Цикл
			Если ЭлементАрхива.ПолноеИмя = "word/document.xml" Тогда
				Архив.Извлечь(ЭлементАрхива, КаталогРаспаковки, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
				НайденФайл = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Архив.Закрыть();
		Если Не НайденФайл Тогда
			ВызватьИсключение "В файле не найден word/document.xml";
		КонецЕсли;

		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(КаталогРаспаковки + "document.xml");
		Глубина = 0;
		ТекущаяТаблица = Неопределено;
		ТекущаяСтрока = Неопределено;
		ТекущаяЯчейка = Неопределено;
		ВТексте = Ложь;
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Имя = Чтение.ЛокальноеИмя;
				Если Имя = "tbl" Тогда
					Глубина = Глубина + 1;
					Если Глубина = 1 Тогда
						ТекущаяТаблица = Новый Массив;
					КонецЕсли;
				ИначеЕсли Имя = "tr" И Глубина = 1 Тогда
					ТекущаяСтрока = Новый Массив;
				ИначеЕсли Имя = "tc" И Глубина = 1 Тогда
					ТекущаяЯчейка = "";
				ИначеЕсли Имя = "t" Тогда
					ВТексте = Истина;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Если ВТексте И ТекущаяЯчейка <> Неопределено Тогда
					ТекущаяЯчейка = ТекущаяЯчейка + Чтение.Значение;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Имя = Чтение.ЛокальноеИмя;
				Если Имя = "t" Тогда
					ВТексте = Ложь;
				ИначеЕсли Имя = "p" И ТекущаяЯчейка <> Неопределено Тогда
					ТекущаяЯчейка = ТекущаяЯчейка + " ";
				ИначеЕсли Имя = "tc" И Глубина = 1 Тогда
					Если ТекущаяСтрока <> Неопределено Тогда
						ТекущаяСтрока.Добавить(СокрЛП(ТекущаяЯчейка));
					КонецЕсли;
					ТекущаяЯчейка = Неопределено;
				ИначеЕсли Имя = "tr" И Глубина = 1 Тогда
					Если ТекущаяТаблица <> Неопределено Тогда
						ТекущаяТаблица.Добавить(ТекущаяСтрока);
					КонецЕсли;
					ТекущаяСтрока = Неопределено;
				ИначеЕсли Имя = "tbl" Тогда
					Глубина = Глубина - 1;
					Если Глубина = 0 И ТекущаяТаблица <> Неопределено Тогда
						Таблицы.Добавить(ТекущаяТаблица);
						ТекущаяТаблица = Неопределено;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		УдалитьФайлы(КаталогРаспаковки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	УдалитьФайлы(КаталогРаспаковки);

	Если Таблицы.Количество() = 0 Тогда
		ВызватьИсключение "В Word-файле не найдены таблицы";
	КонецЕсли;
	Лучшая = Таблицы[0];
	Для Каждого Таблица Из Таблицы Цикл
		Если Таблица.Количество() > Лучшая.Количество() Тогда
			Лучшая = Таблица;
		КонецЕсли;
	КонецЦикла;
	Результат_ = Новый Массив;
	Для Каждого СтрокаТаблицы Из Лучшая Цикл
		Заполнена = Ложь;
		Для Каждого Ячейка Из СтрокаТаблицы Цикл
			Если Не ПустаяСтрока(Ячейка) Тогда
				Заполнена = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Заполнена Тогда
			Результат_.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

#КонецОбласти

#Область ТекстовыеФункции

&НаКлиенте
Функция ЭтоЦифра(Символ_)

	Если Символ_ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ_);
	Возврат Код >= 48 И Код <= 57;

КонецФункции

// Буква латиницы или кириллицы.
&НаКлиенте
Функция ЭтоБуква(Символ_)

	Если Символ_ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ_);
	Возврат (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122) Или (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;

КонецФункции

// «Словесный» символ в смысле регулярных выражений JavaScript (\w): только латиница, цифры и «_».
&НаКлиенте
Функция ЭтоСимволСлова(Символ_)

	Если Символ_ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ_);
	Возврат (Код >= 48 И Код <= 57) Или (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122) Или Код = 95;

КонецФункции

&НаКлиенте
Функция ЭтоПробел(Символ_)

	Если Символ_ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ_);
	Возврат Код = 32 Или Код = 160 Или Код = 8201 Или Код = 9 Или Код = 10 Или Код = 13 Или Код = 8199 Или Код = 8239;

КонецФункции

// Значение ячейки как текст (числа — без разделителей групп разрядов).
&НаКлиенте
Функция ТекстЯчейки(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Тип_ = ТипЗнч(Значение);
	Если Тип_ = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	ИначеЕсли Тип_ = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=");
	ИначеЕсли Тип_ = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Текст всей строки таблицы в нижнем регистре (ячейки через пробел).
&НаКлиенте
Функция ТекстСтрокиНРег(СтрокаДанных)

	Части = Новый Массив;
	Для Каждого Ячейка Из СтрокаДанных Цикл
		Части.Добавить(НРег(ТекстЯчейки(Ячейка)));
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

// Текст содержит любую из подстрок (список через «|»).
&НаКлиенте
Функция СодержитЛюбую(Текст, СписокПодстрок)

	Для Каждого Подстрока Из СтрРазделить(СписокПодстрок, "|") Цикл
		Если Подстрока <> "" И Найти(Текст, Подстрока) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Ячейка — дата или строка-дата целиком (ДД.ММ.ГГГГ, ГГГГ-ММ-ДД и т.п.).
&НаКлиенте
Функция ЯчейкаЯвляетсяДатой(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДатаИзСтроки(СокрЛП(Значение)) <> "";

КонецФункции

// Распознаёт строку-дату целиком: ДД.ММ.ГГГГ, ДД/ММ/ГГГГ, ДД-ММ-ГГГГ, ГГГГ-ММ-ДД, ДД.ММ.ГГ. Возвращает ГГГГ-ММ-ДД или "".
&НаКлиенте
Функция ДатаИзСтроки(Текст)

	Числа = Новый Массив;
	Накоплено = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ_ = Сред(Текст, Индекс, 1);
		Если ЭтоЦифра(Символ_) Тогда
			Накоплено = Накоплено + Символ_;
		ИначеЕсли Символ_ = "." Или Символ_ = "/" Или Символ_ = "-" Тогда
			Если Накоплено = "" Тогда
				Возврат "";
			КонецЕсли;
			Числа.Добавить(Накоплено);
			Накоплено = "";
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Если Накоплено = "" Тогда
		Возврат "";
	КонецЕсли;
	Числа.Добавить(Накоплено);
	Если Числа.Количество() <> 3 Тогда
		Возврат "";
	КонецЕсли;
	Первое = Числа[0];
	Второе = Числа[1];
	Третье = Числа[2];
	Если СтрДлина(Первое) = 4 И СтрДлина(Второе) <= 2 И СтрДлина(Третье) <= 2 Тогда
		Возврат СобратьДатуISO(Третье, Второе, Первое, Ложь);
	ИначеЕсли СтрДлина(Первое) <= 2 И СтрДлина(Второе) <= 2 И СтрДлина(Третье) = 4 Тогда
		Возврат СобратьДатуISO(Первое, Второе, Третье, Ложь);
	ИначеЕсли СтрДлина(Первое) <= 2 И СтрДлина(Второе) <= 2 И СтрДлина(Третье) = 2 Тогда
		Возврат СобратьДатуISO(Первое, Второе, Третье, Истина);
	КонецЕсли;
	Возврат "";

КонецФункции

// ГГГГ-ММ-ДД из частей. Двузначный год: 00-30 — 20ГГ, иначе 19ГГ. Пустая строка, если день или месяц неверны.
&НаКлиенте
Функция СобратьДатуISO(День, Месяц, Год, ДвузначныйГод)

	ДеньЧисло = Число(День);
	МесяцЧисло = Число(Месяц);
	Если МесяцЧисло < 1 Или МесяцЧисло > 12 Или ДеньЧисло < 1 Или ДеньЧисло > 31 Тогда
		Возврат "";
	КонецЕсли;
	Если ДвузначныйГод Тогда
		Год = ?(Число(Год) <= 30, "20", "19") + Год;
	КонецЕсли;
	Возврат Год + "-" + Прав("0" + Формат(МесяцЧисло, "ЧГ=0"), 2) + "-" + Прав("0" + Формат(ДеньЧисло, "ЧГ=0"), 2);

КонецФункции

// Приводит дату из ячейки к виду ГГГГ-ММ-ДД. Если не распознана — возвращает исходный текст.
&НаКлиенте
Функция НормализоватьДату(Значение)

	Если Значение = Неопределено Или (ТипЗнч(Значение) = Тип("Строка") И СокрЛП(Значение) = "") Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		КонецЕсли;
		Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение > 30000 И Значение < 50000 Тогда
			Возврат Формат('18991230' + Цел(Значение) * 86400, "ДФ=yyyy-MM-dd");
		КонецЕсли;
		Возврат ТекстЯчейки(Значение);
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Дата_ = ДатаИзСтроки(Текст);
	Возврат ?(Дата_ = "", Текст, Дата_);

КонецФункции

// Даты внутри текста документа («от ДД.ММ.ГГГГ», ДД.ММ.ГГ, «ДД ММ ГГГГ», ГГГГ-ММ-ДД).
// Возвращает самую раннюю в виде ГГГГ-ММ-ДД или пустую строку.
&НаКлиенте
Функция ДатаИзТекстаДокумента(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Найденные = Новый Массив;
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Если Не ЭтоЦифра(Сред(Текст, Индекс, 1)) Или (Индекс > 1 И ЭтоЦифра(Сред(Текст, Индекс - 1, 1))) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		// Начало группы цифр: читаем до трёх групп, разделённых одним символом . / - либо пробелами
		Группы = Новый Массив;
		Разделители = Новый Массив;
		Позиция = Индекс;
		Для НомерГруппы = 1 По 3 Цикл
			Накоплено = "";
			Пока Позиция <= Длина И ЭтоЦифра(Сред(Текст, Позиция, 1)) Цикл
				Накоплено = Накоплено + Сред(Текст, Позиция, 1);
				Позиция = Позиция + 1;
			КонецЦикла;
			Если Накоплено = "" Тогда
				Прервать;
			КонецЕсли;
			Группы.Добавить(Накоплено);
			Если НомерГруппы = 3 Тогда
				Прервать;
			КонецЕсли;
			Если Позиция <= Длина Тогда
				Символ_ = Сред(Текст, Позиция, 1);
				Если Символ_ = "." Или Символ_ = "/" Или Символ_ = "-" Тогда
					Разделители.Добавить("с");
					Позиция = Позиция + 1;
				ИначеЕсли ЭтоПробел(Символ_) Тогда
					Разделители.Добавить("п");
					Пока Позиция <= Длина И ЭтоПробел(Сред(Текст, Позиция, 1)) Цикл
						Позиция = Позиция + 1;
					КонецЦикла;
				Иначе
					Прервать;
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Группы.Количество() = 3 Тогда
			Дата_ = "";
			Если Разделители[0] = "с" И Разделители[1] = "с" Тогда
				Если СтрДлина(Группы[0]) <= 2 И СтрДлина(Группы[1]) <= 2 И СтрДлина(Группы[2]) = 4 Тогда
					Дата_ = СобратьДатуISO(Группы[0], Группы[1], Группы[2], Ложь);
				ИначеЕсли СтрДлина(Группы[0]) <= 2 И СтрДлина(Группы[1]) <= 2 И СтрДлина(Группы[2]) = 2 Тогда
					Дата_ = СобратьДатуISO(Группы[0], Группы[1], Группы[2], Истина);
				ИначеЕсли СтрДлина(Группы[0]) = 4 И СтрДлина(Группы[1]) = 2 И СтрДлина(Группы[2]) = 2 Тогда
					Дата_ = СобратьДатуISO(Группы[2], Группы[1], Группы[0], Ложь);
				КонецЕсли;
			ИначеЕсли Разделители[0] = "п" И Разделители[1] = "п" Тогда
				Если СтрДлина(Группы[0]) <= 2 И СтрДлина(Группы[1]) <= 2 И СтрДлина(Группы[2]) = 4 И Лев(Группы[2], 2) = "20" Тогда
					Дата_ = СобратьДатуISO(Группы[0], Группы[1], Группы[2], Ложь);
				КонецЕсли;
			КонецЕсли;
			Если Дата_ <> "" Тогда
				Найденные.Добавить(Дата_);
				Индекс = Позиция;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		// Не дата: пропускаем текущую группу цифр
		Пока Индекс <= Длина И ЭтоЦифра(Сред(Текст, Индекс, 1)) Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;

	Если Найденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Самая = Найденные[0];
	Для Каждого Элемент Из Найденные Цикл
		Если Элемент < Самая Тогда
			Самая = Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Самая;

КонецФункции

#КонецОбласти

#Область Суммы

// Разбор числа из ячейки: «1 234,56», «1.234,56», «1,234.56», «(1 234,56)», «-100», «100 руб.» и т.п.
&НаКлиенте
Функция РазобратьСумму(Значение)

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат 0;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если Текст = "" Или Текст = "-" Или Текст = "—" Или Текст = "–" Или Текст = "*" Или Текст = "х" Или Текст = "x" Тогда
		Возврат 0;
	КонецЕсли;

	Отрицательное = Ложь;
	Первый = Лев(Текст, 1);
	Если Первый = "-" Или Первый = "−" Или (Первый = "(" И Прав(Текст, 1) = ")") Тогда
		Отрицательное = Истина;
	КонецЕсли;
	Если Первый = "(" И Прав(Текст, 1) = ")" Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	КонецЕсли;
	Если Лев(Текст, 1) = "-" Или Лев(Текст, 1) = "−" Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	// Оставляем цифры, запятую и точку; пробел между цифрами — признак разделителя тысяч
	Чистый = "";
	ЕстьПробел = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ_ = Сред(Текст, Индекс, 1);
		Если ЭтоЦифра(Символ_) Или Символ_ = "," Или Символ_ = "." Тогда
			Чистый = Чистый + Символ_;
		ИначеЕсли ЭтоПробел(Символ_) Тогда
			Если Чистый <> "" Тогда
				ЕстьПробел = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Чистый = "" Тогда
		Возврат 0;
	КонецЕсли;

	ЕстьЗапятая = Найти(Чистый, ",") > 0;
	ЕстьТочка = Найти(Чистый, ".") > 0;
	Если ЕстьЗапятая И ЕстьТочка Тогда
		Если ПоследняяПозиция(Чистый, ",") > ПоследняяПозиция(Чистый, ".") Тогда
			Чистый = СтрЗаменить(Чистый, ".", "");
			Чистый = СтрЗаменить(Чистый, ",", ".");
		Иначе
			Чистый = СтрЗаменить(Чистый, ",", "");
		КонецЕсли;
	ИначеЕсли ЕстьЗапятая Тогда
		ПозицияЗапятой = ПоследняяПозиция(Чистый, ",");
		ПослеЗапятой = Сред(Чистый, ПозицияЗапятой + 1);
		Если СтрДлина(ПослеЗапятой) = 3 И Не ЕстьПробел И ПозицияЗапятой > 1 Тогда
			Чистый = СтрЗаменить(Чистый, ",", "");
		Иначе
			Чистый = СтрЗаменить(Чистый, ",", ".");
		КонецЕсли;
	ИначеЕсли ЕстьТочка Тогда
		ПозицияТочки = ПоследняяПозиция(Чистый, ".");
		ПослеТочки = Сред(Чистый, ПозицияТочки + 1);
		Если СтрДлина(ПослеТочки) = 3 И ПозицияТочки > 1 И Не ЕстьПробел Тогда
			КолвоТочек = СтрДлина(Чистый) - СтрДлина(СтрЗаменить(Чистый, ".", ""));
			Если КолвоТочек > 1 Тогда
				Чистый = СтрЗаменить(Чистый, ".", "");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Значение_ = ЧислоИзСтроки(Чистый);
	Возврат ?(Отрицательное, -ЧислоАбс(Значение_), Значение_);

КонецФункции

&НаКлиенте
Функция ПоследняяПозиция(Текст, Подстрока)

	Результат_ = 0;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Сред(Текст, Индекс, СтрДлина(Подстрока)) = Подстрока Тогда
			Результат_ = Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Число из строки, где «.» — десятичный разделитель (лишние точки после второй части отбрасываются).
&НаКлиенте
Функция ЧислоИзСтроки(Текст)

	Части = СтрРазделить(Текст, ".");
	ЦелаяЧасть = Части[0];
	ДробнаяЧасть = ?(Части.Количество() > 1, Части[1], "");
	Если ЦелаяЧасть = "" Тогда
		ЦелаяЧасть = "0";
	КонецЕсли;
	Результат_ = Число(ЦелаяЧасть);
	Если ДробнаяЧасть <> "" Тогда
		Результат_ = Результат_ + Число(ДробнаяЧасть) / Pow(10, СтрДлина(ДробнаяЧасть));
	КонецЕсли;
	Возврат Результат_;

КонецФункции

&НаКлиенте
Функция ЧислоАбс(Значение)

	Возврат ?(Значение < 0, -Значение, Значение);

КонецФункции

#КонецОбласти

#Область НомераДокументов

// Номер документа в сравнимом виде: без «№», без буквенного префикса (УТ-, КР, СФ…), без ведущих нулей.
&НаКлиенте
Функция НормализоватьНомер(Номер)

	Если ПустаяСтрока(Номер) Тогда
		Возврат "";
	КонецЕсли;
	Текст = НРег(СокрЛП(Строка(Номер)));
	Пока Лев(Текст, 1) = "№" Или Лев(Текст, 1) = "#" Или ЭтоПробел(Лев(Текст, 1)) Цикл
		Текст = Сред(Текст, 2);
		Если Текст = "" Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	// Буквенный префикс (любые буквы до первой цифры) и необязательный разделитель «-» или «/»
	Индекс = 1;
	Пока Индекс <= СтрДлина(Текст) И ЭтоБуква(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Индекс > 1 Тогда
		Если Индекс <= СтрДлина(Текст) И (Сред(Текст, Индекс, 1) = "-" Или Сред(Текст, Индекс, 1) = "/") Тогда
			Индекс = Индекс + 1;
		КонецЕсли;
		Текст = Сред(Текст, Индекс);
	КонецЕсли;
	// Ведущие нули
	Пока Лев(Текст, 1) = "0" Цикл
		Текст = Сред(Текст, 2);
	КонецЦикла;
	Возврат СокрЛП(Текст);

КонецФункции

// В тексте есть признак счёта-фактуры / УПД.
&НаКлиенте
Функция ЭтоСчетФактура(Текст, СИнвойс = Истина)

	Нижний = НРег(Текст);
	Нижний = СтрЗаменить(Нижний, "ё", "е");
	// «счёт?фактур» — «счет», любой один символ, «фактур»
	Позиция = Найти(Нижний, "фактур");
	Пока Позиция > 0 Цикл
		Если Позиция >= 6 Тогда
			Если Сред(Нижний, Позиция - 5, 4) = "счет" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		Остаток = Сред(Нижний, Позиция + 1);
		Следующая = Найти(Остаток, "фактур");
		Если Следующая = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Следующая;
	КонецЦикла;
	Если СодержитЛюбую(Нижний, "счф|с/ф|упд") Тогда
		Возврат Истина;
	КонецЕсли;
	Если СИнвойс И Найти(Нижний, "invoice") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Номера после знака «№» или «#»: первая буква/цифра, далее латиница/цифры/«_»/«-»/«/», заканчивается цифрой, не короче двух символов.
// Ограничение «\w только латиница» намеренно сохранено: так работает исходный сервис.
&НаКлиенте
Функция НомераПослеЗнакаНомера(Текст, Широко = Ложь)

	Результат_ = Новый Массив;
	Длина = СтрДлина(Текст);
	Для Индекс = 1 По Длина Цикл
		Символ_ = Сред(Текст, Индекс, 1);
		Если Символ_ <> "№" И Символ_ <> "#" Тогда
			Продолжить;
		КонецЕсли;
		Позиция = Индекс + 1;
		Пока Позиция <= Длина И ЭтоПробел(Сред(Текст, Позиция, 1)) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Если Позиция > Длина Тогда
			Продолжить;
		КонецЕсли;
		Первый = Сред(Текст, Позиция, 1);
		Если Широко Тогда
			// Для номера СФ: только словесные символы, «-» и «/»
			Если Не (ЭтоСимволСлова(Первый) Или Первый = "-" Или Первый = "/") Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			Если Не (ЭтоБуква(Первый) Или ЭтоЦифра(Первый)) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Конец = Позиция + 1;
		Пока Конец <= Длина И (ЭтоСимволСлова(Сред(Текст, Конец, 1)) Или Сред(Текст, Конец, 1) = "-" Или Сред(Текст, Конец, 1) = "/") Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Токен = Сред(Текст, Позиция, Конец - Позиция);
		// Заканчивается на цифру: откатываем хвост без цифр
		Пока СтрДлина(Токен) > 0 И Не ЭтоЦифра(Прав(Токен, 1)) Цикл
			Токен = Лев(Токен, СтрДлина(Токен) - 1);
		КонецЦикла;
		Если СтрДлина(Токен) >= 2 Тогда
			Результат_.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Буквенно-цифровые коды вида КР0000064188, УТ-0012345: 1–4 буквы, необязательный «-» или «/», не менее 4 цифр.
// Границы слов — как в JavaScript (только латиница, цифры и «_» считаются словесными символами).
&НаКлиенте
Функция КодыСБуквамиИЦифрами(Текст)

	Результат_ = Новый Массив;
	Длина = СтрДлина(Текст);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		// Ищем начало группы цифр
		Если Не ЭтоЦифра(Сред(Текст, Индекс, 1)) Или (Индекс > 1 И ЭтоЦифра(Сред(Текст, Индекс - 1, 1))) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		КонецЦифр = Индекс;
		Пока КонецЦифр <= Длина И ЭтоЦифра(Сред(Текст, КонецЦифр, 1)) Цикл
			КонецЦифр = КонецЦифр + 1;
		КонецЦикла;
		КолвоЦифр = КонецЦифр - Индекс;
		Если КолвоЦифр >= 4 И (КонецЦифр > Длина Или Не ЭтоСимволСлова(Сред(Текст, КонецЦифр, 1))) Тогда
			// Необязательный разделитель перед цифрами и 1–4 буквы перед ним
			НачалоБукв = Индекс;
			Если Индекс > 1 И (Сред(Текст, Индекс - 1, 1) = "-" Или Сред(Текст, Индекс - 1, 1) = "/") Тогда
				НачалоБукв = Индекс - 1;
			КонецЕсли;
			ДоступноБукв = 0;
			Пока ДоступноБукв < 4 И НачалоБукв - ДоступноБукв - 1 >= 1 И ЭтоБуква(Сред(Текст, НачалоБукв - ДоступноБукв - 1, 1)) Цикл
				ДоступноБукв = ДоступноБукв + 1;
			КонецЦикла;
			// Самое левое начало совпадения (больше букв) с учётом границы слова \b в начале
			Для Сдвиг = 0 По ДоступноБукв - 1 Цикл
				КолвоБукв = ДоступноБукв - Сдвиг;
				НачалоСовпадения = НачалоБукв - КолвоБукв;
				ПервыйСимвол = Сред(Текст, НачалоСовпадения, 1);
				Предыдущий = ?(НачалоСовпадения > 1, Сред(Текст, НачалоСовпадения - 1, 1), "");
				// Граница слова: словесность символа и предыдущего различается
				Если ЭтоСимволСлова(ПервыйСимвол) <> ЭтоСимволСлова(Предыдущий) Тогда
					Результат_.Добавить(Сред(Текст, НачалоСовпадения, КонецЦифр - НачалоСовпадения));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Индекс = КонецЦифр;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Все номера документа из текста. Приоритет — номера из контекста счёта-фактуры/УПД (идут первыми).
// «Приобретение №2462 (Счёт-фактура №24462)» → «24462», «2462».
&НаКлиенте
Функция ИзвлечьНомераДокумента(Док)

	Результат_ = Новый Массив;
	Если ПустаяСтрока(Док) Тогда
		Возврат Результат_;
	КонецЕсли;
	Текст = Строка(Док);

	// Части: основной текст (без скобок) и вложенные в скобки
	Части = Новый Массив;
	Вложенные = Новый Массив;
	Основной = "";
	Позиция = 1;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Символ_ = Сред(Текст, Позиция, 1);
		Если Символ_ = "(" Тогда
			ЗакрывающаяПозиция = 0;
			Для Индекс = Позиция + 1 По Длина Цикл
				Если Сред(Текст, Индекс, 1) = ")" Тогда
					ЗакрывающаяПозиция = Индекс;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗакрывающаяПозиция > Позиция + 1 Тогда
				Вложенные.Добавить(Сред(Текст, Позиция + 1, ЗакрывающаяПозиция - Позиция - 1));
				Основной = Основной + " ";
				Позиция = ЗакрывающаяПозиция + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Основной = Основной + Символ_;
		Позиция = Позиция + 1;
	КонецЦикла;
	Части.Добавить(Основной);
	Для Каждого Вложенная Из Вложенные Цикл
		Части.Добавить(Вложенная);
	КонецЦикла;

	НомераСФ = Новый Массив;
	ПрочиеНомера = Новый Массив;
	Для Каждого Часть Из Части Цикл
		ЭтоСФ = ЭтоСчетФактура(Часть);
		Номера = Новый Массив;
		Для Каждого Токен Из НомераПослеЗнакаНомера(Часть) Цикл
			Нормальный = НормализоватьНомер(Токен);
			Если Нормальный <> "" И Номера.Найти(Нормальный) = Неопределено Тогда
				Номера.Добавить(Нормальный);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Токен Из КодыСБуквамиИЦифрами(Часть) Цикл
			Нормальный = НормализоватьНомер(Токен);
			Если Нормальный <> "" И Номера.Найти(Нормальный) = Неопределено Тогда
				Номера.Добавить(Нормальный);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Нормальный Из Номера Цикл
			Если ЭтоСФ Тогда
				НомераСФ.Добавить(Нормальный);
			Иначе
				ПрочиеНомера.Добавить(Нормальный);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Нормальный Из НомераСФ Цикл
		Если Результат_.Найти(Нормальный) = Неопределено Тогда
			Результат_.Добавить(Нормальный);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Нормальный Из ПрочиеНомера Цикл
		Если Результат_.Найти(Нормальный) = Неопределено Тогда
			Результат_.Добавить(Нормальный);
		КонецЕсли;
	КонецЦикла;

	// Запасной вариант: любое число из трёх и более цифр
	Если Результат_.Количество() = 0 Тогда
		Индекс = 1;
		Пока Индекс <= Длина Цикл
			Если ЭтоЦифра(Сред(Текст, Индекс, 1)) И (Индекс = 1 Или Не ЭтоСимволСлова(Сред(Текст, Индекс - 1, 1))) Тогда
				Конец = Индекс;
				Пока Конец <= Длина И ЭтоЦифра(Сред(Текст, Конец, 1)) Цикл
					Конец = Конец + 1;
				КонецЦикла;
				Если Конец - Индекс >= 3 И (Конец > Длина Или Не ЭтоСимволСлова(Сред(Текст, Конец, 1))) Тогда
					Результат_.Добавить(НормализоватьНомер(Сред(Текст, Индекс, Конец - Индекс)));
					Прервать;
				КонецЕсли;
				Индекс = Конец;
			Иначе
				Индекс = Индекс + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат_;

КонецФункции

// Номер счёта-фактуры/УПД из текста документа (только из СФ-части): «Приобретение №2462 (Счёт-фактура №24462)» → «24462».
&НаКлиенте
Функция ИзвлечьНомерСФ(Док)

	Если ПустаяСтрока(Док) Тогда
		Возврат "";
	КонецЕсли;
	Текст = Строка(Док);
	// Вложенные в скобки части с признаком СФ/УПД
	Позиция = 1;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) = "(" Тогда
			ЗакрывающаяПозиция = 0;
			Для Индекс = Позиция + 1 По Длина Цикл
				Если Сред(Текст, Индекс, 1) = ")" Тогда
					ЗакрывающаяПозиция = Индекс;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЗакрывающаяПозиция > Позиция Тогда
				Вложенная = Сред(Текст, Позиция + 1, ЗакрывающаяПозиция - Позиция - 1);
				Если ЭтоСчетФактура(Вложенная, Ложь) Тогда
					Токены = НомераПослеЗнакаНомера(Вложенная, Истина);
					Если Токены.Количество() > 0 Тогда
						Возврат НормализоватьНомер(Токены[0]);
					КонецЕсли;
				КонецЕсли;
				Позиция = ЗакрывающаяПозиция + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	// Сам документ — УПД/СФ (без скобок)
	Если ЭтоСчетФактура(Текст) Тогда
		Токены = НомераПослеЗнакаНомера(Текст, Истина);
		Если Токены.Количество() > 0 Тогда
			Возврат НормализоватьНомер(Токены[0]);
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

// Совпадает ли хотя бы один номер из двух наборов.
&НаКлиенте
Функция НомераСовпадают(Номера1, Номера2)

	Если Номера1.Количество() = 0 Или Номера2.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Номер Из Номера1 Цикл
		Для Каждого ДругойНомер Из Номера2 Цикл
			Если НомераЭквивалентны(Номер, ДругойНомер) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Ключ для сравнения номеров: без короткого числового префикса «11-» и без ведущих нулей.
&НаКлиенте
Функция КлючНомера(Номер)

	Текст = Строка(Номер);
	Позиция = Найти(Текст, "-");
	Если Позиция = 2 Или Позиция = 3 Тогда
		ТолькоЦифры = Истина;
		Для Индекс = 1 По Позиция - 1 Цикл
			Если Не ЭтоЦифра(Сред(Текст, Индекс, 1)) Тогда
				ТолькоЦифры = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если ТолькоЦифры Тогда
			Текст = Сред(Текст, Позиция + 1);
		КонецЕсли;
	КонецЕсли;
	Пока Лев(Текст, 1) = "0" Цикл
		Текст = Сред(Текст, 2);
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Номера считаются одинаковыми, если равны или один — начало другого до разделителя «/» или «-»:
// у нас «79313/26/0101», у поставщика «079313/26/0101/Фактура» (из него берётся «79313»).
&НаКлиенте
Функция НомераЭквивалентны(Номер1, Номер2)

	Если Номер1 = Номер2 Тогда
		Возврат Истина;
	КонецЕсли;
	А = КлючНомера(Номер1);
	Б = КлючНомера(Номер2);
	Если А = "" Или Б = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если А = Б Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрДлина(А) > СтрДлина(Б) Тогда
		Длинный = А;
		Короткий = Б;
	Иначе
		Длинный = Б;
		Короткий = А;
	КонецЕсли;
	Если СтрДлина(Короткий) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Лев(Длинный, СтрДлина(Короткий)) <> Короткий Тогда
		Возврат Ложь;
	КонецЕсли;
	Следующий = Сред(Длинный, СтрДлина(Короткий) + 1, 1);
	Возврат Следующий = "/" Или Следующий = "-";

КонецФункции

// Документ — УКД, корректировка, исправление, кредит-нота: в таких актах дебет/кредит зеркальны.
&НаКлиенте
Функция ЭтоКорректирующийДокумент(Док)

	Текст = НРег(Строка(Док));
	Если СодержитЛюбую(Текст, "укд|корректировк|исправлен|корр.") Тогда
		Возврат Истина;
	КонецЕсли;
	// «кредит.нот» / «credit.note»: любой один символ между словами
	Для Каждого Пара Из СтрРазделить("кредит|нот;credit|note", ";") Цикл
		Слова = СтрРазделить(Пара, "|");
		Позиция = Найти(Текст, Слова[0]);
		Пока Позиция > 0 Цикл
			Если Сред(Текст, Позиция + СтрДлина(Слова[0]) + 1, СтрДлина(Слова[1])) = Слова[1] Тогда
				Возврат Истина;
			КонецЕсли;
			Остаток = Сред(Текст, Позиция + 1);
			Следующая = Найти(Остаток, Слова[0]);
			Если Следующая = 0 Тогда
				Прервать;
			КонецЕсли;
			Позиция = Позиция + Следующая;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ОпределениеКолонок

// Определяет строку заголовков, первую строку данных и колонки (дата, документ, дебет, кредит).
// Результат: Структура(СтрокаШапки, ПерваяСтрока, КолДата, КолДок, КолДебет, КолКредит); номера строк и колонок — с единицы.
&НаКлиенте
Функция ОпределитьНастройкуФайла(Данные, НомерФайла)

	ИндексШапки = НайтиСтрокуШапки(Данные);
	ИндексСальдо = -1;
	Для Индекс = 0 По Мин(Данные.Количество(), 100) - 1 Цикл
		Если ЭтоСтрокаНачальногоСальдо(Данные[Индекс]) Тогда
			ИндексСальдо = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Первая строка данных: «Сальдо начальное» (если оно после шапки), иначе строка после шапки
	Если ИндексШапки >= 0 Тогда
		Если ИндексСальдо >= ИндексШапки Тогда
			Первая = ИндексСальдо + 1;
		Иначе
			Первая = ИндексШапки + 2;
		КонецЕсли;
		НомерШапки = ИндексШапки + 1;
	Иначе
		Первая = ?(ИндексСальдо >= 0, ИндексСальдо + 1, 1);
		НомерШапки = 1;
	КонецЕсли;

	Заголовки = ЗаголовкиКолонок(Данные, НомерШапки - 1);
	Назначено = Новый Структура("Дата, Док, Дебет, Кредит", -1, -1, -1, -1);

	// Прямое сопоставление по названиям колонок
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Название = Заголовки[Индекс];
		Если Название = "" Тогда
			Продолжить;
		КонецЕсли;
		Нижний = НРег(Название);
		Если Нижний = "дата" Или Нижний = "date" Или Нижний = "дата документа" Тогда
			Если Назначено.Дата < 0 Тогда
				Назначено.Дата = Индекс;
			КонецЕсли;
		ИначеЕсли Нижний = "документ" Или Нижний = "doc" Или Нижний = "описание" Или Нижний = "desc" Или Нижний = "содержание"
			Или Нижний = "основание" Или Нижний = "номер" Или Нижний = "наименование" Или Нижний = "от кого" Или Нижний = "№"
			Или Нижний = "n" Или Нижний = "no" Или Нижний = "содержание записей" Или Нижний = "наименование операции"
			Или Найти(Нижний, "наименование операци") > 0 Или Найти(Нижний, "назначение") > 0 Или Найти(Нижний, "содержание записей") > 0
			Или Найти(Нижний, "название") > 0 Тогда
			Если Назначено.Док < 0 Тогда
				Назначено.Док = Индекс;
			КонецЕсли;
		ИначеЕсли Нижний = "дебет" Или Нижний = "debet" Или Нижний = "debit" Или Нижний = "дт" Или Нижний = "dt"
			Или Лев(Нижний, 5) = "дебет" Или Прав(Нижний, 2) = "дт" Тогда
			Если Назначено.Дебет < 0 Тогда
				Назначено.Дебет = Индекс;
			КонецЕсли;
		ИначеЕсли Нижний = "кредит" Или Нижний = "kredit" Или Нижний = "credit" Или Нижний = "кт" Или Нижний = "kt"
			Или Лев(Нижний, 6) = "кредит" Или Прав(Нижний, 2) = "кт" Тогда
			Если Назначено.Кредит < 0 Тогда
				Назначено.Кредит = Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Шапка из нескольких строк: «Дебет» и «Кредит» стоят строками ниже «Дата»/«Документ» — берём первые (левый блок — «по данным» автора акта)
	Если НомерШапки >= 1 И (Назначено.Дебет < 0 Или Назначено.Кредит < 0) Тогда
		Для Индекс = НомерШапки По Мин(НомерШапки + 2, Данные.Количество() - 1) Цикл
			Для Колонка = 0 По Данные[Индекс].ВГраница() Цикл
				Текст = НРег(ТекстЯчейки(Данные[Индекс][Колонка]));
				Если Назначено.Дебет < 0 И (Текст = "дебет" Или Текст = "debet" Или Текст = "дт") Тогда
					Назначено.Дебет = Колонка;
				ИначеЕсли Назначено.Кредит < 0 И (Текст = "кредит" Или Текст = "kredit" Или Текст = "кт") Тогда
					Назначено.Кредит = Колонка;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	// Не всё нашли по заголовкам — дополняем анализом содержимого колонок
	Если Назначено.Дата < 0 Или Назначено.Док < 0 Или Назначено.Дебет < 0 Или Назначено.Кредит < 0 Тогда
		Профили = ПрофилиКолонок(Данные, НомерШапки - 1, Первая - 1);
		ПоСодержимому = НазначитьКолонкиПоСодержимому(Профили, НомерФайла);
		Для Каждого Роль Из СтрРазделить("Дата,Док,Дебет,Кредит", ",") Цикл
			Если Назначено[Роль] < 0 И ПоСодержимому[Роль] >= 0 Тогда
				Назначено[Роль] = ПоСодержимому[Роль];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Заголовок «Содержание записей» стоит над пустой колонкой, а текст — в соседней
	Если Назначено.Док >= 0 Тогда
		КолонкаПустая = Истина;
		ЕстьТекстСправа = Ложь;
		Для Индекс = Первая По Мин(Первая + 4, Данные.Количество() - 1) Цикл
			СтрокаДанных = Данные[Индекс];
			Если Назначено.Док <= СтрокаДанных.ВГраница() И Не ПустаяСтрока(ТекстЯчейки(СтрокаДанных[Назначено.Док])) Тогда
				КолонкаПустая = Ложь;
			КонецЕсли;
			Если Назначено.Док + 1 <= СтрокаДанных.ВГраница() И СтрДлина(ТекстЯчейки(СтрокаДанных[Назначено.Док + 1])) > 5 Тогда
				ЕстьТекстСправа = Истина;
			КонецЕсли;
		КонецЦикла;
		Если КолонкаПустая И ЕстьТекстСправа Тогда
			Назначено.Док = Назначено.Док + 1;
		КонецЕсли;
	КонецЕсли;

	Настройка = Новый Структура;
	Настройка.Вставить("СтрокаШапки", НомерШапки);
	Настройка.Вставить("ПерваяСтрока", Первая);
	Настройка.Вставить("КолДата", Назначено.Дата + 1);
	Настройка.Вставить("КолДок", Назначено.Док + 1);
	Настройка.Вставить("КолДебет", Назначено.Дебет + 1);
	Настройка.Вставить("КолКредит", Назначено.Кредит + 1);
	Возврат Настройка;

КонецФункции

&НаКлиенте
Функция ЭтоСтрокаНачальногоСальдо(СтрокаДанных)

	Текст = ТекстСтрокиНРег(СтрокаДанных);
	Если СодержитЛюбую(Текст, "сальдо начальное|начальное сальдо|сальдо на начало|входящее сальдо|остаток на начало|задолженность на начало") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЕстьПослеПодстроки(Текст, "задолженность по состоянию на ", "01") Или ЕстьСальдоНаДату(Текст);

КонецФункции

&НаКлиенте
Функция ЭтоСтрокаКонечногоСальдо(СтрокаДанных)

	Текст = ТекстСтрокиНРег(СтрокаДанных);
	Если СодержитЛюбую(Текст, "сальдо конечное|конечное сальдо|исходящее сальдо|остаток на конец|сальдо на конец|задолженность на конец") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЕстьПослеПодстроки(Текст, "задолженность по состоянию на ", "3");

КонецФункции

// После подстроки сразу идёт заданный префикс (например, «01» или «3»).
&НаКлиенте
Функция ЕстьПослеПодстроки(Текст, Подстрока, Префикс)

	Позиция = Найти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Если Сред(Текст, Позиция + СтрДлина(Подстрока), СтрДлина(Префикс)) = Префикс Тогда
			Возврат Истина;
		КонецЕсли;
		Остаток = Сред(Текст, Позиция + 1);
		Следующая = Найти(Остаток, Подстрока);
		Если Следующая = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Следующая;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// «сальдо на ДД.ММ.ГГ[ГГ]»
&НаКлиенте
Функция ЕстьСальдоНаДату(Текст)

	Подстрока = "сальдо на ";
	Позиция = Найти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + СтрДлина(Подстрока), 10);
		Если ЭтоЦифра(Сред(Хвост, 1, 1)) И ЭтоЦифра(Сред(Хвост, 2, 1)) И Сред(Хвост, 3, 1) = "." И ЭтоЦифра(Сред(Хвост, 4, 1)) И ЭтоЦифра(Сред(Хвост, 5, 1)) И Сред(Хвост, 6, 1) = "." Тогда
			Возврат Истина;
		КонецЕсли;
		Остаток = Сред(Текст, Позиция + 1);
		Следующая = Найти(Остаток, Подстрока);
		Если Следующая = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Следующая;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Индекс (с нуля) строки заголовков таблицы или -1.
&НаКлиенте
Функция НайтиСтрокуШапки(Данные)

	Предел = Мин(Данные.Количество(), 60) - 1;
	Для Индекс = 0 По Предел Цикл
		Если ЭтоСтрокаШапки(Данные[Индекс]) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	// Многострочная шапка актов 1С: «Дата»/«Документ» в одной строке, «Дебет»/«Кредит» — ниже
	Для Индекс = 0 По Предел Цикл
		Ячейки = Новый Массив;
		Для Каждого Ячейка Из Данные[Индекс] Цикл
			Ячейки.Добавить(НРег(ТекстЯчейки(Ячейка)));
		КонецЦикла;
		ЕстьДатаИДок = (Ячейки.Найти("дата") <> Неопределено Или Ячейки.Найти("date") <> Неопределено)
			И (Ячейки.Найти("документ") <> Неопределено Или Ячейки.Найти("doc") <> Неопределено);
		ЕстьСодержание = Ложь;
		Для Каждого Ячейка Из Ячейки Цикл
			Если Найти(Ячейка, "содержание записей") > 0 Тогда
				ЕстьСодержание = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьДатаИДок Или ЕстьСодержание Тогда
			Для Нижняя = Индекс + 1 По Мин(Индекс + 4, Данные.Количество() - 1) Цикл
				НижниеЯчейки = Новый Массив;
				Для Каждого Ячейка Из Данные[Нижняя] Цикл
					НижниеЯчейки.Добавить(НРег(ТекстЯчейки(Ячейка)));
				КонецЦикла;
				ЕстьДебет = НижниеЯчейки.Найти("дебет") <> Неопределено Или НижниеЯчейки.Найти("debet") <> Неопределено Или НижниеЯчейки.Найти("дт") <> Неопределено Или НижниеЯчейки.Найти("dt") <> Неопределено;
				ЕстьКредит = НижниеЯчейки.Найти("кредит") <> Неопределено Или НижниеЯчейки.Найти("kredit") <> Неопределено Или НижниеЯчейки.Найти("кт") <> Неопределено Или НижниеЯчейки.Найти("kt") <> Неопределено;
				Если ЕстьДебет И ЕстьКредит Тогда
					Возврат Нижняя;
				КонецЕсли;
			КонецЦикла;
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

&НаКлиенте
Функция ЭтоСтрокаШапки(СтрокаДанных)

	Ячейки = Новый Массив;
	Для Каждого Ячейка Из СтрокаДанных Цикл
		Текст = НРег(ТекстЯчейки(Ячейка));
		Если Текст <> "" Тогда
			Ячейки.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Если Ячейки.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Точные = СтрРазделить("дата|документ|дебет|кредит|дт|кт|сальдо|описание|номер|сумма|оплата|отгрузка|реализация|приход|расход|наименование|операция|"
		+ "назначение|date|debet|kredit|dt|kt|платеж|платёж|поступление|задолженность|период|счет-фактура|сч-ф|накладная|основание|содержание|"
		+ "обороты|остаток|договор|контрагент|содержание записей", "|");
	Совпадений = 0;
	Для Каждого Текст Из Ячейки Цикл
		Если Точные.Найти(Текст) <> Неопределено Тогда
			Совпадений = Совпадений + 1;
		КонецЕсли;
		Если Найти(Текст, "содержание записей") > 0 Или Найти(Текст, "наименование операц") > 0 Тогда
			Совпадений = Совпадений + 1;
		КонецЕсли;
	КонецЦикла;
	Если Совпадений >= 2 Тогда
		Возврат Истина;
	КонецЕсли;

	ЕстьДата = Ячейки.Найти("дата") <> Неопределено Или Ячейки.Найти("date") <> Неопределено;
	ЕстьДок = Ячейки.Найти("документ") <> Неопределено Или Ячейки.Найти("doc") <> Неопределено Или Ячейки.Найти("номер") <> Неопределено
		Или Ячейки.Найти("описание") <> Неопределено Или Ячейки.Найти("desc") <> Неопределено Или Ячейки.Найти("содержание") <> Неопределено;
	Для Каждого Текст Из Ячейки Цикл
		Если Найти(Текст, "содержание записей") > 0 Или Найти(Текст, "наименование операц") > 0 Тогда
			ЕстьДок = Истина;
		КонецЕсли;
	КонецЦикла;
	ЕстьДебет = Ячейки.Найти("дебет") <> Неопределено Или Ячейки.Найти("debet") <> Неопределено Или Ячейки.Найти("debit") <> Неопределено
		Или Ячейки.Найти("дт") <> Неопределено Или Ячейки.Найти("dt") <> Неопределено;
	ЕстьКредит = Ячейки.Найти("кредит") <> Неопределено Или Ячейки.Найти("kredit") <> Неопределено Или Ячейки.Найти("credit") <> Неопределено
		Или Ячейки.Найти("кт") <> Неопределено Или Ячейки.Найти("kt") <> Неопределено;
	Если (ЕстьДата Или ЕстьДок) И (ЕстьДебет Или ЕстьКредит) Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЕстьДебет И ЕстьКредит Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЕстьДата И ЕстьДок;

КонецФункции

// Заголовки колонок; пустые «Дата»/«Документ» подтягиваются из строк выше (до четырёх), если там есть эти слова.
&НаКлиенте
Функция ЗаголовкиКолонок(Данные, ИндексШапки)

	Заголовки = Новый Массив;
	Если ИндексШапки < 0 Или ИндексШапки >= Данные.Количество() Тогда
		Возврат Заголовки;
	КонецЕсли;
	Для Каждого Ячейка Из Данные[ИндексШапки] Цикл
		Заголовки.Добавить(ТекстЯчейки(Ячейка));
	КонецЦикла;
	Безопасные = СтрРазделить("дата|date|документ|doc|номер|описание|содержание|основание|наименование|операция|назначение|от кого|период", "|");
	Для Выше = Макс(0, ИндексШапки - 4) По ИндексШапки - 1 Цикл
		Строка_ = Данные[Выше];
		ЕстьСлова = Ложь;
		Для Каждого Ячейка Из Строка_ Цикл
			Текст = НРег(ТекстЯчейки(Ячейка));
			Если Текст = "дата" Или Текст = "date" Или Текст = "документ" Или Текст = "doc" Тогда
				ЕстьСлова = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьСлова Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 0 По Строка_.ВГраница() Цикл
			Текст = ТекстЯчейки(Строка_[Индекс]);
			Если Текст <> "" И Безопасные.Найти(НРег(Текст)) <> Неопределено Тогда
				Пока Заголовки.Количество() <= Индекс Цикл
					Заголовки.Добавить("");
				КонецЦикла;
				Если Заголовки[Индекс] = "" Тогда
					Заголовки[Индекс] = Текст;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Заголовки;

КонецФункции

// Профили колонок по первым 20 непустым строкам данных: доля дат, чисел, текста и т.д.
&НаКлиенте
Функция ПрофилиКолонок(Данные, ИндексШапки, ИндексПервой)

	ЧислоКолонок = 0;
	Для Индекс = 0 По Мин(Данные.Количество(), 30) - 1 Цикл
		ЧислоКолонок = Макс(ЧислоКолонок, Данные[Индекс].Количество());
	КонецЦикла;
	Образцы = Новый Массив;
	Для Индекс = Макс(ИндексПервой, 0) По Данные.Количество() - 1 Цикл
		Если Образцы.Количество() >= 20 Тогда
			Прервать;
		КонецЕсли;
		Непустая = Ложь;
		Для Каждого Ячейка Из Данные[Индекс] Цикл
			Если Не ПустаяСтрока(ТекстЯчейки(Ячейка)) Тогда
				Непустая = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Непустая Тогда
			Образцы.Добавить(Данные[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Профили = Новый Массив;
	Для Колонка = 0 По ЧислоКолонок - 1 Цикл
		КолвоДат = 0;
		КолвоЧисел = 0;
		КолвоТекста = 0;
		КолвоНулей = 0;
		Всего = 0;
		Уникальные = Новый Соответствие;
		Для Каждого СтрокаОбразца Из Образцы Цикл
			Если Колонка > СтрокаОбразца.ВГраница() Тогда
				Продолжить;
			КонецЕсли;
			Значение = СтрокаОбразца[Колонка];
			Текст = ТекстЯчейки(Значение);
			Если Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Уникальные.Вставить(Текст, Истина);
			Если ЯчейкаЯвляетсяДатой(Значение) Или (ТипЗнч(Значение) = Тип("Число") И Значение > 30000 И Значение < 55000) Тогда
				КолвоДат = КолвоДат + 1;
			ИначеЕсли Текст = "-" Или Текст = "—" Или Текст = "–" Или Текст = "0" Тогда
				КолвоНулей = КолвоНулей + 1;
			Иначе
				Сумма = РазобратьСумму(Значение);
				Если Сумма <> 0 Тогда
					КолвоЧисел = КолвоЧисел + 1;
				Иначе
					КолвоТекста = КолвоТекста + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Всего_ = Макс(Всего, 1);
		Профиль = Новый Структура;
		Профиль.Вставить("Индекс", Колонка);
		Профиль.Вставить("Заголовок", ?(ИндексШапки >= 0 И ИндексШапки < Данные.Количество() И Колонка <= Данные[ИндексШапки].ВГраница(),
			НРег(ТекстЯчейки(Данные[ИндексШапки][Колонка])), ""));
		Профиль.Вставить("ДоляДат", КолвоДат / Всего_);
		Профиль.Вставить("ДоляЧисел", КолвоЧисел / Всего_);
		Профиль.Вставить("ДоляТекста", КолвоТекста / Всего_);
		Профиль.Вставить("ДоляНулей", КолвоНулей / Всего_);
		Профиль.Вставить("ДоляУникальных", Уникальные.Количество() / Всего_);
		Профиль.Вставить("Заполнена", Всего / Макс(Образцы.Количество(), 1));
		Профили.Добавить(Профиль);
	КонецЦикла;
	Возврат Профили;

КонецФункции

// Жадное назначение ролей лучшим колонкам по оценкам (как в исходном сервисе). Возвращает Структура(Дата, Док, Дебет, Кредит) — индексы с нуля или -1.
&НаКлиенте
Функция НазначитьКолонкиПоСодержимому(Профили, НомерФайла)

	Оценки = Новый Структура("Дата, Док, Дебет, Кредит");
	Для Каждого Роль Из СтрРазделить("Дата,Док,Дебет,Кредит", ",") Цикл
		Оценки[Роль] = Новый Массив;
	КонецЦикла;

	Для Каждого Профиль Из Профили Цикл
		Заг = Профиль.Заголовок;
		// Дата
		Оценка = Профиль.ДоляДат * 80;
		Оценка = Оценка + ?(СодержитЛюбую(Заг, "дата|date|период"), 100, 0);
		Оценка = Оценка + ?(Профиль.Заполнена > 0.5, 10, 0);
		Оценки.Дата.Добавить(Новый Структура("Индекс, Оценка", Профиль.Индекс, Оценка));
		// Документ
		Оценка = Профиль.ДоляТекста * 40;
		Оценка = Оценка + ?(СодержитЛюбую(Заг, "документ|описание|номер|наименование|операция|назначение|doc|desc|платежн|фактур|накладн|договор|содержание|основание"), 100, 0);
		Оценка = Оценка + ?(Профиль.ДоляУникальных > 0.5 И Профиль.ДоляТекста > 0.3, 15, 0);
		Оценка = Оценка - ?(Профиль.ДоляЧисел > 0.5, 25, 0);
		Оценка = Оценка - ?(Профиль.ДоляДат > 0.3, 20, 0);
		Оценка = Оценка + ?(Профиль.Заполнена > 0.5, 5, 0);
		Оценки.Док.Добавить(Новый Структура("Индекс, Оценка", Профиль.Индекс, Оценка));
		// Дебет
		Оценка = Профиль.ДоляЧисел * 35;
		Если СодержитЛюбую(Заг, "по данным|сумма документа|сумма|total|итог") И Не СодержитЛюбую(Заг, "дебет|debet|debit") Тогда
			Оценка = Оценка - 200;
		КонецЕсли;
		Если НомерФайла = 2 Тогда
			Оценка = Оценка + ?(СодержитЛюбую(Заг, "дебет|debet|debit|отгрузка|расход|реализац|поставк"), 100, 0);
		Иначе
			Оценка = Оценка + ?(СодержитЛюбую(Заг, "дебет|debet|debit|оплата|приход|платеж|платёж|поступлен"), 100, 0);
		КонецЕсли;
		Оценка = Оценка + ?(Профиль.ДоляНулей > 0.1 И Профиль.ДоляНулей < 0.9, 10, 0);
		Оценка = Оценка - ?(Профиль.ДоляДат > 0.3, 30, 0);
		Оценка = Оценка - ?(Профиль.ДоляТекста > 0.4, 20, 0);
		Оценки.Дебет.Добавить(Новый Структура("Индекс, Оценка", Профиль.Индекс, Оценка));
		// Кредит
		Оценка = Профиль.ДоляЧисел * 35;
		Если СодержитЛюбую(Заг, "по данным|сумма документа|сумма|total|итог") И Не СодержитЛюбую(Заг, "кредит|kredit|credit") Тогда
			Оценка = Оценка - 200;
		КонецЕсли;
		Если НомерФайла = 2 Тогда
			Оценка = Оценка + ?(СодержитЛюбую(Заг, "кредит|kredit|credit|оплата|приход|платеж|платёж|поступлен"), 100, 0);
		Иначе
			Оценка = Оценка + ?(СодержитЛюбую(Заг, "кредит|kredit|credit|отгрузка|расход|реализац|поставк|долг|задолж"), 100, 0);
		КонецЕсли;
		Оценка = Оценка + ?(Профиль.ДоляНулей > 0.1 И Профиль.ДоляНулей < 0.9, 10, 0);
		Оценка = Оценка - ?(Профиль.ДоляДат > 0.3, 30, 0);
		Оценка = Оценка - ?(Профиль.ДоляТекста > 0.4, 20, 0);
		Оценки.Кредит.Добавить(Новый Структура("Индекс, Оценка", Профиль.Индекс, Оценка));
	КонецЦикла;

	Назначено = Новый Структура("Дата, Док, Дебет, Кредит", -1, -1, -1, -1);
	Занятые = Новый Соответствие;
	Для Каждого Роль Из СтрРазделить("Дата,Дебет,Кредит,Док", ",") Цикл
		Лучший = -1;
		ЛучшаяОценка = 0;
		Для Каждого Элемент Из Оценки[Роль] Цикл
			Если Занятые.Получить(Элемент.Индекс) = Неопределено И Элемент.Оценка > ЛучшаяОценка Тогда
				Лучший = Элемент.Индекс;
				ЛучшаяОценка = Элемент.Оценка;
			КонецЕсли;
		КонецЦикла;
		Если Лучший >= 0 Тогда
			Назначено[Роль] = Лучший;
			Занятые.Вставить(Лучший, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Назначено;

КонецФункции

#КонецОбласти

#Область РазборДанных

// Сальдо начальное и конечное из строк файла.
// Результат: Структура(Начальное, Конечное) — каждое либо Неопределено, либо Структура(Сальдо, СыройДебет, СыройКредит, Переплата).
&НаКлиенте
Функция РазобратьСальдо(Данные, НомерФайла, КолДебет, КолКредит)

	Результат_ = Новый Структура("Начальное, Конечное", Неопределено, Неопределено);
	НомерСтроки = 0;
	Для Каждого СтрокаДанных Из Данные Цикл
		НомерСтроки = НомерСтроки + 1;
		ЭтоНачальное = ЭтоСтрокаНачальногоСальдо(СтрокаДанных);
		ЭтоКонечное = ЭтоСтрокаКонечногоСальдо(СтрокаДанных);
		Если Не ЭтоНачальное И Не ЭтоКонечное Тогда
			Продолжить;
		КонецЕсли;
		СыройДебет = РазобратьСумму(ЗначениеКолонки(СтрокаДанных, КолДебет));
		СыройКредит = РазобратьСумму(ЗначениеКолонки(СтрокаДанных, КолКредит));
		Если СыройДебет = 0 И СыройКредит = 0 Тогда
			// В указанных колонках пусто (сдвиг колонок, объединённые ячейки): берём числа из самой строки, ближайшая колонка решает «дебет/кредит»
			Для Индекс = 0 По СтрокаДанных.ВГраница() Цикл
				Ячейка = СтрокаДанных[Индекс];
				Если ТипЗнч(Ячейка) <> Тип("Число") И (ТипЗнч(Ячейка) <> Тип("Строка") Или Не ЭтоСуммаТекстом(Ячейка)) Тогда
					Продолжить;
				КонецЕсли;
				Число_ = РазобратьСумму(Ячейка);
				Если Число_ = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если ЧислоАбс(Индекс + 1 - КолДебет) <= ЧислоАбс(Индекс + 1 - КолКредит) Тогда
					СыройДебет = СыройДебет + Число_;
				Иначе
					СыройКредит = СыройКредит + Число_;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Дебет = СыройДебет;
		Кредит = СыройКредит;
		// У поставщика дебет и кредит противоположны покупателю
		Если НомерФайла = 2 Тогда
			Дебет = СыройКредит;
			Кредит = СыройДебет;
		КонецЕсли;
		Сальдо = Новый Структура;
		Сальдо.Вставить("Сальдо", Дебет - Кредит);
		Сальдо.Вставить("СыройДебет", СыройДебет);
		Сальдо.Вставить("СыройКредит", СыройКредит);
		Сальдо.Вставить("НомерСтроки", НомерСтроки);
		Сальдо.Вставить("Переплата", ?(НомерФайла = 1, СыройДебет > СыройКредит, СыройКредит > СыройДебет));
		Если ЭтоНачальное Тогда
			Результат_.Начальное = Сальдо;
		КонецЕсли;
		Если ЭтоКонечное Тогда
			Результат_.Конечное = Сальдо;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Строка похожа на сумму: цифры, пробелы (в т.ч. неразрывные), запятая или точка.
&НаКлиенте
Функция ЭтоСуммаТекстом(Текст)

	Есть = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ_ = Сред(Текст, Индекс, 1);
		Если ЭтоЦифра(Символ_) Тогда
			Есть = Истина;
		ИначеЕсли Символ_ <> "," И Символ_ <> "." И Символ_ <> "-" И Не ЭтоПробел(Символ_) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Есть;

КонецФункции

// Значение ячейки по номеру колонки (с единицы); пусто, если колонки нет в строке.
&НаКлиенте
Функция ЗначениеКолонки(СтрокаДанных, НомерКолонки)

	Если НомерКолонки < 1 Или НомерКолонки > СтрокаДанных.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрокаДанных[НомерКолонки - 1];

КонецФункции

// Строка относится к «мусору»: итоги, сальдо, подписи, реквизиты, пояснительный текст.
&НаКлиенте
Функция ЭтоМусорнаяСтрока(Текст)

	Если СодержитЛюбую(Текст, "обороты|сальдо начальное|начальное сальдо|сальдо на начало|входящее сальдо|остаток на начало|сальдо конечное|конечное сальдо|сальдо на конец|итого"
		+ "|исходящее сальдо|сальдо входящее|сальдо исходящее|входящий остаток|исходящий остаток|остаток на конец|задолженность на конец|сальдо на начало|сальдо на конец"
		+ "|задолженность по состоянию|долг по состоянию|остаток по состоянию|таким образом|генеральный директор|главный бухгалтер|нижеподписавш"
		+ "|составили настоящий|одной стороны|другой стороны|подписи сторон|должность|расшифровка|м.п.|были осуществлены следующие"
		+ "|расчеты с клиентом|расчёты с клиентом|юридический адрес|фактический адрес|краснодарский край|московская область") Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЕстьСальдоНаДату(Текст) Или ЕстьПослеПодстрокиЦифра(Текст, "задолженность на ") Или ЕстьПослеПодстрокиЦифра(Текст, "в период с ") Тогда
		Возврат Истина;
	КонецЕсли;
	// «инн» и 10+ цифр, «кпп» и 9 цифр
	Если ЕстьПослеПодстрокиЦифры(Текст, "инн ", 10) Или ЕстьПослеПодстрокиЦифры(Текст, "кпп ", 9) Тогда
		Возврат Истина;
	КонецЕсли;
	// «ооо … инн», «ип … инн», «пао … инн», «ао … инн»
	Для Каждого Форма_ Из СтрРазделить("ооо |ип |пао |ао ", "|") Цикл
		ПозицияФормы = Найти(Текст, Форма_);
		Если ПозицияФормы > 0 И Найти(Сред(Текст, ПозицияФормы + СтрДлина(Форма_)), "инн") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	// «долг … в валюте»
	ПозицияДолга = Найти(Текст, "долг ");
	Если ПозицияДолга > 0 И Найти(Сред(Текст, ПозицияДолга + 8), " в валюте") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	// «тысяч… рублей», «рублей NN копеек»
	ПозицияТысяч = Найти(Текст, "тысяч");
	Если ПозицияТысяч > 0 И Найти(Сред(Текст, ПозицияТысяч + 5, 12), " рублей") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	ПозицияРублей = Найти(Текст, "рублей ");
	Если ПозицияРублей > 0 Тогда
		Хвост = Сред(Текст, ПозицияРублей + 7, 10);
		Если ЭтоЦифра(Сред(Хвост, 1, 1)) И ЭтоЦифра(Сред(Хвост, 2, 1)) И Сред(Хвост, 3, 8) = " копеек" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Если Лев(Текст, 4) = "мы, " Или Лев(Текст, 13) = "представитель" Или СокрЛП(Текст) = "подпись" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ЕстьПослеПодстрокиЦифра(Текст, Подстрока)

	Позиция = Найти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Если ЭтоЦифра(Сред(Текст, Позиция + СтрДлина(Подстрока), 1)) Тогда
			Возврат Истина;
		КонецЕсли;
		Остаток = Сред(Текст, Позиция + 1);
		Следующая = Найти(Остаток, Подстрока);
		Если Следующая = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Следующая;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// После подстроки идёт не менее N цифр подряд.
&НаКлиенте
Функция ЕстьПослеПодстрокиЦифры(Текст, Подстрока, МинКолво)

	Позиция = Найти(Текст, Подстрока);
	Пока Позиция > 0 Цикл
		Кол = 0;
		Индекс = Позиция + СтрДлина(Подстрока);
		Пока Индекс <= СтрДлина(Текст) И ЭтоЦифра(Сред(Текст, Индекс, 1)) Цикл
			Кол = Кол + 1;
			Индекс = Индекс + 1;
		КонецЦикла;
		Если Кол >= МинКолво Тогда
			Возврат Истина;
		КонецЕсли;
		Остаток = Сред(Текст, Позиция + 1);
		Следующая = Найти(Остаток, Подстрока);
		Если Следующая = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Следующая;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Есть ли дата хотя бы в одной ячейке строки.
&НаКлиенте
Функция ЕстьДатаВЛюбойЯчейке(СтрокаДанных)

	Для Каждого Ячейка Из СтрокаДанных Цикл
		Если ЯчейкаЯвляетсяДатой(Ячейка) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Строки операций файла: отбрасываются пустые, служебные, подписи и реквизиты.
&НаКлиенте
Функция РазобратьОперации(Данные, НомерФайла, ПерваяСтрока, КолДата, КолДок, КолДебет, КолКредит)

	Операции = Новый Массив;
	Для Индекс = Макс(ПерваяСтрока - 1, 0) По Данные.Количество() - 1 Цикл
		СтрокаДанных = Данные[Индекс];
		Дата_ = НормализоватьДату(ЗначениеКолонки(СтрокаДанных, КолДата));
		ДокСырой = ТекстЯчейки(ЗначениеКолонки(СтрокаДанных, КолДок));
		ТекстПервичный = ДокСырой;
		// Если колонка документа пуста — берём текст из соседних колонок (±2)
		Если ДокСырой = "" Тогда
			Для Сдвиг = 1 По 2 Цикл
				Следующая = ТекстЯчейки(ЗначениеКолонки(СтрокаДанных, КолДок + Сдвиг));
				Если СтрДлина(Следующая) > 3 Тогда
					ДокСырой = Следующая;
					Прервать;
				КонецЕсли;
				Предыдущая = ТекстЯчейки(ЗначениеКолонки(СтрокаДанных, КолДок - Сдвиг));
				Если СтрДлина(Предыдущая) > 3 Тогда
					ДокСырой = Предыдущая;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Номера = ИзвлечьНомераДокумента(ДокСырой);
		ДатаВДокументе = ДатаИзТекстаДокумента(ДокСырой);
		Дебет = РазобратьСумму(ЗначениеКолонки(СтрокаДанных, КолДебет));
		Кредит = РазобратьСумму(ЗначениеКолонки(СтрокаДанных, КолКредит));
		// У поставщика дебет и кредит противоположны покупателю — меняем местами
		Если НомерФайла = 2 Тогда
			Временный = Дебет;
			Дебет = Кредит;
			Кредит = Временный;
		КонецЕсли;
		Сумма = ЧислоАбс(Дебет) + ЧислоАбс(Кредит);

		// 1. Пустая строка
		Если Дата_ = "" И ДокСырой = "" И Дебет = 0 И Кредит = 0 Тогда
			Продолжить;
		КонецЕсли;
		// 2. Служебные строки (вся строка и первая ячейка)
		Если ЭтоМусорнаяСтрока(ТекстСтрокиНРег(СтрокаДанных)) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаДанных.Количество() > 0 И ЭтоМусорнаяСтрока(НРег(ТекстЯчейки(СтрокаДанных[0]))) Тогда
			Продолжить;
		КонецЕсли;
		// 3. Нулевая сумма и длинный описательный текст без даты
		Если Сумма = 0 И СтрДлина(ДокСырой) > 30 И Дата_ = "" И Не ЕстьДатаВЛюбойЯчейке(СтрокаДанных) Тогда
			Продолжить;
		КонецЕсли;
		// 4. Строка должна быть операцией: дата и (номер или сумма), либо номер и сумма
		ЕстьНомер = ИзвлечьНомераДокумента(ТекстПервичный).Количество() > 0;
		ЕстьСумма = Сумма > 0.009;
		Если Не ((Дата_ <> "" И (ЕстьНомер Или ЕстьСумма)) Или (ЕстьНомер И ЕстьСумма)) Тогда
			Продолжить;
		КонецЕсли;

		Операция = Новый Структура;
		Операция.Вставить("Дата", Дата_);
		Операция.Вставить("Док", НРег(СтрЗаменить(СокрЛП(ДокСырой), "  ", " ")));
		Операция.Вставить("Номера", Номера);
		Операция.Вставить("Номер", ?(Номера.Количество() > 0, Номера[0], ""));
		Операция.Вставить("ДатаДока", ДатаВДокументе);
		Операция.Вставить("ДокСырой", ДокСырой);
		Операция.Вставить("Дебет", Дебет);
		Операция.Вставить("Кредит", Кредит);
		Операция.Вставить("Сумма", Сумма);
		Операция.Вставить("Ссылка", СсылкаНаДокументИзСтроки(СтрокаДанных));
		Операции.Добавить(Операция);
	КонецЦикла;
	Возврат Операции;

КонецФункции

#КонецОбласти

#Область Сверка

// Сопоставляет операции двух актов. Статусы результата: match, mismatch, only1 (только у нас), only2 (только у поставщика).
// Метод: «date_doc_sum» (дата + номер + сумма), «doc_sum» (номер + сумма), «date_sum» (дата + сумма), «sum_only» (только сумма).
&НаКлиенте
Процедура ДобавитьВИндекс(Индекс, Ключ, НомерЗаписи)

	Список = Индекс.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Индекс.Вставить(Ключ, Список);
	КонецЕсли;
	Если Список.Количество() = 0 Или Список[Список.ВГраница()] <> НомерЗаписи Тогда
		Список.Добавить(НомерЗаписи);
	КонецЕсли;

КонецПроцедуры

// Индекс записей по ключам номеров: «Полные» — ключ целиком, «Префиксы» — начало ключа до «/» или «-» (от 3 символов).
&НаКлиенте
Функция ПостроитьИндексПоНомерам(Данные)

	Полные = Новый Соответствие;
	Префиксы = Новый Соответствие;
	Для Индекс = 0 По Данные.Количество() - 1 Цикл
		Для Каждого Номер Из Данные[Индекс].Номера Цикл
			Ключ = КлючНомера(Номер);
			Если Ключ = "" Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьВИндекс(Полные, Ключ, Индекс);
			Для Позиция = 4 По СтрДлина(Ключ) Цикл
				Символ_ = Сред(Ключ, Позиция, 1);
				Если Символ_ = "/" Или Символ_ = "-" Тогда
					ДобавитьВИндекс(Префиксы, Лев(Ключ, Позиция - 1), Индекс);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Полные, Префиксы", Полные, Префиксы);

КонецФункции

&НаКлиенте
Процедура СобратьИзСписка(Набор, Список)

	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Список Цикл
		Набор.Вставить(Элемент, Истина);
	КонецЦикла;

КонецПроцедуры

// Индексы из набора по возрастанию (порядок важен: берётся первое подходящее).
&НаКлиенте
Функция ОтсортированныеИндексы(Набор)

	Результат_ = Новый Массив;
	Для Каждого Пара Из Набор Цикл
		Значение = Пара.Ключ;
		Позиция = Результат_.Количество();
		Результат_.Добавить(Значение);
		Пока Позиция > 0 И Результат_[Позиция - 1] > Значение Цикл
			Результат_[Позиция] = Результат_[Позиция - 1];
			Позиция = Позиция - 1;
		КонецЦикла;
		Результат_[Позиция] = Значение;
	КонецЦикла;
	Возврат Результат_;

КонецФункции

// Кандидаты для записи: записи другого акта, у которых номер совпадает или является началом номера (и наоборот).
&НаКлиенте
Функция КандидатыПоНомерам(Запись, ИндексДругого)

	Набор = Новый Соответствие;
	Для Каждого Номер Из Запись.Номера Цикл
		Ключ = КлючНомера(Номер);
		Если Ключ = "" Тогда
			Продолжить;
		КонецЕсли;
		СобратьИзСписка(Набор, ИндексДругого.Полные.Получить(Ключ));
		СобратьИзСписка(Набор, ИндексДругого.Префиксы.Получить(Ключ));
		Для Позиция = 4 По СтрДлина(Ключ) Цикл
			Символ_ = Сред(Ключ, Позиция, 1);
			Если Символ_ = "/" Или Символ_ = "-" Тогда
				СобратьИзСписка(Набор, ИндексДругого.Полные.Получить(Лев(Ключ, Позиция - 1)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ОтсортированныеИндексы(Набор);

КонецФункции

&НаКлиенте
Функция ПостроитьИндексПоСуммам(Данные)

	Результат_ = Новый Соответствие;
	Для Индекс = 0 По Данные.Количество() - 1 Цикл
		ДобавитьВИндекс(Результат_, Окр(Данные[Индекс].Сумма * 100, 0), Индекс);
	КонецЦикла;
	Возврат Результат_;

КонецФункции

&НаКлиенте
Функция КандидатыПоСумме(Запись, ИндексСумм)

	Набор = Новый Соответствие;
	Центр = Окр(Запись.Сумма * 100, 0);
	Для Сдвиг = -1 По 1 Цикл
		СобратьИзСписка(Набор, ИндексСумм.Получить(Центр + Сдвиг));
	КонецЦикла;
	Возврат ОтсортированныеИндексы(Набор);

КонецФункции

&НаКлиенте
Функция СравнитьОперации(Данные1, Данные2, МетодСверки)

	Результаты = Новый Массив;
	Сопоставлено1 = Новый Соответствие;
	Сопоставлено2 = Новый Соответствие;
	// Индексы для быстрого поиска (иначе сравнение «каждый с каждым» на тысячах строк очень медленное)
	ИндексДанных1 = ПостроитьИндексПоНомерам(Данные1);
	ИндексДанных2 = ПостроитьИндексПоНомерам(Данные2);
	СуммыДанных2 = ПостроитьИндексПоСуммам(Данные2);

	// Метод 1/2: дата + номер + сумма, либо номер + сумма
	Если МетодСверки = "date_doc_sum" Или МетодСверки = "doc_sum" Тогда
		Для Индекс1 = 0 По Данные1.Количество() - 1 Цикл
			Если Сопоставлено1.Получить(Индекс1) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись1 = Данные1[Индекс1];
			Для Каждого Индекс2 Из КандидатыПоНомерам(Запись1, ИндексДанных2) Цикл
				Если Сопоставлено2.Получить(Индекс2) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Запись2 = Данные2[Индекс2];
				НомераСовпали = НомераСовпадают(Запись1.Номера, Запись2.Номера);
				Если МетодСверки = "date_doc_sum" Тогда
					Совпало = ДатаДляСравнения(Запись1) = ДатаДляСравнения(Запись2) И НомераСовпали И ЧислоАбс(Запись1.Сумма - Запись2.Сумма) < 0.01;
				Иначе
					Совпало = НомераСовпали И ЧислоАбс(Запись1.Сумма - Запись2.Сумма) < 0.01;
				КонецЕсли;
				Если Совпало Тогда
					Сопоставлено1.Вставить(Индекс1, Истина);
					Сопоставлено2.Вставить(Индекс2, Истина);
					// Номер СФ у нас отличается от номера документа у поставщика — предупреждение
					НомерСФ1 = ИзвлечьНомерСФ(Запись1.ДокСырой);
					НомерСФ2 = ИзвлечьНомерСФ(Запись2.ДокСырой);
					Если НомерСФ2 = "" Тогда
						НомерСФ2 = ?(Запись2.Номера.Количество() > 0, Запись2.Номера[0], "");
					КонецЕсли;
					Предупреждение = "";
					Если НомерСФ1 <> "" И НомерСФ2 <> "" И Не НомераЭквивалентны(НомерСФ1, НомерСФ2) Тогда
						Предупреждение = "Номер СФ расходится: у нас №" + НомерСФ1 + ", у поставщика №" + НомерСФ2;
					КонецЕсли;
					Результаты.Добавить(НоваяЗаписьРезультата(Запись1, Запись2, ?(Предупреждение = "", "match", "mismatch"),
						?(МетодСверки = "date_doc_sum", "Д+Н+С", "Н+С"), Предупреждение));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	// Метод 3: дата + сумма; метод 4: только сумма
	Если МетодСверки = "date_sum" Или МетодСверки = "sum_only" Тогда
		Для Индекс1 = 0 По Данные1.Количество() - 1 Цикл
			Если Сопоставлено1.Получить(Индекс1) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись1 = Данные1[Индекс1];
			Для Каждого Индекс2 Из КандидатыПоСумме(Запись1, СуммыДанных2) Цикл
				Если Сопоставлено2.Получить(Индекс2) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Запись2 = Данные2[Индекс2];
				Если МетодСверки = "date_sum" Тогда
					Совпало = ДатаДляСравнения(Запись1) = ДатаДляСравнения(Запись2) И ЧислоАбс(Запись1.Сумма - Запись2.Сумма) < 0.01;
				Иначе
					Совпало = ЧислоАбс(Запись1.Сумма - Запись2.Сумма) < 0.01;
				КонецЕсли;
				Если Совпало Тогда
					Сопоставлено1.Вставить(Индекс1, Истина);
					Сопоставлено2.Вставить(Индекс2, Истина);
					Результаты.Добавить(НоваяЗаписьРезультата(Запись1, Запись2, "match", ?(МетодСверки = "date_sum", "Д+С", "С"), ""));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	// Зеркальное сопоставление УКД / корректировок: у покупателя идут по дебету, у поставщика по кредиту
	Для Индекс1 = 0 По Данные1.Количество() - 1 Цикл
		Если Сопоставлено1.Получить(Индекс1) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись1 = Данные1[Индекс1];
		Если Не ЭтоКорректирующийДокумент(Запись1.ДокСырой) И Запись1.Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Индекс2 Из КандидатыПоНомерам(Запись1, ИндексДанных2) Цикл
			Если Сопоставлено2.Получить(Индекс2) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись2 = Данные2[Индекс2];
			Если Не НомераСовпадают(Запись1.Номера, Запись2.Номера) Тогда
				Продолжить;
			КонецЕсли;
			ДатаПодходит = МетодСверки = "doc_sum" Или МетодСверки = "sum_only" Или ДатаДляСравнения(Запись1) = ДатаДляСравнения(Запись2);
			Если Не ДатаПодходит Тогда
				Продолжить;
			КонецЕсли;
			ЗеркалоДК = ЧислоАбс(Запись1.Дебет - Запись2.Кредит) < 0.01 И Запись1.Дебет > 0;
			ЗеркалоКД = ЧислоАбс(Запись1.Кредит - Запись2.Дебет) < 0.01 И Запись1.Кредит > 0;
			Если ЗеркалоДК Или ЗеркалоКД Тогда
				Сопоставлено1.Вставить(Индекс1, Истина);
				Сопоставлено2.Вставить(Индекс2, Истина);
				Запись = НоваяЗаписьРезультата(Запись1, Запись2, "match", "УКД", "Зеркальное отражение (дебет ↔ кредит)");
				Запись.Разница = 0;
				Результаты.Добавить(Запись);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Групповое совпадение: одна запись у нас = несколько у поставщика (и наоборот) по номеру, суммы в сумме совпадают
	Если МетодСверки = "date_doc_sum" Или МетодСверки = "doc_sum" Тогда
		Для Индекс1 = 0 По Данные1.Количество() - 1 Цикл
			Если Сопоставлено1.Получить(Индекс1) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись1 = Данные1[Индекс1];
			Если Запись1.Номера.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Кандидаты = Новый Массив;
			Для Каждого Индекс2 Из КандидатыПоНомерам(Запись1, ИндексДанных2) Цикл
				Если Сопоставлено2.Получить(Индекс2) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Запись2 = Данные2[Индекс2];
				Если Не НомераСовпадают(Запись1.Номера, Запись2.Номера) Тогда
					Продолжить;
				КонецЕсли;
				Если МетодСверки = "date_doc_sum" Тогда
					Если Не (ДатаДляСравнения(Запись1) = ДатаДляСравнения(Запись2) Или ДатаДляСравнения(Запись2) = "" Или ДатаДляСравнения(Запись1) = "") Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				Кандидаты.Добавить(Индекс2);
			КонецЦикла;
			Если Кандидаты.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			СуммаГруппы = 0;
			Дебет2 = 0;
			Кредит2 = 0;
			Для Каждого Индекс2 Из Кандидаты Цикл
				СуммаГруппы = СуммаГруппы + Данные2[Индекс2].Сумма;
				Дебет2 = Дебет2 + Данные2[Индекс2].Дебет;
				Кредит2 = Кредит2 + Данные2[Индекс2].Кредит;
			КонецЦикла;
			Если ЧислоАбс(Запись1.Сумма - СуммаГруппы) > 0.05 Тогда
				Продолжить;
			КонецЕсли;
			Сопоставлено1.Вставить(Индекс1, Истина);
			Для Каждого Индекс2 Из Кандидаты Цикл
				Сопоставлено2.Вставить(Индекс2, Истина);
			КонецЦикла;
			Запись = НоваяЗаписьРезультата(Запись1, Неопределено, "match", "1:" + Кандидаты.Количество(),
				"1 запись = " + Кандидаты.Количество() + " у поставщика");
			Запись.СуммаПост = СуммаГруппы;
			Запись.ДебетПост = Дебет2;
			Запись.КредитПост = Кредит2;
			Запись.Разница = 0;
			Результаты.Добавить(Запись);
		КонецЦикла;

		Для Индекс2 = 0 По Данные2.Количество() - 1 Цикл
			Если Сопоставлено2.Получить(Индекс2) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись2 = Данные2[Индекс2];
			Если Запись2.Номера.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Кандидаты = Новый Массив;
			Для Каждого Индекс1 Из КандидатыПоНомерам(Запись2, ИндексДанных1) Цикл
				Если Сопоставлено1.Получить(Индекс1) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Запись1 = Данные1[Индекс1];
				Если Не НомераСовпадают(Запись1.Номера, Запись2.Номера) Тогда
					Продолжить;
				КонецЕсли;
				Если МетодСверки = "date_doc_sum" Тогда
					Если Не (ДатаДляСравнения(Запись1) = ДатаДляСравнения(Запись2) Или ДатаДляСравнения(Запись1) = "" Или ДатаДляСравнения(Запись2) = "") Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				Кандидаты.Добавить(Индекс1);
			КонецЦикла;
			Если Кандидаты.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			СуммаГруппы = 0;
			Дебет1 = 0;
			Кредит1 = 0;
			Для Каждого Индекс1 Из Кандидаты Цикл
				СуммаГруппы = СуммаГруппы + Данные1[Индекс1].Сумма;
				Дебет1 = Дебет1 + Данные1[Индекс1].Дебет;
				Кредит1 = Кредит1 + Данные1[Индекс1].Кредит;
			КонецЦикла;
			Если ЧислоАбс(Запись2.Сумма - СуммаГруппы) > 0.05 Тогда
				Продолжить;
			КонецЕсли;
			Сопоставлено2.Вставить(Индекс2, Истина);
			Для Каждого Индекс1 Из Кандидаты Цикл
				Сопоставлено1.Вставить(Индекс1, Истина);
			КонецЦикла;
			Запись = НоваяЗаписьРезультата(Неопределено, Запись2, "match", Кандидаты.Количество() + ":1",
				Кандидаты.Количество() + " записей = 1 у поставщика");
			Запись.СуммаНаша = СуммаГруппы;
			Запись.ДебетНаш = Дебет1;
			Запись.КредитНаш = Кредит1;
			Запись.Разница = 0;
			Результаты.Добавить(Запись);
		КонецЦикла;
	КонецЕсли;

	// Расхождения: тот же документ, но разная сумма
	Для Индекс1 = 0 По Данные1.Количество() - 1 Цикл
		Если Сопоставлено1.Получить(Индекс1) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись1 = Данные1[Индекс1];
		Если Запись1.Номера.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Индекс2 Из КандидатыПоНомерам(Запись1, ИндексДанных2) Цикл
			Если Сопоставлено2.Получить(Индекс2) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись2 = Данные2[Индекс2];
			Если Запись2.Номера.Количество() = 0 Или Не НомераСовпадают(Запись1.Номера, Запись2.Номера) Тогда
				Продолжить;
			КонецЕсли;
			Если МетодСверки = "doc_sum" Или МетодСверки = "sum_only" Тогда
				ДатаПодходит = Истина;
			Иначе
				ДатаПодходит = ДатаДляСравнения(Запись1) = ДатаДляСравнения(Запись2) Или ДатаДляСравнения(Запись1) = "" Или ДатаДляСравнения(Запись2) = "";
			КонецЕсли;
			Если ДатаПодходит Тогда
				Сопоставлено1.Вставить(Индекс1, Истина);
				Сопоставлено2.Вставить(Индекс2, Истина);
				Результаты.Добавить(НоваяЗаписьРезультата(Запись1, Запись2, "mismatch", "Д+Н+С", ""));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Только у одной из сторон
	Для Индекс1 = 0 По Данные1.Количество() - 1 Цикл
		Если Сопоставлено1.Получить(Индекс1) = Неопределено Тогда
			Результаты.Добавить(НоваяЗаписьРезультата(Данные1[Индекс1], Неопределено, "only1", "", ""));
		КонецЕсли;
	КонецЦикла;
	Для Индекс2 = 0 По Данные2.Количество() - 1 Цикл
		Если Сопоставлено2.Получить(Индекс2) = Неопределено Тогда
			Результаты.Добавить(НоваяЗаписьРезультата(Неопределено, Данные2[Индекс2], "only2", "", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат Результаты;

КонецФункции

// «Эффективная» дата для сравнения: дата из текста документа, иначе дата из колонки.
&НаКлиенте
Функция ДатаДляСравнения(Запись)

	Возврат ?(Запись.ДатаДока <> "", Запись.ДатаДока, Запись.Дата);

КонецФункции

// Ссылка на документ 1С из 5-го элемента строки данных (есть только у акта, сформированного из документа сверки).
&НаКлиенте
Функция СсылкаНаДокументИзСтроки(СтрокаДанных)

	Если СтрокаДанных.Количество() < 5 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = СтрокаДанных[4];
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число")
		Или ТипЗнч(Значение) = Тип("Дата") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Двойной щелчок по строке результата открывает документ 1С (поступление, платёж…), если он есть.
&НаКлиенте
Процедура РезультатВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Результат.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Ссылка = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьПредупреждение(, "У этой строки нет документа в 1С: она есть только в акте поставщика, либо наш акт загружен из файла, а не сформирован из документа сверки.");
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.Ссылка);

КонецПроцедуры

&НаКлиенте
Функция НоваяЗаписьРезультата(Запись1, Запись2, Код, Метод_, Примечание)

	Результат_ = Новый Структура;
	Результат_.Вставить("Код", Код);
	Результат_.Вставить("Метод", Метод_);
	Результат_.Вставить("Примечание", Примечание);
	Результат_.Вставить("Дата", "");
	Результат_.Вставить("Документ", "");
	Результат_.Вставить("СуммаНаша", 0);
	Результат_.Вставить("ДебетНаш", 0);
	Результат_.Вставить("КредитНаш", 0);
	Результат_.Вставить("СуммаПост", 0);
	Результат_.Вставить("ДебетПост", 0);
	Результат_.Вставить("КредитПост", 0);
	Результат_.Вставить("Разница", 0);
	Результат_.Вставить("Ссылка", Неопределено);
	Если Запись1 <> Неопределено Тогда
		Если Запись1.Свойство("Ссылка") Тогда
			Результат_.Ссылка = Запись1.Ссылка;
		КонецЕсли;
		Результат_.Дата = Запись1.Дата;
		Результат_.Документ = Запись1.ДокСырой;
		Результат_.СуммаНаша = Запись1.Сумма;
		Результат_.ДебетНаш = Запись1.Дебет;
		Результат_.КредитНаш = Запись1.Кредит;
	КонецЕсли;
	Если Запись2 <> Неопределено Тогда
		Если Запись1 = Неопределено Тогда
			Результат_.Дата = Запись2.Дата;
			Результат_.Документ = Запись2.ДокСырой;
		КонецЕсли;
		Результат_.СуммаПост = Запись2.Сумма;
		Результат_.ДебетПост = Запись2.Дебет;
		Результат_.КредитПост = Запись2.Кредит;
	КонецЕсли;
	Результат_.Разница = Результат_.СуммаНаша - Результат_.СуммаПост;
	Возврат Результат_;

КонецФункции

#КонецОбласти

#Область ЗапускСверки

&НаКлиенте
Процедура Сверить(Команда)

	Если ДанныеФайла2 = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите файл акта поставщика.");
		Возврат;
	КонецЕсли;
	Если ИсточникНаш = "Из документа сверки" Тогда
		// Наш акт всегда формируется заново по текущему содержимому документа
		Если Не СформироватьНашАктИзДокумента() Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли ДанныеФайла1 = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите файл нашего акта сверки или переключите источник на «Из документа сверки».");
		Возврат;
	КонецЕсли;
	Колонки = Новый Соответствие;
	Колонки.Вставить("Дата нашего акта", КолДата1);
	Колонки.Вставить("Документ нашего акта", КолДок1);
	Колонки.Вставить("Дебет нашего акта", КолДебет1);
	Колонки.Вставить("Кредит нашего акта", КолКредит1);
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.Значение < 1 Тогда
			ПоказатьПредупреждение(, "Не определена колонка: " + Колонка.Ключ + ". Укажите номер колонки в настройках файла.");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Колонки = Новый Соответствие;
	Колонки.Вставить("Дата акта поставщика", КолДата2);
	Колонки.Вставить("Документ акта поставщика", КолДок2);
	Колонки.Вставить("Дебет акта поставщика", КолДебет2);
	Колонки.Вставить("Кредит акта поставщика", КолКредит2);
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.Значение < 1 Тогда
			ПоказатьПредупреждение(, "Не определена колонка: " + Колонка.Ключ + ". Укажите номер колонки в настройках файла.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	МетодСверки = "date_doc_sum";
	Если Метод = "Номер + Сумма" Тогда
		МетодСверки = "doc_sum";
	ИначеЕсли Метод = "Дата + Сумма" Тогда
		МетодСверки = "date_sum";
	ИначеЕсли Метод = "Только сумма" Тогда
		МетодСверки = "sum_only";
	КонецЕсли;

	Состояние("Разбор актов...");
	Сальдо1 = РазобратьСальдо(ДанныеФайла1, 1, КолДебет1, КолКредит1);
	Сальдо2 = РазобратьСальдо(ДанныеФайла2, 2, КолДебет2, КолКредит2);
	Операции1 = РазобратьОперации(ДанныеФайла1, 1, ПерваяСтрока1, КолДата1, КолДок1, КолДебет1, КолКредит1);
	Операции2 = РазобратьОперации(ДанныеФайла2, 2, ПерваяСтрока2, КолДата2, КолДок2, КолДебет2, КолКредит2);
	Если Операции1.Количество() = 0 Или Операции2.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "В одном из актов не найдено ни одной операции (наш: " + Операции1.Количество() + ", поставщика: " + Операции2.Количество()
			+ "). Проверьте номер первой строки данных и колонки.");
		Возврат;
	КонецЕсли;

	Состояние("Сопоставление документов...");
	ПоследниеРезультаты = СравнитьОперации(Операции1, Операции2, МетодСверки);
	ЗаполнитьРезультат(ПоследниеРезультаты);
	ПоказатьСальдо(Сальдо1, Сальдо2, Операции1, Операции2);
	// Результат важнее настроек: прячем выбор файлов, чтобы таблица заняла больше места
	УстановитьВидимостьНастроек(Ложь);
	Элементы.КомментарийРасчет.Видимость = Не ПустаяСтрока(КомментарийРасчет);
	Состояние("Готово.");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРезультат(Записи)

	Результат.Очистить();
	Совпадают = 0;
	Расхождения = 0;
	ТолькоНаши = 0;
	ТолькоПоставщика = 0;
	Для Каждого Запись Из Записи Цикл
		Строка_ = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(Строка_, Запись);
		Если Запись.Код = "match" Тогда
			Строка_.Статус = "✔ Совпадает";
			Совпадают = Совпадают + 1;
		ИначеЕсли Запись.Код = "mismatch" Тогда
			Строка_.Статус = "✖ Расхождение";
			Расхождения = Расхождения + 1;
		ИначеЕсли Запись.Код = "only1" Тогда
			Строка_.Статус = "⚠ Только у нас";
			ТолькоНаши = ТолькоНаши + 1;
		Иначе
			Строка_.Статус = "⚠ Только у поставщика";
			ТолькоПоставщика = ТолькоПоставщика + 1;
		КонецЕсли;
	КонецЦикла;
	// Сортировка по дате и документу (таблица значений на клиенте недоступна — сортируем коллекцию формы)
	Результат.Сортировать("Дата, Документ");
	Статистика = "Совпадают: " + Совпадают + "   |   Расхождения: " + Расхождения + "   |   Только у нас: " + ТолькоНаши
		+ "   |   Только у поставщика: " + ТолькоПоставщика;
	ФильтрСтатуса = "Все";
	ОбновитьОтборРезультата();

КонецПроцедуры

&НаКлиенте
Процедура ФильтрСтатусаПриИзменении(Элемент)

	ОбновитьОтборРезультата();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборРезультата()

	Код = "";
	Если ФильтрСтатуса = "Совпадают" Тогда
		Код = "match";
	ИначеЕсли ФильтрСтатуса = "Расхождения" Тогда
		Код = "mismatch";
	ИначеЕсли ФильтрСтатуса = "Только у нас" Тогда
		Код = "only1";
	ИначеЕсли ФильтрСтатуса = "Только у поставщика" Тогда
		Код = "only2";
	КонецЕсли;
	Если Код = "" Тогда
		Элементы.Результат.ОтборСтрок = Неопределено;
	Иначе
		Элементы.Результат.ОтборСтрок = Новый ФиксированнаяСтруктура("Код", Код);
	КонецЕсли;

КонецПроцедуры

// Сальдо начальное и конечное, разница, вердикт.
&НаКлиенте
Функция ОткудаСальдо(Сальдо)

	Если Сальдо.Конечное = Неопределено Тогда
		Возврат "конечное сальдо в файле не найдено";
	КонецЕсли;
	Возврат "конечное сальдо в строке " + Сальдо.Конечное.НомерСтроки + " (дт " + Сальдо.Конечное.СыройДебет + ", кт " + Сальдо.Конечное.СыройКредит + ")";

КонецФункции

&НаКлиенте
Процедура ПоказатьСальдо(Сальдо1, Сальдо2, Операции1, Операции2)

	НачНаше = 0;
	НачПост = 0;
	Если Сальдо1.Начальное <> Неопределено Тогда
		НачНаше = Сальдо1.Начальное.Сальдо;
	КонецЕсли;
	Если Сальдо2.Начальное <> Неопределено Тогда
		НачПост = Сальдо2.Начальное.Сальдо;
	КонецЕсли;

	// Конечное сальдо: из файла, а если не найдено — расчётное (начальное + дебет − кредит по операциям)
	Дебет1 = 0;
	Кредит1 = 0;
	Для Каждого Операция Из Операции1 Цикл
		Дебет1 = Дебет1 + Операция.Дебет;
		Кредит1 = Кредит1 + Операция.Кредит;
	КонецЦикла;
	Дебет2 = 0;
	Кредит2 = 0;
	Для Каждого Операция Из Операции2 Цикл
		Дебет2 = Дебет2 + Операция.Дебет;
		Кредит2 = Кредит2 + Операция.Кредит;
	КонецЦикла;
	КонРасчетное1 = Ложь;
	КонРасчетное2 = Ложь;
	Если Сальдо1.Конечное <> Неопределено Тогда
		КонНаше = Сальдо1.Конечное.Сальдо;
	Иначе
		КонНаше = НачНаше + Дебет1 - Кредит1;
		КонРасчетное1 = Истина;
	КонецЕсли;
	Если Сальдо2.Конечное <> Неопределено Тогда
		КонПост = Сальдо2.Конечное.Сальдо;
	Иначе
		КонПост = НачПост + Дебет2 - Кредит2;
		КонРасчетное2 = Истина;
	КонецЕсли;

	// Сальдо зеркальное: сравниваем по модулю — реальная задолженность одна и та же
	РазницаНачало = ЧислоАбс(НачПост) - ЧислоАбс(НачНаше);
	РазницаКонец = ЧислоАбс(КонПост) - ЧислоАбс(КонНаше);
	НачалоСовпало = ЧислоАбс(РазницаНачало) < 0.015;
	КонецСовпал = ЧислоАбс(РазницаКонец) < 0.015;

	СальдоНачНаше = ДеньгиТекст(ЧислоАбс(НачНаше));
	СальдоНачПост = ДеньгиТекст(ЧислоАбс(НачПост));
	СальдоКонНаше = ДеньгиТекст(ЧислоАбс(КонНаше)) + ?(КонРасчетное1, " *", "");
	СальдоКонПост = ДеньгиТекст(ЧислоАбс(КонПост)) + ?(КонРасчетное2, " *", "");
	СальдоНачРазн = ?(НачалоСовпало, "0,00  ✔ Совпадает", ДеньгиТекст(ЧислоАбс(РазницаНачало)) + "  ✖ Расхождение!");
	СальдоКонРазн = ?(КонецСовпал, "0,00  ✔ Совпадает", ДеньгиТекст(ЧислоАбс(РазницаКонец)) + "  ✖ Расхождение!");

	КомментарийНач = "Начальное сальдо: " + ТекстЗадолженности(НачНаше, НачалоСовпало, ЧислоАбс(РазницаНачало));
	КомментарийКон = "Конечное сальдо: " + ТекстЗадолженности(КонНаше, КонецСовпал, ЧислоАбс(РазницаКонец));
	КомментарийКон = КомментарийКон + " [наш акт: " + ОткудаСальдо(Сальдо1) + "; акт поставщика: " + ОткудаСальдо(Сальдо2) + "]";
	КомментарийРасчет = ?(КонРасчетное1 Или КонРасчетное2, "* — конечное сальдо не найдено в файле, рассчитано: начальное + обороты по данным.", "");

	Если НачалоСовпало И КонецСовпал Тогда
		Вердикт = "✔ Акты сверки сходятся: начальное и конечное сальдо совпадают у обеих сторон.";
	Иначе
		Текст = "⚠ Обнаружены расхождения в сальдо! ";
		Если Не НачалоСовпало Тогда
			Текст = Текст + "Начальное сальдо не совпадает. ";
		КонецЕсли;
		Если Не КонецСовпал Тогда
			Текст = Текст + "Конечное сальдо не совпадает. ";
		КонецЕсли;
		Вердикт = Текст + "Проверьте выделенные строки ниже.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ТекстЗадолженности(Сальдо, Совпало, АбсРазница)

	Если ЧислоАбс(Сальдо) < 0.01 Тогда
		Возврат ?(Совпало, "задолженности нет", "расхождение " + ДеньгиТекст(АбсРазница));
	КонецЕсли;
	Сторона = ?(Сальдо < 0, "в пользу покупателя", "в пользу поставщика");
	Если Совпало Тогда
		Возврат "задолженность " + Сторона + " " + ДеньгиТекст(ЧислоАбс(Сальдо));
	КонецЕсли;
	Возврат "задолженность " + Сторона + ". Расхождение в суммах: " + ДеньгиТекст(АбсРазница);

КонецФункции

&НаКлиенте
Функция ДеньгиТекст(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧН=0,00");

КонецФункции

#КонецОбласти

#Область Выгрузка

&НаКлиенте
Процедура СохранитьВExcel(Команда)

	Если Результат.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет данных для выгрузки: сначала выполните сверку.");
		Возврат;
	КонецЕсли;
	Шапка = Новый Массив;
	Шапка.Добавить("Сверка актов с поставщиком");
	Шапка.Добавить(Статистика);
	Шапка.Добавить("Сальдо начальное: у нас " + СальдоНачНаше + ", у поставщика " + СальдоНачПост + ", разница " + СальдоНачРазн + ". " + КомментарийНач);
	Шапка.Добавить("Сальдо конечное: у нас " + СальдоКонНаше + ", у поставщика " + СальдоКонПост + ", разница " + СальдоКонРазн + ". " + КомментарийКон);
	Шапка.Добавить(Вердикт);

	Строки = Новый Массив;
	Для Каждого СтрокаРезультата Из Результат Цикл
		Значения = Новый Массив;
		Значения.Добавить(СтрокаРезультата.Дата);
		Значения.Добавить(СтрокаРезультата.Документ);
		Значения.Добавить(СтрокаРезультата.СуммаНаша);
		Значения.Добавить(СтрокаРезультата.ДебетНаш);
		Значения.Добавить(СтрокаРезультата.КредитНаш);
		Значения.Добавить(СтрокаРезультата.СуммаПост);
		Значения.Добавить(СтрокаРезультата.ДебетПост);
		Значения.Добавить(СтрокаРезультата.КредитПост);
		Значения.Добавить(СтрокаРезультата.Разница);
		Значения.Добавить(СтрокаРезультата.Статус);
		Значения.Добавить(СтрокаРезультата.Метод);
		Значения.Добавить(СтрокаРезультата.Примечание);
		Строки.Добавить(Значения);
	КонецЦикла;
	Попытка
		Адрес = СформироватьExcelНаСервере(Шапка, Строки);
		// Диалог сохранения на компьютере пользователя
		ПолучитьФайл(Адрес, "Результаты_сверки_актов.xlsx", Истина);
	Исключение
		ПоказатьПредупреждение(, "Не удалось сохранить файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Формирует xlsx с итогами и таблицей результата; возвращает адрес двоичных данных во временном хранилище.
&НаСервере
Функция СформироватьExcelНаСервере(Шапка, Строки)

	ТабДок = Новый ТабличныйДокумент;
	НомерСтроки = 1;
	Для Каждого Текст Из Шапка Цикл
		ТабДок.Область(НомерСтроки, 1).Текст = Текст;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;
	Заголовки = СтрРазделить("Дата;Документ;Сумма у нас;Дебет у нас;Кредит у нас;Сумма у поставщика;Дебет у поставщика;Кредит у поставщика;Разница;Статус;Метод;Примечание", ";");
	Для Колонка = 0 По Заголовки.ВГраница() Цикл
		Ячейка = ТабДок.Область(НомерСтроки, Колонка + 1);
		Ячейка.Текст = Заголовки[Колонка];
		Ячейка.Шрифт = Новый Шрифт(, , , Истина);
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;
	Для Каждого Значения Из Строки Цикл
		Для Колонка = 0 По Значения.ВГраница() Цикл
			Ячейка = ТабДок.Область(НомерСтроки, Колонка + 1);
			Если ТипЗнч(Значения[Колонка]) = Тип("Число") Тогда
				Ячейка.Значение = Значения[Колонка];
				Ячейка.Текст = Формат(Значения[Колонка], "ЧДЦ=2; ЧРД=,");
			Иначе
				Ячейка.Текст = Значения[Колонка];
			КонецЕсли;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	ВременныйФайл = ПолучитьИмяВременногоФайла(".xlsx");
	ТабДок.Записать(ВременныйФайл, ТипФайлаТабличногоДокумента.XLSX);
	Двоичные = Новый ДвоичныеДанные(ВременныйФайл);
	УдалитьФайлы(ВременныйФайл);
	Возврат ПоместитьВоВременноеХранилище(Двоичные, УникальныйИдентификатор);

КонецФункции

#КонецОбласти
