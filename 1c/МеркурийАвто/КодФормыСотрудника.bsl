// Модуль формы "ФормаСотрудника" внешней обработки МеркурийАвто.
// Форма пустая: все поля, кнопки и таблица создаются кодом при открытии, рисовать ничего не нужно.
// Вставьте этот текст целиком в модуль новой формы (заменив все, что там есть).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипКол = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ТипВСД = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6, 0));
	ТипПриход = Новый ОписаниеТипов("ДокументСсылка.ПриобретениеТоваровУслуг");
	ТипОперация = Новый ОписаниеТипов("ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС");
	ТипСсылкаВСД = Новый ОписаниеТипов("СправочникСсылка.ВетеринарноСопроводительныйДокументВЕТИС");

	// Реквизиты формы
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаС", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), , "С даты"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаПо", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), , "По дату"));
	Реквизиты.Добавить(Новый РеквизитФормы("Итог", ТипСтрока, , "Итог"));
	Реквизиты.Добавить(Новый РеквизитФормы("Накладные", Новый ОписаниеТипов("ТаблицаЗначений"), , "Накладные"));

	Колонки = Новый Массив;
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Выбрать", "Оформить", Новый ОписаниеТипов("Булево")));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Ключ", "Ключ", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Статус", "Статус", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ВидОшибки", "Вид ошибки", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Подробности", "Подробности", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Накладная", "Накладная", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Отправитель", "Отправитель", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Получатель", "Получатель", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ВСД", "ВСД, шт.", ТипВСД));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "КолВСД", "Кол-во по ВСД", ТипКол));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Приход", "Поступление", ТипПриход));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "КолПриход", "Кол-во в поступлении", ТипКол));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Операция", "Операция ВетИС", ТипОперация));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ПервыйВСД", "ВСД накладной", ТипСсылкаВСД));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Результат", "Результат", ТипСтрока));
	Для Каждого Колонка Из Колонки Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.Тип, "Накладные", Колонка.Заголовок));
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);

	// Значения по умолчанию
	ЭтаФорма.ДатаС = НачалоДня(ТекущаяДатаСеанса()) - 14 * 86400;
	// "По дату" пусто = без верхней границы (до сегодняшнего дня)
	НайденнаяОрганизация = Справочники.Организации.НайтиПоНаименованию("Кубаньторг ООО", Истина);
	Если Не НайденнаяОрганизация.Пустая() Тогда
		ЭтаФорма.Организация = НайденнаяОрганизация;
	КонецЕсли;
	ЭтаФорма.Итог = "Нажмите ""Проверить"": покажу накладные, которые можно оформить сами, и те, что нужно оформить вручную.";

	// Элементы формы
	Заголовок = "Оформление и гашение ВСД (Меркурий)";
	ЭтаФорма.Заголовок = Заголовок;

	Поле = Элементы.Добавить("ПолеОрганизация", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Организация";

	Поле = Элементы.Добавить("ПолеДатаС", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ДатаС";

	Поле = Элементы.Добавить("ПолеДатаПо", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ДатаПо";

	Команда = Команды.Добавить("Проверить");
	Команда.Заголовок = "Проверить";
	Команда.Подсказка = "Только посмотреть: ничего не оформляется и не отправляется";
	Команда.Действие = "КомандаПроверить";
	Кнопка = Элементы.Добавить("КнопкаПроверить", Тип("КнопкаФормы"));
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = "Проверить";

	Команда = Команды.Добавить("ВыделитьВсе");
	Команда.Заголовок = "Выделить все (Готово)";
	Команда.Подсказка = "Отметить все накладные со статусом Готово";
	Команда.Действие = "КомандаВыделитьВсе";
	Кнопка = Элементы.Добавить("КнопкаВыделитьВсе", Тип("КнопкаФормы"));
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = "ВыделитьВсе";

	Команда = Команды.Добавить("СнятьВыделение");
	Команда.Заголовок = "Снять выделение";
	Команда.Действие = "КомандаСнятьВыделение";
	Кнопка = Элементы.Добавить("КнопкаСнятьВыделение", Тип("КнопкаФормы"));
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = "СнятьВыделение";

	Команда = Команды.Добавить("Оформить");
	Команда.Заголовок = "Оформить и отправить выбранные";
	Команда.Подсказка = "Оформить отмеченные накладные со статусом Готово и передать на гашение в Меркурий";
	Команда.Действие = "КомандаОформить";
	Кнопка = Элементы.Добавить("КнопкаОформить", Тип("КнопкаФормы"));
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = "Оформить";

	Поле = Элементы.Добавить("ПолеИтог", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеНадписи;
	Поле.ПутьКДанным = "Итог";

	Таблица = Элементы.Добавить("ТаблицаНакладные", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Накладные";
	Таблица.ТолькоПросмотр = Ложь;
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.УстановитьДействие("Выбор", "НакладныеВыбор");
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.Имя = "Ключ" Тогда
			Продолжить;
		КонецЕсли;
		Столбец = Элементы.Добавить("Накладные" + Колонка.Имя, Тип("ПолеФормы"), Таблица);
		Если Колонка.Имя = "Выбрать" Тогда
			Столбец.Вид = ВидПоляФормы.ПолеФлажка;
		Иначе
			Столбец.Вид = ВидПоляФормы.ПолеВвода;
			Столбец.ТолькоПросмотр = Истина;
		КонецЕсли;
		Столбец.ПутьКДанным = "Накладные." + Колонка.Имя;
	КонецЦикла;

	// Цветовая подсказка по статусам (если не получится - таблица все равно работает)
	Попытка
		ДобавитьЦвет("Накладные.Статус", "Готово", Новый Цвет(214, 240, 214));
		ДобавитьЦвет("Накладные.Статус", "Расхождение", Новый Цвет(255, 242, 204));
		ДобавитьЦвет("Накладные.Статус", "Нет прихода", Новый Цвет(235, 235, 235));
		ДобавитьЦвет("Накладные.Результат", "ОШИБКА", Новый Цвет(255, 205, 205));
		БлокироватьФлажок();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура БлокироватьФлажок()
	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("НакладныеВыбрать");
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Накладные.Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	Отбор.ПравоеЗначение = "Готово";
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
КонецПроцедуры

&НаСервере
Процедура ДобавитьЦвет(ИмяПоля, Значение, Цвет)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
КонецПроцедуры

// Двойной щелчок по строке: открывает документ. Колонка "Операция ВетИС" - операцию,
// "Поступление" - приход, остальные колонки - первый ВСД накладной (в нем видны данные ТТН).
&НаКлиенте
Процедура НакладныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = ЭтаФорма.Накладные.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяКолонки = Поле.Имя;
	Если ИмяКолонки = "НакладныеОперация" И ЗначениеЗаполнено(Данные.Операция) Тогда
		ПоказатьЗначение(, Данные.Операция);
	ИначеЕсли ИмяКолонки = "НакладныеПриход" И ЗначениеЗаполнено(Данные.Приход) Тогда
		ПоказатьЗначение(, Данные.Приход);
	ИначеЕсли ЗначениеЗаполнено(Данные.ПервыйВСД) Тогда
		ПоказатьЗначение(, Данные.ПервыйВСД);
	Иначе
		ПоказатьПредупреждение(, "Для этой строки нет документа, который можно открыть.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПериодКорректен()
	Если ЗначениеЗаполнено(ЭтаФорма.ДатаПо) И ЗначениеЗаполнено(ЭтаФорма.ДатаС) И ЭтаФорма.ДатаПо < ЭтаФорма.ДатаС Тогда
		ПоказатьПредупреждение(, "Дата ""по"" не может быть раньше даты ""с"".");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура КомандаПроверить(Команда)
	Если Не ПериодКорректен() Тогда
		Возврат;
	КонецЕсли;
	Состояние("Проверяю накладные...");
	ВыполнитьНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьВсе(Команда)
	Для Каждого Стр Из ЭтаФорма.Накладные Цикл
		Стр.Выбрать = (Стр.Статус = "Готово");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВыделение(Команда)
	Для Каждого Стр Из ЭтаФорма.Накладные Цикл
		Стр.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОформить(Команда)
	Если Не ПериодКорректен() Тогда
		Возврат;
	КонецЕсли;
	Ключи = Новый Массив;
	Пропущено = 0;
	Для Каждого Стр Из ЭтаФорма.Накладные Цикл
		Если Не Стр.Выбрать Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.Статус = "Готово" Тогда
			Ключи.Добавить(Стр.Ключ);
		Иначе
			Пропущено = Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте накладные со статусом ""Готово"" (или нажмите ""Выделить все"").");
		Возврат;
	КонецЕсли;
	Текст = "Будет оформлено и передано на гашение накладных: " + Ключи.Количество() + "."
		+ ?(Пропущено > 0, " Отмеченные со статусом не ""Готово"" (" + Пропущено + ") будут пропущены.", "")
		+ " Передача данных в Меркурий необратима. Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("КомандаОформитьЗавершение", ЭтаФорма, Ключи), Текст,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Подтверждение");
КонецПроцедуры

&НаКлиенте
Процедура КомандаОформитьЗавершение(Ответ, Ключи) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Состояние("Оформляю накладные, это может занять несколько минут...");
		ВыполнитьНаСервере(Истина, Ключи);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(Боевой, Ключи = Неопределено)

	Обработка = РеквизитФормыВЗначение("Объект");
	Если Боевой Тогда
		Таблица = Обработка.ТаблицаОформления(ЭтаФорма.ДатаС, ЭтаФорма.Организация, , ЭтаФорма.ДатаПо, Ключи);
	Иначе
		Таблица = Обработка.ТаблицаПроверки(ЭтаФорма.ДатаС, ЭтаФорма.Организация, ЭтаФорма.ДатаПо);
	КонецЕсли;

	ЭтаФорма.Накладные.Очистить();
	Готово = 0;
	Расхождение = 0;
	НетПрихода = 0;
	Оформлено = 0;
	Ошибок = 0;
	Для Каждого Стр Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(ЭтаФорма.Накладные.Добавить(), Стр);
		Если Стр.Статус = "Готово" Тогда
			Готово = Готово + 1;
		ИначеЕсли Стр.Статус = "Расхождение" Тогда
			Расхождение = Расхождение + 1;
		Иначе
			НетПрихода = НетПрихода + 1;
		КонецЕсли;
		Если СтрНачинаетсяС(Стр.Результат, "Оформлено") Тогда
			Оформлено = Оформлено + 1;
		ИначеЕсли Стр.Результат = "ОШИБКА" Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	Итог = "Накладных: " + Таблица.Количество() + ". Готово к оформлению: " + Готово
		+ "; расхождение (вручную): " + Расхождение + "; нет прихода (вручную): " + НетПрихода;
	Если Боевой Тогда
		Итог = Итог + ". ОФОРМЛЕНО СЕЙЧАС: " + Оформлено + "; ошибок: " + Ошибок;
	КонецЕсли;
	ЭтаФорма.Итог = Итог;

КонецПроцедуры
