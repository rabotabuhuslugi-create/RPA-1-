// Модуль формы "ФормаСотрудника" внешней обработки МеркурийАвто.
// Форма пустая: все поля, кнопки, вкладки и таблицы создаются кодом при открытии, рисовать ничего не нужно.
// Вставьте этот текст целиком в модуль формы (заменив все, что там есть).
// Событие ПриСозданииНаСервере уже привязано в свойствах формы (если форма новая - привяжите: Свойства формы -> События).
//
// Вкладки:
//   "Оформление"  - накладные со статусом Готово: отметить и оформить/отправить.
//   "Расхождения" - накладные, которые оформляются вручную: расхождение по товарам ВетИС, не определено, не принято,
//                   нет прихода. Из строки можно открыть оформление операции (как кнопка "Оформить" в списке
//                   "К оформлению"), где вручную вносятся отклонения и акт, и посмотреть строки отклонений.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипКол = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ТипВСД = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6, 0));
	ТипПриход = Новый ОписаниеТипов("ДокументСсылка.ПриобретениеТоваровУслуг");
	ТипОперация = Новый ОписаниеТипов("ДокументСсылка.ВходящаяТранспортнаяОперацияВЕТИС");
	ТипСсылкаВСД = Новый ОписаниеТипов("СправочникСсылка.ВетеринарноСопроводительныйДокументВЕТИС");
	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));

	Колонки = Новый Массив;
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Выбрать", "Оформить", Новый ОписаниеТипов("Булево")));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Ключ", "Ключ", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Статус", "Статус", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ВидОшибки", "Вид ошибки", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Подробности", "Подробности", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Накладная", "Накладная", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Номер", "Номер накладной", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ДатаНакладной", "Дата", ТипДата));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Хранение", "Хранение", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Отправитель", "Отправитель", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Получатель", "Получатель", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ВСД", "ВСД, шт.", ТипВСД));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "КолВСД", "Кол-во по ВСД", ТипКол));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Приход", "Поступление", ТипПриход));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "КолПриход", "Кол-во в поступлении", ТипКол));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Операция", "Операция ВетИС", ТипОперация));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "ПервыйВСД", "ВСД накладной", ТипСсылкаВСД));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Отклонения", "Строки с отклонением", ТипСтрока));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Тип", "Результат", "Результат", ТипСтрока));

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаС", ТипДата, , "С даты"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаПо", ТипДата, , "По дату"));
	Реквизиты.Добавить(Новый РеквизитФормы("Итог", ТипСтрока, , "Итог"));
	Реквизиты.Добавить(Новый РеквизитФормы("Накладные", Новый ОписаниеТипов("ТаблицаЗначений"), , "Накладные"));
	Реквизиты.Добавить(Новый РеквизитФормы("Расхождения", Новый ОписаниеТипов("ТаблицаЗначений"), , "Расхождения"));
	Для Каждого Колонка Из Колонки Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.Тип, "Накладные", Колонка.Заголовок));
		Если Колонка.Имя <> "Выбрать" Тогда
			Реквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.Тип, "Расхождения", Колонка.Заголовок));
		КонецЕсли;
	КонецЦикла;
	ИзменитьРеквизиты(Реквизиты);

	ЭтаФорма.ДатаС = НачалоДня(ТекущаяДатаСеанса()) - 14 * 86400;
	НайденнаяОрганизация = Справочники.Организации.НайтиПоНаименованию("Кубаньторг ООО", Истина);
	Если Не НайденнаяОрганизация.Пустая() Тогда
		ЭтаФорма.Организация = НайденнаяОрганизация;
	КонецЕсли;
	ЭтаФорма.Итог = "Нажмите ""Проверить"": покажу накладные, которые можно оформить сами (вкладка ""Оформление""), и те, что нужно оформить вручную (вкладка ""Расхождения"").";
	ЭтаФорма.Заголовок = "Оформление и гашение ВСД (Меркурий)";

	Поле = Элементы.Добавить("ПолеОрганизация", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Организация";
	Поле = Элементы.Добавить("ПолеДатаС", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ДатаС";
	Поле = Элементы.Добавить("ПолеДатаПо", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "ДатаПо";

	ДобавитьКнопку("Проверить", "Проверить", "КомандаПроверить", "Только посмотреть: ничего не оформляется и не отправляется", Неопределено);

	Поле = Элементы.Добавить("ПолеИтог", Тип("ПолеФормы"));
	Поле.Вид = ВидПоляФормы.ПолеНадписи;
	Поле.ПутьКДанным = "Итог";

	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"));
	Страницы.Вид = ВидГруппыФормы.Страницы;
	СтраницаОформление = Элементы.Добавить("СтраницаОформление", Тип("ГруппаФормы"), Страницы);
	СтраницаОформление.Вид = ВидГруппыФормы.Страница;
	СтраницаОформление.Заголовок = "Оформление";
	СтраницаРасхождения = Элементы.Добавить("СтраницаРасхождения", Тип("ГруппаФормы"), Страницы);
	СтраницаРасхождения.Вид = ВидГруппыФормы.Страница;
	СтраницаРасхождения.Заголовок = "Расхождения";

	// Вкладка "Оформление"
	ДобавитьКнопку("ВыделитьВсе", "Выделить все (Готово)", "КомандаВыделитьВсе", "Отметить все накладные", СтраницаОформление);
	ДобавитьКнопку("СнятьВыделение", "Снять выделение", "КомандаСнятьВыделение", "", СтраницаОформление);
	ДобавитьКнопку("Оформить", "Оформить и отправить выбранные",
		"КомандаОформить", "Оформить отмеченные накладные и передать на гашение в Меркурий", СтраницаОформление);
	ДобавитьТаблицу("ТаблицаНакладные", "Накладные", СтраницаОформление, Колонки, "НакладныеВыбор", Истина);

	// Вкладка "Расхождения"
	ДобавитьКнопку("ОткрытьОформление", "Оформить вручную (открыть операцию)", "КомандаОткрытьОформление",
		"Открыть новую операцию по ВСД выбранной накладной: там вносятся отклонения и акт", СтраницаРасхождения);
	ДобавитьКнопку("ПоказатьОтклонения", "Строки с отклонением", "КомандаПоказатьОтклонения",
		"Показать, какие строки прихода отличаются и относятся ли они к ВетИС", СтраницаРасхождения);
	ДобавитьТаблицу("ТаблицаРасхождения", "Расхождения", СтраницаРасхождения, Колонки, "РасхожденияВыбор", Ложь);

	Попытка
		Для Каждого Путь Из СтрРазделить("Накладные,Расхождения", ",") Цикл
			ДобавитьЦвет(Путь + ".Статус", "Готово", Новый Цвет(214, 240, 214));
			ДобавитьЦвет(Путь + ".Статус", "Расхождение", Новый Цвет(255, 242, 204));
			ДобавитьЦвет(Путь + ".Статус", "Не принято", Новый Цвет(220, 230, 245));
			ДобавитьЦвет(Путь + ".Статус", "Нет прихода", Новый Цвет(235, 235, 235));
			ДобавитьЦвет(Путь + ".Результат", "ОШИБКА", Новый Цвет(255, 205, 205));
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Действие, Подсказка, Родитель)
	Команда = Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Подсказка = Подсказка;
	Команда.Действие = Действие;
	Если Родитель = Неопределено Тогда
		Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"));
	Иначе
		Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"), Родитель);
	КонецЕсли;
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = Имя;
КонецПроцедуры

&НаСервере
Процедура ДобавитьТаблицу(ИмяЭлемента, Путь, Родитель, Колонки, Обработчик, ЕстьФлажок)
	Таблица = Элементы.Добавить(ИмяЭлемента, Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = Путь;
	Таблица.ТолькоПросмотр = Ложь;
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.УстановитьДействие("Выбор", Обработчик);
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.Имя = "Ключ" Или Колонка.Имя = "Отклонения" Или Колонка.Имя = "Накладная" Тогда
			Продолжить;
		КонецЕсли;
		Если Колонка.Имя = "ВидОшибки" И ЕстьФлажок Тогда
			Продолжить; // на вкладке "Оформление" вид ошибки всегда пустой
		КонецЕсли;
		Если Колонка.Имя = "Выбрать" И Не ЕстьФлажок Тогда
			Продолжить;
		КонецЕсли;
		Столбец = Элементы.Добавить(Путь + Колонка.Имя, Тип("ПолеФормы"), Таблица);
		Если Колонка.Имя = "Выбрать" Тогда
			Столбец.Вид = ВидПоляФормы.ПолеФлажка;
		Иначе
			Столбец.Вид = ВидПоляФормы.ПолеВвода;
			Столбец.ТолькоПросмотр = Истина;
		КонецЕсли;
		Столбец.ПутьКДанным = Путь + "." + Колонка.Имя;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДобавитьЦвет(ИмяПоля, Значение, Цвет)
	Элемент = УсловноеОформление.Элементы.Добавить();
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Значение;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
КонецПроцедуры

// ---------- Вкладка "Оформление": двойной щелчок открывает документ ----------
&НаКлиенте
Процедура НакладныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = ЭтаФорма.Накладные.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле.Имя = "НакладныеОперация" И ЗначениеЗаполнено(Данные.Операция) Тогда
		ПоказатьЗначение(, Данные.Операция);
	ИначеЕсли Поле.Имя = "НакладныеПриход" И ЗначениеЗаполнено(Данные.Приход) Тогда
		ПоказатьЗначение(, Данные.Приход);
	ИначеЕсли ЗначениеЗаполнено(Данные.ПервыйВСД) Тогда
		ПоказатьЗначение(, Данные.ПервыйВСД);
	Иначе
		ПоказатьПредупреждение(, "Для этой строки нет документа, который можно открыть.");
	КонецЕсли;
КонецПроцедуры

// ---------- Вкладка "Расхождения": колонка "Поступление" открывает приход, остальные - оформление операции ----------
&НаКлиенте
Процедура РасхожденияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = ЭтаФорма.Расхождения.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле.Имя = "РасхожденияПриход" И ЗначениеЗаполнено(Данные.Приход) Тогда
		ПоказатьЗначение(, Данные.Приход);
	ИначеЕсли Поле.Имя = "РасхожденияПервыйВСД" И ЗначениеЗаполнено(Данные.ПервыйВСД) Тогда
		ПоказатьЗначение(, Данные.ПервыйВСД);
	Иначе
		ОткрытьОформлениеПоКлючу(Данные.Ключ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьОформление(Команда)
	Данные = Элементы.ТаблицаРасхождения.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите накладную в таблице.");
		Возврат;
	КонецЕсли;
	ОткрытьОформлениеПоКлючу(Данные.Ключ);
КонецПроцедуры

// Открывает новую "Входящую транспортную операцию ВетИС" по ВСД накладной - так же, как кнопка "Оформить" в списке
// "К оформлению": документ заполняется по основанию (ВСД), в нем вручную вносятся отклонения и акт несоответствия.
&НаКлиенте
Процедура ОткрытьОформлениеПоКлючу(Ключ)
	МассивВСД = ВСДГруппыНаСервере(Ключ);
	Если МассивВСД.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "ВСД этой накладной уже оформлены или недоступны. Нажмите ""Проверить"" еще раз.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ.ВходящаяТранспортнаяОперацияВЕТИС.ФормаОбъекта", Новый Структура("Основание", МассивВСД), ЭтаФорма);
КонецПроцедуры

&НаСервере
Функция ВСДГруппыНаСервере(Ключ)
	Возврат РеквизитФормыВЗначение("Объект").ВСДГруппыПоКлючу(ЭтаФорма.ДатаС, ЭтаФорма.ДатаПо, Ключ);
КонецФункции

&НаКлиенте
Процедура КомандаПоказатьОтклонения(Команда)
	Данные = Элементы.ТаблицаРасхождения.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите накладную в таблице.");
		Возврат;
	КонецЕсли;
	Текст = Данные.Накладная + Символы.ПС + Данные.Статус + ": " + Данные.ВидОшибки + Символы.ПС + Данные.Подробности
		+ Символы.ПС + Символы.ПС;
	Если ЗначениеЗаполнено(Данные.Отклонения) Тогда
		Текст = Текст + "Строки поступления, где план не равен факту ([ВетИС] - товар ВетИС, [НеВетИС] - не относится к Меркурию, "
			+ "[Неизвестно] - не удалось определить, проверьте вручную):" + Символы.ПС + Данные.Отклонения;
	Иначе
		Текст = Текст + "Строк с отклонением для этой накладной нет (причина - в колонке ""Подробности"").";
	КонецЕсли;
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Текст);
	Документ.Показать("Отклонения по накладной");
КонецПроцедуры

// ---------- Проверка и оформление ----------
&НаКлиенте
Функция ПериодКорректен()
	Если ЗначениеЗаполнено(ЭтаФорма.ДатаПо) И ЗначениеЗаполнено(ЭтаФорма.ДатаС) И ЭтаФорма.ДатаПо < ЭтаФорма.ДатаС Тогда
		ПоказатьПредупреждение(, "Дата ""по"" не может быть раньше даты ""с"".");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура КомандаПроверить(Команда)
	Если Не ПериодКорректен() Тогда
		Возврат;
	КонецЕсли;
	Состояние("Проверяю накладные...");
	ВыполнитьНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьВсе(Команда)
	Для Каждого Стр Из ЭтаФорма.Накладные Цикл
		Стр.Выбрать = (Стр.Статус = "Готово");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВыделение(Команда)
	Для Каждого Стр Из ЭтаФорма.Накладные Цикл
		Стр.Выбрать = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОформить(Команда)
	Если Не ПериодКорректен() Тогда
		Возврат;
	КонецЕсли;
	Ключи = Новый Массив;
	Для Каждого Стр Из ЭтаФорма.Накладные Цикл
		Если Стр.Выбрать И Стр.Статус = "Готово" Тогда
			Ключи.Добавить(Стр.Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте накладные на вкладке ""Оформление"" (или нажмите ""Выделить все"").");
		Возврат;
	КонецЕсли;
	Текст = "Будет оформлено и передано на гашение накладных: " + Ключи.Количество() + "."
		+ " Передача данных в Меркурий необратима. Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("КомандаОформитьЗавершение", ЭтаФорма, Ключи), Текст,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Подтверждение");
КонецПроцедуры

&НаКлиенте
Процедура КомандаОформитьЗавершение(Ответ, Ключи) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Состояние("Оформляю накладные, это может занять несколько минут...");
		ВыполнитьНаСервере(Истина, Ключи);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(Боевой, Ключи = Неопределено)

	Обработка = РеквизитФормыВЗначение("Объект");
	Если Боевой Тогда
		Таблица = Обработка.ТаблицаОформления(ЭтаФорма.ДатаС, ЭтаФорма.Организация, , ЭтаФорма.ДатаПо, Ключи);
	Иначе
		Таблица = Обработка.ТаблицаПроверки(ЭтаФорма.ДатаС, ЭтаФорма.Организация, ЭтаФорма.ДатаПо);
	КонецЕсли;

	ЭтаФорма.Накладные.Очистить();
	ЭтаФорма.Расхождения.Очистить();
	Готово = 0;
	Расхождение = 0;
	НеПринято = 0;
	НетПрихода = 0;
	Оформлено = 0;
	Ошибок = 0;
	Для Каждого Стр Из Таблица Цикл
		Если Стр.Статус = "Готово" Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма.Накладные.Добавить(), Стр);
			Готово = Готово + 1;
		Иначе
			ЗаполнитьЗначенияСвойств(ЭтаФорма.Расхождения.Добавить(), Стр);
			Если Стр.Статус = "Расхождение" Тогда
				Расхождение = Расхождение + 1;
			ИначеЕсли Стр.Статус = "Не принято" Тогда
				НеПринято = НеПринято + 1;
			Иначе
				НетПрихода = НетПрихода + 1;
			КонецЕсли;
		КонецЕсли;
		Если СтрНачинаетсяС(Стр.Результат, "Оформлено") Тогда
			Оформлено = Оформлено + 1;
		ИначеЕсли Стр.Результат = "ОШИБКА" Тогда
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	Итог = "Накладных: " + Таблица.Количество() + ". Готово к оформлению: " + Готово
		+ "; расхождения (вручную): " + Расхождение + "; не принято: " + НеПринято + "; нет прихода: " + НетПрихода;
	Если Боевой Тогда
		Итог = Итог + ". ОФОРМЛЕНО СЕЙЧАС: " + Оформлено + "; ошибок: " + Ошибок;
	КонецЕсли;
	ЭтаФорма.Итог = Итог;
	Элементы.СтраницаОформление.Заголовок = "Оформление (" + Готово + ")";
	Элементы.СтраницаРасхождения.Заголовок = "Расхождения (" + (Расхождение + НеПринято + НетПрихода) + ")";

КонецПроцедуры
