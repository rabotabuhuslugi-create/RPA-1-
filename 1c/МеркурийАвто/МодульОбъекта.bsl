// Внешняя обработка "МеркурийАвто": оформление и гашение входящих ВСД (ВетИС/Меркурий).
// Вся логика - в этом модуле объекта, без форм: позже переносится в общий модуль расширения без изменений.
//
// Порядок работы:
//   1. Диагностика()          - выясняем реальные имена объектов вашей конфигурации (безопасно, только чтение).
//   2. Настройки ниже         - вписываем найденные имена.
//   3. Выполнить(Истина, ...) - пробный прогон: только список, ничего не оформляется и не гасится.
//   4. Выполнить(Ложь, ...)   - боевой режим, небольшими пакетами и только за свежий период.

#Область ПрограммныйИнтерфейс

// Настройки: имена объектов конфигурации. Значения по умолчанию - типовые для БСП "ИнтеграцияВЕТИС",
// ПРОВЕРЬТЕ их по результату Диагностика().
Функция Настройки() Экспорт
	Н = Новый Структура;
	Н.Вставить("ДокументВходящаяОперация", "ВходящаяТранспортнаяОперацияВЕТИС");
	Н.Вставить("ДокументВСД", "ВетеринарноСопроводительныйДокументВЕТИС");
	Н.Вставить("РеквизитОрганизация", ""); // у входящей операции НЕТ реквизита "Организация"; пусто = без отбора по организации
	Н.Вставить("РеквизитДата", "Дата");
	// Колонки табличной части "Товары" поступления: план и факт. Узнайте имена через ДиагностикаПрихода().
	// Если заполнены оба - группа "Готово", когда во всех строках план = факт (иначе сверка по сумме количества).
	// Что делать после создания операции. Пока Ложь: операция создается и проводится, но НЕ передается на гашение.
	Н.Вставить("ПогашатьПослеОформления", Истина);
	// Ответственный в создаваемых операциях: наименование пользователя из справочника "Пользователи".
	// Пусто - подставляется текущий пользователь, под которым запущена обработка.
	Н.Вставить("ОтветственныйНаименование", "Финансовый директор");
	Н.Вставить("ПриходПолеПлан", "КоличествоУпаковок");
	Н.Вставить("ПриходПолеФакт", "абр_КоличествоУпаковокФакт");
	Возврат Н;
КонецФункции

// Только чтение: перечень объектов с "ВЕТИС" в имени, реквизиты документа входящей операции,
// общие модули. Результат скопируйте и пришлите/сверьте с Настройки().
Функция Диагностика() Экспорт
	Текст = Новый Массив;
	Для Каждого Коллекция Из СписокКоллекций() Цикл
		Текст.Добавить("== " + Коллекция.Ключ + " ==");
		Для Каждого О Из Коллекция.Значение Цикл
			Если СтрНайти(ВРег(О.Имя), "ВЕТИС") > 0 Тогда
				Текст.Добавить("  " + О.Имя + " (" + О.Синоним + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Н = Настройки();
	МД = Метаданные.Документы.Найти(Н.ДокументВходящаяОперация);
	Если МД = Неопределено Тогда
		Текст.Добавить("!! Документ " + Н.ДокументВходящаяОперация + " не найден: исправьте Настройки()");
	Иначе
		Текст.Добавить("== Реквизиты " + МД.Имя + " ==");
		Для Каждого Р Из МД.Реквизиты Цикл
			Текст.Добавить("  " + Р.Имя + ": " + Строка(Р.Тип));
		КонецЦикла;
		Текст.Добавить("== Команды/формы ==");
		Для Каждого Ф Из МД.Формы Цикл
			Текст.Добавить("  Форма " + Ф.Имя);
		КонецЦикла;
		Текст.Добавить("Всего документов: " + КоличествоДокументов(МД.Имя));
	КонецЕсли;
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

// Основная процедура. ПробныйПрогон = Истина - только отчет. Каждая группа ВСД (одна накладная) получает статус:
//   Готово     - в 1С есть проведенное поступление с тем же номером и датой накладной и тем же количеством;
//   Расхождение - поступление найдено, но количество не совпало (оформлять вручную);
//   НетПрихода - поступления в 1С нет (оформлять вручную).
// В боевом режиме оформляются и гасятся только группы "Готово".
Функция Выполнить(ПробныйПрогон = Истина, Организация = Неопределено, ДатаС = Неопределено, ЛимитГрупп = 50) Экспорт
	Если ДатаС = Неопределено Тогда
		Сегодня = ТекущаяДатаСеанса();
		Год = Год(Сегодня) - ?(Месяц(Сегодня) < 9, 1, 0);
		ДатаС = Дата(Год, 9, 1);
	КонецЕсли;
	Отчет = Новый Массив;
	Группы = ГруппыКОформлению(ДатаС);
	СверитьСПриходом(Группы, ДатаС, Организация);
	Всего = 0;
	Итог = Новый Структура("Готово, Расхождение, НетПрихода", 0, 0, 0);
	Для Каждого Г Из Группы Цикл
		Всего = Всего + Г.ВСД.Количество();
		Итог[Г.Статус] = Итог[Г.Статус] + 1;
	КонецЦикла;
	Отчет.Добавить("ВСД к оформлению с " + Формат(ДатаС, "ДЛФ=D") + ": " + Всего + ", групп: " + Группы.Количество());
	Отчет.Добавить("  Готово (приход совпал): " + Итог.Готово + "; Расхождение: " + Итог.Расхождение
		+ "; НетПрихода: " + Итог.НетПрихода);
	// Пробный прогон: показываем первые ЛимитГрупп групп любого статуса.
	// Боевой режим: обрабатываем первые ЛимитГрупп групп только со статусом "Готово";
	// "Расхождение" и "НетПрихода" не трогаем (их список см. в пробном прогоне).
	Счетчик = 0;
	Для Каждого Г Из Группы Цикл
		Если Не ПробныйПрогон И Г.Статус <> "Готово" Тогда
			Продолжить;
		КонецЕсли;
		Если Счетчик >= ЛимитГрупп Тогда
			Отчет.Добавить("... показано/обработано первых " + ЛимитГрупп + " групп");
			Прервать;
		КонецЕсли;
		Счетчик = Счетчик + 1;
		Описание = Г.Статус + " | " + Г.Описание + "; ВСД: " + Г.ВСД.Количество() + " (кол-во " + Г.КолВСД + ")"
			+ ?(Г.Приход = Неопределено, "", "; приход: " + Г.Приход + " (кол-во " + Г.КолПриход + ")");
		Если ПробныйПрогон Тогда
			Отчет.Добавить("[пробно] " + Описание);
			Продолжить;
		КонецЕсли;
		Попытка
			ОформитьГруппу(Г);
			Отчет.Добавить("OK " + Описание + "; операция: " + ?(Г.Свойство("Операция"), Г.Операция, "?"));
		Исключение
			Сообщение = "ОШИБКА " + Описание + ": " + ОписаниеОшибки();
			Отчет.Добавить(Сообщение);
			ЗаписьЖурналаРегистрации("МеркурийАвто", УровеньЖурналаРегистрации.Ошибка,,, Сообщение);
		КонецПопытки;
	КонецЦикла;
	Если Счетчик = 0 Тогда
		Отчет.Добавить("Нет групп для обработки.");
	КонецЕсли;
	Возврат СтрСоединить(Отчет, Символы.ПС);
КонецФункции

// Таблица для формы сотрудника: ТОЛЬКО ЧТЕНИЕ. Все группы ВСД к оформлению со статусом сверки и причиной.
Функция ТаблицаПроверки(ДатаС, Организация = Неопределено, ДатаПо = Неопределено) Экспорт
	Группы = ГруппыКОформлению(ДатаС, ДатаПо);
	СверитьСПриходом(Группы, ДатаС, Организация);
	Для Каждого Г Из Группы Цикл
		Г.Результат = ?(Г.Статус = "Готово", "К оформлению", "Вручную");
	КонецЦикла;
	Возврат ТаблицаИзГрупп(Группы);
КонецФункции

// Оформление: берет свежую очередь, оформляет (и передает на гашение) первые Лимит групп со статусом "Готово",
// остальные не трогает. Возвращает ту же таблицу с результатом по каждой группе.
Функция ТаблицаОформления(ДатаС, Организация = Неопределено, Лимит = 10, ДатаПо = Неопределено, ВыбранныеКлючи = Неопределено) Экспорт
	Группы = ГруппыКОформлению(ДатаС, ДатаПо);
	СверитьСПриходом(Группы, ДатаС, Организация);
	Обработано = 0;
	Для Каждого Г Из Группы Цикл
		Если ВыбранныеКлючи <> Неопределено И ВыбранныеКлючи.Найти(Г.Ключ) = Неопределено Тогда
			Г.Результат = ?(Г.Статус = "Готово", "Не выбрано", "Вручную");
			Продолжить;
		КонецЕсли;
		Если Г.Статус <> "Готово" Тогда
			Г.Результат = ?(ВыбранныеКлючи <> Неопределено, "Не оформлено: статус изменился, проверьте заново", "Вручную");
			Продолжить;
		КонецЕсли;
		Если ВыбранныеКлючи = Неопределено И Обработано >= Лимит Тогда
			Г.Результат = "Не обработано (лимит за раз)";
			Продолжить;
		КонецЕсли;
		Обработано = Обработано + 1;
		Попытка
			ОформитьГруппу(Г);
			Г.Результат = "Оформлено: " + Г.Операция + ?(Настройки().ПогашатьПослеОформления, ", передано на гашение", "");
		Исключение
			Г.ВидОшибки = ?(Г.Свойство("Операция"), "Ошибка передачи", "Ошибка оформления");
			Г.Подробности = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Г.Результат = "ОШИБКА";
			ЗаписьЖурналаРегистрации("МеркурийАвто", УровеньЖурналаРегистрации.Ошибка,,, Г.Накладная + ": " + Г.Подробности);
		КонецПопытки;
	КонецЦикла;
	Возврат ТаблицаИзГрупп(Группы);
КонецФункции

// Таблица для формы: простые значения плюс ссылки для перехода в документы (поступление, операция, первый ВСД).
// Порядок строк по умолчанию: сначала "Готово", затем "Расхождение", затем "Нет прихода".
Функция ТаблицаИзГрупп(Группы)
	Т = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Ключ,Порядок,Статус,ВидОшибки,Подробности,Накладная,Отправитель,Получатель,ВСД,КолВСД,Приход,КолПриход,Операция,ПервыйВСД,Результат", ",") Цикл
		Т.Колонки.Добавить(Имя);
	КонецЦикла;
	Названия = Новый Соответствие;
	Названия.Вставить("Готово", "Готово");
	Названия.Вставить("Расхождение", "Расхождение");
	Названия.Вставить("НетПрихода", "Нет прихода");
	Порядки = Новый Соответствие;
	Порядки.Вставить("Готово", 1);
	Порядки.Вставить("Расхождение", 2);
	Порядки.Вставить("НетПрихода", 3);
	Для Каждого Г Из Группы Цикл
		С = Т.Добавить();
		С.Ключ = Г.Ключ;
		С.Порядок = Порядки[Г.Статус];
		С.Статус = Названия[Г.Статус];
		С.ВидОшибки = Г.ВидОшибки;
		С.Подробности = Г.Подробности;
		С.Накладная = Г.Накладная;
		С.Отправитель = Г.Отправитель;
		С.Получатель = Г.Получатель;
		С.ВСД = Г.ВСД.Количество();
		С.КолВСД = Г.КолВСД;
		С.Приход = Г.Приход;
		С.КолПриход = Г.КолПриход;
		С.Операция = ?(Г.Свойство("Операция"), Г.Операция, Неопределено);
		С.ПервыйВСД = ?(Г.ВСД.Количество() > 0, Г.ВСД[0], Неопределено);
		С.Результат = Г.Результат;
	КонецЦикла;
	Т.Сортировать("Порядок, Накладная");
	Возврат Т;
КонецФункции

// Псевдоним: форма уже вызывает ВыполнитьПрогон(,Организация).
Функция ВыполнитьПрогон(ПробныйПрогон = Истина, Организация = Неопределено, ДатаС = Неопределено) Экспорт
	Возврат Выполнить(ПробныйПрогон, Организация, ДатаС);
КонецФункции

// Глубокая диагностика (только чтение): по каждому документу, справочнику и регистру сведений с "ВЕТИС"
// в имени - число записей и состав полей. По ней находим источник списка "К оформлению"
// и ключевые реквизиты группировки. Результат длинный - показывайте в текстовом документе.
Функция ДиагностикаГлубокая() Экспорт
	Текст = Новый Массив;
	Группы = Новый Массив;
	Группы.Добавить(Новый Структура("Вид, МД", "Документ", Метаданные.Документы));
	Группы.Добавить(Новый Структура("Вид, МД", "Справочник", Метаданные.Справочники));
	Группы.Добавить(Новый Структура("Вид, МД", "РегистрСведений", Метаданные.РегистрыСведений));
	Для Каждого Г Из Группы Цикл
		Для Каждого О Из Г.МД Цикл
			Если СтрНайти(ВРег(О.Имя), "ВЕТИС") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Количество = "?";
			Попытка
				З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ " + Г.Вид + "." + О.Имя + " КАК Т");
				Количество = З.Выполнить().Выгрузить()[0].К;
			Исключение
			КонецПопытки;
			Текст.Добавить("### " + Г.Вид + "." + О.Имя + " [" + О.Синоним + "], записей: " + Количество);
			Если Г.Вид = "РегистрСведений" Тогда
				Для Каждого Р Из О.Измерения Цикл
					Текст.Добавить("   изм: " + Р.Имя + " : " + Строка(Р.Тип));
				КонецЦикла;
				Для Каждого Р Из О.Ресурсы Цикл
					Текст.Добавить("   рес: " + Р.Имя + " : " + Строка(Р.Тип));
				КонецЦикла;
			КонецЕсли;
			Для Каждого Р Из О.Реквизиты Цикл
				Текст.Добавить("   рек: " + Р.Имя + " : " + Строка(Р.Тип));
			КонецЦикла;
			Если Г.Вид = "Документ" Тогда
				Для Каждого ТЧ Из О.ТабличныеЧасти Цикл
					Текст.Добавить("   ТЧ: " + ТЧ.Имя);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Текст.Добавить("### Общие модули с ВЕТИС");
	Для Каждого М Из Метаданные.ОбщиеМодули Цикл
		Если СтрНайти(ВРег(М.Имя), "ВЕТИС") > 0 Тогда
			Текст.Добавить("   " + М.Имя + " (клиент: " + М.КлиентУправляемоеПриложение + ", сервер: " + М.Сервер + ")");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

// Диагностика прихода (только чтение): реквизиты документа "Приобретение товаров и услуг" и колонки
// его табличных частей - ищем колонки "план" и "факт".
Функция ДиагностикаПрихода() Экспорт
	Текст = Новый Массив;
	МД = Метаданные.Документы.Найти("ПриобретениеТоваровУслуг");
	Если МД = Неопределено Тогда
		Возврат "Документ ПриобретениеТоваровУслуг не найден";
	КонецЕсли;
	Текст.Добавить("### Реквизиты шапки");
	Для Каждого Р Из МД.Реквизиты Цикл
		Текст.Добавить("   " + Р.Имя + " [" + Р.Синоним + "] : " + Строка(Р.Тип));
	КонецЦикла;
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Текст.Добавить("### ТЧ " + ТЧ.Имя + " [" + ТЧ.Синоним + "]");
		Для Каждого Р Из ТЧ.Реквизиты Цикл
			Текст.Добавить("   " + Р.Имя + " [" + Р.Синоним + "] : " + Строка(Р.Тип));
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

// Диагностика операций в ошибке (только чтение): для каждой операции со статусом "К гашению ВСД (ошибка)" -
// способ хранения операции, способы хранения ее ВСД и вывод, что с ней делать.
Функция ДиагностикаОшибочныхОпераций() Экспорт
	Текст = Новый Массив;
	ТипВСД = Тип("СправочникСсылка.ВетеринарноСопроводительныйДокументВЕТИС");
	ТЧ = Метаданные.Документы.ВходящаяТранспортнаяОперацияВЕТИС.ТабличныеЧасти.Товары;
	ИмяКолонки = Неопределено;
	Для Каждого Р Из ТЧ.Реквизиты Цикл
		Если Р.Тип.СодержитТип(ТипВСД) Тогда
			ИмяКолонки = Р.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИмяКолонки = Неопределено Тогда
		Список = Новый Массив;
		Для Каждого Р Из ТЧ.Реквизиты Цикл
			Список.Добавить(Р.Имя);
		КонецЦикла;
		Возврат "В табличной части Товары нет колонки со ссылкой на ВСД. Колонки: " + СтрСоединить(Список, ", ");
	КонецЕсли;

	З = Новый Запрос;
	З.Текст = "ВЫБРАТЬ Д.Ссылка КАК Операция, Д.СпособХранения КАК СпособОперации, Д.НомерТТН КАК НомерТТН,
	|	Д.ДатаТТН КАК ДатаТТН
	|ИЗ Документ.ВходящаяТранспортнаяОперацияВЕТИС КАК Д
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовВЕТИС КАК С ПО С.Документ = Д.Ссылка
	|ГДЕ С.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиВходящихТранспортныхОперацийВЕТИС.Ошибка)
	|УПОРЯДОЧИТЬ ПО Д.Дата";
	Выборка = З.Выполнить().Выбрать();
	Текст.Добавить("Операции в ошибке: " + Выборка.Количество() + " (колонка ВСД в ТЧ: " + ИмяКолонки + ")");
	Пока Выборка.Следующий() Цикл
		З2 = Новый Запрос;
		З2.Текст = "ВЫБРАТЬ Т." + ИмяКолонки + ".СпособХранения КАК Способ, КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ Документ.ВходящаяТранспортнаяОперацияВЕТИС.Товары КАК Т
		|ГДЕ Т.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО Т." + ИмяКолонки + ".СпособХранения";
		З2.УстановитьПараметр("Ссылка", Выборка.Операция);
		В2 = З2.Выполнить().Выбрать();
		Способы = Новый Массив;
		Различных = 0;
		ЕдинственныйСпособ = Неопределено;
		Пока В2.Следующий() Цикл
			Способы.Добавить(Строка(В2.Способ) + " (" + В2.Количество + ")");
			Различных = Различных + 1;
			ЕдинственныйСпособ = В2.Способ;
		КонецЦикла;
		Если Различных > 1 Тогда
			Вывод = "СМЕШАННЫЙ способ хранения во ВСД: операцию нужно разделить по способам хранения";
		ИначеЕсли Различных = 1 И ЕдинственныйСпособ <> Выборка.СпособОперации Тогда
			Вывод = "НЕ СОВПАДАЕТ: у ВСД " + Строка(ЕдинственныйСпособ) + ", у операции " + Строка(Выборка.СпособОперации)
				+ ": поправьте способ хранения операции";
		Иначе
			Вывод = "способ хранения совпадает: причина в другом (см. ""причину"" в операции)";
		КонецЕсли;
		Текст.Добавить(Строка(Выборка.Операция) + " | накладная " + Выборка.НомерТТН + " от " + Формат(Выборка.ДатаТТН, "ДЛФ=D")
			+ " | у операции: " + Строка(Выборка.СпособОперации) + " | у ВСД: " + СтрСоединить(Способы, ", ") + " => " + Вывод);
	КонецЦикла;
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

// Диагностика связей ВСД (только чтение): (1) табличные части ВСД с колонками и примерами строк - ищем
// "Связанные документы" (УПД/ТОРГ-12 и их номера); (2) где предприятие ВетИС связано со складом.
Функция ДиагностикаСвязейВСД() Экспорт
	Текст = Новый Массив;
	МД = Метаданные.Справочники.ВетеринарноСопроводительныйДокументВЕТИС;
	Текст.Добавить("### Табличные части ВСД");
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Текст.Добавить("ТЧ " + ТЧ.Имя + " [" + ТЧ.Синоним + "]");
		Поля = Новый Массив;
		Для Каждого Р Из ТЧ.Реквизиты Цикл
			Текст.Добавить("   " + Р.Имя + " : " + Строка(Р.Тип));
			Поля.Добавить("Т." + Р.Имя + " КАК " + Р.Имя);
		КонецЦикла;
		Если Поля.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 8 Т.Ссылка.НомерТТН КАК НомерТТН_ВСД, " + СтрСоединить(Поля, ", ")
				+ " ИЗ Справочник.ВетеринарноСопроводительныйДокументВЕТИС." + ТЧ.Имя + " КАК Т"
				+ " ГДЕ Т.Ссылка.Дата >= &Дата");
			З.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()) - 10 * 86400);
			Результат = З.Выполнить();
			Выб = Результат.Выбрать();
			Текст.Добавить("   -- примеры строк (" + Выб.Количество() + "):");
			Пока Выб.Следующий() Цикл
				Части = Новый Массив;
				Для Каждого Колонка Из Результат.Колонки Цикл
					Части.Добавить(Колонка.Имя + "=" + Строка(Выб[Колонка.Имя]));
				КонецЦикла;
				Текст.Добавить("   " + СтрСоединить(Части, "; "));
			КонецЦикла;
		Исключение
			Текст.Добавить("   (не удалось получить примеры: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")");
		КонецПопытки;
	КонецЦикла;

	Текст.Добавить("### Объекты, где есть и предприятие ВетИС, и склад");
	ТипПредприятия = Тип("СправочникСсылка.ПредприятияВЕТИС");
	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.Документы);
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого О Из Коллекция Цикл
			Поля = Новый Массив;
			Если ЕстьСвойство(О, "Измерения") Тогда
				Для Каждого Р Из О.Измерения Цикл
					Поля.Добавить(Р);
				КонецЦикла;
			КонецЕсли;
			Если ЕстьСвойство(О, "Ресурсы") Тогда
				Для Каждого Р Из О.Ресурсы Цикл
					Поля.Добавить(Р);
				КонецЦикла;
			КонецЕсли;
			Для Каждого Р Из О.Реквизиты Цикл
				Поля.Добавить(Р);
			КонецЦикла;
			ЕстьПредприятие = Ложь;
			Склады = Новый Массив;
			Для Каждого Р Из Поля Цикл
				Если Р.Тип.СодержитТип(ТипПредприятия) Тогда
					ЕстьПредприятие = Истина;
				КонецЕсли;
				Если СтрНайти(НРег(Строка(Р.Тип)), "склад") > 0 Или СтрНайти(НРег(Р.Имя), "склад") > 0 Тогда
					Склады.Добавить(Р.Имя + " : " + Строка(Р.Тип));
				КонецЕсли;
			КонецЦикла;
			Если ЕстьПредприятие И Склады.Количество() > 0 Тогда
				Текст.Добавить(О.ПолноеИмя() + " [" + О.Синоним + "]: " + СтрСоединить(Склады, " | "));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

Функция ЕстьСвойство(Объект, Имя)
	Попытка
		Значение = Объект[Имя];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Диагностика статусов (только чтение): значения перечислений статусов и распределение записей
// регистров СтатусыОформленияДокументовВЕТИС и СтатусыДокументовВЕТИС. По ней находим условие "К оформлению".
Функция ДиагностикаСтатусов() Экспорт
	Текст = Новый Массив;
	Для Каждого Е Из Метаданные.Перечисления Цикл
		Если СтрНайти(Е.Синоним, "Статусы оформления документов") > 0
			Или СтрНайти(Е.Синоним, "Статусы обработки входящих транспортных") > 0
			Или СтрНайти(Е.Синоним, "Дальнейшие действия по взаимодействию ВетИС") > 0 Тогда
			Текст.Добавить("### Перечисление." + Е.Имя + " [" + Е.Синоним + "]");
			Для Каждого З Из Е.ЗначенияПеречисления Цикл
				Текст.Добавить("   " + З.Имя + " (" + З.Синоним + ")");
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Текст.Добавить("### СтатусыОформленияДокументовВЕТИС: статус | архивный | тип основания | документ заполнен -> записей");
	Счет = Новый Соответствие;
	З = Новый Запрос("ВЫБРАТЬ С.СтатусОформления КАК Статус, С.Архивный КАК Архивный, С.Основание КАК Основание,
	|С.Документ КАК Документ ИЗ РегистрСведений.СтатусыОформленияДокументовВЕТИС КАК С");
	Выборка = З.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТипОсн = "?";
		Попытка
			ТипОсн = Выборка.Основание.Метаданные().Имя;
		Исключение
		КонецПопытки;
		Ключ = Строка(Выборка.Статус) + " | архивный=" + Выборка.Архивный + " | " + ТипОсн
			+ " | документ=" + ?(ЗначениеЗаполнено(Выборка.Документ), "да", "нет");
		Счет.Вставить(Ключ, ?(Счет[Ключ] = Неопределено, 0, Счет[Ключ]) + 1);
	КонецЦикла;
	Для Каждого КЗ Из Счет Цикл
		Текст.Добавить("   " + КЗ.Ключ + " -> " + КЗ.Значение);
	КонецЦикла;

	Текст.Добавить("### СтатусыДокументовВЕТИС: статус | действие1 -> записей");
	Счет2 = Новый Соответствие;
	З2 = Новый Запрос("ВЫБРАТЬ С.Статус КАК Статус, С.ДальнейшееДействие1 КАК Д1
	|ИЗ РегистрСведений.СтатусыДокументовВЕТИС КАК С");
	В2 = З2.Выполнить().Выбрать();
	Пока В2.Следующий() Цикл
		Ключ = Строка(В2.Статус) + " | " + Строка(В2.Д1);
		Счет2.Вставить(Ключ, ?(Счет2[Ключ] = Неопределено, 0, Счет2[Ключ]) + 1);
	КонецЦикла;
	Для Каждого КЗ Из Счет2 Цикл
		Текст.Добавить("   " + КЗ.Ключ + " -> " + КЗ.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Текст, Символы.ПС);
КонецФункции

#КонецОбласти

#Область Служебные

// Номер накладной для сравнения (по реальным данным): верхний регистр; часть после "/" отбрасывается ("14Т2880169/18");
// латинские буквы-двойники заменяются русскими (T -> Т); все, кроме букв и цифр, убирается;
// ведущие нули убираются и в начале, и после буквенного префикса ("00ТТ-031512" = "ТТ-031512",
// "СЧ0000053594" = "СЧ000053594").
Функция НормализоватьНомер(Номер)
	Алфавит = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789";
	Лат = "ABCEHKMOPTXY";
	Кир = "АВСЕНКМОРТХУ";
	Текст = ВРег(СокрЛП(Номер));
	Позиция = СтрНайти(Текст, "/");
	Если Позиция > 1 Тогда
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Найден = СтрНайти(Лат, Символ);
		Если Найден > 0 Тогда
			Символ = Сред(Кир, Найден, 1);
		КонецЕсли;
		Если СтрНайти(Алфавит, Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Префикс = "";
	Остаток = Результат;
	Пока СтрДлина(Остаток) > 0 И СтрНайти("0123456789", Лев(Остаток, 1)) = 0 Цикл
		Префикс = Префикс + Лев(Остаток, 1);
		Остаток = Сред(Остаток, 2);
	КонецЦикла;
	Пока СтрДлина(Остаток) > 1 И Лев(Остаток, 1) = "0" Цикл
		Остаток = Сред(Остаток, 2);
	КонецЦикла;
	Возврат Префикс + Остаток;
КонецФункции

// Только цифры номера без ведущих нулей ("ЦБ-9735" -> "9735"); для запасного сопоставления.
Функция ТолькоЦифры(Номер)
	Результат = "";
	Текст = Строка(Номер);
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Пока СтрДлина(Результат) > 1 И Лев(Результат, 1) = "0" Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СписокКоллекций()
	Результат = Новый Структура;
	Результат.Вставить("Документы", Метаданные.Документы);
	Результат.Вставить("Справочники", Метаданные.Справочники);
	Результат.Вставить("Обработки", Метаданные.Обработки);
	Результат.Вставить("ОбщиеМодули", Метаданные.ОбщиеМодули);
	Результат.Вставить("РегистрыСведений", Метаданные.РегистрыСведений);
	Возврат Результат;
КонецФункции

Функция КоличествоЗаПериод(ДатаС)
	Н = Настройки();
	З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ." + Н.ДокументВходящаяОперация + " КАК Д
	|ГДЕ НЕ Д.ПометкаУдаления И Д." + Н.РеквизитДата + " >= &ДатаС");
	З.УстановитьПараметр("ДатаС", ДатаС);
	Возврат З.Выполнить().Выгрузить()[0].К;
КонецФункции

Функция КоличествоДокументов(Имя)
	З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ." + Имя + " КАК Д");
	Возврат З.Выполнить().Выгрузить()[0].К;
КонецФункции

// ВСД, ожидающие оформления (регистр "Статусы оформления документов ВетИС": основание - ВСД, статус
// "Не оформлено", не архивный), сгруппированные так, как их принимает кнопка "Оформить":
// все строки группы - одна накладная, один отправитель, один получатель.
// Возвращает массив структур: Описание, Ключ, ВСД (массив ссылок).
Функция ГруппыКОформлению(ДатаС, ДатаПо = Неопределено)
	З = Новый Запрос;
	З.Текст = "ВЫБРАТЬ ВетеринарноСопроводительныйДокументВЕТИС.Ссылка КАК ВСД, ВетеринарноСопроводительныйДокументВЕТИС.Дата КАК Дата, ВетеринарноСопроводительныйДокументВЕТИС.ТипТТН КАК ТипТТН, ВетеринарноСопроводительныйДокументВЕТИС.СерияТТН КАК СерияТТН,
	|	ВетеринарноСопроводительныйДокументВЕТИС.НомерТТН КАК НомерТТН, ВетеринарноСопроводительныйДокументВЕТИС.ДатаТТН КАК ДатаТТН,
	|	ВетеринарноСопроводительныйДокументВЕТИС.ГрузоотправительХозяйствующийСубъект КАК ГОХС, ВетеринарноСопроводительныйДокументВЕТИС.ГрузоотправительПредприятие КАК ГОП,
	|	ВетеринарноСопроводительныйДокументВЕТИС.ГрузополучательХозяйствующийСубъект КАК ГПХС, ВетеринарноСопроводительныйДокументВЕТИС.ГрузополучательПредприятие КАК ГПП,
	|	ВетеринарноСопроводительныйДокументВЕТИС.ПеревозчикХозяйствующийСубъект КАК ПХС, ВетеринарноСопроводительныйДокументВЕТИС.КоличествоВЕТИС КАК Количество,
	|	ВетеринарноСопроводительныйДокументВЕТИС.СпособХранения КАК СпособХранения,
	|	ВетеринарноСопроводительныйДокументВЕТИС.ГрузоотправительХозяйствующийСубъект.Контрагент КАК КонтрагентОтправителя
	|ИЗ РегистрСведений.СтатусыОформленияДокументовВЕТИС КАК С
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВетеринарноСопроводительныйДокументВЕТИС КАК ВетеринарноСопроводительныйДокументВЕТИС ПО С.Основание = ВетеринарноСопроводительныйДокументВЕТИС.Ссылка
	|ГДЕ С.СтатусОформления = ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовГосИС.НеОформлено)
	|	И НЕ С.Архивный
	|	И НЕ ВетеринарноСопроводительныйДокументВЕТИС.ПометкаУдаления
	|	И НЕ ВетеринарноСопроводительныйДокументВЕТИС.Закрыт
	|	И ВетеринарноСопроводительныйДокументВЕТИС.Дата >= &ДатаС
	|	И (&БезДатыПо ИЛИ ВетеринарноСопроводительныйДокументВЕТИС.Дата <= &ДатаПо)
	|	И ВетеринарноСопроводительныйДокументВЕТИС.ГрузополучательХозяйствующийСубъект.СоответствуетОрганизации
	|УПОРЯДОЧИТЬ ПО ВетеринарноСопроводительныйДокументВЕТИС.Дата УБЫВ";
	З.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	З.УстановитьПараметр("БезДатыПо", Не ЗначениеЗаполнено(ДатаПо));
	З.УстановитьПараметр("ДатаПо", КонецДня(?(ЗначениеЗаполнено(ДатаПо), ДатаПо, ТекущаяДатаСеанса())));
	Выборка = З.Выполнить().Выбрать();
	Индекс = Новый Соответствие;
	ВСДГруппа = Новый Соответствие;
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ключ = Строка(Выборка.ТипТТН) + "|" + Выборка.СерияТТН + "|" + Выборка.НомерТТН + "|"
			+ Формат(Выборка.ДатаТТН, "ДФ=dd.MM.yyyy") + "|" + Строка(Выборка.ГОХС) + "|" + Строка(Выборка.ГОП) + "|"
			+ Строка(Выборка.ГПХС) + "|" + Строка(Выборка.ГПП) + "|" + Строка(Выборка.ПХС) + "|" + Строка(Выборка.СпособХранения);
		Г = Индекс[Ключ];
		Если Г = Неопределено Тогда
			Описание = Строка(Выборка.ТипТТН) + " " + Выборка.СерияТТН + " " + Выборка.НомерТТН + " от "
				+ Формат(Выборка.ДатаТТН, "ДЛФ=D") + ", отправитель: " + Выборка.ГОХС + " / " + Выборка.ГОП
				+ ", получатель: " + Выборка.ГПП;
			Накладная = Строка(Выборка.ТипТТН) + " " + СокрЛП(Выборка.СерияТТН + " " + Выборка.НомерТТН) + " от "
				+ Формат(Выборка.ДатаТТН, "ДЛФ=D")
				+ ?(ЗначениеЗаполнено(Выборка.СпособХранения), ", хранение: " + Строка(Выборка.СпособХранения), "");
			Г = Новый Структура("Описание, Ключ, ВСД, НомерТТН, ДатаТТН, КолВСД, Приход, КолПриход, Статус, Поставщик, "
				+ "Накладная, Отправитель, Получатель, ВидОшибки, Подробности, Результат, СпособХранения, Документы, ПредприятиеПолучателя",
				Описание, Ключ, Новый Массив, Выборка.НомерТТН, НачалоДня(Выборка.ДатаТТН), 0, Неопределено, 0, "НетПрихода",
				Выборка.КонтрагентОтправителя,
				Накладная, Строка(Выборка.ГОХС) + " / " + Строка(Выборка.ГОП), Строка(Выборка.ГПП), "", "", "",
				Выборка.СпособХранения, Новый Массив, Выборка.ГПП);
			Г.Документы.Добавить(Новый Структура("Номер, Дата", Выборка.НомерТТН, НачалоДня(Выборка.ДатаТТН)));
			Индекс.Вставить(Ключ, Г);
			Результат.Добавить(Г);
		КонецЕсли;
		Г.ВСД.Добавить(Выборка.ВСД);
		ВСДГруппа.Вставить(Выборка.ВСД, Г);
		Г.КолВСД = Г.КолВСД + Выборка.Количество;
	КонецЦикла;
	// Связанные документы ВСД (УПД, ТОРГ-12 и др.): у части поставщиков номер УПД отличается от номера ТТН,
	// а в приходе записан именно он.
	Если ВСДГруппа.Количество() > 0 Тогда
		ЗС = Новый Запрос;
		ЗС.Текст = "ВЫБРАТЬ Т.Ссылка КАК ВСД, Т.Номер КАК Номер, Т.Дата КАК Дата
		|ИЗ Справочник.ВетеринарноСопроводительныйДокументВЕТИС.СвязанныеДокументы КАК Т
		|ГДЕ Т.Ссылка.Дата >= &ДатаС И (&БезДатыПо ИЛИ Т.Ссылка.Дата <= &ДатаПо) И Т.Номер <> """"";
		ЗС.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
		ЗС.УстановитьПараметр("БезДатыПо", Не ЗначениеЗаполнено(ДатаПо));
		ЗС.УстановитьПараметр("ДатаПо", КонецДня(?(ЗначениеЗаполнено(ДатаПо), ДатаПо, ТекущаяДатаСеанса())));
		Связанные = ЗС.Выполнить().Выбрать();
		Пока Связанные.Следующий() Цикл
			ГруппаВСД = ВСДГруппа[Связанные.ВСД];
			Если ГруппаВСД <> Неопределено Тогда
				ГруппаВСД.Документы.Добавить(Новый Структура("Номер, Дата", Связанные.Номер, НачалоДня(Связанные.Дата)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Сверка с приходом: проведенное "Приобретение товаров и услуг" с тем же входящим номером и датой накладной.
// Статус "Готово" - найдено и суммарное количество совпало; иначе "Расхождение" / "НетПрихода" (вручную).
// Количество сравнивается как сумма по документу: если единицы в 1С и ВетИС разные, группа безопасно
// уйдет в "Расхождение" и будет оформлена вручную (уточним правило по результатам пробного прогона).
Процедура СверитьСПриходом(Группы, ДатаС, Организация = Неопределено)
	Н = Настройки();
	ПланФакт = ЗначениеЗаполнено(Н.ПриходПолеПлан) И ЗначениеЗаполнено(Н.ПриходПолеФакт);
	Расхождений = "0";
	БезФакта = "0";
	Если ПланФакт Тогда
		Расхождений = "СУММА(ВЫБОР КОГДА Т." + Н.ПриходПолеПлан + " <> Т." + Н.ПриходПолеФакт + " ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)";
		БезФакта = "СУММА(ВЫБОР КОГДА Т." + Н.ПриходПолеФакт + " = 0 И Т." + Н.ПриходПолеПлан + " <> 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)";
	КонецЕсли;
	З = Новый Запрос;
	З.Текст = "ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.НомерВходящегоДокумента КАК Номер, Д.Контрагент КАК Контрагент, Д.Склад КАК Склад,
	|	НАЧАЛОПЕРИОДА(Д.ДатаВходящегоДокумента, ДЕНЬ) КАК ДатаТТН, СУММА(Т.Количество) КАК Количество,
	|	КОЛИЧЕСТВО(Т.НомерСтроки) КАК Строк, " + Расхождений + " КАК Расхождений, " + БезФакта + " КАК БезФакта
	|ИЗ Документ.ПриобретениеТоваровУслуг КАК Д
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК Т ПО Т.Ссылка = Д.Ссылка
	|ГДЕ Д.Проведен И Д.ДатаВходящегоДокумента >= &С
	|	И (&БезОрганизации ИЛИ Д.Организация = &Организация)
	|СГРУППИРОВАТЬ ПО Д.Ссылка, Д.НомерВходящегоДокумента, Д.Контрагент, Д.Склад, НАЧАЛОПЕРИОДА(Д.ДатаВходящегоДокумента, ДЕНЬ)";
	З.УстановитьПараметр("С", НачалоДня(ДатаС) - 60 * 86400);
	З.УстановитьПараметр("Организация", Организация);
	З.УстановитьПараметр("БезОрганизации", Не ЗначениеЗаполнено(Организация));
	Индекс = Новый Соответствие;       // нормализованный номер + дата
	ИндексЦифр = Новый Соответствие;   // цифры номера + дата
	ИндексСклад = Новый Соответствие;  // поставщик + склад + дата
	Индекс2 = Новый Соответствие;      // подсказки: номера приходов поставщика на дату
	Выборка = З.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДатаКлюч = Формат(Выборка.ДатаТТН, "ДФ=yyyyMMdd");
		Приход = Новый Структура("Ссылка, Контрагент, Количество, Строк, Расхождений, БезФакта, Номер",
			Выборка.Ссылка, Выборка.Контрагент, Выборка.Количество, Выборка.Строк, Выборка.Расхождений, Выборка.БезФакта,
			СокрЛП(Выборка.Номер));
		ДобавитьВИндекс(Индекс, НормализоватьНомер(Выборка.Номер) + "|" + ДатаКлюч, Приход);
		ЦифрыПрихода = ТолькоЦифры(Выборка.Номер);
		Если СтрДлина(ЦифрыПрихода) >= 3 Тогда
			ДобавитьВИндекс(ИндексЦифр, ЦифрыПрихода + "|" + ДатаКлюч, Приход);
		КонецЕсли;
		КлючПоставщика = Строка(Выборка.Контрагент.УникальныйИдентификатор());
		ДобавитьВИндекс(ИндексСклад, КлючПоставщика + "|" + Строка(Выборка.Склад.УникальныйИдентификатор()) + "|" + ДатаКлюч, Приход);
		НомераПоставщика = Индекс2[КлючПоставщика + "|" + ДатаКлюч];
		Если НомераПоставщика = Неопределено Тогда
			НомераПоставщика = Новый Массив;
			Индекс2.Вставить(КлючПоставщика + "|" + ДатаКлюч, НомераПоставщика);
		КонецЕсли;
		Если НомераПоставщика.Количество() < 5 Тогда
			НомераПоставщика.Добавить(СокрЛП(Выборка.Номер));
		КонецЕсли;
	КонецЦикла;

	КэшСкладов = Новый Соответствие;
	Для Каждого Г Из Группы Цикл
		Поиск = НайтиПриходГруппы(Г, Индекс, ИндексЦифр, ИндексСклад, КэшСкладов);
		Кандидаты = Поиск.Кандидаты;
		Если Кандидаты.Количество() = 0 Тогда
			Г.ВидОшибки = "Нет прихода";
			Если ЗначениеЗаполнено(Поиск.Причина) Тогда
				Г.Подробности = Поиск.Причина;
			Иначе
				Г.Подробности = "Нет проведенного поступления с номером накладной """ + Г.НомерТТН + """ от "
					+ Формат(Г.ДатаТТН, "ДЛФ=D");
			КонецЕсли;
			Если ЗначениеЗаполнено(Г.Поставщик) Тогда
				Номера = Индекс2[Строка(Г.Поставщик.УникальныйИдентификатор()) + "|" + Формат(Г.ДатаТТН, "ДФ=yyyyMMdd")];
				Если Номера <> Неопределено Тогда
					Г.Подробности = Г.Подробности + ". В 1С у этого поставщика на эту дату есть поступления с номерами: "
						+ СтрСоединить(Номера, ", ");
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПримечаниеСпособа = ?(ЗначениеЗаполнено(Поиск.Способ), "; сопоставлено " + Поиск.Способ, "");
		Прих = Кандидаты[0];
		Г.Приход = Прих.Ссылка;
		Г.КолПриход = Прих.Количество;
		Если Кандидаты.Количество() > 1 Тогда
			Г.Статус = "Расхождение";
			Г.ВидОшибки = "Несколько приходов";
			Г.Подробности = "Найдено поступлений с таким номером и датой: " + Кандидаты.Количество() + ". Оформите вручную.";
		ИначеЕсли ПланФакт Тогда
			Если Прих.Строк = 0 Тогда
				Г.Статус = "Расхождение";
				Г.ВидОшибки = "Нет строк";
				Г.Подробности = "В поступлении нет строк товаров";
			ИначеЕсли Прих.Расхождений = 0 Тогда
				Г.Статус = "Готово";
				Г.Подробности = "План = факт во всех строках (" + Прих.Строк + ")" + ПримечаниеСпособа;
			Иначе
				Г.Статус = "Расхождение";
				Г.ВидОшибки = "Расхождение план/факт";
				Г.Подробности = "План не равен факту в " + Прих.Расхождений + " из " + Прих.Строк + " строк"
					+ ?(Прих.БезФакта > 0, "; факт не заполнен в " + Прих.БезФакта, "") + ПримечаниеСпособа;
			КонецЕсли;
		Иначе
			Если Окр(Г.КолПриход, 3) = Окр(Г.КолВСД, 3) Тогда
				Г.Статус = "Готово";
				Г.Подробности = "Количество совпало" + ПримечаниеСпособа;
			Иначе
				Г.Статус = "Расхождение";
				Г.ВидОшибки = "Расхождение количества";
				Г.Подробности = "Количество в поступлении " + Г.КолПриход + ", по ВСД " + Г.КолВСД + ПримечаниеСпособа;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВИндекс(Индекс, Ключ, Значение)
	Список = Индекс[Ключ];
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Индекс.Вставить(Ключ, Список);
	КонецЕсли;
	Список.Добавить(Значение);
КонецПроцедуры

Функция ФильтрПоставщика(Список, Поставщик)
	Результат = Новый Массив;
	Для Каждого К Из Список Цикл
		Если Не ЗначениеЗаполнено(Поставщик) Или К.Контрагент = Поставщик Тогда
			Результат.Добавить(К);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Склад получателя: платформа сама определяет торговый объект, когда документ заполняется по ВСД
// (в операции поле "Торговый объект"). Берем его у временного, НЕ записываемого документа и кэшируем по предприятию.
Функция СкладПолучателя(Г, КэшСкладов)
	Если Не ЗначениеЗаполнено(Г.ПредприятиеПолучателя) Или Г.ВСД.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = Строка(Г.ПредприятиеПолучателя.УникальныйИдентификатор());
	Кэш = КэшСкладов[Ключ];
	Если Кэш <> Неопределено Тогда
		Возврат Кэш.Склад;
	КонецЕсли;
	Склад = Неопределено;
	Попытка
		Док = Документы.ВходящаяТранспортнаяОперацияВЕТИС.СоздатьДокумент();
		Первый = Новый Массив;
		Первый.Добавить(Г.ВСД[0]);
		Док.Заполнить(Первый);
		Если ЗначениеЗаполнено(Док.ТорговыйОбъект) Тогда
			Склад = Док.ТорговыйОбъект;
		КонецЕсли;
	Исключение
		Склад = Неопределено;
	КонецПопытки;
	КэшСкладов.Вставить(Ключ, Новый Структура("Склад", Склад));
	Возврат Склад;
КонецФункции

// Поиск прихода для группы ВСД тремя способами, от надежного к запасному:
//  1) номер накладной или номер связанного документа (УПД, ТОРГ-12) + дата - точное совпадение (после нормализации);
//  2) цифры номера + дата, только если приход ровно один;
//  3) поставщик + склад получателя + дата накладной, только если приход ровно один.
// Возвращает: Кандидаты (массив), Способ (как найдено, пусто для точного номера ТТН), Причина (почему не найден).
Функция НайтиПриходГруппы(Г, Индекс, ИндексЦифр, ИндексСклад, КэшСкладов)
	Результат = Новый Структура("Кандидаты, Способ, Причина", Новый Массив, "", "");
	// 1. точный номер
	Для Каждого Док Из Г.Документы Цикл
		Список = Индекс[НормализоватьНомер(Док.Номер) + "|" + Формат(Док.Дата, "ДФ=yyyyMMdd")];
		Если Список <> Неопределено Тогда
			Кандидаты = ФильтрПоставщика(Список, Г.Поставщик);
			Если Кандидаты.Количество() > 0 Тогда
				Результат.Кандидаты = Кандидаты;
				Результат.Способ = ?(Док.Номер = Г.НомерТТН, "", "по номеру связанного документа " + Док.Номер);
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// 2. цифры номера
	Для Каждого Док Из Г.Документы Цикл
		Цифры = ТолькоЦифры(Док.Номер);
		Если СтрДлина(Цифры) < 3 Тогда
			Продолжить;
		КонецЕсли;
		Список = ИндексЦифр[Цифры + "|" + Формат(Док.Дата, "ДФ=yyyyMMdd")];
		Если Список <> Неопределено Тогда
			Кандидаты = ФильтрПоставщика(Список, Г.Поставщик);
			Если Кандидаты.Количество() = 1 Тогда
				Результат.Кандидаты = Кандидаты;
				Результат.Способ = "по цифрам номера (" + Док.Номер + ")";
				Возврат Результат;
			ИначеЕсли Кандидаты.Количество() > 1 Тогда
				Результат.Причина = "Номер совпал только по цифрам с несколькими приходами поставщика; оформите вручную";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// 3. поставщик + склад + дата
	Если ЗначениеЗаполнено(Г.Поставщик) Тогда
		Склад = СкладПолучателя(Г, КэшСкладов);
		Если ЗначениеЗаполнено(Склад) Тогда
			Список = ИндексСклад[Строка(Г.Поставщик.УникальныйИдентификатор()) + "|" + Строка(Склад.УникальныйИдентификатор())
				+ "|" + Формат(Г.ДатаТТН, "ДФ=yyyyMMdd")];
			Если Список <> Неопределено Тогда
				Если Список.Количество() = 1 Тогда
					Результат.Кандидаты = Список;
					Результат.Способ = "по поставщику, складу (" + Строка(Склад) + ") и дате";
					Возврат Результат;
				Иначе
					Результат.Причина = "Номер не совпал; на эту дату у поставщика на склад " + Строка(Склад) + " несколько приходов ("
						+ Список.Количество() + "), оформите вручную";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Оформление группы так же, как кнопка "Оформить" в списке "К оформлению": форма открывает новую
// "Входящую транспортную операцию ВетИС" с параметром Основание = массив ссылок на ВСД, то есть документ
// заполняется по основанию. Здесь то же самое выполняется без формы, затем документ проводится.
// Создание и проведение операции обратимо (можно отменить проведение), в Меркурий ничего не уходит:
// подпись и передача выполняются отдельным шагом (гашение) через обмен.
Процедура ОформитьГруппу(Группа)
	Документ = Документы.ВходящаяТранспортнаяОперацияВЕТИС.СоздатьДокумент();
	Документ.Заполнить(Группа.ВСД);
	// Меркурий требует, чтобы способ хранения в операции совпадал с указанным в ВСД (MERC14235).
	Если ЗначениеЗаполнено(Группа.СпособХранения) И Документ.СпособХранения <> Группа.СпособХранения Тогда
		Документ.СпособХранения = Группа.СпособХранения;
	КонецЕсли;
	Если Документ.Товары.Количество() = 0 Тогда
		ВызватьИсключение "Документ не заполнился по ВСД группы (пустая табличная часть Товары)";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ.Дата) Тогда
		Документ.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ЗначениеЗаполнено(Настройки().ОтветственныйНаименование) Тогда
		Ответственный = Справочники.Пользователи.НайтиПоНаименованию(Настройки().ОтветственныйНаименование, Истина);
		Если Ответственный.Пустая() Тогда
			ВызватьИсключение "Не найден пользователь """ + Настройки().ОтветственныйНаименование
				+ """ для поля Ответственный (см. Настройки().ОтветственныйНаименование)";
		КонецЕсли;
		Документ.Ответственный = Ответственный;
	ИначеЕсли Не ЗначениеЗаполнено(Документ.Ответственный) Тогда
		Документ.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	ЗаписьЖурналаРегистрации("МеркурийАвто", УровеньЖурналаРегистрации.Информация, Метаданные.Документы.ВходящаяТранспортнаяОперацияВЕТИС,
		Документ.Ссылка, "Создана операция по группе: " + Группа.Описание + "; ВСД: " + Группа.ВСД.Количество());
	Группа.Вставить("Операция", Документ.Ссылка);
	Если Настройки().ПогашатьПослеОформления Тогда
		Попытка
			ПередатьНаГашение(Документ.Ссылка);
		Исключение
			ВызватьИсключение "Операция " + Документ.Ссылка + " создана, но передача на гашение не удалась "
				+ "(нажмите ""передайте данные"" в операции вручную): " + ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Передача операции на гашение - то же, что ссылка "передайте данные" в форме документа:
// форма вызывает на сервере ИнтеграцияВЕТИСВызовСервера.ПодготовитьКПередаче(Ссылка, ПараметрыПередачи, УИД)
// с ДальнейшееДействие = ПередайтеДанные. При подготовке операция получает статус "К гашению ВСД",
// сообщение уходит в очередь обмена и передается; ответ Меркурия и итоговый статус "ВСД погашены" приходят
// при выполнении обмена (регламентное задание ВетИС или кнопка "Выполнить обмен").
// ВНИМАНИЕ: после передачи отмена невозможна.
Процедура ПередатьНаГашение(Операция)
	ПараметрыПередачи = ИнтеграцияВЕТИСКлиентСервер.СтруктураПараметрыПередачи();
	ПараметрыПередачи.ДальнейшееДействие = Перечисления.ДальнейшиеДействияПоВзаимодействиюВЕТИС.ПередайтеДанные;
	Результат = ИнтеграцияВЕТИСВызовСервера.ПодготовитьКПередаче(Операция, ПараметрыПередачи, Новый УникальныйИдентификатор);
	Ошибки = Новый Массив;
	Для Каждого Изменение Из Результат.Изменения Цикл
		Если ЗначениеЗаполнено(Изменение.ТекстОшибки) Тогда
			Ошибки.Добавить(Изменение.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
