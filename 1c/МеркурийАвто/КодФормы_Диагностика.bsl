// Вставьте в модуль формы обработки (команда "ГлубокаяДиагностика" с этим действием).
&НаКлиенте
Процедура ГлубокаяДиагностика(Команда)
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ГлубокаяДиагностикаНаСервере());
	Документ.Показать("Диагностика ВетИС");
КонецПроцедуры

&НаСервере
Функция ГлубокаяДиагностикаНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ДиагностикаГлубокая();
КонецФункции

// Вторая кнопка: команда "ДиагностикаСтатусов" с этим действием.
&НаКлиенте
Процедура ДиагностикаСтатусов(Команда)
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ДиагностикаСтатусовНаСервере());
	Документ.Показать("Статусы ВетИС");
КонецПроцедуры

&НаСервере
Функция ДиагностикаСтатусовНаСервере()
	Возврат РеквизитФормыВЗначение("Объект").ДиагностикаСтатусов();
КонецФункции
