// Обработка «Закрытие периода: проверки».
//
// Каждая проверка расположена на собственной вкладке (параметры, кнопки, таблица результата).
// Отдельная вкладка «Сверка деклараций НДС» сравнивает Excel-файлы декларации (раздел 8/9)
// и реестры счетов-фактур.
//
// Все реквизиты и элементы формы создаются программно в ПриСозданииНаСервере по списку
// ОписаниеПроверок() — чтобы добавить проверку, достаточно добавить её описание и
// ветку в ВыполнитьПроверкуПоИмени().
// Ориентир по конфигурации: ERP / Комплексная автоматизация 2 (как в исходной обработке).

#Область ОписаниеПроверок

&НаСервереБезКонтекста
Функция НовыйПараметр(Имя, Заголовок, Тип, Значение = "")
	Возврат Новый Структура("Имя, Заголовок, Тип, Значение", Имя, Заголовок, Тип, Значение);
КонецФункции

&НаСервереБезКонтекста
Функция НоваяПроверка(Имя, Заголовок, Подсказка, Параметры = Неопределено, ДействияСДокументами = Истина)
	Возврат Новый Структура("Имя, Заголовок, Подсказка, Параметры, ДействияСДокументами",
		Имя, Заголовок, Подсказка, ?(Параметры = Неопределено, Новый Массив, Параметры), ДействияСДокументами);
КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеПроверок()

	Проверки = Новый Массив;

	Параметры = Новый Массив;
	Параметры.Добавить(НовыйПараметр("ТипДокумента", "Вид документа (пусто — все)", "ИмяДокумента"));
	Проверки.Добавить(НоваяПроверка("БезПроводок", "Нет проводок",
		"Проведённые документы периода, у которых нет ни одной проводки в регистре «Хозрасчётный». Часть документов (нулевые суммы) может не формировать проводок законно.",
		Параметры));

	Параметры = Новый Массив;
	Параметры.Добавить(НовыйПараметр("Счет", "Счёт", "Счет", ""));
	Параметры.Добавить(НовыйПараметр("ТипДокумента", "Вид документа (пусто — все)", "ИмяДокумента"));
	Проверки.Добавить(НоваяПроверка("БезПроводокПоСчету", "Нет проводок по счёту",
		"Проведённые документы периода без проводок по выбранному счёту (с учётом субсчетов), например отчёты о розничных продажах без проводок по счёту оплаты картами.",
		Параметры));

	Проверки.Добавить(НоваяПроверка("НДСБезДвижений", "СФ без движений НДС",
		"Проведённые полученные счета-фактуры периода, по которым нет движений в регистре «Движения по НДС»."));

	Параметры = Новый Массив;
	Параметры.Добавить(НовыйПараметр("СчетДт", "Счёт Дт", "Счет", "68.02"));
	Параметры.Добавить(НовыйПараметр("СчетКт", "Счёт Кт", "Счет", "19.03"));
	Проверки.Добавить(НоваяПроверка("ДублиПроводок", "Дубли проводок",
		"Документы, у которых есть полностью одинаковые проводки (период, счета, сумма) по заданной корреспонденции. Пустой счёт — любой.",
		Параметры));

	Проверки.Добавить(НоваяПроверка("ДублиСФ", "Дубли СФ",
		"Документы-основания, на которые оформлено более одного проведённого полученного счёта-фактуры за период."));

	Проверки.Добавить(НоваяПроверка("КорректировочныеСФ", "СФ и исправления",
		"Счета-фактуры по документам, которые исправлены корректировкой приобретения «Исправление ошибок» — риск двойного отражения НДС."));

	Проверки.Добавить(НоваяПроверка("УдаленныеСДвижениями", "Удалённые с движениями",
		"Документы периода, помеченные на удаление, но сохранившие движения в регистрах."));

	Параметры = Новый Массив;
	Параметры.Добавить(НовыйПараметр("Счет", "Счёт", "Счет", "94"));
	Параметры.Добавить(НовыйПараметр("Коэффициент", "Допустимое превышение (коэфф.)", "Число", 1.3));
	Проверки.Добавить(НоваяПроверка("СписанияВРУ", "Суммы списаний в РУ",
		"Списания недостач: оборот по счёту в регистре превышает сумму документа больше, чем в заданное число раз.",
		Параметры));

	Проверки.Добавить(НоваяПроверка("Непроведенные", "Непроведённые документы",
		"Непроведённые документы периода (кроме помеченных на удаление) по всем видам документов с возможностью проведения."));

	Параметры = Новый Массив;
	Параметры.Добавить(НовыйПараметр("Счета", "Счета (коды через запятую)", "Строка", "10,41,43,50,51,52"));
	Проверки.Добавить(НоваяПроверка("КредитовоеСальдо", "Кредитовое сальдо активных",
		"Счета, которые не должны иметь кредитовое сальдо на конец периода (запасы, касса, расчётные счета).",
		Параметры, Ложь));

	Параметры = Новый Массив;
	Параметры.Добавить(НовыйПараметр("Счета", "Счета (коды через запятую)", "Строка", "90,91,25,26"));
	Проверки.Добавить(НоваяПроверка("ОстаткиЗакрытия", "Остатки закрываемых счетов",
		"Остатки на конец периода по счетам, которые должны быть закрыты регламентными операциями.",
		Параметры, Ложь));

	Возврат Проверки;

КонецФункции

#КонецОбласти

#Область СозданиеФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Проверки = ОписаниеПроверок();

	ТипДатаКвал = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипОбъект = Новый ОписаниеТипов(Документы.ТипВсеСсылки(), "ПланСчетовСсылка.Хозрасчетный");
	ТипТЗ = Новый ОписаниеТипов("ТаблицаЗначений");

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"), , "Организация"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаНачала", ТипДатаКвал, , "Начало периода"));
	Реквизиты.Добавить(Новый РеквизитФормы("ДатаОкончания", ТипДатаКвал, , "Конец периода"));

	// Сводка.
	Реквизиты.Добавить(Новый РеквизитФормы("Сводка", ТипТЗ, , "Сводка"));
	Реквизиты.Добавить(Новый РеквизитФормы("Код", ТипСтрока, "Сводка", "Код"));
	Реквизиты.Добавить(Новый РеквизитФормы("Проверка", ТипСтрока, "Сводка", "Проверка"));
	Реквизиты.Добавить(Новый РеквизитФормы("Найдено", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0)), "Сводка", "Найдено"));
	Реквизиты.Добавить(Новый РеквизитФормы("Статус", ТипСтрока, "Сводка", "Статус"));

	// Проверки.
	Для Каждого П Из Проверки Цикл
		ИмяТ = "Т_" + П.Имя;
		Реквизиты.Добавить(Новый РеквизитФормы(ИмяТ, ТипТЗ, , П.Заголовок));
		Реквизиты.Добавить(Новый РеквизитФормы("Объект", ТипОбъект, ИмяТ, "Объект"));
		Реквизиты.Добавить(Новый РеквизитФормы("Проведен", ТипБулево, ИмяТ, "Проведён"));
		Реквизиты.Добавить(Новый РеквизитФормы("Описание", ТипСтрока, ИмяТ, "Описание"));
		Реквизиты.Добавить(Новый РеквизитФормы("Сумма", ТипЧисло, ИмяТ, "Сумма"));
		Для Каждого Пар Из П.Параметры Цикл
			Реквизиты.Добавить(Новый РеквизитФормы("П_" + П.Имя + "_" + Пар.Имя, ТипПараметра(Пар.Тип), , Пар.Заголовок));
		КонецЦикла;
	КонецЦикла;

	// Сверка деклараций НДС.
	СверкаДобавитьРеквизиты(Реквизиты);

	ИзменитьРеквизиты(Реквизиты);

	// Значения по умолчанию.
	ЭтаФорма["ДатаНачала"] = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	ЭтаФорма["ДатаОкончания"] = КонецМесяца(ЭтаФорма["ДатаНачала"]);
	Для Каждого П Из Проверки Цикл
		Для Каждого Пар Из П.Параметры Цикл
			Значение = Пар.Значение;
			Если Пар.Тип = "Счет" Тогда
				Значение = ?(ПустаяСтрока(Значение), ПланыСчетов.Хозрасчетный.ПустаяСсылка(), ПланыСчетов.Хозрасчетный.НайтиПоКоду(Значение));
			КонецЕсли;
			ЭтаФорма["П_" + П.Имя + "_" + Пар.Имя] = Значение;
		КонецЦикла;
		НоваяСтрока = ЭтаФорма["Сводка"].Добавить();
		НоваяСтрока.Код = П.Имя;
		НоваяСтрока.Проверка = П.Заголовок;
		НоваяСтрока.Статус = "Не выполнялась";
	КонецЦикла;

	// Элементы.
	Шапка = Элементы.Добавить("ГруппаШапка", Тип("ГруппаФормы"));
	Шапка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Шапка.Группировка = ГруппировкаГруппыФормы.Горизонтальная;
	Шапка.ОтображатьЗаголовок = Ложь;

	Для Каждого Имя Из СтрРазделить("Организация,ДатаНачала,ДатаОкончания", ",") Цикл
		Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Шапка);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = Имя;
	КонецЦикла;

	КомандаВсе = Команды.Добавить("ВыполнитьВсе");
	КомандаВсе.Действие = "ВыполнитьВсеКоманда";
	КомандаВсе.Заголовок = "Выполнить все проверки";
	Кнопка = Элементы.Добавить("КнопкаВыполнитьВсе", Тип("КнопкаФормы"), Шапка);
	Кнопка.ИмяКоманды = "ВыполнитьВсе";

	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"));
	Страницы.Вид = ВидГруппыФормы.Страницы;

	// Вкладка «Сводка».
	СтрСводка = Элементы.Добавить("Стр_Сводка", Тип("ГруппаФормы"), Страницы);
	СтрСводка.Вид = ВидГруппыФормы.Страница;
	СтрСводка.Заголовок = "Сводка";
	ТабСводка = Элементы.Добавить("ТаблицаСводка", Тип("ТаблицаФормы"), СтрСводка);
	ТабСводка.ПутьКДанным = "Сводка";
	ТабСводка.ТолькоПросмотр = Истина;
	Для Каждого Имя Из СтрРазделить("Проверка,Найдено,Статус", ",") Цикл
		Колонка = Элементы.Добавить("ТаблицаСводка_" + Имя, Тип("ПолеФормы"), ТабСводка);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Сводка." + Имя;
	КонецЦикла;

	// Вкладки проверок.
	Для Каждого П Из Проверки Цикл
		СоздатьВкладкуПроверки(П, Страницы);
	КонецЦикла;

	// Вкладка сверки деклараций.
	СверкаСоздатьЭлементы(Страницы);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипПараметра(Тип)
	Если Тип = "Счет" Тогда
		Возврат Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный");
	ИначеЕсли Тип = "Число" Тогда
		Возврат Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 2));
	КонецЕсли;
	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
КонецФункции

&НаСервере
Процедура СоздатьВкладкуПроверки(П, Страницы)

	Имя = П.Имя;

	Стр = Элементы.Добавить("Стр_" + Имя, Тип("ГруппаФормы"), Страницы);
	Стр.Вид = ВидГруппыФормы.Страница;
	Стр.Заголовок = П.Заголовок;

	Подсказка = Элементы.Добавить("Подсказка_" + Имя, Тип("ДекорацияФормы"), Стр);
	Подсказка.Вид = ВидДекорацииФормы.Надпись;
	Подсказка.Заголовок = П.Подсказка;

	Если П.Параметры.Количество() > 0 Тогда
		ГруппаПар = Элементы.Добавить("Параметры_" + Имя, Тип("ГруппаФормы"), Стр);
		ГруппаПар.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаПар.Группировка = ГруппировкаГруппыФормы.Горизонтальная;
		ГруппаПар.ОтображатьЗаголовок = Ложь;
		Для Каждого Пар Из П.Параметры Цикл
			Поле = Элементы.Добавить("П_" + Имя + "_" + Пар.Имя, Тип("ПолеФормы"), ГруппаПар);
			Поле.Вид = ВидПоляФормы.ПолеВвода;
			Поле.ПутьКДанным = "П_" + Имя + "_" + Пар.Имя;
			Если Пар.Тип = "ИмяДокумента" Тогда
				Поле.РежимВыбораИзСписка = Истина;
				Для Каждого МД Из Метаданные.Документы Цикл
					Поле.СписокВыбора.Добавить(МД.Имя, МД.Представление());
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ГруппаКн = Элементы.Добавить("Кнопки_" + Имя, Тип("ГруппаФормы"), Стр);
	ГруппаКн.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКн.Группировка = ГруппировкаГруппыФормы.Горизонтальная;
	ГруппаКн.ОтображатьЗаголовок = Ложь;

	ДобавитьКнопкуКоманды(ГруппаКн, "Выполнить_" + Имя, "Выполнить проверку", "ВыполнитьПроверкуКоманда");
	Если П.ДействияСДокументами Тогда
		ДобавитьКнопкуКоманды(ГруппаКн, "Провести_" + Имя, "Провести / перепровести (по датам)", "ПровестиКоманда");
		ДобавитьКнопкуКоманды(ГруппаКн, "Очистить_" + Имя, "Очистить движения (проведение сохраняется)", "ОчиститьДвиженияКоманда");
	КонецЕсли;

	Таб = Элементы.Добавить("Таб_" + Имя, Тип("ТаблицаФормы"), Стр);
	Таб.ПутьКДанным = "Т_" + Имя;
	Таб.ТолькоПросмотр = Истина;
	Таб.УстановитьДействие("Выбор", "ТаблицаВыбор");
	Для Каждого Колонка Из СтрРазделить("Объект,Проведен,Описание,Сумма", ",") Цикл
		Поле = Элементы.Добавить("Таб_" + Имя + "_" + Колонка, Тип("ПолеФормы"), Таб);
		Поле.Вид = ?(Колонка = "Проведен", ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода);
		Поле.ПутьКДанным = "Т_" + Имя + "." + Колонка;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопкуКоманды(Родитель, ИмяКоманды, Заголовок, Действие)
	НоваяКоманда = Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = Действие;
	НоваяКоманда.Заголовок = Заголовок;
	Кнопка = Элементы.Добавить("Кнопка_" + ИмяКоманды, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = ИмяКоманды;
КонецПроцедуры

#КонецОбласти

#Область КомандыКлиент

&НаКлиенте
Процедура ВыполнитьВсеКоманда(Команда)
	ВыполнитьВсеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуКоманда(Команда)
	ВыполнитьПроверкуНаСервере(Сред(Команда.Имя, СтрДлина("Выполнить_") + 1));
КонецПроцедуры

&НаКлиенте
Процедура ПровестиКоманда(Команда)
	Имя = Сред(Команда.Имя, СтрДлина("Провести_") + 1);
	ПоказатьВопрос(Новый ОписаниеОповещения("ПровестиЗавершение", ЭтаФорма, Имя),
		"Провести (перепровести) документы, перечисленные на вкладке, в хронологическом порядке?",
		РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПровестиЗавершение(Результат, Имя) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПровестиНаСервере(Имя);
		ВыполнитьПроверкуНаСервере(Имя);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДвиженияКоманда(Команда)
	Имя = Сред(Команда.Имя, СтрДлина("Очистить_") + 1);
	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьДвиженияЗавершение", ЭтаФорма, Имя),
		"Будут очищены движения всех документов на вкладке. Признак проведения останется"
		+ " (это нужно для последующего массового перепроведения). Продолжить?",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДвиженияЗавершение(Результат, Имя) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОчиститьДвиженияНаСервере(Имя);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Элемент.ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Объект) Тогда
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Объект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ВыполнениеПроверок

&НаСервере
Процедура ВыполнитьВсеНаСервере()
	Для Каждого П Из ОписаниеПроверок() Цикл
		ВыполнитьПроверкуНаСервере(П.Имя);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкуНаСервере(Имя)

	Результат = НовыйРезультат();
	Статус = "";
	Попытка
		Результат = ВыполнитьПроверкуПоИмени(Имя);
	Исключение
		Статус = "Ошибка выполнения";
		Сообщить("Проверка «" + Имя + "»: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЭтаФорма["Т_" + Имя].Загрузить(Результат);

	Если Статус = "" Тогда
		Статус = ?(Результат.Количество() > 0, "Найдены замечания", "Замечаний нет");
	КонецЕсли;
	Для Каждого Строка Из ЭтаФорма["Сводка"] Цикл
		Если Строка.Код = Имя Тогда
			Строка.Найдено = Результат.Количество();
			Строка.Статус = Статус;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВыполнитьПроверкуПоИмени(Имя)

	Если Имя = "БезПроводок" Тогда
		Возврат ДокументыБезПроводок("Нет проводок в регистре «Хозрасчётный»", Неопределено, ЗначениеПараметра(Имя, "ТипДокумента"));
	ИначеЕсли Имя = "БезПроводокПоСчету" Тогда
		Счет = ЗначениеПараметра(Имя, "Счет");
		Если Счет.Пустая() Тогда
			ВызватьИсключение "Не заполнен параметр «Счёт».";
		КонецЕсли;
		Возврат ДокументыБезПроводок("Нет проводок по счёту " + Счет.Код, Счет, ЗначениеПараметра(Имя, "ТипДокумента"));
	ИначеЕсли Имя = "НДСБезДвижений" Тогда
		Возврат ПроверкаНДСБезДвижений();
	ИначеЕсли Имя = "ДублиПроводок" Тогда
		Возврат ПроверкаДублиПроводок(ЗначениеПараметра(Имя, "СчетДт"), ЗначениеПараметра(Имя, "СчетКт"));
	ИначеЕсли Имя = "ДублиСФ" Тогда
		Возврат ПроверкаДублиСФ();
	ИначеЕсли Имя = "КорректировочныеСФ" Тогда
		Возврат ПроверкаКорректировочныеСФ();
	ИначеЕсли Имя = "УдаленныеСДвижениями" Тогда
		Возврат ПроверкаУдаленныеСДвижениями();
	ИначеЕсли Имя = "СписанияВРУ" Тогда
		Счет = ЗначениеПараметра(Имя, "Счет");
		Если Счет.Пустая() Тогда
			ВызватьИсключение "Не заполнен параметр «Счёт».";
		КонецЕсли;
		Возврат ПроверкаСписанияВРУ(Счет, ЗначениеПараметра(Имя, "Коэффициент"));
	ИначеЕсли Имя = "Непроведенные" Тогда
		Возврат ПроверкаНепроведенные();
	ИначеЕсли Имя = "КредитовоеСальдо" Тогда
		Возврат ПроверкаОстатков(ЗначениеПараметра(Имя, "Счета"), Истина);
	ИначеЕсли Имя = "ОстаткиЗакрытия" Тогда
		Возврат ПроверкаОстатков(ЗначениеПараметра(Имя, "Счета"), Ложь);
	КонецЕсли;

	ВызватьИсключение "Неизвестная проверка: " + Имя;

КонецФункции

&НаСервере
Функция ЗначениеПараметра(Проверка, Имя)
	Возврат ЭтаФорма["П_" + Проверка + "_" + Имя];
КонецФункции

&НаСервереБезКонтекста
Функция НовыйРезультат()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Объект");
	Результат.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗапросСПараметрами()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаН", НачалоДня(ЭтаФорма["ДатаНачала"]));
	Запрос.УстановитьПараметр("ДатаО", КонецДня(ЭтаФорма["ДатаОкончания"]));
	Запрос.УстановитьПараметр("Организация", ЭтаФорма["Организация"]);
	Возврат Запрос;
КонецФункции

&НаСервере
Функция ЕстьОтборОрганизации()
	Возврат ЗначениеЗаполнено(ЭтаФорма["Организация"]);
КонецФункции

// Условие по организации для запроса документа (с ведущим «И»); пустая строка, если отбора нет.
&НаСервере
Функция УсловиеОрганизации(Псевдоним)
	Возврат ?(ЕстьОтборОрганизации(), " И " + Псевдоним + ".Организация = &Организация", "");
КонецФункции

// Условие по организации для параметра виртуальной таблицы регистра.
&НаСервере
Функция УсловиеОрганизацииРегистра()
	Возврат ?(ЕстьОтборОрганизации(), "Организация = &Организация", "");
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьИзЗапроса(Результат, Запрос)
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
КонецПроцедуры

// Виды документов с проведением; при заданном регистре — только пишущие в него;
// при заполненной организации — только имеющие реквизит «Организация».
&НаСервере
Функция ТипыДокументов(РегистрМД = Неопределено, ИмяДокумента = "")
	Результат = Новый Массив;
	Для Каждого МД Из Метаданные.Документы Цикл
		Если МД.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяДокумента) И МД.Имя <> ИмяДокумента Тогда
			Продолжить;
		КонецЕсли;
		Если РегистрМД <> Неопределено И Не МД.Движения.Содержит(РегистрМД) Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьОтборОрганизации() И МД.Реквизиты.Найти("Организация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(МД);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверки 1 и 2: проведённые документы без проводок (по счёту — если он задан).
&НаСервере
Функция ДокументыБезПроводок(Описание, Счет, ИмяДокумента)

	Результат = НовыйРезультат();
	Запрос = ЗапросСПараметрами();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Описание", Описание);

	Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Х.Регистратор КАК Регистратор ПОМЕСТИТЬ ВТ_Рег
		|ИЗ РегистрБухгалтерии.Хозрасчетный КАК Х
		|ГДЕ Х.Период МЕЖДУ &ДатаН И &ДатаО";
	Если ЕстьОтборОрганизации() Тогда
		Текст = Текст + " И Х.Организация = &Организация";
	КонецЕсли;
	Если Счет <> Неопределено Тогда
		Запрос.УстановитьПараметр("Счет", Счет);
		Текст = Текст + " И (Х.СчетДт В ИЕРАРХИИ(&Счет) ИЛИ Х.СчетКт В ИЕРАРХИИ(&Счет))";
	КонецЕсли;
	Текст = Текст + Символы.ПС + "ИНДЕКСИРОВАТЬ ПО Регистратор";
	Запрос.Текст = Текст;
	Запрос.Выполнить();

	Для Каждого МД Из ТипыДокументов(Метаданные.РегистрыБухгалтерии.Хозрасчетный, ИмяДокумента) Цикл
		Запрос.Текст = "ВЫБРАТЬ Д.Ссылка КАК Объект, Д.Проведен КАК Проведен, &Описание КАК Описание, 0 КАК Сумма
			|ИЗ " + МД.ПолноеИмя() + " КАК Д
			|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Рег КАК Р ПО Д.Ссылка = Р.Регистратор
			|ГДЕ Д.Проведен И Д.Дата МЕЖДУ &ДатаН И &ДатаО И Р.Регистратор ЕСТЬ NULL" + УсловиеОрганизации("Д");
		ДобавитьИзЗапроса(Результат, Запрос);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаНДСБезДвижений()

	Запрос = ЗапросСПараметрами();
	Запрос.УстановитьПараметр("Описание", "Нет движений в регистре «Движения по НДС»");
	Запрос.Текст = "ВЫБРАТЬ Д.Ссылка КАК Объект, Д.Проведен КАК Проведен, &Описание КАК Описание, 0 КАК Сумма
		|ИЗ Документ.СчетФактураПолученный КАК Д
		|ГДЕ Д.Проведен И Д.Дата МЕЖДУ &ДатаН И &ДатаО" + УсловиеОрганизации("Д") + "
		|	И НЕ Д.Ссылка В
		|		(ВЫБРАТЬ Н.Регистратор ИЗ РегистрНакопления.ДвиженияПоНДС КАК Н
		|		ГДЕ Н.Период МЕЖДУ &ДатаН И &ДатаО)";
	Результат = НовыйРезультат();
	ДобавитьИзЗапроса(Результат, Запрос);
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаДублиПроводок(СчетДт, СчетКт)

	Запрос = ЗапросСПараметрами();
	Текст = "ВЫБРАТЬ Х.Регистратор КАК Объект, Х.Регистратор.Проведен КАК Проведен,
		|	""Одинаковых проводок: "" + ВЫРАЗИТЬ(КОЛИЧЕСТВО(*) КАК СТРОКА(10)) КАК Описание,
		|	Х.Сумма КАК Сумма
		|ИЗ РегистрБухгалтерии.Хозрасчетный КАК Х
		|ГДЕ Х.Период МЕЖДУ &ДатаН И &ДатаО И Х.Активность" + УсловиеОрганизации("Х");
	Если Не СчетДт.Пустая() Тогда
		Запрос.УстановитьПараметр("СчетДт", СчетДт);
		Текст = Текст + " И Х.СчетДт В ИЕРАРХИИ(&СчетДт)";
	КонецЕсли;
	Если Не СчетКт.Пустая() Тогда
		Запрос.УстановитьПараметр("СчетКт", СчетКт);
		Текст = Текст + " И Х.СчетКт В ИЕРАРХИИ(&СчетКт)";
	КонецЕсли;
	Текст = Текст + "
		|СГРУППИРОВАТЬ ПО Х.Регистратор, Х.Регистратор.Проведен, Х.СчетДт, Х.СчетКт, Х.Сумма, Х.Период
		|ИМЕЮЩИЕ КОЛИЧЕСТВО(*) > 1";
	Запрос.Текст = Текст;
	Результат = НовыйРезультат();
	ДобавитьИзЗапроса(Результат, Запрос);
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаДублиСФ()

	Запрос = ЗапросСПараметрами();
	Запрос.Текст = "ВЫБРАТЬ О.ДокументОснование КАК Объект, О.ДокументОснование.Проведен КАК Проведен,
		|	""Счетов-фактур по документу: "" + ВЫРАЗИТЬ(КОЛИЧЕСТВО(РАЗЛИЧНЫЕ О.Ссылка) КАК СТРОКА(10)) КАК Описание,
		|	0 КАК Сумма
		|ИЗ Документ.СчетФактураПолученный.ДокументыОснования КАК О
		|ГДЕ О.Ссылка.Проведен И О.Ссылка.Дата МЕЖДУ &ДатаН И &ДатаО" + УсловиеОрганизации("О.Ссылка") + "
		|СГРУППИРОВАТЬ ПО О.ДокументОснование, О.ДокументОснование.Проведен
		|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ О.Ссылка) > 1";
	Результат = НовыйРезультат();
	ДобавитьИзЗапроса(Результат, Запрос);
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаКорректировочныеСФ()

	Запрос = ЗапросСПараметрами();
	Запрос.УстановитьПараметр("ВидКорректировки", Вычислить("Перечисления.ХозяйственныеОперации.ИсправлениеОшибок"));
	Запрос.УстановитьПараметр("Описание", "Документ-основание исправлен корректировкой «Исправление ошибок» — проверьте двойное отражение НДС");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ О.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ ВТ_ПТиУ
		|ИЗ Документ.СчетФактураПолученный.ДокументыОснования КАК О
		|ГДЕ О.Ссылка.Дата МЕЖДУ &ДатаН И &ДатаО" + УсловиеОрганизации("О.Ссылка") + "
		|;
		|ВЫБРАТЬ К.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_КоррПоступления
		|ИЗ Документ.КорректировкаПриобретения КАК К
		|ГДЕ К.ДокументОснование В (ВЫБРАТЬ ВТ_ПТиУ.ДокументОснование ИЗ ВТ_ПТиУ КАК ВТ_ПТиУ)
		|	И К.ВидКорректировки = &ВидКорректировки
		|;
		|ВЫБРАТЬ О.ДокументОснование.ДокументОснование КАК ПТиУ
		|ПОМЕСТИТЬ ПТиУ_Для_СФ
		|ИЗ Документ.СчетФактураПолученный.ДокументыОснования КАК О
		|ГДЕ О.ДокументОснование В (ВЫБРАТЬ ВТ_КоррПоступления.Ссылка ИЗ ВТ_КоррПоступления КАК ВТ_КоррПоступления)
		|	И О.Ссылка.Проведен
		|;
		|ВЫБРАТЬ РАЗЛИЧНЫЕ О.Ссылка КАК Объект, О.Ссылка.Проведен КАК Проведен, &Описание КАК Описание, 0 КАК Сумма
		|ИЗ Документ.СчетФактураПолученный.ДокументыОснования КАК О
		|ГДЕ О.ДокументОснование В (ВЫБРАТЬ ПТиУ_Для_СФ.ПТиУ ИЗ ПТиУ_Для_СФ КАК ПТиУ_Для_СФ)
		|	И О.Ссылка.Проведен";
	Результат = НовыйРезультат();
	ДобавитьИзЗапроса(Результат, Запрос);
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаУдаленныеСДвижениями()

	Результат = НовыйРезультат();
	Запрос = ЗапросСПараметрами();

	Для Каждого МД Из Метаданные.Документы Цикл
		Если МД.Движения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьОтборОрганизации() И МД.Реквизиты.Найти("Организация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запрос.Текст = "ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Проведен КАК Проведен
			|ИЗ " + МД.ПолноеИмя() + " КАК Д
			|ГДЕ Д.ПометкаУдаления И Д.Дата МЕЖДУ &ДатаН И &ДатаО" + УсловиеОрганизации("Д");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.Движения.Прочитать();
			Наборы = "";
			Для Каждого Набор Из Об.Движения Цикл
				Если Набор.Количество() > 0 Тогда
					Наборы = Наборы + ?(Наборы = "", "", ", ") + Набор.Метаданные().Имя;
				КонецЕсли;
			КонецЦикла;
			Если Наборы <> "" Тогда
				Строка = Результат.Добавить();
				Строка.Объект = Выборка.Ссылка;
				Строка.Проведен = Выборка.Проведен;
				Строка.Описание = "Помечен на удаление, есть движения: " + Наборы;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаСписанияВРУ(Счет, Коэффициент)

	Запрос = ЗапросСПараметрами();
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("Коэффициент", Коэффициент);
	Запрос.УстановитьПараметр("Описание", "Оборот по счёту в регистре превышает сумму документа");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ О.Регистратор КАК Регистратор, СУММА(О.СуммаОборотДт) КАК СуммаОборот
		|ПОМЕСТИТЬ ВТ_Списания
		|ИЗ РегистрБухгалтерии.Хозрасчетный.Обороты(&ДатаН, &ДатаО, Регистратор, Счет В ИЕРАРХИИ(&Счет), , "
		+ УсловиеОрганизацииРегистра() + ", , ) КАК О
		|ГДЕ О.Регистратор ССЫЛКА Документ.СписаниеНедостачТоваров
		|СГРУППИРОВАТЬ ПО О.Регистратор
		|;
		|ВЫБРАТЬ Т.Ссылка КАК Ссылка, СУММА(Т.Сумма) КАК Сумма
		|ПОМЕСТИТЬ ВТ_Док
		|ИЗ Документ.СписаниеНедостачТоваров.Товары КАК Т
		|ГДЕ Т.Ссылка В (ВЫБРАТЬ С.Регистратор ИЗ ВТ_Списания КАК С)
		|СГРУППИРОВАТЬ ПО Т.Ссылка
		|;
		|ВЫБРАТЬ С.Регистратор КАК Объект, С.Регистратор.Проведен КАК Проведен, &Описание КАК Описание,
		|	С.СуммаОборот - ЕСТЬNULL(Д.Сумма, 0) КАК Сумма
		|ИЗ ВТ_Списания КАК С
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Док КАК Д ПО С.Регистратор = Д.Ссылка
		|ГДЕ С.СуммаОборот > ЕСТЬNULL(Д.Сумма, 0) * &Коэффициент";
	Результат = НовыйРезультат();
	ДобавитьИзЗапроса(Результат, Запрос);
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаНепроведенные()

	Результат = НовыйРезультат();
	Запрос = ЗапросСПараметрами();
	Запрос.УстановитьПараметр("Описание", "Документ не проведён");
	Для Каждого МД Из ТипыДокументов() Цикл
		Запрос.Текст = "ВЫБРАТЬ Д.Ссылка КАК Объект, Д.Проведен КАК Проведен, &Описание КАК Описание, 0 КАК Сумма
			|ИЗ " + МД.ПолноеИмя() + " КАК Д
			|ГДЕ НЕ Д.Проведен И НЕ Д.ПометкаУдаления И Д.Дата МЕЖДУ &ДатаН И &ДатаО" + УсловиеОрганизации("Д");
		ДобавитьИзЗапроса(Результат, Запрос);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция СчетаИзСтроки(Знач Строка)
	Результат = Новый Массив;
	Для Каждого Код Из СтрРазделить(Строка, ",", Ложь) Цикл
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(Код));
		Если Счет.Пустая() Тогда
			Сообщить("Счёт не найден: " + СокрЛП(Код));
		Иначе
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Остатки на конец периода. ТолькоКредитовое — искать кредитовое сальдо; иначе — любое ненулевое.
&НаСервере
Функция ПроверкаОстатков(КодыСчетов, ТолькоКредитовое)

	Счета = СчетаИзСтроки(КодыСчетов);
	Если Счета.Количество() = 0 Тогда
		ВызватьИсключение "Не заданы счета для проверки.";
	КонецЕсли;

	Запрос = ЗапросСПараметрами();
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.Текст = "ВЫБРАТЬ О.Счет КАК Объект, ИСТИНА КАК Проведен,
		|	" + ?(ТолькоКредитовое, """Кредитовое сальдо""", """Остаток не закрыт""")
		+ " + "" (организация: "" + ПРЕДСТАВЛЕНИЕ(О.Организация) + "")"" КАК Описание,
		|	О.СуммаОстатокДт - О.СуммаОстатокКт КАК Сумма
		|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&ДатаО, Счет В ИЕРАРХИИ(&Счета), , "
		+ УсловиеОрганизацииРегистра() + ") КАК О
		|ГДЕ " + ?(ТолькоКредитовое, "О.СуммаОстатокКт > 0", "(О.СуммаОстатокДт <> 0 ИЛИ О.СуммаОстатокКт <> 0)");
	Результат = НовыйРезультат();
	ДобавитьИзЗапроса(Результат, Запрос);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДействияСДокументами

// Документы вкладки (только ссылки на документы), по возрастанию даты.
&НаСервере
Функция ДокументыВкладкиПоДатам(Имя)

	ТипыДок = Документы.ТипВсеСсылки();
	Список = Новый ТаблицаЗначений;
	Список.Колонки.Добавить("Документ");
	Список.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Уникальные = Новый Соответствие;
	Для Каждого Строка Из ЭтаФорма["Т_" + Имя] Цикл
		Если Не ТипыДок.СодержитТип(ТипЗнч(Строка.Объект)) Или Уникальные[Строка.Объект] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уникальные[Строка.Объект] = Истина;
		Новая = Список.Добавить();
		Новая.Документ = Строка.Объект;
		Новая.Дата = Строка.Объект.Дата;
	КонецЦикла;
	Список.Сортировать("Дата");
	Возврат Список;

КонецФункции

&НаСервере
Процедура ПровестиНаСервере(Имя)

	Обработано = 0;
	Ошибок = 0;
	Для Каждого Запись Из ДокументыВкладкиПоДатам(Имя) Цикл
		Попытка
			Об = Запись.Документ.ПолучитьОбъект();
			Если Об.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			Об.Записать(РежимЗаписиДокумента.Проведение);
			Обработано = Обработано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить(Строка(Запись.Документ) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Сообщить("Проведено документов: " + Обработано + ", ошибок: " + Ошибок);

КонецПроцедуры

// Очищает движения документов, не снимая признак проведения: так последующее массовое
// перепроведение не удаляет и не пересоздаёт лишнего. Каждый документ — в своей транзакции.
&НаСервере
Процедура ОчиститьДвиженияНаСервере(Имя)

	Обработано = 0;
	Ошибок = 0;
	Для Каждого Запись Из ДокументыВкладкиПоДатам(Имя) Цикл
		НачатьТранзакцию();
		Попытка
			Об = Запись.Документ.ПолучитьОбъект();
			Об.Движения.Прочитать();
			Для Каждого Набор Из Об.Движения Цикл
				Набор.Записывать = Истина;
				Набор.Очистить();
			КонецЦикла;
			Об.Движения.Записать();
			ЗафиксироватьТранзакцию();
			Обработано = Обработано + 1;
		Исключение
			ОтменитьТранзакцию();
			Ошибок = Ошибок + 1;
			Сообщить(Строка(Запись.Документ) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Сообщить("Очищены движения документов: " + Обработано + ", ошибок: " + Ошибок);

КонецПроцедуры

#КонецОбласти

#Область СверкаДеклараций

// Порт веб-сверки деклараций НДС (раздел 8 книги покупок / раздел 9, код операции 18 /
// реестр счетов-фактур / журнал документов). Источник — Excel-файлы (xlsx, xls).

&НаСервереБезКонтекста
Функция СверкаКолонкиДанных()
	// Имя, Тип: С — строка, Ч — число, Б — булево.
	Возврат "НомерСтроки:Ч,КодОперации:С,СФ:С,Исправление:С,КСФ:С,ДатаПринятия:С,Продавец:С,ИННКПП:С,"
		+ "Стоимость:Ч,СтоимостьЕсть:Б,НДС:Ч,НДСЕсть:Б,Раздел:Ч,Реестр:Б,Ключ:С,ПолныйКлюч:С";
КонецФункции

&НаСервереБезКонтекста
Функция СверкаКолонкиРезультата()
	Возврат "Группа:Ч,Номер1:Ч,Номер2:Ч,СФ1:С,СФ2:С,Дата1:С,Дата2:С,Продавец1:С,Продавец2:С,"
		+ "ИННКПП1:С,ИННКПП2:С,Стоимость1:Ч,Стоимость2:Ч,РазницаСтоимости:Ч,НДС1:Ч,НДС2:Ч,РазницаНДС:Ч,"
		+ "Отличия:С,Примечание:С";
КонецФункции

&НаСервереБезКонтекста
Функция СверкаТипКолонки(Код)
	Если Код = "Ч" Тогда
		Возврат Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2));
	ИначеЕсли Код = "Б" Тогда
		Возврат Новый ОписаниеТипов("Булево");
	КонецЕсли;
	Возврат Новый ОписаниеТипов("Строка");
КонецФункции

&НаСервереБезКонтекста
Функция СверкаТаблицы()
	// Имя реквизита и заголовок вкладки.
	Результат = Новый Структура;
	Результат.Вставить("СверкаРазличия", "Различия");
	Результат.Вставить("СверкаТолько1", "Только в 1");
	Результат.Вставить("СверкаТолько2", "Только во 2");
	Результат.Вставить("СверкаСовпадают", "Совпадают");
	Результат.Вставить("СверкаДубли", "Дубли");
	Возврат Результат;
КонецФункции

&НаСервере
Процедура СверкаДобавитьРеквизиты(Реквизиты)

	ТипТЗ = Новый ОписаниеТипов("ТаблицаЗначений");
	ТипСтрока = Новый ОписаниеТипов("Строка");

	Для Номер = 1 По 2 Цикл
		ИмяТ = "СверкаДанные" + Номер;
		Реквизиты.Добавить(Новый РеквизитФормы(ИмяТ, ТипТЗ, , "Данные " + Номер));
		Для Каждого Описание Из СтрРазделить(СверкаКолонкиДанных(), ",") Цикл
			Части = СтрРазделить(Описание, ":");
			Реквизиты.Добавить(Новый РеквизитФормы(Части[0], СверкаТипКолонки(Части[1]), ИмяТ));
		КонецЦикла;
		Реквизиты.Добавить(Новый РеквизитФормы("СверкаИнфо" + Номер, ТипСтрока, , "Загружено"));
	КонецЦикла;

	Реквизиты.Добавить(Новый РеквизитФормы("СверкаСводка", ТипСтрока, , "Сводка"));

	Для Каждого КлючЗначение Из СверкаТаблицы() Цикл
		ИмяТ = КлючЗначение.Ключ;
		Реквизиты.Добавить(Новый РеквизитФормы(ИмяТ, ТипТЗ, , КлючЗначение.Значение));
		Для Каждого Описание Из СтрРазделить(СверкаКолонкиРезультата(), ",") Цикл
			Части = СтрРазделить(Описание, ":");
			Реквизиты.Добавить(Новый РеквизитФормы(Части[0], СверкаТипКолонки(Части[1]), ИмяТ));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СверкаСоздатьЭлементы(Страницы)

	Стр = Элементы.Добавить("Стр_Сверка", Тип("ГруппаФормы"), Страницы);
	Стр.Вид = ВидГруппыФормы.Страница;
	Стр.Заголовок = "Сверка деклараций НДС";

	Подсказка = Элементы.Добавить("Подсказка_Сверка", Тип("ДекорацияФормы"), Стр);
	Подсказка.Вид = ВидДекорацииФормы.Надпись;
	Подсказка.Заголовок = "Загрузите Excel-файлы: декларацию (раздел 8 — книга покупок; раздел 9 можно добавить в то же поле — "
		+ "учитываются только строки с кодом 18) и вторую декларацию либо реестр / журнал полученных счетов-фактур. "
		+ "Если декларация выгружена частями — выберите все файлы сразу, они объединятся.";

	// Две области загрузки.
	ГруппаФайлы = Элементы.Добавить("Сверка_Файлы", Тип("ГруппаФормы"), Стр);
	ГруппаФайлы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаФайлы.Группировка = ГруппировкаГруппыФормы.Горизонтальная;
	ГруппаФайлы.ОтображатьЗаголовок = Ложь;
	Для Номер = 1 По 2 Цикл
		Колонка = Элементы.Добавить("Сверка_Файл" + Номер, Тип("ГруппаФормы"), ГруппаФайлы);
		Колонка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Колонка.Группировка = ГруппировкаГруппыФормы.Вертикальная;
		Колонка.Заголовок = ?(Номер = 1, "Декларация 1 (эталон)", "Декларация 2 или реестр счетов-фактур");
		ДобавитьКнопкуКоманды(Колонка, "СверкаЗагрузить" + Номер, "Выбрать файл(ы)…", "СверкаЗагрузитьКоманда");
		Инфо = Элементы.Добавить("СверкаИнфо" + Номер, Тип("ПолеФормы"), Колонка);
		Инфо.Вид = ВидПоляФормы.ПолеНадпись;
		Инфо.ПутьКДанным = "СверкаИнфо" + Номер;
		Инфо.ОтображатьЗаголовок = Ложь;
		ЭтаФорма["СверкаИнфо" + Номер] = "Файлы не загружены";
	КонецЦикла;

	ГруппаКн = Элементы.Добавить("Сверка_Кнопки", Тип("ГруппаФормы"), Стр);
	ГруппаКн.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКн.Группировка = ГруппировкаГруппыФормы.Горизонтальная;
	ГруппаКн.ОтображатьЗаголовок = Ложь;
	ДобавитьКнопкуКоманды(ГруппаКн, "СверкаСравнить", "Сравнить декларации", "СверкаСравнитьКоманда");
	ДобавитьКнопкуКоманды(ГруппаКн, "СверкаДубли", "Найти дубли (загруженные файлы)", "СверкаДублиКоманда");
	ДобавитьКнопкуКоманды(ГруппаКн, "СверкаЭкспорт", "Экспорт в Excel", "СверкаЭкспортКоманда");

	Сводка = Элементы.Добавить("СверкаСводка", Тип("ПолеФормы"), Стр);
	Сводка.Вид = ВидПоляФормы.ПолеНадпись;
	Сводка.ПутьКДанным = "СверкаСводка";
	Сводка.ОтображатьЗаголовок = Ложь;

	// Вложенные вкладки результата.
	Подстраницы = Элементы.Добавить("Сверка_Страницы", Тип("ГруппаФормы"), Стр);
	Подстраницы.Вид = ВидГруппыФормы.Страницы;

	Колонки = Новый Структура;
	Колонки.Вставить("СверкаСовпадают", "Номер1,СФ1,Дата1,Продавец1,ИННКПП1,Стоимость1,НДС1");
	Колонки.Вставить("СверкаРазличия", "Номер1,Номер2,СФ1,СФ2,Дата1,Дата2,Продавец1,Продавец2,ИННКПП1,ИННКПП2,"
		+ "Стоимость1,Стоимость2,РазницаСтоимости,НДС1,НДС2,РазницаНДС,Отличия");
	Колонки.Вставить("СверкаТолько1", "Номер1,СФ1,Дата1,Продавец1,ИННКПП1,Стоимость1,НДС1,Примечание");
	Колонки.Вставить("СверкаТолько2", "Номер2,СФ2,Дата2,Продавец2,ИННКПП2,Стоимость2,НДС2,Примечание");
	Колонки.Вставить("СверкаДубли", "Группа,Номер1,СФ1,Дата1,Продавец1,ИННКПП1,Стоимость1,НДС1,Примечание");

	Заголовки = Новый Структура("Группа, Номер1, Номер2, СФ1, СФ2, Дата1, Дата2, Продавец1, Продавец2, ИННКПП1, ИННКПП2, "
		+ "Стоимость1, Стоимость2, РазницаСтоимости, НДС1, НДС2, РазницаНДС, Отличия, Примечание",
		"Группа", "№ п/п (1)", "№ п/п (2)", "Счёт-фактура (1)", "Счёт-фактура (2)", "Дата принятия (1)", "Дата принятия (2)",
		"Продавец (1)", "Продавец (2)", "ИНН/КПП (1)", "ИНН/КПП (2)", "Стоимость (1)", "Стоимость (2)", "Разница стоимости",
		"НДС (1)", "НДС (2)", "Разница НДС", "Что отличается", "Примечание");

	// Порядок вкладок: сначала то, что требует внимания.
	Для Каждого КлючЗначение Из СверкаТаблицы() Цикл
		ИмяТ = КлючЗначение.Ключ;
		Подстр = Элементы.Добавить("Стр_" + ИмяТ, Тип("ГруппаФормы"), Подстраницы);
		Подстр.Вид = ВидГруппыФормы.Страница;
		Подстр.Заголовок = КлючЗначение.Значение;
		Таб = Элементы.Добавить("Таб_" + ИмяТ, Тип("ТаблицаФормы"), Подстр);
		Таб.ПутьКДанным = ИмяТ;
		Таб.ТолькоПросмотр = Истина;
		Для Каждого Колонка Из СтрРазделить(Колонки[ИмяТ], ",") Цикл
			Поле = Элементы.Добавить("Таб_" + ИмяТ + "_" + Колонка, Тип("ПолеФормы"), Таб);
			Поле.Вид = ВидПоляФормы.ПолеВвода;
			Поле.ПутьКДанным = ИмяТ + "." + Колонка;
			Поле.Заголовок = Заголовки[Колонка];
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#Область СверкаКлиент

&НаКлиенте
Процедура СверкаЗагрузитьКоманда(Команда)
	Номер = Число(Сред(Команда.Имя, СтрДлина("СверкаЗагрузить") + 1));
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файлы Excel";
	Диалог.МножественныйВыбор = Истина;
	Диалог.Фильтр = "Файлы Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	НачатьПомещениеФайлов(Новый ОписаниеОповещения("СверкаФайлыПомещены", ЭтаФорма, Номер), , Диалог, Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура СверкаФайлыПомещены(Файлы, Номер) Экспорт
	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Список = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Список.Добавить(Новый Структура("Имя, Адрес", Файл.Имя, Файл.Хранение));
	КонецЦикла;
	СверкаЗагрузитьНаСервере(Номер, Список);
КонецПроцедуры

&НаКлиенте
Процедура СверкаСравнитьКоманда(Команда)
	СверкаСравнитьНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура СверкаДублиКоманда(Команда)
	СверкаСравнитьНаСервере(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СверкаЭкспортКоманда(Команда)
	Адрес = СверкаЭкспортНаСервере();
	Если Адрес <> Неопределено Тогда
		ПолучитьФайл(Адрес, "Сверка деклараций НДС.xlsx", Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СверкаРазборФайлов

// ---- Простые помощники ----

&НаСервереБезКонтекста
Функция ТекстЗнч(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

&НаСервереБезКонтекста
Функция НормСтр(Значение)
	Текст = НРег(ТекстЗнч(Значение));
	Для Каждого Символ Из СтрРазделить(Символы.НПП + "," + Символы.Таб + "," + Символы.ПС + "," + Символы.ВК, ",") Цикл
		Текст = СтрЗаменить(Текст, Символ, " ");
	КонецЦикла;
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Текст);
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзЗначения(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстЗнч(Значение), Символы.НПП, ""), " ", ""), ",", ".");
	Если Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ТолькоЦифры(Текст)
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Значение ячейки: число — числом, дата — строкой дд.мм.гггг, остальное — строкой; пусто — Неопределено.
&НаСервереБезКонтекста
Функция Яч(Док, Строка, Колонка)
	Область = Док.Область(Строка, Колонка);
	Значение = Область.Значение;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Текст = СокрЛП(Область.Текст);
	Если Текст = "" И ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = СокрЛП(Значение);
	КонецЕсли;
	Возврат ?(Текст = "", Неопределено, Текст);
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоДатаДДММГГГГ(Текст)
	Если СтрДлина(Текст) <> 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По 10 Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Индекс = 3 Или Индекс = 6 Тогда
			Если Символ <> "." Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// «ЮП-92520 от 26.03.2026» -> «юп-92520» (дата в конце номера отбрасывается).
&НаСервереБезКонтекста
Функция НомерБезДаты(Значение)
	Текст = НормСтр(Значение);
	Для Вхождение = 1 По 20 Цикл
		Позиция = СтрНайти(Текст, " от ", , , Вхождение);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ЭтоДатаДДММГГГГ(Сред(Текст, Позиция + 4, 10)) Тогда
			Возврат СокрЛП(Лев(Текст, Позиция - 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьКСФ(Строка)
	Возврат СокрЛП(Строка.КСФ) <> "";
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоИсправлениеНомер1(Строка)
	Текст = СокрЛП(Строка.Исправление);
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;
	Возврат Цифры = "1";
КонецФункции

&НаСервереБезКонтекста
Функция НомерЭффективный(Строка)
	Возврат ?(ЕстьКСФ(Строка), НомерБезДаты(Строка.КСФ), НомерБезДаты(Строка.СФ));
КонецФункции

&НаСервереБезКонтекста
Функция НормПродавец(Знач Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Текст = ВРег(ТекстЗнч(Имя));
	Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789";
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Результат = Результат + ?(СтрНайти(Допустимые, Символ) > 0, Символ, " ");
	КонецЦикла;
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);
КонецФункции

&НаСервереБезКонтекста
Функция ТокеныПродавца(Имя)
	ОргФормы = ",ООО,ОАО,ЗАО,ПАО,НАО,АО,ИП,ГК,ТД,ТОРГОВЫЙ,ДОМ,КОМПАНИЯ,ФИРМА,ГРУПП,ГРУППА,";
	Результат = Новый Массив;
	Для Каждого Токен Из СтрРазделить(НормПродавец(Имя), " ", Ложь) Цикл
		Если СтрНайти(ОргФормы, "," + Токен + ",") = 0 Тогда
			Результат.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПродавцыПохожи(Имя1, Имя2)
	А = ТокеныПродавца(Имя1);
	Б = ТокеныПродавца(Имя2);
	Если А.Количество() = 0 Или Б.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	МножествоБ = Новый Соответствие;
	Для Каждого Токен Из Б Цикл
		МножествоБ[Токен] = Истина;
	КонецЦикла;
	Для Каждого Токен Из А Цикл
		Если СтрДлина(Токен) >= 2 И МножествоБ[Токен] <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция НоваяТаблицаДанных()
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Описание Из СтрРазделить(СверкаКолонкиДанных(), ",") Цикл
		Части = СтрРазделить(Описание, ":");
		Таблица.Колонки.Добавить(Части[0], СверкаТипКолонки(Части[1]));
	КонецЦикла;
	Возврат Таблица;
КонецФункции

// ---- Определение формата и разбор ----

&НаСервереБезКонтекста
Функция ФорматКниги(Док)
	А1 = НРег(ТекстЗнч(Яч(Док, 1, 1)));
	Б1 = НРег(ТекстЗнч(Яч(Док, 1, 2)));
	В1 = НРег(ТекстЗнч(Яч(Док, 1, 3)));
	Если А1 = "номер" И Б1 = "дата" И СтрНачинаетсяС(В1, "вид документ") Тогда
		Возврат "журнал";
	ИначеЕсли А1 = "номер" И СтрНачинаетсяС(Б1, "дата состав") Тогда
		Возврат "реестр";
	ИначеЕсли СтрНачинаетсяС(А1, "раздел 9") Тогда
		Возврат "раздел9";
	КонецЕсли;
	Возврат "декларация";
КонецФункции

&НаСервереБезКонтекста
Функция КартаЗаголовков(Док)
	Карта = Новый Соответствие;
	Для Колонка = 1 По Док.ШиринаТаблицы Цикл
		Текст = НРег(ТекстЗнч(Яч(Док, 1, Колонка)));
		Если Текст <> "" И Карта[Текст] = Неопределено Тогда
			Карта[Текст] = Колонка;
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;
КонецФункции

&НаСервереБезКонтекста
Функция НоваяСтрокаДанных(Таблица, НомерСтроки, КодОперации, СФ, Исправление, КСФ, Дата, Продавец, ИННКПП, Стоимость, НДС, Раздел, Реестр, Ключ, ПолныйКлюч)
	Строка = Таблица.Добавить();
	Строка.НомерСтроки = НомерСтроки;
	Строка.КодОперации = КодОперации;
	Строка.СФ = СФ;
	Строка.Исправление = Исправление;
	Строка.КСФ = КСФ;
	Строка.ДатаПринятия = Дата;
	Строка.Продавец = Продавец;
	Строка.ИННКПП = ИННКПП;
	Строка.СтоимостьЕсть = (Стоимость <> Неопределено);
	Строка.Стоимость = ?(Строка.СтоимостьЕсть, Стоимость, 0);
	Строка.НДСЕсть = (НДС <> Неопределено);
	Строка.НДС = ?(Строка.НДСЕсть, НДС, 0);
	Строка.Раздел = Раздел;
	Строка.Реестр = Реестр;
	Строка.Ключ = Ключ;
	Строка.ПолныйКлюч = ПолныйКлюч;
	Возврат Строка;
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьДекларацию(Док, Таблица)
	Для Р = 1 По Док.ВысотаТаблицы Цикл
		Значение = Яч(Док, Р, 1);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Номер = Значение;
		Иначе
			Цифры = "";
			Текст = ТекстЗнч(Значение);
			Для Индекс = 1 По СтрДлина(Текст) Цикл
				Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
					Прервать;
				КонецЕсли;
				Цифры = Цифры + Сред(Текст, Индекс, 1);
			КонецЦикла;
			Если Цифры = "" Тогда
				Продолжить;
			КонецЕсли;
			Номер = Число(Цифры);
		КонецЕсли;
		Если Номер < 1 Тогда
			Продолжить;
		КонецЕсли;
		// Шапки и строки номеров граф отсеиваем по двузначному коду вида операции.
		Код = ТекстЗнч(Яч(Док, Р, 2));
		Если СтрДлина(Код) <> 2 Или Не ТолькоЦифры(Код) Тогда
			Продолжить;
		КонецЕсли;
		СФ = ТекстЗнч(Яч(Док, Р, 3));
		Продавец = ТекстЗнч(Яч(Док, Р, 25));
		ИННКПП = ТекстЗнч(Яч(Док, Р, 26));
		НоваяСтрокаДанных(Таблица, Номер, Код, СФ, ТекстЗнч(Яч(Док, Р, 5)), ТекстЗнч(Яч(Док, Р, 7)),
			ТекстЗнч(Яч(Док, Р, 23)), Продавец, ИННКПП,
			ПриведениеЧисла(Яч(Док, Р, 32)), ПриведениеЧисла(Яч(Док, Р, 33)), 8, Ложь,
			СФ + "|" + Продавец + "|" + ИННКПП, "");
	КонецЦикла;
КонецФункции

// Число или Неопределено; нечисловой непустой текст трактуется как 0 (как parseFloat(...) || 0).
&НаСервереБезКонтекста
Функция ПриведениеЧисла(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = ЧислоИзЗначения(Значение);
	Возврат ?(Результат = Неопределено, 0, Результат);
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьРаздел9(Док, Таблица)
	Счетчик = 0;
	Для Р = 1 По Док.ВысотаТаблицы Цикл
		Если Не ТолькоЦифры(ТекстЗнч(Яч(Док, Р, 1))) Тогда
			Продолжить;
		КонецЕсли;
		Если ТекстЗнч(Яч(Док, Р, 3)) <> "18" Тогда
			Продолжить;
		КонецЕсли;
		СФ = ТекстЗнч(Яч(Док, Р, 5));
		КСФ = ТекстЗнч(Яч(Док, Р, 10));
		Стоимость = Яч(Док, Р, 35);
		НДС = Неопределено;
		Для Каждого Колонка Из СтрРазделить("48,50,53,55,58", ",") Цикл
			Кандидат = Яч(Док, Р, Число(Колонка));
			Если Кандидат <> Неопределено Тогда
				НДС = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Счетчик = Счетчик + 1;
		НоваяСтрокаДанных(Таблица, Счетчик, "18", СФ, ТекстЗнч(Яч(Док, Р, 9)), КСФ, "", "", "",
			?(ТипЗнч(Стоимость) = Тип("Число"), Стоимость, Неопределено),
			?(ТипЗнч(НДС) = Тип("Число"), НДС, Неопределено), 9, Ложь,
			СФ + "|разд9|" + КСФ, "");
	КонецЦикла;
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьРеестр(Док, Таблица)
	Карта = КартаЗаголовков(Док);
	КолНомер = Карта["номер"];
	КолДата = Карта["дата составления"];
	КолИсправНом = Карта["номер исправления"];
	КолИсправДата = Карта["дата исправления"];
	КолКорр = Карта["корректировочный"];
	Если КолНомер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Счетчик = 0;
	Для Р = 2 По Док.ВысотаТаблицы Цикл
		Номер = ТекстЗнч(Яч(Док, Р, КолНомер));
		Если Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		ДатаТекст = ?(КолДата = Неопределено, "", ТекстЗнч(Яч(Док, Р, КолДата)));
		ЭтоКСФ = КолКорр <> Неопределено И НРег(ТекстЗнч(Яч(Док, Р, КолКорр))) = "да";
		СФ = ?(ДатаТекст <> "", Номер + " от " + ДатаТекст, Номер);

		ИспрНомер = ?(КолИсправНом = Неопределено, "", ТекстЗнч(Яч(Док, Р, КолИсправНом)));
		ИспрДата = ?(КолИсправДата = Неопределено, "", ТекстЗнч(Яч(Док, Р, КолИсправДата)));
		Исправление = ?(ИспрНомер <> "", ИспрНомер + ?(ИспрДата <> "", " от " + ИспрДата, ""), "");

		Счетчик = Счетчик + 1;
		НоваяСтрокаДанных(Таблица, Счетчик, "", СФ, Исправление, ?(ЭтоКСФ, СФ, ""), ДатаТекст, "", "", Неопределено, Неопределено,
			0, Истина, "reg|" + НомерБезДаты(СФ), СФ + "~" + Исправление + "~" + ?(ЭтоКСФ, "да", "нет"));
	КонецЦикла;
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьЖурнал(Док, Таблица)
	Карта = КартаЗаголовков(Док);
	КолВид = Карта["вид документа"];
	КолОперация = Карта["хоз. операция"];
	КолНомер = Карта["номер входящего документа"];
	КолДата = Карта["дата входящего документа"];
	КолСумма = Карта["сумма"];
	КолПоставщик = Карта["поставщик"];
	Если КолВид = Неопределено Или КолНомер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Счетчик = 0;
	Для Р = 2 По Док.ВысотаТаблицы Цикл
		Если НРег(ТекстЗнч(Яч(Док, Р, КолВид))) <> "счет-фактура полученный" Тогда
			Продолжить;
		КонецЕсли;
		Если КолОперация <> Неопределено И СтрНайти(НРег(ТекстЗнч(Яч(Док, Р, КолОперация))), "возврат") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Номер = ТекстЗнч(Яч(Док, Р, КолНомер));
		Если Номер = "" Тогда
			Продолжить;
		КонецЕсли;
		ДатаТекст = ?(КолДата = Неопределено, "", ТекстЗнч(Яч(Док, Р, КолДата)));
		Пробел = СтрНайти(ДатаТекст, " ");
		Если Пробел > 0 Тогда
			ДатаТекст = Лев(ДатаТекст, Пробел - 1);
		КонецЕсли;
		СФ = ?(ДатаТекст <> "", Номер + " от " + ДатаТекст, Номер);
		СуммаСырая = ?(КолСумма = Неопределено, Неопределено, Яч(Док, Р, КолСумма));
		Поставщик = ?(КолПоставщик = Неопределено, "", ТекстЗнч(Яч(Док, Р, КолПоставщик)));

		Счетчик = Счетчик + 1;
		НоваяСтрокаДанных(Таблица, Счетчик, "", СФ, "", "", ДатаТекст, Поставщик, "", ЧислоИзЗначения(СуммаСырая), Неопределено,
			0, Истина, "reg|" + НомерБезДаты(СФ), СФ + "~" + Поставщик + "~" + ТекстЗнч(СуммаСырая));
	КонецЦикла;
КонецФункции

&НаСервере
Процедура СверкаЗагрузитьНаСервере(Номер, Файлы)

	Все = НоваяТаблицаДанных();
	Описания = Новый Массив;
	Форматы = Новый Соответствие;

	Для Каждого Файл Из Файлы Цикл
		Расширение = ?(НРег(Прав(Файл.Имя, 4)) = ".xls", ".xls", ".xlsx");
		ИмяВремФайла = ПолучитьИмяВременногоФайла(Расширение);
		Попытка
			ПолучитьИзВременногоХранилища(Файл.Адрес).Записать(ИмяВремФайла);
			Док = Новый ТабличныйДокумент;
			Док.Прочитать(ИмяВремФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		Исключение
			УдалитьФайлы(ИмяВремФайла);
			Сообщить("Не удалось прочитать файл " + Файл.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		УдалитьФайлы(ИмяВремФайла);

		ВидФайла = ФорматКниги(Док);
		Часть = НоваяТаблицаДанных();
		Если ВидФайла = "реестр" Тогда
			РазобратьРеестр(Док, Часть);
		ИначеЕсли ВидФайла = "журнал" Тогда
			РазобратьЖурнал(Док, Часть);
		ИначеЕсли ВидФайла = "раздел9" Тогда
			РазобратьРаздел9(Док, Часть);
		Иначе
			РазобратьДекларацию(Док, Часть);
		КонецЕсли;
		Форматы[ВидФайла] = Истина;
		Описания.Добавить(Файл.Имя + " — " + Часть.Количество() + " зап. (" + ПредставлениеФормата(ВидФайла) + ")");
		Для Каждого Строка Из Часть Цикл
			ЗаполнитьЗначенияСвойств(Все.Добавить(), Строка);
		КонецЦикла;
	КонецЦикла;

	Если Описания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЕстьРеестр = Форматы["реестр"] <> Неопределено Или Форматы["журнал"] <> Неопределено;
	ЕстьДекл = Форматы["декларация"] <> Неопределено Или Форматы["раздел9"] <> Неопределено;
	ЕстьОба = Форматы["декларация"] <> Неопределено И Форматы["раздел9"] <> Неопределено;

	// Объединение: убираем повторы (тот же файл выбран дважды / пересекающиеся выгрузки реестра).
	Видели = Новый Соответствие;
	Данные = НоваяТаблицаДанных();
	Для Каждого Строка Из Все Цикл
		КлючПовтора = ?(Строка.Реестр, "c|" + Строка.ПолныйКлюч, Формат(Строка.НомерСтроки, "ЧГ=0") + "|" + Строка.Ключ);
		Если Видели[КлючПовтора] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Видели[КлючПовтора] = Истина;
		ЗаполнитьЗначенияСвойств(Данные.Добавить(), Строка);
	КонецЦикла;
	Если ЕстьРеестр Или ЕстьОба Тогда
		Для Индекс = 0 По Данные.Количество() - 1 Цикл
			Данные[Индекс].НомерСтроки = Индекс + 1;
		КонецЦикла;
	Иначе
		Данные.Сортировать("НомерСтроки");
	КонецЕсли;

	ЭтаФорма["СверкаДанные" + Номер].Загрузить(Данные);

	Инфо = "Файлов: " + Описания.Количество() + Символы.ПС + СтрСоединить(Описания, Символы.ПС) + Символы.ПС
		+ "Всего записей: " + Данные.Количество();
	Если Все.Количество() <> Данные.Количество() Тогда
		Инфо = Инфо + " (удалено повторов при объединении: " + (Все.Количество() - Данные.Количество()) + ")";
	КонецЕсли;
	Если ЕстьРеестр И ЕстьДекл Тогда
		Инфо = Инфо + Символы.ПС + "ВНИМАНИЕ: в одном поле смешаны декларация/раздел 9 и реестр — загрузите их в разные поля.";
	КонецЕсли;
	ЭтаФорма["СверкаИнфо" + Номер] = Инфо;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеФормата(ВидФайла)
	Если ВидФайла = "реестр" Тогда
		Возврат "реестр СФ";
	ИначеЕсли ВидФайла = "журнал" Тогда
		Возврат "реестр СФ (с суммами)";
	ИначеЕсли ВидФайла = "раздел9" Тогда
		Возврат "раздел 9, код 18";
	КонецЕсли;
	Возврат "декларация, раздел 8";
КонецФункции

#КонецОбласти

#Область СверкаСравнение

&НаСервереБезКонтекста
Функция Окр2(Значение)
	Возврат Окр(?(Значение = Неопределено, 0, Значение), 2);
КонецФункции

// Группировка по ключу без пустых ключей; порядок строк внутри группы сохраняется.
&НаСервереБезКонтекста
Функция ГруппировкаПоКлючу(Строки, ИмяФункцииКлюча)
	Группы = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючСтроки(Строка, ИмяФункцииКлюча);
		Если Ключ = "" Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы[Ключ];
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы[Ключ] = Группа;
		КонецЕсли;
		Группа.Добавить(Строка);
	КонецЦикла;
	Возврат Группы;
КонецФункции

&НаСервереБезКонтекста
Функция КлючСтроки(Строка, Вид)
	Если Вид = "ИНН" Тогда
		Возврат НормСтр(Строка.ИННКПП);
	ИначеЕсли Вид = "Номер" Тогда
		Возврат НомерЭффективный(Строка);
	ИначеЕсли Вид = "НомерСтроки" Тогда
		Возврат Формат(Строка.НомерСтроки, "ЧГ=0");
	ИначеЕсли Вид = "ДатаСумма" Тогда
		Возврат НормСтр(Строка.ДатаПринятия) + "|" + Формат(Окр2(Строка.Стоимость), "ЧГ=0") + "|" + Формат(Окр2(Строка.НДС), "ЧГ=0");
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ВзятьКандидата(Группа, Использованные)
	Если Группа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Строка Из Группа Цикл
		Если Использованные[Строка] = Неопределено Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписьСопоставления(Р1, Р2)

	ЛюбойРеестр = Р1.Реестр Или Р2.Реестр;
	ЛюбойРаздел9 = (Р1.Раздел = 9 Или Р2.Раздел = 9);

	Запись = Новый Структура;
	Запись.Вставить("Р1", Р1);
	Запись.Вставить("Р2", Р2);
	Запись.Вставить("ЕстьСтоимость", Не ЛюбойРаздел9 И Р1.СтоимостьЕсть И Р2.СтоимостьЕсть);
	Запись.Вставить("ЕстьНДС", Не ЛюбойРаздел9 И Р1.НДСЕсть И Р2.НДСЕсть);
	ЕстьИНН = Р1.ИННКПП <> "" И Р2.ИННКПП <> "";
	Запись.Вставить("РазницаСтоимости", ?(Запись.ЕстьСтоимость, Р2.Стоимость - Р1.Стоимость, 0));
	Запись.Вставить("РазницаНДС", ?(Запись.ЕстьНДС, Р2.НДС - Р1.НДС, 0));
	Запись.Вставить("РазницаДаты", ?(ЛюбойРеестр, Ложь, НормСтр(Р1.ДатаПринятия) <> НормСтр(Р2.ДатаПринятия)));
	Запись.Вставить("РазницаСФ", НомерЭффективный(Р1) <> НомерЭффективный(Р2));
	Запись.Вставить("РазницаКонтрагента", ?(ЕстьИНН, НормСтр(Р1.ИННКПП) <> НормСтр(Р2.ИННКПП), Ложь));
	Возврат Запись;

КонецФункции

&НаСервереБезКонтекста
Функция ПолноеСовпадение(Запись)
	Если Запись.РазницаСФ Или Запись.РазницаДаты Или Запись.РазницаКонтрагента Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Запись.ЕстьСтоимость И Абс(Запись.РазницаСтоимости) > 0.01 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Запись.ЕстьНДС И Абс(Запись.РазницаНДС) > 0.01 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Дубли внутри одного набора. Возвращает массив групп (Структура: Строки, ВероятноеИсправление).
&НаСервереБезКонтекста
Функция НайтиДубли(Данные, Встречный)

	Отсортированные = Данные.Скопировать();
	Отсортированные.Сортировать("НомерСтроки");

	ЭтоРеестр = Данные.Количество() > 0 И Данные[0].Реестр;

	Обычные = Новый Массив;
	КорректировочныеСФ = Новый Массив;
	Для Каждого Строка Из Отсортированные Цикл
		Если ЕстьКСФ(Строка) Тогда
			КорректировочныеСФ.Добавить(Строка);
		Иначе
			Обычные.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Группы = Новый Массив;
	Для Проход = 1 По 2 Цикл
		Список = ?(Проход = 1, Обычные, КорректировочныеСФ);
		Накоплено = Новый Соответствие;
		Порядок = Новый Массив;
		Для Каждого Строка Из Список Цикл
			Номер = ?(Проход = 1, НомерБезДаты(Строка.СФ), НомерБезДаты(Строка.КСФ));
			Если ЭтоРеестр Тогда
				// Реестр: номер + дата счёта-фактуры (+ продавец, если известен).
				Текст = ?(Проход = 1, Строка.СФ, Строка.КСФ);
				Ключ = НормСтр(Текст) + "|" + НормПродавец(Строка.Продавец);
				Если НормСтр(Текст) = "" Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				ИНН = НормСтр(Строка.ИННКПП);
				Если ИНН = "" Или Номер = "" Тогда
					Продолжить;
				КонецЕсли;
				Ключ = ИНН + "|" + Номер;
			КонецЕсли;
			Группа = Накоплено[Ключ];
			Если Группа = Неопределено Тогда
				Группа = Новый Массив;
				Накоплено[Ключ] = Группа;
				Порядок.Добавить(Ключ);
			КонецЕсли;
			Группа.Добавить(Строка);
		КонецЦикла;
		Для Каждого Ключ Из Порядок Цикл
			Если Накоплено[Ключ].Количество() > 1 Тогда
				Группы.Добавить(Новый Структура("Строки, ВероятноеИсправление", Накоплено[Ключ], Ложь));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Упорядочиваем группы по номеру первой строки.
	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Первый", Новый ОписаниеТипов("Число"));
	Порядок.Колонки.Добавить("Группа");
	Для Каждого Группа Из Группы Цикл
		Новая = Порядок.Добавить();
		Новая.Первый = Группа.Строки[0].НомерСтроки;
		Новая.Группа = Группа;
	КонецЦикла;
	Порядок.Сортировать("Первый");
	Результат = Порядок.ВыгрузитьКолонку("Группа");

	// Если рядом декларация с заполненной графой 4 по этому СФ — это исправление, а не дубль.
	Если ЭтоРеестр И Встречный <> Неопределено И Встречный.Количество() > 0 И Не Встречный[0].Реестр Тогда
		КлючиИсправлений = Новый Соответствие;
		Для Каждого Строка Из Встречный Цикл
			Если СокрЛП(Строка.Исправление) <> "" Тогда
				КлючиИсправлений[НомерБезДаты(Строка.СФ)] = Истина;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Группа Из Результат Цикл
			Группа.ВероятноеИсправление = (КлючиИсправлений[НомерБезДаты(Группа.Строки[0].СФ)] <> Неопределено);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СравнитьДанные(Д1, Д2)

	Совпадают = Новый Массив;
	Различия = Новый Массив;
	Только1 = Новый Массив;
	Только2 = Новый Массив;
	Использ1 = Новый Соответствие;
	Использ2 = Новый Соответствие;

	ЭтоСверкаСРеестром = (Д1.Количество() > 0 И Д1[0].Реестр) Или (Д2.Количество() > 0 И Д2[0].Реестр);

	// Этап 1: точное совпадение по ключу (СФ + продавец + ИНН/КПП); при повторах ключа берётся последняя строка.
	Карта1 = Новый Соответствие;
	Порядок1 = Новый Массив;
	Для Каждого Строка Из Д1 Цикл
		Если Карта1[Строка.Ключ] = Неопределено Тогда
			Порядок1.Добавить(Строка.Ключ);
		КонецЕсли;
		Карта1[Строка.Ключ] = Строка;
	КонецЦикла;
	Карта2 = Новый Соответствие;
	Для Каждого Строка Из Д2 Цикл
		Карта2[Строка.Ключ] = Строка;
	КонецЦикла;
	Для Каждого Ключ Из Порядок1 Цикл
		Р1 = Карта1[Ключ];
		Р2 = Карта2[Ключ];
		Если Р2 = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Использ1[Р1] = Истина;
		Использ2[Р2] = Истина;
		Запись = ЗаписьСопоставления(Р1, Р2);
		Если ПолноеСовпадение(Запись) Тогда
			Совпадают.Добавить(Запись);
		Иначе
			Различия.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Остаток1 = Новый Массив;
	Для Каждого Строка Из Д1 Цикл
		Если Использ1[Строка] = Неопределено Тогда
			Остаток1.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Остаток2 = Новый Массив;
	Для Каждого Строка Из Д2 Цикл
		Если Использ2[Строка] = Неопределено Тогда
			Остаток2.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Если ЭтоСверкаСРеестром Тогда
		// Декларация ↔ реестр: одна строка реестра может подтверждать несколько строк декларации
		// (исходная запись + исправления) — запись реестра не «расходуется».
		Первый_Реестр = (Д1.Количество() > 0 И Д1[0].Реестр);
		СтрокиДекл = ?(Первый_Реестр, Остаток2, Остаток1);
		СтрокиРеестра = ?(Первый_Реестр, Остаток1, Остаток2);
		ГруппыРеестра = ГруппировкаПоКлючу(СтрокиРеестра, "Номер");
		СопоставленныеРеестра = Новый Соответствие;
		НесопоставленныеДекл = Новый Массив;

		Для Каждого Дек Из СтрокиДекл Цикл
			Группа = ГруппыРеестра[НомерЭффективный(Дек)];
			Найденная = Неопределено;
			Если Группа <> Неопределено Тогда
				Для Каждого Кандидат Из Группа Цикл
					Если ПродавцыПохожи(Дек.Продавец, Кандидат.Продавец) Тогда
						Найденная = Кандидат;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если Найденная <> Неопределено Тогда
				СопоставленныеРеестра[Найденная] = Истина;
				Запись = ?(Первый_Реестр, ЗаписьСопоставления(Найденная, Дек), ЗаписьСопоставления(Дек, Найденная));
				Если ПолноеСовпадение(Запись) Тогда
					Совпадают.Добавить(Запись);
				Иначе
					Различия.Добавить(Запись);
				КонецЕсли;
			Иначе
				НесопоставленныеДекл.Добавить(Дек);
			КонецЕсли;
		КонецЦикла;
		НесопоставленныеРеестра = Новый Массив;
		Для Каждого Строка Из СтрокиРеестра Цикл
			Если СопоставленныеРеестра[Строка] = Неопределено Тогда
				НесопоставленныеРеестра.Добавить(Строка);
			КонецЕсли;
		КонецЦикла;

		Если Первый_Реестр Тогда
			Только1 = НесопоставленныеРеестра;
			Только2 = НесопоставленныеДекл;
		Иначе
			Только1 = НесопоставленныеДекл;
			Только2 = НесопоставленныеРеестра;
		КонецЕсли;
	Иначе
		// Декларация ↔ декларация: по контрагенту, затем по номеру СФ, по № п/п, по дате и сумме.
		ПоИНН = ГруппировкаПоКлючу(Остаток2, "ИНН");
		ПоНомеру = ГруппировкаПоКлючу(Остаток2, "Номер");
		ПоНомеруСтроки = ГруппировкаПоКлючу(Остаток2, "НомерСтроки");
		ПоДатеСумме = ГруппировкаПоКлючу(Остаток2, "ДатаСумма");
		Израсходованные = Новый Соответствие;

		Для Каждого Р1 Из Остаток1 Цикл
			Р2 = ВзятьКандидата(ПоИНН[КлючСтроки(Р1, "ИНН")], Израсходованные);
			Если Р2 = Неопределено Тогда
				Р2 = ВзятьКандидата(ПоНомеру[КлючСтроки(Р1, "Номер")], Израсходованные);
			КонецЕсли;
			Если Р2 = Неопределено Тогда
				Р2 = ВзятьКандидата(ПоНомеруСтроки[КлючСтроки(Р1, "НомерСтроки")], Израсходованные);
			КонецЕсли;
			Если Р2 = Неопределено Тогда
				Р2 = ВзятьКандидата(ПоДатеСумме[КлючСтроки(Р1, "ДатаСумма")], Израсходованные);
			КонецЕсли;
			Если Р2 <> Неопределено Тогда
				Израсходованные[Р2] = Истина;
				Запись = ЗаписьСопоставления(Р1, Р2);
				Если ПолноеСовпадение(Запись) Тогда
					Совпадают.Добавить(Запись);
				Иначе
					Различия.Добавить(Запись);
				КонецЕсли;
			Иначе
				Только1.Добавить(Р1);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Р2 Из Остаток2 Цикл
			Если Израсходованные[Р2] = Неопределено Тогда
				Только2.Добавить(Р2);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Совпадают, Различия, Только1, Только2", Совпадают, Различия, Только1, Только2);

КонецФункции

#КонецОбласти

#Область СверкаВывод

&НаСервереБезКонтекста
Функция НоваяТаблицаРезультата()
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Описание Из СтрРазделить(СверкаКолонкиРезультата(), ",") Цикл
		Части = СтрРазделить(Описание, ":");
		Таблица.Колонки.Добавить(Части[0], СверкаТипКолонки(Части[1]));
	КонецЦикла;
	Возврат Таблица;
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьСторону(Строка, Номер, Данные)
	Строка["Номер" + Номер] = Данные.НомерСтроки;
	Строка["СФ" + Номер] = Данные.СФ;
	Строка["Дата" + Номер] = Данные.ДатаПринятия;
	Строка["Продавец" + Номер] = Данные.Продавец;
	Строка["ИННКПП" + Номер] = Данные.ИННКПП;
	Строка["Стоимость" + Номер] = Данные.Стоимость;
	Строка["НДС" + Номер] = Данные.НДС;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтметкаСтроки(Строка)
	Результат = "";
	Если ЭтоИсправлениеНомер1(Строка) Тогда
		Результат = "исправление №1";
	КонецЕсли;
	Если ЕстьКСФ(Строка) Тогда
		Результат = Результат + ?(Результат = "", "", ", ") + "КСФ";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаЗаписей(Записи, Совпадение)
	Таблица = НоваяТаблицаРезультата();
	Для Каждого Запись Из Записи Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьСторону(Строка, 1, Запись.Р1);
		ЗаполнитьСторону(Строка, 2, Запись.Р2);
		Строка.РазницаСтоимости = Запись.РазницаСтоимости;
		Строка.РазницаНДС = Запись.РазницаНДС;
		Отличия = Новый Массив;
		Если Запись.РазницаСФ Тогда
			Отличия.Добавить("счёт-фактура");
		КонецЕсли;
		Если Запись.РазницаДаты Тогда
			Отличия.Добавить("дата принятия");
		КонецЕсли;
		Если Запись.РазницаКонтрагента Тогда
			Отличия.Добавить("контрагент");
		КонецЕсли;
		Если Запись.ЕстьСтоимость И Абс(Запись.РазницаСтоимости) > 0.01 Тогда
			Отличия.Добавить("стоимость");
		КонецЕсли;
		Если Запись.ЕстьНДС И Абс(Запись.РазницаНДС) > 0.01 Тогда
			Отличия.Добавить("НДС");
		КонецЕсли;
		Строка.Отличия = СтрСоединить(Отличия, ", ");
		Строка.Примечание = ОтметкаСтроки(Запись.Р1);
	КонецЦикла;
	Возврат Таблица;
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаОдиночных(Строки, Номер)
	Таблица = НоваяТаблицаРезультата();
	Для Каждого Данные Из Строки Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьСторону(Строка, Номер, Данные);
		Строка.Примечание = ОтметкаСтроки(Данные);
	КонецЦикла;
	Возврат Таблица;
КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаДублей(Группы1, Группы2)
	Таблица = НоваяТаблицаРезультата();
	НомерГруппы = 0;
	Для Источник = 1 По 2 Цикл
		Для Каждого Группа Из ?(Источник = 1, Группы1, Группы2) Цикл
			НомерГруппы = НомерГруппы + 1;
			Первая = Группа.Строки[0];
			Заголовок = ?(Первая.Реестр, "Файл ", "Декларация ") + Источник + " · СФ № " + НомерЭффективный(Первая)
				+ ?(Первая.Реестр, "", " · " + Первая.Продавец + " · ИНН/КПП " + Первая.ИННКПП)
				+ " · записей: " + Группа.Строки.Количество()
				+ ?(Группа.ВероятноеИсправление, " — по декларации это исправление, не дубль", "");
			Для Каждого Данные Из Группа.Строки Цикл
				Строка = Таблица.Добавить();
				Строка.Группа = НомерГруппы;
				ЗаполнитьСторону(Строка, 1, Данные);
				Строка.Примечание = Заголовок + ?(ОтметкаСтроки(Данные) = "", "", " [" + ОтметкаСтроки(Данные) + "]");
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Таблица;
КонецФункции

&НаСервереБезКонтекста
Функция СуммаНДС(Таблица)
	Итог = 0;
	Для Каждого Строка Из Таблица Цикл
		Итог = Итог + Строка.НДС;
	КонецЦикла;
	Возврат Итог;
КонецФункции

&НаСервере
Процедура СверкаСравнитьНаСервере(ТолькоДубли)

	Д1 = ЭтаФорма["СверкаДанные1"].Выгрузить();
	Д2 = ЭтаФорма["СверкаДанные2"].Выгрузить();

	Если Не ТолькоДубли И (Д1.Количество() = 0 Или Д2.Количество() = 0) Тогда
		Сообщить("Загрузите файлы в оба поля.");
		Возврат;
	КонецЕсли;
	Если ТолькоДубли И Д1.Количество() = 0 И Д2.Количество() = 0 Тогда
		Сообщить("Загрузите хотя бы один файл.");
		Возврат;
	КонецЕсли;

	Группы1 = ?(Д1.Количество() > 0, НайтиДубли(Д1, Д2), Новый Массив);
	Группы2 = ?(Д2.Количество() > 0, НайтиДубли(Д2, Д1), Новый Массив);
	КолвоДублей = 0;
	Для Каждого Группа Из Группы1 Цикл
		КолвоДублей = КолвоДублей + Группа.Строки.Количество();
	КонецЦикла;
	Для Каждого Группа Из Группы2 Цикл
		КолвоДублей = КолвоДублей + Группа.Строки.Количество();
	КонецЦикла;

	Если ТолькоДубли Тогда
		Итог = Новый Структура("Совпадают, Различия, Только1, Только2", Новый Массив, Новый Массив, Новый Массив, Новый Массив);
		Сводка = "Режим: поиск дублей без сравнения. Файл 1: " + Д1.Количество() + " записей; файл 2: " + Д2.Количество()
			+ " записей; строк в дублях: " + КолвоДублей + ".";
	Иначе
		Итог = СравнитьДанные(Д1, Д2);
		Реестр1 = Д1[0].Реестр;
		Реестр2 = Д2[0].Реестр;
		Если Реестр1 Или Реестр2 Тогда
			Декл = ?(Реестр1, Д2, Д1);
			Реестр = ?(Реестр1, Д1, Д2);
			Сводка = "Декларация: " + Декл.Количество() + " записей, НДС " + Формат(СуммаНДС(Декл), "ЧДЦ=2; ЧГ=") + " | Реестр СФ: "
				+ Реестр.Количество() + " записей"
				+ ?(Реестр.Количество() > 0 И Реестр[0].СтоимостьЕсть, ", с суммами", " (суммы и НДС в реестре не указаны — сравнение только по номеру и дате)");
		Иначе
			Сводка = "Декларация 1: " + Д1.Количество() + " записей, НДС " + Формат(СуммаНДС(Д1), "ЧДЦ=2; ЧГ=")
				+ " | Декларация 2: " + Д2.Количество() + " записей, НДС " + Формат(СуммаНДС(Д2), "ЧДЦ=2; ЧГ=")
				+ " | Разница НДС: " + Формат(СуммаНДС(Д2) - СуммаНДС(Д1), "ЧДЦ=2; ЧГ=");
		КонецЕсли;
		Сводка = Сводка + Символы.ПС + "Совпадают: " + Итог.Совпадают.Количество() + ", различия: " + Итог.Различия.Количество()
			+ ", только в 1-й: " + Итог.Только1.Количество() + ", только во 2-й: " + Итог.Только2.Количество()
			+ ", строк в дублях: " + КолвоДублей;
	КонецЕсли;

	ЭтаФорма["СверкаСовпадают"].Загрузить(ТаблицаЗаписей(Итог.Совпадают, Истина));
	ЭтаФорма["СверкаРазличия"].Загрузить(ТаблицаЗаписей(Итог.Различия, Ложь));
	ЭтаФорма["СверкаТолько1"].Загрузить(ТаблицаОдиночных(Итог.Только1, 1));
	ЭтаФорма["СверкаТолько2"].Загрузить(ТаблицаОдиночных(Итог.Только2, 2));
	ЭтаФорма["СверкаДубли"].Загрузить(ТаблицаДублей(Группы1, Группы2));
	ЭтаФорма["СверкаСводка"] = Сводка;

	Количества = Новый Структура("СверкаРазличия, СверкаТолько1, СверкаТолько2, СверкаСовпадают, СверкаДубли",
		Итог.Различия.Количество(), Итог.Только1.Количество(), Итог.Только2.Количество(), Итог.Совпадают.Количество(), КолвоДублей);
	Для Каждого КлючЗначение Из СверкаТаблицы() Цикл
		Элементы["Стр_" + КлючЗначение.Ключ].Заголовок = КлючЗначение.Значение + " (" + Количества[КлючЗначение.Ключ] + ")";
	КонецЦикла;

	Элементы.Сверка_Страницы.ТекущаяСтраница = Элементы[?(ТолькоДубли, "Стр_СверкаДубли", "Стр_СверкаРазличия")];

КонецПроцедуры

&НаСервере
Функция СверкаЭкспортНаСервере()

	Док = Новый ТабличныйДокумент;
	Заголовки = СтрРазделить(СверкаКолонкиРезультата(), ",");
	Выведено = 0;

	Для Каждого КлючЗначение Из СверкаТаблицы() Цикл
		Таблица = ЭтаФорма[КлючЗначение.Ключ];
		Если Таблица.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Док.Область(Док.ВысотаТаблицы + 2, 1).Текст = КлючЗначение.Значение + " (" + Таблица.Количество() + ")";
		Док.Область(Док.ВысотаТаблицы, 1).Шрифт = Новый Шрифт(, , Истина);
		НоваяСтрока = Док.ВысотаТаблицы + 1;
		Колонка = 0;
		Для Каждого Описание Из Заголовки Цикл
			Колонка = Колонка + 1;
			Док.Область(НоваяСтрока, Колонка).Текст = СтрРазделить(Описание, ":")[0];
		КонецЦикла;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			НоваяСтрока = Док.ВысотаТаблицы + 1;
			Колонка = 0;
			Для Каждого Описание Из Заголовки Цикл
				Колонка = Колонка + 1;
				Значение = СтрокаТаблицы[СтрРазделить(Описание, ":")[0]];
				Док.Область(НоваяСтрока, Колонка).Текст = ?(Значение = 0 И ТипЗнч(Значение) = Тип("Число"), "", Строка(Значение));
			КонецЦикла;
		КонецЦикла;
		Выведено = Выведено + 1;
	КонецЦикла;

	Если Выведено = 0 Тогда
		Сообщить("Нет результатов для выгрузки — сначала выполните сверку.");
		Возврат Неопределено;
	КонецЕсли;

	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	Док.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), УникальныйИдентификатор);
	УдалитьФайлы(ИмяФайла);
	Возврат Адрес;

КонецФункции

#КонецОбласти

#КонецОбласти
