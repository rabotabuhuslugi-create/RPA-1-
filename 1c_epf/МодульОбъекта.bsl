// Модуль объекта внешней обработки «РазделкаДолиПоЦенам».
// Алгоритм тот же, что в 1c_extension/РазделкаДоли.bsl и rpa1c/razdelka.py.
// Настройки (вид цен, мин. доля, отходы) приходят параметрами — констант нет.
// УТОЧНИТЬ: имена реквизитов («КоличествоФакт» и т.д.) и регистры — сверить с конфигурацией.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Возвращает массив структур (НомерСтроки, ДоляВыхода, ДоляСебестоимости). Документ не меняет.
Функция РассчитатьДоли(Знач Товары, Знач ВидЦен, Знач Дата, Знач МинДоля, Знач ИменаОтходов) Экспорт

	Результат = Новый Массив;
	Если Товары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Товары.Количество() = 1 Тогда
		Результат.Добавить(Новый Структура("НомерСтроки, ДоляВыхода, ДоляСебестоимости", 1, 1, 1));
		Возврат Результат;
	КонецЕсли;

	СуммаФакт = 0;
	Для Каждого Строка Из Товары Цикл
		СуммаФакт = СуммаФакт + Строка.КоличествоФакт;
	КонецЦикла;
	Если СуммаФакт <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Сумма фактического количества должна быть больше нуля'");
	КонецЕсли;

	Отходы = НоменклатураПоИменам(ИменаОтходов);
	Цены = ЦеныПродажи(Товары.ВыгрузитьКолонку("Номенклатура"), ВидЦен, Дата);

	Выход = Новый Массив;
	Веса = Новый Массив;
	СуммаВесов = 0;
	Для Каждого Строка Из Товары Цикл
		Выход.Добавить(Окр(Строка.КоличествоФакт / СуммаФакт, 3, 1));
		Вес = 0;
		Если Отходы.Найти(Строка.Номенклатура) = Неопределено Тогда
			Вес = Строка.КоличествоФакт * Цены[Строка.Номенклатура];
		КонецЕсли;
		Веса.Добавить(Вес);
		СуммаВесов = СуммаВесов + Вес;
	КонецЦикла;
	Если СуммаВесов <= 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет продаваемых позиций с ценой: доли себестоимости не рассчитать'");
	КонецЕсли;

	Себест = Новый Массив;
	Для Каждого Вес Из Веса Цикл
		Себест.Добавить(Окр(Вес / СуммаВесов, 2, 1));
	КонецЦикла;

	ДобавитьОстаток(Выход, Товары.ВыгрузитьКолонку("КоличествоФакт"), 1, Ложь);
	ДобавитьОстаток(Себест, Веса, 1, Ложь);

	Если МинДоля > 0 Тогда
		Для Индекс = 0 По Веса.ВГраница() Цикл
			Если Веса[Индекс] > 0 И Себест[Индекс] = 0 Тогда
				Себест[Индекс] = МинДоля;
				ДобавитьОстаток(Себест, Веса, -МинДоля, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Индекс = 0 По Выход.ВГраница() Цикл
		Результат.Добавить(Новый Структура("НомерСтроки, ДоляВыхода, ДоляСебестоимости",
			Индекс + 1, Выход[Индекс], Себест[Индекс]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Записывает доли в НЕпроведённый документ (режим «Запись»), факт и порядок строк не трогает.
Процедура ПрименитьДоли(ДокументСсылка, Доли) Экспорт
	Объект = ДокументСсылка.ПолучитьОбъект();
	Если Объект.Проведен Тогда
		ВызватьИсключение НСтр("ru = 'Документ проведён: отмените проведение, примените доли, проведите заново'");
	КонецЕсли;
	Для Каждого Доля Из Доли Цикл
		Строка = Объект.Товары[Доля.НомерСтроки - 1];
		Строка.ДоляВыхода = Доля.ДоляВыхода;
		Строка.ДоляСебестоимости = Доля.ДоляСебестоимости;
	КонецЦикла;
	Объект.Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры

Процедура ДобавитьОстаток(Значения, Ключи, Знач Поправка, Знач Вычитание)
	Индекс = 0;
	Для Н = 1 По Ключи.ВГраница() Цикл
		Если Ключи[Н] > Ключи[Индекс] Тогда // строго больше → при равенстве первая
			Индекс = Н;
		КонецЕсли;
	КонецЦикла;
	Если Вычитание Тогда
		Значения[Индекс] = Значения[Индекс] + Поправка;
	Иначе
		Сумма = 0;
		Для Каждого Значение Из Значения Цикл
			Сумма = Сумма + Значение;
		КонецЦикла;
		Значения[Индекс] = Значения[Индекс] + (Поправка - Сумма);
	КонецЕсли;
КонецПроцедуры

Функция НоменклатураПоИменам(Имена)
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Наименование В (&Имена)");
	Запрос.УстановитьПараметр("Имена", Имена);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

Функция ЦеныПродажи(Номенклатура, ВидЦен, Дата)

	Цены = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ВидЦен", ВидЦен);

	Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|&Дата, Номенклатура В (&Номенклатура) И ВидЦен = &ВидЦен)"; // продажные цены: РС «Цены номенклатуры»
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;

	// Резерв: самая частая из последних цен по всем розничным видам цен
	// (наименование вида цены содержит «озничн»: «Розничная Дарвина 101», «Сочи 1 кат. Искры розничная»).
	Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена, КОЛИЧЕСТВО(*) КАК Частота ИЗ (
		|ВЫБРАТЬ Номенклатура, ВидЦен, Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|&Дата, Номенклатура В (&Номенклатура) И ВидЦен.Наименование ПОДОБНО ""%озничн%"") КАК С)
		|СГРУППИРОВАТЬ ПО Номенклатура, Цена УПОРЯДОЧИТЬ ПО Частота УБЫВ, Цена УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Цены[Выборка.Номенклатура] = Неопределено Тогда
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Позиция Из Номенклатура Цикл
		Если Цены[Позиция] = Неопределено Тогда
			Цены.Вставить(Позиция, 0);
		КонецЕсли;
	КонецЦикла;
	Возврат Цены;

КонецФункции

#КонецЕсли
