// Модуль управляемой формы внешней обработки.
// Реквизиты формы: Документ (ДокументСсылка.Разделка), ВидЦен (СправочникСсылка.ВидыЦен),
// МинДоля (Число 3.2, по умолчанию 0), Отходы (СписокЗначений строк),
// Предпросмотр (ТаблицаЗначений: Номенклатура, Факт Число 15.3, Цена Число 15.2,
// ПроцентВыхода 7.3, ПроцентСебестоимости 5.2 (колонки предпросмотра: ДоляВыхода, ДоляСебестоимости)).
// Команды: «Рассчитать» → РассчитатьКоманда, «Применить к документу» → ПрименитьКоманда.

&НаКлиенте
Процедура РассчитатьКоманда(Команда)
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите документ «Разделка»'"));
		Возврат;
	КонецЕсли;
	Попытка
		РассчитатьНаСервере();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьКоманда(Команда)
	Если Предпросмотр.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПрименитьНаСервере();
		ПоказатьОповещениеПользователя(НСтр("ru = 'Доли записаны'"),, Строка(Документ));
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Доли = ДолиДокумента(Обработка);
	Предпросмотр.Очистить();
	Для Каждого Доля Из Доли Цикл
		Строка = Документ.Товары[Доля.НомерСтроки - 1];
		Новая = Предпросмотр.Добавить();
		Новая.Номенклатура = Строка.Номенклатура;
		Новая.Факт = Строка.Количество;
		Новая.ДоляВыхода = Доля.ДоляВыхода;
		Новая.ДоляСебестоимости = Доля.ДоляСебестоимости;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПрименитьДоли(Документ, ДолиДокумента(Обработка)); // пересчёт на момент записи
КонецПроцедуры

&НаСервере
Функция ДолиДокумента(Обработка)
	Возврат Обработка.РассчитатьДоли(Документ.Товары.Выгрузить(), ВидЦен, Документ.Дата,
		МинДоля, Отходы.ВыгрузитьЗначения());
КонецФункции
